// SPDX-License-Identifier: (MIT OR Apache-2.0)

// The TOML a config file needs, read into a tree with no schema involved.
//
// Supported: comments, bare/quoted/dotted keys, [table] headers, basic and
// literal strings, integers, booleans, arrays, inline tables. Rejected with
// a message: floats, dates, multi-line strings, [[array-of-tables]]. No
// field type reads them yet, and saying so beats half-reading them.
//
// Well-formedness, checked here because no schema can see it later:
// quoted keys must be NFC, raw bidi controls are rejected anywhere in the
// file, duplicate keys are an error, depth and size have fixed limits.

import string.StringBuilder

const MAX_BYTES: usize = 1048576
const MAX_DEPTH: usize = 32

const TAB: u8 = 9
const LF: u8 = 10
const CR: u8 = 13
const SPACE: u8 = 32
const DQUOTE: u8 = 34
const HASH: u8 = 35
const SQUOTE: u8 = 39
const COMMA: u8 = 44
const MINUS: u8 = 45
const DOT: u8 = 46
const EQUALS: u8 = 61
const LBRACKET: u8 = 91
const BACKSLASH: u8 = 92
const RBRACKET: u8 = 93
const LBRACE: u8 = 123
const RBRACE: u8 = 125
const PLUS: u8 = 43
const UNDERSCORE: u8 = 95

public enum Value {
    Str(string)
    Int(i64)
    Bool(bool)
    Array(Vec<Value>)
    Table(Vec<Entry>)
}

// Tables keep their keys in file order. A rewrite keeps that order among a
// table's values and among its sub-tables, but writes the values first: a
// value can't follow a sub-table's header and still belong to the parent.
public struct Entry {
    public key: string
    public value: Value
}

public struct TomlError {
    public line: i64
    public what: string
}

extend TomlError {
    public func message(self) -> string {
        return "line {self.line}: {self.what}"
    }
}

// One `key = value` or `[header]`, with its full dotted path.
struct Assign {
    path: Vec<string>
    value: Value
    header: bool
    line: i64
}

struct Reader {
    input: string
    pos: usize
    len: usize
    line: i64
}

public func parse_toml(input: string) -> Vec<Entry> or TomlError {
    if input.len() > MAX_BYTES {
        return TomlError { line: 0, what: "file is larger than {MAX_BYTES} bytes" }
    }
    try check_bidi(input)
    mut r = Reader { input, pos: 0, len: input.len(), line: 1 }
    mut assigns = Vec<Assign>.new()
    mut prefix = Vec<string>.new()

    loop {
        r.skip_blank_lines()
        if r.at_end() {
            break
        }
        let line = r.line
        if r.peek() == LBRACKET {
            r.pos = r.pos + 1
            if r.peek() == LBRACKET {
                return r.error("[[array of tables]] isn't supported; use a table of tables")
            }
            r.skip_spaces()
            let path = try r.parse_key()
            r.skip_spaces()
            if r.peek() != RBRACKET {
                return r.error("expected `]` to close the table header")
            }
            r.pos = r.pos + 1
            try r.end_of_line()
            if path.len() > MAX_DEPTH {
                return TomlError { line, what: "keys nest deeper than {MAX_DEPTH} levels" }
            }
            prefix = path.clone()
            assigns.push(Assign { path, value: Value.Table(Vec.new()), header: true, line })
            continue
        }
        let key = try r.parse_key()
        r.skip_spaces()
        if r.peek() != EQUALS {
            return r.error("expected `=` after the key")
        }
        r.pos = r.pos + 1
        r.skip_spaces()
        mut path = prefix.clone()
        for k in key {
            path.push(k)
        }
        if path.len() > MAX_DEPTH {
            return TomlError { line, what: "keys nest deeper than {MAX_DEPTH} levels" }
        }
        let value = try r.parse_value(path.len())
        try r.end_of_line()
        assigns.push(Assign { path, value, header: false, line })
    }

    mut all = Vec<usize>.new()
    mut i: usize = 0
    while i < assigns.len() {
        all.push(i)
        i = i + 1
    }
    return build_table(assigns, all, 0)
}

// Group assignments by their next path segment, in first-seen order.
// Duplicates and a value reused as a table are caught here, where both
// lines are in hand.
func build_table(assigns: Vec<Assign>, idx: Vec<usize>, depth: usize) -> Vec<Entry> or TomlError {
    mut keys = Vec<string>.new()
    for i in idx {
        let k = assigns[i].path[depth].clone()
        if !keys.contains(k) {
            keys.push(k)
        }
    }
    mut out = Vec<Entry>.new()
    for k in keys {
        mut leaf: usize? = none
        mut header: usize? = none
        mut child: usize? = none
        mut children = Vec<usize>.new()
        for i in idx {
            if assigns[i].path[depth] != k {
                continue
            }
            if assigns[i].path.len() > depth + 1 {
                if child is none {
                    child = i
                }
                children.push(i)
            } else if assigns[i].header {
                if header? as h {
                    return TomlError { line: assigns[i].line, what: "table [{assigns[i].path.join(".")}] is defined twice{first_on(assigns[h].line, assigns[i].line)}" }
                }
                header = i
            } else {
                if leaf? as l {
                    return TomlError { line: assigns[i].line, what: "duplicate key `{assigns[i].path.join(".")}`{first_on(assigns[l].line, assigns[i].line)}" }
                }
                leaf = i
            }
        }
        if leaf? as li {
            let other = header ?? child ?? li
            if other != li {
                let lv = assigns[li].line
                let lt = assigns[other].line
                let line = if lv > lt: lv else: lt
                return TomlError { line, what: "`{assigns[li].path.join(".")}` is a value on line {lv} and a table on line {lt}" }
            }
            out.push(Entry { key: k, value: assigns[li].value.clone() })
        } else {
            let inner = try build_table(assigns, children, depth + 1)
            out.push(Entry { key: k, value: Value.Table(inner) })
        }
    }
    return out
}

// A conflict names both lines, unless both are the same line.
func first_on(first: i64, now: i64) -> string {
    if first == now {
        return ""
    }
    return " (first on line {first})"
}

// Raw bidi controls can make text read differently from how it parses.
// They're rejected everywhere; a string that needs one writes it escaped.
func check_bidi(input: string) -> void or TomlError {
    mut line: i64 = 1
    mut i: usize = 0
    let n = input.len()
    while i < n {
        let b = input.byte_at(i) ?? 0
        if b == LF {
            line = line + 1
        }
        if bidi_at(input, i) != 0 {
            return TomlError { line, what: "raw bidirectional control character; write it as a \\u escape inside a string" }
        }
        i = i + 1
    }
    return
}

// The Bidi_Control code point starting at byte `i`, or 0: U+061C,
// U+200E-200F, U+202A-202E, U+2066-2069.
func bidi_at(s: string, i: usize) -> usize {
    let b0 = s.byte_at(i) ?? 0
    let b1 = s.byte_at(i + 1) ?? 0
    if b0 == 216 && b1 == 156 {
        return 1564
    }
    if b0 != 226 {
        return 0
    }
    let b2 = s.byte_at(i + 2) ?? 0
    let marks = b1 == 128 && (b2 == 142 || b2 == 143)
    let embeds = b1 == 128 && b2 >= 170 && b2 <= 174
    let isolates = b1 == 129 && b2 >= 166 && b2 <= 169
    if marks || embeds || isolates {
        return 8192 + (b1 - 128) as usize * 64 + (b2 - 128) as usize
    }
    return 0
}

func is_bare_key_byte(b: u8) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == UNDERSCORE || b == MINUS
}

func is_digit(b: u8) -> bool {
    return b >= 48 && b <= 57
}

// The digit's value in `radix`, or -1.
func digit_value(b: u8, radix: i64) -> i64 {
    mut d: i64 = -1
    if b >= 48 && b <= 57 {
        d = (b - 48) as i64
    } else if b >= 97 && b <= 102 {
        d = (b - 87) as i64
    } else if b >= 65 && b <= 70 {
        d = (b - 55) as i64
    }
    if d >= radix {
        return -1
    }
    return d
}

extend Reader {
    func at_end(self) -> bool {
        return self.pos >= self.len
    }

    func peek(self) -> u8 {
        if self.pos >= self.len {
            return 0
        }
        return self.input.byte_at(self.pos) ?? 0
    }

    func error(self, message: string) -> TomlError {
        return TomlError { line: self.line, what: message }
    }

    func skip_spaces(mutate self) {
        while self.peek() == SPACE || self.peek() == TAB {
            self.pos = self.pos + 1
        }
    }

    func skip_comment(mutate self) {
        if self.peek() == HASH {
            while !self.at_end() && self.peek() != LF {
                self.pos = self.pos + 1
            }
        }
    }

    func newline(mutate self) {
        if self.peek() == CR {
            self.pos = self.pos + 1
        }
        if self.peek() == LF {
            self.pos = self.pos + 1
            self.line = self.line + 1
        }
    }

    func skip_blank_lines(mutate self) {
        loop {
            self.skip_spaces()
            self.skip_comment()
            if self.peek() == LF || self.peek() == CR {
                self.newline()
                continue
            }
            return
        }
    }

    // Spaces, comments and newlines, as allowed between array elements.
    func skip_ws_multiline(mutate self) {
        self.skip_blank_lines()
    }

    func end_of_line(mutate self) -> void or TomlError {
        self.skip_spaces()
        self.skip_comment()
        if self.at_end() {
            return
        }
        if self.peek() == LF || self.peek() == CR {
            self.newline()
            return
        }
        return self.error("unexpected text after the value; one key per line")
    }

    // `a.b."c d"` — one or more segments joined by dots.
    func parse_key(mutate self) -> Vec<string> or TomlError {
        mut segs = Vec<string>.new()
        loop {
            self.skip_spaces()
            let seg = try self.parse_key_segment()
            segs.push(seg)
            self.skip_spaces()
            if self.peek() == DOT {
                self.pos = self.pos + 1
                continue
            }
            return segs
        }
    }

    func parse_key_segment(mutate self) -> string or TomlError {
        let b = self.peek()
        if b == DQUOTE || b == SQUOTE {
            let s = try self.parse_string()
            if s.normalized() != s {
                return self.error("quoted key \"{s}\" is not in NFC form; two spellings of one key would be two keys")
            }
            return s
        }
        let start = self.pos
        while is_bare_key_byte(self.peek()) {
            self.pos = self.pos + 1
        }
        if self.pos == start {
            return self.error("expected a key")
        }
        return self.input[start..self.pos].to_string()
    }

    // `depth` counts every key segment and container above this value.
    func parse_value(mutate self, depth: usize) -> Value or TomlError {
        if depth > MAX_DEPTH {
            return self.error("values nest deeper than {MAX_DEPTH} levels")
        }
        let b = self.peek()
        if b == DQUOTE || b == SQUOTE {
            let s = try self.parse_string()
            return Value.Str(s)
        }
        if b == LBRACKET {
            return self.parse_array(depth)
        }
        if b == LBRACE {
            return self.parse_inline_table(depth)
        }
        if self.input[self.pos..].starts_with("true") {
            self.pos = self.pos + 4
            return Value.Bool(true)
        }
        if self.input[self.pos..].starts_with("false") {
            self.pos = self.pos + 5
            return Value.Bool(false)
        }
        if is_digit(b) || b == MINUS || b == PLUS {
            return self.parse_integer()
        }
        return self.error("expected a value: a string, integer, boolean, array or inline table")
    }

    // Decimal with an optional sign, or unsigned 0x/0o/0b. `_` only between
    // digits, no leading zeros, and the value must fit in an i64.
    func parse_integer(mutate self) -> Value or TomlError {
        let signed = self.peek() == MINUS || self.peek() == PLUS
        let negative = self.peek() == MINUS
        if signed {
            self.pos = self.pos + 1
        }
        if !is_digit(self.peek()) {
            return self.error("expected a digit")
        }
        mut radix: i64 = 10
        if self.peek() == 48 {
            let p = self.input.byte_at(self.pos + 1) ?? 0
            if p == 120 {
                radix = 16
            } else if p == 111 {
                radix = 8
            } else if p == 98 {
                radix = 2
            }
            if radix != 10 {
                if signed {
                    return self.error("a hex, octal or binary integer can't have a sign")
                }
                self.pos = self.pos + 2
            }
        }
        // Counted below zero: i64's minimum has no positive twin.
        mut n: i64 = 0
        mut digits: usize = 0
        mut first: u8 = 0
        mut after_digit = false
        mut fits = true
        loop {
            let b = self.peek()
            if b == UNDERSCORE {
                if !after_digit {
                    return self.error("`_` in a number must sit between two digits")
                }
                after_digit = false
                self.pos = self.pos + 1
                continue
            }
            let d = digit_value(b, radix)
            if d < 0 {
                break
            }
            if digits == 0 {
                first = b
            }
            digits = digits + 1
            after_digit = true
            self.pos = self.pos + 1
            if n.checked_mul(radix)? as m {
                if m.checked_sub(d)? as s {
                    n = s
                    continue
                }
            }
            fits = false
        }
        if digits == 0 {
            return self.error("expected digits after the base prefix")
        }
        if !after_digit {
            return self.error("`_` in a number must sit between two digits")
        }
        let next = self.peek()
        if radix == 10 {
            if next == DOT || next == 101 || next == 69 || next == 58 || next == MINUS {
                return self.error("floats and dates aren't supported")
            }
            if first == 48 && digits > 1 {
                return self.error("leading zeros aren't allowed in an integer")
            }
        } else if is_bare_key_byte(next) {
            return self.error("`{self.input[self.pos..self.pos + 1]}` is not a base-{radix} digit")
        }
        if !negative {
            if n.checked_mul(-1)? as p {
                n = p
            } else {
                fits = false
            }
        }
        if !fits {
            return self.error("integer doesn't fit in 64 bits")
        }
        return Value.Int(n)
    }

    func parse_array(mutate self, depth: usize) -> Value or TomlError {
        self.pos = self.pos + 1
        mut items = Vec<Value>.new()
        loop {
            self.skip_ws_multiline()
            if self.peek() == RBRACKET {
                self.pos = self.pos + 1
                return Value.Array(items)
            }
            let v = try self.parse_value(depth + 1)
            items.push(v)
            self.skip_ws_multiline()
            if self.peek() == COMMA {
                self.pos = self.pos + 1
                continue
            }
            if self.peek() == RBRACKET {
                self.pos = self.pos + 1
                return Value.Array(items)
            }
            return self.error("expected `,` or `]` in the array")
        }
    }

    // `{ a = 1, b.c = "x" }` — one line, no trailing comma, as TOML has it.
    func parse_inline_table(mutate self, depth: usize) -> Value or TomlError {
        let line = self.line
        self.pos = self.pos + 1
        mut assigns = Vec<Assign>.new()
        self.skip_spaces()
        if self.peek() == RBRACE {
            self.pos = self.pos + 1
            return Value.Table(Vec.new())
        }
        loop {
            self.skip_spaces()
            let path = try self.parse_key()
            self.skip_spaces()
            if self.peek() != EQUALS {
                return self.error("expected `=` after the key")
            }
            self.pos = self.pos + 1
            self.skip_spaces()
            let value = try self.parse_value(depth + path.len())
            assigns.push(Assign { path, value, header: false, line })
            self.skip_spaces()
            if self.peek() == COMMA {
                self.pos = self.pos + 1
                continue
            }
            if self.peek() == RBRACE {
                self.pos = self.pos + 1
                break
            }
            return self.error("expected `,` or `}` in the inline table")
        }
        mut all = Vec<usize>.new()
        mut i: usize = 0
        while i < assigns.len() {
            all.push(i)
            i = i + 1
        }
        let entries = try build_table(assigns, all, 0)
        return Value.Table(entries)
    }

    func parse_string(mutate self) -> string or TomlError {
        let quote = self.peek()
        if self.input[self.pos..].starts_with("\"\"\"") || self.input[self.pos..].starts_with("'''") {
            return self.error("multi-line strings aren't supported")
        }
        self.pos = self.pos + 1
        mut out = StringBuilder.new()
        mut run_start = self.pos
        loop {
            let b = self.peek()
            let crlf = b == CR && (self.input.byte_at(self.pos + 1) ?? 0) == LF
            if self.at_end() || b == LF || crlf {
                return self.error("unterminated string")
            }
            if (b < SPACE && b != TAB) || b == 127 {
                return self.error("raw control character in a string; write it as an escape")
            }
            if b == quote {
                out.push(self.input[run_start..self.pos].to_string())
                self.pos = self.pos + 1
                return out.build()
            }
            if b == BACKSLASH && quote == DQUOTE {
                out.push(self.input[run_start..self.pos].to_string())
                self.pos = self.pos + 1
                let esc = self.peek()
                self.pos = self.pos + 1
                if esc == DQUOTE {
                    out.push_char('"')
                } else if esc == BACKSLASH {
                    out.push_char('\\')
                } else if esc == 110 {
                    out.push_char('\n')
                } else if esc == 116 {
                    out.push_char('\t')
                } else if esc == 114 {
                    out.push_char('\r')
                } else if esc == 98 {
                    out.push_char('\u{8}')
                } else if esc == 102 {
                    out.push_char('\u{C}')
                } else if esc == 117 {
                    let c = try self.parse_hex_escape(4)
                    out.push_char(c)
                } else if esc == 85 {
                    let c = try self.parse_hex_escape(8)
                    out.push_char(c)
                } else {
                    return self.error("unknown escape in string")
                }
                run_start = self.pos
                continue
            }
            self.pos = self.pos + 1
        }
    }

    func parse_hex_escape(mutate self, digits: usize) -> char or TomlError {
        mut cp: u32 = 0
        mut i: usize = 0
        while i < digits {
            let b = self.peek()
            self.pos = self.pos + 1
            mut d: u32 = 0
            if b >= 48 && b <= 57 {
                d = (b - 48).wrap<u32>()
            } else if b >= 97 && b <= 102 {
                d = (b - 87).wrap<u32>()
            } else if b >= 65 && b <= 70 {
                d = (b - 55).wrap<u32>()
            } else {
                return self.error("bad hex digit in \\u escape")
            }
            cp = cp * 16 + d
            i = i + 1
        }
        if char.from_u32(cp)? as c {
            return c
        }
        return self.error("\\u escape is not a valid code point")
    }
}

// ─── Tree access ────────────────────────────────────────────────

extend Value {
    public func kind(self) -> string {
        return match self {
            Value.Str(_) => "a string",
            Value.Int(_) => "an integer",
            Value.Bool(_) => "a boolean",
            Value.Array(_) => "an array",
            Value.Table(_) => "a table",
        }
    }

    public func eq(self, other: Value) -> bool {
        return render_value(self) == render_value(other)
    }
}

public func find_entry(entries: Vec<Entry>, key: string) -> usize? {
    mut i: usize = 0
    while i < entries.len() {
        if entries[i].key == key {
            return i
        }
        i = i + 1
    }
    return none
}

// Typed reads of a checked tree. A key that's missing or holds another
// kind of value reads as absent: after the shape check, that only happens
// for optional fields.

public func table_at(entries: Vec<Entry>, key: string) -> Vec<Entry> {
    if find_entry(entries, key)? as i {
        if entries[i].value is Table(inner) {
            return inner.clone()
        }
    }
    return Vec.new()
}

public func str_at(entries: Vec<Entry>, key: string) -> string? {
    if find_entry(entries, key)? as i {
        if entries[i].value is Str(s) {
            return s
        }
    }
    return none
}

public func bool_at(entries: Vec<Entry>, key: string) -> bool? {
    if find_entry(entries, key)? as i {
        if entries[i].value is Bool(b) {
            return b
        }
    }
    return none
}

public func int_at(entries: Vec<Entry>, key: string) -> i64? {
    if find_entry(entries, key)? as i {
        if entries[i].value is Int(n) {
            return n
        }
    }
    return none
}

public func pairs_at(entries: Vec<Entry>, key: string) -> Vec<(string, string)> {
    mut out = Vec<(string, string)>.new()
    for e in table_at(entries, key) {
        if e.value is Str(s) {
            out.push((e.key, s))
        }
    }
    return out
}

public func strs_at(entries: Vec<Entry>, key: string) -> Vec<string> {
    mut out = Vec<string>.new()
    if find_entry(entries, key)? as i {
        if entries[i].value is Array(items) {
            for item in items {
                if item is Str(s) {
                    out.push(s)
                }
            }
        }
    }
    return out
}

// ─── Writing ─────────────────────────────────────────────────────
// Not format-preserving: comments and layout are lost. The real `rask add`
// and `rask migrate` need an editor that keeps them; this is enough to show
// what a migration produces.

public func render_value(v: Value) -> string {
    match v {
        Value.Str(s) => return quote_string(s),
        Value.Int(n) => return "{n}",
        Value.Bool(b) => return if b: "true" else: "false",
        Value.Array(items) => {
            mut parts = Vec<string>.new()
            for item in items {
                parts.push(render_value(item))
            }
            return "[{parts.join(", ")}]"
        }
        Value.Table(entries) => {
            if entries.is_empty() {
                return "{{}}"
            }
            mut parts = Vec<string>.new()
            for e in entries {
                parts.push("{render_key(e.key)} = {render_value(e.value)}")
            }
            return "{{ {parts.join(", ")} }}"
        }
    }
}

func render_key(k: string) -> string {
    if k.is_empty() {
        return "\"\""
    }
    mut i: usize = 0
    while i < k.len() {
        if !is_bare_key_byte(k.byte_at(i) ?? 0) {
            return quote_string(k)
        }
        i = i + 1
    }
    return k
}

// Escapes whatever the reader would refuse raw: control characters and
// bidi controls.
func quote_string(s: string) -> string {
    mut out = StringBuilder.new()
    out.push_char('"')
    let n = s.len()
    mut run: usize = 0
    mut i: usize = 0
    while i < n {
        let b = s.byte_at(i) ?? 0
        mut width: usize = 1
        mut esc = ""
        if b == DQUOTE {
            esc = "\\\""
        } else if b == BACKSLASH {
            esc = "\\\\"
        } else if b == LF {
            esc = "\\n"
        } else if b == TAB {
            esc = "\\t"
        } else if b == CR {
            esc = "\\r"
        } else if b == 8 {
            esc = "\\b"
        } else if b == 12 {
            esc = "\\f"
        } else if b < SPACE || b == 127 {
            esc = unicode_escape(b as usize)
        } else {
            let cp = bidi_at(s, i)
            if cp != 0 {
                esc = unicode_escape(cp)
                width = if cp == 1564: 2 else: 3
            }
        }
        if esc.is_empty() {
            i = i + 1
            continue
        }
        out.push(s[run..i].to_string())
        out.push(esc)
        i = i + width
        run = i
    }
    out.push(s[run..n].to_string())
    out.push_char('"')
    return out.build()
}

func unicode_escape(cp: usize) -> string {
    let hex = "0123456789ABCDEF"
    mut out = StringBuilder.new()
    out.push("\\u")
    mut div: usize = 4096
    while div > 0 {
        let d = cp / div % 16
        out.push(hex[d..d + 1].to_string())
        div = div / 16
    }
    return out.build()
}

// Top-level scalars first, then one [section] per table. A table whose
// entries are all tables (like [dependencies]) stays one section of inline
// tables, which is how a person writes it.
public func render_document(entries: Vec<Entry>) -> string {
    mut out = StringBuilder.new()
    for e in entries {
        if e.value is Table(_) {
            continue
        }
        out.push("{render_key(e.key)} = {render_value(e.value)}\n")
    }
    for e in entries {
        if e.value is Table(inner) {
            render_section(mutate out, vec_of(render_key(e.key)), inner)
        }
    }
    return out.build()
}

func vec_of(s: string) -> Vec<string> {
    mut v = Vec<string>.new()
    v.push(s)
    return v
}

func render_section(mutate out: StringBuilder, path: Vec<string>, entries: Vec<Entry>) {
    out.push("\n[{path.join(".")}]\n")
    mut nested = Vec<usize>.new()
    mut i: usize = 0
    for e in entries {
        // A table that itself holds tables gets its own header; a leaf
        // table goes inline.
        if e.value is Table(inner) && has_table(inner) {
            nested.push(i)
        } else {
            out.push("{render_key(e.key)} = {render_value(e.value)}\n")
        }
        i = i + 1
    }
    for j in nested {
        if entries[j].value is Table(inner) {
            mut sub = path.clone()
            sub.push(render_key(entries[j].key))
            render_section(mutate out, sub, inner)
        }
    }
}

func has_table(entries: Vec<Entry>) -> bool {
    for e in entries {
        if e.value is Table(_) {
            return true
        }
    }
    return false
}
