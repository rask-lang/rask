.env
*__pycache__/
*.pyc

# Claude artifacts (removed from history)
.refinement/
research/
.claude
.devcontainer/

# mdBook build artifacts
docs/build/
docs/book/book/

# Compiled Rask binaries
build/

# Compiler build artifacts
*.o
compiler/runtime/*.a

# Runtime artifacts from example programs
rask-db/

# Playground builds
docs/playground/dist/
docs/playground/node_modules/
docs/playground/.cache/
docs/playground/pkg/
# Byproduct of running examples/18_resource_types.rk, which creates and then
# removes it. It got committed once by an examples sweep run from the repo root.
test.txt

# Ergonomics baseline binaries
benchmarks/ergonomics/grep_c

# Agent benchmark run output (transcripts, reports, raw run data)
agentbench/runs/

# Test-fixture lockfiles — the gate builds from source (see tests/packages/README.md).
tests/packages/*/app/rask.lock

# mdBook's create-missing turns SUMMARY.md's external links (the language card,
# the tutorials) into placeholder source files under a literal `https:` path.
# Generated on every build, never content.
docs/book/src/https:/
