/// Time operations.
struct time { }

extend time {
    /// Sleep for the given duration.
    @native("rask_sleep_ns")
    public func sleep(duration: Duration) -> void or SysError {}

    /// Nanoseconds since the UNIX epoch, straight off the OS wall clock.
    /// The one thing `SystemTime` can't compute for itself; everything else
    /// about it is arithmetic on this number.
    @native("rask_time_wall_clock_nanos")
    func wall_clock_nanos() -> i64 {}
}

/// A span of time.
public struct Duration { }

extend Duration {
    /// Create a duration from whole seconds.
    @native("rask_time_Duration_seconds")
    public func seconds(n: i64) -> Duration {}

    /// Create a duration from milliseconds.
    @native("rask_time_Duration_millis")
    public func millis(n: i64) -> Duration {}

    /// Create a duration from microseconds.
    @native("rask_time_Duration_micros")
    public func micros(n: i64) -> Duration {}

    /// Create a duration from nanoseconds.
    @native("rask_time_Duration_nanos")
    public func nanos(n: i64) -> Duration {}

    /// Create a duration from fractional seconds.
    @native("rask_time_Duration_from_secs_f64")
    public func seconds_f64(secs: f64) -> Duration {}

    /// Whole seconds in this duration.
    @native("rask_time_Duration_as_secs")
    public func as_seconds(self) -> u64 {}

    /// Whole milliseconds in this duration.
    @native("rask_time_Duration_as_millis")
    public func as_millis(self) -> u64 {}

    /// Whole microseconds in this duration.
    @native("rask_time_Duration_as_micros")
    public func as_micros(self) -> u64 {}

    /// Nanoseconds in this duration.
    @native("rask_time_Duration_as_nanos")
    public func as_nanos(self) -> u64 {}

    /// Duration as f64 seconds.
    @native("rask_time_Duration_as_secs_f64")
    public func as_seconds_f64(self) -> f64 {}
}

/// A point in monotonic time.
public struct Instant { }

extend Instant {
    /// Capture the current instant.
    @native("rask_time_Instant_now")
    public func now() -> Instant {}

    /// Duration elapsed since this instant was captured.
    @native("rask_time_Instant_elapsed")
    public func elapsed(self) -> Duration {}
}

/// A point in wall-clock time, relative to the UNIX epoch.
/// Subject to NTP adjustments — can go backward. Serializable, unlike Instant.
///
/// Nanoseconds since the epoch, which runs out in 2262. `unix_nanos` widens to
/// `i128` on the way out because the spec asks for it, not because the range is
/// there.
public struct SystemTime {
    nanos: i64
}

extend SystemTime {
    /// Capture the current wall-clock time.
    public func now() -> SystemTime {
        return SystemTime { nanos: time.wall_clock_nanos() }
    }

    /// The UNIX epoch: 1970-01-01 00:00:00 UTC.
    public func unix_epoch() -> SystemTime {
        return SystemTime { nanos: 0 }
    }

    /// Reconstruct from a stored seconds-since-epoch timestamp.
    public func from_unix_seconds(seconds: i64) -> SystemTime {
        return SystemTime { nanos: seconds * 1000000000 }
    }

    /// Reconstruct from a stored millis-since-epoch timestamp.
    public func from_unix_millis(millis: i64) -> SystemTime {
        return SystemTime { nanos: millis * 1000000 }
    }

    /// Whole seconds since the UNIX epoch (negative before 1970).
    public func unix_seconds(self) -> i64 {
        return self.nanos / 1000000000
    }

    /// Whole milliseconds since the UNIX epoch.
    public func unix_millis(self) -> i64 {
        return self.nanos / 1000000
    }

    /// Nanoseconds since the UNIX epoch.
    public func unix_nanos(self) -> i128 {
        return self.nanos as i128
    }

    /// Duration since an earlier point. Fails if the clock went backward.
    public func duration_since(self, earlier: SystemTime) -> Duration or TimeError {
        if self.nanos < earlier.nanos {
            return TimeError.Backwards
        }
        return Duration.nanos(self.nanos - earlier.nanos)
    }

    /// Duration since this time was captured. Fails if the clock went backward.
    public func elapsed(self) -> Duration or TimeError {
        return SystemTime.now().duration_since(self)
    }

    /// A6: two wall-clock points name the same moment.
    public func eq(self, other: SystemTime) -> bool {
        return self.nanos == other.nanos
    }

    /// A6: earlier than.
    public func lt(self, other: SystemTime) -> bool {
        return self.nanos < other.nanos
    }

    /// A6: earlier than or the same moment.
    public func le(self, other: SystemTime) -> bool {
        return self.nanos <= other.nanos
    }

    /// A6: later than.
    public func gt(self, other: SystemTime) -> bool {
        return self.nanos > other.nanos
    }

    /// A6: later than or the same moment.
    public func ge(self, other: SystemTime) -> bool {
        return self.nanos >= other.nanos
    }
}

/// A wall-clock read failed because the clock went backward (NTP adjustment).
public enum TimeError {
    Backwards
}

extend TimeError {
    public func message(self) -> string {
        match self {
            TimeError.Backwards => return "clock went backward"
        }
    }
}

/// Timer for delayed and periodic events.
public struct Timer { }

extend Timer {
    /// Create a one-shot timer that fires after the given duration.
    /// Returns a Receiver that will receive () when the timer fires.
    ///
    /// A timer needs the reactor to wake a fiber on a deadline, and the
    /// reactor isn't built (Phase B). Both of these were marked `@native`
    /// against a symbol nobody wrote, so a call type-checked, ran on the
    /// interpreter, and died at codegen with "Function not found: Timer_after"
    /// (#1066).
    @unimplemented
    public func after(duration: Duration) -> Receiver<void> {}

    /// Create a periodic timer that fires at the given interval.
    /// Returns a Receiver that receives () on each tick.
    @unimplemented
    public func interval(duration: Duration) -> Receiver<void> {}
}

// ─── Operators (A1–A8) ──────────────────────────────────────────
//
// type.operator-resolution/OR1: each of these is a pair, and the pair is what
// the operator resolves on. They used to live in the type checker as a
// hand-written `match ("Instant", "sub")` — the one place that could say
// "instant minus instant is a Duration" — because the language had no way to
// write a conformance whose result type depends on the right operand.

/// A1: shift an instant forward.
extend Instant with Add<Duration> {
    type Out = Instant

    @builtin
    public func add(self, span: Duration) -> Instant {}
}

/// A1: shift an instant back.
extend Instant with Sub<Duration> {
    type Out = Instant

    @builtin
    public func sub(self, span: Duration) -> Instant {}
}

/// A2: the span between two instants.
extend Instant with Sub<Instant> {
    type Out = Duration

    @builtin
    public func sub(self, earlier: Instant) -> Duration {}
}

/// A3: durations add and subtract.
extend Duration with Add {
    @builtin
    public func add(self, other: Duration) -> Duration {}
}

extend Duration with Sub {
    @builtin
    public func sub(self, other: Duration) -> Duration {}
}

/// A4: scale a duration. Both directions — `d * 3` and `3 * d`.
extend Duration with Mul<i64> {
    public func mul(self, n: i64) -> Duration {
        return Duration.nanos(self.as_nanos().wrap<i64>() * n)
    }
}

extend i64 with Mul<Duration> {
    type Out = Duration

    public func mul(self, span: Duration) -> Duration {
        return Duration.nanos(span.as_nanos().wrap<i64>() * self)
    }
}

extend Duration with Div<i64> {
    public func div(self, n: i64) -> Duration {
        return Duration.nanos(self.as_nanos().wrap<i64>() / n)
    }
}

/// A5: how many of the second fit in the first, truncated.
extend Duration with Div<Duration> {
    type Out = u64

    public func div(self, other: Duration) -> u64 {
        return self.as_nanos() / other.as_nanos()
    }
}

/// A7: shift a wall-clock point.
extend SystemTime with Add<Duration> {
    type Out = SystemTime

    public func add(self, span: Duration) -> SystemTime {
        return SystemTime { nanos: self.nanos + span.as_nanos().wrap<i64>() }
    }
}

extend SystemTime with Sub<Duration> {
    type Out = SystemTime

    public func sub(self, span: Duration) -> SystemTime {
        return SystemTime { nanos: self.nanos - span.as_nanos().wrap<i64>() }
    }
}

/// A8: the span between two wall-clock points, unchecked — it wraps when
/// `other` is later. `duration_since` is the one that reports the clock going
/// backward.
extend SystemTime with Sub<SystemTime> {
    type Out = Duration

    public func sub(self, other: SystemTime) -> Duration {
        return Duration.nanos(self.nanos - other.nanos)
    }
}
