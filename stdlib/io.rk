import sync.Shared

/// I/O error type — all I/O operations return T or IoError.
public enum IoError {
    NotFound(string)
    PermissionDenied(string)
    AlreadyExists(string)
    BrokenPipe
    ConnectionReset
    TimedOut
    UnexpectedEof
    Other(string)
    /// The task was cancelled while it waited (conc.async/CN3).
    Cancelled
}

extend IoError {
    public func message(self) -> string {
        match self {
            IoError.NotFound(msg) => return "not found: {msg}"
            IoError.PermissionDenied(msg) => return "permission denied: {msg}"
            IoError.AlreadyExists(msg) => return "already exists: {msg}"
            IoError.BrokenPipe => return "broken pipe"
            IoError.ConnectionReset => return "connection reset"
            IoError.TimedOut => return "timed out"
            IoError.UnexpectedEof => return "unexpected end of file"
            IoError.Other(msg) => return msg
            IoError.Cancelled => return "cancelled"
        }
    }

    /// The error for whatever errno the last failed C call left behind.
    ///
    /// Call it immediately after the call that failed — anything in between
    /// can overwrite errno.
    ///
    /// Variant and wording both match what the interpreter builds from Rust's
    /// `std::io::Error`, so one failure reads the same on both backends (#674).
    /// The interpreter keeps the last error its own I/O calls hit and answers
    /// the three natives below from it, so this runs there too.
    public func last_os_error() -> IoError {
        let code = IoError.errno_now()
        let kind = IoError.kind_of(code)
        // The variants without a message first, so the message is only built
        // where it's kept (building it up front leaked it on these paths, #1341).
        if kind == 3 {
            return IoError.BrokenPipe
        }
        if kind == 4 {
            return IoError.ConnectionReset
        }
        if kind == 5 {
            return IoError.TimedOut
        }
        if kind == 8 {
            return IoError.Cancelled
        }
        let msg = IoError.text_of(code)
        if kind == 0 {
            return IoError.NotFound(msg)
        }
        if kind == 1 {
            return IoError.PermissionDenied(msg)
        }
        if kind == 2 {
            return IoError.AlreadyExists(msg)
        }
        return IoError.Other(msg)
    }

    /// errno, which is a macro over a thread-local, so Rask can't name it.
    @native("rask_io_errno")
    @ambient
    func errno_now() -> i32 {}

    /// The variant index for an errno, in declaration order. The E* values
    /// differ across platforms, so the mapping lives in the runtime.
    @native("rask_io_error_kind")
    func kind_of(err: i32) -> i32 {}

    /// "No such file or directory (os error 2)": the shape Rust's
    /// `std::io::Error` prints.
    @native("rask_io_error_message")
    func text_of(err: i32) -> string {}
}

/// Readable stream: bytes in, `IoError` out. `read`/`read_bytes`/`read_text`
/// mirror the Writer trio (specs/stdlib/io.md R1-R4).
public interface Reader {
    /// `buf` is `mutate` because that's the whole point of `read` — it fills
    /// the caller's buffer. Without it the interface was unimplementable: any body
    /// that wrote into `buf` was rejected as mutating a read-only parameter.
    func read(self, mutate buf: Vec<u8>) -> usize or IoError
    func read_bytes(self) -> Vec<u8> or IoError

    /// Everything left, as UTF-8 (R3). One body for every reader: which bytes
    /// are legal and what a bad one reports is not something each stream
    /// should decide for itself.
    func read_text(self) -> string or IoError {
        let bytes = try self.read_bytes()
        let text = string.from_utf8(bytes) catch e => {
            return IoError.Other("stream is not valid UTF-8: {e.message()}")
        }
        return text
    }

    /// Fill all of `buf`, or fail with `UnexpectedEof` (R4). Built on `read`,
    /// which may hand back fewer bytes than asked for at any call.
    func read_exact(self, mutate buf: Vec<u8>) -> void or IoError {
        let want = buf.len()
        mut filled: usize = 0
        while filled < want {
            mut chunk = zeroed(want - filled)
            let n = try self.read(mutate chunk)
            if n == 0 {
                return IoError.UnexpectedEof
            }
            for i in 0..n {
                buf[filled + i] = chunk[i]
            }
            filled = filled + n
        }
        return
    }
}

/// Writable stream: bytes out, `IoError` back. Mirror of Reader (W1-W4).
public interface Writer {
    func write(self, data: Vec<u8>) -> usize or IoError
    func write_bytes(self, data: Vec<u8>) -> void or IoError
    func write_text(self, data: string) -> void or IoError
    /// Push anything the writer is holding to where it's going (W3). A
    /// writer that holds nothing says so with an empty body.
    func flush(self) -> void or IoError
}

/// Where a seek measures from (std.io/K2).
public enum SeekFrom {
    Start(i64)
    End(i64)
    Current(i64)
}

/// A stream whose position can be moved (K1, K3).
///
/// `File` and `Buffer` implement it. The standard streams don't — they are
/// sequential, and there is nothing to seek.
public interface Seeker {
    func seek(self, pos: SeekFrom) -> i64 or IoError
    func position(self) -> i64 or IoError
}

/// Input/output module functions.
struct io { }

extend io {
    /// Read a line of text from standard input.
    @native("rask_io_read_line")
    @blocks
    public func read_line() -> string or IoError {}

    /// Acquire a handle to standard input.
    public func stdin() -> Stdin {
        return Stdin(stream: 0)
    }

    /// Acquire a handle to standard output.
    public func stdout() -> Stdout {
        return Stdout(stream: 1)
    }

    /// Acquire a handle to standard error.
    public func stderr() -> Stderr {
        return Stderr(stream: 2)
    }

    /// The standard streams go through stdio rather than `write(2)`, so a
    /// handle's output interleaves with `println` in the order the program
    /// wrote it. `println` is buffered; a raw fd write would jump the queue.
    ///
    /// The stream number comes off the handle: 0 = stdin, 1 = stdout,
    /// 2 = stderr. Bytes written, or -1.
    @native("rask_io_std_write_text")
    @blocks
    func write_std_text(stream: i32, data: string) -> i64 {}

    /// The same, for bytes that needn't be UTF-8.
    @native("rask_io_std_write_bytes")
    @blocks
    func write_std_bytes(stream: i32, data: Vec<u8>) -> i64 {}

    /// Push what stdio is holding. 0, or -1.
    @native("rask_io_std_flush")
    @blocks
    func flush_std(stream: i32) -> i64 {}

    /// Read up to `max` bytes from standard input, stopping at end of input.
    @native("rask_io_std_read_bytes")
    @blocks
    func read_std_bytes(max: i64) -> Vec<u8> {}

    /// Copy all bytes from reader to writer. Returns total bytes copied.
    ///
    /// C1: no handles to acquire. Written in Rask over the two interfaces, so any
    /// Reader/Writer pair works and both backends agree. A chunk at a time, so
    /// a stream bigger than memory copies too; the total is a `u64` for the
    /// same reason — it counts bytes that went past, not bytes held.
    public func copy(reader: any Reader, writer: any Writer) -> u64 or IoError {
        mut chunk = zeroed(8192)
        mut total: u64 = 0
        loop {
            let n = try reader.read(mutate chunk)
            if n == 0 {
                return total
            }
            mut part: Vec<u8> = Vec.with_capacity(n)
            for i in 0..n {
                part.push(chunk[i])
            }
            try writer.write_bytes(part)
            total = total + n.wrap<u64>()
        }
    }
}

/// Standard input handle. Implements Reader. Must be consumed via close().
///
/// The `stream` field is what a native entry point needs to know which stream
/// it is talking to. All three handles were empty structs with `@native` on
/// every method and no implementation behind any of them, so the stream number
/// had nowhere to live (#859).
@resource
public struct Stdin {
    stream: i32
}

Stdin implements Reader {
    /// Read bytes into buffer. Returns number of bytes read (0 = EOF).
    public func read(self, mutate buf: Vec<u8>) -> usize or IoError {
        let want = buf.len()
        if want == 0 {
            return 0
        }
        let got = io.read_std_bytes(want.wrap<i64>())
        let n = got.len()
        for i in 0..n {
            buf[i] = got[i]
        }
        return n
    }

    /// Read all remaining bytes.
    public func read_bytes(self) -> Vec<u8> or IoError {
        // Standard input has no length to ask for, so "everything" needs a
        // bound. 16 MiB is far past any interactive or piped input, and small
        // enough that a runaway producer can't exhaust memory.
        return io.read_std_bytes(16777216)
    }
}

extend Stdin {
    /// Read a single line from stdin.
    @blocks
    public func read_line(self) -> string or IoError {
        return io.read_line()
    }

    /// Close the handle.
    ///
    /// `take self`, not `mutate self`: the handle is `@resource`, so it has to
    /// be consumed exactly once before scope exit, and a `mutate` receiver
    /// consumes nothing. Every program that acquired a standard stream failed
    /// to compile with "resource must be consumed before scope exit" even with
    /// `close()` right there (#859).
    public func close(take self) -> void {
        return
    }
}

/// Standard output handle. Implements Writer. Must be consumed via close().
@resource
public struct Stdout {
    stream: i32
}

Stdout implements Writer {
    /// Write bytes. Returns number of bytes written.
    public func write(self, data: Vec<u8>) -> usize or IoError {
        let n = io.write_std_bytes(self.stream, data)
        if n < 0 {
            return IoError.last_os_error()
        }
        return n.wrap<usize>()
    }

    /// Write all bytes, retrying partial writes.
    public func write_bytes(self, data: Vec<u8>) -> void or IoError {
        let _ = try self.write(data)
        return
    }

    /// Write a string.
    public func write_text(self, s: string) -> void or IoError {
        let n = io.write_std_text(self.stream, s)
        if n < 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// Push what stdio is holding.
    public func flush(self) -> void or IoError {
        if io.flush_std(self.stream) < 0 {
            return IoError.last_os_error()
        }
        return
    }
}

extend Stdout {
    /// Close the handle. See `Stdin.close` for why it takes `self`.
    ///
    /// The stream itself stays open — closing the process's own stdout is not
    /// what `close` on a borrowed standard stream should mean. What it does is
    /// discharge the linearity obligation, and flush, so nothing written
    /// through the handle is still sitting in a buffer when it goes away.
    public func close(take self) -> void {
        let _ = io.flush_std(self.stream)
        return
    }
}

/// Standard error handle. Implements Writer. Must be consumed via close().
@resource
public struct Stderr {
    stream: i32
}

Stderr implements Writer {
    /// Write bytes. Returns number of bytes written.
    public func write(self, data: Vec<u8>) -> usize or IoError {
        let n = io.write_std_bytes(self.stream, data)
        if n < 0 {
            return IoError.last_os_error()
        }
        return n.wrap<usize>()
    }

    /// Write all bytes, retrying partial writes.
    public func write_bytes(self, data: Vec<u8>) -> void or IoError {
        let _ = try self.write(data)
        return
    }

    /// Write a string.
    public func write_text(self, s: string) -> void or IoError {
        let n = io.write_std_text(self.stream, s)
        if n < 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// Push what stdio is holding.
    public func flush(self) -> void or IoError {
        if io.flush_std(self.stream) < 0 {
            return IoError.last_os_error()
        }
        return
    }
}

extend Stderr {
    /// Close the handle. See `Stdin.close` for why it takes `self`.
    ///
    /// The stream itself stays open — closing the process's own stdout is not
    /// what `close` on a borrowed standard stream should mean. What it does is
    /// discharge the linearity obligation, and flush, so nothing written
    /// through the handle is still sitting in a buffer when it goes away.
    public func close(take self) -> void {
        let _ = io.flush_std(self.stream)
        return
    }
}

/// In-memory buffer implementing both Reader and Writer (B4). Not linear —
/// there's no OS resource behind it.
///
/// The read position lives in a `Shared<i64, Local>` because `Reader` takes
/// `self`, not `mutate self`. Reading has to advance the cursor, and scoped
/// access is how a `self` method changes something.
///
/// Written in Rask rather than native: it's bytes and an index, nothing the
/// machine has to be asked about, so both backends run this source. Before
/// this the whole type was nine `@native` declarations with no implementation
/// anywhere — `Buffer.new()` failed on both backends (#860).
public struct Buffer {
    data: Vec<u8>
    /// `Local`, spelled out: a buffer's read position is reached by one task,
    /// and the strategy is part of the type — a bare `Shared<i64>` would mean
    /// `Readers`, which is a lock this doesn't need and doesn't have.
    pos: Shared<i64, Local>
}

Buffer implements Reader {
    /// Read up to `buf.len()` bytes into `buf`, starting at the read position.
    /// Returns how many were copied — 0 once the buffer is exhausted (R1).
    public func read(self, mutate buf: Vec<u8>) -> usize or IoError {
        let total = self.data.len().wrap<i64>()
        let want = buf.len().wrap<i64>()
        mut copied: i64 = 0
        with self.pos.write() as at {
            mut from = at
            while copied < want && from < total {
                buf.set(copied, self.data.get(from) ?? 0)
                copied = copied + 1
                from = from + 1
            }
            at = from
        }
        return copied.wrap<usize>()
    }

    /// Read everything left, and leave the position at the end (R2).
    public func read_bytes(self) -> Vec<u8> or IoError {
        let total = self.data.len().wrap<i64>()
        mut out: Vec<u8> = Vec.new()
        with self.pos.write() as at {
            mut from = at
            while from < total {
                out.push(self.data.get(from) ?? 0)
                from = from + 1
            }
            at = from
        }
        return out
    }
}

Buffer implements Writer {
    /// Append bytes, and report how many went in (W1). A memory buffer never
    /// writes short, so that's always all of them.
    public func write(self, data: Vec<u8>) -> usize or IoError {
        for byte in data {
            self.data.push(byte)
        }
        return data.len()
    }

    /// Append every byte (W2).
    public func write_bytes(self, data: Vec<u8>) -> void or IoError {
        let _ = try self.write(data)
        return
    }

    /// Append a string's UTF-8 bytes (W4).
    public func write_text(self, s: string) -> void or IoError {
        let len = s.len().wrap<i64>()
        mut i: i64 = 0
        while i < len {
            self.data.push(s.byte_at(i.wrap<usize>()) ?? 0)
            i = i + 1
        }
        return
    }

    /// Nothing to push: the bytes are already where they're going.
    public func flush(self) -> void or IoError {
        return
    }
}

extend Buffer {
    /// Create an empty buffer.
    public func new() -> Buffer {
        return Buffer(data: Vec.new(), pos: Shared.local(0))
    }

    /// Create a buffer initialized with data, position at 0.
    public func from(take data: Vec<u8>) -> Buffer {
        return Buffer(data, pos: Shared.local(0))
    }

    /// Every byte written, from the start — not just what's left to read.
    ///
    /// A copy, not a view, so `to_` rather than `as_`: the name says the cost
    /// (`canonical-patterns`). A borrowed slice into a struct field isn't
    /// something Rask can express yet (#492), and a copy that says so beats a
    /// name that promises otherwise.
    public func to_bytes(self) -> Vec<u8> {
        return self.data.clone()
    }

    /// Total bytes written.
    public func len(self) -> usize {
        return self.data.len()
    }
}

/// K1–K3 for a file: the position the OS keeps, with the `SeekFrom` taken
/// apart here rather than in each backend.
File implements Seeker {
    public func seek(self, pos: SeekFrom) -> i64 or IoError {
        mut whence: i64 = 0
        mut offset: i64 = 0
        match pos {
            SeekFrom.Start(n) => {
                whence = 0
                offset = n
            }
            SeekFrom.End(n) => {
                whence = 1
                offset = n
            }
            SeekFrom.Current(n) => {
                whence = 2
                offset = n
            }
        }
        // A negative absolute position is rejected here rather than by either
        // backend: C's `fseek` fails on it and Rust's `SeekFrom::Start` takes a
        // `u64` and would clamp, so leaving it to them is a divergence.
        if whence == 0 && offset < 0 {
            return IoError.Other("seek to a negative position")
        }
        let at = self.seek_raw(whence, offset)
        if at < 0 {
            return IoError.last_os_error()
        }
        return at
    }
    public func position(self) -> i64 or IoError {
        let at = self.position_raw()
        if at < 0 {
            return IoError.last_os_error()
        }
        return at
    }
}

/// Seeking a buffer is arithmetic on the cursor it already keeps (K1–K3).
///
/// There used to be a `reset()` stub here instead, which the spec says
/// shouldn't exist — "no `reset` — `buf.seek(SeekFrom.Start(0))` is the one way
/// to rewind" — and which nothing implemented either. So it is gone and this is
/// the spelling.
Buffer implements Seeker {
    public func seek(self, pos: SeekFrom) -> i64 or IoError {
        let total = self.data.len().wrap<i64>()
        mut want: i64 = 0
        match pos {
            SeekFrom.Start(n) => want = n
            SeekFrom.End(n) => want = total + n
            SeekFrom.Current(n) => {
                with self.pos.read() as at {
                    want = at + n
                }
            }
        }
        // Past the end is legal for a seek and reads as empty; before the
        // start is not — there is no position there to report.
        if want < 0 {
            return IoError.Other("seek to a negative position")
        }
        with self.pos.write() as at {
            at = want
        }
        return want
    }
    public func position(self) -> i64 or IoError {
        with self.pos.read() as at {
            return at
        }
    }
}

/// A file handle for reading and writing. A resource: every opened file is
/// closed exactly once, and the compiler checks it.
@resource
@handle
public struct File { }

/// F2: a file is a stream like any other. `read_text` and `read_exact` come
/// from the interface.
File implements Reader {
    /// Read up to `buf.len()` bytes from the current position. 0 at the end.
    public func read(self, mutate buf: Vec<u8>) -> usize or IoError {
        let want = buf.len()
        if want == 0 {
            return 0
        }
        if self.read_some_raw(want.wrap<i64>()) is Vec<u8> as got {
            let n = got.len()
            for i in 0..n {
                buf[i] = got[i]
            }
            return n
        }
        return IoError.last_os_error()
    }

    /// Read from the current position to the end.
    public func read_bytes(self) -> Vec<u8> or IoError {
        if self.read_bytes_raw() is Vec<u8> as bytes {
            return bytes
        }
        return IoError.last_os_error()
    }
}

File implements Writer {
    /// Write every byte of `data`; a file never takes a short write that a
    /// retry would finish, so the count is all of them.
    public func write(self, data: Vec<u8>) -> usize or IoError {
        try self.write_bytes(data)
        return data.len()
    }

    /// Write all bytes, retrying partial writes.
    public func write_bytes(self, data: Vec<u8>) -> void or IoError {
        if self.write_bytes_raw(data) != 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// Write a string's UTF-8 bytes.
    public func write_text(self, data: string) -> void or IoError {
        if self.write_raw(data) != 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// Hand what stdio is holding to the OS.
    public func flush(self) -> void or IoError {
        if self.flush_raw() != 0 {
            return IoError.last_os_error()
        }
        return
    }
}

extend File {
    /// The two halves of `Seeker`, as the backends see them: a position or -1.
    /// The interface methods below turn -1 into an `IoError` and take the
    /// `SeekFrom` apart, which is work neither backend should be doing.
    @native("rask_file_seek")
    @blocks
    func seek_raw(self, whence: i64, offset: i64) -> i64 {}
    @native("rask_file_position")
    @blocks
    func position_raw(self) -> i64 {}

    /// Write a string followed by a newline.
    public func write_line(self, data: string) -> void or IoError {
        if self.write_line_raw(data) != 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// Close the file handle. Buffered bytes reach the disk here, so this is
    /// where a full disk usually says so.
    public func close(take self) -> void or IoError {
        if self.close_raw() != 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// The writes, flush and close as the backends see them: 0, or -1 with the
    /// OS error left for `IoError.last_os_error`. The runtime can't build an
    /// `IoError`, so the bodies above do. These used to be the public methods
    /// themselves and returned nothing natively, so a failed write read as a
    /// success.
    @native("rask_file_write")
    @blocks
    func write_raw(self, data: string) -> i64 {}
    @native("rask_file_write_bytes")
    @blocks
    func write_bytes_raw(self, data: Vec<u8>) -> i64 {}
    @native("rask_file_write_line")
    @blocks
    func write_line_raw(self, data: string) -> i64 {}
    @native("rask_file_flush")
    @blocks
    func flush_raw(self) -> i64 {}
    @native("rask_file_close")
    @blocks
    func close_raw(self) -> i64 {}

    /// The read as the backends see it: `none` when it failed, with the OS
    /// error left for `IoError.last_os_error`. It used to be `read_bytes`
    /// itself, and natively a failure came back with the raw -1 as its error,
    /// which trapped when matched as an `IoError` (#1340).
    @native("rask_file_read_bytes")
    @blocks
    func read_bytes_raw(self) -> Vec<u8>? {}

    /// One read of up to `max` bytes: empty at the end of the file, `none`
    /// when it failed.
    @native("rask_file_read_some")
    @blocks
    func read_some_raw(self, max: i64) -> Vec<u8>? {}
}

// ─── Buffered wrappers ──────────────────────────────────────

/// A zero-filled buffer of `n` bytes, the shape `read` fills.
func zeroed(n: usize) -> Vec<u8> {
    mut out: Vec<u8> = Vec.with_capacity(n)
    for _ in 0..n {
        out.push(0)
    }
    return out
}

/// A `Reader` that reads its inner reader a chunk at a time (B1), so small
/// reads and lines don't each cost a call into the stream.
///
/// What's held is `held[at..]`. Both live in a `Shared<_, Local>` for the
/// reason `Buffer`'s cursor does: `Reader` takes `self`, and reading has to
/// change them. Two boxes rather than one holding a struct, because a box
/// holding a struct with a `Vec` in it never frees the `Vec` natively (#1571).
public struct BufferedReader<R: Reader> {
    inner: R
    capacity: usize
    held: Shared<Vec<u8>, Local>
    at: Shared<usize, Local>
}

extend BufferedReader<R> {
    /// Wrap `inner` with an 8 KiB buffer.
    public func new(take inner: R) -> BufferedReader<R> {
        return BufferedReader.with_capacity(8192, inner)
    }

    /// Wrap `inner`, reading `capacity` bytes at a time. 0 reads one.
    public func with_capacity(capacity: usize, take inner: R) -> BufferedReader<R> {
        let cap = if capacity == 0 { 1 } else { capacity }
        return BufferedReader(inner, capacity: cap, held: Shared.local(Vec.new()), at: Shared.local(0))
    }

    /// The next line, without its `\n` or `\r\n`. A last line with no newline
    /// still counts; past the end is `UnexpectedEof`, as `io.read_line` says it.
    public func read_line(self) -> string or IoError {
        mut line: Vec<u8> = Vec.new()
        loop {
            if (try self.fill()) == 0 {
                if line.is_empty() {
                    return IoError.UnexpectedEof
                }
                break
            }
            let b = next_held(self.held, self.at) ?? 10
            if b == 10 {
                break
            }
            line.push(b)
        }
        if !line.is_empty() && line[line.len() - 1] == 13 {
            line.pop()
        }
        let text = string.from_utf8(line) catch e => {
            return IoError.Other("stream is not valid UTF-8: {e.message()}")
        }
        return text
    }

    /// Every line left, read as the loop asks for them. Ends at the end of
    /// the stream; a failed read is yielded once and ends it too.
    public func lines(self) -> Sequence<string or IoError> {
        return |yield| {
            loop {
                let line = self.read_line() catch e => {
                    if e != IoError.UnexpectedEof {
                        yield(line_error(e))
                    }
                    return
                }
                if !yield(line_ok(line)) {
                    return
                }
            }
        }
    }

    /// Unwrap the reader. Bytes already read into the buffer and not handed
    /// out are dropped with it.
    public func take(take self) -> R {
        return self.inner
    }

    /// How many bytes are held, reading a chunk from `inner` when none are.
    /// 0 is the end of the stream.
    func fill(self) -> usize or IoError {
        let left = held_count(self.held, self.at)
        if left > 0 {
            return left
        }
        mut chunk = zeroed(self.capacity)
        let n = try self.inner.read(mutate chunk)
        // Refilled in place. Workaround: assigning a new Vec to `h` leaks the
        // old one natively (#1626).
        with self.held.write() as h {
            h.clear()
            for i in 0..n {
                h.push(chunk[i])
            }
        }
        with self.at.write() as a {
            a = 0
        }
        return n
    }
}

/// How many of `held` are past `at`: held and not handed out yet.
///
/// Free functions over the two boxes, not methods: a private method that calls
/// another on `self` is taken to mutate it (GC9), and `read`, which takes
/// `self`, couldn't call one.
func held_count(held: Shared<Vec<u8>, Local>, at: Shared<usize, Local>) -> usize {
    mut total: usize = 0
    with held.read() as h {
        total = h.len()
    }
    mut from: usize = 0
    with at.read() as a {
        from = a
    }
    return total - from
}

/// Hand out the next held byte, if there is one.
func next_held(held: Shared<Vec<u8>, Local>, at: Shared<usize, Local>) -> u8? {
    mut from: usize = 0
    with at.read() as a {
        from = a
    }
    mut b: u8? = none
    with held.read() as h {
        if from < h.len() {
            b = h[from]
        }
    }
    if b is u8 {
        with at.write() as a {
            a = from + 1
        }
    }
    return b
}

func line_ok(line: string) -> string or IoError {
    return line
}

func line_error(e: IoError) -> string or IoError {
    return e
}

BufferedReader<R> implements Reader {
    /// Up to `buf.len()` bytes, from what's held first. A read at least as
    /// big as the buffer, with nothing held, goes straight to `inner`.
    public func read(self, mutate buf: Vec<u8>) -> usize or IoError {
        let want = buf.len()
        if want == 0 {
            return 0
        }
        if held_count(self.held, self.at) == 0 && want >= self.capacity {
            return self.inner.read(mutate buf)
        }
        if (try self.fill()) == 0 {
            return 0
        }
        mut copied: usize = 0
        while copied < want {
            let b = next_held(self.held, self.at) ?? {
                break
            }
            buf[copied] = b
            copied = copied + 1
        }
        return copied
    }

    /// What's held, then everything left in `inner`.
    public func read_bytes(self) -> Vec<u8> or IoError {
        mut out: Vec<u8> = Vec.new()
        while next_held(self.held, self.at) is u8 as b {
            out.push(b)
        }
        let rest = try self.inner.read_bytes()
        for b in rest {
            out.push(b)
        }
        return out
    }
}

/// A `Writer` that collects small writes and hands them to its inner writer
/// a buffer at a time (B2). Bytes reach `inner` when the buffer fills, on
/// `flush()`, and on `take()`.
public struct BufferedWriter<W: Writer> {
    inner: W
    capacity: usize
    held: Shared<Vec<u8>, Local>
}

extend BufferedWriter<W> {
    /// Wrap `inner` with an 8 KiB buffer.
    public func new(take inner: W) -> BufferedWriter<W> {
        return BufferedWriter.with_capacity(8192, inner)
    }

    /// Wrap `inner`, holding up to `capacity` bytes before writing them.
    public func with_capacity(capacity: usize, take inner: W) -> BufferedWriter<W> {
        return BufferedWriter(inner, capacity, held: Shared.local(Vec.new()))
    }

    /// Unwrap the writer, flushing what's held first. Best effort, as B2
    /// says a drop is: call `flush()` before this when the error matters.
    public func take(take self) -> W {
        let _ = self.flush()
        return self.inner
    }

    /// Write out what's held, and hold nothing.
    func write_held(self) -> void or IoError {
        mut out: Vec<u8> = Vec.new()
        with self.held.write() as h {
            out = h.clone()
            h.clear()
        }
        if !out.is_empty() {
            try self.inner.write_bytes(out)
        }
        return
    }
}

BufferedWriter<W> implements Writer {
    /// Take all of `data` (W1): a buffered writer never writes short.
    public func write(self, data: Vec<u8>) -> usize or IoError {
        try self.write_bytes(data)
        return data.len()
    }

    /// Hold `data`, writing out what's held first if it wouldn't fit. Data at
    /// least as big as the buffer goes straight through.
    public func write_bytes(self, data: Vec<u8>) -> void or IoError {
        mut held: usize = 0
        with self.held.read() as h {
            held = h.len()
        }
        if held + data.len() > self.capacity {
            try self.write_held()
        }
        if data.len() >= self.capacity {
            return self.inner.write_bytes(data)
        }
        with self.held.write() as h {
            for b in data {
                h.push(b)
            }
        }
        return
    }

    /// A string's UTF-8 bytes, held like any others.
    public func write_text(self, data: string) -> void or IoError {
        mut bytes: Vec<u8> = Vec.with_capacity(data.len())
        for b in data.bytes() {
            bytes.push(b)
        }
        return self.write_bytes(bytes)
    }

    /// Write out what's held, then flush `inner` (W3).
    public func flush(self) -> void or IoError {
        try self.write_held()
        return self.inner.flush()
    }
}
