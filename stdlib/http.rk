// SPDX-License-Identifier: (MIT OR Apache-2.0)

// HTTP/1.1 client and server.
//
// Convenience functions for simple requests, HttpClient for configuration,
// HttpServer for accept loops with linear response handles. Request parsing
// and response formatting are implemented in Rask; socket I/O delegates to
// the C runtime.

import async.spawn
import net

// ─── Types ───────────────────────────────────────────────────────

enum Method {
    Get
    Head
    Post
    Put
    Delete
    Patch
    Options
}

extend Method {
    // Parse an HTTP method string into a Method enum.
    // Uses byte-level matching because stdlib code doesn't go through
    // the desugar pass, so string == does pointer comparison (not content).
    public func from_string(s: string) -> Method? {
        let len = s.len()
        if len == 3 && (s.byte_at(0) ?? 0) == 71 && (s.byte_at(1) ?? 0) == 69 && (s.byte_at(2) ?? 0) == 84 {
            return Method.Get    // GET
        }
        if len == 4 && (s.byte_at(0) ?? 0) == 72 && (s.byte_at(1) ?? 0) == 69 && (s.byte_at(2) ?? 0) == 65 && (s.byte_at(3) ?? 0) == 68 {
            return Method.Head   // HEAD
        }
        if len == 4 && (s.byte_at(0) ?? 0) == 80 && (s.byte_at(1) ?? 0) == 79 && (s.byte_at(2) ?? 0) == 83 && (s.byte_at(3) ?? 0) == 84 {
            return Method.Post   // POST
        }
        if len == 3 && (s.byte_at(0) ?? 0) == 80 && (s.byte_at(1) ?? 0) == 85 && (s.byte_at(2) ?? 0) == 84 {
            return Method.Put    // PUT
        }
        if len == 6 && (s.byte_at(0) ?? 0) == 68 && (s.byte_at(1) ?? 0) == 69 && (s.byte_at(2) ?? 0) == 76 {
            return Method.Delete // DELETE (check first 3 bytes)
        }
        if len == 5 && (s.byte_at(0) ?? 0) == 80 && (s.byte_at(1) ?? 0) == 65 && (s.byte_at(2) ?? 0) == 84 {
            return Method.Patch  // PATCH (check first 3 bytes)
        }
        if len == 7 && (s.byte_at(0) ?? 0) == 79 && (s.byte_at(1) ?? 0) == 80 && (s.byte_at(2) ?? 0) == 84 {
            return Method.Options // OPTIONS (check first 3 bytes)
        }
        return none
    }

}

// std.fmt/D3: an enum opts into Displayable by declaring the conformance — a
// bare `extend` with a `to_string` in it doesn't count. Without this header
// `format_http_request` couldn't call `req.method.to_string()`, so `rask check
// stdlib/fmt.rk` failed on a stdlib file.
extend Method with Displayable {
    // Serialize to the standard HTTP method string.
    public func to_string(self) -> string {
        match self {
            Method.Get => return "GET",
            Method.Head => return "HEAD",
            Method.Post => return "POST",
            Method.Put => return "PUT",
            Method.Delete => return "DELETE",
            Method.Patch => return "PATCH",
            Method.Options => return "OPTIONS",
        }
    }
}

// Case-insensitive header map.
struct Headers {
    entries: Map<string, string>
}

extend Headers {
    public func new() -> Headers {
        return Headers { entries: Map.new() }
    }

    public func get(self, name: string) -> string? {
        // Case-insensitive: lowercase the key for lookup
        return self.entries.get(name.to_lowercase())
    }

    public func set(mutate self, name: string, value: string) -> void {
        self.entries.insert(name.to_lowercase(), value)
    }

    public func has(self, name: string) -> bool {
        return self.entries.contains_key(name.to_lowercase())
    }

    public func remove(mutate self, name: string) -> string? {
        return self.entries.remove(name.to_lowercase())
    }

    public func len(self) -> usize {
        return self.entries.len()
    }

    public func iter(self) -> Iterator<(string, string)> {
        return self.entries.iter()
    }
}

struct Request {
    public method: Method
    public url: string
    public headers: Headers
    public body: string
}

extend Request {
    public func new(method: Method, url: string) -> Request {
        return Request {
            method: method,
            url: url,
            headers: Headers.new(),
            body: "",
        }
    }

    public func with_header(take self, name: string, value: string) -> Request {
        self.headers.set(name, value)
        return self
    }

    public func with_body(take self, body: string) -> Request {
        return Request {
            method: self.method,
            url: self.url,
            headers: self.headers,
            body: body,
        }
    }

    // URL path before '?'.
    public func path(self) -> string {
        let qpos = self.url.index_of("?") ?? return self.url
        return self.url[0..qpos].to_string()
    }

    // Single query parameter by name.
    public func query_param(self, name: string) -> string? {
        let params = self.query_params()
        return params.get(name)
    }

    // All query parameters as a map.
    // Keys and values are copied out: the map outlives the slices `split`
    // hands back, which are views into `self.url`.
    public func query_params(self) -> Map<string, string> {
        mut result = Map<string, string>.new()
        let qpos = self.url.index_of("?")
        if qpos? as qp {
            let query = self.url[qp + 1..].to_string()
            for pair in query.split("&") {
                let item = pair.to_string()
                if item.is_empty() {
                    continue
                }
                let eq = item.index_of("=")
                if eq? as eqpos {
                    let key = item[0..eqpos].to_string()
                    let value = item[eqpos + 1..].to_string()
                    result.insert(key, value)
                } else {
                    result.insert(item, "")
                }
            }
        }
        return result
    }
}

struct Response {
    public status: u16
    public headers: Headers
    public body: string
}

extend Response {
    // ── Constructors ──

    public func new(status: u16, body: string) -> Response {
        return Response {
            status: status,
            headers: Headers.new(),
            body: body,
        }
    }

    public func ok(body: string) -> Response {
        return Response.new(200, body)
    }

    public func json(body: string) -> Response {
        mut resp = Response.new(200, body)
        resp.headers.set("Content-Type", "application/json")
        return resp
    }

    public func created(body: string) -> Response {
        return Response.new(201, body)
    }

    public func no_content() -> Response {
        return Response.new(204, "")
    }

    public func not_found() -> Response {
        return Response.new(404, "")
    }

    public func bad_request(message: string) -> Response {
        return Response.new(400, message)
    }

    public func internal_error(message: string) -> Response {
        return Response.new(500, message)
    }

    public func redirect(url: string) -> Response {
        mut resp = Response.new(302, "")
        resp.headers.set("Location", url)
        return resp
    }

    // ── Builder ──

    public func with_status(take self, status: u16) -> Response {
        return Response {
            status: status,
            headers: self.headers,
            body: self.body,
        }
    }

    public func with_header(take self, name: string, value: string) -> Response {
        self.headers.set(name, value)
        return self
    }

    // ── Status checks ──

    public func is_ok(self) -> bool {
        return self.status >= 200 && self.status <= 299
    }

    public func is_redirect(self) -> bool {
        return self.status >= 300 && self.status <= 399
    }

    public func is_client_error(self) -> bool {
        return self.status >= 400 && self.status <= 499
    }

    public func is_server_error(self) -> bool {
        return self.status >= 500 && self.status <= 599
    }

    public func is_error(self) -> bool {
        return self.status >= 400 && self.status <= 599
    }
}

// ─── Errors ──────────────────────────────────────────────────────

enum HttpError {
    InternalServerError(string)
    ConnectionFailed(string)
    Timeout
    InvalidUrl(string)
    InvalidResponse(string)
    TooManyRedirects
    Io(string)
    NotFound
}

extend HttpError {
    public func message(self) -> string {
        match self {
            HttpError.InternalServerError(msg) => return "internal server error: {msg}",
            HttpError.ConnectionFailed(msg) => return "connection failed: {msg}",
            HttpError.Timeout => return "request timed out",
            HttpError.InvalidUrl(msg) => return "invalid URL: {msg}",
            HttpError.InvalidResponse(msg) => return "invalid response: {msg}",
            HttpError.TooManyRedirects => return "too many redirects",
            HttpError.Io(msg) => return "I/O error: {msg}",
            HttpError.NotFound => return "not found",
        }
    }
}


// ─── HTTP/1.1 Parser ─────────────────────────────────────────────
//
// Parses raw HTTP/1.1 request bytes into a Request struct.
// Handles: request line, headers, body (via Content-Length).

// Parse a raw HTTP/1.1 request string into a Request.
func parse_http_request(raw: string) -> Request or HttpError {
    let len = raw.len()
    if len == 0 {
        return HttpError.InvalidResponse("empty request")
    }

    // Find end of request line (first \r\n)
    mut line_end: usize = 0
    while line_end + 1 < len {
        if (raw.byte_at(line_end) ?? 0) == 13 && (raw.byte_at(line_end + 1) ?? 0) == 10 {
            break
        }
        line_end += 1
    }
    let request_line = raw[0..line_end].to_string()

    // Parse request line: "METHOD PATH HTTP/1.1"
    mut first_sp: usize = 0
    while first_sp < line_end && (raw.byte_at(first_sp) ?? 0) != 32 {
        first_sp += 1
    }
    mut second_sp = first_sp + 1
    while second_sp < line_end && (raw.byte_at(second_sp) ?? 0) != 32 {
        second_sp += 1
    }

    // Slices are temporary views into `raw`, which goes away when this function
    // returns — anything kept in the Request has to be copied out (the checker
    // rejects storing a slice; stdlib code slipped past it and every request
    // arrived with an empty path and body).
    let method_str = raw[0..first_sp].to_string()
    let path = raw[first_sp + 1..second_sp].to_string()

    let method = Method.from_string(method_str)
        ?? return HttpError.InvalidResponse("unknown HTTP method")

    // Parse headers: starts after first \r\n, ends at \r\n\r\n
    mut headers = Headers.new()
    mut pos = line_end + 2  // skip past \r\n
    mut header_end = pos

    while pos + 1 < len {
        if (raw.byte_at(pos) ?? 0) == 13 && (raw.byte_at(pos + 1) ?? 0) == 10 {
            header_end = pos
            pos += 2
            break
        }

        mut hline_end = pos
        while hline_end + 1 < len {
            if (raw.byte_at(hline_end) ?? 0) == 13 && (raw.byte_at(hline_end + 1) ?? 0) == 10 {
                break
            }
            hline_end += 1
        }

        mut colon = pos
        while colon < hline_end {
            if (raw.byte_at(colon) ?? 0) == 58 && colon + 1 < hline_end && (raw.byte_at(colon + 1) ?? 0) == 32 {
                break
            }
            colon += 1
        }

        if colon < hline_end {
            let hname = raw[pos..colon].to_string()
            let hvalue = raw[colon + 2..hline_end].to_string()
            headers.set(hname, hvalue)
        }

        pos = hline_end + 2
    }

    let body = if pos < len {
        raw[pos..].to_string()
    } else {
        ""
    }

    return Request {
        method: method,
        url: path,
        headers: headers,
        body: body,
    }
}

// ─── HTTP/1.1 Response Formatter ─────────────────────────────────

func reason_phrase(status: u16) -> string {
    match status {
        200 => return "OK",
        201 => return "Created",
        204 => return "No Content",
        301 => return "Moved Permanently",
        302 => return "Found",
        304 => return "Not Modified",
        400 => return "Bad Request",
        401 => return "Unauthorized",
        403 => return "Forbidden",
        404 => return "Not Found",
        405 => return "Method Not Allowed",
        408 => return "Request Timeout",
        409 => return "Conflict",
        413 => return "Payload Too Large",
        422 => return "Unprocessable Entity",
        429 => return "Too Many Requests",
        500 => return "Internal Server Error",
        502 => return "Bad Gateway",
        503 => return "Service Unavailable",
        504 => return "Gateway Timeout",
        _ => return "Unknown",
    }
}

// Format an HTTP/1.1 response into a raw byte string for the wire.
func format_http_response(resp: Response) -> string {
    mut out = StringBuilder.new()

    // Status line
    out.push("HTTP/1.1 ")
    out.push(resp.status.to_string())
    out.push(" ")
    out.push(reason_phrase(resp.status))
    out.push("\r\n")

    // Content-Length + end of headers
    out.push("Content-Length: ")
    out.push(resp.body.len().to_string())
    out.push("\r\n\r\n")

    // Body
    out.push(resp.body)

    return out.build()
}

// ─── Socket I/O (C runtime) ─────────────────────────────────────

extern "C" {
    // Both readers fill a string out-param, so they're declared returning
    // `string`. Declared `-> i64` the result stayed an integer and `as string`
    // didn't reinterpret it, so every request body read back as the pointer's
    // decimal value and request parsing failed.
    func rask_io_read_string(fd: i64, max: i64) -> string
    func rask_io_write_string(fd: i64, s: i64) -> i64
    func rask_io_read_until_close(fd: i64, max: i64) -> string
    func rask_net_tcp_connect(addr: i64) -> i64
    func rask_io_close_fd(fd: i64) -> void
}

// Read raw bytes from a TCP connection (up to max_bytes).
func read_raw(conn_fd: i64, max_bytes: i64) -> string {
    return unsafe { rask_io_read_string(conn_fd, max_bytes) }
}

// Write a string to a TCP connection.
func write_raw(conn_fd: i64, data: string) {
    unsafe { rask_io_write_string(conn_fd, data as i64) }
}

// ─── Client Helpers ──────────────────────────────────────────────

// Parse "http://host:port/path" into (host, port, path).
func parse_url(url: string) -> (string, string, string) or HttpError {
    mut rest = url

    // Strip scheme
    if rest.starts_with("http://") {
        rest = rest[7..].to_string()
    } else if rest.starts_with("https://") {
        return HttpError.InvalidUrl("HTTPS not supported yet")
    }

    // Split host+port from path at first /
    mut host_port = rest
    mut path = "/"
    let slash = rest.index_of("/")
    if slash? as pos {
        host_port = rest[0..pos].to_string()
        path = rest[pos..].to_string()
    }

    // Split host from port at last :
    mut host = host_port
    mut port = "80"
    let colon = host_port.index_of(":")
    if colon? as cpos {
        host = host_port[0..cpos].to_string()
        port = host_port[cpos + 1..].to_string()
    }

    if host.is_empty() {
        return HttpError.InvalidUrl("empty host in URL: {url}")
    }

    return (host, port, path)
}

// Format an HTTP/1.1 request for the wire.
func format_http_request(req: Request, host: string) -> string {
    mut out = StringBuilder.new()

    // Request line
    out.push(req.method.to_string())
    out.push(" ")
    out.push(req.url)
    out.push(" HTTP/1.1\r\n")

    // Host header
    out.push("Host: ")
    out.push(host)
    out.push("\r\n")

    // User headers
    for (name, value) in req.headers.entries.iter() {
        out.push(name)
        out.push(": ")
        out.push(value)
        out.push("\r\n")
    }

    // Connection: close so the server closes after response
    out.push("Connection: close\r\n")

    // Content-Length for bodies
    if req.body.len() > 0 {
        out.push("Content-Length: ")
        out.push(req.body.len().to_string())
        out.push("\r\n")
    }

    out.push("\r\n")
    out.push(req.body)

    return out.build()
}

// Parse raw HTTP/1.1 response bytes into a Response.
func parse_http_response(raw: string) -> Response or HttpError {
    let len = raw.len()
    if len == 0 {
        return HttpError.InvalidResponse("empty response")
    }

    // Find end of status line
    mut line_end: usize = 0
    while line_end + 1 < len {
        if (raw.byte_at(line_end) ?? 0) == 13 && (raw.byte_at(line_end + 1) ?? 0) == 10 {
            break
        }
        line_end += 1
    }

    // Parse status line: "HTTP/1.1 200 OK"
    let status_line = raw[0..line_end].to_string()
    mut first_sp: usize = 0
    while first_sp < line_end && (raw.byte_at(first_sp) ?? 0) != 32 {
        first_sp += 1
    }
    mut second_sp = first_sp + 1
    while second_sp < line_end && (raw.byte_at(second_sp) ?? 0) != 32 {
        second_sp += 1
    }

    let status_str = raw[first_sp + 1..second_sp].to_string()
    let status_val = status_str.parse_int()
        ?? return HttpError.InvalidResponse("bad status code: {status_str}")
    let status = status_val.wrap<u16>()

    // Parse headers
    mut headers = Headers.new()
    mut pos = line_end + 2
    while pos + 1 < len {
        if (raw.byte_at(pos) ?? 0) == 13 && (raw.byte_at(pos + 1) ?? 0) == 10 {
            pos += 2
            break
        }

        mut hline_end = pos
        while hline_end + 1 < len {
            if (raw.byte_at(hline_end) ?? 0) == 13 && (raw.byte_at(hline_end + 1) ?? 0) == 10 {
                break
            }
            hline_end += 1
        }

        mut colon = pos
        while colon < hline_end {
            if (raw.byte_at(colon) ?? 0) == 58 && colon + 1 < hline_end && (raw.byte_at(colon + 1) ?? 0) == 32 {
                break
            }
            colon += 1
        }

        if colon < hline_end {
            let hname = raw[pos..colon].to_string()
            let hvalue = raw[colon + 2..hline_end].to_string()
            headers.set(hname, hvalue)
        }

        pos = hline_end + 2
    }

    // Body is everything after headers
    let body = if pos < len {
        raw[pos..].to_string()
    } else {
        ""
    }

    return Response {
        status: status,
        headers: headers,
        body: body,
    }
}

// Connect, send request, read response, close connection.
// Internal helper — called from extend http {} and extend HttpClient {}.
func _send_request_impl(method: Method, url: string, body: string, extra_headers: Headers) -> Response or HttpError {
    let (host, port, path) = try parse_url(url)
    let addr = "{host}:{port}"

    // Connect
    let conn_fd = unsafe { rask_net_tcp_connect(addr as i64) }
    if conn_fd < 0 {
        return HttpError.ConnectionFailed("cannot connect to {addr}")
    }

    // Build and send request
    mut req = Request.new(method, path)
    for (name, value) in extra_headers.entries.iter() {
        req = req.with_header(name, value)
    }
    if body.len() > 0 {
        req = req.with_body(body)
    }
    let raw_req = format_http_request(req, host)
    write_raw(conn_fd, raw_req)

    // Read response (reads until server closes connection)
    let raw_resp = unsafe { rask_io_read_until_close(conn_fd, 1048576) }

    // Close connection
    unsafe { rask_io_close_fd(conn_fd) }

    return parse_http_response(raw_resp)
}

// ─── Server Integration ──────────────────────────────────────────
//
// These functions wire the pure-Rask parser/formatter into the
// TcpConnection method dispatch, replacing the C HTTP parser.

// Parse HTTP/1.1 request from a TCP connection.
// Shadows the dispatch entry for TcpConnection_read_http_request.
func TcpConnection_read_http_request(conn_fd: i64) -> i64 or HttpError {
    let raw = read_raw(conn_fd, 65536)
    let request = try parse_http_request(raw)

    // Build the legacy struct layout: [method_str, path, body, headers_map]
    // This matches what the codegen expects for HttpRequest struct access.
    // Once the compiler handles the new Request type natively, this shim
    // can be replaced with a direct return.
    return request as i64
}

// Write HTTP/1.1 response to a TCP connection.
// Shadows the dispatch entry for TcpConnection_write_http_response.
func TcpConnection_write_http_response(conn_fd: i64, resp_ptr: i64) -> i64 or HttpError {
    let resp = resp_ptr as Response
    let raw = format_http_response(resp)
    write_raw(conn_fd, raw)
    return 0
}

// ─── Server Types ────────────────────────────────────────────────

@resource
struct HttpServer {
    listener: TcpListener
    addr: string
}

extend HttpServer {
    public func accept(self) -> (Request, Responder) or HttpError {
        let conn = self.listener.accept() catch _ => return HttpError.Io("accept failed")
        let raw = read_raw(conn as i64, 65536)
        let request = parse_http_request(raw)
            catch _ => return HttpError.InvalidResponse("malformed request")
        let responder = Responder { conn_fd: conn as i64, sent: false }
        return (request, responder)
    }

    public func local_addr(self) -> string {
        return self.addr
    }


    public func close(take self) -> void or IoError {
        // Listener cleanup handled by drop
        return
    }
}

@resource
struct Responder {
    conn_fd: i64
    sent: bool
}

extend Responder {
    public func respond(take self, response: Response) -> void or HttpError {
        let raw = format_http_response(response)
        write_raw(self.conn_fd, raw)
    }
}

// ─── Convenience Server ──────────────────────────────────────────

struct http { }

extend http {
    /// Bind a TCP listener and return an `HttpServer` for a manual accept loop.
    /// Parallel to `net.tcp_listen`. The server is a linear resource — close it
    /// with `ensure server.close()`. Each accepted request yields a linear
    /// `Responder` that must send exactly one response.
    public func listen(addr: string) -> HttpServer or HttpError {
        let listener = net.tcp_listen(addr)
            catch _ => return HttpError.ConnectionFailed("failed to bind {addr}")
        return HttpServer { listener: listener, addr: addr }
    }

    /// One-line HTTP server. Spawns a green task per request.
    /// Requires an active `using Multitasking { ... }` scope in the process
    /// (transitively reaches `spawn`).
    public func serve(addr: string, handler: func(Request) -> Response) -> void or HttpError
    {
        mut server = http.listen(addr) catch _ => return HttpError.Io("listen failed")
        ensure server.close()
        loop {
            // A failed accept drops this connection, not the server.
            let (req, responder) = server.accept() catch _ => continue
            // `own` moves req/responder into the task. Borrowing them
            // leaves the task reading this iteration's frame, which the
            // next accept() reuses while the task is still running — the
            // request's method came out as garbage (#474).
            spawn(own || {
                responder.respond(handler(req))
            }).detach()
        }
    }

    public func get(url: string) -> Response or HttpError {
        return _send_request_impl(Method.Get, url, "", Headers.new())
    }

    public func post(url: string, body: string) -> Response or HttpError {
        return _send_request_impl(Method.Post, url, body, Headers.new())
    }

    public func put(url: string, body: string) -> Response or HttpError {
        return _send_request_impl(Method.Put, url, body, Headers.new())
    }

    public func delete(url: string) -> Response or HttpError {
        return _send_request_impl(Method.Delete, url, "", Headers.new())
    }

    public func request(request: Request) -> Response or HttpError {
        return _send_request_impl(request.method, request.url, request.body, request.headers)
    }

    public func send_request(method: Method, url: string, body: string, headers: Headers) -> Response or HttpError {
        return _send_request_impl(method, url, body, headers)
    }
}

// ─── HttpClient ──────────────────────────────────────────────────

struct HttpClient {
    default_headers: Headers
}

extend HttpClient {
    public func new() -> HttpClient {
        return HttpClient { default_headers: Headers.new() }
    }

    public func with_timeout(take self, timeout: Duration) -> HttpClient {
        // Timeout not yet wired to socket options
        return self
    }

    public func with_header(take self, name: string, value: string) -> HttpClient {
        self.default_headers.set(name, value)
        return self
    }

    public func with_max_redirects(take self, n: u32) -> HttpClient {
        // Redirect following not yet implemented
        return self
    }

    public func get(self, url: string) -> Response or HttpError {
        return _send_request_impl(Method.Get, url, "", self.default_headers)
    }

    public func post(self, url: string, body: string) -> Response or HttpError {
        return _send_request_impl(Method.Post, url, body, self.default_headers)
    }

    public func put(self, url: string, body: string) -> Response or HttpError {
        return _send_request_impl(Method.Put, url, body, self.default_headers)
    }

    public func delete(self, url: string) -> Response or HttpError {
        return _send_request_impl(Method.Delete, url, "", self.default_headers)
    }

    public func request(self, request: Request) -> Response or HttpError {
        return _send_request_impl(request.method, request.url, request.body, self.default_headers)
    }
}
