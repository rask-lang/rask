// Content digests (std.digest): SHA-256, SHA-1, MD5, CRC-32. Pure Rask, so both
// backends run the same code. The one-shot functions are the builders with the
// loop written for you (D2).

struct digest { }

extend digest {
    /// SHA-256 (FIPS 180-4). The default choice.
    public func sha256(data: Vec<u8>) -> [u8; 32] {
        mut d = Sha256.new()
        d.update(data)
        return d.build()
    }

    /// SHA-1 (FIPS 180-4). For Git and old formats only: collisions are practical.
    public func sha1(data: Vec<u8>) -> [u8; 20] {
        mut d = Sha1.new()
        d.update(data)
        return d.build()
    }

    /// MD5 (RFC 1321). For formats that specified it only: collisions are cheap.
    public func md5(data: Vec<u8>) -> [u8; 16] {
        mut d = Md5.new()
        d.update(data)
        return d.build()
    }

    /// CRC-32 (IEEE 802.3, as in ZIP, PNG and gzip). Detects corruption, not tampering.
    public func crc32(data: Vec<u8>) -> u32 {
        mut d = Crc32.new()
        d.update(data)
        return d.build()
    }
}

// ── Block buffering, shared by the three 64-byte-block hashes ──────

/// Bytes waiting for a full 64-byte block, and how many came in overall.
struct Blocks {
    buf: [u8; 64]
    len: usize
    total: u64
}

extend Blocks {
    func new() -> Blocks {
        return Blocks(buf: [0; 64], len: 0, total: 0)
    }

    /// Append one byte; true when that completed a block in `buf`.
    func push(mutate self, b: u8) -> bool {
        self.buf[self.len] = b
        self.total = self.total + 1
        if self.len == 63 {
            self.len = 0
            return true
        }
        self.len = self.len + 1
        return false
    }

    /// The tail that ends the message: 0x80, zeros up to 56 mod 64, then the
    /// bit length in eight bytes, big-endian for SHA, little-endian for MD5.
    func padding(self, big_endian: bool) -> Vec<u8> {
        let bits = self.total.wrapping_mul(8)
        let zeros = if self.len < 56 { 55 - self.len } else { 119 - self.len }
        mut out: Vec<u8> = Vec.with_capacity(zeros + 9)
        out.push(128)
        for _ in 0..zeros {
            out.push(0)
        }
        for i in 0..8 {
            let byte = if big_endian { 7 - i } else { i }
            out.push((bits >> (byte * 8).wrap<u64>()).wrap<u8>())
        }
        return out
    }
}

/// Word `i` of a block, four bytes big-endian.
func be_word(buf: [u8; 64], i: usize) -> u32 {
    let at = i * 4
    return (buf[at] as u32) << 24 | (buf[at + 1] as u32) << 16 | (buf[at + 2] as u32) << 8 | (buf[at + 3] as u32)
}

/// Word `i` of a block, four bytes little-endian.
func le_word(buf: [u8; 64], i: usize) -> u32 {
    let at = i * 4
    return (buf[at] as u32) | (buf[at + 1] as u32) << 8 | (buf[at + 2] as u32) << 16 | (buf[at + 3] as u32) << 24
}

// ── SHA-256 ─────────────────────────────────────────────────────────

/// Incremental SHA-256. `update` any number of times, then `build`.
public struct Sha256 {
    h: [u32; 8]
    blocks: Blocks
}

extend Sha256 {
    public func new() -> Sha256 {
        return Sha256(
            h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
            blocks: Blocks.new()
        )
    }

    public func update(mutate self, chunk: Vec<u8>) -> void {
        for b in chunk {
            if self.blocks.push(b) {
                sha256_block(mutate self.h, self.blocks.buf)
            }
        }
    }

    public func build(take self) -> [u8; 32] {
        mut d = self
        d.update(d.blocks.padding(true))
        mut out: [u8; 32] = [0; 32]
        for i in 0..8 {
            out[i * 4] = (d.h[i] >> 24).wrap<u8>()
            out[i * 4 + 1] = (d.h[i] >> 16).wrap<u8>()
            out[i * 4 + 2] = (d.h[i] >> 8).wrap<u8>()
            out[i * 4 + 3] = d.h[i].wrap<u8>()
        }
        return out
    }
}

func sha256_block(mutate h: [u32; 8], buf: [u8; 64]) {
    let k: [u32; 64] = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]
    mut w: [u32; 64] = [0; 64]
    for i in 0..16 {
        w[i] = be_word(buf, i)
    }
    for i in 16..64 {
        let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ w[i - 15] >> 3
        let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ w[i - 2] >> 10
        w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1)
    }
    mut a = h[0]
    mut b = h[1]
    mut c = h[2]
    mut d = h[3]
    mut e = h[4]
    mut f = h[5]
    mut g = h[6]
    mut hh = h[7]
    for i in 0..64 {
        let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25)
        let ch = e & f ^ ~e & g
        let t1 = hh.wrapping_add(s1).wrapping_add(ch).wrapping_add(k[i]).wrapping_add(w[i])
        let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22)
        let maj = a & b ^ a & c ^ b & c
        let t2 = s0.wrapping_add(maj)
        hh = g
        g = f
        f = e
        e = d.wrapping_add(t1)
        d = c
        c = b
        b = a
        a = t1.wrapping_add(t2)
    }
    h[0] = h[0].wrapping_add(a)
    h[1] = h[1].wrapping_add(b)
    h[2] = h[2].wrapping_add(c)
    h[3] = h[3].wrapping_add(d)
    h[4] = h[4].wrapping_add(e)
    h[5] = h[5].wrapping_add(f)
    h[6] = h[6].wrapping_add(g)
    h[7] = h[7].wrapping_add(hh)
}

// ── SHA-1 ───────────────────────────────────────────────────────────

/// Incremental SHA-1. Broken for anything adversarial (D4).
public struct Sha1 {
    h: [u32; 5]
    blocks: Blocks
}

extend Sha1 {
    public func new() -> Sha1 {
        return Sha1(h: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0], blocks: Blocks.new())
    }

    public func update(mutate self, chunk: Vec<u8>) -> void {
        for b in chunk {
            if self.blocks.push(b) {
                sha1_block(mutate self.h, self.blocks.buf)
            }
        }
    }

    public func build(take self) -> [u8; 20] {
        mut d = self
        d.update(d.blocks.padding(true))
        mut out: [u8; 20] = [0; 20]
        for i in 0..5 {
            out[i * 4] = (d.h[i] >> 24).wrap<u8>()
            out[i * 4 + 1] = (d.h[i] >> 16).wrap<u8>()
            out[i * 4 + 2] = (d.h[i] >> 8).wrap<u8>()
            out[i * 4 + 3] = d.h[i].wrap<u8>()
        }
        return out
    }
}

func sha1_block(mutate h: [u32; 5], buf: [u8; 64]) {
    mut w: [u32; 80] = [0; 80]
    for i in 0..16 {
        w[i] = be_word(buf, i)
    }
    for i in 16..80 {
        w[i] = (w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]).rotate_left(1)
    }
    mut a = h[0]
    mut b = h[1]
    mut c = h[2]
    mut d = h[3]
    mut e = h[4]
    for i in 0..80 {
        mut f: u32 = 0
        mut k: u32 = 0
        if i < 20 {
            f = b & c | ~b & d
            k = 0x5a827999
        } else if i < 40 {
            f = b ^ c ^ d
            k = 0x6ed9eba1
        } else if i < 60 {
            f = b & c | b & d | c & d
            k = 0x8f1bbcdc
        } else {
            f = b ^ c ^ d
            k = 0xca62c1d6
        }
        let t = a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[i])
        e = d
        d = c
        c = b.rotate_left(30)
        b = a
        a = t
    }
    h[0] = h[0].wrapping_add(a)
    h[1] = h[1].wrapping_add(b)
    h[2] = h[2].wrapping_add(c)
    h[3] = h[3].wrapping_add(d)
    h[4] = h[4].wrapping_add(e)
}

// ── MD5 ─────────────────────────────────────────────────────────────

/// Incremental MD5. Broken for anything adversarial (D4).
public struct Md5 {
    h: [u32; 4]
    blocks: Blocks
}

extend Md5 {
    public func new() -> Md5 {
        return Md5(h: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476], blocks: Blocks.new())
    }

    public func update(mutate self, chunk: Vec<u8>) -> void {
        for b in chunk {
            if self.blocks.push(b) {
                md5_block(mutate self.h, self.blocks.buf)
            }
        }
    }

    public func build(take self) -> [u8; 16] {
        mut d = self
        d.update(d.blocks.padding(false))
        mut out: [u8; 16] = [0; 16]
        for i in 0..4 {
            out[i * 4] = d.h[i].wrap<u8>()
            out[i * 4 + 1] = (d.h[i] >> 8).wrap<u8>()
            out[i * 4 + 2] = (d.h[i] >> 16).wrap<u8>()
            out[i * 4 + 3] = (d.h[i] >> 24).wrap<u8>()
        }
        return out
    }
}

func md5_block(mutate h: [u32; 4], buf: [u8; 64]) {
    let s: [u32; 64] = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
    // floor(abs(sin(i + 1)) * 2^32), RFC 1321 section 3.4
    let k: [u32; 64] = [0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8, 0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70, 0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391]
    mut a = h[0]
    mut b = h[1]
    mut c = h[2]
    mut d = h[3]
    for i in 0..64 {
        mut f: u32 = 0
        mut g: usize = 0
        if i < 16 {
            f = b & c | ~b & d
            g = i
        } else if i < 32 {
            f = d & b | ~d & c
            g = (5 * i + 1) % 16
        } else if i < 48 {
            f = b ^ c ^ d
            g = (3 * i + 5) % 16
        } else {
            f = c ^ (b | ~d)
            g = 7 * i % 16
        }
        let rotated = a.wrapping_add(f).wrapping_add(k[i]).wrapping_add(le_word(buf, g)).rotate_left(s[i])
        a = d
        d = c
        c = b
        b = b.wrapping_add(rotated)
    }
    h[0] = h[0].wrapping_add(a)
    h[1] = h[1].wrapping_add(b)
    h[2] = h[2].wrapping_add(c)
    h[3] = h[3].wrapping_add(d)
}

// ── CRC-32 ──────────────────────────────────────────────────────────

/// Incremental CRC-32 (reflected, polynomial 0xEDB88320).
public struct Crc32 {
    crc: u32
}

extend Crc32 {
    public func new() -> Crc32 {
        return Crc32(crc: 0xffffffff)
    }

    public func update(mutate self, chunk: Vec<u8>) -> void {
        mut crc = self.crc
        for b in chunk {
            crc = crc ^ (b as u32)
            for _ in 0..8 {
                let mask = 0u32.wrapping_sub(crc & 1)
                crc = crc >> 1 ^ 0xedb88320 & mask
            }
        }
        self.crc = crc
    }

    public func build(take self) -> u32 {
        return self.crc ^ 0xffffffff
    }
}
