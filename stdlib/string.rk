// SPDX-License-Identifier: (MIT OR Apache-2.0)

// String types: immutable string, StringView for storable zero-copy
// substrings, StringBuilder for construction, cstring for C interop.

// ─── string ─────────────────────────────────────────────────────
//
// Immutable, refcounted, UTF-8, Copy (S1). 16 bytes — tagged union with
// small string optimization for <=15 bytes (S8). No mutation methods (S7).

extend string {
    // No `new()`. An empty string is written `""`, and SD5 wants one spelling
    // for one thing. It only existed to open `mut s = string.new()` followed by
    // pushes — the Rust `String` habit S7 rules out.

    /// From validated UTF-8 bytes. Returns error on invalid UTF-8 (S4).
    ///
    /// This is the only way in from bytes: StringBuilder deliberately has no raw
    /// byte entry point, so a program holding a `Vec<u8>` had nowhere to go and
    /// nothing to work around it with.
    ///
    /// Decodes and appends in one pass rather than copying the bytes wholesale.
    /// Going through a raw buffer would need `rask_alloc`, which the interpreter
    /// doesn't have — and this is exactly the kind of function where the two
    /// backends must agree about which byte sequences are legal.
    public func from_utf8(bytes: Vec<u8>) -> string or Utf8Error {
        let len = bytes.len().wrap<i64>()
        mut out = StringBuilder.with_capacity(bytes.len())
        mut i: i64 = 0
        while i < len {
            let lead = (bytes.get(i) ?? 0).wrap<i64>()
            // Sequence width from the lead byte. A continuation byte
            // (0x80..0xBF) can't lead; 0xC0/0xC1 are overlong two-byte forms
            // whose value fits in one; 0xF5..0xFF are past U+10FFFF.
            let width = if lead < 0x80 {
                1
            } else if lead >= 0xC2 && lead <= 0xDF {
                2
            } else if lead >= 0xE0 && lead <= 0xEF {
                3
            } else if lead >= 0xF0 && lead <= 0xF4 {
                4
            } else {
                0
            }
            if width == 0 || i + width > len {
                return Utf8Error.InvalidByte(i.wrap<usize>())
            }

            // Fold the continuation bytes into the scalar, checking each.
            mut scalar = if width == 1 {
                lead
            } else if width == 2 {
                lead - 0xC0
            } else if width == 3 {
                lead - 0xE0
            } else {
                lead - 0xF0
            }
            mut k: i64 = 1
            while k < width {
                let cont = (bytes.get(i + k) ?? 0).wrap<i64>()
                if cont < 0x80 || cont > 0xBF {
                    return Utf8Error.InvalidByte((i + k).wrap<usize>())
                }
                scalar = (scalar << 6) + (cont - 0x80)
                k = k + 1
            }

            // Right width, but not a legal scalar: an overlong three-byte form,
            // a surrogate, or past U+10FFFF. Checking the decoded value covers
            // all three at once.
            if width == 3 && scalar < 0x800 {
                return Utf8Error.InvalidByte(i.wrap<usize>())
            }
            if scalar >= 0xD800 && scalar <= 0xDFFF {
                return Utf8Error.InvalidByte(i.wrap<usize>())
            }
            if width == 4 && (scalar < 0x10000 || scalar > 0x10FFFF) {
                return Utf8Error.InvalidByte(i.wrap<usize>())
            }

            if char.from_u32(scalar.wrap<u32>())? as c {
                out.push_char(c)
            } else {
                return Utf8Error.InvalidByte(i.wrap<usize>())
            }
            i = i + width
        }
        return out.build()
    }

    /// Single-character string.
    @native("rask_string_from_char")
    public func from_char(c: char) -> string {}

    // ── Length and properties ────────────────────────────────

    /// Byte length. O(1).
    @native("rask_string_len")
    public func len(self) -> usize {}

    /// Display columns (std.strings/U2). O(1) for ASCII, else O(n).
    /// This is what fmt padding counts — `len` is bytes, `width` aligns.
    @native("rask_string_width")
    public func width(self) -> usize {}

    /// True if the string is empty. O(1).
    @native("rask_string_is_empty")
    public func is_empty(self) -> bool {}

    /// True if all bytes are ASCII. Decided at construction (S10), O(1).
    @native("rask_string_str_is_ascii")
    public func is_ascii(self) -> bool {}

    // ── Indexed access ──────────────────────────────────────
    // Both take byte offsets (std.strings/U1) and both are O(1). char_at used
    // to take a *character* index, so it scanned from byte zero every call and
    // a cursor loop built on it was quadratic.

    /// Byte at byte offset. none if out of bounds.
    @native("rask_string_byte_at")
    public func byte_at(self, idx: usize) -> u8? {}

    /// The scalar starting at byte offset `idx`. none if out of bounds or if
    /// `idx` lands inside a character. Advance a cursor with `c.len_utf8()`.
    @native("rask_string_char_at")
    public func char_at(self, idx: usize) -> char? {}

    /// The text a `Span` covers, copied out — or `none` when the span runs
    /// past the end, runs backwards, or cuts a character in half. The
    /// checked form of `self[span.start..span.end]`.
    public func get(self, span: Span) -> string? {
        if span.start > span.end || span.end > self.len() {
            return none
        }
        if !self.starts_char(span.start) || !self.starts_char(span.end) {
            return none
        }
        return self[span.start..span.end].to_string()
    }

    // ── Slicing ─────────────────────────────────────────────
    // `s[i..j]` is the `Slice` conformance below: a slice is a value that
    // knows where it was cut (std.strings/S2).

    /// The whole string as a span.
    public func span(self) -> Span {
        return Span(0, self.len())
    }

    @native("rask_string_view_range")
    func view_range(self, start: usize, end: usize) -> StringView {}

    @native("rask_string_trim_start_at")
    func trim_start_at(self, start: usize, end: usize) -> usize {}

    @native("rask_string_trim_end_at")
    func trim_end_at(self, start: usize, end: usize) -> usize {}

    @native("rask_string_word_end_at")
    func word_end_at(self, start: usize, end: usize) -> usize {}

    /// Is byte offset `at` where a character starts, or the end? A UTF-8
    /// continuation byte is `10xxxxxx`; anything else starts one.
    func starts_char(self, at: usize) -> bool {
        if self.byte_at(at)? as b {
            return (b & 0xC0) != 0x80
        }
        return at == self.len()
    }

    // ── Searching ───────────────────────────────────────────

    /// Byte index of first occurrence. none if not found.
    @native("rask_string_find")
    public func index_of(self, pat: string) -> usize? {}

    /// Byte index of last occurrence. none if not found.
    @native("rask_string_rfind")
    public func last_index_of(self, pat: string) -> usize? {}

    /// True if the string contains the substring.
    @native("rask_string_contains")
    public func contains(self, pat: string) -> bool {}

    /// True if the string starts with the given prefix.
    @native("rask_string_starts_with")
    public func starts_with(self, pat: string) -> bool {}

    /// True if the string ends with the given suffix.
    @native("rask_string_ends_with")
    public func ends_with(self, pat: string) -> bool {}

    // ── Trimming ────────────────────────────────────────────
    // Each one is a slice of this string, not a copy (std.strings/S2).

    /// Without leading and trailing whitespace.
    public func trim(self) -> StringSlice {
        return self[0..].trim()
    }

    /// Without leading whitespace.
    public func trim_start(self) -> StringSlice {
        return self[0..].trim_start()
    }

    /// Without trailing whitespace.
    public func trim_end(self) -> StringSlice {
        return self[0..].trim_end()
    }

    // ── Case and normalization ──────────────────────────────

    /// Full Unicode uppercase mapping. Allocates. Length can change —
    /// "straße" uppercases to "STRASSE".
    @native("rask_string_to_uppercase")
    public func to_uppercase(self) -> string {}

    /// Full Unicode lowercase mapping. Allocates.
    @native("rask_string_to_lowercase")
    public func to_lowercase(self) -> string {}

    /// NFC form (std.strings/U5). Normalize both sides before comparing text
    /// that came from outside the program — filenames, form input, the network.
    /// Returns self unchanged when already normal.
    @native("rask_string_normalized")
    public func normalized(self) -> string {}

    // ── Substring extraction ────────────────────────────────
    // Slice it: `s[start..end]`, then `.to_string()` to keep it or `.view()`
    // to keep it without copying. No `substring` method — it was the slice
    // under a second name (std.api/SD5).

    // ── Iteration ───────────────────────────────────────────
    // Iterators borrow for expression scope only. Cannot be stored.

    /// Iterate over graphemes — what a reader calls characters (std.strings/U2).
    /// The unit for cursor movement and truncation.
    @native("rask_string_graphemes")
    public func graphemes(self) -> Iterator<string> {}

    /// Iterate over Unicode scalars. For lexers and protocol parsers (U3).
    @native("rask_string_chars")
    public func chars(self) -> Iterator<char> {}

    /// Iterate over raw bytes.
    @native("rask_string_bytes")
    public func bytes(self) -> Iterator<u8> {}

    /// Iterate over (byte_index, char) pairs.
    @native("rask_string_char_indices")
    public func char_indices(self) -> Iterator<(usize, char)> {}

    /// The pieces between each `sep`, as slices of this string, one at a time
    /// (std.strings/S2). An empty `sep` splits between characters, with an
    /// empty piece at each end. `.to_strings()` keeps copies.
    public func split(self, sep: string) -> Sequence<StringSlice> {
        let text = self.view()
        return |yield| {
            let n = text.len()
            if sep.is_empty() {
                if !yield(slice_of(text, 0, 0, 0)) {
                    return
                }
                mut i = 0
                while i < n {
                    let w = text.char_at(i)!.len_utf8()
                    if !yield(slice_of(text, 0, i, i + w)) {
                        return
                    }
                    i += w
                }
                let _ = yield(slice_of(text, 0, n, n))
                return
            }
            mut at = 0
            loop {
                if text.view_range(at, n).index_of(sep)? as found {
                    if !yield(slice_of(text, 0, at, at + found)) {
                        return
                    }
                    at = at + found + sep.len()
                } else {
                    let _ = yield(slice_of(text, 0, at, n))
                    return
                }
            }
        }
    }

    /// The runs of non-whitespace, as slices of this string.
    public func split_whitespace(self) -> Sequence<StringSlice> {
        let text = self.view()
        return |yield| {
            let n = text.len()
            mut at = text.trim_start_at(0, n)
            while at < n {
                let end = text.word_end_at(at, n)
                if !yield(slice_of(text, 0, at, end)) {
                    return
                }
                at = text.trim_start_at(end, n)
            }
        }
    }

    /// The lines, without their `\n`, as slices of this string. A final
    /// newline doesn't start an empty line.
    public func lines(self) -> Sequence<StringSlice> {
        let text = self.view()
        return |yield| {
            let n = text.len()
            mut at = 0
            while at < n {
                if text.view_range(at, n).index_of("\n")? as found {
                    if !yield(slice_of(text, 0, at, at + found)) {
                        return
                    }
                    at = at + found + 1
                } else {
                    let _ = yield(slice_of(text, 0, at, n))
                    return
                }
            }
        }
    }

    // ── Manipulation ────────────────────────────────────────

    /// Replace occurrences of `from` with `to`, left to right: every one, or
    /// at most `limit`. `limit: 0` replaces nothing. Allocates.
    public func replace(self, from: string, to: string, limit: usize? = none) -> string {
        if limit? as n {
            return self.replace_at_most(from, to, n)
        }
        return self.replace_every(from, to)
    }

    @native("rask_string_replace")
    func replace_every(self, from: string, to: string) -> string {}

    @native("rask_string_replace_limit")
    func replace_at_most(self, from: string, to: string, limit: usize) -> string {}

    /// Reverse by graphemes (std.strings/U2). Allocates.
    /// Scalar reversal has no correct use — it splits combining marks from
    /// their base character and turns emoji into rubble.
    @native("rask_string_reverse")
    public func reverse(self) -> string {}

    /// Cut to at most `cols` display columns, never splitting a grapheme.
    /// The operation people hand-roll wrong: width and graphemes composed.
    @native("rask_string_truncate")
    public func truncate(self, cols: usize) -> string {}

    /// Repeat this string n times. Allocates.
    @native("rask_string_repeat")
    public func repeat(self, n: usize) -> string {}

    // ── Join ────────────────────────────────────────────────

    // join() lives on Vec<string>: names.join(", ")

    // ── Parsing ─────────────────────────────────────────────

    /// Parse to a numeric type, answered at T's own width. Trims whitespace.
    /// One function: `parse<i64>()` and `parse<f64>()` are what `parse_int`
    /// and `parse_float` were, and a type parameter already does that job
    /// (std.api/SD2).
    @native("rask_string_parse_int_into")
    public func parse<T>(self) -> T or ParseError {}

    // ── Equality / Comparison ───────────────────────────────
    // == is O(1) or O(n): SSO byte comparison, heap pointer+length fast path.
    // < is O(n) lexicographic. hash() is O(n), not cached.

    /// Hash the string contents.
    @native("rask_string_hash")
    public func hash(self) -> u64 {}

    // ── C interop ───────────────────────────────────────────

    /// The buffer's address, for pointer+length C APIs and for the ones that
    /// read to a terminator — a whole string's buffer ends in a NUL.
    ///
    /// Borrowed, not owned: the pointer is only valid while the string is, and
    /// nothing here refuses a string with an interior NUL. `to_cstring()` is
    /// the owned, checked conversion. `as_c_str` was a second name for this
    /// exact function, and the name promised a guarantee it wasn't giving.
    @native("rask_string_ptr")
    public unsafe func as_ptr(self) -> *u8 {}

    /// Copy from a null-terminated C string. Caller must ensure ptr is valid.
    @native("rask_string_from")
    public unsafe func from_c(ptr: *u8) -> string {}

    /// Build from raw pointer and byte length. No UTF-8 validation.
    @native("rask_string_from_bytes")
    public unsafe func from_raw(ptr: *u8, len: usize) -> string {}
}

// ─── StringBuilder ─────────────────────────────────────────────
//
// Growable mutable buffer for string construction. Sole owner —
// mutation is always O(1) amortized. Move on assignment (not Copy).
//
// UTF-8 validity is maintained by construction: push() takes string,
// push_char() takes char. No raw byte entry point.
//
// Field-less on purpose: the buffer lives in the C runtime and this is
// just the handle to it. A field here makes MIR treat the builder as an
// aggregate at function boundaries while call sites still pass the
// handle, so `mutate b: StringBuilder` crashed natively.

// No release: `build()` takes the builder away, so freeing one an owner
// still names would free a block that's already gone.
@handle
public struct StringBuilder { }

extend StringBuilder {
    /// Create an empty builder.
    @native("rask_string_builder_new")
    public func new() -> StringBuilder {}

    /// Create a builder with pre-allocated capacity.
    @native("rask_string_builder_with_capacity")
    public func with_capacity(n: usize) -> StringBuilder {}

    /// Add a string at the end.
    @native("rask_string_builder_append")
    public func push(mutate self, s: string) {}

    /// Add a single character at the end.
    @native("rask_string_builder_append_char")
    public func push_char(mutate self, c: char) {}

    /// Consume the builder, return the built string. Zero-copy.
    @native("rask_string_builder_build")
    public func build(take self) -> string {}

    /// Current byte length.
    @native("rask_string_builder_len")
    public func len(self) -> usize {}

    /// True if the builder contains no bytes.
    @native("rask_string_builder_is_empty")
    public func is_empty(self) -> bool {}
}

// ─── StringSlice ────────────────────────────────────────────────
//
// What `s[i..j]`, `s.trim()` and `s.split(…)` items are (std.strings/S2): a
// piece of a string that knows where it was cut. It lives for the expression
// that makes it; to keep the text, `.view()` shares the source's buffer and
// `.to_string()` copies it. Every read-only string method works on a slice,
// reading its range.

public struct StringSlice {
    /// The slice's bytes, sharing the source's buffer.
    text: StringView
    /// Where they sit in the source.
    start: usize
    end: usize
}

extend StringSlice {
    /// The slice as a view that shares its source's buffer (V1). No copy.
    public func view(self) -> StringView {
        return self.text
    }

    /// Where the slice sits in the string it was cut from.
    public func span(self) -> Span {
        return Span(self.start, self.end)
    }

    /// The slice's text in a string of its own. Copies.
    public func to_string(self) -> string {
        return self.text.to_string()
    }

    /// Without leading and trailing whitespace.
    public func trim(self) -> StringSlice {
        let n = self.text.len()
        let a = self.text.trim_start_at(0, n)
        return self.cut(a, self.text.trim_end_at(a, n))
    }

    /// Without leading whitespace.
    public func trim_start(self) -> StringSlice {
        let n = self.text.len()
        return self.cut(self.text.trim_start_at(0, n), n)
    }

    /// Without trailing whitespace.
    public func trim_end(self) -> StringSlice {
        return self.cut(0, self.text.trim_end_at(0, self.text.len()))
    }

    /// Offsets `a..b` of this slice, which the trims have already checked.
    func cut(self, a: usize, b: usize) -> StringSlice {
        return StringSlice(text: self.text.view_range(a, b), start: self.start + a, end: self.start + b)
    }
}

// `s[i..j]` on each of the three (type.operators/IX4). A slice of a slice is
// still placed in the original string (SL1), and a view's slices in the view
// (V6).

string implements Slice {
    type Out = StringSlice

    func slice(self, start: usize, end: usize?, through: bool) -> StringSlice {
        return slice_of(self.view(), 0, start, range_end(end, through, self.len()))
    }
}

StringView implements Slice {
    type Out = StringSlice

    func slice(self, start: usize, end: usize?, through: bool) -> StringSlice {
        return slice_of(self, 0, start, range_end(end, through, self.len()))
    }
}

StringSlice implements Slice {
    type Out = StringSlice

    func slice(self, start: usize, end: usize?, through: bool) -> StringSlice {
        return slice_of(self.text, self.start, start, range_end(end, through, self.text.len()))
    }
}

/// Where a range stops: its end, one past it for `..=`, or `len` when it has
/// none.
func range_end(end: usize?, through: bool, len: usize) -> usize {
    if end? as e {
        if through {
            return e + 1
        }
        return e
    }
    return len
}

/// `text[start..end]` as a slice placed `base` bytes into its source. Clamps
/// and refuses a cut character as slicing always has.
func slice_of(text: StringView, base: usize, start: usize, end: usize) -> StringSlice {
    let n = text.len()
    mut hi = end
    if hi > n {
        hi = n
    }
    mut lo = start
    if lo > hi {
        lo = hi
    }
    return StringSlice(text: text.view_range(lo, hi), start: base + lo, end: base + hi)
}

// ─── StringView ─────────────────────────────────────────────────
//
// Storable zero-copy substring (std.strings/V1). Shares the source
// string's buffer and holds a refcount on it — can't dangle. 16 bytes,
// Copy, SSO for <=15 bytes. Read-only: supports the string read API.
//
// Created with .view() on a string or any expression-scoped slice:
//   line[0..colon].trim().view()

public struct StringView { }

extend string {
    /// Storable zero-copy view. On a slice, captures the slice's range;
    /// on a whole string, views all of it. Keeps the source buffer alive.
    @native("rask_string_clone")
    public func view(self) -> StringView {}
}

extend StringView {
    /// Byte length. O(1).
    @native("rask_string_len")
    public func len(self) -> usize {}

    /// Byte index of the first occurrence of `pat`, from the view's start.
    /// none if not found. A view is laid out as a string, so this is the same
    /// search.
    @native("rask_string_find")
    public func index_of(self, pat: string) -> usize? {}

    /// The view's Unicode scalars, in order (U3).
    @native("rask_string_chars")
    public func chars(self) -> Iterator<char> {}

    /// True if the view is empty. O(1).
    @native("rask_string_is_empty")
    public func is_empty(self) -> bool {}

    /// The view's text as an independent string — releases the source
    /// buffer. Rendering a view is copying it out.
    @native("rask_string_unshare")
    public func to_string(self) -> string {}

    /// Sub-view. Same as slicing then .view() — references the original buffer.
    @native("rask_string_clone")
    public func view(self) -> StringView {}

    /// Another view of the same range: one more count on the buffer.
    @native("rask_string_clone")
    public func clone(self) -> StringView {}

    /// Hash the view contents.
    @native("rask_string_hash")
    public func hash(self) -> u64 {}
}

// ─── cstring ────────────────────────────────────────────────────
//
// Owned null-terminated string for C FFI. Move on assignment (not Copy).

@handle(release: "rask_cstring_free")
public struct cstring { }

extend cstring {
    /// Raw pointer. Unsafe context only.
    @native("rask_cstring_as_ptr")
    public unsafe func as_ptr(self) -> *u8 {}

    /// Back to a Rask string, reading up to the terminator.
    ///
    /// Fallible because C promises nothing about encoding — the bytes may be
    /// anything at all. That's why this is `decode` and not `to_string`: a
    /// cstring has no rendering that can't fail, so it isn't Displayable.
    /// `from_utf8` is the validator both backends already share, so the trip
    /// back stops being native here rather than growing a second copy of it
    /// in the runtime.
    public func decode(self) -> string or Utf8Error {
        return string.from_utf8(self.bytes())
    }

    /// The bytes up to the terminator, unvalidated. `decode` is the public
    /// way back; this is the half of it that reads.
    @native("rask_cstring_bytes")
    func bytes(self) -> Vec<u8> {}
}

extend string {
    /// Convert to null-terminated cstring. Fails if the string contains \0 —
    /// C has no way to represent one, so the conversion says where it is
    /// rather than truncating there.
    ///
    /// Written here rather than in the runtime so both backends make the same
    /// call about which strings are convertible; only the copy is native.
    public func to_cstring(self) -> cstring or NullByteError {
        let at = self.first_nul()
        if at >= 0 {
            return NullByteError.FoundAt(at.wrap<usize>())
        }
        return self.copy_terminated()
    }

    /// Byte offset of the first interior NUL, or -1.
    ///
    /// Public because "where does C stop reading this" is a real question about
    /// a string, and answering it costs no allocation. `to_cstring` asks it too.
    @native("rask_string_first_nul")
    public func first_nul(self) -> i64 {}

    /// The allocating half of `to_cstring`, once the check has passed. Not
    /// public either — reaching it directly is how you get an unterminated
    /// `const char*` past the check that exists to prevent one.
    @native("rask_cstring_from_string")
    func copy_terminated(self) -> cstring {}
}

// ─── Parsing and encoding errors ───────────────────────────────

/// Why `parse<T>` failed.
public enum ParseError {
    Empty        // no digits found
    Invalid      // non-numeric character
    OutOfRange   // doesn't fit the target type
}

extend ParseError {
    public func message(self) -> string {
        match self {
            ParseError.Empty => return "no digits found"
            ParseError.Invalid => return "non-numeric character"
            ParseError.OutOfRange => return "value out of range"
        }
    }
}

/// Bytes were not valid UTF-8.
public enum Utf8Error {
    InvalidByte(usize)
}

extend Utf8Error {
    public func message(self) -> string {
        match self {
            Utf8Error.InvalidByte(pos) => return "invalid UTF-8 byte at position {pos}"
        }
    }
}

/// A string meant for C interop contained an embedded null byte.
public enum NullByteError {
    FoundAt(usize)
}

extend NullByteError {
    public func message(self) -> string {
        match self {
            NullByteError.FoundAt(pos) => return "null byte found at position {pos}"
        }
    }
}
