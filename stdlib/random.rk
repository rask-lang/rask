/// Module-level shortcuts on this thread's own generator (C1). Use
/// `Random.from_seed()` instead when a sequence has to be reproducible.
struct random { }

extend random {
    /// Generate a random unsigned 64-bit integer.
    @native("rask_random_u64")
    @ambient
    public func u64() -> u64 {}

    /// Generate a random signed 64-bit integer.
    @native("rask_random_i64")
    @ambient
    public func i64() -> i64 {}

    /// Generate a random f64 in [0, 1).
    @native("rask_random_f64")
    @ambient
    public func f64() -> f64 {}

    /// Generate a random f32 in [0, 1).
    @native("rask_random_f32")
    @ambient
    public func f32() -> f32 {}

    /// Generate a random boolean.
    @native("rask_random_bool")
    @ambient
    public func bool() -> bool {}

    /// Generate a random integer in [lo, hi). Panics when `lo >= hi`.
    @native("rask_random_range", panics: true)
    @ambient
    public func range(lo: i64, hi: i64) -> i64 {}

    /// Shuffle a vector in place (Fisher-Yates).
    @native("rask_random_shuffle")
    @ambient
    public func shuffle<T>(mutate vec: Vec<T>) {}

    /// Pick a random element from a vector — `none` when it's empty.
    @native("rask_random_choice")
    @ambient
    public func choice<T>(vec: Vec<T>) -> Option<T> {}
}

/// Random number generator.
@handle(release: "rask_rng_free")
public struct Random { }

extend Random {
    /// Create a new RNG with a random seed.
    @native("rask_rng_new")
    @ambient
    public func new() -> Random {}

    /// Create an RNG with a specific seed (deterministic).
    @native("rask_rng_from_seed")
    public func from_seed(seed: u64) -> Random {}

    /// Generate a random unsigned 64-bit integer.
    @native("rask_rng_u64")
    public func u64(mutate self) -> u64 {}

    /// Generate a random signed 64-bit integer.
    @native("rask_rng_i64")
    public func i64(mutate self) -> i64 {}

    /// Generate a random f64 in [0, 1).
    @native("rask_rng_f64")
    public func f64(mutate self) -> f64 {}

    /// Generate a random f32 in [0, 1).
    @native("rask_rng_f32")
    public func f32(mutate self) -> f32 {}

    /// Generate a random boolean.
    @native("rask_rng_bool")
    public func bool(mutate self) -> bool {}

    /// Generate a random integer in [lo, hi). Panics when `lo >= hi`.
    @native("rask_rng_range", panics: true)
    public func range(mutate self, lo: i64, hi: i64) -> i64 {}

    /// Shuffle a vector in place (Fisher-Yates).
    @native("rask_rng_shuffle")
    public func shuffle<T>(mutate self, mutate vec: Vec<T>) {}

    /// Pick a random element from a vector — `none` when it's empty.
    @native("rask_rng_choice")
    public func choice<T>(mutate self, vec: Vec<T>) -> Option<T> {}
}
