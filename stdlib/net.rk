/// Network operations.
struct net { }

extend net {
    /// Listen for TCP connections on the given address.
    public func tcp_listen(addr: string) -> TcpListener or IoError {
        try net.check_addr(addr)
        let l = net.listen_handle(addr)
        if l.is_unresolved() {
            return IoError.Other("could not resolve {addr}")
        }
        if l.is_invalid() {
            return IoError.last_os_error()
        }
        return l
    }

    /// Connect to a remote TCP address. Returns a connection or error.
    public func tcp_connect(addr: string) -> TcpConnection or IoError {
        try net.check_addr(addr)
        let c = net.connect_handle(addr)
        if c.is_unresolved() {
            return IoError.Other("could not resolve {addr}")
        }
        if c.is_invalid() {
            return IoError.last_os_error()
        }
        return c
    }

    /// An address is a host *and* a port.
    ///
    /// Checked here rather than in the runtime, so both backends reject the same
    /// strings with the same message. The C side used to fill in whichever half
    /// was missing: `tcp_listen("not-an-address")` found no colon, defaulted to
    /// 0.0.0.0 port 0, bound it, and reported success (#863).
    func check_addr(addr: string) -> void or IoError {
        let cut = addr.last_index_of(":")
        if cut is none {
            return IoError.Other("invalid socket address")
        }
        let at = cut!.wrap<i64>()
        if at == 0 {
            return IoError.Other("invalid socket address")
        }
        let start = at + 1
        let port = addr[start.wrap<usize>()..addr.len()].to_string()
        // `parse<u16>` is the range check: a port is a u16, and #837 made a
        // narrow parse reject anything that doesn't fit rather than keeping the
        // low bits. The C side used to take `atoi` and mask, so
        // `tcp_listen("127.0.0.1:99999")` bound port 34463 and said it worked.
        let n = port.parse<u16>()
        n catch e => {
            return IoError.Other("invalid port value")
        }
        return
    }

    /// The raw `bind`/`listen` pair. -1 means the syscall failed and errno says
    /// why; -2 means the address named nothing that resolves.
    @native("rask_net_tcp_listen")
    func listen_handle(addr: string) -> TcpListener {}

    /// The raw `connect`. Same -1/-2 convention as `listen_handle`.
    @native("rask_net_tcp_connect")
    func connect_handle(addr: string) -> TcpConnection {}
}

/// A listening TCP socket.
///
/// Declared here rather than only in the type registry: without a struct
/// declaration, `self.accept_handle()` inside `extend TcpListener` mangled to
/// `Self_accept_handle` and codegen couldn't find it.
public struct TcpListener { }

extend TcpListener {
    /// Accept an incoming TCP connection.
    public func accept(self) -> TcpConnection or IoError {
        let c = self.accept_handle()
        if c.is_invalid() {
            return IoError.last_os_error()
        }
        return c
    }

    /// The raw `accept`, -1 on failure.
    @native("rask_net_tcp_accept")
    func accept_handle(self) -> TcpConnection {}

    /// True when the handle is a failed syscall's -1.
    ///
    /// The check lives in Rask because only Rask can build an `IoError` — the
    /// runtime reports failure as -1, and the adapter that turned a negative
    /// return into the error side put that -1 in the payload. Reading -1 as an
    /// `IoError` tag is an out-of-range match, which traps: SIGILL on the first
    /// refused connection (#863). Same shape as `File.is_null` (#858).
    @native("rask_net_is_invalid")
    func is_invalid(self) -> bool {}

    /// True when the runtime's -2 came back: the address parsed but named
    /// nothing that resolves. Kept apart from `is_invalid` because
    /// `getaddrinfo` doesn't set errno — asking `last_os_error()` about it
    /// answered "Success (os error 0)" for a failure.
    @native("rask_net_is_unresolved")
    func is_unresolved(self) -> bool {}

    /// Get the local address the listener is bound to.
    @native("rask_net_local_addr")
    public func local_addr(self) -> string {}

    /// Close the listener.
    @native("rask_net_close")
    public func close(take self) -> void or IoError {}

    /// Clone the listener handle.
    @native("rask_net_clone")
    public func clone(self) -> TcpListener {}
}

/// A TCP connection (socket).
public struct TcpConnection { }

extend TcpConnection {
    /// Read all available data as bytes.
    @native("rask_net_read_bytes")
    public func read_bytes(self) -> Vec<u8> or IoError {}

    /// Write bytes to the connection.
    @native("rask_net_write_bytes")
    public func write_bytes(self, data: Vec<u8>) -> void or IoError {}

    /// Read all available data, decoding as UTF-8 text.
    ///
    /// Written in Rask over `read_bytes`: which byte sequences are legal, and
    /// what a bad one reports, is exactly the kind of answer the two backends
    /// must not decide separately. Before this there was no native entry point
    /// at all — `conn.read_text()` failed in codegen with "Function not found:
    /// TcpConnection_read_text" while the interpreter ran it (#863).
    public func read_text(self) -> string or IoError {
        let bytes = try self.read_bytes()
        let text = string.from_utf8(bytes)
        text catch e => {
            return IoError.Other("stream is not valid UTF-8: {e.message()}")
        }
        return try text
    }

    /// Write text to the connection — its UTF-8 bytes, nothing added.
    public func write_text(self, data: string) -> void or IoError {
        mut bytes: Vec<u8> = Vec.new()
        let len = data.len().wrap<i64>()
        mut i: i64 = 0
        while i < len {
            bytes.push(data.byte_at(i.wrap<usize>()) ?? 0)
            i = i + 1
        }
        try self.write_bytes(bytes)
        return
    }

    /// Get the remote address as "ip:port".
    @native("rask_net_remote_addr")
    public func remote_addr(self) -> string {}

    /// Read an HTTP/1.1 request from the connection.
    @native("rask_net_read_http_request")
    public func read_http_request(self) -> Request or IoError {}

    /// Write an HTTP response to the connection, and close it.
    ///
    /// Takes the connection because `format_http_response` always writes
    /// `Connection: close` — a response that says the socket is closing has to
    /// be sent by something that then closes it, or the client waits for an EOF
    /// that never comes and the server keeps the descriptor (#1055). Borrowing
    /// and closing inside would be worse: the caller still holds a
    /// `close(take self)` of its own, and that would be a second close on a
    /// descriptor the OS may already have handed to someone else.
    ///
    /// Same shape as `Responder.respond`, which is the path `HttpServer.accept`
    /// hands out.
    @native("rask_net_write_http_response")
    public func write_http_response(take self, response: Response) -> void or IoError {}

    /// Close the connection.
    @native("rask_net_close")
    public func close(take self) -> void or IoError {}

    /// Clone the connection handle.
    @native("rask_net_clone")
    public func clone(self) -> TcpConnection {}

    /// True when the handle is a failed syscall's -1. See `TcpListener.is_invalid`.
    @native("rask_net_is_invalid")
    func is_invalid(self) -> bool {}

    /// True when the address named nothing that resolves. See
    /// `TcpListener.is_unresolved`.
    @native("rask_net_is_unresolved")
    func is_unresolved(self) -> bool {}
}
