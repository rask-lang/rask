// JSON encoding and decoding.
//
// Two layers: untyped JsonValue enum for dynamic JSON, compiler-generated
// struct encoding/decoding for known schemas. The parser is a recursive
// descent implementation handling the full RFC 8259 grammar.

// ─── Types ───────────────────────────────────────────────────────

enum JsonValue {
    Null
    Bool(bool)
    Number(f64)
    String(string)
    Array(Vec<JsonValue>)
    Object(Map<string, JsonValue>)
}

enum JsonError {
    ParseError(string)
    TypeError(string)
    MissingField(string)
}

extend JsonError {
    public func message(self) -> string {
        match self {
            JsonError.ParseError(msg) => return "parse error: {msg}",
            JsonError.TypeError(msg) => return "type error: {msg}",
            JsonError.MissingField(field) => return "missing field: {field}",
        }
    }
}

// ─── JsonValue accessors ─────────────────────────────────────────

extend JsonValue {
    public func is_null(self) -> bool {
        return self is Null
    }

    public func as_bool(self) -> bool? {
        if self is Bool(b) {
            return b
        }
        return none
    }

    public func as_number(self) -> f64? {
        if self is Number(n) {
            return n
        }
        return none
    }

    public func as_string(self) -> string? {
        if self is String(s) {
            return s
        }
        return none
    }

    public func as_array(self) -> Vec<JsonValue>? {
        if self is Array(a) {
            return a
        }
        return none
    }

    public func as_object(self) -> Map<string, JsonValue>? {
        if self is Object(m) {
            return m
        }
        return none
    }
}

// `{v}` renders through Displayable, and enums opt in (std.fmt/D3, D4).
//
// The encoder has always been here, in Rask: `stringify_value` and the escape
// and number helpers below it. Nothing reached it — `json.encode` is `@native`,
// and MIR routes a non-struct, non-Vec, non-string argument to
// `json_encode_i64`, so a JsonValue printed as its own address (#689).
extend JsonValue with Displayable {
    func to_string(self) -> string {
        return stringify_value(self)
    }
}

// ─── Parser internals ────────────────────────────────────────────

struct JsonParser {
    input: string
    pos: usize
    len: usize
}

extend JsonParser {
    func new(input: string) -> JsonParser {
        return JsonParser {
            input: input,
            pos: 0,
            len: input.len(),
        }
    }

    func peek(self) -> u8 {
        if self.pos >= self.len {
            return 0
        }
        return self.input.byte_at(self.pos) ?? 0
    }

    func advance(mutate self) -> u8 {
        if self.pos >= self.len {
            return 0
        }
        let b = self.input.byte_at(self.pos) ?? 0
        self.pos = self.pos + 1
        return b
    }

    func skip_ws(mutate self) {
        while self.pos < self.len {
            let b = self.input.byte_at(self.pos) ?? 0
            if b != 32 && b != 9 && b != 10 && b != 13 {
                return
            }
            self.pos = self.pos + 1
        }
    }

    func expect(mutate self, expected: u8) -> void or JsonError {
        self.skip_ws()
        if self.pos >= self.len {
            return JsonError.ParseError("unexpected end of input")
        }
        let b = self.advance()
        if b != expected {
            return JsonError.ParseError("expected '{expected}', got '{b}'")
        }
        return
    }

    func parse_value(mutate self) -> JsonValue or JsonError {
        self.skip_ws()
        if self.pos >= self.len {
            return JsonError.ParseError("unexpected end of input")
        }

        let b = self.peek()

        if b == 123 {
            return self.parse_object()
        }
        if b == 91 {
            return self.parse_array()
        }
        if b == 34 {
            return self.parse_string_value()
        }
        if b == 116 {
            return self.parse_true()
        }
        if b == 102 {
            return self.parse_false()
        }
        if b == 110 {
            return self.parse_null()
        }
        if b == 45 || b >= 48 && b <= 57 {
            return self.parse_number()
        }

        return JsonError.ParseError("unexpected character at position {self.pos}")
    }

    func parse_object(mutate self) -> JsonValue or JsonError {
        self.pos = self.pos + 1
        self.skip_ws()

        mut map = Map<string, JsonValue>.new()

        if self.peek() == 125 {
            self.pos = self.pos + 1
            return JsonValue.Object(map)
        }

        loop {
            self.skip_ws()
            if self.peek() != 34 {
                return JsonError.ParseError("expected string key in object")
            }
            let key = try self.parse_raw_string()
            self.skip_ws()
            if self.advance() != 58 {
                return JsonError.ParseError("expected ':' after object key")
            }
            let value = try self.parse_value()
            // Last value wins for duplicate keys (J5)
            map.insert(key, value)

            self.skip_ws()
            let next = self.advance()
            if next == 44 {
                continue
            }
            if next == 125 {
                return JsonValue.Object(map)
            }

            return JsonError.ParseError("expected ',' or '}' in object")
        }
    }

    func parse_array(mutate self) -> JsonValue or JsonError {
        self.pos = self.pos + 1
        self.skip_ws()

        mut arr = Vec<JsonValue>.new()

        if self.peek() == 93 {
            self.pos = self.pos + 1
            return JsonValue.Array(arr)
        }

        loop {
            let value = try self.parse_value()
            arr.push(value)

            self.skip_ws()
            let next = self.advance()
            if next == 44 {
                continue
            }
            if next == 93 {
                return JsonValue.Array(arr)
            }

            return JsonError.ParseError("expected ',' or ']' in array")
        }
    }

    func parse_raw_string(mutate self) -> string or JsonError {
        if self.advance() != 34 {
            return JsonError.ParseError("expected '\"'")
        }

        mut b = StringBuilder.new()

        while self.pos < self.len {
            let byte = self.advance()
            if byte == 34 {
                return b.build()
            }
            if byte == 92 {
                if self.pos >= self.len {
                    return JsonError.ParseError("unterminated escape sequence")
                }
                let esc = self.advance()
                if esc == 34 {
                    b.push_char('"')
                } else if esc == 92 {
                    b.push_char('\\')
                } else if esc == 47 {
                    b.push_char('/')
                } else if esc == 110 {
                    b.push_char('\n')
                } else if esc == 114 {
                    b.push_char('\r')
                } else if esc == 116 {
                    b.push_char('\t')
                } else if esc == 98 {
                    b.push_char('\u{8}')
                } else if esc == 102 {
                    b.push_char('\u{c}')
                } else if esc == 117 {
                    let cp = try self.parse_unicode_escape()
                    b.push_char(cp)
                } else {
                    return JsonError.ParseError("invalid escape character")
                }
                continue
            }
            b.push_char(char.from_u32(byte as u32) ?? '\u{0}')
        }

        return JsonError.ParseError("unterminated string")
    }

    func parse_unicode_escape(mutate self) -> char or JsonError {
        if self.pos + 4 > self.len {
            return JsonError.ParseError("incomplete unicode escape")
        }
        mut cp: u32 = 0
        mut i = 0
        while i < 4 {
            let b = self.advance()
            let digit = hex_digit(b)
            if digit < 0 {
                return JsonError.ParseError("invalid hex digit in unicode escape")
            }
            cp = cp * 16 + (digit truncate to u32)
            i = i + 1
        }
        if char.from_u32(cp)? as c {
            return c
        }
        return JsonError.ParseError("invalid unicode code point")
    }

    func parse_string_value(mutate self) -> JsonValue or JsonError {
        let s = try self.parse_raw_string()
        return JsonValue.String(s)
    }

    func parse_true(mutate self) -> JsonValue or JsonError {
        if self.pos + 4 > self.len {
            return JsonError.ParseError("unexpected end of input")
        }
        if self.input[self.pos..self.pos + 4] == "true" {
            self.pos = self.pos + 4
            return JsonValue.Bool(true)
        }
        return JsonError.ParseError("invalid token")
    }

    func parse_false(mutate self) -> JsonValue or JsonError {
        if self.pos + 5 > self.len {
            return JsonError.ParseError("unexpected end of input")
        }
        if self.input[self.pos..self.pos + 5] == "false" {
            self.pos = self.pos + 5
            return JsonValue.Bool(false)
        }
        return JsonError.ParseError("invalid token")
    }

    func parse_null(mutate self) -> JsonValue or JsonError {
        if self.pos + 4 > self.len {
            return JsonError.ParseError("unexpected end of input")
        }
        if self.input[self.pos..self.pos + 4] == "null" {
            self.pos = self.pos + 4
            return JsonValue.Null
        }
        return JsonError.ParseError("invalid token")
    }

    func parse_number(mutate self) -> JsonValue or JsonError {
        let start = self.pos

        if self.peek() == 45 {
            self.pos = self.pos + 1
        }

        if self.pos >= self.len {
            return JsonError.ParseError("unexpected end in number")
        }
        // Leading zero — only valid as "0" or "0.xxx"
        if self.peek() == 48 {
            self.pos = self.pos + 1
        } else if self.peek() >= 49 && self.peek() <= 57 {
            while self.pos < self.len && self.peek() >= 48 && self.peek() <= 57 {
                self.pos = self.pos + 1
            }
        } else {
            return JsonError.ParseError("invalid number")
        }

        // Fractional part
        if self.pos < self.len && self.peek() == 46 {
            self.pos = self.pos + 1
            if self.pos >= self.len || self.peek() < 48 || self.peek() > 57 {
                return JsonError.ParseError("expected digit after decimal point")
            }
            while self.pos < self.len && self.peek() >= 48 && self.peek() <= 57 {
                self.pos = self.pos + 1
            }
        }

        // Exponent part
        if self.pos < self.len && (self.peek() == 101 || self.peek() == 69) {
            self.pos = self.pos + 1
            if self.pos < self.len && (self.peek() == 43 || self.peek() == 45) {
                self.pos = self.pos + 1
            }
            if self.pos >= self.len || self.peek() < 48 || self.peek() > 57 {
                return JsonError.ParseError("expected digit in exponent")
            }
            while self.pos < self.len && self.peek() >= 48 && self.peek() <= 57 {
                self.pos = self.pos + 1
            }
        }

        let num_str = self.input[start..self.pos].to_string()
        let n = try {
            try num_str.parse<f64>()
        } catch _e => {
            return JsonError.ParseError("invalid number: {num_str}")
        }
        return JsonValue.Number(n)
    }
}

func hex_digit(b: u8) -> i32 {
    if b >= 48 && b <= 57 {
        return b as i32 - 48
    }
    if b >= 65 && b <= 70 {
        return b as i32 - 55
    }
    if b >= 97 && b <= 102 {
        return b as i32 - 87
    }
    return -1
}

// ─── Public API: parsing ─────────────────────────────────────────

struct json {  }

extend json {
    /// Encode a value as a JSON string.
    /// Compiler-expanded at MIR level for structs via comptime for + reflect.
    @native("rask_json_encode")
    public func encode<T: Encode>(value: T) -> string {}

    /// Decode a JSON string into a typed value.
    /// Compiler-expanded: the call site describes T to the decoder, which
    /// fills the value in one pass. Missing required fields, wrong types, and
    /// malformed input all come back as JsonError.
    @native("rask_json_decode")
    public func decode<T: Decode>(str: string) -> T or JsonError {}

    /// Convert a typed value to a JsonValue tree.
    @unimplemented
    public func to_value<T: Encode>(value: T) -> JsonValue {}

    /// Convert a JsonValue tree to a typed value.
    @unimplemented
    public func from_value<T: Decode>(value: JsonValue) -> T or JsonError {}
}

// ─── Stringify internals ─────────────────────────────────────────

// Compact stringify writes into one shared builder, the way the pretty printer
// below already does. Returning a string per nested value instead meant a
// StringBuilder allocation and a copy for every object, array and escaped key —
// on 1000 small objects that was ~40% of the encode time, all of it in
// intermediate strings nobody read.
func stringify_value(value: JsonValue) -> string {
    mut out = StringBuilder.new()
    write_value(value, mutate out)
    return out.build()
}

func write_value(value: JsonValue, mutate out: StringBuilder) {
    match value {
        JsonValue.Null => out.push("null")
        JsonValue.Bool(b) => {
            if b {
                out.push("true")
            } else {
                out.push("false")
            }
        }
        JsonValue.Number(n) => out.push(format_number(n))
        JsonValue.String(s) => write_escaped(s, mutate out)
        JsonValue.Array(arr) => {
            out.push_char('[')
            mut first = true
            for item in arr {
                if !first {
                    out.push_char(',')
                }
                write_value(item, mutate out)
                first = false
            }
            out.push_char(']')
        }
        JsonValue.Object(map) => {
            out.push_char('{')
            mut first = true
            for (key, value) in map {
                if !first {
                    out.push_char(',')
                }
                write_escaped(key, mutate out)
                out.push_char(':')
                write_value(value, mutate out)
                first = false
            }
            out.push_char('}')
        }
    }
}

/// The quoted, escaped form of `s`, appended to `out`.
func write_escaped(s: string, mutate out: StringBuilder) {
    out.push_char('"')
    mut i: usize = 0
    while i < s.len() {
        let byte = s.byte_at(i) ?? 0
        if byte == 34 {
            out.push("\\\"")
        } else if byte == 92 {
            out.push("\\\\")
        } else if byte == 10 {
            out.push("\\n")
        } else if byte == 13 {
            out.push("\\r")
        } else if byte == 9 {
            out.push("\\t")
        } else if byte == 8 {
            out.push("\\b")
        } else if byte == 12 {
            out.push("\\f")
        } else if byte < 32 {
            out.push("\\u00")
            out.push_char(hex_char(byte / 16))
            out.push_char(hex_char(byte % 16))
        } else {
            out.push_char(char.from_u32(byte as u32) ?? '\u{0}')
        }
        i = i + 1
    }
    out.push_char('"')
}

func hex_char(n: u8) -> char {
    if n < 10 {
        return char.from_u32((48 + n) as u32) ?? '0'
    }
    return char.from_u32((87 + n) as u32) ?? '0'
}

func format_number(n: f64) -> string {
    let i = n float to int i64 (saturating)
    if i as f64 == n && n >= -9007199254740992.0 && n <= 9007199254740992.0 {
        return "{i}"
    }
    return "{n}"
}

// ─── Pretty-print internals ─────────────────────────────────────

func stringify_pretty_inner(value: JsonValue, mutate out: StringBuilder, indent: usize) {
    match value {
        JsonValue.Null => out.push("null")
        JsonValue.Bool(b) => if b {
            out.push("true")
        } else {
            out.push("false")
        }
        JsonValue.Number(n) => out.push(format_number(n))
        JsonValue.String(s) => write_escaped(s, mutate out)
        JsonValue.Array(arr) => {
            if arr.is_empty() {
                out.push("[]")
                return
            }
            out.push("[\n")
            mut first = true
            for item in arr {
                if !first {
                    out.push(",\n")
                }
                write_indent(mutate out, indent + 1)
                stringify_pretty_inner(item, mutate out, indent + 1)
                first = false
            }
            out.push_char('\n')
            write_indent(mutate out, indent)
            out.push_char(']')
        }
        JsonValue.Object(map) => {
            if map.is_empty() {
                out.push("{}")
                return
            }
            out.push("{\n")
            mut first = true
            for (key, val) in map {
                if !first {
                    out.push(",\n")
                }
                write_indent(mutate out, indent + 1)
                write_escaped(key, mutate out)
                out.push(": ")
                stringify_pretty_inner(val, mutate out, indent + 1)
                first = false
            }
            out.push_char('\n')
            write_indent(mutate out, indent)
            out.push_char('}')
        }
    }
}

func write_indent(mutate out: StringBuilder, level: usize) {
    mut i: usize = 0
    while i < level {
        out.push("  ")
        i = i + 1
    }
}
