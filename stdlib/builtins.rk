import memory.Heap

/// Print a value followed by a newline to stdout.
@native
public func println(msg: string) {}

/// Print a value to stdout without a trailing newline.
@native
public func print(msg: string) {}

/// Abort execution with an error message.
@native
public func panic(msg: string) {}

/// Mark unfinished code. Panics with "not yet implemented" at runtime.
/// Returns `!` (Never) so it works in any type context.
@native
public func todo(msg: string?) {}

/// Mark code that should never be reached. Panics if executed.
/// Returns `!` (Never) so it works in any type context.
@native
public func unreachable(msg: string?) {}

/// Consume a `Heap<T>` and free its heap value (mem.heap/HP3).
///
/// Exactly one box, per HP1/HP2 — a type that owns further boxes frees them
/// itself. A scalar `Heap` was never on the heap (it fits its slot), so
/// dropping one frees nothing.
@native
public func drop(take ptr: Heap) {}

/// Print a value followed by a newline to stderr.
@native
public func eprintln(msg: string) {}

/// Print a value to stderr without a trailing newline.
@native
public func eprint(msg: string) {}

/// Assert a condition is true. Panics with message if false.
@native
public func assert(condition: bool, msg: string?) {}

/// Format values into a string.
@native
public func format(fmt: string) -> string {}

/// The smaller of two values. Works on any Comparable type — numbers,
/// strings (lexicographic), custom types. No `.min()` method or
/// `math.min` — this is the one way (std.math/G1).
public func min<T: Comparable>(a: T, b: T) -> T {
    if a < b {
        return a
    }
    return b
}

/// The larger of two values (std.math/G2).
public func max<T: Comparable>(a: T, b: T) -> T {
    if a > b {
        return a
    }
    return b
}

/// Restrict a value to [lo, hi] (std.math/G3).
public func clamp<T: Comparable>(value: T, lo: T, hi: T) -> T {
    if value < lo {
        return lo
    }
    if value > hi {
        return hi
    }
    return value
}

// ─── Core types ─────────────────────────────────────────────────

/// A byte-index range. Used for source spans, text ranges, slicing.
/// 16 bytes, Copy.
public struct Span {
    public start: usize
    public end: usize
}

extend Span {
    public func new(start: usize, end: usize) -> Span {
        return Span { start, end }
    }
    public func len(self) -> usize {
        return self.end - self.start
    }
    public func is_empty(self) -> bool {
        return self.start == self.end
    }
}

/// Why a conversion couldn't produce the value (type.primitives/CV11).
///
/// `x.to<T>()`, `x.round<T>()` to an integer, `x.floor<T>()` and `x.ceil<T>()`
/// all answer `T or ConvertError`. `OutOfRange` is spelled to match
/// `ParseError.OutOfRange`, which already means exactly this.
public enum ConvertError {
    OutOfRange   // doesn't fit the target type
    NotExact     // a float with a fraction, going to an integer
    NotFinite    // NaN or infinity
}

extend ConvertError {
    public func message(self) -> string {
        match self {
            ConvertError.OutOfRange => return "value doesn't fit the target type"
            ConvertError.NotExact => return "value can't be represented exactly"
            ConvertError.NotFinite => return "value is NaN or infinity"
        }
    }
}
