/// Arena allocator for graph structures. Elements are accessed via handles.
public struct Pool<T> { }

/// Typed reference into a Pool. Handles are values — they can outlive the scope
/// where they were created, but accessing the element requires `using Pool<T>`.
public struct Handle<T> { }

/// Non-owning reference into a Pool. May become invalid if the element is removed.
/// Use `upgrade()` to convert back to a Handle (returns none if invalidated).
public struct WeakHandle<T> { }

/// Arena of nodes whose incoming edges are fixed when a node is deleted.
/// Where a `Pool` hands out handles that get validated at every use, a `Rack`
/// hands out links that are followed directly: `delete` walks every edge
/// pointing at the dying node and sets it to `none`, so a dead link never
/// exists to be checked.
public struct Rack<T> { }

/// One edge to a node in a `Rack<T>`.
///
/// A link is a reference, not a ticket: `l.field` reads the node with no
/// generation check and no `using` context. An edge that can die is declared
/// `Link<T>?` and becomes `none` at the moment its target is deleted.
public struct Link<T> { }

extend Rack<T> {
    /// Create an empty rack.
    @native("rask_rack_new")
    public func new() -> Rack<T> {}

    /// Insert a node, returning a link to it.
    @native("rask_rack_insert")
    public func insert(mutate self, node: T) -> Link<T> {}

    /// Delete a node. Every edge pointing at it becomes `none` before this
    /// returns. Takes the link: after this the caller's name for that node is
    /// revoked, which is what makes use-after-delete a compile error rather
    /// than a runtime check.
    @native("rask_rack_delete")
    public func delete(mutate self, take link: Link<T>) -> void {}

    /// Number of live nodes.
    @native("rask_rack_len")
    public func len(self) -> usize {}

    /// True if the rack holds no nodes.
    @native("rask_rack_is_empty")
    public func is_empty(self) -> bool {}

    /// True if the link names a node in this rack.
    @native("rask_rack_contains")
    public func contains(self, link: Link<T>) -> bool {}

    /// Links to every live node. This is what `for n in rack` walks.
    @native("rask_rack_nodes")
    public func nodes(self) -> Vec<Link<T>> {}

    /// Remove every node.
    @native("rask_rack_clear")
    public func clear(mutate self) -> void {}

    /// An independent copy of the whole graph, with every edge inside it
    /// re-pointed at the copy. Nothing is shared with the original, so the copy
    /// can be moved to another task and read there while this one keeps
    /// mutating — which is how a graph crosses a task boundary, since a link
    /// never can (mem.ownership/T2).
    ///
    /// O(nodes + edges). The same walk `delete` does, rewriting instead of
    /// nulling.
    @native("rask_rack_snapshot")
    public func snapshot(self) -> Rack<T> {}

    /// This snapshot's copy of the node `link` names, or `none` if that node
    /// isn't in here. A link is an address, so it can't name anything in a
    /// different allocation — this is the one translation at the boundary that
    /// buys you a starting point inside the copy.
    @native("rask_rack_corresponding")
    public func corresponding(self, link: Link<T>) -> Link<T>? {}
}

extend WeakHandle<T> {
    /// Check if the weak handle is still valid (element hasn't been removed).
    @native
    public func valid(self) -> bool {}

    /// Attempt to convert back to a strong Handle. Returns none if the element
    /// was removed since the weak handle was created.
    @native
    public func upgrade(self) -> Handle<T>? {}
}

extend Pool<T> {
    /// Create a new empty pool.
    @native("rask_pool_new")
    public func new() -> Pool<T> {}

    /// Create a pool with pre-allocated capacity.
    @native("rask_pool_with_capacity")
    public func with_capacity(n: usize) -> Pool<T> {}

    /// Number of live elements.
    @native("rask_pool_len")
    public func len(self) -> usize {}

    /// True if the pool contains no elements.
    @native("rask_pool_is_empty")
    public func is_empty(self) -> bool {}

    /// Insert an element, returning a handle to it. Panics on allocation
    /// failure (mem.pools/PL3, PL8) — use `try_insert` to handle capacity.
    @native("rask_pool_insert_packed_sized")
    public func insert(mutate self, value: T) -> Handle<T> {}

    /// Get element by handle (borrows).
    @native("rask_pool_get_packed")
    public func get(self, handle: Handle<T>) -> Option<T> {}

    /// Get a clone of element by handle.
    @unimplemented
    public func get_clone(self, handle: Handle<T>) -> Option<T> {}

    /// Read element through a closure.
    @native
    public func read(self, handle: Handle<T>, f: func(T) -> R) -> Option<R> {}

    /// Modify element through a closure.
    @native
    public func modify(mutate self, handle: Handle<T>, f: func(T) -> R) -> Option<R> {}

    /// True if the handle points to a live element.
    @native("rask_pool_is_valid_packed")
    public func contains(self, handle: Handle<T>) -> bool {}

    /// Remove element by handle, returning it.
    @native("rask_pool_remove_out")
    public func remove(mutate self, handle: Handle<T>) -> Option<T> {}

    /// Remove all elements.
    @native
    public func clear(mutate self) {}

    /// Iterate over (handle, element) pairs.
    @native
    public func iter(self) -> Iterator<(Handle<T>, T)> {}

    /// Snapshot of handles. Returned as a Vec so callers can index, slice,
    /// or iterate without invalidating on subsequent insert/remove.
    @native("rask_pool_handles_packed")
    public func handles(self) -> Vec<Handle<T>> {}

    /// Iterate over elements only.
    @native("rask_pool_values")
    public func values(self) -> Iterator<T> {}

    /// Try to insert, returning none if at capacity.
    @native("rask_pool_try_insert_packed_sized")
    public func try_insert(mutate self, value: T) -> Handle<T>? {}

    /// Remove all elements, returning them as a Vec.
    @native("rask_pool_drain")
    public func drain(mutate self) -> Vec<T> {}

    /// Get (handle, element) pairs as a Vec snapshot.
    @native
    public func entries(self) -> Vec<(Handle<T>, T)> {}

    /// Get element without Option wrapping — panics on invalid handle.
    @native
    public func get_unchecked(self, handle: Handle<T>) -> T {}

    /// Get mutable element without Option wrapping — panics on invalid handle.
    @native
    public func get_mut_unchecked(mutate self, handle: Handle<T>) -> T {}

    /// Apply closure only if handle is valid (read-only).
    @native
    public func with_valid(self, handle: Handle<T>, f: func(T) -> R) -> Option<R> {}

    /// Apply closure only if handle is valid (mutable).
    @native
    public func with_valid_mut(mutate self, handle: Handle<T>, f: func(T) -> R) -> Option<R> {}

    /// Total slot capacity (allocated slots, including free).
    @native
    public func capacity(self) -> usize {}

    /// Remaining free slots before a new allocation is needed.
    @native
    public func remaining(self) -> usize {}

    /// Create a WeakHandle from a Handle.
    @native
    public func weak(self, handle: Handle<T>) -> WeakHandle<T> {}

    /// Create a snapshot: returns (read_copy, write_copy) for concurrent access.
    @native
    public func snapshot(self) -> (Pool<T>, Pool<T>) {}
}
