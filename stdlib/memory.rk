/// Arena of nodes whose incoming edges are fixed when a node is deleted.
/// `delete` walks every edge pointing at the dying node and sets it to `none`,
/// so a dead link never exists to be checked.
public struct Rack<T> { }

/// One edge to a node in a `Rack<T>`.
///
/// A link is a reference, not a ticket: `l.field` reads the node with no
/// generation check and no `using` context. An edge that can die is declared
/// `Link<T>?` and becomes `none` at the moment its target is deleted.
public struct Link<T> { }

extend Rack<T> {
    /// Create an empty rack.
    @native("rask_rack_new")
    public func new() -> Rack<T> {}

    /// Insert a node, returning a link to it.
    @native("rask_rack_insert")
    public func insert(mutate self, take node: T) -> Link<T> {}

    /// Delete a node. Every edge pointing at it becomes `none` before this
    /// returns. Takes the link: after this the caller's name for that node is
    /// revoked, which is what makes use-after-delete a compile error rather
    /// than a runtime check.
    @native("rask_rack_delete")
    public func delete(mutate self, take link: Link<T>) -> void {}

    /// Number of live nodes.
    @native("rask_rack_len")
    public func len(self) -> usize {}

    /// True if the rack holds no nodes.
    @native("rask_rack_is_empty")
    public func is_empty(self) -> bool {}

    /// True if the link names a node in this rack.
    @native("rask_rack_contains")
    public func contains(self, link: Link<T>) -> bool {}

    /// Links to every live node. This is what `for n in rack` walks.
    @native("rask_rack_nodes")
    public func nodes(self) -> Vec<Link<T>> {}

    /// Remove every node.
    @native("rask_rack_clear")
    public func clear(mutate self) -> void {}

    /// An independent copy of the whole graph, with every edge inside it
    /// re-pointed at the copy. Nothing is shared with the original, so the copy
    /// can be moved to another task and read there while this one keeps
    /// mutating — which is how a graph crosses a task boundary, since a link
    /// never can (mem.ownership/T2).
    ///
    /// O(nodes + edges). The same walk `delete` does, rewriting instead of
    /// nulling.
    @native("rask_rack_snapshot")
    public func snapshot(self) -> Rack<T> {}

    /// This snapshot's copy of the node `link` names, or `none` if that node
    /// isn't in here. A link is an address, so it can't name anything in a
    /// different allocation — this is the one translation at the boundary that
    /// buys you a starting point inside the copy.
    @native("rask_rack_corresponding")
    public func corresponding(self, link: Link<T>) -> Link<T>? {}
}
