// --- Task spawning ---

/// Spawn a green task on the current scheduler.
/// Requires an active `using Multitasking { ... }` scope in the process.
/// Compile error if called outside any scope (directly or transitively);
/// runtime panic for higher-order/trait-object cases the compiler can't prove.
///
/// `take f`: the task keeps the closure and runs it after this call returns, so
/// the closure is given away here (PM3). It read as a borrow for a long time,
/// which is a signature saying the caller keeps something they don't — and
/// `mem.closures/SL4` reads parameter modes to decide what a returned closure
/// still borrows, so the lie had to be worked around rather than trusted.
@native("rask_green_closure_spawn")
public func spawn(take f: func() -> T) -> TaskHandle<T> {}

/// Check if the current task has been cancelled.
/// Returns true if cancel was requested. Use in long-running loops.
@native
public func cancelled() -> bool {}

// --- Task handles ---

/// Handle to a spawned task. Must be joined or detached — dropping
/// an unconsumed handle is a compile error.
@resource
public struct TaskHandle<T> {
}

extend TaskHandle<T> {
    /// Wait for the task to finish and return its result.
    /// Consumes the handle.
    @native("rask_green_join_simple")
    public func join(take self) -> T or JoinError {}

    /// Detach the task (fire-and-forget). Consumes the handle.
    @native("rask_green_detach")
    public func detach(take self) {}

    /// Request cooperative cancellation, wait for exit.
    /// Consumes the handle.
    @native("rask_green_cancel_simple")
    public func cancel(take self) -> T or JoinError {}
}

public enum JoinError {
    Panicked(string)
    Cancelled
}

extend JoinError {
    public func message(self) -> string {
        match self {
            JoinError.Panicked(msg) => return "task panicked: {msg}"
            JoinError.Cancelled => return "task was cancelled"
        }
    }
}

// --- Multiple tasks ---

/// Tasks spawned into one place, joined together. For a count known only at
/// run time; a fixed handful is just as clear joined one by one.
///
///     let group = TaskGroup<string>.new()
///     ensure group.detach()
///     for url in urls {
///         group.spawn(|| { return fetch(url) })
///     }
///     let pages = group.join_all()
///
/// Must be joined or detached, like the handles it holds.
@resource
public struct TaskGroup<T> { }

extend TaskGroup<T> {
    @native("rask_task_group_new")
    public func new() -> TaskGroup<T> {}

    /// Spawn a task in this group.
    public func spawn(self, take f: func() -> T) {
        self.adopt(spawn(f))
    }

    /// Wait for every task. Results come back in spawn order, one per task, so
    /// a task that panicked doesn't cost the others theirs.
    public func join_all(take self) -> Vec<T or JoinError> {
        mut results: Vec<T or JoinError> = Vec.new()
        mut i = 0
        while i < self.len() {
            results.push(self.at(i).join())
            i += 1
        }
        self.release()
        return results
    }

    /// Let every task run on without waiting for it. Consumes the group.
    public func detach(take self) {
        mut i = 0
        while i < self.len() {
            self.at(i).detach()
            i += 1
        }
        self.release()
    }

    @native("rask_task_group_adopt")
    func adopt(self, take handle: TaskHandle<T>) {}

    @native("rask_task_group_len")
    func len(self) -> i64 {}

    /// The i-th handle. `join_all` and `detach` take each exactly once.
    @native("rask_task_group_at")
    func at(self, i: i64) -> TaskHandle<T> {}

    @native("rask_task_group_free")
    func release(take self) {}
}

// --- Channels ---

extend Channel<T> {
    /// Create a buffered channel with the given capacity.
    @native("rask_channel_new_ptr")
    public func buffered(capacity: u64) -> (Sender<T>, Receiver<T>) {}

    /// Create an unbuffered (synchronous) channel.
    @native("rask_channel_new_ptr")
    public func unbuffered() -> (Sender<T>, Receiver<T>) {}
}

public struct Sender<T> { }

extend Sender<T> {
    /// Send a value. Pauses/blocks if buffer full.
    @native("rask_channel_send_ptr")
    public func send(self, take value: T) -> void or SendError {}

    /// Non-blocking send. Returns error if full or closed.
    @native("rask_channel_try_send_i64")
    public func try_send(self, value: T) -> void or TrySendError {}

    /// Explicitly close this end. Consumes the sender: closing *is* dropping
    /// it, and the channel closes when the last sender goes. Declaring it
    /// `self` said the handle survived the call, so the frame dropped it a
    /// second time on the way out — `tx.close()!` then aborted the process.
    @native("rask_sender_close_i64")
    public func close(take self) -> void or CloseError {}
}

public struct Receiver<T> { }

extend Receiver<T> {
    /// Receive a value. Pauses/blocks if buffer empty.
    @native("rask_channel_recv_i64")
    public func receive(self) -> T or ReceiveError {}

    /// Non-blocking receive. Returns error if empty or closed.
    @native("rask_channel_try_recv_into")
    public func try_receive(self) -> T or TryReceiveError {}

    /// Explicitly close this end. Consumes the receiver, for the same reason
    /// `Sender.close` consumes the sender.
    @native("rask_recver_close_i64")
    public func close(take self) -> void or CloseError {}
}

// --- Channel errors ---

public enum SendError { Closed }

extend SendError {
    public func message(self) -> string {
        return "send on closed channel"
    }
}

public enum ReceiveError { Closed }

extend ReceiveError {
    public func message(self) -> string {
        return "receive on closed channel"
    }
}

public enum CloseError { AlreadyClosed, FlushFailed }

extend CloseError {
    public func message(self) -> string {
        match self {
            CloseError.AlreadyClosed => return "channel already closed"
            CloseError.FlushFailed => return "flush failed on close"
        }
    }
}

public enum TrySendError {
    Full(T)
    Closed(T)
}

extend TrySendError<T> {
    public func message(self) -> string {
        match self {
            TrySendError.Full(_) => return "channel is full"
            TrySendError.Closed(_) => return "send on closed channel"
        }
    }
}

public enum TryReceiveError { Empty, Closed }

extend TryReceiveError {
    public func message(self) -> string {
        match self {
            TryReceiveError.Empty => return "channel is empty"
            TryReceiveError.Closed => return "receive on closed channel"
        }
    }
}
