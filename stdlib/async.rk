import memory.Heap

// --- Tasks ---
//
// A task starts with a task block, which is language syntax rather than a
// function here (conc.async/S1–S3):
//
//     spawn { responder.respond(handler(req)) }.detach()
//     let h = Thread.spawn { work() }
//     let j = ThreadPool.spawn { compute(x) }

/// Whether the task, pooled job or thread running this has been asked to stop.
/// Use in long-running loops.
@native("rask_handle_cancelled")
public func cancelled() -> bool {}

// --- Handles ---

/// What every task block hands back: `spawn { … }`, `Thread.spawn { … }` and
/// `ThreadPool.spawn { … }`. Must be joined or detached; dropping one is a
/// compile error.
@resource
public struct Handle<T> {
}

extend Handle<T> {
    /// Wait for the result.
    @native("rask_handle_join")
    public func join(take self) -> T or JoinError {}

    /// Let it run on without waiting.
    @native("rask_handle_detach")
    public func detach(take self) -> void {}

    /// Ask it to stop, then wait. It stops only where it checks `cancelled()`,
    /// and whatever it returns then is the result.
    @native("rask_handle_cancel")
    public func cancel(take self) -> T or JoinError {}
}

/// Why a join has no value. A cancelled task still ends through its own code,
/// so what it returned is the answer; the only way to have none is to panic.
public enum JoinError {
    Panicked(string)
}

extend JoinError {
    public func message(self) -> string {
        match self {
            JoinError.Panicked(msg) => return "task panicked: {msg}"
        }
    }
}

// --- Many handles ---

/// Handles for a count known only at run time; a fixed handful is just as
/// clear joined one by one.
///
///     mut pages = Handles<Page>.new()
///     ensure pages.detach()
///     for url in urls {
///         pages.add(spawn { fetch(url) })
///     }
///     let results = pages.join_all()
///
/// Must be joined or detached, like the handles it holds. Plain Rask: a
/// linked list of handles, so a group of any other linear type is written
/// the same way.
@resource
public struct Handles<T> {
    list: HandleList<T>
}

/// Newest first.
enum HandleList<T> {
    Empty
    More(Handle<T>, Heap<HandleList<T>>)
}

extend Handles<T> {
    public func new() -> Handles<T> {
        return Handles { list: HandleList.Empty }
    }

    public func add(mutate self, take h: Handle<T>) -> void {
        self.list = HandleList.More(h, Heap(self.list))
    }

    /// Wait for every one. Results come back in add order, one per handle, so
    /// one that panicked doesn't cost the others theirs.
    public func join_all(take self) -> Vec<T or JoinError> {
        mut results: Vec<T or JoinError> = Vec.new()
        mut rest = self.list
        loop {
            match rest {
                HandleList.Empty => break
                HandleList.More(h, next) => {
                    results.push(h.join())
                    rest = *next
                }
            }
        }
        results.reverse()
        return results
    }

    /// Let every one run on without waiting.
    public func detach(take self) -> void {
        mut rest = self.list
        loop {
            match rest {
                HandleList.Empty => break
                HandleList.More(h, next) => {
                    h.detach()
                    rest = *next
                }
            }
        }
    }
}

// --- Channels ---

extend Channel<T> {
    /// Create a buffered channel with the given capacity.
    @native("rask_channel_new_ptr")
    public func buffered(capacity: u64) -> (Sender<T>, Receiver<T>) {}

    /// Create an unbuffered (synchronous) channel.
    @native("rask_channel_new_ptr")
    public func unbuffered() -> (Sender<T>, Receiver<T>) {}
}

public struct Sender<T> { }

extend Sender<T> {
    /// Send a value. Pauses/blocks if buffer full.
    @native("rask_channel_send_ptr")
    public func send(self, take value: T) -> void or SendError {}

    /// Non-blocking send. Returns error if full or closed.
    @native("rask_channel_try_send_i64")
    public func try_send(self, value: T) -> void or TrySendError {}

    /// Explicitly close this end. Consumes the sender: closing *is* dropping
    /// it, and the channel closes when the last sender goes. Declaring it
    /// `self` said the handle survived the call, so the frame dropped it a
    /// second time on the way out — `tx.close()!` then aborted the process.
    @native("rask_sender_close_i64")
    public func close(take self) -> void or CloseError {}
}

public struct Receiver<T> { }

extend Receiver<T> {
    /// Receive a value. Pauses/blocks if buffer empty.
    @native("rask_channel_recv_i64")
    public func receive(self) -> T or ReceiveError {}

    /// Non-blocking receive. Returns error if empty or closed.
    @native("rask_channel_try_recv_into")
    public func try_receive(self) -> T or TryReceiveError {}

    /// Explicitly close this end. Consumes the receiver, for the same reason
    /// `Sender.close` consumes the sender.
    @native("rask_recver_close_i64")
    public func close(take self) -> void or CloseError {}
}

// --- Channel errors ---

/// `Cancelled`: the task was cancelled while it waited (conc.async/CN3).
public enum SendError { Closed, Cancelled }

extend SendError {
    public func message(self) -> string {
        match self {
            SendError.Closed => return "send on closed channel"
            SendError.Cancelled => return "send cancelled"
        }
    }
}

public enum ReceiveError { Closed, Cancelled }

extend ReceiveError {
    public func message(self) -> string {
        match self {
            ReceiveError.Closed => return "receive on closed channel"
            ReceiveError.Cancelled => return "receive cancelled"
        }
    }
}

public enum CloseError { AlreadyClosed, FlushFailed }

extend CloseError {
    public func message(self) -> string {
        match self {
            CloseError.AlreadyClosed => return "channel already closed"
            CloseError.FlushFailed => return "flush failed on close"
        }
    }
}

public enum TrySendError {
    Full(T)
    Closed(T)
}

extend TrySendError<T> {
    public func message(self) -> string {
        match self {
            TrySendError.Full(_) => return "channel is full"
            TrySendError.Closed(_) => return "send on closed channel"
        }
    }
}

public enum TryReceiveError { Empty, Closed }

extend TryReceiveError {
    public func message(self) -> string {
        match self {
            TryReceiveError.Empty => return "channel is empty"
            TryReceiveError.Closed => return "receive on closed channel"
        }
    }
}
