// Binary parsing and building (std.bits).
//
// The integer methods std.bits also promises (count_ones … rotate_right,
// to_be … from_ne_bytes) are in int.rk, written once for every width.

// ── Binary parsing (P3–P5) ──────────────────────────────────────────

public enum BinaryParseError {
    UnexpectedEnd(expected: usize, actual: usize)
    InvalidData(message: string)
}

extend BinaryParseError {
    public func message(self) -> string {
        match self {
            BinaryParseError.UnexpectedEnd(expected, actual) => return "unexpected end: expected {expected} bytes, got {actual}"
            BinaryParseError.InvalidData(message) => return "invalid data: {message}"
        }
    }
}

/// A byte buffer read front to back. Each `read_*` takes the next value and
/// moves past it, so nothing is copied but what a read hands back.
public struct BinaryReader {
    data: bytes
    at: usize
}

extend BinaryReader {
    public func new(data: bytes) -> BinaryReader {
        return BinaryReader(data: data, at: 0)
    }

    /// Bytes read so far.
    public func pos(self) -> usize {
        return self.at
    }

    /// Bytes not read yet.
    public func remaining(self) -> usize {
        return self.data.len() - self.at
    }

    /// The whole buffer back, read part included.
    public func into_inner(take self) -> bytes {
        return self.data
    }

    public func read_u8(mutate self) -> u8 or BinaryParseError {
        let b = try self.next1()
        return b[0]
    }

    public func read_i8(mutate self) -> i8 or BinaryParseError {
        let b = try self.next1()
        return i8.from_le_bytes(b)
    }

    public func read_u16be(mutate self) -> u16 or BinaryParseError {
        let b = try self.next2()
        return u16.from_be_bytes(b)
    }

    public func read_u16le(mutate self) -> u16 or BinaryParseError {
        let b = try self.next2()
        return u16.from_le_bytes(b)
    }

    public func read_i16be(mutate self) -> i16 or BinaryParseError {
        let b = try self.next2()
        return i16.from_be_bytes(b)
    }

    public func read_i16le(mutate self) -> i16 or BinaryParseError {
        let b = try self.next2()
        return i16.from_le_bytes(b)
    }

    public func read_u32be(mutate self) -> u32 or BinaryParseError {
        let b = try self.next4()
        return u32.from_be_bytes(b)
    }

    public func read_u32le(mutate self) -> u32 or BinaryParseError {
        let b = try self.next4()
        return u32.from_le_bytes(b)
    }

    public func read_i32be(mutate self) -> i32 or BinaryParseError {
        let b = try self.next4()
        return i32.from_be_bytes(b)
    }

    public func read_i32le(mutate self) -> i32 or BinaryParseError {
        let b = try self.next4()
        return i32.from_le_bytes(b)
    }

    public func read_u64be(mutate self) -> u64 or BinaryParseError {
        let b = try self.next8()
        return u64.from_be_bytes(b)
    }

    public func read_u64le(mutate self) -> u64 or BinaryParseError {
        let b = try self.next8()
        return u64.from_le_bytes(b)
    }

    public func read_i64be(mutate self) -> i64 or BinaryParseError {
        let b = try self.next8()
        return i64.from_be_bytes(b)
    }

    public func read_i64le(mutate self) -> i64 or BinaryParseError {
        let b = try self.next8()
        return i64.from_le_bytes(b)
    }

    public func read_f32be(mutate self) -> f32 or BinaryParseError {
        let b = try self.next4()
        return f32.from_bits(u32.from_be_bytes(b))
    }

    public func read_f32le(mutate self) -> f32 or BinaryParseError {
        let b = try self.next4()
        return f32.from_bits(u32.from_le_bytes(b))
    }

    public func read_f64be(mutate self) -> f64 or BinaryParseError {
        let b = try self.next8()
        return f64.from_bits(u64.from_be_bytes(b))
    }

    public func read_f64le(mutate self) -> f64 or BinaryParseError {
        let b = try self.next8()
        return f64.from_bits(u64.from_le_bytes(b))
    }

    /// The next `n` bytes, sharing the buffer (std.bytes/BY9).
    public func read_bytes(mutate self, n: usize) -> BytesView or BinaryParseError {
        try self.need(n)
        let at = self.at
        self.at += n
        return self.data[at..at + n].view()
    }

    /// Fails unless at least `n` bytes are left.
    func need(self, n: usize) -> void or BinaryParseError {
        let left = self.remaining()
        if left < n {
            return BinaryParseError.UnexpectedEnd(expected: n, actual: left)
        }
    }

    func next1(mutate self) -> [u8; 1] or BinaryParseError {
        try self.need(1)
        let at = self.at
        self.at += 1
        return [self.data[at]]
    }

    func next2(mutate self) -> [u8; 2] or BinaryParseError {
        try self.need(2)
        let at = self.at
        self.at += 2
        return [self.data[at], self.data[at + 1]]
    }

    func next4(mutate self) -> [u8; 4] or BinaryParseError {
        try self.need(4)
        let at = self.at
        self.at += 4
        return [self.data[at], self.data[at + 1], self.data[at + 2], self.data[at + 3]]
    }

    func next8(mutate self) -> [u8; 8] or BinaryParseError {
        try self.need(8)
        let at = self.at
        self.at += 8
        return [self.data[at], self.data[at + 1], self.data[at + 2], self.data[at + 3], self.data[at + 4], self.data[at + 5], self.data[at + 6], self.data[at + 7]]
    }
}

// ── Binary building (K2) ────────────────────────────────────────────

public struct BinaryBuilder {
    data: Vec<u8>
}

extend BinaryBuilder {
    public func new() -> BinaryBuilder {
        return BinaryBuilder(data: Vec.new())
    }

    public func with_capacity(n: usize) -> BinaryBuilder {
        return BinaryBuilder(data: Vec.with_capacity(n))
    }

    public func write_u8(take self, value: u8) -> BinaryBuilder {
        mut b = self
        b.data.push(value)
        return b
    }

    public func write_i8(take self, value: i8) -> BinaryBuilder {
        mut b = self
        b.data.push(value.wrap<u8>())
        return b
    }

    public func write_u16be(take self, value: u16) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_u16le(take self, value: u16) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i16be(take self, value: i16) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i16le(take self, value: i16) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_u32be(take self, value: u32) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_u32le(take self, value: u32) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i32be(take self, value: i32) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i32le(take self, value: i32) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_u64be(take self, value: u64) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_u64le(take self, value: u64) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i64be(take self, value: i64) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i64le(take self, value: i64) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_f32be(take self, value: f32) -> BinaryBuilder {
        return self.write_u32be(value.to_bits())
    }

    public func write_f32le(take self, value: f32) -> BinaryBuilder {
        return self.write_u32le(value.to_bits())
    }

    public func write_f64be(take self, value: f64) -> BinaryBuilder {
        return self.write_u64be(value.to_bits())
    }

    public func write_f64le(take self, value: f64) -> BinaryBuilder {
        return self.write_u64le(value.to_bits())
    }

    public func write_bytes(take self, octets: Vec<u8>) -> BinaryBuilder {
        mut b = self
        for byte in octets {
            b.data.push(byte)
        }
        return b
    }

    public func len(self) -> usize {
        return self.data.len()
    }

    public func build(take self) -> Vec<u8> {
        return self.data
    }
}
