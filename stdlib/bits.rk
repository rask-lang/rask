// Binary parsing and building (std.bits).
//
// The integer methods std.bits also promises (count_ones … rotate_right,
// to_be … from_ne_bytes) are in int.rk, written once for every width.

// ── Binary parsing (P3–P5) ──────────────────────────────────────────

public enum BinaryParseError {
    UnexpectedEnd(expected: usize, actual: usize)
    InvalidData(message: string)
}

extend BinaryParseError {
    public func message(self) -> string {
        match self {
            BinaryParseError.UnexpectedEnd(expected, actual) => return "unexpected end: expected {expected} bytes, got {actual}"
            BinaryParseError.InvalidData(message) => return "invalid data: {message}"
        }
    }
}

extend Vec<u8> {
    public func read_u8(self, at: usize) -> (u8, usize) or BinaryParseError {
        let b = try first1(self, at)
        return (b[0], at + 1)
    }

    public func read_i8(self, at: usize) -> (i8, usize) or BinaryParseError {
        let b = try first1(self, at)
        return (i8.from_le_bytes(b), at + 1)
    }

    public func read_u16be(self, at: usize) -> (u16, usize) or BinaryParseError {
        let b = try first2(self, at)
        return (u16.from_be_bytes(b), at + 2)
    }

    public func read_u16le(self, at: usize) -> (u16, usize) or BinaryParseError {
        let b = try first2(self, at)
        return (u16.from_le_bytes(b), at + 2)
    }

    public func read_i16be(self, at: usize) -> (i16, usize) or BinaryParseError {
        let b = try first2(self, at)
        return (i16.from_be_bytes(b), at + 2)
    }

    public func read_i16le(self, at: usize) -> (i16, usize) or BinaryParseError {
        let b = try first2(self, at)
        return (i16.from_le_bytes(b), at + 2)
    }

    public func read_u32be(self, at: usize) -> (u32, usize) or BinaryParseError {
        let b = try first4(self, at)
        return (u32.from_be_bytes(b), at + 4)
    }

    public func read_u32le(self, at: usize) -> (u32, usize) or BinaryParseError {
        let b = try first4(self, at)
        return (u32.from_le_bytes(b), at + 4)
    }

    public func read_i32be(self, at: usize) -> (i32, usize) or BinaryParseError {
        let b = try first4(self, at)
        return (i32.from_be_bytes(b), at + 4)
    }

    public func read_i32le(self, at: usize) -> (i32, usize) or BinaryParseError {
        let b = try first4(self, at)
        return (i32.from_le_bytes(b), at + 4)
    }

    public func read_u64be(self, at: usize) -> (u64, usize) or BinaryParseError {
        let b = try first8(self, at)
        return (u64.from_be_bytes(b), at + 8)
    }

    public func read_u64le(self, at: usize) -> (u64, usize) or BinaryParseError {
        let b = try first8(self, at)
        return (u64.from_le_bytes(b), at + 8)
    }

    public func read_i64be(self, at: usize) -> (i64, usize) or BinaryParseError {
        let b = try first8(self, at)
        return (i64.from_be_bytes(b), at + 8)
    }

    public func read_i64le(self, at: usize) -> (i64, usize) or BinaryParseError {
        let b = try first8(self, at)
        return (i64.from_le_bytes(b), at + 8)
    }

    public func read_f32be(self, at: usize) -> (f32, usize) or BinaryParseError {
        let b = try first4(self, at)
        return (f32.from_bits(u32.from_be_bytes(b)), at + 4)
    }

    public func read_f32le(self, at: usize) -> (f32, usize) or BinaryParseError {
        let b = try first4(self, at)
        return (f32.from_bits(u32.from_le_bytes(b)), at + 4)
    }

    public func read_f64be(self, at: usize) -> (f64, usize) or BinaryParseError {
        let b = try first8(self, at)
        return (f64.from_bits(u64.from_be_bytes(b)), at + 8)
    }

    public func read_f64le(self, at: usize) -> (f64, usize) or BinaryParseError {
        let b = try first8(self, at)
        return (f64.from_bits(u64.from_le_bytes(b)), at + 8)
    }

    /// The `n` bytes from `at` on, and the offset past them.
    public func read_bytes(self, at: usize, n: usize) -> (Vec<u8>, usize) or BinaryParseError {
        try need(self, at, n)
        mut head: Vec<u8> = Vec.with_capacity(n)
        for i in at..at + n {
            head.push(self[i])
        }
        return (head, at + n)
    }
}

/// Fails unless `data` holds at least `n` bytes from `at` on.
func need(data: Vec<u8>, at: usize, n: usize) -> void or BinaryParseError {
    let left = if at < data.len() { data.len() - at } else { 0 }
    if left < n {
        return BinaryParseError.UnexpectedEnd(expected: n, actual: left)
    }
}

func first1(data: Vec<u8>, at: usize) -> [u8; 1] or BinaryParseError {
    try need(data, at, 1)
    return [data[at]]
}

func first2(data: Vec<u8>, at: usize) -> [u8; 2] or BinaryParseError {
    try need(data, at, 2)
    return [data[at], data[at + 1]]
}

func first4(data: Vec<u8>, at: usize) -> [u8; 4] or BinaryParseError {
    try need(data, at, 4)
    return [data[at], data[at + 1], data[at + 2], data[at + 3]]
}

func first8(data: Vec<u8>, at: usize) -> [u8; 8] or BinaryParseError {
    try need(data, at, 8)
    return [data[at], data[at + 1], data[at + 2], data[at + 3], data[at + 4], data[at + 5], data[at + 6], data[at + 7]]
}

// ── Binary building (K2) ────────────────────────────────────────────

public struct BinaryBuilder {
    data: Vec<u8>
}

extend BinaryBuilder {
    public func new() -> BinaryBuilder {
        return BinaryBuilder(data: Vec.new())
    }

    public func with_capacity(n: usize) -> BinaryBuilder {
        return BinaryBuilder(data: Vec.with_capacity(n))
    }

    public func write_u8(take self, value: u8) -> BinaryBuilder {
        mut b = self
        b.data.push(value)
        return b
    }

    public func write_i8(take self, value: i8) -> BinaryBuilder {
        mut b = self
        b.data.push(value.wrap<u8>())
        return b
    }

    public func write_u16be(take self, value: u16) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_u16le(take self, value: u16) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i16be(take self, value: i16) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i16le(take self, value: i16) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_u32be(take self, value: u32) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_u32le(take self, value: u32) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i32be(take self, value: i32) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i32le(take self, value: i32) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_u64be(take self, value: u64) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_u64le(take self, value: u64) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i64be(take self, value: i64) -> BinaryBuilder {
        mut b = self
        for byte in value.to_be_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_i64le(take self, value: i64) -> BinaryBuilder {
        mut b = self
        for byte in value.to_le_bytes() {
            b.data.push(byte)
        }
        return b
    }

    public func write_f32be(take self, value: f32) -> BinaryBuilder {
        return self.write_u32be(value.to_bits())
    }

    public func write_f32le(take self, value: f32) -> BinaryBuilder {
        return self.write_u32le(value.to_bits())
    }

    public func write_f64be(take self, value: f64) -> BinaryBuilder {
        return self.write_u64be(value.to_bits())
    }

    public func write_f64le(take self, value: f64) -> BinaryBuilder {
        return self.write_u64le(value.to_bits())
    }

    public func write_bytes(take self, bytes: Vec<u8>) -> BinaryBuilder {
        mut b = self
        for byte in bytes {
            b.data.push(byte)
        }
        return b
    }

    public func len(self) -> usize {
        return self.data.len()
    }

    public func build(take self) -> Vec<u8> {
        return self.data
    }
}
