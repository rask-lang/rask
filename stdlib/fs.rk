extern "C" func fopen(path: *u8, mode: *u8) -> *u8
extern "C" func fclose(f: *u8) -> i32
extern "C" func fread(ptr: *u8, size: u64, count: u64, stream: *u8) -> u64
extern "C" func fwrite(ptr: *u8, size: u64, count: u64, stream: *u8) -> u64
extern "C" func fseek(stream: *u8, offset: i64, whence: i32) -> i32
extern "C" func ftell(stream: *u8) -> i64
extern "C" func rask_alloc(size: i64) -> *u8
extern "C" func rask_free(ptr: *u8)
extern "C" func rask_string_from_bytes(out: *u8, data: *u8, len: i64)
extern "C" func rask_fwrite_vec(f: *u8, data: *u8)
extern "C" func access(path: *u8, mode: i32) -> i32
extern "C" func rask_libc_rename(from: *u8, to: *u8) -> i32
extern "C" func rask_libc_remove(path: *u8) -> i32
extern "C" func rask_libc_mkdir(path: *u8, mode: u32) -> i32
extern "C" func realpath(path: *u8, resolved: *u8) -> *u8
extern "C" func strlen(s: *u8) -> u64
extern "C" func opendir(path: *u8) -> *u8
extern "C" func readdir(dir: *u8) -> *u8
extern "C" func closedir(dir: *u8) -> i32
extern "C" func rask_dirent_name(entry: *u8) -> *u8
extern "C" func rask_stat_size(path: *u8) -> i64
extern "C" func rask_stat_mtime(path: *u8) -> i64
extern "C" func rask_stat_atime(path: *u8) -> i64
extern "C" func getcwd(buf: *u8, size: u64) -> *u8
extern "C" func getenv(name: *u8) -> *u8

/// File system operations.
struct fs { }

extend fs {
    /// Open a file at the given path.
    @native("rask_fs_open")
    public func open(path: string) -> File or IoError { }

    /// Create a new file at the given path.
    @native("rask_fs_create")
    public func create(path: string) -> File or IoError { }

    /// Read the entire contents of a file as a string.
    public func read_text(path: string) -> string or IoError {
        let p = unsafe path.as_c_str()
        let f = unsafe fopen(p, "rb\0".as_ptr())
        if unsafe f.is_null() {
            return IoError.Other("could not open file")
        }
        unsafe fseek(f, 0, 2)
        let size = unsafe ftell(f)
        unsafe fseek(f, 0, 0)
        if size <= 0 {
            unsafe fclose(f)
            return ""
        }
        let buf = unsafe rask_alloc(size + 1)
        let n = unsafe fread(buf, 1, size truncate to u64, f)
        unsafe fclose(f)
        let result = unsafe string.from_raw(buf, n as usize)
        unsafe rask_free(buf)
        return result
    }

    /// Read the entire contents of a file as bytes.
    public func read_bytes(path: string) -> Vec<u8> or IoError {
        let p = unsafe path.as_c_str()
        let f = unsafe fopen(p, "rb\0".as_ptr())
        if unsafe f.is_null() {
            return IoError.Other("could not open file")
        }
        unsafe fseek(f, 0, 2)
        let size = unsafe ftell(f)
        unsafe fseek(f, 0, 0)
        mut bytes: Vec<u8> = Vec.new()
        if size > 0 {
            let buf = unsafe rask_alloc(size)
            let n = unsafe fread(buf, 1, size truncate to u64, f)
            mut i: u64 = 0
            loop {
                if i >= n { break }
                let b = unsafe buf.add(i as usize).read()
                bytes.push(b as u8)
                i = i + 1
            }
            unsafe rask_free(buf)
        }
        unsafe fclose(f)
        return bytes
    }

    /// Write a string to a file, replacing its contents.
    public func write_text(path: string, content: string) -> void or IoError {
        let p = unsafe path.as_c_str()
        let f = unsafe fopen(p, "wb\0".as_ptr())
        if unsafe f.is_null() {
            return IoError.Other("could not open file")
        }
        let ptr = unsafe content.as_ptr()
        let len = content.len() truncate to u64
        unsafe fwrite(ptr, 1, len, f)
        unsafe fclose(f)
        return
    }

    /// Write bytes to a file, replacing its contents.
    @native("rask_fs_write_bytes")
    public func write_bytes(path: string, data: Vec<u8>) -> void or IoError { }

    /// Check if a file or directory exists at the path.
    public func exists(path: string) -> bool {
        let p = unsafe path.as_c_str()
        return unsafe { access(p, 0) } == 0
    }

    /// Read a file and split into lines.
    public func read_lines(path: string) -> Vec<string> or IoError {
        let content = try fs.read_text(path)
        mut lines: Vec<string> = Vec.new()
        for line in content.lines() {
            lines.push(line)
        }
        return lines
    }

    /// Return the canonical, absolute form of a path.
    public func absolute_path(path: string) -> string or IoError {
        let buf = unsafe rask_alloc(4096)
        let result = unsafe realpath(path.as_c_str(), buf)
        if unsafe result.is_null() {
            unsafe rask_free(buf)
            return IoError.Other("could not resolve path")
        }
        let len = unsafe strlen(buf)
        let s = unsafe string.from_raw(buf, len as usize)
        unsafe rask_free(buf)
        return s
    }

    /// Copy a file from one path to another.
    public func copy(from: string, to: string) -> void or IoError {
        let src = unsafe fopen(from.as_c_str(), "rb\0".as_ptr())
        if unsafe src.is_null() {
            return IoError.Other("could not open source file")
        }
        let dst = unsafe fopen(to.as_c_str(), "wb\0".as_ptr())
        if unsafe dst.is_null() {
            unsafe fclose(src)
            return IoError.Other("could not open destination file")
        }
        let buf = unsafe rask_alloc(8192)
        loop {
            let n = unsafe fread(buf, 1, 8192, src)
            if n == 0 { break }
            unsafe fwrite(buf, 1, n, dst)
        }
        unsafe rask_free(buf)
        unsafe fclose(src)
        unsafe fclose(dst)
        return
    }

    /// Rename a file or directory.
    public func rename(from: string, to: string) -> void or IoError {
        let r = unsafe rask_libc_rename(from.as_c_str(), to.as_c_str())
        if r != 0 {
            return IoError.Other("could not rename")
        }
        return
    }

    /// Remove a file.
    public func remove_file(path: string) -> void or IoError {
        let r = unsafe rask_libc_remove(path.as_c_str())
        if r != 0 {
            return IoError.Other("could not remove")
        }
        return
    }

    /// Create a directory.
    public func create_dir(path: string) -> void or IoError {
        let r = unsafe rask_libc_mkdir(path.as_c_str(), 493)
        if r != 0 {
            return IoError.Other("could not create directory")
        }
        return
    }

    /// Create a directory and all parent directories.
    @native("rask_fs_create_dir_all")
    public func create_dir_all(path: string) -> void or IoError { }

    /// Append a string to a file.
    public func append_text(path: string, content: string) -> void or IoError {
        let p = unsafe path.as_c_str()
        let f = unsafe fopen(p, "ab\0".as_ptr())
        if unsafe f.is_null() {
            return IoError.Other("could not open file for append")
        }
        let ptr = unsafe content.as_ptr()
        let len = content.len() truncate to u64
        unsafe fwrite(ptr, 1, len, f)
        unsafe fclose(f)
        return
    }

    /// List entries in a directory.
    public func list_dir(path: string) -> Vec<string> or IoError {
        let dir = unsafe opendir(path.as_c_str())
        if unsafe dir.is_null() {
            return IoError.Other("could not open directory")
        }
        mut entries: Vec<string> = Vec.new()
        loop {
            let entry = unsafe readdir(dir)
            if unsafe entry.is_null() { break }
            let name_ptr = unsafe rask_dirent_name(entry)
            let name_len = unsafe strlen(name_ptr)
            let name = unsafe string.from_raw(name_ptr, name_len as usize)
            // Skip . and ..
            if name != "." {
                if name != ".." {
                    entries.push(name)
                }
            }
        }
        unsafe closedir(dir)
        return entries
    }

    /// Get metadata for a file or directory.
    @native("rask_fs_metadata")
    public func metadata(path: string) -> Metadata or IoError { }

    /// Current working directory.
    public func current_dir() -> Path {
        let buf = unsafe rask_alloc(4096)
        let result = unsafe getcwd(buf, 4096)
        if unsafe result.is_null() {
            unsafe rask_free(buf)
            return Path.from(".")
        }
        let len = unsafe strlen(buf)
        let s = unsafe string.from_raw(buf, len as usize)
        unsafe rask_free(buf)
        return Path.from(s)
    }

    /// User home directory. none if unknown.
    public func home_dir() -> Path? {
        let ptr = unsafe getenv("HOME\0".as_ptr())
        if unsafe ptr.is_null() {
            return none
        }
        let len = unsafe strlen(ptr)
        let s = unsafe string.from_raw(ptr, len as usize)
        return Path.from(s)
    }
}

/// File metadata: size, access time, modification time.
public struct Metadata { }

extend Metadata {
    /// File size in bytes.
    @native("rask_metadata_size")
    public func size(self) -> u64 { }

    /// Last access time as Unix epoch seconds.
    @native("rask_metadata_accessed")
    public func accessed(self) -> i64 { }

    /// Last modification time as Unix epoch seconds.
    @native("rask_metadata_modified")
    public func modified(self) -> i64 { }
}
