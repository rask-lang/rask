// fopen, access and opendir go through the runtime rather than libc, which is
// where sim puts its filesystem overlay (sim/B5).
extern "C" func rask_libc_fopen(path: *u8, mode: *u8) -> *u8?

extern "C" func fclose(f: *u8) -> i32

extern "C" func fread(ptr: *u8, size: usize, count: usize, stream: *u8) -> usize

extern "C" func fwrite(ptr: *u8, size: usize, count: usize, stream: *u8) -> usize

extern "C" func fseek(stream: *u8, offset: c_long, whence: c_int) -> c_int

extern "C" func ftell(stream: *u8) -> c_long

extern "C" func ferror(stream: *u8) -> i32

@memory_only
extern "C" func rask_alloc(size: i64) -> *u8

@memory_only
extern "C" func rask_free(ptr: *u8)

@memory_only
extern "C" func rask_realloc(ptr: *u8, old_size: i64, new_size: i64) -> *u8

@memory_only
extern "C" func rask_string_from_bytes(out: *u8, data: *u8, len: i64)

extern "C" func rask_libc_access(path: *u8, mode: i32) -> i32

extern "C" func rask_libc_rename(from: *u8, to: *u8) -> i32

extern "C" func rask_libc_unlink(path: *u8) -> i32

extern "C" func rask_libc_mkdir(path: *u8, mode: u32) -> i32

extern "C" func rask_libc_mkdir_or_dir(path: *u8, mode: u32) -> i32

extern "C" func realpath(path: *u8, resolved: *u8) -> *u8?

@memory_only
extern "C" func strlen(s: *u8) -> usize

extern "C" func getcwd(buf: *u8, size: usize) -> *u8?

extern "C" func getenv(name: *u8) -> *u8?

/// File system operations.
struct fs { }

extend fs {
    /// Open a file at the given path.
    ///
    /// The check is here rather than in the runtime because the runtime can't
    /// build an `IoError` — it's a Rask enum. A failed `fopen` used to come
    /// back as a NULL `File` and sail through as a success: the failure only
    /// surfaced on the first read, as "file handle is closed" (#858).
    public func open(path: string) -> File or IoError {
        if fs.open_handle(path) is File as f {
            return f
        }
        return IoError.last_os_error()
    }

    /// Create a new file at the given path.
    ///
    /// Named for what it makes, beside `create_dir` and `remove_file`. Bare
    /// `create` in a filesystem module doesn't say which of the two it is.
    public func create_file(path: string) -> File or IoError {
        if fs.create_handle(path) is File as f {
            return f
        }
        return IoError.last_os_error()
    }

    /// The raw `fopen`: `none` when it failed, with the OS error left for
    /// `IoError.last_os_error`. `open` is the one to call.
    @native("rask_fs_open")
    @blocks
    func open_handle(path: string) -> File? {}

    /// The raw `fopen` in write mode. `create_file` is the one to call.
    @native("rask_fs_create")
    @blocks
    func create_handle(path: string) -> File? {}

    /// Read the entire contents of a file as a string.
    public func read_text(path: string) -> string or IoError {
        let f = unsafe rask_libc_fopen(path.as_ptr(), "rb\0".as_ptr()) ?? return IoError.last_os_error()
        let raw = try read_to_end(f)
        let result = unsafe string.from_raw(raw.ptr, raw.len.wrap<usize>())
        unsafe rask_free(raw.ptr)
        return result
    }

    /// Read the entire contents of a file as bytes.
    public func read_bytes(path: string) -> Vec<u8> or IoError {
        let f = unsafe rask_libc_fopen(path.as_ptr(), "rb\0".as_ptr()) ?? return IoError.last_os_error()
        let raw = try read_to_end(f)
        mut data: Vec<u8> = Vec.with_capacity(raw.len.wrap<usize>())
        mut i: i64 = 0
        loop {
            if i >= raw.len { break }
            data.push(unsafe raw.ptr.add(i.wrap<usize>()).read())
            i = i + 1
        }
        unsafe rask_free(raw.ptr)
        return data
    }

    /// Write a string to a file, replacing its contents.
    public func write_text(path: string, content: string) -> void or IoError {
        let p = unsafe path.as_ptr()
        let f = unsafe rask_libc_fopen(p, "wb\0".as_ptr()) ?? return IoError.last_os_error()
        return write_all_then_close(f, unsafe content.as_ptr(), content.len())
    }

    /// Write bytes to a file, replacing its contents.
    public func write_bytes(path: string, data: Vec<u8>) -> void or IoError {
        let f = unsafe rask_libc_fopen(path.as_ptr(), "wb\0".as_ptr()) ?? return IoError.last_os_error()
        // Byte by byte into a flat buffer, the one shape `fwrite` takes.
        let n = data.len()
        let buf = unsafe rask_alloc(if n > 0 { n.wrap<i64>() } else { 1 })
        mut i: usize = 0
        for b in data {
            unsafe buf.add(i).write(b)
            i = i + 1
        }
        let result = write_all_then_close(f, buf, n)
        unsafe rask_free(buf)
        return result
    }

    /// Check if a file or directory exists at the path.
    public func exists(path: string) -> bool {
        let p = unsafe path.as_ptr()
        return (unsafe {
            rask_libc_access(p, 0)
        }) == 0
    }

    /// Read a file and split into lines.
    public func read_lines(path: string) -> Vec<string> or IoError {
        let content = try fs.read_text(path)
        mut lines: Vec<string> = Vec.new()
        for line in content.lines() {
            lines.push(line.to_string())
        }
        return lines
    }

    /// Return the canonical, absolute form of a path.
    public func absolute_path(path: string) -> string or IoError {
        let buf = unsafe rask_alloc(4096)
        let result = unsafe realpath(path.as_ptr(), buf)
        if result is none {
            unsafe rask_free(buf)
            return IoError.last_os_error()
        }
        let len = unsafe strlen(buf)
        let s = unsafe string.from_raw(buf, len)
        unsafe rask_free(buf)
        return s
    }

    /// Copy a file from one path to another.
    public func copy(from: string, to: string) -> void or IoError {
        let src = unsafe rask_libc_fopen(from.as_ptr(), "rb\0".as_ptr()) ?? return IoError.last_os_error()
        let dst = unsafe rask_libc_fopen(to.as_ptr(), "wb\0".as_ptr()) ?? {
            unsafe fclose(src)
            return IoError.last_os_error()
        }
        let buf = unsafe rask_alloc(8192)
        loop {
            let n = unsafe fread(buf, 1, 8192, src)
            let failed = if n == 0 {
                (unsafe ferror(src)) != 0
            } else {
                (unsafe fwrite(buf, 1, n, dst)) < n || (unsafe ferror(dst)) != 0
            }
            // errno is read before either close can touch it.
            if failed {
                let err = IoError.last_os_error()
                unsafe rask_free(buf)
                unsafe fclose(src)
                unsafe fclose(dst)
                return err
            }
            if n == 0 { break }
        }
        unsafe rask_free(buf)
        unsafe fclose(src)
        if (unsafe fclose(dst)) != 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// Rename a file or directory.
    public func rename(from: string, to: string) -> void or IoError {
        let r = unsafe rask_libc_rename(from.as_ptr(), to.as_ptr())
        if r != 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// Remove a file or a link. A directory is an error: that's `remove_dir`.
    public func remove_file(path: string) -> void or IoError {
        let r = unsafe rask_libc_unlink(path.as_ptr())
        if r != 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// Create a directory.
    public func create_dir(path: string) -> void or IoError {
        let r = unsafe rask_libc_mkdir(path.as_ptr(), 493)
        if r != 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// Create a directory and all parent directories. One that already exists
    /// is fine; a file in the way is an error.
    public func create_dir_all(path: string) -> void or IoError {
        mut prefix = if path.starts_with("/") { "/" } else { "" }
        for part in path.split("/") {
            if part.is_empty() {
                continue
            }
            prefix = if prefix.is_empty() || prefix == "/" { "{prefix}{part}" } else { "{prefix}/{part}" }
            if (unsafe rask_libc_mkdir_or_dir(prefix.as_ptr(), 493)) != 0 {
                return IoError.last_os_error()
            }
        }
        return
    }

    /// Append a string to a file.
    public func append_text(path: string, content: string) -> void or IoError {
        let p = unsafe path.as_ptr()
        let f = unsafe rask_libc_fopen(p, "ab\0".as_ptr()) ?? return IoError.last_os_error()
        return write_all_then_close(f, unsafe content.as_ptr(), content.len())
    }

    /// The entries in a directory, without `.` and `..`, in the order the
    /// filesystem lists them — which is no particular order.
    ///
    /// Each entry's `path` is `path` and the name joined, so it can be handed
    /// straight back to any `fs` call. `list_dir` gave the names alone, which
    /// every caller then had to join; it's gone.
    public func read_dir(path: string) -> Vec<DirEntry> or IoError {
        if fs.read_dir_names(path) is Vec<string> as names {
            let sep = if path.ends_with("/") { "" } else { "/" }
            mut entries: Vec<DirEntry> = Vec.with_capacity(names.len())
            for name in names {
                entries.push(DirEntry(name: name.clone(), path: "{path}{sep}{name}"))
            }
            return entries
        }
        return IoError.last_os_error()
    }

    /// Remove an empty directory. A file is an error: that's `remove_file`.
    public func remove_dir(path: string) -> void or IoError {
        if fs.remove_dir_raw(path) != 0 {
            return IoError.last_os_error()
        }
        return
    }

    /// Remove a directory and everything in it. A symlink inside is removed
    /// as a link; what it points at is left alone.
    public func remove_dir_all(path: string) -> void or IoError {
        for entry in try fs.read_dir(path) {
            let kind = fs.kind_raw(entry.path)
            if kind < 0 {
                return IoError.last_os_error()
            }
            if kind == 2 {
                try fs.remove_dir_all(entry.path)
            } else {
                try fs.remove_file(entry.path)
            }
        }
        return fs.remove_dir(path)
    }

    /// Open a file the way `opts` says (F5). Asking for no access, or for
    /// `create`/`truncate` without a way to write, is an error rather than a
    /// guess at what was meant.
    public func open_with(path: string, opts: OpenOptions) -> File or IoError {
        if !opts.reading && !opts.writing && !opts.appending {
            return IoError.Other("OpenOptions asks for no access: set read, write or append")
        }
        if (opts.creating || opts.truncating) && !opts.writing && !opts.appending {
            return IoError.Other("OpenOptions: create and truncate need write or append")
        }
        if opts.truncating && opts.appending {
            return IoError.Other("OpenOptions: truncate and append can't both be set")
        }
        mut flags: i64 = 0
        if opts.reading {
            flags = flags + 1
        }
        if opts.writing {
            flags = flags + 2
        }
        if opts.appending {
            flags = flags + 4
        }
        if opts.creating {
            flags = flags + 8
        }
        if opts.truncating {
            flags = flags + 16
        }
        if fs.open_with_handle(path, flags) is File as f {
            return f
        }
        return IoError.last_os_error()
    }

    /// Get metadata for a file or directory.
    ///
    /// One stat, with the error built on this side (#674): the runtime used
    /// to hand back a null pointer as a `Metadata`, and the `catch` never ran.
    public func metadata(path: string) -> Metadata or IoError {
        if fs.stat_load(path) != 0 {
            return IoError.last_os_error()
        }
        return fs.loaded_metadata()
    }

    /// The fields of the last stat, from either load.
    func loaded_metadata() -> Metadata {
        return Metadata(size: fs.loaded_size(), modified: fs.loaded_mtime(), accessed: fs.loaded_atime())
    }

    // The seams under the functions above. Each failure is -1 or `none` with
    // the OS error left for `IoError.last_os_error`.

    @native("rask_fs_read_dir_names")
    @blocks
    func read_dir_names(path: string) -> Vec<string>? {}
    @native("rask_fs_remove_dir")
    @blocks
    func remove_dir_raw(path: string) -> i64 {}
    /// What `path` is, not following a link: 1 file, 2 directory,
    /// 3 symlink, 4 anything else, or -1.
    @native("rask_fs_kind")
    @blocks
    func kind_raw(path: string) -> i64 {}
    /// `flags`: 1 read, 2 write, 4 append, 8 create, 16 truncate.
    @native("rask_fs_open_with")
    @blocks
    func open_with_handle(path: string, flags: i64) -> File? {}
    @native("rask_fs_stat_load")
    @blocks
    func stat_load(path: string) -> i64 {}
    @native("rask_stat_loaded_size")
    func loaded_size() -> u64 {}
    @native("rask_stat_loaded_mtime")
    func loaded_mtime() -> i64 {}
    @native("rask_stat_loaded_atime")
    func loaded_atime() -> i64 {}

    /// Current working directory.
    public func current_dir() -> Path {
        let buf = unsafe rask_alloc(4096)
        let result = unsafe getcwd(buf, 4096)
        if result is none {
            unsafe rask_free(buf)
            return Path.from(".")
        }
        let len = unsafe strlen(buf)
        let s = unsafe string.from_raw(buf, len)
        unsafe rask_free(buf)
        return Path.from(s)
    }

    /// User home directory. none if unknown.
    public func home_dir() -> Path? {
        let ptr = unsafe getenv("HOME\0".as_ptr()) ?? return none
        let len = unsafe strlen(ptr)
        let s = unsafe string.from_raw(ptr, len)
        return Path.from(s)
    }
}

/// A file's bytes, in a buffer the caller frees.
struct RawBytes {
    ptr: *u8
    len: i64
}

/// Read `f` to end of file and close it. The size `ftell` reports is only a
/// first guess at the buffer: a /proc file reports 0 and a sysfs file a whole
/// page, whatever they hold. A short `fread` is the end of the file unless
/// `ferror` says otherwise.
func read_to_end(f: *u8) -> RawBytes or IoError {
    unsafe fseek(f, 0, 2)
    let guess = unsafe ftell(f)
    unsafe fseek(f, 0, 0)
    mut cap: i64 = if guess > 0 { (guess as i64) + 1 } else { 4096 }
    mut buf = unsafe rask_alloc(cap)
    mut len: i64 = 0
    loop {
        if len == cap {
            buf = unsafe rask_realloc(buf, cap, cap * 2)
            cap = cap * 2
        }
        let n = unsafe fread(buf.add(len.wrap<usize>()), 1, (cap - len).wrap<usize>(), f)
        if n == 0 {
            // errno is read before fclose can touch it.
            if (unsafe ferror(f)) != 0 {
                let err = IoError.last_os_error()
                unsafe fclose(f)
                unsafe rask_free(buf)
                return err
            }
            unsafe fclose(f)
            return RawBytes(ptr: buf, len)
        }
        len = len + n.wrap<i64>()
    }
}

/// Write `len` bytes from `ptr` and close `f`, reporting either step failing.
/// The write is buffered, so a disk that refuses the bytes usually says so at
/// the close; a caller that only checked `fwrite` would report success for
/// data that never arrived.
func write_all_then_close(f: *u8, ptr: *u8, size: usize) -> void or IoError {
    let wrote = unsafe fwrite(ptr, 1, size, f)
    // `ferror` as well as the count: an unbuffered stream can report the
    // whole count for a write that failed.
    if wrote < size || (unsafe ferror(f)) != 0 {
        let err = IoError.last_os_error()
        unsafe fclose(f)
        return err
    }
    if (unsafe fclose(f)) != 0 {
        return IoError.last_os_error()
    }
    return
}

extend File {
    /// Size and times of the open file, from the handle rather than a path,
    /// so a file renamed or removed since it was opened still answers.
    /// Unwritten bytes are flushed first, so `size` counts what this handle
    /// wrote.
    public func metadata(self) -> Metadata or IoError {
        if self.stat_raw() != 0 {
            return IoError.last_os_error()
        }
        return fs.loaded_metadata()
    }

    /// `fstat` into the slot `fs.loaded_metadata` reads: 0, or -1.
    @native("rask_file_stat_load")
    @blocks
    func stat_raw(self) -> i64 {}
}

/// How `fs.open_with` opens a file (F5). Every setter hands back a new value,
/// so a chain reads left to right: `OpenOptions.new().write(true).create(true)`.
/// All off to start with.
public struct OpenOptions {
    reading: bool
    writing: bool
    appending: bool
    creating: bool
    truncating: bool
}

extend OpenOptions {
    /// Nothing set. `open_with` refuses this as it stands: say what to open for.
    public func new() -> OpenOptions {
        return OpenOptions(reading: false, writing: false, appending: false, creating: false, truncating: false)
    }

    /// Open for reading.
    public func read(self, on: bool) -> OpenOptions {
        mut o = self
        o.reading = on
        return o
    }

    /// Open for writing, from the start of the file.
    public func write(self, on: bool) -> OpenOptions {
        mut o = self
        o.writing = on
        return o
    }

    /// Open for writing, every write going to the end.
    public func append(self, on: bool) -> OpenOptions {
        mut o = self
        o.appending = on
        return o
    }

    /// Create the file if it isn't there.
    public func create(self, on: bool) -> OpenOptions {
        mut o = self
        o.creating = on
        return o
    }

    /// Empty the file on open.
    public func truncate(self, on: bool) -> OpenOptions {
        mut o = self
        o.truncating = on
        return o
    }
}

/// One entry from `fs.read_dir`.
public struct DirEntry {
    /// The file name, no directory.
    public name: string
    /// The directory and the name joined: usable as a path as it stands.
    public path: string
}

/// File metadata: size, access time, modification time.
///
/// Plain fields, as std.fs specifies. It used to be an opaque handle with
/// `size()`/`accessed()`/`modified()` accessors reading out of a C-allocated
/// array, which is what forced `metadata` to be `@native` and left it with no
/// way to report a failure.
public struct Metadata {
    /// File size in bytes.
    public size: u64
    /// Last modification time as Unix epoch seconds.
    public modified: i64
    /// Last access time as Unix epoch seconds.
    public accessed: i64
}
