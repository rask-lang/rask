// Wrapping<T> and Saturating<T> (type.overflow W1-W4) — non-panicking
// arithmetic as a type instead of a call per operation. The one-off methods
// (.wrapping_add() etc, M1) already do the real work per width; these wrap a
// value once so every `+`/`-`/`*` on it goes through the same hatch without
// spelling out the method name each time. Each is a newtype: built from its
// one value, `Wrapping(5381u32)`, and read back with `.value`.

public type Wrapping<T: Integer> = T

Wrapping<T> implements Add where T: Integer {
    public func add(self, other: Wrapping<T>) -> Wrapping<T> {
        return Wrapping(self.value.wrapping_add(other.value))
    }
}

Wrapping<T> implements Sub where T: Integer {
    public func sub(self, other: Wrapping<T>) -> Wrapping<T> {
        return Wrapping(self.value.wrapping_sub(other.value))
    }
}

Wrapping<T> implements Mul where T: Integer {
    public func mul(self, other: Wrapping<T>) -> Wrapping<T> {
        return Wrapping(self.value.wrapping_mul(other.value))
    }
}

public type Saturating<T: Integer> = T

Saturating<T> implements Add where T: Integer {
    public func add(self, other: Saturating<T>) -> Saturating<T> {
        return Saturating(self.value.saturating_add(other.value))
    }
}

Saturating<T> implements Sub where T: Integer {
    public func sub(self, other: Saturating<T>) -> Saturating<T> {
        return Saturating(self.value.saturating_sub(other.value))
    }
}

Saturating<T> implements Mul where T: Integer {
    public func mul(self, other: Saturating<T>) -> Saturating<T> {
        return Saturating(self.value.saturating_mul(other.value))
    }
}
