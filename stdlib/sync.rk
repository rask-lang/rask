// --- Shared: one value, several accessors, one scoped view (conc.sync) ---
//
// The strategy `S` says what synchronization the value takes, and it is a type
// argument — so `Shared<T>` is `Shared<T, Readers>` everywhere, and nothing
// about the choice survives into the emitted code. `Cell` and `Mutex` used to be
// separate types; they are these strategies now.

/// `Readers` — a read-write lock. Many readers at once, or one writer.
/// The default: most shared values are reached by more than one task, and the ones that
/// aren't only pay for a lock they could have opted out of.
public struct Readers { }

/// `Local` — no lock at all. Several accessors, one task. Opt in with
/// `Shared.local(…)` when the value provably never leaves its task.
public struct Local { }

/// `Mutex` — a plain lock. One holder at a time, reader or writer.
public struct Mutex { }

// `S` is written out here. These declarations are generic over the strategy —
// the accessors work under all three — and the constructors each name the one
// they build. A bare `Shared<T>` in a *user's* annotation means
// `Shared<T, Readers>`; leaving it bare here would have pinned every method to
// Readers and turned the other two strategies away at the door.
//
// Every method is `@builtin`. The strategy picks the runtime family a call
// lands in (`Readers`, `Mutex` or `Local`), so no one symbol is right for all
// three, and the compiler chooses it from the type argument.
extend Shared<T, S> {
    /// Many tasks, concurrent reads. The default — what you write unless you
    /// have a reason not to.
    @builtin
    public func new(take value: T) -> Shared<T, Readers> {}

    /// Many tasks, one at a time — reader or writer. Cheaper than `Readers`
    /// when writes dominate, since there is no reader count to keep.
    @builtin
    public func mutex(take value: T) -> Shared<T, Mutex> {}

    /// No lock at all. One task, several accessors — what `Cell` used to be.
    /// Sending one is a compile error (SH7), which is what makes it safe to
    /// reach for.
    @builtin
    public func local(take value: T) -> Shared<T, Local> {}

    // `read`, `write` and `staged` have no function to call: the compiler
    // takes the lock, runs the `with` block or the rest of the expression in
    // the caller's frame, and releases it.

    /// Shared access, scoped to the expression or the `with` block.
    /// Under `Mutex` this takes the exclusive lock: slower than `Readers` would
    /// be there, never wrong.
    @builtin
    public func read(self) -> T {}

    /// Exclusive access, scoped to the expression or the `with` block.
    @builtin
    public func write(self) -> T {}

    /// Exclusive access to a working copy, committed as one move on any
    /// non-panic exit and discarded on unwind (ST1-ST4). The clone is the price
    /// and the name says so — reach for it where a panic mid-update would leave
    /// an invariant other tasks read torn. Not available under `Local`: nothing
    /// else can observe the tear, and there is no unwind boundary to protect.
    ///
    /// Only as the source of a `with`: `with s.staged() as v { … }`. The commit
    /// happens when the block exits, so a call with no block has nowhere to put
    /// it, and the checker rejects one (E0846).
    @builtin
    public func staged(self) -> T {}

    /// Non-blocking read. `none` if contended; always succeeds under `Local`.
    @builtin
    public func try_read(self, f: func(T)) -> Option<T> {}

    /// Non-blocking write. `none` if contended; always succeeds under `Local`.
    @builtin
    public func try_write(self, f: func(T)) -> Option<T> {}

    /// Copy the inner value out. Copy types only — the single-expression
    /// shorthand `Cell` had.
    @builtin
    public func get(self) -> T {}

    /// Replace the inner value.
    @builtin
    public func set(self, take value: T) {}

    /// Swap in a new value, return the old one.
    @builtin
    public func replace(self, take value: T) -> T {}

    /// Consume the `Shared`, return what it held. Only for a box holding a
    /// resource or a `Heap`, which can't be cloned, so this is the last handle
    /// (SH9). Any other payload comes out with `replace`.
    ///
    /// `take` is the parameter mode this method's own receiver uses, and
    /// `Vec.take_all` is the same idea one level down. `into_inner` was `Cell`'s
    /// name, carried forward from a type Rask no longer has.
    @builtin
    public func take(take self) -> T {}
}

/// What a failed compare-exchange hands back: the value the atomic actually
/// held (mem.atomics).
///
/// The wrapper is what makes the two branches tell apart. `compare_exchange`
/// answers the old value on success and the observed value on failure — both
/// are a `T`, so `T or T` left every match arm ambiguous and `r is …` with
/// nothing to name.
///
/// One field, so it is the same word the atomic holds; the wrapper costs
/// nothing at run time.
public struct CasFailed<T> {
    public found: T
}

extend CasFailed<T> {
    public func message(self) -> string {
        return "compare-exchange found a different value"
    }
}

// --- Atomic: one word, read and written by one instruction (mem.atomics) ---
//
// Every method is `@builtin`: the compiler emits the instruction, or the runtime
// call, for the payload's width. Which payloads may sit in one (GA2), and which
// operations a payload has (GA3), are rules about the type, so the checker
// judges them before it reads a signature from here.
//
// Every operation is sequentially consistent unless the call says otherwise,
// so `a.load()` and `a.fetch_add(1)` are all most code writes. A weaker order is
// an optimization for code that has measured a need for one, and it's written
// at the call that wants it: `a.load(order: MemoryOrder.Relaxed)`.

/// How much an atomic operation orders the memory around it. The default,
/// `SeqCst`, is one order every task agrees on; the others give up some of
/// that for speed on hardware that reorders.
public enum MemoryOrder {
    /// Atomic, and nothing more: no ordering with other memory.
    Relaxed
    /// A load: nothing after it moves before it. Pairs with a `Release` store.
    Acquire
    /// A store: nothing before it moves after it. Pairs with an `Acquire` load.
    Release
    /// A read-modify-write that is both.
    AcqRel
    /// One total order all tasks agree on. The default.
    SeqCst
}

/// One word that any number of tasks read and write without a lock.
@handle(release: "rask_atomic_free")
public struct Atomic<T> { }

extend Atomic<T> {
    /// An atomic holding `value`.
    @builtin
    public func new(value: T) -> Atomic<T> {}

    /// An atomic holding the payload's zero: 0, `false`, a null pointer. A
    /// struct payload has no compiler-known default; use `new`.
    @builtin
    public func default() -> Atomic<T> {}

    /// Read the value.
    @builtin
    public func load(self, order: MemoryOrder = MemoryOrder.SeqCst) -> T {}

    /// Write the value. Takes `self`, not `mutate self`: the atomic does its
    /// own synchronizing (AT4).
    @builtin
    public func store(self, value: T, order: MemoryOrder = MemoryOrder.SeqCst) {}

    /// Write `value` and answer what was there.
    @builtin
    public func swap(self, value: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T {}

    /// If the value is `current`, write `new`. The old value on success,
    /// `CasFailed` holding what was actually there on failure. Compares bits.
    /// A failure only reads, so it uses `order` without its release half.
    @builtin
    public func compare_exchange(self, current: T, new: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T or CasFailed<T> {}

    /// `compare_exchange` that may fail when the value matched. Cheaper on
    /// some hardware; call it in a loop.
    @builtin
    public func compare_exchange_weak(self, current: T, new: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T or CasFailed<T> {}

    // The fetch family answers the old value and wraps on overflow (AT5).

    @builtin
    public func fetch_add(self, value: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T {}

    @builtin
    public func fetch_sub(self, value: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T {}

    @builtin
    public func fetch_max(self, value: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T {}

    @builtin
    public func fetch_min(self, value: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T {}

    @builtin
    public func fetch_and(self, value: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T {}

    @builtin
    public func fetch_or(self, value: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T {}

    @builtin
    public func fetch_xor(self, value: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T {}

    @builtin
    public func fetch_nand(self, value: T, order: MemoryOrder = MemoryOrder.SeqCst) -> T {}

    /// Consume the atomic and answer what it held. `take self` is what makes
    /// this safe without an ordering: nobody else can be reading it (AT3).
    @builtin
    public func take(take self) -> T {}
}
