// --- OS threads ---

/// Raw OS thread. Works anywhere — no context required.
///
///     let h = Thread.spawn { work() }
///
/// `Thread.spawn { … }` is a task block (conc.async/S3): language syntax, so
/// the type has no methods of its own.
public struct Thread { }

// --- Thread pool ---

/// Thread pool for CPU-bound work. Requires `using ThreadPool`.
///
///     let j = ThreadPool.spawn { compute(x) }
///
/// `ThreadPool.spawn { … }` is a task block (conc.async/S2).
public struct ThreadPool { }
