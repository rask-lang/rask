// SPDX-License-Identifier: (MIT OR Apache-2.0)

/// A dynamic, growable array.
@handle(release: "rask_vec_free")
public struct Vec<T> { }

extend Vec<T> {
    /// Create a new empty vector.
    @native("rask_vec_new")
    public func new() -> Vec<T> {}

    /// Create a vector with pre-allocated capacity.
    @native("rask_vec_with_capacity")
    public func with_capacity(n: usize) -> Vec<T> {}

    /// A Vec holding each of an array's elements.
    ///
    /// Lowered by the compiler: a Rask body needs `N` bound at the call, and
    /// native monomorphization doesn't bind a comptime parameter yet (#1623).
    @builtin
    public func from<comptime N: usize>(arr: [T; N]) -> Vec<T> {}

    /// Create a bounded vector that cannot grow beyond n elements (CP2, CP3).
    /// Pre-allocated at creation, and `push` past the bound panics.
    @native("rask_vec_fixed")
    public func fixed(n: usize) -> Vec<T> {}

    /// Number of elements.
    @native("rask_vec_len")
    public func len(self) -> usize {}

    /// True if the vector contains no elements.
    @native("rask_vec_is_empty")
    public func is_empty(self) -> bool {}

    /// Maximum capacity, if bounded — `none` when the vector may grow freely.
    @native("rask_vec_bound")
    public func capacity(self) -> Option<usize> {}

    /// True if this vector has a capacity bound.
    @native("rask_vec_is_bounded")
    public func is_bounded(self) -> bool {}

    /// True if this vector is bounded and at its bound.
    @native("rask_vec_is_full")
    public func is_full(self) -> bool {}

    /// Room left before the bound — `none` when the vector is unbounded.
    @native("rask_vec_remaining")
    public func remaining(self) -> Option<usize> {}

    /// How many elements the allocation has room for — the same unit as
    /// `len()`, which is why this isn't in bytes. `capacity()` is a different
    /// question: it answers the *bound*, and an unbounded vector has none.
    @native("rask_vec_allocated")
    public func allocated(self) -> usize {}

    /// Push a value onto the end. Panics if bounded and full, or on OOM.
    @native("rask_vec_push")
    @grows
    public func push(mutate self, take value: T) {}

    /// Push a value onto the end. Hands the value back instead of panicking
    /// when the vector is at its bound or the allocator refuses.
    ///
    /// Written in Rask so the two backends share one rule. `NoMemory` has no
    /// path yet — the allocator panics on OOM rather than reporting it.
    @grows
    public func try_push(mutate self, take value: T) -> void or GrowError<T> {
        if self.is_full() {
            return GrowError.Full(value)
        }
        self.push(value)
    }

    /// Push every element of `items`. Hands back the first one that didn't
    /// fit. `push_all`, not `extend` — that word is the declaration keyword.
    ///
    /// Takes any `Sequence<T>`: `a.try_push_all(b)` with `b` a `Vec` or a
    /// `Set` (a collection fills the slot itself, SEQ48), or a chain like
    /// `a.try_push_all(b.filter(p))`.
    ///
    /// Written in Rask so both backends share the rule, like `try_push` next
    /// to it. Stopping at the first refusal is what the doc says.
    ///
    /// A sequence lends its items, so what goes in — and what comes back
    /// refused — is a copy. Pushing the item itself gave `self` an element
    /// the source still owned (E0906, #1429).
    @grows
    @copies_elements
    public func try_push_all(mutate self, items: Sequence<T>) -> void or GrowError<T> {
        for item in items {
            if self.is_full() {
                return GrowError.Full(item.clone())
            }
            self.push(item.clone())
        }
    }

    /// Push every element of `items`. Panics if bounded and full, or on OOM.
    ///
    /// What goes in is a copy, for the reason `try_push_all` gives.
    @grows
    @copies_elements
    public func push_all(mutate self, items: Sequence<T>) -> void {
        for item in items {
            self.push(item.clone())
        }
    }

    /// Remove and return the last element.
    @native("rask_vec_pop")
    @shrinks
    public func pop(mutate self) -> Option<T> {}

    /// Remove all elements.
    @native("rask_vec_clear")
    @shrinks
    @drops_elements
    public func clear(mutate self) {}

    /// Insert a value at the given index, shifting later elements right.
    @native("rask_vec_insert_at", panics: true)
    @grows
    public func insert(mutate self, index: i64, take value: T) {}

    /// Insert at `index`, handing the value back instead of panicking when the
    /// vector is at its bound. An index past the end still panics, as it does
    /// for `insert`: that's a bug in the caller, not a full collection.
    @grows
    public func try_insert(mutate self, index: i64, take value: T) -> void or GrowError<T> {
        if self.is_full() {
            return GrowError.Full(value)
        }
        self.insert(index, value)
    }

    /// Remove and return the element at the given index.
    @native("rask_vec_remove_at", panics: true)
    @shrinks
    public func remove(mutate self, index: i64) -> T {}

    /// Remove and return the element at the given index by swapping in the
    /// last element — O(1), does not preserve order.
    ///
    /// Rask rather than a runtime symbol: `swap` and `pop` already do the two
    /// halves, and writing it here means both backends run the same three
    /// lines. The index is checked by `swap`.
    @shrinks
    public func remove_unordered(mutate self, index: i64) -> T {
        let last = self.len().wrap<i64>() - 1
        if index != last {
            self.swap(index, last)
        }
        return self.pop()!
    }

    /// Reserve space for at least `additional` more elements. Panics on OOM,
    /// and on a request past a bounded vector's bound.
    @native("rask_vec_reserve", panics: true)
    @grows
    public func reserve(mutate self, additional: usize) {}

    /// Reserve space for at least `additional` more elements. Reports why
    /// instead of panicking when the room isn't there.
    ///
    /// Only a bounded vector can refuse: the allocator panics on OOM, so
    /// `ReserveError.NoMemory` is not reachable from here.
    @grows
    public func try_reserve(mutate self, additional: usize) -> void or ReserveError {
        if self.remaining()? as room {
            if additional > room {
                return ReserveError.Full
            }
        }
        self.reserve(additional)
        return
    }

    /// Get element at index (borrows).
    @native("rask_vec_get_opt")
    @copies_elements
    public func get(self, index: i64) -> Option<T> {}

    /// Get the first element.
    @native("rask_vec_first")
    @copies_elements
    public func first(self) -> Option<T> {}

    /// Get the last element.
    @native("rask_vec_last")
    @copies_elements
    public func last(self) -> Option<T> {}

    /// Read element at index through a closure.
    @native
    public func read(self, index: i64, f: func(T) -> R) -> Option<R> {}

    /// Modify element at index through a closure.
    @native
    public func modify(mutate self, index: i64, f: func(mutate T) -> R) -> Option<R> {}

    /// Swap elements at two indices.
    @native("rask_vec_swap", panics: true)
    public func swap(mutate self, i: i64, j: i64) {}

    /// Mutate several elements in one call. `f` gets them in `indices` order,
    /// as a Vec it may change in place but not resize. `none` when an index is
    /// out of range; a repeated index panics (D1).
    ///
    /// The elements are moved out for the call and put back after, so `f`
    /// holds each one alone and no slot is reachable twice. Removing from the
    /// highest index down keeps the lower ones in place, and inserting from
    /// the lowest up puts each back where it was.
    public func modify_many<R>(mutate self, indices: Vec<i64>, f: func(mutate Vec<T>) -> R) -> R? {
        let n = self.len().wrap<i64>()
        let k = indices.len()
        mut i: usize = 0
        while i < k {
            let at = indices[i]
            if at < 0 || at >= n {
                return none
            }
            mut j = i + 1
            while j < k {
                if indices[j] == at {
                    panic("modify_many: index {at} appears twice")
                }
                j = j + 1
            }
            i = i + 1
        }

        mut labels = indices.clone()
        labels.sort_by(|a, b| b.compare(a))
        mut parts: Vec<T> = Vec.with_capacity(k)
        for at in labels {
            parts.push(self.remove(at))
        }
        reorder_parallel(mutate parts, mutate labels, indices)

        let result = f(mutate parts)
        if parts.len() != k {
            panic("modify_many: the callback resized its Vec from {k} to {parts.len()}")
        }

        mut ascending = indices.clone()
        ascending.sort()
        reorder_parallel(mutate parts, mutate labels, ascending)
        mut p: usize = 0
        for item in parts.take_all() {
            self.insert(ascending[p], item)
            p = p + 1
        }
        return result
    }

    /// Move every element out into a new Vec, leaving this one empty with
    /// its bound and its buffer (std.iteration/T1, T2).
    @native("rask_vec_take_all")
    @shrinks
    public func take_all(mutate self) -> Vec<T> {}

    /// Hand every element to `f`, front first, and free the vector. `f` owes
    /// what it's handed, so this is how a vector of resources is consumed
    /// whole, and what an `ensure` commits it with (mem.resources/RC1):
    /// `ensure files.consume(|take f| f.close())`. Every element is handed
    /// over even after one fails, since each is owed either way, and the
    /// first failure is the answer. A consumer that can't fail makes a call
    /// that can't either.
    public func consume<E>(take self, f: func(take T) -> void or E) -> void or E {
        self.reverse()
        mut failed: E? = none
        while self.pop()? as item {
            f(item) catch e => {
                if failed is none {
                    failed = e
                }
            }
        }
        if failed? as e {
            return e
        }
        return
    }

    /// A sequence over these elements — the chain head a collection stands for
    /// (SEQ48). Compiler-inserted where a Vec fills a `Sequence<T>` slot; not a
    /// spelling anyone writes, and not a second `.iter()`.
    public func as_sequence(self) -> Sequence<T> {
        return |yield| {
            mut i = 0
            while i < self.len() {
                if !yield(self[i]) {
                    return
                }
                i = i + 1
            }
        }
    }

    /// Remove elements where f returns true, return count removed. No `retain`
    /// — invert the predicate on this instead.
    ///
    /// One pass, in place: each survivor is swapped down to the next free slot,
    /// which keeps survivors in order and gathers the removed ones at the end,
    /// where `pop` releases each exactly once.
    @shrinks
    @drops_elements
    public func remove_where(mutate self, f: func(T) -> bool) -> usize {
        let n = self.len()
        mut kept: usize = 0
        mut i: usize = 0
        while i < n {
            if !f(self[i]) {
                if kept != i {
                    self.swap(kept.wrap<i64>(), i.wrap<i64>())
                }
                kept = kept + 1
            }
            i = i + 1
        }
        while self.len() > kept {
            self.pop()
        }
        return n - kept
    }

    /// Remove and return elements where f returns true, in the order they
    /// were in.
    ///
    /// One pass. Swapping in place would scramble the removed elements, so
    /// this splits the contents instead; `take_all` keeps this vector's
    /// buffer, so pushing the survivors back doesn't grow it.
    @shrinks
    public func take_where(mutate self, f: func(T) -> bool) -> Vec<T> {
        mut taken: Vec<T> = Vec.new()
        for item in self.take_all() {
            if f(item) {
                taken.push(item)
            } else {
                self.push(item)
            }
        }
        return taken
    }

    /// True if the vector contains the given value.
    @native("rask_vec_contains")
    public func contains(self, value: T) -> bool {}

    /// Reverse elements in place.
    @native("rask_vec_reverse")
    public func reverse(mutate self) {}

    /// Join elements into a string with a separator.
    @native("rask_vec_join")
    public func join(self, sep: string) -> string {}

    /// Sort using a custom comparator, which answers with an `Ordering`.
    /// An integer comparator isn't accepted — `|a, b| a - b` is a type error.
    @native("rask_vec_sort_by")
    public func sort_by(mutate self, f: func(T, T) -> Ordering) {}

    /// Sort by a key extracted from each element. Not stable, like `sort` —
    /// only `sort_by` promises that.
    @native
    public func sort_by_key<K: Comparable>(mutate self, f: func(T) -> K) {}

    /// Remove consecutive duplicate elements. Only runs of equal neighbors
    /// collapse — sort first for full dedup.
    @native("rask_vec_dedup")
    @shrinks
    @drops_elements
    public func remove_adjacent_duplicates(mutate self) {}

    /// Map then flatten results. Lazy (type.sequence/SEQ41).
    ///
    /// Written out rather than forwarded. `Sequence.flat_map` wants
    /// `func(T) -> Sequence<U>` and `f` gives a `Vec<U>`, so forwarding means
    /// `flat_map(|x| f(x).as_sequence())` — and that inner sequence has to
    /// outlive the closure call that made the Vec it reads. It segfaults
    /// (#1045). Changing `f`'s type instead would break every call site that
    /// hands back a Vec, which is all of them.
    public func flat_map(self, f: func(T) -> Vec<U>) -> Sequence<U> {
        return |yield| {
            mut i = 0
            while i < self.len() {
                let inner = f(self[i])
                mut j = 0
                while j < inner.len() {
                    if !yield(inner[j]) {
                        return
                    }
                    j = j + 1
                }
                i = i + 1
            }
        }
    }

    /// Reduce to a single value using an accumulator.
    @native
    public func fold(self, init: U, f: func(U, T) -> U) -> U {}

    /// Reduce without initial value. Returns none if empty.
    @native
    @copies_elements
    public func reduce(self, f: func(T, T) -> T) -> Option<T> {}

    /// Zip with another vector into pairs.
    ///
    /// Native has no lowering — see #886, and #887 for why a Rask body doesn't
    /// work yet: `U` is the method's own type parameter and nothing resolves it
    /// at the call site, so the pair's second slot gets the wrong width.
    @native
    @copies_elements
    public func zip(self, other: Vec<U>) -> Vec<(T, U)> {}

    /// Split into chunks of the given size.
    @native("rask_vec_chunks")
    @copies_elements
    public func chunks(self, size: usize) -> Vec<Vec<T>> {}

    /// True if any element satisfies the predicate.
    @native
    public func any(self, f: func(T) -> bool) -> bool {}

    /// True if all elements satisfy the predicate.
    @native
    public func all(self, f: func(T) -> bool) -> bool {}

    /// Find the first element matching the predicate.
    @native
    @copies_elements
    public func find(self, f: func(T) -> bool) -> Option<T> {}

    /// Find the index of the first element matching the predicate.
    @native
    public func position(self, f: func(T) -> bool) -> Option<usize> {}

    /// Sum all elements.
    @native
    @copies_elements
    public func sum(self) -> T {}

    /// Clone the vector.
    @native("rask_vec_clone")
    @copies_elements
    public func clone(self) -> Vec<T> {}

    /// Set element at index. Panics if out of bounds.
    @native("rask_vec_set", panics: true)
    @drops_elements
    public func set(mutate self, index: i64, take value: T) {}

    /// Give back allocation past `to` elements — or past the current length,
    /// when that is larger. Left out, `shrink()` is shrink-to-fit.
    ///
    /// A bounded vector keeps its allocation: CP3 pre-allocates at the bound,
    /// and shrinking one would make a later push reallocate past its promise.
    ///
    /// This was `shrink_to_fit()` beside `shrink_to(n)`, and the first was
    /// exactly the second with a zero — `std.api/SD5` says one operation gets
    /// one spelling, and `SD2` says the surface grows by parameter.
    @native("rask_vec_shrink_to")
    @shrinks
    public func shrink(mutate self, to: usize = 0) {}

    /// Raw pointer to the underlying buffer (unsafe).
    @native("rask_vec_as_ptr")
    public unsafe func as_ptr(self) -> *T {}

    /// Mutable raw pointer to the underlying buffer (unsafe). Same address
    /// `as_ptr` hands back — it's the `mutate self` receiver that makes writing
    /// through it legal, not a different buffer.
    @native("rask_vec_as_ptr")
    public unsafe func as_mut_ptr(mutate self) -> *T {}
}

// A copy out, for an element too wide to hand back by borrow. `get` lends the
// element for the expression; past the 16-byte threshold that isn't enough, and
// this is the spelling that says the copy out loud (`mem.ownership`).
//
// Its own block because a `where` clause covers the whole one (type.generics/CC3).
extend Vec<T> where T: Cloneable {
    /// Stage this data as a `Wide` plan (conc.data-parallel). The lanes are
    /// copied here, so a later change to the Vec doesn't reach the plan.
    public func wide(self) -> Wide<T> {
        let lanes = self.clone()
        return Wide(run: || { return lanes.clone() })
    }

    /// A clone of the element at `index`, or `none` when there isn't one.
    public func get_clone(self, index: i64) -> Option<T> {
        if index < 0 {
            return none
        }
        if index >= self.len() {
            return none
        }
        return self[index].clone()
    }
}

// Two vectors are equal when they hold equal elements in the same order, and
// hash from their elements the same way a derived struct hashes its fields
// (EQ1/HA1). Written here, element by element through `T`'s own `eq` and
// `hash`, so a map keyed by `Vec<Name>` and `==` on two of them agree on both
// backends.
extend Vec<T> where T: Equal {
    public func eq(self, other: Vec<T>) -> bool {
        if self.len() != other.len() {
            return false
        }
        mut i: usize = 0
        while i < self.len() {
            if self[i] != other[i] {
                return false
            }
            i = i + 1
        }
        return true
    }
}

// `sort`, `min` and `max` order by `T`'s own `compare` (SO3). An element with
// no order, like `i64?`, is a type error here rather than something each
// backend improvises: native used to compare the option's tag word and leave
// the payloads in push order (#1313).
extend Vec<T> where T: Comparable {
    /// Sort elements in ascending order.
    @native
    public func sort(mutate self) {}

    /// Minimum element. The first of several equal ones.
    ///
    /// Through `compare`, like `sort`. Both used to be native: the interpreter
    /// ordered field by field whatever `compare` said, and native compared a
    /// struct element's address and segfaulted (#1406).
    ///
    /// The loop keeps an index rather than the element: the elements are
    /// `self`'s, and the answer is handed out the way `get` hands one out.
    @copies_elements
    public func min(self) -> T? {
        let i = self.extreme_index(Ordering.Less)
        if i < 0 {
            return none
        }
        return self.get(i)
    }

    /// Maximum element. The first of several equal ones.
    @copies_elements
    public func max(self) -> T? {
        let i = self.extreme_index(Ordering.Greater)
        if i < 0 {
            return none
        }
        return self.get(i)
    }

    /// Index of the first element no other beats in direction `wins`, or -1
    /// when there are none.
    func extreme_index(self, wins: Ordering) -> i64 {
        if self.len() == 0 {
            return -1
        }
        mut best: usize = 0
        mut i: usize = 1
        while i < self.len() {
            if self[i].compare(self[best]) == wins {
                best = i
            }
            i = i + 1
        }
        return best.to<i64>()!
    }
}

extend Vec<T> where T: Hashable {
    public func hash(self) -> u64 {
        mut h: u64 = 14695981039346656037
        mut i: usize = 0
        while i < self.len() {
            h = (h ^ self[i].hash()).wrapping_mul(1099511628211)
            i = i + 1
        }
        return h
    }
}

// --- Growth errors ---

/// A growth operation refused a value. The value comes back inside the error,
/// so the caller can retry it, spill it, or log it instead of losing it.
///
/// One type covers `try_push`, `try_push_all` and `try_insert`: the reason a
/// collection wouldn't take a value doesn't depend on which collection it was,
/// so a function that grows any of them can still name its error.
public enum GrowError<T> {
    /// The collection is at its capacity bound.
    Full(T)
    /// The allocator couldn't provide the space.
    NoMemory(T)
}

extend GrowError<T> {
    public func message(self) -> string {
        match self {
            GrowError.Full(_) => return "collection is at its capacity bound"
            GrowError.NoMemory(_) => return "allocation failed"
        }
    }
}

/// `try_reserve` couldn't get the room. Nothing was rejected, so nothing comes
/// back — only the reason.
public enum ReserveError {
    /// The requested capacity is past the collection's bound.
    Full
    /// The allocator couldn't provide the space.
    NoMemory
}

extend ReserveError {
    public func message(self) -> string {
        match self {
            ReserveError.Full => return "requested capacity exceeds the collection's bound"
            ReserveError.NoMemory => return "allocation failed"
        }
    }
}

/// Swap `items` into `target`'s order, given that `labels[i]` names where
/// `items[i]` came from. Both are reordered together, so afterwards
/// `labels == target`. `modify_many`'s bookkeeping; quadratic, and called with
/// a handful of indices.
func reorder_parallel<T>(mutate items: Vec<T>, mutate labels: Vec<i64>, target: Vec<i64>) {
    mut i: usize = 0
    while i < target.len() {
        mut m = i
        while labels[m] != target[i] {
            m = m + 1
        }
        if m != i {
            items.swap(i.wrap<i64>(), m.wrap<i64>())
            labels.swap(i.wrap<i64>(), m.wrap<i64>())
        }
        i = i + 1
    }
}

/// A hash map from keys to values.
@handle(release: "rask_map_free")
public struct Map<K, V> { }

extend Map<K, V> {
    /// Create a new empty map.
    @native("rask_map_new")
    public func new() -> Map<K, V> {}

    /// A map holding each `(key, value)` pair. A key that appears twice
    /// keeps the later value. Lowered by the compiler, like `Vec.from`.
    @builtin
    public func from<comptime N: usize>(pairs: [(K, V); N]) -> Map<K, V> {}

    /// Create a map with pre-allocated capacity.
    @native("rask_map_new_cap")
    public func with_capacity(n: usize) -> Map<K, V> {}

    /// Number of entries.
    @native("rask_map_len")
    public func len(self) -> usize {}

    /// True if the map contains no entries.
    @native("rask_map_is_empty")
    public func is_empty(self) -> bool {}

    /// Insert a key-value pair. Returns the old value if the key existed. Panics on alloc failure.
    @native("rask_map_insert_displaced")
    @grows
    public func insert(mutate self, take key: K, take value: V) -> Option<V> {}

    /// Remove a key and return its value.
    @native("rask_map_take")
    @shrinks
    public func remove(mutate self, key: K) -> Option<V> {}

    /// Remove all entries.
    @native("rask_map_clear")
    @shrinks
    @drops_elements
    public func clear(mutate self) {}

    /// Clone the map.
    @native("rask_map_clone")
    @copies_elements
    public func clone(self) -> Map<K, V> {}

    /// Get value for key (borrows).
    @native("rask_map_get")
    @copies_elements
    public func get(self, key: K) -> Option<V> {}

    /// True if the map contains this key.
    ///
    /// Not `contains_key`. Rust needs that because a Rust map's `contains` would
    /// have to say which half it means; in Rask every single-argument method on
    /// `Map` takes a key — `get`, `remove`, `read`, `modify` — so one more that
    /// does is no ambiguity at all. Asking about a value is
    /// `m.any(|e| e.1 == v)`, which doesn't compete for the name. `Vec`, `Set`,
    /// `string`, `Rack` and `Pool` all spell membership `contains`, and the
    /// runtime symbol behind this has been `rask_map_contains` the whole time.
    @native("rask_map_contains")
    public func contains(self, key: K) -> bool {}

    /// Read value for key through a closure.
    @native
    public func read(self, key: K, f: func(V) -> R) -> Option<R> {}

    /// Modify value for key through a closure.
    @native
    public func modify(mutate self, key: K, f: func(mutate V) -> R) -> Option<R> {}

    /// Insert default if key absent, no-op if present. Panics on alloc failure.
    /// Named for what it does — `ensure` is the cleanup keyword.
    ///
    /// Written in Rask over `contains` and `insert`: it's a condition around
    /// two primitives, and native had no lowering for it at all —
    /// `Map_insert_if_missing` reached codegen as a function nothing emits, while
    /// the interpreter's own copy ran (#886). One source, so the two can't
    /// disagree about it.
    @grows
    public func insert_if_missing(mutate self, take key: K, f: func() -> V) -> void {
        if self.contains(key) {
            return
        }
        self.insert(key, f())
        return
    }

    /// Insert default if key absent, then modify the value. One hash lookup.
    /// Panics on alloc failure.
    @native
    @grows
    public func modify_with_default(mutate self, key: K, default: func() -> V, f: func(mutate V) -> R) -> R {}

    /// The chain head: each entry as a `(key, value)` pair (type.sequence/SEQ49).
    ///
    /// Every other sequence method on `Map` is generated from this one.
    public func as_sequence(self) -> Sequence<(K, V)> {
        return |yield| {
            for entry in self {
                if !yield(entry) {
                    return
                }
            }
        }
    }

    /// Move every entry out as `(key, value)` pairs, leaving the map empty
    /// (std.iteration/T1, T2). The order is the map's, which is unspecified.
    @native("rask_map_take_all")
    @shrinks
    public func take_all(mutate self) -> Vec<(K, V)> {}

    /// Hand every entry to `f` and free the map, the way `Vec.consume` does:
    /// how a map holding resources is consumed (mem.resources/RC3).
    public func consume<E>(take self, f: func(take K, take V) -> void or E) -> void or E {
        mut entries = self.take_all()
        mut failed: E? = none
        while entries.pop()? as entry {
            let (key, value) = entry
            f(key, value) catch e => {
                if failed is none {
                    failed = e
                }
            }
        }
        if failed? as e {
            return e
        }
        return
    }

    /// Iterate over keys.
    @native("rask_map_keys")
    public func keys(self) -> Iterator<K> {}

    /// Iterate over values.
    @native("rask_map_values")
    @copies_elements
    public func values(self) -> Iterator<V> {}
}

// Two maps are equal when they hold the same keys with equal values (EQ4a).
// Insertion order doesn't count: a map has none to promise. The keys are
// already Equal, since a map finds them by `eq` (HA3c).
extend Map<K, V> where V: Equal {
    public func eq(self, other: Map<K, V>) -> bool {
        if self.len() != other.len() {
            return false
        }
        for (key, value) in self {
            if other.get(key)? as theirs {
                if theirs != value {
                    return false
                }
            } else {
                return false
            }
        }
        return true
    }
}

// The copying read, for the same reason `Vec.get_clone` exists: `get` lends the
// value for the expression, and past the 16-byte threshold that isn't enough.
extend Map<K, V> where V: Cloneable {
    /// A clone of the value under `key`, or `none` when the key is absent.
    public func get_clone(self, key: K) -> Option<V> {
        if self.get(key)? as v {
            return v.clone()
        }
        return none
    }
}

/// A staged data-parallel plan over lanes of `T` (conc.data-parallel).
///
/// Built from `some_vec.wide()`. Staging is lazy (C1): `map` and `zip_with`
/// return a new plan and run nothing. A terminal — `to_vec`, `sum`, `reduce`,
/// `min`, `max` — runs the plan on the CPU, the baseline every plan has (W2),
/// and runs all of it again if it is asked again.
///
/// Written in Rask, so both backends run this one copy. The interpreter used to
/// have a plan tree of its own in Rust and native had `sum` alone, adding up
/// every lane's bits as an `i64` whatever the lanes were (#1287).
public struct Wide<T> {
    /// The staged work: calling it builds the lanes.
    run: func() -> Vec<T>
}

// The receiver has to say its element is itself a Vec, which the block header
// is the only place to write.
extend Vec<Vec<T>> {
    /// Flatten one level. Lazy (type.sequence/SEQ41).
    ///
    /// Written out for the same reason `flat_map` is: forwarding would wrap each
    /// inner Vec in a sequence that has to outlive the read that produced it
    /// (#1045).
    public func flatten(self) -> Sequence<T> {
        return |yield| {
            mut i = 0
            while i < self.len() {
                mut j = 0
                while j < self[i].len() {
                    if !yield(self[i][j]) {
                        return
                    }
                    j = j + 1
                }
                i = i + 1
            }
        }
    }
}

extend Wide<T> {
    /// Transform each lane. Lazy — records `f`, runs nothing.
    public func map(self, f: func(T) -> U) -> Wide<U> {
        let src = self.run
        return Wide(run: || {
            mut out: Vec<U> = Vec.new()
            for x in src() {
                out.push(f(x))
            }
            return out
        })
    }

    /// Combine two plans lane by lane. Lazy. The lane counts have to match
    /// when the plan runs.
    public func zip_with(self, other: Wide<U>, f: func(T, U) -> V) -> Wide<V> {
        let a = self.run
        let b = other.run
        return Wide(run: || {
            let xs = a()
            let ys = b()
            if xs.len() != ys.len() {
                panic("zip_with: lane counts differ ({xs.len()} vs {ys.len()})")
            }
            mut out: Vec<V> = Vec.new()
            mut i = 0
            while i < xs.len() {
                out.push(f(xs[i], ys[i]))
                i = i + 1
            }
            return out
        })
    }

    /// Run the plan and hand back its lanes.
    public func to_vec(self) -> Vec<T> {
        let run = self.run
        return run()
    }

    /// Run the plan, adding the lanes up.
    public func sum(self) -> T {
        return self.to_vec().sum()
    }

    /// Run the plan, folding the lanes from `init`.
    public func reduce(self, take init: U, f: func(U, T) -> U) -> U {
        mut acc = init
        for x in self.to_vec() {
            acc = f(acc, x)
        }
        return acc
    }
}

extend Wide<T> where T: Comparable {
    /// Run the plan, returning the smallest lane. Panics on an empty plan.
    public func min(self) -> T {
        return self.to_vec().min()!
    }

    /// Run the plan, returning the largest lane. Panics on an empty plan.
    public func max(self) -> T {
        return self.to_vec().max()!
    }
}

/// A set of unique values.
///
/// `Set` has been in BI1's always-available list since the start, and resolved
/// as a builtin, with no declaration anywhere — so `Set.new()` type-checked and
/// then `s.insert(x)` was "no method `insert` found" three lines later, with
/// the error pointing at the call rather than at the type (#1017).
///
/// It's a `Map<T, bool>` underneath, written in Rask so both backends run the
/// same source. That costs a byte per entry over a purpose-built hash set, and
/// buys a set that behaves exactly like the map it's made of — same hashing,
/// same growth, same iteration order. (`Map<T, void>` would be the tighter
/// shape and isn't available: `void` is a type, not a value, so there'd be
/// nothing to pass to `insert`.)
///
/// The membership test is `contains`, the same word `Vec`, `string` and `Map`
/// use.
public struct Set<T> {
    entries: Map<T, bool>
}

extend Set<T> {
    /// Create a new empty set.
    public func new() -> Set<T> {
        return Set(entries: Map.new())
    }

    /// Number of values.
    public func len(self) -> usize {
        return self.entries.len()
    }

    /// True if the set contains no values.
    public func is_empty(self) -> bool {
        return self.entries.is_empty()
    }

    /// Add a value. True if it wasn't already there.
    @grows
    public func insert(mutate self, take value: T) -> bool {
        if self.entries.contains(value) {
            return false
        }
        self.entries.insert(value, true)
        return true
    }

    /// True if the value is in the set.
    public func contains(self, value: T) -> bool {
        return self.entries.contains(value)
    }

    /// Remove a value. True if it was there.
    @shrinks
    public func remove(mutate self, value: T) -> bool {
        if !self.entries.contains(value) {
            return false
        }
        self.entries.remove(value)
        return true
    }

    /// Remove all values.
    @shrinks
    public func clear(mutate self) -> void {
        self.entries.clear()
    }

    /// The chain head (type.sequence/SEQ49). Every other sequence method on
    /// `Set` is generated from this one.
    public func as_sequence(self) -> Sequence<T> {
        return |yield| {
            for (value, _) in self.entries {
                if !yield(value) {
                    return
                }
            }
        }
    }

    /// The values, as a `Vec`.
    ///
    /// Named for what it builds, not for what you do with it (SEQ31).
    public func to_vec(self) -> Vec<T> {
        return self.entries.keys().to_vec()
    }

    /// Clone the set.
    public func clone(self) -> Set<T> {
        return Set(entries: self.entries.clone())
    }
}

// Two sets are equal when they hold the same values, in any order (EQ4a).
extend Set<T> where T: Equal {
    public func eq(self, other: Set<T>) -> bool {
        return self.entries == other.entries
    }
}
