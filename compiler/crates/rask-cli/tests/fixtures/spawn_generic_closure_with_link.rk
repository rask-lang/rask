// A closure written in a generic function, returned and then spawned. The
// capture has type `T`, so whether the closure may cross to another task
// depends on what `T` is. The `i64` copy crosses; the link copy is refused.
import memory.{Rack, Link}

struct Node {
    id: i64
}

func keep<T>(x: T) -> func() -> i64 {
    return || {
        let y = x
        return 1
    }
}

func main() {
    using Multitasking {
        mut rack: Rack<Node> = Rack.new()
        let a = rack.insert(Node { id: 1 })
        let plain = keep(7)
        println("{spawn(plain).join()!}")
        let f = keep(a)
        println("before")
        println("{spawn(f).join()!}")
    }
}
