// #270: scalar `mutate` params write back through the caller's place — for a
// field or index projection and for a whole variable alike (#899). Native and
// interp agree; native passes a pointer to the variable itself, which is why
// the last line changed from 42 to 999.
struct Point { x: i32, y: i32 }

func swap_fields(mutate x: i32, mutate y: i32) {
    let tmp = x
    x = y
    y = tmp
}

func boost(mutate n: i32) {
    n += 10
}

func modify_int(mutate n: i32) {
    n = 999
}

func main() {
    mut p = Point { x: 1, y: 2 }
    swap_fields(mutate p.x, mutate p.y)
    print(p.x)   // 2
    print(p.y)   // 1
    boost(mutate p.x)
    print(p.x)   // 12
    mut z = 42
    modify_int(mutate z)
    print(z)     // 999 — a whole variable writes back like any other place
}
