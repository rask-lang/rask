// #270: scalar `mutate` params write back through the caller's place for
// field/index projections, but a whole Copy variable stays unchanged. Native
// and interp agree (native scalar mutate is now a by-pointer convention).
struct Point { x: i32, y: i32 }

func swap_fields(mutate x: i32, mutate y: i32) {
    const tmp = x
    x = y
    y = tmp
}

func boost(mutate n: i32) {
    n += 10
}

func modify_int(mutate n: i32) {
    n = 999
}

func main() {
    mut p = Point { x: 1, y: 2 }
    swap_fields(mutate p.x, mutate p.y)
    print(p.x)   // 2
    print(p.y)   // 1
    boost(mutate p.x)
    print(p.x)   // 12
    mut z = 42
    modify_int(z)
    print(z)     // 42 — whole Copy variable, write-back discarded
}
