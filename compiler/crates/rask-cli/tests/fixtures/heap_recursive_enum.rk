// A recursive type built with `Heap<T>`, which is what the box is for.
//
// Allocation used to do nothing here. Layout gives a `Heap<T>` slot 8 bytes, so storing a
// 16-byte enum into an enum payload declared `Heap<Tree>` wrote across the next
// payload, and reading it back gave the first child's *tag* used as an address —
// SIGSEGV on the first recursion (#705).
//
// Three levels deep on purpose: a boxed payload has to be able to hold another
// boxed payload. `Wrap` covers the struct-field form of the same boundary.
import memory.Heap

enum Tree {
    Leaf(f64),
    Node(left: Heap<Tree>, right: Heap<Tree>),
}

func total(t: Tree) -> f64 {
    match t {
        Leaf(v) => return v,
        Node(l, r) => {
            let a = total(l)
            let b = total(r)
            return a + b
        }
    }
}

func depth(t: Tree) -> i64 {
    match t {
        Leaf(_v) => return 1,
        Node(l, r) => {
            let a = depth(l)
            let b = depth(r)
            if a > b {
                return a + 1
            }
            return b + 1
        }
    }
}

struct Wrap {
    public inner: Heap<Tree>
}

func main() {
    // Three levels, so a boxed payload holds another boxed payload.
    let l1 = Tree.Leaf(1.0)
    let l2 = Tree.Leaf(2.0)
    let l3 = Tree.Leaf(4.0)
    let l4 = Tree.Leaf(8.0)
    let n1 = Tree.Node(left: Heap(l1), right: Heap(l2))
    let n2 = Tree.Node(left: Heap(l3), right: Heap(l4))
    let root = Tree.Node(left: Heap(n1), right: Heap(n2))
    println("total={total(root)} (expect 15)")
    println("depth={depth(root)} (expect 3)")

    // A struct field declared Heap<T>, not just an enum payload.
    let w = Wrap { inner: Heap(Tree.Leaf(5.0)) }
    println("wrapped={total(w.inner)} (expect 5)")
}
