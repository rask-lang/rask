// join() reports both what the task produced and how it ended.

func main() {
    let ok = Thread.spawn(|| {
        return 42
    })
    match ok.join() {
        i64 as v => println("value {v}"),
        JoinError.Panicked(m) => println("panicked {m}"),
        JoinError.Cancelled => println("cancelled"),
    }

    // A value that used to be indistinguishable from the panic sentinel.
    let neg = Thread.spawn(|| {
        return -1
    })
    match neg.join() {
        i64 as v => println("value {v}"),
        JoinError.Panicked(m) => println("panicked {m}"),
        JoinError.Cancelled => println("cancelled"),
    }

    let boom = Thread.spawn(|| {
        panic("boom")
        return 0
    })
    match boom.join() {
        i64 as v => println("value {v}"),
        JoinError.Panicked(m) => println("panicked {m}"),
        JoinError.Cancelled => println("cancelled"),
    }

    println("still alive")
}
