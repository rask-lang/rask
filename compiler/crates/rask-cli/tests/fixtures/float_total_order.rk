// type.operators/ORD3: floats are Comparable, `compare()` is the IEEE total
// order, and the comparison operators stay IEEE.
//
// The default sort compared elements as int64_t whatever the Vec held. Positive
// floats happen to order correctly that way, so this was silent until a negative
// one showed up: -1.5 sorted before -2.5.
func main() {
    mut v = Vec.new()
    v.push(0.0 - 1.5)
    v.push(0.0 - 2.5)
    v.push(3.0)
    v.push(0.0)
    v.sort()
    println("sorted {v[0]} {v[1]} {v[2]} {v[3]}")

    let nan = 0.0 / 0.0
    let one = 1.0
    println("nan<1 {nan < one}")
    println("nan>1 {nan > one}")
    println("nan==nan {nan == nan}")

    mut w = Vec.new()
    w.push(3.0)
    w.push(1.0)
    w.push(2.0)
    w.sort()
    println("plain {w[0]} {w[1]} {w[2]}")
}
