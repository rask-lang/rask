// #399: native `==`/`!=` on enums and structs must compare contents, not the
// address of the operands' stack slots. Every line here must print the same on
// the native and interpreter backends.

enum Color { Red, Green, Blue }
enum Msg { Move(i32), Stop }
struct User { name: string, id: i32 }

func main() {
    // Unit-variant enums: compare by tag.
    let c = Color.Green
    println((c == Color.Green).display())   // true
    println((c == Color.Red).display())     // false
    println((c != Color.Red).display())     // true

    // Enum carrying a payload: tag then payload fields.
    let m = Msg.Move(5)
    println((m == Msg.Move(5)).display())   // true
    println((m == Msg.Move(6)).display())   // false
    println((m == Msg.Stop).display())      // false
    println((m != Msg.Move(6)).display())   // true

    // Struct with a string field: string compares by content.
    let u = User(name: "ada", id: 1)
    println((u == User(name: "ada", id: 1)).display())   // true
    println((u == User(name: "bob", id: 1)).display())   // false
    println((u == User(name: "ada", id: 2)).display())   // false
    println((u != User(name: "bob", id: 1)).display())   // true

    // `if x == Enum.Variant { .. }` takes the right branch natively.
    if (c == Color.Green) {
        println("branch-green")
    } else {
        println("branch-other")
    }
}
