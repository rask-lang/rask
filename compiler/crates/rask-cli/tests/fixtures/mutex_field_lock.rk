// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Regression test: `with self.index.write() as idx { ... }` on a Mutex field
// used to be lowered as a plain method call, handing a closure-taking
// runtime entry point one argument and failing Cranelift verification. It
// has to take the lock around the block instead.
import sync.Shared
import sync.Mutex

struct Counter {
    value: Shared<i64, Mutex>
}

extend Counter {
    func snapshot(self) -> i64 {
        with self.value.write() as v {
            return v
        }
    }
}

func main() {
    let c = Counter { value: Shared.mutex(42) }
    println(c.snapshot().to_string())
}
