// GA2's other half: `{ index: i32, generation: i32 }` is eight bytes, which is
// one machine word, so it fits an atomic. This is the example mem.atomics' own
// text uses and it was a compile error — the rule counted fields times eight
// instead of reading the width (#1083).
import sync.Atomic
import sync.Ordering

struct Slot {
    index: i32
    generation: i32
}

func main() {
    let a = Atomic.new(Slot { index: 1, generation: 2 })
    let s = a.load(SeqCst)
    println("{s.index} {s.generation}")
    a.store(Slot { index: 7, generation: 9 }, SeqCst)
    let t = a.load(SeqCst)
    println("{t.index} {t.generation}")
}
