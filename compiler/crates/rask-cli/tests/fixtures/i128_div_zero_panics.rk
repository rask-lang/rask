// OV2 at 128 bits. Division has no Cranelift lowering at that width, so the
// divisor check lives in the runtime helper and comes back as a status the
// caller branches on — the panic still carries the Rask span (#762).

func zero() -> i128 {
    return 0
}

func main() {
    let a: i128 = 5
    println("before")
    let q = a / zero()
    println("unreachable {q}")
}
