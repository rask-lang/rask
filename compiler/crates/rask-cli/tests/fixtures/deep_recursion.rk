// SPDX-License-Identifier: (MIT OR Apache-2.0)
// The interpreter used to die at ~245 nested calls by overflowing the host stack:
// SIGABRT, nothing printed, no exit code (#759). Native handles depths in the
// millions, so a program that ran compiled vanished interpreted — and the
// interpreter is meant to be the reference.
//
// It no longer stops at the end of a stack: a call that doesn't fit continues on
// a thread with a fresh one, and the frame that couldn't fit waits in `join`.
// Nothing the program can observe changes. The chain is capped by memory rather
// than by depth — about a gigabyte of live stack, ~30,000 Rask frames in release
// — so runaway recursion is still a diagnostic (see runaway_recursion.rk).
//
// 1,000 is deliberately past the old cliff and inside what a debug build reaches
// too: a debug frame costs ~17× an optimized one, so the two profiles reach very
// different depths on the same budget, and a fixture that only fits in release
// would fail in a debug CI job.

func down(n: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    return 1 + down(n - 1)
}

// Mutual recursion counts the same frames.
func even(n: i64) -> bool {
    if n == 0 {
        return true
    }
    return odd(n - 1)
}

func odd(n: i64) -> bool {
    if n == 0 {
        return false
    }
    return even(n - 1)
}

// A recursive descent that builds a value on the way back up — the return path
// crosses every stack the call chain grew through.
func sum_to(n: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    return n + sum_to(n - 1)
}

func main() {
    println("down={down(1000)}")
    println("even={even(1000)} odd={odd(1001)}")
    println("sum={sum_to(1000)}")
}
