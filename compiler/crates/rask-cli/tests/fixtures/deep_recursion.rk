// SPDX-License-Identifier: (MIT OR Apache-2.0)
// The interpreter used to die at ~245 nested calls by overflowing the host stack:
// SIGABRT, nothing printed, no exit code (#759). Native handles depths in the
// millions, so a program that ran compiled vanished interpreted — and the
// interpreter is meant to be the reference.
//
// Two things changed. `main` and the test runner now run on the same 16 MiB stack
// every spawned task already got, so the depth doesn't depend on which entry
// point ran the code (~245 → ~495). And running out is now measured and reported
// rather than left to overflow.
//
// Measured, not counted: one Rask frame costs anywhere from a few KB to tens of
// KB depending on how deeply nested the expressions in the body are, so a fixed
// depth limit is either wrong for a heavy body or needlessly low for a light one.
// This file stays well under either.

func down(n: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    return 1 + down(n - 1)
}

// Mutual recursion counts the same frames.
func even(n: i64) -> bool {
    if n == 0 {
        return true
    }
    return odd(n - 1)
}

func odd(n: i64) -> bool {
    if n == 0 {
        return false
    }
    return even(n - 1)
}

// A recursive descent that builds a value on the way back up.
func sum_to(n: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    return n + sum_to(n - 1)
}

func main() {
    println("down={down(300)}")
    println("even={even(300)} odd={odd(301)}")
    println("sum={sum_to(300)}")
}
