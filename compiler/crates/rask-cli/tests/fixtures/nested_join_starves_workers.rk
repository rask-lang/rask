//
// A task that joins another task, with one worker to run both (#1130).
//
// A worker that calls `join` blocks on the target's condvar and stops taking
// work, so with one worker the inner task never got picked up and the program
// hung — no output, no exit, deterministically. Raising the worker count above
// the join depth was the only way to run it.
//
// A blocked worker isn't running anything, so the scope starts a replacement
// for the duration and this prints `got 7` on one worker. Four levels deep on
// one worker works the same way; past `JOIN_HELPER_SLOTS` levels the deadlock
// report is still what you get.

func main() {
    using Multitasking(workers: 1) {
        let outer = spawn(|| {
            let inner = spawn(|| {
                return 7
            })
            let v = inner.join() catch e => {
                return 0
            }
            return v
        })
        let r = outer.join() catch e => {
            println("outer failed")
            return
        }
        println("got {r}")
    }
    return
}
