// A test that panics inside `using ThreadPool` skips the block's end. The next
// test has to find the pool closed: natively it found the first test's pool
// still open, so a pool spawn the checker couldn't see ran instead of panicking.
import thread.ThreadPool

func job() -> i64 {
    return ThreadPool.spawn { return 5 }.join()!
}

test "panics inside the pool block" {
    using ThreadPool(workers: 2) {
        assert job() == 5
        panic("boom")
    }
}

test "outside any block, a stored call panics" {
    let f: func() -> i64 = job
    let v = f()
    println("got {v} without a pool")
}

test "a fresh block works" {
    using ThreadPool(workers: 3) {
        assert job() == 5
    }
}
