func big_rec(n: i64) -> i64 {
    mut a: [i64; 4096] = [0; 4096]
    a[n % 4096] = n
    if n == 0 {
        return a[0]
    }
    return big_rec(n - 1) + a[n % 4096]
}

func huge() -> i64 {
    mut a: [i64; 2000000] = [0; 2000000]
    a[5] = 7
    return a[5]
}

func main() {
    println("{big_rec(100)}")
    println("{huge()}")
}
