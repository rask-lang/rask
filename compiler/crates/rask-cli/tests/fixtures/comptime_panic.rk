// CT46: a comptime block that panics is a compile error. There is no second
// chance — running the same block at startup reaches the same panic.
const D: i64 = comptime {
    mut n = 0
    for i in 0..10 {
        if i == 7 { panic("seven is not allowed") }
        n = n + i
    }
    n
}

func main() { println(D.to_string()) }
