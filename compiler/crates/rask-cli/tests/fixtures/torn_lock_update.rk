// SPDX-License-Identifier: (MIT OR Apache-2.0)
// tool.warnings/W9 (W0907): two fields of a locked value written in one `with`
// block without staging. `transfer` warns; the rest are the exclusions —
// `@allow` says the tear is harmless, `Local` has nobody to observe one (and
// `staged()` is an error there per ST3a), and staging is the fix itself. The
// `@allow` goes on a `test` block too (#1010), which is where a warning most
// often fires on purpose.

import sync.Shared
import sync.Mutex
import sync.Local

struct Ledger9 { checking: i64, savings: i64 }
const BOOKS: Shared<Ledger9, Mutex> = Shared.mutex(Ledger9 { checking: 100, savings: 0 })
const SOLO: Shared<Ledger9, Local> = Shared.local(Ledger9 { checking: 100, savings: 0 })

func transfer(amount: i64) {
    with BOOKS.write() as b {
        b.checking = b.checking - amount
        b.savings = b.savings + amount
    }
}

@allow(torn_lock_update)
func transfer_allowed(amount: i64) {
    with BOOKS.write() as b {
        b.checking = b.checking - amount
        b.savings = b.savings + amount
    }
}

func transfer_local(amount: i64) {
    with SOLO.write() as s {
        s.checking = s.checking - amount
        s.savings = s.savings + amount
    }
}

func transfer_staged(amount: i64) {
    with BOOKS.staged() as b {
        b.checking = b.checking - amount
        b.savings = b.savings + amount
    }
}

@allow(torn_lock_update)
test "a test block can say the tear is harmless" {
    with BOOKS.write() as b {
        b.checking = b.checking - 1
        b.savings = b.savings + 1
    }
}

func main() {
    transfer(1)
    transfer_allowed(1)
    transfer_local(1)
    transfer_staged(1)
    println("done")
}
