// Delete cost follows in-degree, not store size.
//
// One node with in-degree 1 in a store of 500. If the fixup found incoming
// edges by scanning the store it would visit 499 nodes; following backlinks it
// visits one:
//
//     $ RASK_STORE_STATS=1 rask run --interp sparse_delete_links.rk
//     store stats: deletes=1 edges_fixed=1 holders_visited=1
//
// This is the companion to fanin_links.rk, where in-degree happens to equal
// store size and so can't tell the two costs apart.

const FILLER: i32 = 498

struct Node {
    id: i32
    peer: Link<Node>?
}

func main() {
    mut store: Store<Node> = Store.new()

    let victim = store.insert(Node { id: -1, peer: none })
    let pointer = store.insert(Node { id: -2, peer: none })
    pointer.peer = victim

    mut i = 0
    while i < FILLER {
        let _n = store.insert(Node { id: i, peer: none })
        i += 1
    }

    println("nodes = {store.len()}, victim in-degree = 1")

    store.delete(victim)

    println("after delete, nodes = {store.len()}")

    if pointer.peer? as _p {
        println("the one incoming edge survived -- WRONG")
    } else {
        println("the one incoming edge was nulled")
    }
}
