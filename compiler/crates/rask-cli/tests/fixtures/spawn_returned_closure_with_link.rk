// A closure that captured a link, returned from a function and called in a
// task block (#1356). The block only names the closure, so the checker can't
// see what it captured; the closure carries that itself, and spawn refuses it.
import memory.{Rack, Link}

struct Node {
    id: i64
}

func reader(a: Link<Node>) -> func() -> i64 {
    return || { return a.id }
}

func main() {
    using Multitasking {
        mut rack: Rack<Node> = Rack.new()
        let a = rack.insert(Node { id: 1 })
        let f = reader(a)
        println("before")
        let t1 = spawn { f() }
        println("{t1.join()!}")
    }
}
