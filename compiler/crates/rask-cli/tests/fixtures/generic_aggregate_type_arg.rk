// The half of #781 that's still an error.
//
// A generic type whose type argument is an inline aggregate gets a layout of its
// own now — `tests/suite/t_generic_aggregate_arg.rk` covers what works.
//
// Not when the type has methods. `extend One<A>` compiles to *one* `One_get`
// body, whose `self` is the shared layout, and mono doesn't monomorphize a method
// per receiver instantiation the way it does a generic function. Widen the layout
// and the caller passes 24 bytes to a body reading 8, which is a segfault rather
// than an error — so such a type keeps the shared layout and the aggregate
// argument is refused at the field whose two sizes disagree.
//
// `rask check` doesn't run MIR lowering, so this is caught at compile/run.

struct One<A> {
    public only: A
}

extend One<A> {
    func get(self) -> A {
        return self.only
    }
}

struct Big {
    public a: i64
    public b: i64
    public c: i64
}

func main() {
    // A scalar argument fits the placeholder slot, so this half is fine.
    let n = One { only: 5 }
    println("{n.get()}")

    // ERROR: a 24-byte Big doesn't fit, and the shared method body can't widen.
    let b = One { only: Big { a: 1, b: 2, c: 3 } }
    println("{b.get().a}")
}
