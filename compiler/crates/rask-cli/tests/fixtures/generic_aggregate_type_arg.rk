// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A generic type with methods, instantiated with an inline aggregate (#781, #814).
//
// `extend One<A>` used to compile to *one* `One_get` body, whose `self` had the
// shared layout: a word-sized placeholder per type parameter. A 24-byte `Big`
// doesn't fit that, so widening the layout meant the caller passed 24 bytes to a
// body reading 8 — and the aggregate argument was refused outright instead.
//
// Mono monomorphizes such a method per receiver instantiation now, the way it
// already did a generic function, so `One<i64>.get()` and `One<Big>.get()` are two
// bodies with two layouts.
//
// `rask check` doesn't run MIR lowering, so this only ever showed up at run time.

struct One<A> {
    public only: A
}

extend One<A> {
    func get(self) -> A {
        return self.only
    }
}

struct Big {
    public a: i64
    public b: i64
    public c: i64
}

func main() {
    // A scalar argument fits the placeholder slot.
    let n = One { only: 5 }
    println("{n.get()}")

    // A 24-byte Big needs a layout of its own, and a body that agrees with it.
    let b = One { only: Big { a: 1, b: 2, c: 3 } }
    println("{b.get().a}")
}
