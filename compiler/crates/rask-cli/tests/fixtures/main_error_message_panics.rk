// An error out of main whose `message()` panics is a panic, exit 101, on both
// backends. The interpreter swallowed the panic and printed the error's debug
// form with exit 1 (#2096).

struct Msg {
    text: string
}

extend Msg {
    func message(self) -> string {
        if self.text == "zero" {
            panic("message blew up")
        }
        return "msg: {self.text}"
    }
}

func f(n: i64) -> i64 or Msg {
    if n == 0 {
        return Msg(text: "zero")
    }
    return n
}

func main() -> void or Msg {
    let b = try f(0)
    println("unreachable {b}")
}
