// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `reflect.fields<T>()` inside a generic function needs to know what `T` became
// at the call. Native monomorphizes, so `T` is already `Point` by the time MIR
// unrolls the loop. The interpreter doesn't, so the name reached reflect as the
// literal "T" and it answered "not a struct type" (#699). It records what each
// call bound its type parameters to now, read off the arguments.
//
// PC1 matters here: `value: T` declares a type parameter without writing `<T>`,
// so a binding pass that only reads the explicit list finds nothing.
import std.reflect

struct Point { public x: f64, public y: f64 }

struct Label { public text: string }

func print_fields(value: T) {
    comptime for field in reflect.fields<T>() {
        print("{field.name} ")
    }
    print("\n")
}

func main() {
    print_fields(Point { x: 1.0, y: 2.0 })
    print_fields(Label { text: "hi" })

    // The two calls above are also the leak check: a frame that outlived its
    // call would make the second one print Point's fields again.

    // Directly, with no generic wrapper — the path that always worked.
    comptime for field in reflect.fields<Point>() {
        print("direct:{field.name} ")
    }
    print("\n")
}
