// Wide<T> data-parallel algebra on the CPU (conc.data-parallel).
func main() {
    let xs = Vec.from([1.0, 2.0, 3.0, 4.0]).wide()

    // terminal: sum over lanes
    print("{xs.sum()}\n")                              // 10

    // lazy map, then terminal sum
    print("{xs.map(|x| x * 2.0).sum()}\n")             // 20

    // zip two plans lane-by-lane, then sum (dot product)
    let ys = Vec.from([10.0, 20.0, 30.0, 40.0]).wide()
    print("{xs.zip_with(ys, |a, b| a * b).sum()}\n")   // 300

    // lazy map, then read back to a Vec
    print("{xs.map(|x| x * 2.0).read().join(\", \")}\n") // 2, 4, 6, 8

    // reduction family
    print("{xs.min()}\n")                              // 1
    print("{xs.max()}\n")                              // 4
    print("{xs.reduce(1.0, |a, x| a * x)}\n")          // 24
}
