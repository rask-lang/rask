// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A struct out of a C header: built, read, handed to C by value, and handed
// back.
//
// The type resolved in a signature and nothing else — no way to construct one,
// no fields to read, and `c.Nonexistent` type-checked just as happily, so a
// C API taking a struct by value was unreachable (#948).
//
// Passing one is not passing a pointer. System V cuts a struct of sixteen bytes
// or less into eight-byte pieces and puts each in an SSE register if everything
// in it is a float and an integer register otherwise; anything larger is copied
// onto the stack. One case per class here, each combining its fields so a
// misclassification is a wrong number rather than a crash.

import c "c_struct.h"

// C calling Rask. A C caller passes and expects structs by C's rules, so these
// are entered through a thunk that follows them (SR2).
extern "C" func area_of(r: c.Rect) -> c_int {
    return r.width * r.height
}

extern "C" func vec2_of(v: c.Vec2) -> f32 {
    return v.x + v.y
}

extern "C" func stamp_of(s: c.Stamp) -> f64 {
    return s.t + s.id.round<f64>()
}

extern "C" func triple_of(t: c.Triple) -> c_long {
    return t.a + t.b * 10 + t.c * 100
}

extern "C" func seg_of(s: c.Seg) -> f32 {
    return s.a.x + s.a.y * 10.0f32 + s.b.x * 100.0f32 + s.b.y * 1000.0f32
}

extern "C" func make_rect(w: c_int, h: c_int) -> c.Rect {
    return c.Rect(width: w, height: h)
}

extern "C" func make_vec2(x: f32, y: f32) -> c.Vec2 {
    return c.Vec2(x: x, y: y)
}

extern "C" func make_stamp(t: f64, id: c_long) -> c.Stamp {
    return c.Stamp(t: t, id: id)
}

extern "C" func make_triple(a: c_long, b: c_long, c3: c_long) -> c.Triple {
    return c.Triple(a: a, b: b, c: c3)
}

extern "C" func make_tri(base: f32) -> c.Tri {
    return c.Tri(v: [base, base + 1.0f32], w: base + 2.0f32)
}

func main() {
    let r = c.Rect(width: 6, height: 7)
    let v = c.Vec2(x: 1.5f32, y: 2.25f32)
    let vd = c.Vec2d(x: 1.5, y: 2.25)
    let s = c.Stamp(t: 0.5, id: 41i64)
    let t = c.Triple(a: 1i64, b: 2i64, c: 3i64)
    let col = c.Rgba(r: 1u8, g: 2u8, b: 3u8, a: 4u8)
    // Floats behind a nested struct or an array are still floats to the ABI
    // (#1655): Seg is four floats, Tri three, and both go in float registers.
    let seg = c.Seg(a: c.Vec2(x: 1.0f32, y: 2.0f32), b: c.Vec2(x: 3.0f32, y: 4.0f32))
    let tri = c.Tri(v: [1.0f32, 2.0f32], w: 3.0f32)

    // Fields read on the Rask side, at the widths the header declares.
    println("fields {r.width} {r.height} {col.a}")

    unsafe {
        println("area {c.rask_test_area(r)}")
        println("vec2 {c.rask_test_vec2_sum(v)}")
        println("vec2d {c.rask_test_vec2d_sum(vd)}")
        println("stamp {c.rask_test_stamp(s)}")
        println("triple {c.rask_test_triple(t)}")
        println("rgba {c.rask_test_rgba(col)}")
        println("mixed {c.rask_test_mixed(r, 5, vd)}")
        println("seg {c.rask_test_seg(seg)}")
        println("tri {c.rask_test_tri(tri)}")
    }

    // Coming back, through a C wrapper the compiler writes (SR1): each class
    // again, read field by field.
    unsafe {
        let mr = c.rask_test_make(3, 4)
        println("back rect {mr.width} {mr.height}")
        let mv = c.rask_test_make_vec2(1.5f32, 2.5f32)
        println("back vec2 {mv.x} {mv.y}")
        let mvd = c.rask_test_make_vec2d(1.25, 2.5)
        println("back vec2d {mvd.x} {mvd.y}")
        let ms = c.rask_test_make_stamp(0.5, 7i64)
        println("back stamp {ms.t} {ms.id}")
        let mt = c.rask_test_make_triple(1i64, 2i64, 3i64)
        println("back triple {mt.a} {mt.b} {mt.c}")
        let mc = c.rask_test_make_rgba(10)
        println("back rgba {mc.r} {mc.g} {mc.b} {mc.a}")
        let ms2 = c.rask_test_make_seg(1.0f32)
        println("back seg {ms2.a.x} {ms2.a.y} {ms2.b.x} {ms2.b.y}")
        let mt2 = c.rask_test_make_tri(5.0f32)
        println("back tri {mt2.v[0]} {mt2.v[1]} {mt2.w}")
        // Straight back into C: what came out is a struct like any other.
        println("round trip {c.rask_test_area(c.rask_test_make(6, 7))}")
    }

    // C calls Rask with a struct, and reads one Rask returns.
    unsafe {
        println("called area {c.rask_test_call_area(area_of)}")
        println("called vec2 {c.rask_test_call_vec2(vec2_of)}")
        println("called stamp {c.rask_test_call_stamp(stamp_of)}")
        println("called triple {c.rask_test_call_triple(triple_of)}")
        println("called seg {c.rask_test_call_seg(seg_of)}")
        println("called make {c.rask_test_call_make(make_rect)}")
        println("called make vec2 {c.rask_test_call_make_vec2(make_vec2)}")
        println("called make stamp {c.rask_test_call_make_stamp(make_stamp)}")
        println("called make triple {c.rask_test_call_make_triple(make_triple)}")
        println("called make tri {c.rask_test_call_make_tri(make_tri)}")
        // A closure that captures nothing is a C function too (CB2).
        let built = c.rask_test_call_make(|w: c_int, h: c_int| -> c.Rect {
            return c.Rect(width: w + 1, height: h + 1)
        })
        println("called closure {built}")
    }
}
