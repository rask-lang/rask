// Two headers define macros of the same name. A macro isn't a symbol, so
// each import's is its own: computed, folded and compiled with its own
// header (struct.c-interop/PP4).

import c "c_macro_two_a.h" as ca
import c "c_macro_two_b.h" as cb

func main() {
    let n: i32 = 5
    println("run {ca.G(n)} {cb.G(n)}")
    println("const {ca.G(5)} {cb.G(5)}")
    mut x = ca.Sa(v: 3)
    mut y = cb.Sb(w: 0, v: 4)
    println("read {unsafe ca.GETV(&x)} {unsafe cb.GETV(&y)}")
}
