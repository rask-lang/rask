// `try` on a stdlib call whose error is one member of main's union error.
// The checker took the call's error type to be the whole union, so native
// never wrote which member the value was: the run reported the first
// member's message over an IoError's bytes, or matched no member at all.

import fs
import io.IoError

struct Sfail {
    s: string
    t: string
}

extend Sfail {
    func message(self) -> string {
        return "sfail {self.s} {self.t}"
    }
}

func read_it() -> void or (Sfail | IoError) {
    let t = try fs.read_text("/nonexistent/rask-fixture/zz")
    println(t)
}

func main() -> void or (Sfail | IoError) {
    let r = read_it()
    if r is IoError {
        println("is IoError")
    }
    if r is Sfail {
        println("is Sfail")
    }
    try r
}
