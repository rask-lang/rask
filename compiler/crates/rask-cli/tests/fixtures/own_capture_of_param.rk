// SPDX-License-Identifier: (MIT OR Apache-2.0)
// An `own` closure capturing a Copy *parameter* inside a branch reported the
// parameter maybe-moved at the next use (#768):
//
//     func doit(n: i32, v: Vec<i32>, flag: bool) {
//         if flag {
//             let kept = v.filter(own |c| c != n)
//         }
//         println("{n}")     // error[E0813]: use of maybe-moved value: `n`
//     }
//
// A Copy value is copied into the closure's environment, so it can't be moved
// out of the caller. The check for that read `binding_types`, which holds only
// `let`/`mut` bindings — a parameter isn't in it, so it looked non-Copy. The same
// code with `n` a local was accepted, and so was straight-line code with a
// parameter; it took parameter *and* branch together. The non-`own` closure path
// already went through `capture_is_copy`, which also reads a parameter's declared
// type; the `own` path now does too.
//
// `Handle<T>` needed one more thing: resolving a parameter's type string gave up
// on any generic spelling, so `Handle<Item>` never reached the Copy rules that
// answer by base name. It now reduces to its base — the arguments aren't needed,
// since only Handle and WeakHandle are Copy among the containers.
//
// Without `own` the same call is rejected the other way ("closure captures scoped
// borrow and cannot escape", with the fix hint telling you to add `own`), so this
// shape had no spelling that compiled.

struct Item {
    id: i32
    other: Handle<Item>?
}

struct Big {
    a: i64
    b: i64
    c: i64
}

// A Copy scalar parameter.
func scalar(n: i32, v: Vec<i32>, flag: bool) -> string {
    mut count: u64 = 0
    if flag {
        let kept = v.filter(own |c| c != n)
        count = kept.len()
    }
    return "kept={count} n={n}"
}

// A Copy handle parameter — the reported case.
func handle(mutate p: Pool<Item>, n: Handle<Item>, v: Vec<Handle<Item>>) -> string {
    mut count: u64 = 0
    if p[n].other? as _o {
        let kept = v.filter(own |c| c != n)
        count = kept.len()
    }
    return "kept={count} id={p[n].id}"
}

// A non-Copy parameter is still moved by an `own` capture, so this one has to
// use it only inside the branch.
func nocopy(big: Big, v: Vec<i64>, flag: bool) -> u64 {
    if flag {
        let kept = v.filter(own |c| c != big.a)
        return kept.len()
    }
    return 0
}

func main() {
    mut v: Vec<i32> = Vec.new()
    v.push(1)
    v.push(2)
    v.push(3)
    println("scalar={scalar(2, v, true)}")
    println("scalar no branch={scalar(2, v, false)}")

    mut p: Pool<Item> = Pool.new()
    let a = p.insert(Item { id: 10, other: none })
    let b = p.insert(Item { id: 20, other: a })
    mut hs: Vec<Handle<Item>> = Vec.new()
    hs.push(a)
    hs.push(b)
    println("{handle(mutate p, b, hs)}")
    println("{handle(mutate p, a, hs)}")

    mut ns: Vec<i64> = Vec.new()
    ns.push(1)
    ns.push(2)
    println("nocopy={nocopy(Big { a: 1, b: 2, c: 3 }, ns, true)}")
}
