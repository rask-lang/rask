// E18-E20: field annotations surfaced through reflect (interpreter path).

import std.reflect

struct ApiUser {
    @rename("user_name")
    public name: string

    @no_serialize
    public cache_key: string

    @default(0)
    public login_count: i32

    public role: string = "guest"
}

func main() {
    comptime for field in reflect.fields<ApiUser>() {
        println("{field.name} {field.serial_name} {field.is_skipped} {field.has_default}")
    }
}
