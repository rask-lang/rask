// mem.context/CC7 (#434): a private function with a Handle param and no `using`
// clause infers an unnamed Pool<Player> context from its `h.field` access.
import memory.Handle
import memory.Pool

struct Player { health: i32 }

func report(h: Handle<Player>) {
    print(h.health)
}

func main() {
    mut players = Pool.new()
    let p = players.insert(Player { health: 42 })
    report(p)
}
