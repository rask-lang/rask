// The same loop as `comptime_quota.rk`, with the annotation that says how much
// room it needs. 5000 iterations, 6000 allowed.
@comptime_quota(6000)
const SUM: i64 = comptime {
    mut n = 0
    for i in 0..5000 {
        n = n + i
    }
    n
}

func main() { println(SUM.to_string()) }
