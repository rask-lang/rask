// FD1-FD5: struct field defaults, filled at construction when omitted.

struct Config {
    public host: string
    public port: i32 = 8080
    public verbose: bool = false
}

struct Settings {
    public width: i32 = 640
    public height: i32 = 480
    public title: string = "untitled"
}

func main() {
    // FD2: omitted defaulted fields fill in
    let c = Config { host: "localhost" }
    println("{c.host} {c.port} {c.verbose}")

    // Explicit values override defaults
    let d = Config { host: "example.com", port: 3000, verbose: true }
    println("{d.host} {d.port} {d.verbose}")

    // FD3: every field defaulted -> {} constructs all defaults
    let a = Settings {}
    println("{a.width} {a.height} {a.title}")

    // FD5: spread covers unlisted fields; explicit wins over spread
    let b = Settings { width: 800 }
    let e = Settings { title: "copy", ..b }
    println("{e.width} {e.height} {e.title}")
}
