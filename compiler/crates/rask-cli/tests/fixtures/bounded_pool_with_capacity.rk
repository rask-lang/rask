// mem.pools/PL2: a with_capacity pool holds up to its bound; inserts within the
// bound work like a normal pool. Native and interp agree.
import memory.Pool

struct Ent { hp: i32 }

func main() {
    mut p = Pool.with_capacity(4)
    let a = p.insert(Ent { hp: 10 })
    let b = p.insert(Ent { hp: 20 })
    print(p.len())
    print(p[a].hp + p[b].hp)
}
