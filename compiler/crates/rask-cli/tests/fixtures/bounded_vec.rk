// std.collections/CP1-CP3, C2 (#666): a bounded vector refuses to grow past its
// bound. `try_push` hands the rejected value back instead of panicking, which is
// the whole reason the growth error carries a payload.

public func main() {
    mut v: Vec<i32> = Vec.fixed(2)
    print(v.is_bounded())
    print(v.capacity() ?? 0)
    print(v.remaining() ?? 0)

    v.push(10)
    v.push(20)
    print(v.is_full())
    print(v.remaining() ?? 9)

    match v.try_push(30) {
        GrowError.Full(rejected) => print(rejected),
        GrowError.NoMemory(rejected) => print(rejected),
        _ => print(0),
    }
    // The rejected element never went in.
    print(v.len())

    // CP1: a capacity hint is not a bound.
    mut u: Vec<i32> = Vec.with_capacity(2)
    print(u.is_bounded())
    u.push(1)
    u.push(2)
    u.push(3)
    print(u.len())

    // The rejected element is the one that was offered, not a stale slot.
    mut w: Vec<i32> = Vec.fixed(1)
    w.try_push(7) catch _ => {}
    match w.try_push(41) {
        GrowError.Full(r) => print(r),
        _ => print("pushed"),
    }
    print(w[0])
}

// A payload wider than a machine word — `Vec<string>` here — comes back as
// garbage from the error, because a generic enum stores its payload in one word
// under the single layout every instantiation of that enum shares. That is not
// specific to growth errors and predates this: constructing any generic enum
// with a string payload prints garbage natively. Covering it here would be
// testing that bug, so this stays on word-sized elements until the layout is
// per-instantiation.
