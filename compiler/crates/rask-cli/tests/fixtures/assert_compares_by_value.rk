// `assert a == b` compares by value on every type, on both backends.
//
// This was `assert_eq`'s fixture. That spelling is gone (std.testing/A4 was
// deleted), and the property it pinned belongs to `==` anyway.

struct Point {
    public x: i32
    public y: i32
}

enum Color { Red, Green }

func main() {
    println("assert_compares_by_value")
}

test "strings compare by content" {
    let a = "hei"
    let b = "hei"
    assert a == b
    assert a == "hei"
}

test "a heap string past the small-string limit" {
    let a = "en ganske lang streng som ikke passer i sso-bufferen"
    let b = "en ganske lang streng som ikke passer i sso-bufferen"
    assert a == b
}

test "floats" {
    assert 1.5 == 1.5
    let f: f32 = 2.25
    assert f == 2.25
}

test "chars" {
    assert 'a' == 'a'
}

test "bools" {
    assert true == true
    assert false == false
}

test "narrow integers" {
    let n: u16 = 8080
    assert n == 8080
    let m: i32 = -7
    assert m == -7
}

test "structs" {
    let a = Point { x: 1, y: 2 }
    let b = Point { x: 1, y: 2 }
    assert a == b
}

test "enums" {
    assert Color.Red == Color.Red
}
