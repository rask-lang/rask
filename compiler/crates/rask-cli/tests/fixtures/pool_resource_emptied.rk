// The other half of mem.resources/R5: a pool emptied before it is dropped is
// fine, and is what the rule asks for.

import memory.Pool

@resource
struct Conn {
    public id: i32
}

extend Conn {
    public func close(take self) -> i32 {
        return self.id
    }
}

func tidy() -> i32 {
    mut p: Pool<Conn> = Pool.new()
    let h = p.insert(Conn { id: 4 })
    mut total = 0
    if p.remove(h)? as c {
        total = total + c.close()
    }
    return total
}

func main() {
    println("{tidy()}")
}
