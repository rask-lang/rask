// The test body joins a task that waits for a value only the body can send.
import async.spawn

test "join before send" {
    using Multitasking {
        let (tx, rx) = Channel<i64>.buffered(1)
        let waiter = spawn(|| {
            let _ = rx.receive()
        })
        ensure waiter.detach()
        waiter.join()!
        let _ = tx.send(1)
    }
}
