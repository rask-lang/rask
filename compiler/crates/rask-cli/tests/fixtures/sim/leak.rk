// A test that passes and leaks: a block from the allocator that nothing gives
// back. Raw memory is the program's to free, so this stays a leak whatever the
// compiler learns about releasing values.

extern "C" func rask_alloc(size: i64) -> *u8

func never_given_back() -> bool {
    let block = unsafe rask_alloc(64)
    return !block.is_null()
}

test "a raw block nothing frees" {
    assert never_given_back()
}
