// The corners of the loopback network that used to hang or answer wrongly.
import net
import async.spawn

// A connection still waiting in a listener's backlog when the listener
// closes is refused. It used to stay queued, and its client waited forever.
test "closing a listener resets the connections it never accepted" {
    using Multitasking {
        let listener = try net.tcp_listen("127.0.0.1:0")
        let addr = listener.local_addr()
        let (tx, rx) = Channel<bool>.buffered(1)
        let (done_tx, done_rx) = Channel<bool>.buffered(1)
        let client = spawn(|| {
            let conn = net.tcp_connect(addr) catch e => {
                let _ = done_tx.send(true)
                return
            }
            let _ = tx.send(true)
            let failed = conn.read_text() is IoError
            let _ = conn.close()
            let _ = done_tx.send(failed)
        })
        ensure client.detach()
        let _ = rx.receive()
        let _ = listener.close()
        assert done_rx.receive()!
        client.join()!
    }
}

test "a port that isn't a number is an error" {
    assert net.tcp_listen("127.0.0.1:http") is IoError
    assert net.tcp_connect("127.0.0.1:http") is IoError
}
