// `workers: 1` means one body in flight at a time, under sim as anywhere.
import sync.Atomic

const IN_FLIGHT: Atomic<i64> = Atomic<i64>.new(0)
const PEAK: Atomic<i64> = Atomic<i64>.new(0)

func body() {
    let now = IN_FLIGHT.fetch_add(1) + 1
    if now > PEAK.load() {
        PEAK.store(now)
    }
    IN_FLIGHT.fetch_sub(1)
}

test "one worker, one body" {
    using Multitasking(workers: 1) {
        let a = spawn { body() }
        ensure a.detach()
        let b = spawn { body() }
        ensure b.detach()
        let c = spawn { body() }
        ensure c.detach()
        a.join()!
        b.join()!
        c.join()!
        assert PEAK.load() == 1
    }
}
