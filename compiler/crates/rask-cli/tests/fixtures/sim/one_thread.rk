//
// Under sim every task is a fiber on the thread running the test, so the
// process has one thread however many tasks it spawns. It used to be a baton
// over one OS thread per task.
import fs

func threads() -> string {
    let text = fs.read_text("/proc/self/status")!
    for line in text.split("\n") {
        if line.starts_with("Threads:") {
            return line
        }
    }
    return "?"
}

test "tasks are fibers" {
    using Multitasking(workers: 4) {
        assert spawn(|| { return threads() }).join()! == "Threads:\t1"
        let nested = spawn(|| {
            return spawn(|| { return threads() }).join()!
        }).join()!
        assert nested == "Threads:\t1"
    }
}
