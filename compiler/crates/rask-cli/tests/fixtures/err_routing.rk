// #259 family — ok/err arm routing decided by the scrutinee's real type
// identities, not by the capitalization of the pattern's type name.
//
// Old native routed by "lowercase first char ⇒ ok side": a lowercase-named
// err type (`failure`) was sent to the ok side, so the err arm never ran and
// `load_num(false)` fell through printing nothing. Type names start with a
// capital now (E0417), so that adversary is gone; `Failure` and `Cfg` still
// check routing goes by type identity, on both backends.
//
// Match form only: the `if r is X` form has a pre-existing interpreter bug
// (#391) and union-err members a pre-existing native bug (#375), so neither is
// asserted here.

struct Cfg { port: i64 }
enum CfgError { Bad }
extend CfgError {
    func message(self) -> string {
        match self { CfgError.Bad => return "bad" }
    }
}

// An error type with nothing in its name that says error — routing goes by
// the type, not the spelling.
enum Failure { Down }
extend Failure {
    func message(self) -> string {
        match self { Failure.Down => return "down" }
    }
}

func load_cfg(ok: bool) -> Cfg or CfgError {
    if ok {
        return Cfg(port: 8080)
    }
    return CfgError.Bad
}

func load_num(ok: bool) -> i64 or Failure {
    if ok {
        return 7
    }
    return Failure.Down
}

func main() {
    // Uppercase struct on the ok side → ok arm.
    match load_cfg(true) {
        Cfg as c => println("cfg {c.port}")
        CfgError => println("cfg err")
    }
    match load_cfg(false) {
        Cfg as c => println("cfg {c.port}")
        CfgError => println("cfg err")
    }
    // An err type whose name says nothing about errors → err arm.
    match load_num(true) {
        i64 as v => println("num {v}")
        Failure => println("num err")
    }
    match load_num(false) {
        i64 as v => println("num {v}")
        Failure => println("num err")
    }
}
