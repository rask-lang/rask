// Four threads, each emitting its whole line in one println. Every line of
// output must read exactly "line N from thread M" — no splicing.
import async.Handles
import thread.Thread

func spam(id: i64) {
    for i in 0..300 {
        println("line {i} from thread {id}")
    }
}

func main() {
    mut threads = Handles<void>.new()
    ensure threads.detach()
    threads.add(Thread.spawn(|| { spam(1) }))
    threads.add(Thread.spawn(|| { spam(2) }))
    threads.add(Thread.spawn(|| { spam(3) }))
    threads.add(Thread.spawn(|| { spam(4) }))
    let _ = threads.join_all()
}
