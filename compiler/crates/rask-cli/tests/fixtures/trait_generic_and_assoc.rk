// Trait type parameters and associated types, end to end.
//
// `trait Mul<Rhs> { type Out ... }` is the line operator resolution is built on
// and neither half existed: the parameter was dropped on the floor and `type`
// in a trait body hung the parser (#1164, #1165).

struct Meters { v: f64 }
struct SquareMeters { v: f64 }
struct Point { x: f64, y: f64 }

// GT4/AT4: both defaults declared on the trait, so `extend Point with Mul`
// means `Mul<Point>` answering in `Point`.
trait Mul<Rhs = Self> {
    type Out = Self

    func mul(self, rhs: Rhs) -> Self.Out
}

extend Point with Mul {
    func mul(self, rhs: Point) -> Point {
        return Point { x: self.x * rhs.x, y: self.y * rhs.y }
    }
}

extend Meters with Mul<f64> {
    func mul(self, k: f64) -> Meters {
        return Meters { v: self.v * k }
    }
}

// AT8: a second conformance of the same trait, to a different type, with its
// own `Out`. `Meters` can't also carry `Mul<Meters>` — that would be two
// `mul`s on one type and MN1 gives it one, so it's rejected at the block
// (E0889) until operator resolution picks from the pair.
extend SquareMeters with Mul<SquareMeters> {
    type Out = SquareMeters

    func mul(self, other: SquareMeters) -> SquareMeters {
        return SquareMeters { v: self.v * other.v }
    }
}

// GT2: `Rhs` is substituted from the bound, so `k` is an `f64` here.
trait Scale<Rhs> {
    func scale(self, k: Rhs) -> Self
}

extend Meters with Scale<f64> {
    func scale(self, k: f64) -> Meters {
        return Meters { v: self.v * k }
    }
}

// AT3/AT6: the projection in generic code. `T.Out` is written, then read off
// T's conformance once T is known — no search, no inference.
func doubled<T: Mul<f64>>(x: T) -> T.Out {
    return x.mul(2.0)
}

func main() {
    let m = Meters { v: 3.0 }
    println(m.mul(2.0).v)
    println(m.scale(4.0).v)
    println(doubled(m).v)

    let p = Point { x: 2.0, y: 3.0 }.mul(Point { x: 4.0, y: 5.0 })
    println(p.x)
    println(p.y)

    let a = SquareMeters { v: 2.0 }.mul(SquareMeters { v: 5.0 })
    println(a.v)
}
