// mem.context/CC1 (#434): `h.field` on a Handle<Player> auto-resolves through
// the named `using players: Pool<Player>` context — no explicit `players[h]`.
import memory.Handle
import memory.Pool

struct Player { health: i32 }

func report(h: Handle<Player>) using players: Pool<Player> {
    print(h.health)
}

func main() {
    mut players = Pool.new()
    let p = players.insert(Player { health: 100 })
    report(p)
}
