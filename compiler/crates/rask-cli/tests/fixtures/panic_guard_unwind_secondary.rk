// ctrl.panic/E3, issue #298: a runtime guard firing at scope exit *during
// unwind* is a secondary panic, not a replacement for the one already in
// flight.
//
// The guard here is R5 — a `Pool<Conn>` that still holds a resource when its
// scope ends. A pool's contents are a runtime fact, so this is the corner the
// static rules can't reach: `nested` panics with "boom", the pool trips its
// guard on the way out, and "boom" stays the task's panic while the leak goes
// to stderr.
//
// It used to be an unconsumed TaskHandle (H1), parked behind a `h.join()` the
// panic jumped over. mem.linear/L7 rejects that shape now — nothing may stand
// between acquiring a linear value and committing its cleanup — so the same
// corner is reached through the pool instead.

import memory.Pool

@resource
struct Conn {
    public id: i64
}

extend Conn {
    public func close(take self) -> void {
        println("closed {self.id}")
    }
}

func nested() -> i64 {
    mut pool: Pool<Conn> = Pool.new()
    let _h = pool.insert(Conn { id: 1 })
    println("inserted")
    panic("boom")
    return 0
}

func main() {
    nested()
}
