// GA2: an atomic is one machine word. Rask gives every struct field its own
// word, so two i32 fields are 16 bytes and there is no single instruction to
// read or write them.
import sync.Atomic

struct Slot {
    index: i32
    gen: i32
}

func main() {
    let s = Atomic<Slot>.new(Slot { index: 0, gen: 0 })
    println("{s.load(Ordering.SeqCst).index}")
}
