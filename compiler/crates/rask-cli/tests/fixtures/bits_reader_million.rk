// A million single-byte reads off one `bits.BinaryReader`. Reads used to hand
// back the rest of the buffer as a fresh Vec, so this was ~5×10¹¹ byte copies.
import bits
import time

func sum_bytes(n: usize) -> u64 or bits.BinaryParseError {
    mut data: Vec<u8> = Vec.with_capacity(n)
    for i in 0..n {
        data.push((i % 7).wrap<u8>())
    }
    mut r = bits.BinaryReader.new(data)
    mut total: u64 = 0
    while r.remaining() > 0 {
        let b = try r.read_u8()
        total += b.wrap<u64>()
    }
    return total
}

func main() {
    let start = time.Instant.now()
    let total = sum_bytes(1_000_000) catch e => {
        println(e.message())
        return
    }
    let fast = start.elapsed().as_millis() < 2000
    println("total={total} fast={fast}")
}
