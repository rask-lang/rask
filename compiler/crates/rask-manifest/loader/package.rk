// The checked tree onto Rask types. The tree already passed the shape
// check, so a missing or mistyped value here is a bug in this file, not in
// the manifest.
//
// Written by hand: it restates the shape in package_schema.rk.

import schema.{Entry, LoadError, load, table_at, str_at, bool_at, int_at, pairs_at, strs_at, quoted_list}

public struct Package {
    public name: string
    public version: string
    public description: string?
    public license: string?
    public repository: string?
    public members: Vec<string>
    public sandbox: bool
    public vendor_dir: string?
    public dependencies: Vec<Dep>
    public dev_dependencies: Vec<Dep>
    public build_dependencies: Vec<Dep>
    public features: Vec<Feature>
    public exclusive_features: Vec<ExclusiveFeature>
    public profiles: Vec<Profile>
}

public enum DepSource {
    Registry(string)
    Path(string)
    Git(url: string, rev: string?, branch: string?)
}

public struct Dep {
    public name: string
    public source: DepSource
    public target: string?
    public with: Vec<string>
    public allow: Vec<string>
    // Exclusive feature choices made for this dependency: group, option.
    public select: Vec<(string, string)>
    // Also gated by this feature of ours.
    public feature: string?
}

public struct Feature {
    public name: string
    public on_by_default: bool
    public enables: Vec<string>
    public dependencies: Vec<Dep>
    public dev_dependencies: Vec<Dep>
    public build_dependencies: Vec<Dep>
}

public struct ExclusiveFeature {
    public name: string
    public default: string
    public options: Vec<FeatureOption>
}

public struct FeatureOption {
    public name: string
    public dependencies: Vec<Dep>
}

public struct Profile {
    public name: string
    public inherits: string?
    public opt_level: string?
    public debug_info: bool?
    public overflow_checks: bool?
    public lto: string?
    public codegen_units: i64?
    public strip: bool?
    public panic: string?
}

public func load_package(text: string) -> Package or LoadError {
    let tree = try load(text, package_schema())
    let pkg = table_at(tree, "package")
    let built = Package(
        name: str_at(pkg, "name") ?? ""
        version: str_at(pkg, "version") ?? ""
        description: str_at(pkg, "description")
        license: str_at(pkg, "license")
        repository: str_at(pkg, "repository")
        members: strs_at(pkg, "members")
        sandbox: bool_at(pkg, "sandbox") ?? false
        vendor_dir: str_at(pkg, "vendor-dir")
        dependencies: deps_at(tree, "dependencies")
        dev_dependencies: deps_at(tree, "dev-dependencies")
        build_dependencies: deps_at(tree, "build-dependencies")
        features: features_at(tree)
        exclusive_features: exclusive_at(tree)
        profiles: profiles_at(tree)
    )
    let errors = rule_errors(built)
    if !errors.is_empty() {
        return LoadError(what: errors.join("\n"))
    }
    return built
}

// ─── Rules the shape can't state ────────────────────────────────
// Each needs only this file, so it's checked here with the rest of the file
// rather than at build time (struct.build F5, F6, FG2 and the profile
// ranges). They run once the shape holds.

func rule_errors(p: Package) -> Vec<string> {
    mut errors = Vec<string>.new()
    check_enables(p, mutate errors)
    check_one_entry_per_dep(p, mutate errors)
    for g in p.exclusive_features {
        mut names = Vec<string>.new()
        for o in g.options {
            names.push(o.name)
        }
        if !names.contains(g.default) {
            errors.push("exclusive-features.{g.name}.default: `{g.default}` is not one of its options ({quoted_list(names)})")
        }
    }
    for pr in p.profiles {
        if pr.codegen_units? as n {
            if n < 1 || n > 256 {
                errors.push("profiles.{pr.name}.codegen-units: {n} is outside 1 to 256")
            }
        }
    }
    return errors
}

// F6: `enables` names a declared feature, and no chain of them comes back
// around.
func check_enables(p: Package, mutate errors: Vec<string>) {
    mut names = Vec<string>.new()
    for f in p.features {
        names.push(f.name)
    }
    for g in p.exclusive_features {
        names.push(g.name)
    }
    for f in p.features {
        for n in f.enables {
            if !names.contains(n) {
                errors.push("features.{f.name}.enables: `{n}` is not a feature")
            }
        }
    }
    mut done = Vec<string>.new()
    for f in p.features {
        mut path = Vec<string>.new()
        walk_enables(f.name, p.features, mutate path, mutate done, mutate errors)
    }
}

func walk_enables(name: string, features: Vec<Feature>, mutate path: Vec<string>, mutate done: Vec<string>, mutate errors: Vec<string>) {
    if path.contains(name) {
        mut cycle = Vec<string>.new()
        mut on = false
        for n in path {
            if n == name {
                on = true
            }
            if on {
                cycle.push(n)
            }
        }
        cycle.push(name)
        errors.push("features.{name}.enables: features enable each other in a circle: {cycle.join(" -> ")}")
        return
    }
    if done.contains(name) {
        return
    }
    done.push(name)
    for f in features {
        if f.name == name {
            path.push(name)
            for next in f.enables {
                walk_enables(next, features, mutate path, mutate done, mutate errors)
            }
            path.pop()
        }
    }
}

// D3 and F5: a name gets one entry across every dependency table in the
// file, whatever its scope. `import x` has to lead to one package, and two
// entries are either redundant (a [dependencies] entry is already there in
// tests) or two different packages under one name. A second feature gate
// goes through `feature = "other"` on the one entry. An exclusive group's
// options are alternatives, only one of them ever on, so each may name it.
func check_one_entry_per_dep(p: Package, mutate errors: Vec<string>) {
    // (name, where it was first declared, the feature it belongs to or "")
    mut seen = Vec<(string, string, string)>.new()
    mut tables = Vec<(string, string, Vec<Dep>)>.new()
    tables.push(("dependencies", "", p.dependencies.clone()))
    tables.push(("dev-dependencies", "", p.dev_dependencies.clone()))
    tables.push(("build-dependencies", "", p.build_dependencies.clone()))
    for f in p.features {
        tables.push(("features.{f.name}.dependencies", f.name, f.dependencies.clone()))
        tables.push(("features.{f.name}.dev-dependencies", f.name, f.dev_dependencies.clone()))
        tables.push(("features.{f.name}.build-dependencies", f.name, f.build_dependencies.clone()))
    }
    for (place, feature, deps) in tables {
        for d in deps {
            mut first = ""
            mut first_feature = ""
            for (name, at, owner) in seen {
                if name == d.name && first.is_empty() {
                    first = at
                    first_feature = owner
                }
            }
            if first.is_empty() {
                seen.push((d.name, place, feature))
            } else if !feature.is_empty() && !first_feature.is_empty() && feature != first_feature {
                errors.push("{place}.{d.name}: `{d.name}` is already gated by feature `{first_feature}`; gate this one on it with `feature = \"{first_feature}\"` instead")
            } else {
                errors.push("{place}.{d.name}: `{d.name}` is already declared in [{first}]; a name gets one entry")
            }
        }
    }
}

func exclusive_at(tree: Vec<Entry>) -> Vec<ExclusiveFeature> {
    mut out = Vec<ExclusiveFeature>.new()
    for e in table_at(tree, "exclusive-features") {
        if e.value is Table(g) {
            mut options = Vec<FeatureOption>.new()
            for o in table_at(g, "options") {
                if o.value is Table(deps) {
                    mut list = Vec<Dep>.new()
                    for d in deps {
                        if d.value is Table(spec) {
                            list.push(dep_from(d.key, spec))
                        }
                    }
                    options.push(FeatureOption(name: o.key, dependencies: list))
                }
            }
            out.push(ExclusiveFeature(name: e.key, default: str_at(g, "default") ?? "", options))
        }
    }
    return out
}

func deps_at(entries: Vec<Entry>, key: string) -> Vec<Dep> {
    mut out = Vec<Dep>.new()
    for e in table_at(entries, key) {
        if e.value is Table(spec) {
            out.push(dep_from(e.key, spec))
        }
    }
    return out
}

func dep_from(name: string, spec: Vec<Entry>) -> Dep {
    mut source = DepSource.Path("")
    if str_at(spec, "registry")? as req {
        source = DepSource.Registry(req)
    } else if str_at(spec, "path")? as p {
        source = DepSource.Path(p)
    } else if str_at(spec, "git")? as url {
        source = DepSource.Git(url, rev: str_at(spec, "rev"), branch: str_at(spec, "branch"))
    }
    return Dep(
        name
        source
        target: str_at(spec, "target")
        with: strs_at(spec, "with")
        allow: strs_at(spec, "allow")
        select: pairs_at(spec, "select")
        feature: str_at(spec, "feature")
    )
}

func features_at(tree: Vec<Entry>) -> Vec<Feature> {
    mut out = Vec<Feature>.new()
    for e in table_at(tree, "features") {
        if e.value is Table(f) {
            out.push(Feature(
                name: e.key
                on_by_default: bool_at(f, "default") ?? false
                enables: strs_at(f, "enables")
                dependencies: deps_at(f, "dependencies")
                dev_dependencies: deps_at(f, "dev-dependencies")
                build_dependencies: deps_at(f, "build-dependencies")
            ))
        }
    }
    return out
}

func profiles_at(tree: Vec<Entry>) -> Vec<Profile> {
    mut out = Vec<Profile>.new()
    for e in table_at(tree, "profiles") {
        if e.value is Table(p) {
            out.push(Profile(
                name: e.key
                inherits: str_at(p, "inherits")
                opt_level: str_at(p, "opt-level")
                debug_info: bool_at(p, "debug-info")
                overflow_checks: bool_at(p, "overflow-checks")
                lto: str_at(p, "lto")
                codegen_units: int_at(p, "codegen-units")
                strip: bool_at(p, "strip")
                panic: str_at(p, "panic")
            ))
        }
    }
    return out
}

extend DepSource {
    public func describe(self) -> string {
        return match self {
            DepSource.Registry(req) => "registry {req}",
            DepSource.Path(p) => "path {p}",
            DepSource.Git(url, rev, branch) => {
                mut s = "git {url}"
                if rev? as r {
                    s = "{s} rev {r}"
                }
                if branch? as b {
                    s = "{s} branch {b}"
                }
                s
            }
        }
    }
}
