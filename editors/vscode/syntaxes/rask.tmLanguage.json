{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rask",
  "scopeName": "source.rk",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#method-calls" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.rk",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.rk",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rk",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "comment": "\"..\" and \"\"\"..\"\"\" interpolate: { opens a hole holding an expression, up to the matching }. \\{ and \\} are literal braces. Raw strings are text as written.",
      "patterns": [
        {
          "name": "string.quoted.triple.rk",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation-multiline" }
          ]
        },
        {
          "name": "string.quoted.raw.hash.rk",
          "begin": "(?<![A-Za-z0-9_])r(#+)\"",
          "end": "\"\\1"
        },
        {
          "name": "string.quoted.raw.rk",
          "begin": "(?<![A-Za-z0-9_])r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.bytes.rk",
          "match": "(?<![A-Za-z0-9_])x\"[^\"]*\""
        },
        {
          "name": "string.quoted.double.rk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.rk",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.rk",
          "match": "\\\\(n|r|t|\\\\|0|'|\"|\\{|\\}|u\\{[0-9a-fA-F]{1,6}\\})"
        }
      ]
    },
    "interpolation": {
      "comment": "Same rule as the lexer: { opens a hole only when a matching } follows on the same line (nested strings closed), and not for the {\"key\": ..} of JSON text. Otherwise the brace is plain text.",
      "name": "meta.interpolation.rk",
      "begin": "(?=(?<hole>\\{(?:[^{}\"\\\\]|\\\\.|\"(?:[^\"\\\\]|\\\\.)*\"|\\g<hole>)*+\\}))\\{(?!\\{)(?!\\s*\"(?:[^\"\\\\]|\\\\.)*\"\\s*:)",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.rk" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.rk" } },
      "patterns": [
        { "include": "#format-spec" },
        { "include": "#interpolation-expr" }
      ]
    },
    "interpolation-multiline": {
      "comment": "Holes in triple-quoted strings may run over lines; the closing quotes end an unclosed one",
      "name": "meta.interpolation.rk",
      "begin": "\\{(?!\\{)",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.rk" } },
      "end": "\\}|(?=\"\"\")",
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.rk" } },
      "patterns": [
        { "include": "#format-spec" },
        { "include": "#interpolation-expr" }
      ]
    },
    "format-spec": {
      "comment": "The first colon outside any bracket or string starts the spec: {x:>5}, {x:debug}",
      "name": "meta.format-spec.rk",
      "match": "(:)([^}]*)",
      "captures": {
        "1": { "name": "punctuation.separator.colon.rk" },
        "2": { "name": "constant.other.format-spec.rk" }
      }
    },
    "interpolation-expr": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#interpolation-expr-no-strings" }
      ]
    },
    "interpolation-expr-no-strings": {
      "comment": "Code inside a hole. Brackets nest so a } or : inside them doesn't end the hole or start a spec",
      "patterns": [
        { "include": "#interpolation-braces" },
        { "include": "#interpolation-parens" },
        { "include": "#interpolation-brackets" },
        { "include": "#numbers" },
        { "include": "#method-calls" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#identifiers" }
      ]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.definition.block.rk" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.block.rk" } },
      "patterns": [
        { "include": "#interpolation-expr" }
      ]
    },
    "interpolation-parens": {
      "begin": "\\(",
      "beginCaptures": { "0": { "name": "punctuation.definition.parameters.rk" } },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.definition.parameters.rk" } },
      "patterns": [
        { "include": "#interpolation-expr" }
      ]
    },
    "interpolation-brackets": {
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.definition.brackets.rk" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.definition.brackets.rk" } },
      "patterns": [
        { "include": "#interpolation-expr" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.rk",
          "match": "\\b0x[0-9a-fA-F_]+(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize)?\\b"
        },
        {
          "name": "constant.numeric.binary.rk",
          "match": "\\b0b[01_]+(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize)?\\b"
        },
        {
          "name": "constant.numeric.octal.rk",
          "match": "\\b0o[0-7_]+(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize)?\\b"
        },
        {
          "name": "constant.numeric.float.rk",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.rk",
          "match": "\\b[0-9][0-9_]*(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize)?\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.rk",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
          "captures": {
            "0": { "name": "entity.name.function.decorator.rk" }
          }
        },
        {
          "name": "meta.attribute.rk",
          "begin": "@([a-zA-Z_][a-zA-Z0-9_]*)\\(",
          "beginCaptures": {
            "1": { "name": "entity.name.function.decorator.rk" }
          },
          "end": "\\)",
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "method-calls": {
      "comment": "Keywords used as method names after dot - color as methods not keywords",
      "patterns": [
        {
          "name": "entity.name.function.method.rk",
          "match": "(?<=\\.)\\s*(func|let|mut|const|struct|enum|union|interface|implements|extend|import|type|test|benchmark|public|private|take|mutate|unsafe|comptime|native|export|extern|lazy|if|else|match|for|in|while|loop|break|continue|return|is|assert|check|try|catch|discard|select_priority|select|using|with|ensure|where|as|or|asm|void|true|false|none)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.method.rk",
          "match": "(?<=\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rk",
          "match": "\\b(if|else|match|for|in|while|loop|break|continue|return|is|assert|check|try|catch|discard)\\b"
        },
        {
          "name": "keyword.declaration.rk",
          "match": "\\b(func|let|mut|const|struct|enum|union|interface|implements|extend|import|type|test)\\b"
        },
        {
          "name": "keyword.modifier.rk",
          "match": "\\b(public|private|take|mutate|unsafe|comptime|native|export|extern|lazy)\\b"
        },
        {
          "name": "keyword.other.rk",
          "match": "\\b(select_priority|select|using|with|ensure|where|as|or|asm|benchmark)\\b"
        },
        {
          "name": "storage.type.void.rk",
          "match": "\\bvoid\\b"
        },
        {
          "name": "constant.language.rk",
          "match": "\\b(true|false|none)\\b"
        },
        {
          "name": "variable.language.self.rk",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.rk",
          "match": "\\b(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|char|string)\\b"
        },
        {
          "name": "entity.name.type.rk",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.rk",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.compound.rk",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.assignment.rk",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.rk",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.rk",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.rk",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.arrow.rk",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.range.rk",
          "match": "(\\.\\.|\\.\\.=)"
        },
        {
          "name": "keyword.operator.optional.rk",
          "match": "(\\?\\?|\\?\\.)"
        },
        {
          "name": "keyword.operator.optional.rk",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.rk",
          "match": "[,;]"
        },
        {
          "name": "punctuation.accessor.rk",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.block.rk",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.parameters.rk",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.brackets.rk",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.colon.rk",
          "match": ":"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.rk",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        },
        {
          "name": "variable.other.rk",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
