// Solution: Lesson 13

enum FlightPhase {
    Parked, Taxiing, Takeoff(runway: string),
    Climbing(altitude: f64, target: f64), Cruising(altitude: f64),
    Descending(altitude: f64, target: f64), Landed
}

enum LogEntry {
    EngineStart(time: i32)
    Takeoff(time: i32, runway: string)
    WaypointReached(time: i32, name: string, altitude: f64)
    Landing(time: i32, runway: string)
    EngineStop(time: i32)
}

func entry_time(entry: LogEntry) -> i32 {
    return match entry {
        EngineStart(time: t) => t,
        Takeoff(time: t, runway: _) => t,
        WaypointReached(time: t, name: _, altitude: _) => t,
        Landing(time: t, runway: _) => t,
        EngineStop(time: t) => t,
    }
}

func flight_time(log: Vec<LogEntry>) -> i32 {
    mut takeoff_time = -1
    mut landing_time = -1
    for entry in log {
        match entry {
            Takeoff(time: t, runway: _) => { takeoff_time = t }
            Landing(time: t, runway: _) => { landing_time = t }
            _ => {}
        }
    }
    if takeoff_time < 0 { return 0 }
    if landing_time < 0 { return 0 }
    return landing_time - takeoff_time
}

enum Token { Num(f64), Plus, Minus, Times, Divide }

func eval_postfix(tokens: Vec<Token>) -> f64 {
    mut stack = Vec.new()
    for token in tokens {
        match token {
            Num(x) => stack.push(x),
            Plus => {
                let b = stack.pop()!
                let a = stack.pop()!
                stack.push(a + b)
            }
            Minus => {
                let b = stack.pop()!
                let a = stack.pop()!
                stack.push(a - b)
            }
            Times => {
                let b = stack.pop()!
                let a = stack.pop()!
                stack.push(a * b)
            }
            Divide => {
                let b = stack.pop()!
                let a = stack.pop()!
                stack.push(a / b)
            }
        }
    }
    return stack.pop()!
}

enum AirportStatus {
    Open
    Closed(reason: string)
    Restricted(ceiling_ft: i32, visibility_sm: f64)
}

func can_land_ifr(status: AirportStatus) -> bool {
    return match status {
        Open => true,
        Closed(reason: _) => false,
        Restricted(ceiling_ft: ceiling, visibility_sm: vis) => ceiling >= 200 && vis >= 0.5,
    }
}

func can_land_vfr(status: AirportStatus) -> bool {
    return match status {
        Open => true,
        Closed(reason: _) => false,
        Restricted(ceiling_ft: ceiling, visibility_sm: vis) => ceiling >= 1000 && vis >= 3.0,
    }
}

test "entry time" {
    assert entry_time(LogEntry.EngineStart(time: 800)) == 800
    assert entry_time(LogEntry.Takeoff(time: 815, runway: "27L")) == 815
    assert entry_time(LogEntry.Landing(time: 1030, runway: "09R")) == 1030
}

test "flight time" {
    let log = Vec.from([
        LogEntry.EngineStart(time: 800), LogEntry.Takeoff(time: 815, runway: "27L")
        LogEntry.WaypointReached(time: 900, name: "CEDAR", altitude: 35000.0)
        LogEntry.WaypointReached(time: 945, name: "MAPLE", altitude: 35000.0)
        LogEntry.Landing(time: 1030, runway: "09R"), LogEntry.EngineStop(time: 1045)
    ])
    assert flight_time(log) == 215
}

test "flight time no takeoff" {
    let log = Vec.from([LogEntry.EngineStart(time: 800), LogEntry.EngineStop(time: 805)])
    assert flight_time(log) == 0
}

test "eval postfix" {
    assert eval_postfix(Vec.from([Token.Num(3.0), Token.Num(4.0), Token.Plus])) == 7.0
    assert eval_postfix(Vec.from([
        Token.Num(2.0), Token.Num(3.0), Token.Times, Token.Num(1.0), Token.Plus
    ])) == 7.0
    assert eval_postfix(Vec.from([
        Token.Num(10.0), Token.Num(2.0), Token.Divide, Token.Num(1.0), Token.Minus
    ])) == 4.0
}

test "airport IFR landing" {
    assert can_land_ifr(AirportStatus.Open) == true
    assert can_land_ifr(AirportStatus.Closed(reason: "snow")) == false
    assert can_land_ifr(AirportStatus.Restricted(ceiling_ft: 300, visibility_sm: 1.0)) == true
    assert can_land_ifr(AirportStatus.Restricted(ceiling_ft: 100, visibility_sm: 0.3)) == false
}

test "airport VFR landing" {
    assert can_land_vfr(AirportStatus.Open) == true
    assert can_land_vfr(AirportStatus.Closed(reason: "snow")) == false
    assert can_land_vfr(AirportStatus.Restricted(ceiling_ft: 1500, visibility_sm: 5.0)) == true
    assert can_land_vfr(AirportStatus.Restricted(ceiling_ft: 800, visibility_sm: 2.0)) == false
}

func main() { println("All solutions for lesson 13") }
