// Solution: Lesson 17

enum BookingError { Msg(string) }
extend BookingError {
    func message(self) -> string {
        match self {
            BookingError.Msg(m) => return m,
        }
    }
}

struct Booking {
    id: i32
    committed: bool
}

extend Booking {
    func new(id: i32) -> Booking {
        return Booking { id: id, committed: false }
    }

    func commit(mutate self) {
        self.committed = true
    }

    func is_committed(self) -> bool {
        return self.committed
    }
}

func book_flight(id: i32, passenger: string) -> i32 or BookingError {
    mut booking = Booking.new(id)

    if passenger == "FAIL" {
        return BookingError.Msg("payment failed")
    }

    booking.commit()
    return booking.id
}

struct BookingStatus {
    first_committed: bool
    second_committed: bool
}

func two_bookings() -> BookingStatus {
    mut b1 = Booking.new(1)
    b1.commit()

    mut b2 = Booking.new(2)

    return BookingStatus {
        first_committed: b1.is_committed(),
        second_committed: b2.is_committed(),
    }
}

func process_flights(flights: Vec<string>) -> i32 or BookingError {
    return flights.len().to<i32>()!
}

test "booking commit" {
    let result = book_flight(1, "Besse")
    // `?` asks whether a value is present; a result's other branch is an
    // error, so the question is `is` (ER12).
    assert !(result is BookingError)
}

test "booking failure" {
    let result = book_flight(2, "FAIL")
    assert result is BookingError
}

test "booking pattern" {
    mut b = Booking.new(42)
    assert b.is_committed() == false
    b.commit()
    assert b.is_committed() == true
}

test "two bookings" {
    let status = two_bookings()
    assert status.first_committed == true
    assert status.second_committed == false
}

func main() { println("All solutions for lesson 17") }
