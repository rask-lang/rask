// Solution: Lesson 15
import async.spawn

func vec_max(v: Vec<f64>) -> f64 {
    mut m = v[0]
    for i in 1..v.len() {
        if v[i] > m { m = v[i] }
    }
    return m
}

func parallel_max(readings: Vec<f64>) -> f64 or Error {
    using Multitasking {
        let mid = readings.len() / 2
        let first_half = readings[0..mid].to_vec()
        let second_half = readings[mid..readings.len()].to_vec()

        let h1 = spawn(|| {
            return vec_max(first_half)
        })
        let h2 = spawn(|| {
            return vec_max(second_half)
        })

        let m1 = try h1.join()
        let m2 = try h2.join()

        if m1 > m2 { return m1 }
        return m2
    }
}

func channel_sum(n: i32) -> i32 or Error {
    using Multitasking {
        mut (tx, rx) = Channel<i32>.buffered(n)

        let producer = spawn(|| {
            for i in 1..(n + 1) {
                tx.send(i)
            }
            tx.close()
        })

        mut sum = 0
        for value in rx {
            sum = sum + value
        }

        try producer.join()
        return sum
    }
}

func estimate_pi(total: i32, num_tasks: i32) -> f64 {
    using Multitasking {
        let per_task = total / num_tasks
        mut (tx, rx) = Channel<i32>.buffered(num_tasks)

        for task_id in 0..num_tasks {
            let seed = task_id * 1000 + 42
            let iters = per_task
            spawn(|| {
                mut state = seed
                mut inside = 0
                let a = 1103515245
                let c = 12345
                let m = 2147483648

                for i in 0..iters {
                    state = (a * state + c) % m
                    let x = state as f64 / m as f64
                    state = (a * state + c) % m
                    let y = state as f64 / m as f64
                    if x * x + y * y <= 1.0 {
                        inside = inside + 1
                    }
                }
                tx.send(inside)
            }).detach()
        }

        mut total_inside = 0
        for i in 0..num_tasks {
            total_inside = total_inside + rx.receive()
        }

        return 4.0 * total_inside as f64 / total as f64
    }
}

test "parallel max" {
    let readings = Vec.from([
        31000.0, 33000.0, 35000.0, 34000.0,
        36000.0, 32000.0, 37000.0, 34500.0,
    ])
    assert parallel_max(readings)! == 37000.0
}

test "channel sum" {
    assert channel_sum(10)! == 55
    assert channel_sum(100)! == 5050
}

test "monte carlo pi" {
    let pi = estimate_pi(100000, 4)
    assert pi > 2.9
    assert pi < 3.5
}

func main() { println("All solutions for lesson 15") }
