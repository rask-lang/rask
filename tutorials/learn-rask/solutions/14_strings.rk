// Solution: Lesson 14

struct Wind { direction: i32, speed: i32 }

func parse_wind(metar: string) -> Wind {
    // A slice is a view into `metar`, not a copy, and a view can't outlive the
    // statement it's made in. `.to_string()` takes an independent copy — the
    // cheaper `metar[0..3].view()` works too, bound as a `StringView`.
    let dir_str = metar[0..3].to_string()
    let spd_str = metar[3..5].to_string()
    return Wind {
        direction: dir_str.parse<i32>()!,
        speed: spd_str.parse<i32>()!,
    }
}

func format_flight_plan(departure: string, arrival: string, waypoints: Vec<string>) -> string {
    mut result = departure
    for wp in waypoints {
        result = "{result} → {wp}"
    }
    result = "{result} → {arrival}"
    return result
}

func word_count(text: string) -> i32 {
    if text.len() == 0 { return 0 }
    // Counting them doesn't need to keep them, so nothing is stored and no
    // view outlives its statement.
    mut count = 0
    for word in text.split_whitespace() {
        count = count + 1
    }
    return count
}

func callsign_prefix(callsign: string) -> string {
    mut end = 0
    for c in callsign.chars() {
        if c >= 'A' && c <= 'Z' {
            end = end + 1
        } else {
            break
        }
    }
    return callsign[0..end].to_string()
}

func parse_csv(input: string) -> Vec<Vec<string>> {
    mut rows = Vec.new()
    // `split` hands back views into `input`, so anything kept has to be copied
    // out. Iterating them directly is fine; storing them is what needs the copy.
    for line in input.split("\n") {
        mut fields: Vec<string> = Vec.new()
        for field in line.split(",") {
            fields.push(field.to_string())
        }
        rows.push(fields)
    }
    return rows
}

test "parse wind" {
    let w = parse_wind("27015KT")
    assert w.direction == 270
    assert w.speed == 15
    let w2 = parse_wind("09008KT")
    assert w2.direction == 90
    assert w2.speed == 8
}

test "format flight plan" {
    let plan = format_flight_plan("ENGM", "EGLL", Vec.from(["CEDAR", "MAPLE", "BIRCH"]))
    assert plan == "ENGM → CEDAR → MAPLE → BIRCH → EGLL"
}

test "format flight plan no waypoints" {
    let plan = format_flight_plan("ENGM", "ESSA", Vec.new())
    assert plan == "ENGM → ESSA"
}

test "word count" {
    assert word_count("cleared for takeoff runway two seven left") == 7
    assert word_count("roger") == 1
    assert word_count("") == 0
}

test "callsign prefix" {
    assert callsign_prefix("SAS937") == "SAS"
    assert callsign_prefix("BAW123") == "BAW"
    assert callsign_prefix("N12345") == "N"
}

test "parse csv" {
    mut rows = parse_csv("a,b,c\n1,2,3")
    assert rows.len() == 2
    assert rows[0].len() == 3
    assert rows[0][0] == "a"
    assert rows[1][2] == "3"
}

func main() { println("All solutions for lesson 14") }
