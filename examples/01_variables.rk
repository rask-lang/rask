// Learn: Variables and basic types

func main() {
    // let - binding won't be reassigned
    let name = "Alice"
    let age = 30
    let height = 1.75

    print("Name: ")
    print(name)
    print("\n")

    print("Age: ")
    print(age)
    print("\n")

    // mut - binding can be reassigned
    mut counter = 0
    counter = counter + 1
    counter = counter + 1

    print("Counter: ")
    print(counter)
    print("\n")
}
