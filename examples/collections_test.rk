// Collections test - Vec, struct literals, match expressions
// Step 9 validation

struct Point {
    x: i32
    y: i32
}

func main() {
    // Vec basics
    mut v = Vec.new()
    v.push(10)
    v.push(20)
    v.push(30)
    let vlen = v.len()
    println("Vec length: {vlen}")
    let v0 = v.get(0)!
    let v1 = v.get(1)!
    let v2 = v.get(2)!
    println("v[0] = {v0}")
    println("v[1] = {v1}")
    println("v[2] = {v2}")

    // Vec iteration
    println("Iterating:")
    for item in v {
        println("  item: {item}")
    }

    // Array literal
    let arr = [1, 2, 3, 4, 5]
    let arrlen = arr.len()
    println("Array length: {arrlen}")

    // Struct instantiation
    let p = Point { x: 100, y: 200 }
    let px = p.x
    let py = p.y
    println("Point: x={px}, y={py}")

    // Match on integers
    let num = 2
    let result = match num {
        1 => "one"
        2 => "two"
        3 => "three"
        _ => "other"
    }
    println("match result: {result}")

    println("Collections test passed!")
}
