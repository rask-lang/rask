// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Package Manager — Stress Test Application
//
// Implements a subset of `rask fetch`: manifest parsing, semver resolution,
// dependency graph construction, lock file generation, and parallel package
// fetching from a local or HTTP registry.
//
// Demonstrates: Pool<T>/Handle<T> for dependency graphs, trait-based registry
// dispatch with implicit `any Trait` coercion, concurrent fetching with
// spawn/channels/Shared, ensure cleanup, closures in sort/join,
// enum-based CLI dispatch, try/else error context, pattern matching at scale.

import fs
import cli
import std
import http
import json
import async.Channel

// ─── Semver ─────────────────────────────────────────────────────────

struct Version {
    major: i64
    minor: i64
    patch: i64
}

extend Version {
    func parse(s: string) -> Version or VersionError {
        let parts = s.split(".").collect()
        if parts.len() != 3 {
            return VersionError.InvalidFormat("expected MAJOR.MINOR.PATCH, got: {s}")
        }

        let major = parts[0].trim().parse_int() is i64 as v else {
            return VersionError.InvalidFormat("bad major version in: {s}")
        }
        let minor = parts[1].trim().parse_int() is i64 as v else {
            return VersionError.InvalidFormat("bad minor version in: {s}")
        }
        let patch = parts[2].trim().parse_int() is i64 as v else {
            return VersionError.InvalidFormat("bad patch version in: {s}")
        }

        return Version {
            major: major,
            minor: minor,
            patch: patch,
        }
    }

    func to_string(self) -> string {
        return "{self.major}.{self.minor}.{self.patch}"
    }
}

// ─── Version Constraints ────────────────────────────────────────────

enum Constraint {
    Compatible(Version)     // ^1.2.3 → >=1.2.3, <2.0.0
    Tilde(Version)          // ~1.2.3 → >=1.2.3, <1.3.0
    Exact(Version)          // =1.2.3
    Minimum(Version)        // >=1.2.3
}

extend Constraint {
    func parse(s: string) -> Constraint or VersionError {
        let trimmed = s.trim().to_string()

        if trimmed.starts_with("^") {
            let ver = try Version.parse(trimmed[1..].to_string())
            return Constraint.Compatible(ver)
        }
        if trimmed.starts_with("~") {
            let ver = try Version.parse(trimmed[1..].to_string())
            return Constraint.Tilde(ver)
        }
        if trimmed.starts_with(">=") {
            let ver = try Version.parse(trimmed[2..].to_string())
            return Constraint.Minimum(ver)
        }
        if trimmed.starts_with("=") {
            let ver = try Version.parse(trimmed[1..].to_string())
            return Constraint.Exact(ver)
        }

        // Bare version string treated as compatible
        let ver = try Version.parse(trimmed.to_string())
        return Constraint.Compatible(ver)
    }

    func satisfies(self, v: Version) -> bool {
        match self {
            Compatible(min) => {
                // ^1.2.3 → >=1.2.3, <2.0.0
                if v < min { return false }
                let next_major = Version {
                    major: min.major + 1,
                    minor: 0,
                    patch: 0,
                }
                return v < next_major
            }
            Tilde(min) => {
                // ~1.2.3 → >=1.2.3, <1.3.0
                if v < min { return false }
                let next_minor = Version {
                    major: min.major,
                    minor: min.minor + 1,
                    patch: 0,
                }
                return v < next_minor
            }
            Exact(target) => {
                return v == target
            }
            Minimum(min) => {
                return v >= min
            }
        }
    }

    func to_string(self) -> string {
        match self {
            Compatible(v) => return "^{v.to_string()}",
            Tilde(v) => return "~{v.to_string()}",
            Exact(v) => return "={v.to_string()}",
            Minimum(v) => return ">={v.to_string()}",
        }
    }
}

// ─── Error Types ────────────────────────────────────────────────────
//
// Five error types, one per layer. FetchError auto-delegates to inner
// errors. When @message lands in the compiler these collapse further.

enum VersionError {
    InvalidFormat(string)
}

extend VersionError {
    func message(self) -> string {
        match self {
            InvalidFormat(msg) => return "invalid version: {msg}",
        }
    }
}

enum ManifestError {
    ParseError(i32, string)
    MissingField(string)
    InvalidConstraint(string)
}

extend ManifestError {
    func message(self) -> string {
        match self {
            ParseError(line, msg) => return "manifest line {line}: {msg}",
            MissingField(field) => return "missing required field: {field}",
            InvalidConstraint(msg) => return "bad constraint: {msg}",
        }
    }
}

enum RegistryError {
    PackageNotFound(string)
    NetworkError(string)
    ChecksumMismatch(string, string, string)
    IoError(string)
}

extend RegistryError {
    func message(self) -> string {
        match self {
            PackageNotFound(name) => return "package not found: {name}",
            NetworkError(msg) => return "network error: {msg}",
            ChecksumMismatch(pkg, expected, got) => {
                return "checksum mismatch for {pkg}: expected {expected}, got {got}"
            }
            IoError(msg) => return "I/O error: {msg}",
        }
    }
}

enum ResolveError {
    Conflict(string, string, string)
    Cycle(string)
    NoMatch(string, string)
}

extend ResolveError {
    func message(self) -> string {
        match self {
            Conflict(pkg, a, b) => return "version conflict for {pkg}: {a} vs {b}",
            Cycle(chain) => return "dependency cycle: {chain}",
            NoMatch(pkg, constraint) => return "no version of {pkg} satisfies {constraint}",
        }
    }
}

enum IoErrorMsg { Msg(string) }
extend IoErrorMsg {
    func message(self) -> string {
        match self {
            IoErrorMsg.Msg(m) => return m,
        }
    }
}

enum FetchError {
    Manifest(ManifestError)
    Version(VersionError)
    Registry(RegistryError)
    Resolve(ResolveError)
    Io(IoErrorMsg)
}

extend FetchError {
    func message(self) -> string {
        match self {
            Manifest(e) => return e.message(),
            Version(e) => return e.message(),
            Registry(e) => return e.message(),
            Resolve(e) => return e.message(),
            Io(e) => return "I/O error: {e.message()}",
        }
    }
}

// ─── Package Types ──────────────────────────────────────────────────

struct Dependency {
    name: string
    constraint: Constraint
}

struct Manifest {
    name: string
    version: Version
    deps: Vec<Dependency>
}

struct PackageMeta {
    name: string
    version: Version
    checksum: string
    deps: Vec<Dependency>
}

struct ResolvedPkg {
    meta: PackageMeta
    deps: Vec<Handle<ResolvedPkg>>
}

struct DepGraph {
    packages: Pool<ResolvedPkg>
    root: Handle<ResolvedPkg>
    by_name: Map<string, Handle<ResolvedPkg>>
}

// ─── Lock File Types ────────────────────────────────────────────────

struct LockedPackage {
    name: string
    version: string
    checksum: string
}

// ─── Manifest Parser ────────────────────────────────────────────────
//
// Parses simplified build.rk format:
//   package "name" "version" {
//       dep "http" "^2.0"
//       dep "json" "^1.5"
//   }

func load_manifest(path: string) -> Manifest or FetchError {
    let content = fs.read_text(path) catch e => return FetchError.Io(IoErrorMsg.Msg("cannot read {path}: {e.message()}"))
    return parse_manifest(content) catch e => return FetchError.Manifest(e)
}

func parse_manifest(content: string) -> Manifest or ManifestError {
    let lines = content.lines().collect()
    mut name = ""
    mut version_str = ""
    mut deps = Vec.new()
    mut in_block = false
    mut line_num = 0

    for line in lines {
        line_num += 1
        let trimmed = line.trim().to_string()

        // Skip empty lines and comments
        if trimmed.is_empty() { continue }
        if trimmed.starts_with("//") { continue }

        if trimmed.starts_with("package") {
            // Parse: package "name" "version" {
            let (parsed_name, parsed_ver) = try parse_package_line(trimmed, line_num)
            name = parsed_name
            version_str = parsed_ver
            in_block = true
            continue
        }

        if trimmed == "}" {
            in_block = false
            continue
        }

        if in_block && trimmed.starts_with("dep ") {
            let dep = try parse_dep_line(trimmed, line_num)
            deps.push(dep)
            continue
        }

        if in_block {
            // Unknown directive inside package block — skip for now
            continue
        }
    }

    if name.is_empty() {
        return ManifestError.MissingField("package name")
    }

    let version = Version.parse(version_str) is Version as v else {
        return ManifestError.InvalidConstraint("bad package version: {version_str}")
    }

    return Manifest { name: name, version: version, deps: deps }
}

// Extract the nth quoted string from a line, or error.
func extract_nth_quoted(line: string, n: i32, line_num: i32, label: string) -> string or ManifestError {
    mut pos = 0
    mut found = 0
    while found <= n {
        let open = line[pos..].find("\"") ?? return ManifestError.ParseError(line_num, "expected quoted {label}")
        let start = pos + open + 1
        let close = line[start..].find("\"") ?? return ManifestError.ParseError(line_num, "unterminated {label}")
        if found == n {
            return line[start..start + close].to_string()
        }
        pos = start + close + 1
        found += 1
    }
    return ManifestError.ParseError(line_num, "expected quoted {label}")
}

// Extract name and version from: package "name" "version" {
func parse_package_line(line: string, line_num: i32) -> (string, string) or ManifestError {
    let name = try extract_nth_quoted(line, 0, line_num, "package name")
    let version = try extract_nth_quoted(line, 1, line_num, "version")
    return (name, version)
}

// Extract dependency from: dep "name" "constraint"
func parse_dep_line(line: string, line_num: i32) -> Dependency or ManifestError {
    let name = try extract_nth_quoted(line, 0, line_num, "dep name")
    let constraint_str = try extract_nth_quoted(line, 1, line_num, "constraint")
    let constraint = Constraint.parse(constraint_str) is Constraint as c else {
        return ManifestError.InvalidConstraint(constraint_str)
    }
    return Dependency { name: name, constraint: constraint }
}

// ─── Registry ───────────────────────────────────────────────────────
//
// Trait-based dispatch with implicit coercion (TR5). Functions accept
// `any Registry`; concrete types coerce automatically at call sites.

trait Registry {
    func available(self, name: string) -> Vec<PackageMeta> or RegistryError
    func fetch_package(self, name: string, version: Version) -> string or RegistryError
}

// ─── Local Registry ─────────────────────────────────────────────────
//
// Layout:
//   root/<pkg>/index.json   → ["1.0.0", "1.1.0"]
//   root/<pkg>/1.0.0/meta.json

struct LocalRegistry {
    root: string
}

extend LocalRegistry with Registry {
    func available(self, name: string) -> Vec<PackageMeta> or RegistryError {
        return local_available(self.root, name)
    }

    func fetch_package(self, name: string, version: Version) -> string or RegistryError {
        return local_fetch(self.root, name, version)
    }
}

func local_available(root: string, name: string) -> Vec<PackageMeta> or RegistryError {
    // Read index file listing available versions
    let index_path = "{root}/{name}/index.json"
    let index_content = fs.read_text(index_path) is string as c else {
        return RegistryError.PackageNotFound(name)
    }

    let parsed = json.parse(index_content) is JsonValue as v else {
        return RegistryError.IoError("invalid JSON in {index_path}")
    }
    let version_list = parsed.as_array() ?? return RegistryError.IoError("expected array in {index_path}")

    mut versions = Vec.new()
    for entry in version_list {
        let ver_str = entry.as_string() ?? continue
        let meta_path = "{root}/{name}/{ver_str}/meta.json"
        let meta = load_package_meta(meta_path) is PackageMeta as m else { continue }
        versions.push(meta)
    }

    if versions.is_empty() {
        return RegistryError.PackageNotFound(name)
    }
    return versions
}

func local_fetch(root: string, name: string, version: Version) -> string or RegistryError {
    let ver_str = version.to_string()
    let pkg_path = "{root}/{name}/{ver_str}"
    if !fs.exists(pkg_path) {
        return RegistryError.PackageNotFound("{name}@{ver_str}")
    }
    return pkg_path
}

// ─── Package Meta Loader ────────────────────────────────────────────

func load_package_meta(path: string) -> PackageMeta or RegistryError {
    let content = fs.read_text(path) is string as c else {
        return RegistryError.IoError("cannot read {path}")
    }
    let parsed = json.parse(content) is JsonValue as v else {
        return RegistryError.IoError("invalid JSON in {path}")
    }
    return parse_meta_from_json(parsed, path)
}

// Pull a string field out of a JSON object map. none if missing or not a string.
func json_str_field(m: Map<string, JsonValue>, key: string) -> string? {
    if m.get(key)? as v {
        return v.as_string()
    }
    return none
}

// Pull an array field out of a JSON object map. none if missing or not an array.
func json_arr_field(m: Map<string, JsonValue>, key: string) -> Vec<JsonValue>? {
    if m.get(key)? as v {
        return v.as_array()
    }
    return none
}

// Shared JSON→PackageMeta extraction — used by both local and HTTP registries.
// Takes the parsed JSON object value, avoiding type duplication.
func parse_meta_from_json(obj: JsonValue, source: string) -> PackageMeta or RegistryError {
    let m = obj.as_object() ?? return RegistryError.IoError("expected object in {source}")

    let name = json_str_field(m, "name") ?? return RegistryError.IoError("missing 'name' in {source}")
    let ver_str = json_str_field(m, "version") ?? return RegistryError.IoError("missing 'version' in {source}")
    let checksum = json_str_field(m, "checksum") ?? ""
    let version = Version.parse(ver_str) is Version as v else {
        return RegistryError.IoError("bad version in {source}: {ver_str}")
    }

    mut deps = Vec.new()
    if json_arr_field(m, "deps")? as dep_arr {
        for d_val in dep_arr {
            let d_obj = d_val.as_object() ?? continue
            let dn = json_str_field(d_obj, "name") ?? ""
            let dc = json_str_field(d_obj, "constraint") ?? ""
            if dn.is_empty() || dc.is_empty() { continue }
            let constraint = Constraint.parse(dc) is Constraint as c else { continue }
            deps.push(Dependency { name: dn, constraint: constraint })
        }
    }

    return PackageMeta {
        name: name,
        version: version,
        checksum: checksum,
        deps: deps,
    }
}

// ─── HTTP Registry ──────────────────────────────────────────────────

struct HttpRegistry {
    base_url: string
}

extend HttpRegistry with Registry {
    func available(self, name: string) -> Vec<PackageMeta> or RegistryError {
        return http_available(self.base_url, name)
    }

    func fetch_package(self, name: string, version: Version) -> string or RegistryError {
        return http_fetch(self.base_url, name, version)
    }
}

func http_available(base_url: string, name: string) -> Vec<PackageMeta> or RegistryError {
    let url = "{base_url}/packages/{name}"
    let resp = http.get(url) is Response as r else {
        return RegistryError.NetworkError("failed to fetch {url}")
    }

    if resp.status == 404 {
        return RegistryError.PackageNotFound(name)
    }
    if !resp.is_ok() {
        return RegistryError.NetworkError("registry returned {resp.status} for {name}")
    }

    let parsed = json.parse(resp.body) is JsonValue as v else {
        return RegistryError.NetworkError("invalid JSON from registry for {name}")
    }
    let arr = parsed.as_array() ?? return RegistryError.NetworkError("expected array from registry for {name}")

    mut versions = Vec.new()
    for entry in arr {
        let meta = parse_meta_from_json(entry, name) is PackageMeta as m else { continue }
        versions.push(meta)
    }

    if versions.is_empty() {
        return RegistryError.PackageNotFound(name)
    }
    return versions
}

func http_fetch(base_url: string, name: string, version: Version) -> string or RegistryError {
    let ver_str = version.to_string()
    let url = "{base_url}/packages/{name}/{ver_str}/download"
    let resp = http.get(url) is Response as r else {
        return RegistryError.NetworkError("failed to download {name}@{ver_str}")
    }

    if !resp.is_ok() {
        return RegistryError.NetworkError("download failed: {resp.status} for {name}@{ver_str}")
    }

    // Write to cache
    let cache_dir = "/tmp/rask-cache/{name}-{ver_str}"
    fs.create_dir_all(cache_dir)
    fs.write_text("{cache_dir}/package.tar", resp.body)
    return cache_dir
}

// ─── Dependency Resolver ────────────────────────────────────────────
//
// Greedy resolver: for each dependency, pick the newest version that
// satisfies the constraint. Detect conflicts when two constraints
// for the same package are incompatible. Detect cycles via a visited set.

// Bundle resolver working state: pool, name→handle map, and cycle-detection stack.
struct ResolveState {
    packages: Pool<ResolvedPkg>
    by_name: Map<string, Handle<ResolvedPkg>>
    visiting: Vec<string>
}

func resolve(manifest: Manifest, registry: any Registry) -> DepGraph or FetchError {
    mut state = ResolveState {
        packages: Pool.new(),
        by_name: Map.new(),
        visiting: Vec.new(),
    }

    // Insert root package
    let root_meta = PackageMeta {
        name: manifest.name,
        version: manifest.version,
        checksum: "",
        deps: Vec.new(),
    }
    let root = state.packages.insert(ResolvedPkg {
        meta: root_meta,
        deps: Vec.new(),
    })

    // Resolve each dependency
    for dep in manifest.deps {
        let handle = try resolve_one(dep.name, dep.constraint, registry, mutate state)
        with state.packages[root] as root_pkg {
            root_pkg.deps.push(handle)
        }
    }

    return DepGraph {
        packages: state.packages,
        root: root,
        by_name: state.by_name,
    }
}

func resolve_one(
    name: string,
    constraint: Constraint,
    registry: any Registry,
    mutate state: ResolveState,
) -> Handle<ResolvedPkg> or FetchError {
    // Check for circular dependency
    for v in state.visiting {
        if v == name {
            let chain = format_cycle(state.visiting, name)
            return FetchError.Resolve(ResolveError.Cycle(chain))
        }
    }

    // Already resolved? Check compatibility.
    if state.by_name.contains_key(name) {
        let existing_handle = state.by_name.get(name) ?? return FetchError.Io(IoErrorMsg.Msg("impossible: key exists but get failed"))
        let existing_handle = existing_handle.clone()

        with state.packages[existing_handle] as existing {
            if constraint.satisfies(existing.meta.version) {
                return existing_handle
            }
            let con_str = constraint.to_string()
            let ver_str = existing.meta.version.to_string()
            return FetchError.Resolve(ResolveError.Conflict(
                name,
                ver_str,
                con_str,
            ))
        }
    }

    // Query registry for available versions
    let versions = registry.available(name)
        catch e => return FetchError.Registry(e)

    // Filter to satisfying versions, pick newest via sort_by
    let want = constraint.clone()
    mut candidates = versions.filter(own |m| want.satisfies(m.version.clone()))
    candidates.sort_by(|a, b| b.version.compare(a.version))

    let meta = candidates.first() ?? return FetchError.Resolve(ResolveError.NoMatch(name, constraint.to_string()))

    let handle = state.packages.insert(ResolvedPkg {
        meta: PackageMeta {
            name: meta.name,
            version: meta.version,
            checksum: meta.checksum,
            deps: Vec.new(),
        },
        deps: Vec.new(),
    })

    state.by_name.insert(name, handle)

    // Recursively resolve transitive deps
    state.visiting.push(name)
    for dep in meta.deps {
        let dep_handle = try resolve_one(dep.name, dep.constraint, registry, mutate state)
        with state.packages[handle] as pkg {
            pkg.deps.push(dep_handle)
        }
    }
    state.visiting.pop()

    return handle
}

func format_cycle(chain: Vec<string>, name: string) -> string {
    mut parts = chain.clone()
    parts.push(name)
    return parts.join(" -> ")
}

// ─── Fetch Packages ─────────────────────────────────────────────────
//
// Concurrent fetch: collect work items, spawn tasks to download in
// parallel, collect results via channel. Mutex protects the fetch counter.

struct FetchItem {
    name: string
    version: Version
    checksum: string
    cache_path: string
}

func collect_fetch_items(graph: DepGraph, cache_dir: string) -> Vec<FetchItem> {
    mut items = Vec.new()
    let handles = graph.packages.handles()
    for handle in handles {
        with graph.packages[handle] as pkg {
            if pkg.meta.checksum.is_empty() { continue }
            let name = pkg.meta.name
            let ver_str = pkg.meta.version.to_string()
            let cache_path = "{cache_dir}/{name}-{ver_str}"

            if fs.exists(cache_path) {
                println("  cached  {name}@{ver_str}")
                continue
            }

            items.push(FetchItem {
                name: name,
                version: pkg.meta.version,
                checksum: pkg.meta.checksum,
                cache_path: cache_path,
            })
        }
    }
    return items
}

func verify_checksum(data: string, expected: string, pkg_name: string) -> void or RegistryError {
    if expected.is_empty() { return () }
    // Simple hash: sum all bytes mod 2^32 (real impl would SHA-256)
    mut hash: i64 = 0
    for ch in data.chars() {
        hash = (hash * 31 + (ch as u32) as i64) % 4294967296
    }
    let got = "{hash}"
    if got != expected {
        return RegistryError.ChecksumMismatch(pkg_name, expected, got)
    }
    return ()
}

// Task outcome carried over the result channel. Channels carry a plain value,
// not a `T or E` — so success and failure travel as one enum.
enum FetchResult {
    Done(string)
    Failed(FetchError)
}

func fetch_packages(
    graph: DepGraph,
    registry: any Registry,
    cache_dir: string,
) -> void or FetchError {
    fs.create_dir_all(cache_dir)

    let items = collect_fetch_items(graph, cache_dir)
    if items.is_empty() {
        println("All packages cached")
        return ()
    }

    println("Fetching {items.len()} packages...")

    // Concurrent fetch: spawn a task per package, collect results via channel.
    // Mutex<i32> tracks fetch count across tasks (conc.sync/MX1).
    using Multitasking {
        mut (tx, rx) = Channel.buffered(items.len())
        let counter = Mutex.new(0)

        for item in items {
            let item_tx = tx.clone()
            let item_counter = counter.clone()
            spawn(own || {
                if fetch_one(item, registry) is string as path {
                    with item_counter.lock() as c { c += 1 }
                    let _ = item_tx.send(FetchResult.Done(path))
                } else as e {
                    let _ = item_tx.send(FetchResult.Failed(e))
                }
            }).detach()
        }

        // Collect results — first error is fatal
        mut first_error: FetchError? = none
        mut received = 0
        while received < items.len() {
            if rx.receive()? as result {
                if result is FetchResult.Done(msg) {
                    println("  {msg}")
                } else if result is FetchResult.Failed(e) {
                    if first_error is none {
                        first_error = e
                    }
                }
            }
            received += 1
        }

        if first_error? as e {
            return e
        }

        let fetched = with counter.lock() as c { c }
        println("Fetched {fetched} packages")
    }

    return ()
}

func fetch_one(item: FetchItem, registry: any Registry) -> string or FetchError {
    let pkg_path = registry.fetch_package(item.name, item.version)
        catch e => return FetchError.Registry(e)

    // Verify checksum if present
    if !item.checksum.is_empty() {
        let content = fs.read_text("{pkg_path}/meta.json") is string as c else {
            return "fetch   {item.name}@{item.version.to_string()}"
        }
        verify_checksum(content, item.checksum, item.name)
            catch e => return FetchError.Registry(e)
    }

    return "fetch   {item.name}@{item.version.to_string()}"
}

// ─── Lock File ──────────────────────────────────────────────────────
//
// Format:
//   lockfile-version = 1
//
//   [[package]]
//   name = "http"
//   version = "2.1.0"
//   checksum = "sha256:a1b2..."

func write_lockfile(graph: DepGraph, path: string) -> void or FetchError {
    // Write to temp file, rename on success. ensure cleans up on error.
    let tmp_path = "{path}.tmp"

    mut tmp_file = fs.create(tmp_path)
        catch e => return FetchError.Io(IoErrorMsg.Msg("cannot create temp lock file: {e.message()}"))
    ensure fs.remove(tmp_path)

    mut out = StringBuilder.new()
    out.push("lockfile-version = 1\n\n")

    let order = topo_sort(graph)

    for handle in order {
        with graph.packages[handle] as pkg {
            if pkg.meta.checksum.is_empty() { continue }

            out.push("[[package]]\n")
            out.push("name = \"{pkg.meta.name}\"\n")
            let ver_str = pkg.meta.version.to_string()
            out.push("version = \"{ver_str}\"\n")
            out.push("checksum = \"{pkg.meta.checksum}\"\n")

            if !pkg.deps.is_empty() {
                mut dep_names = Vec.new()
                for dep_handle in pkg.deps {
                    with graph.packages[dep_handle] as dep_pkg {
                        dep_names.push("\"{dep_pkg.meta.name}\"")
                    }
                }
                out.push("deps = [")
                out.push(dep_names.join(", "))
                out.push("]\n")
            }

            out.push("\n")
        }
    }

    tmp_file.write(out.build())
        catch e => return FetchError.Io(IoErrorMsg.Msg("cannot write lock file: {e.message()}"))
    tmp_file.close()

    // Atomic rename: success path — cancels ensure (EN6)
    fs.rename(tmp_path, path)
        catch e => return FetchError.Io(IoErrorMsg.Msg("cannot rename lock file: {e.message()}"))

    return ()
}

func read_lockfile(path: string) -> Map<string, LockedPackage> or FetchError {
    mut packages = Map.new()

    let content = fs.read_text(path) is string as c else {
        // No lock file yet — that's fine
        return packages
    }

    mut current_name = ""
    mut current_version = ""
    mut current_checksum = ""

    for line in content.lines() {
        let trimmed = line.trim().to_string()

        if trimmed == "[[package]]" {
            // Flush previous
            if !current_name.is_empty() {
                packages.insert(current_name, LockedPackage {
                    name: current_name,
                    version: current_version,
                    checksum: current_checksum,
                })
            }
            current_name = ""
            current_version = ""
            current_checksum = ""
            continue
        }

        if trimmed.starts_with("name = ") {
            current_name = extract_quoted_value(trimmed)
            continue
        }
        if trimmed.starts_with("version = ") {
            current_version = extract_quoted_value(trimmed)
            continue
        }
        if trimmed.starts_with("checksum = ") {
            current_checksum = extract_quoted_value(trimmed)
            continue
        }
    }

    // Flush last
    if !current_name.is_empty() {
        packages.insert(current_name, LockedPackage {
            name: current_name,
            version: current_version,
            checksum: current_checksum,
        })
    }

    return packages
}

func extract_quoted_value(line: string) -> string {
    let first = line.find("\"") ?? return ""
    let rest = first + 1
    let second = line[rest..].find("\"") ?? return ""
    return line[rest..rest + second].to_string()
}

// ─── Topological Sort ───────────────────────────────────────────────
//
// Post-order DFS: deps appear before their dependents.
// Uses name→bool map instead of handle casting — package names are
// unique in the dependency graph.

func topo_sort(graph: DepGraph) -> Vec<Handle<ResolvedPkg>> {
    mut visited = Map.new()
    mut order = Vec.new()

    topo_visit(graph, graph.root, mutate visited, mutate order)

    return order
}

func topo_visit(
    graph: DepGraph,
    handle: Handle<ResolvedPkg>,
    mutate visited: Map<string, bool>,
    mutate order: Vec<Handle<ResolvedPkg>>,
) {
    let name = graph.packages[handle].meta.name
    if visited.contains_key(name) { return }
    visited.insert(name, true)

    with graph.packages[handle] as pkg {
        for dep_handle in pkg.deps {
            topo_visit(graph, dep_handle, mutate visited, mutate order)
        }
    }

    order.push(handle)
}

// ─── Display ────────────────────────────────────────────────────────

func print_dep_graph(graph: DepGraph) {
    println("Dependency graph:")
    print_node(graph, graph.root, 0)
}

func print_node(graph: DepGraph, handle: Handle<ResolvedPkg>, depth: usize) {
    let indent = "  ".repeat(depth)

    with graph.packages[handle] as pkg {
        let ver = pkg.meta.version.to_string()
        if depth == 0 {
            println("{indent}{pkg.meta.name}@{ver} (root)")
        } else {
            println("{indent}{pkg.meta.name}@{ver}")
        }

        for child in pkg.deps {
            print_node(graph, child, depth + 1)
        }
    }
}

func print_lock_diff(old_lock: Map<string, LockedPackage>, graph: DepGraph) {
    let handles = graph.packages.handles()
    mut added = 0
    mut updated = 0
    mut unchanged = 0

    for handle in handles {
        with graph.packages[handle] as pkg {
            if pkg.meta.checksum.is_empty() { continue }
            let ver = pkg.meta.version.to_string()

            if old_lock.contains_key(pkg.meta.name) {
                let locked = old_lock.get(pkg.meta.name) ?? continue
                if locked.version == ver {
                    unchanged += 1
                } else {
                    println("  updated {pkg.meta.name}: {locked.version} -> {ver}")
                    updated += 1
                }
            } else {
                println("  added   {pkg.meta.name}@{ver}")
                added += 1
            }
        }
    }

    if added == 0 && updated == 0 {
        println("Lock file is up to date ({unchanged} packages)")
    } else {
        println("{added} added, {updated} updated, {unchanged} unchanged")
    }
}

// ─── CLI ────────────────────────────────────────────────────────────

enum RegistryType {
    Local
    Http
}

struct CliArgs {
    command: string
    manifest_path: string
    registry_type: RegistryType
    registry_path: string
    registry_url: string
    cache_dir: string
    lock_path: string
}

func parse_cli_args(args: Vec<string>) -> CliArgs or FetchError {
    mut result = CliArgs {
        command: "",
        manifest_path: "build.rk",
        registry_type: RegistryType.Local,
        registry_path: "./registry",
        registry_url: "http://packages.rask-lang.dev",
        cache_dir: "/tmp/rask-cache",
        lock_path: "rask.lock",
    }

    mut positional = Vec.new()
    mut i = 1  // skip program name

    while i < args.len() {
        let arg = args[i]

        match arg {
            "--registry" => {
                i += 1
                if i < args.len() {
                    match args[i] {
                        "local" => result.registry_type = RegistryType.Local,
                        "http" => result.registry_type = RegistryType.Http,
                        _ => return FetchError.Io(IoErrorMsg.Msg(
                            "unknown registry type: {args[i]} (expected 'local' or 'http')"
                        )),
                    }
                }
            }
            "--registry-path" => {
                i += 1
                if i < args.len() {
                    result.registry_path = args[i].to_string()
                }
            }
            "--registry-url" => {
                i += 1
                if i < args.len() {
                    result.registry_url = args[i].to_string()
                }
            }
            "--cache" => {
                i += 1
                if i < args.len() {
                    result.cache_dir = args[i].to_string()
                }
            }
            "--manifest" => {
                i += 1
                if i < args.len() {
                    result.manifest_path = args[i].to_string()
                }
            }
            "--lock" => {
                i += 1
                if i < args.len() {
                    result.lock_path = args[i].to_string()
                }
            }
            "-h" | "--help" => {
                print_usage()
                std.exit(0)
            }
            _ => positional.push(arg.to_string()),
        }
        i += 1
    }

    if positional.is_empty() {
        return FetchError.Io(IoErrorMsg.Msg("no command specified"))
    }
    result.command = positional[0].to_string()

    return result
}

func print_usage() {
    println("rask-fetch: dependency resolver and package fetcher")
    println("")
    println("Usage: package_manager [OPTIONS] <command>")
    println("")
    println("Commands:")
    println("  resolve     Resolve dependencies and print the graph")
    println("  fetch       Resolve + download packages to cache")
    println("  lock        Generate/update rask.lock")
    println("  check       Verify lock file is in sync with manifest")
    println("")
    println("Options:")
    println("  --manifest PATH       Path to build.rk (default: build.rk)")
    println("  --registry local|http Registry type (default: local)")
    println("  --registry-path PATH  Local registry directory")
    println("  --registry-url URL    HTTP registry base URL")
    println("  --cache PATH          Cache directory (default: /tmp/rask-cache)")
    println("  --lock PATH           Lock file path (default: rask.lock)")
    println("  -h, --help            Show this help")
}

// ─── Main ───────────────────────────────────────────────────────────

func create_registry(args: CliArgs) -> any Registry {
    match args.registry_type {
        Http => return HttpRegistry { base_url: args.registry_url },
        Local => return LocalRegistry { root: args.registry_path },
    }
}

func run(args: CliArgs) -> void or FetchError {
    let registry = create_registry(args)

    println("Loading manifest: {args.manifest_path}")
    let manifest = try load_manifest(args.manifest_path)
    println("Package: {manifest.name}@{manifest.version.to_string()}")
    println("Dependencies: {manifest.deps.len()}")
    println("")

    match args.command {
        "resolve" => {
            println("Resolving dependencies...")
            let graph = try resolve(manifest, registry)
            print_dep_graph(graph)
        }
        "fetch" => {
            println("Resolving dependencies...")
            let graph = try resolve(manifest, registry)
            print_dep_graph(graph)
            println("")
            println("Fetching packages to {args.cache_dir}...")
            try fetch_packages(graph, registry, args.cache_dir)
        }
        "lock" => {
            println("Resolving dependencies...")
            let graph = try resolve(manifest, registry)

            // Check against existing lock
            let old_lock = try read_lockfile(args.lock_path)
            print_lock_diff(old_lock, graph)

            println("Writing lock file: {args.lock_path}")
            try write_lockfile(graph, args.lock_path)
            println("Done.")
        }
        "check" => {
            let old_lock = try read_lockfile(args.lock_path)
            if old_lock.is_empty() {
                println("No lock file found. Run 'lock' first.")
                std.exit(1)
            }

            println("Resolving dependencies...")
            let graph = try resolve(manifest, registry)

            mut drift = false
            let handles = graph.packages.handles()
            for handle in handles {
                with graph.packages[handle] as pkg {
                    if pkg.meta.checksum.is_empty() { continue }
                    let ver = pkg.meta.version.to_string()

                    if old_lock.contains_key(pkg.meta.name) {
                        let locked = old_lock.get(pkg.meta.name) ?? continue
                        if locked.version != ver {
                            println("  DRIFT {pkg.meta.name}: locked={locked.version}, resolved={ver}")
                            drift = true
                        }
                    } else {
                        println("  NEW   {pkg.meta.name}@{ver} (not in lock file)")
                        drift = true
                    }
                }
            }

            if drift {
                println("Lock file is out of date. Run 'lock' to update.")
                std.exit(1)
            } else {
                println("Lock file is up to date.")
            }
        }
        _ => {
            println("Unknown command: {args.command}")
            print_usage()
            std.exit(1)
        }
    }

    return ()
}

func main() {
    let args = cli.args()
    let cli_args = parse_cli_args(args) catch e => {
        println("rask-fetch: {e.message()}")
        print_usage()
        std.exit(1)
    }

    run(cli_args) catch e => {
        println("error: {e.message()}")
        std.exit(1)
    }
}
