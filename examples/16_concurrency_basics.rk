// Learn: Concurrency with threads and channels

import thread.Thread
import thread.ThreadPool

func worker(id: i32, iterations: i32) {
    println("Worker {id} starting")

    mut sum = 0
    for i in 1..iterations + 1 {
        sum = sum + i
    }

    println("Worker {id} done, sum = {sum}")
}

func main() -> void {
    print("=== Basic Threading ===\n\n")

    // Spawn a thread with Thread.spawn(|| {})
    // Returns a ThreadHandle
    let handle = Thread.spawn(|| {
        print("Hello from thread!\n")
    })

    print("Main thread continues...\n")

    // Wait for thread to complete with .join()
    let _ = handle.join()
    print("Thread joined\n\n")

    // Spawn multiple threads
    print("=== Multiple Threads ===\n\n")

    let h1 = Thread.spawn(|| {
        worker(1, 10)
    })
    let h2 = Thread.spawn(|| {
        worker(2, 20)
    })
    let h3 = Thread.spawn(|| {
        worker(3, 15)
    })

    // Wait for all threads
    let _ = h1.join()
    let _ = h2.join()
    let _ = h3.join()

    print("\nAll workers done\n\n")

    // Detaching threads - fire and forget
    print("=== Detached Threads ===\n\n")

    let detached = Thread.spawn(|| {
        print("I'm a detached thread!\n")
    })

    detached.detach()  // Don't wait for it
    print("Detached thread running in background\n\n")

    // Channels for communication
    print("=== Channels ===\n\n")

    // buffered/unbuffered return a (Sender, Receiver) tuple
    let (tx, rx) = Channel<string>.buffered(5)

    // Spawn producer thread - `own` moves the Sender into the closure
    let producer = Thread.spawn(own || {
        let _ = tx.send("Message 1")
        let _ = tx.send("Message 2")
        let _ = tx.send("Message 3")
        print("Producer sent 3 messages\n")
    })

    // Spawn consumer thread - `own` moves the Receiver into the closure
    let consumer = Thread.spawn(own || {
        for _ in 0..3 {
            if rx.receive() is string as msg {
                println("Received: {msg}")
            }
        }
    })

    let _ = producer.join()
    let _ = consumer.join()
    print("\n")

    // Unbuffered channel - synchronous
    print("=== Unbuffered Channel ===\n\n")

    let (sync_tx, sync_rx) = Channel<i32>.unbuffered()

    let sender_thread = Thread.spawn(own || {
        print("Sending 100...\n")
        let _ = sync_tx.send(100)  // Blocks until received
        print("Send complete\n")
    })

    let receiver_thread = Thread.spawn(own || {
        print("Waiting to receive...\n")
        if sync_rx.receive() is i32 as value {  // Blocks until sent
            println("Received: {value}")
        }
    })

    let _ = sender_thread.join()
    let _ = receiver_thread.join()
    print("\n")

    // Try receive - non-blocking
    print("=== Non-blocking Receive ===\n\n")

    let (test_tx, test_rx) = Channel<i32>.buffered(2)

    // Send one message
    let _ = test_tx.send(999)

    // Try to receive
    if test_rx.try_receive() is i32 as got {
        println("Got message: {got}")
    } else {
        print("No message available\n")
    }

    // Try to receive again (should fail, channel empty)
    if test_rx.try_receive() is i32 as again {
        println("Got message: {again}")
    } else {
        print("Channel empty (expected)\n")
    }

    print("\n")

    // Thread pool
    print("=== Thread Pool ===\n\n")

    using ThreadPool(workers: 4) {
        mut handles = Vec.new()

        for i in 0..8 {
            let h = ThreadPool.spawn(own || {
                println("Pool task {i} running")
            })
            handles.push(h)
        }

        print("\nWaiting for all pool tasks...\n")

        for h in handles {
            let _ = h.join()
        }
    }

    print("\n=== Key Points ===\n")
    print("- Thread.spawn(|| {}) creates raw OS threads\n")
    print("- ThreadPool.spawn(|| {}) uses thread pool (needs using ThreadPool)\n")
    print("- handle.join() waits for completion\n")
    print("- handle.detach() runs in background\n")
    print("- Channels enable message passing\n")
    print("- No data races - compiler enforces safety\n")
    print("- No function coloring - threads are first-class\n")

    return ()
}
