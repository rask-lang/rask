// Learn: errors are values — reading one, handing it up, declaring your own
//
// The chapter at docs/book/src/guide/errors-are-values.md includes the anchored
// regions below rather than quoting them, so what the page shows is what CI
// runs. tests/examples_gate.sh runs this on both backends against
// tests/golden/errors.out.

import string.ParseError

// ANCHOR: simplest
func years_from(text: string) -> string {
    let n: i64 or ParseError = text.parse<i64>()
    if n is i64 as years {
        return "{years} years"
    } else as e {
        return "not a number: {e.message()}"
    }
}
// ANCHOR_END: simplest

// ANCHOR: propagate
func doubled(text: string) -> i64 or ParseError {
    let n = try text.parse<i64>()
    return n * 2
}
// ANCHOR_END: propagate

// ANCHOR: absence
func name_of(settings: Map<string, string>) -> string {
    return settings.get("name") ?? "unnamed"
}
// ANCHOR_END: absence

// ANCHOR: drop
func retries_of(settings: Map<string, string>) -> i64 {
    let text = settings.get("retries") ?? "3"
    return text.parse<i64>() catch _ => 3
}
// ANCHOR_END: drop

// ANCHOR: owntype
enum ConfigError {
    Missing(string)
    Malformed(string)
}

extend ConfigError with Error {
    func message(self) -> string {
        match self {
            ConfigError.Missing(key) => return "{key} is not set"
            ConfigError.Malformed(key) => return "{key} is not a number"
        }
    }
}
// ANCHOR_END: owntype

// ANCHOR: ownuse
func port_of(settings: Map<string, string>) -> i64 or ConfigError {
    let text = settings.get("port") ?? {
        return ConfigError.Missing("port")
    }
    let n = text.parse<i64>() catch _ => {
        return ConfigError.Malformed("port")
    }
    return n
}
// ANCHOR_END: ownuse

func settings_with(port: string) -> Map<string, string> {
    mut m = Map.new()
    m.insert("port", port)
    return m
}

func report(settings: Map<string, string>) {
    let p = port_of(settings)
    if p is i64 as port {
        println("port {port}")
    } else as e {
        println("bad config: {e.message()}")
    }
}

func main() {
    println(years_from("41"))
    println(years_from("forty-one"))

    let d = doubled("41")
    if d is i64 as n {
        println("doubled {n}")
    } else as e {
        println("could not double: {e.message()}")
    }

    mut empty = Map.new()
    println("name is {name_of(empty)}")
    println("retries is {retries_of(empty)}")

    report(settings_with("8080"))
    report(empty)
    report(settings_with("eighty-eighty"))
}
