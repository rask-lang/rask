// KeyValue — core record type with tab-delimited encoding.
//
// Public because scan() returns Vec<KeyValue> to callers.

struct KeyValue {
    key: string
    value: string
    seq: i64
    deleted: bool
}

extend KeyValue {
    func new(key: string, value: string, seq: i64) -> KeyValue {
        return KeyValue {
            key,
            value,
            seq,
            deleted: false,
        }
    }

    func tombstone(key: string, seq: i64) -> KeyValue {
        return KeyValue {
            key,
            value: "",
            seq,
            deleted: true,
        }
    }
}

// Encode a single KV pair as "key\tvalue\tseq\tdeleted\n"
func encode_kv(kv: KeyValue) -> string {
    let del = if kv.deleted { "1" } else { "0" }
    return "{kv.key}\t{kv.value}\t{kv.seq}\t{del}\n"
}

func decode_kv(line: string) -> KeyValue or WalError {
    let parts = line.split("\t").to_vec()
    if parts.len() < 4 {
        return WalError.CorruptEntry(0, "expected 4 tab-separated fields")
    }
    let seq = parts[2].parse<i64>() is i64 as v else {
        return WalError.CorruptEntry(0, "invalid sequence number: {parts[2]}")
    }
    let deleted = parts[3].trim() == "1"
    return KeyValue {
        key: parts[0].to_string(),
        value: parts[1].to_string(),
        seq: seq as i64,
        deleted,
    }
}

// ─── Tests ──────────────────────────────────────────────────────────

test "kv encode/decode roundtrip" {
    let kv = KeyValue.new("test_key", "test_value", 42)
    let encoded = encode_kv(kv)
    let decoded = decode_kv(encoded)!

    assert decoded.key == "test_key"
    assert decoded.value == "test_value"
    assert decoded.seq == 42
    assert !decoded.deleted
}

test "kv tombstone encode/decode" {
    let kv = KeyValue.tombstone("deleted_key", 99)
    let encoded = encode_kv(kv)
    let decoded = decode_kv(encoded)!

    assert decoded.key == "deleted_key"
    assert decoded.deleted
    assert decoded.seq == 99
}
