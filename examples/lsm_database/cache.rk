// Block cache — LRU cache for SSTable blocks, keyed by "{sst}:{block}".
//
// Blocks don't reference each other, so there's nothing here a container
// with stable identity would buy: the map is the cache. Eviction removes
// the least-accessed entry when capacity is hit.

const MAX_CACHE_ENTRIES: usize = 128

struct CacheBlock {
    sst_id: i32
    block_id: i32
    entries: Vec<KeyValue>
    access_count: i64
}

struct BlockCache {
    blocks: Map<string, CacheBlock>
    access_counter: i64
}

extend BlockCache {
    func new() -> BlockCache {
        return BlockCache {
            blocks: Map.new(),
            access_counter: 0,
        }
    }

    func cache_key(sst_id: i32, block_id: i32) -> string {
        return "{sst_id}:{block_id}"
    }

    func get(mutate self, sst_id: i32, block_id: i32) -> Vec<KeyValue>? {
        let key = BlockCache.cache_key(sst_id, block_id)
        if !self.blocks.contains(key) { return none }

        self.access_counter += 1
        let stamp = self.access_counter
        return self.blocks.modify(key, |mutate block: CacheBlock| {
            block.access_count = stamp
            return block.entries.clone()
        })
    }

    func put(mutate self, sst_id: i32, block_id: i32, entries: Vec<KeyValue>) {
        let key = BlockCache.cache_key(sst_id, block_id)
        if self.blocks.contains(key) { return }

        if self.blocks.len() >= MAX_CACHE_ENTRIES {
            self.evict_one()
        }

        self.access_counter += 1
        self.blocks.insert(key, CacheBlock {
            sst_id,
            block_id,
            entries,
            access_count: self.access_counter,
        })
    }

    func evict_one(mutate self) {
        mut min_access: i64 = i64.MAX
        mut victim: string? = none

        for (key, block) in self.blocks {
            if block.access_count < min_access {
                min_access = block.access_count
                victim = key
            }
        }

        if victim? as key {
            self.blocks.remove(key)
        }
    }

    func invalidate(mutate self, sst_id: i32) {
        mut to_remove = Vec.new()
        for (key, block) in self.blocks {
            if block.sst_id == sst_id {
                to_remove.push(key)
            }
        }
        for key in to_remove {
            self.blocks.remove(key)
        }
    }

    func count(self) -> usize {
        return self.blocks.len()
    }
}

// ─── Interface-based Lookup Strategy ────────────────────────────────────

interface SstLookup {
    func lookup(self, meta: SstMeta, key: string, mutate cache: BlockCache) -> KeyValue? or SstError
}

struct DefaultLookup { }

DefaultLookup implements SstLookup {
    func lookup(self, meta: SstMeta, key: string, mutate cache: BlockCache) -> KeyValue? or SstError {
        return sst_point_lookup(meta, key, mutate cache)
    }
}

func sst_point_lookup(meta: SstMeta, key: string, mutate cache: BlockCache) -> KeyValue? or SstError {
    if !meta.bloom.may_contain(key) {
        return none
    }

    let index = try read_sstable_index(meta.path)
    let target_block = find_block_for_key(index, key) ?? {
        return none
    }

    // Cache hit path
    if cache.get(meta.id, target_block)? as entries {
        for entry in entries {
            if entry.key == key {
                return entry
            }
        }
        return none
    }

    // Cache miss — read from disk, populate cache
    let entries = try read_sstable_block(meta.path, target_block)
    cache.put(meta.id, target_block, entries.clone())

    for entry in entries {
        if entry.key == key {
            return entry
        }
    }
    return none
}

// ─── Tests ──────────────────────────────────────────────────────────

test "block cache put and get" {
    mut cache = BlockCache.new()
    let entries = Vec.from([KeyValue.new("k1", "v1", 1), KeyValue.new("k2", "v2", 2)])

    cache.put(1, 0, entries.clone())

    let result = cache.get(1, 0) ?? panic("expected present")
    assert result.len() == 2
    assert result[0].key == "k1"

    assert cache.get(1, 99) is none
    assert cache.get(99, 0) is none
}

test "block cache eviction" {
    mut cache = BlockCache.new()

    mut i = 0
    while i < MAX_CACHE_ENTRIES + 10 {
        mut entries = Vec.new()
        entries.push(KeyValue.new("k", "v", i.wrap<i64>()))
        cache.put(i.wrap<i32>(), 0, entries)
        i += 1
    }

    assert cache.count() <= MAX_CACHE_ENTRIES
}

test "block cache invalidate" {
    mut cache = BlockCache.new()
    mut e1 = Vec.new()
    e1.push(KeyValue.new("a", "1", 1))
    mut e2 = Vec.new()
    e2.push(KeyValue.new("b", "2", 2))
    mut e3 = Vec.new()
    e3.push(KeyValue.new("c", "3", 3))
    cache.put(1, 0, e1)
    cache.put(1, 1, e2)
    cache.put(2, 0, e3)

    cache.invalidate(1)

    assert cache.get(1, 0) is none
    assert cache.get(1, 1) is none
    assert cache.get(2, 0)?
}
