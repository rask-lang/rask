// Learn: Error handling with T or E and try

enum DivError { Msg(string) }
extend DivError {
    func message(self) -> string {
        match self {
            DivError.Msg(m) => return m,
        }
    }
}

func main() {
    // Handling T or E: the test names the branch, the `as` binds it
    let result = divide(10, 2)

    if result is i32 as v {
        print("10 / 2 = ")
        print(v)
        print("\n")
    } else as e {
        print("Error: ")
        print(e.message())
        print("\n")
    }

    // Division by zero
    let bad = divide(10, 0)

    if bad is i32 as v {
        print("Result: ")
        print(v)
        print("\n")
    } else as e {
        print("Error: ")
        print(e.message())
        print("\n")
    }

    // Handling it in place instead of branching
    let safe = safe_calc()
    print("Safe calc result: ")
    print(safe)
    print("\n")
}

func divide(a: i32, b: i32) -> i32 or DivError {
    if b == 0 {
        return DivError.Msg("Cannot divide by zero")
    }
    return a / b
}

func safe_calc() -> i32 {
    // `catch` gives the value straight out, so the rest reads flat
    let x = divide(20, 4) catch _ => return 0
    return x * 2
}
