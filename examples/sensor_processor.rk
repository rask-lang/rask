// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Embedded Sensor Processor
// Demonstrates: Threading, timing, struct methods, match, real-time deadlines

import thread.Thread
import time

// ============================================================================
// Lookup Tables (runtime-initialized)
// ============================================================================

func build_crc8_table() -> Vec<i64> {
    mut table = Vec.new()
    for i in 0..256 {
        mut crc = i
        for j in 0..8 {
            if crc & 128 != 0 {
                crc = ((crc * 2) & 255) ^ 7
            } else {
                crc = (crc * 2) & 255
            }
        }
        table.push(crc)
    }
    return table
}

func crc8(data: Vec<i64>, table: Vec<i64>) -> i64 {
    mut crc: i64 = 0
    let n = data.len()
    for i in 0..n {
        let byte = data.get(i)!
        crc = table.get((crc ^ byte) & 255)!
    }
    return crc
}

// Read from simulated hardware register
func read_hardware_sensor(sensor_id: i64, tick: i64) -> f64 {
    let base = match sensor_id {
        0 => 2200,
        1 => 10130,
        2 => 4500,
        _ => 0,
    }

    let noise = ((tick * 7 + sensor_id * 13) % 100) - 50
    return (base + noise) as f64 / 100.0
}

// ============================================================================
// Timing Statistics
// ============================================================================

struct TimingStats {
    samples: Vec<i64>
    sample_idx: i64
    sample_count: i64
    min_ns: i64
    max_ns: i64
    sum_ns: i64
    deadline_misses: i64
}

extend TimingStats {
    func record(self, cycle_ns: i64, deadline_ns: i64) {
        self.samples.set(self.sample_idx, cycle_ns)
        self.sample_idx = (self.sample_idx + 1) % 256

        if self.sample_count < 256 {
            self.sample_count += 1
        }
        if cycle_ns < self.min_ns {
            self.min_ns = cycle_ns
        }
        if cycle_ns > self.max_ns {
            self.max_ns = cycle_ns
        }
        self.sum_ns += cycle_ns

        if cycle_ns > deadline_ns {
            self.deadline_misses += 1
        }
    }

    func mean_ns(self) -> i64 {
        if self.sample_count == 0 {
            return 0
        }
        return self.sum_ns / self.sample_count
    }
}

// Integer square root
func isqrt(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    mut x = n
    mut y = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

// ============================================================================
// Interrupt Handler Simulation (runs on separate thread)
// ============================================================================

// Reading sent from the ISR thread to the main loop over a Channel.
// Channels transfer ownership: no shared mutable Vec, no locks.
struct Reading {
    sensor_id: i64
    value: f64
    timestamp_ns: i64
}

// Pushes sensor readings through a channel. The Sender is moved into the
// closure that wraps this on Thread.spawn — main keeps the Receiver.
func interrupt_handler(
    tx: Sender<Reading>,
    start_time: time.Instant,
    sample_rate_hz: i64
) {
    let period_ns = 1000000000 / sample_rate_hz
    mut sequence: i64 = 0

    while sequence < sample_rate_hz * 2 {
        let now_ns = (time.Instant.now() - start_time).as_nanos() saturate to i64

        for sensor_id in 0..3 {
            let value = read_hardware_sensor(sensor_id, sequence)
            let _ = tx.send(Reading {
                sensor_id: sensor_id,
                value: value,
                timestamp_ns: now_ns,
            })
        }

        sequence += 1
        time.sleep(time.Duration.from_millis(period_ns / 1000000))
    }
}

// ============================================================================
// Processing State
// ============================================================================

struct ProcessorState {
    temp_history: Vec<f64>
    pressure_history: Vec<f64>
    humidity_history: Vec<f64>
    history_idx: i64
    history_count: i64
    temp_avg: f64
    pressure_avg: f64
    humidity_avg: f64
    samples_processed: i64
}

extend ProcessorState {
    func process_reading(self, sensor_id: i64, value: f64) {
        match sensor_id {
            0 => self.temp_history.set(self.history_idx, value),
            1 => self.pressure_history.set(self.history_idx, value),
            2 => self.humidity_history.set(self.history_idx, value),
            _ => {}
        }

        if sensor_id == 2 {
            self.history_idx = (self.history_idx + 1) % 64
            if self.history_count < 64 {
                self.history_count += 1
            }
        }

        self.samples_processed += 1
    }

    func compute_averages(self) {
        if self.history_count == 0 {
            return
        }

        mut temp_sum = 0.0
        mut pres_sum = 0.0
        mut hum_sum = 0.0
        for i in 0..self.history_count {
            temp_sum += self.temp_history.get(i)!
            pres_sum += self.pressure_history.get(i)!
            hum_sum += self.humidity_history.get(i)!
        }

        let n = self.history_count as f64
        self.temp_avg = temp_sum / n
        self.pressure_avg = pres_sum / n
        self.humidity_avg = hum_sum / n
    }
}

// ============================================================================
// Main Entry Point
// ============================================================================

func main() {
    println("=== Real-Time Sensor Processor ===")
    println("")

    let SAMPLE_RATE_HZ = 1000
    let PROCESS_RATE_HZ = 100
    let HARD_DEADLINE_US = 5000
    // A fixed cycle count, not a wall-clock duration: 200 cycles at 100 Hz is
    // the same ~2 seconds, but the loop runs the same number of times on a
    // busy machine as an idle one, so the report below is reproducible.
    let PROCESS_CYCLES = 200

    println("Sample rate: {SAMPLE_RATE_HZ} Hz (interrupt)")
    println("Process rate: {PROCESS_RATE_HZ} Hz (main loop)")
    println("Hard deadline: {HARD_DEADLINE_US} µs")
    println("")

    // Build lookup tables
    let crc_table = build_crc8_table()

    // ISR → main channel. Sender is moved into the spawned thread,
    // Receiver stays here for draining.
    let (tx, rx) = Channel<Reading>.buffered(1024)

    mut temp_hist = Vec.new()
    mut pres_hist = Vec.new()
    mut hum_hist = Vec.new()
    for i in 0..64 {
        temp_hist.push(0.0)
        pres_hist.push(0.0)
        hum_hist.push(0.0)
    }
    mut state = ProcessorState {
        temp_history: temp_hist,
        pressure_history: pres_hist,
        humidity_history: hum_hist,
        history_idx: 0,
        history_count: 0,
        temp_avg: 0.0,
        pressure_avg: 0.0,
        humidity_avg: 0.0,
        samples_processed: 0,
    }

    mut timing_samples = Vec.new()
    for i in 0..256 {
        timing_samples.push(0)
    }
    mut timing = TimingStats {
        samples: timing_samples,
        sample_idx: 0,
        sample_count: 0,
        min_ns: 9999999999,
        max_ns: 0,
        sum_ns: 0,
        deadline_misses: 0,
    }

    let start_time = time.Instant.now()
    let process_period_ns = 1000000000 / PROCESS_RATE_HZ
    let deadline_ns = HARD_DEADLINE_US * 1000

    // Start interrupt handler on separate thread. `own` moves the Sender
    // (and Copy captures start_time / SAMPLE_RATE_HZ) into the closure.
    mut isr_handle = Thread.spawn(own || {
        interrupt_handler(tx, start_time, SAMPLE_RATE_HZ)
    })

    println("Started. Processing {PROCESS_CYCLES} cycles...")
    println("")

    mut cycle: i64 = 0

    while cycle < PROCESS_CYCLES {
        let cycle_start = time.Instant.now()

        // Drain available samples without blocking — try_receive returns once
        // the channel is empty, so the cycle stays bounded.
        while rx.try_receive() is Reading as r {
            state.process_reading(r.sensor_id, r.value)
        }

        // Compute derived values periodically
        if cycle % 10 == 0 {
            state.compute_averages()
        }

        // Measure cycle time
        let cycle_ns = cycle_start.elapsed().as_nanos() saturate to i64
        timing.record(cycle_ns, deadline_ns)

        cycle += 1

        // Sleep until next cycle
        time.sleep(time.Duration.from_millis(process_period_ns / 1000000))
    }

    // Wait for interrupt handler
    isr_handle.join()

    // The ISR is done producing, so whatever is still queued is the tail the
    // last cycle didn't reach. Draining it here is what makes the sample count
    // and the averages a property of the program rather than of how the two
    // threads happened to interleave.
    while rx.try_receive() is Reading as r {
        state.process_reading(r.sensor_id, r.value)
    }
    state.compute_averages()

    // Print results
    println("=== Results ===")
    println("")
    println("Samples processed: {state.samples_processed}")
    println("Processing cycles: {cycle}")
    println("")
    // Cycle timings measure this machine, not this program — they move run to
    // run on a single backend as much as they differ between two. They go to
    // stderr so the run still reports them while stdout stays reproducible.
    let min_us = timing.min_ns / 1000
    let max_us = timing.max_ns / 1000
    let mean_us = timing.mean_ns() / 1000
    eprintln("Timing Statistics (wall-clock, varies per run):")
    eprintln("  Min cycle:  {min_us} µs")
    eprintln("  Max cycle:  {max_us} µs")
    eprintln("  Mean cycle: {mean_us} µs")
    eprintln("  Deadline misses: {timing.deadline_misses}")
    println("Final Averages (64-sample window):")
    println("  Temperature: {state.temp_avg} C")
    println("  Pressure:    {state.pressure_avg} hPa")
    println("  Humidity:    {state.humidity_avg} %")

    if timing.deadline_misses > 0 {
        eprintln("")
        eprintln("WARNING: {timing.deadline_misses} deadline misses detected!")
    }
}
