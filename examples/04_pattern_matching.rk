// Learn: Pattern matching with match and if-is

func main() {
    // Match expression
    let x = 2
    let name = match x {
        1 => "one",
        2 => "two",
        3 => "three",
        _ => "many",
    }

    print("Number ")
    print(x)
    print(" is ")
    print(name)
    print("\n")

    // Pattern matching with Option
    let maybe: i32? = 42

    if maybe? {
        print("Got value: ")
        print(maybe)
        print("\n")
    }

    let nothing: i32? = none

    if nothing == none {
        print("Got nothing\n")
    }
}
