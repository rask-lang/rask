import memory.Pool

struct Entity {
    name: string
    health: i32
    active: bool
}

func main() {
    // Basic pool operations
    mut pool = Pool.new()

    let h1 = pool.insert(Entity { name: "Alice", health: 100, active: true })
    let h2 = pool.insert(Entity { name: "Bob", health: 80, active: true })
    let h3 = pool.insert(Entity { name: "Charlie", health: 60, active: true })

    let len = pool.len()
    println("Pool length: {len}")
    let is_empty = pool.is_empty()
    println("Is empty: {is_empty}")

    // Index access - read whole value
    let e1 = pool[h1]
    println("Entity 1: {e1.name}")

    // Index access - read field
    let name2 = pool[h2].name
    let health2 = pool[h2].health
    println("Entity 2: {name2}, health={health2}")

    // Field assignment via index
    pool[h1].health = 90
    let h1_health = pool[h1].health
    println("After assignment: h1 health={h1_health}")

    // Compound assignment (pool[h].field -= value)
    pool[h2].health -= 20
    let h2_health = pool[h2].health
    println("After compound assign: h2 health={h2_health}")

    // Contains check
    let c1 = pool.contains(h1)
    let c3 = pool.contains(h3)
    println("Contains h1: {c1}")
    println("Contains h3: {c3}")

    // Remove
    pool.remove(h3)
    let len2 = pool.len()
    println("Pool length after remove: {len2}")
    let c3_after = pool.contains(h3)
    println("Contains h3 after remove: {c3_after}")

    // Safe get on valid handle
    let maybe = pool.get(h1)
    if maybe? {
        println("Got h1: {maybe.name}")
    }

    // Safe get on stale handle (should be none)
    let stale = pool.get(h3)
    if stale is none {
        println("Correctly got none for stale handle")
    }

    // Iteration via cursor
    println("All entities via cursor:")
    for h in pool.handles() {
        let e = pool[h]
        println("  {e.name}: health={e.health}")
    }

    // Insert more entities to test slot reuse
    let h4 = pool.insert(Entity { name: "Diana", health: 70, active: true })
    let len3 = pool.len()
    println("After inserting Diana, pool length: {len3}")

    // Safe removal during iteration
    pool[h4].health = 30
    for h in pool.handles() {
        let e = pool[h]
        if e.health < 50 {
            pool.remove(h)
        }
    }
    let len4 = pool.len()
    println("Pool length after cleanup: {len4}")

    // Verify remaining entities
    println("Remaining entities:")
    for h in pool.handles() {
        let e = pool[h]
        println("  {e.name}: health={e.health}")
    }

    println("Pool test passed!")
    return
}
