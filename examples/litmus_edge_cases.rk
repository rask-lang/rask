// Edge case tests discovered during litmus program validation.
//
// Tests: string Copy semantics, try-else with method calls, Vec.get() returning
// T?, and basic type system features.
//
// Run: rask test examples/litmus_edge_cases.rk

// ─── String Copy semantics (std.strings/S1) ─────────────────────

struct TextBuffer {
    lines: Vec<string>
}

extend TextBuffer {
    func new() -> TextBuffer {
        return TextBuffer { lines: Vec.new() }
    }

    func add(self, text: string) {
        self.lines.push(text)
    }

    // Requires string to be Copy — reading old_text must not borrow self.lines
    func replace(self, index: i32, new_text: string) -> string {
        let old_text = self.lines[index]
        self.lines[index] = new_text
        return old_text
    }
}

test "string is Copy — read then write same container" {
    mut buf = TextBuffer.new()
    buf.add("hello")
    buf.add("world")
    let old = buf.replace(0, "changed")
    assert old == "hello"
    assert buf.lines[0] == "changed"
    assert buf.lines[1] == "world"
}

test "string Copy — multiple bindings same source" {
    let original = "hello world"
    let copy1 = original
    let copy2 = original
    assert original == "hello world"
    assert copy1 == "hello world"
    assert copy2 == "hello world"
}

struct Named { name: string }

test "string Copy — assign from struct field" {
    let obj = Named { name: "Alice" }
    let n1 = obj.name
    let n2 = obj.name
    assert n1 == "Alice"
    assert n2 == "Alice"
}

// ─── Vec.get() returns T? (collections/V3) ──────────────────────

test "Vec.get — present for valid index" {
    mut v = Vec.new()
    v.push(10)
    v.push(20)
    v.push(30)

    let first = v.get(0)
    assert first?

    let second = v.get(1)!
    assert second == 20
}

test "Vec.get — none for out of bounds" {
    mut v = Vec.new()
    v.push(42)

    let out = v.get(5)
    assert out is none
}

test "Vec.get — force-extract matches expected value" {
    mut v = Vec.new()
    v.push(100)
    v.push(200)
    assert v.get(0)! == 100
    assert v.get(1)! == 200
}

// ─── try-else with method calls ────────────────────────────────

enum InnerError {
    BadInput(string)
}

extend InnerError {
    func message(self) -> string {
        match self {
            InnerError.BadInput(m) => return m
        }
    }
}

enum OuterError {
    Wrapped(InnerError)
    Other(string)
}

extend OuterError {
    func message(self) -> string {
        match self {
            OuterError.Wrapped(e) => return e.message()
            OuterError.Other(m) => return m
        }
    }
}

struct Validator {
    threshold: i32
}

extend Validator {
    func check(self, value: i32) -> i32 or InnerError {
        if value < self.threshold {
            return InnerError.BadInput("below threshold")
        }
        return value * 2
    }
}

func use_validator(v: Validator, x: i32) -> i32 or OuterError {
    let result = v.check(x) catch e => {
        return OuterError.Wrapped(e)
    }
    return result
}

func use_validator_multiline(v: Validator, x: i32) -> i32 or OuterError {
    let result = v.check(x) catch e => {
        return OuterError.Wrapped(e)
    }
    return result
}

test "catch with method call — success" {
    mut v = Validator { threshold: 5 }
    let result = use_validator(v, 10)
    assert result is i32
}

test "catch with method call — error transforms" {
    mut v = Validator { threshold: 5 }
    let result = use_validator(v, 3)
    assert result is OuterError
}

test "try-else multiline with method call — success" {
    mut v = Validator { threshold: 5 }
    let result = use_validator_multiline(v, 10)
    assert result is i32
}

test "try-else multiline with method call — error transforms" {
    mut v = Validator { threshold: 5 }
    let result = use_validator_multiline(v, 3)
    assert result is OuterError
}

// ─── try-else with trait objects ────────────────────────────────

enum ParseError {
    InvalidFormat(string)
}

extend ParseError {
    func message(self) -> string {
        match self {
            ParseError.InvalidFormat(m) => return m
        }
    }
}

enum ProcessError {
    Parse(ParseError)
    Logic(string)
}

extend ProcessError {
    func message(self) -> string {
        match self {
            ProcessError.Parse(e) => return e.message()
            ProcessError.Logic(m) => return m
        }
    }
}

trait Parser {
    func parse(self, input: string) -> i32 or ParseError
}

struct StrictParser { }

extend StrictParser with Parser {
    func parse(self, input: string) -> i32 or ParseError {
        if input == "42" {
            return 42
        }
        return ParseError.InvalidFormat("not 42")
    }
}

func process_with_parser(p: any Parser, input: string) -> i32 or ProcessError {
    let val = p.parse(input) catch e => {
        return ProcessError.Parse(e)
    }
    return val * 2
}

test "try-else with trait object — success" {
    let p = StrictParser {}
    let result = process_with_parser(p, "42")
    assert result is i32
    assert result! == 84
}

test "try-else with trait object — error transforms" {
    let p = StrictParser {}
    let result = process_with_parser(p, "bad")
    assert result is ProcessError
}

// ─── String Copy in collections ─────────────────────────────────

test "string Copy — Vec of strings, read multiple" {
    mut names = Vec.new()
    names.push("Alice")
    names.push("Bob")
    names.push("Charlie")
    // Read same element multiple times — must not move
    let a1 = names[0]
    let a2 = names[0]
    assert a1 == "Alice"
    assert a2 == "Alice"
    assert names.len() == 3
}

test "string Copy — Map with string keys and values" {
    mut m = Map.new()
    m.insert("key1", "value1")
    m.insert("key2", "value2")
    let v1 = m["key1"]
    let v2 = m["key1"]
    assert v1 == "value1"
    assert v2 == "value1"
}

func take_string(s: string) -> string {
    return s
}

test "string Copy — pass to function and keep original" {
    let original = "immutable"
    let copy = take_string(original)
    assert original == "immutable"
    assert copy == "immutable"
}

// ─── Pool with string fields ────────────────────────────────────

struct Entity {
    name: string
    health: i32
}

test "Pool — string fields Copy correctly" {
    mut pool = Pool.new()
    let h = pool.insert(Entity { name: "Hero", health: 100 })
    // Read string field — should be Copy, not move
    let name1 = pool[h].name
    let name2 = pool[h].name
    assert name1 == "Hero"
    assert name2 == "Hero"
    assert pool[h].health == 100
}

test "Pool — modify non-string field after reading string" {
    mut pool = Pool.new()
    let h = pool.insert(Entity { name: "Hero", health: 100 })
    let name = pool[h].name
    with pool[h] as e {
        e.health = 50
    }
    assert name == "Hero"
    assert pool[h].health == 50
}

// ─── Vec.get with narrowing ─────────────────────────────────────

test "Vec.get — narrow on present" {
    mut v = Vec.new()
    v.push("hello")
    if v.get(0)? as val {
        assert val == "hello"
    } else {
        assert false, "expected present"
    }
}

test "Vec.get — else branch on absent" {
    mut v = Vec.new()
    v.push(1)
    if v.get(99)? {
        assert false, "expected none"
    }
}

test "Vec.get — guard pattern" {
    mut v = Vec.new()
    v.push(42)
    let val = v.get(0) ?? panic("missing")
    assert val == 42
}

// ─── try-else error value verification ──────────────────────────

test "try-else — error value is correctly transformed" {
    mut v = Validator { threshold: 10 }
    let result = use_validator(v, 3)
    match result {
        OuterError.Wrapped(InnerError.BadInput(msg)) => assert msg == "below threshold"
        _ => assert false, "expected Wrapped(BadInput)"
    }
}

// ─── Chained try-else ───────────────────────────────────────────

enum ChainError {
    Step1(string)
    Step2(string)
}

extend ChainError {
    func message(self) -> string {
        match self {
            ChainError.Step1(m) => return m
            ChainError.Step2(m) => return m
        }
    }
}

enum StepError {
    Msg(string)
}

extend StepError {
    func message(self) -> string {
        match self {
            StepError.Msg(m) => return m
        }
    }
}

func step1(x: i32) -> i32 or StepError {
    if x < 0 { return StepError.Msg("negative") }
    return x + 1
}

func step2(x: i32) -> i32 or StepError {
    if x > 100 { return StepError.Msg("too large") }
    return x * 2
}

func chained(x: i32) -> i32 or ChainError {
    let a = step1(x) catch e => {
        return ChainError.Step1(e.message())
    }
    let b = step2(a) catch e => {
        return ChainError.Step2(e.message())
    }
    return b
}

test "chained catch — all succeed" {
    let result = chained(5)
    assert result is i32
    assert result! == 12
}

test "chained catch — first fails" {
    let result = chained(-1)
    assert result is ChainError.Step1(_)
}

test "chained catch — second fails" {
    let result = chained(99)
    let result2 = chained(200)
    assert result is i32
    assert result2 is ChainError.Step2(_)
}

// ─── HTTP types (Response constructors, Request.path) ───────────

import http

test "Response.ok creates 200 response" {
    let resp = Response.ok("hello")
    assert resp.status == 200
    assert resp.body == "hello"
}

test "Response.not_found creates 404" {
    let resp = Response.not_found()
    assert resp.status == 404
}

test "Response.json sets content type" {
    let resp = Response.json("{}")
    assert resp.status == 200
    assert resp.body == "{}"
}

test "Response.with_status changes status" {
    let resp = Response.ok("created").with_status(201)
    assert resp.status == 201
    assert resp.body == "created"
}

test "Response.bad_request creates 400" {
    let resp = Response.bad_request("invalid")
    assert resp.status == 400
    assert resp.body == "invalid"
}

// ─── File I/O round-trip ────────────────────────────────────────

import fs

test "fs write and read round-trip" {
    let path = "/tmp/rask_test_litmus.txt"
    let content = "hello from rask\nsecond line\n"
    fs.write_text(path, content)
    let read_back = fs.read_text(path) is string as data else {
        assert false, "failed to read back"
        return
    }
    assert read_back == content
}

test "fs read_lines returns correct line count" {
    let path = "/tmp/rask_test_litmus2.txt"
    fs.write_text(path, "line1\nline2\nline3\n")
    let lines = fs.read_lines(path) catch _ => {
        assert false, "failed to read lines"
        return
    }
    assert lines.len() == 3
}

// ─── Entry point ────────────────────────────────────────────────

func main() {
    println("Run 'rask test examples/litmus_edge_cases.rk' to run tests")
}
