// Error surface for the tracker service.
//
// Error is delivered two ways here:
//   StoreError / AuthError / ApiError — @message (templates, plus ApiError's
//     wrapper variants auto-delegating to the inner error, ER37)
//   ValidationError — hand-written `… implements Error`, because its
//     messages weave the payloads into prose
//
// ER6 works now (#1001): an enum a signature names as an error type gets a
// message() derived from its variant names and payloads with nothing written.
// These keep @message because their messages are prose, not variant names.

import os
import os.SysError

// ─── Auth ────────────────────────────────────────────────────────────

@message
enum AuthError {
    @message("authorization required")
    Missing
    @message("invalid credentials")
    Invalid
    @message("credentials expired")
    Expired
}

// ─── Store ───────────────────────────────────────────────────────────

@message
enum StoreError {
    @message("task {id} not found")
    NotFound(id: u64)
    @message("task {id} already exists")
    Duplicate(id: u64)
    @message("store is at capacity ({limit} items)")
    CapacityFull(limit: usize)
    @message("transaction conflict: {reason}")
    TxConflict(reason: string)
}

// ─── Validation ──────────────────────────────────────────────────────
// Hand-written override — the payloads need weaving into prose.

enum ValidationError {
    Empty(string)
    TooLong(string, usize)
    BadEnum(string, string)
}

ValidationError implements Error {
    func message(self) -> string {
        match self {
            Empty(field) => return "{field} must not be empty"
            TooLong(field, max) => return "{field} exceeds {max} characters"
            BadEnum(field, value) => return "{value} is not a valid {field}"
        }
    }
}

// ─── Boundary error ──────────────────────────────────────────────────
// What handlers return. One variant per wrapped error type, which is what lets
// `try` place a propagated error without a hand-written map (ER31a).

@message
enum ApiError {
    // Wrapper variants carry one error type and no template — `@message`
    // auto-delegates their message() to the inner error (ER37). The prose
    // variants below carry their own template.
    Validation(ValidationError)
    Store(StoreError)
    Auth(AuthError)
    System(SysError)
    @message("bad request: {reason}")
    BadRequest(reason: string)
    @message("rate limited; retry after {seconds}s")
    RateLimited(seconds: u64)
    @message("internal error: {reason}")
    Internal(reason: string)
}

extend ApiError {
    // HTTP status this error maps to. Keeps status policy in one place.
    func status(self) -> u16 {
        match self {
            Validation(_) => return 422
            BadRequest(reason: _) => return 400
            Auth(_) => return 401
            RateLimited(seconds: _) => return 429
            Store(e) => return store_status(e)
            System(_) => return 500
            Internal(reason: _) => return 500
        }
    }
}

func store_status(e: StoreError) -> u16 {
    match e {
        NotFound(id: _) => return 404
        Duplicate(id: _) => return 409
        TxConflict(reason: _) => return 409
        CapacityFull(limit: _) => return 503
    }
}
// No lifters needed. Each wrapper variant above takes exactly one payload of
// exactly one error type, which is all `try` needs to place a propagated error
// on its own (ER31a) — `try s.view_task(id)` in a handler becomes
// `ApiError.Store(e)` without the call site saying so.
