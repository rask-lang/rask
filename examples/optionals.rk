// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Learn: a value or nothing — `T?`, `match`, `if x? as v`, `??`, `?.`
//
// tests/examples_gate.sh runs this on both backends against
// tests/golden/optionals.out.

struct Profile {
    name: string
    email: string?
}

// The `match` is here to be the "before": `shout` below writes the same
// thing with `if p? as found`.
@allow(idiom/match-on-optional)
func greet(p: Profile?) -> string {
    match p {
        Profile as found => return "hello {found.name}"
        none => return "nobody here"
    }
}

func shout(p: Profile?) -> string {
    if p? as found {
        return "HELLO {found.name}"
    }
    return "nobody here"
}

func anybody(p: Profile?) -> string {
    if p? {
        return "yes"
    }
    return "no"
}

func email_of(p: Profile) -> string {
    return p.email ?? "no email"
}

func email_or(p: Profile?, fallback: string) -> string {
    return p?.email ?? fallback
}

func main() {
    let ada = Profile(name: "ada", email: "ada@example.com")
    let anon = Profile(name: "anon", email: none)

    println(greet(ada))
    println(greet(none))

    println(shout(ada))
    println(shout(none))

    println(anybody(ada))
    println(anybody(none))

    println(email_of(ada))
    println(email_of(anon))

    println(email_or(ada, "unknown"))
    println(email_or(anon, "unknown"))
    println(email_or(none, "unknown"))
}
