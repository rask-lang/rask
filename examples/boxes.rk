// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Learn: when a value needs a box, and which one
//
// Included by docs/book/src/guide/boxes.md via mdBook anchors.
// Keep the ANCHOR comments; the chapter quotes the regions between them.

import sync.Shared
import memory.Rack
import memory.Link
import memory.Heap

// ANCHOR: plain
struct Player {
    name: string
    health: i64
    items: Vec<string>
}
// ANCHOR_END: plain

// ANCHOR: sharedtype
struct Settings {
    theme: string
    retries: i64
}
// ANCHOR_END: sharedtype

// ANCHOR: racktype
struct Room {
    name: string
    exit: Link<Room>?
}
// ANCHOR_END: racktype

// ANCHOR: heaptype
struct Frame {
    label: string
    width: i64
    height: i64
}
// ANCHOR_END: heaptype

func main() {
    // ANCHOR: plainuse
    mut hero = Player { name: "Ada", health: 100, items: [] }
    hero.items.push("lamp")
    hero.health = hero.health - 10
    println("{hero.name} has {hero.health} hp and {hero.items.len()} item")
    // ANCHOR_END: plainuse

    // ANCHOR: sharedmake
    let settings = Shared.new(Settings { theme: "dark", retries: 3 })
    // ANCHOR_END: sharedmake

    // ANCHOR: sharedread
    with settings.read() as s {
        println("theme {s.theme}, {s.retries} retries")
    }
    // ANCHOR_END: sharedread

    // ANCHOR: sharedwrite
    with settings.write() as s {
        if s.retries < 5 {
            s.retries = s.retries + 1
        }
    }
    // ANCHOR_END: sharedwrite

    // ANCHOR: sharedstore
    settings.write().retries = 2
    // ANCHOR_END: sharedstore

    // ANCHOR: sharedinline
    let retries = settings.read().retries
    println("retries now {retries}")
    // ANCHOR_END: sharedinline

    // ANCHOR: rackmake
    mut rooms: Rack<Room> = Rack.new()
    let hall = rooms.insert(Room { name: "hall", exit: none })
    let cell = rooms.insert(Room { name: "cell", exit: none })
    hall.exit = cell
    // ANCHOR_END: rackmake

    // ANCHOR: rackread
    if hall.exit? as e {
        println("hall leads to {e.name}")
    }
    // ANCHOR_END: rackread

    // ANCHOR: rackdelete
    rooms.delete(cell)

    if hall.exit? as e {
        println("hall leads to {e.name}")
    } else {
        println("hall leads nowhere")
    }
    // ANCHOR_END: rackdelete

    // ANCHOR: heapuse
    let frame = Heap(Frame { label: "canvas", width: 1920, height: 1080 })
    ensure drop(frame)

    println("{(*frame).label} is {(*frame).width}x{(*frame).height}")
    // ANCHOR_END: heapuse
}
