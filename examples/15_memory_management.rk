// Learn: Memory management with Rack and Link
import memory.Link
import memory.Rack

// Node in a linked list — the `next` edge is a link, not a reference
struct Node {
    value: i32
    next: Link<Node>?
}

// Entity in a game or simulation
struct Entity {
    id: i32
    name: string
    health: i32
    target: Link<Entity>?
}

func main() {
    print("=== Rack/Link Pattern ===\n\n")

    // A reference can't be stored in a field. A link can: it names a node in a
    // rack, and the rack owns the node's lifetime.
    mut nodes = Rack<Node>.new()

    print("Creating linked list with links:\n")

    let first = nodes.insert(Node { value: 1, next: none })
    let second = nodes.insert(Node { value: 2, next: none })
    let third = nodes.insert(Node { value: 3, next: none })

    first.next = second
    second.next = third

    // Traverse — following a link is a dereference, no lookup and no check
    print("List values: ")
    mut current: Link<Node>? = first

    loop {
        if current? as node {
            print(node.value)
            print(" -> ")
            current = node.next
        } else {
            print("end\n\n")
            break
        }
    }

    mut entities = Rack<Entity>.new()

    print("Creating game entities:\n")

    let player = entities.insert(Entity {
        id: 1,
        name: "Player",
        health: 100,
        target: none,
    })

    let goblin = entities.insert(Entity {
        id: 2,
        name: "Goblin",
        health: 50,
        target: player,
    })

    let orc = entities.insert(Entity {
        id: 3,
        name: "Orc",
        health: 80,
        target: player,
    })

    player.target = goblin

    print("\nEntity relationships:\n")

    for e in entities.nodes() {
        print(e.name)
        print(" (HP: ")
        print(e.health)
        print(")")
        if e.target? as t {
            print(" -> targets ")
            print(t.name)
        }
        print("\n")
    }
    print("\n")

    print("Applying damage:\n")

    goblin.health -= 20
    print("Goblin health: ")
    print(goblin.health)
    print("\n")

    player.health -= 10
    print("Player health: ")
    print(player.health)
    print("\n\n")

    // Delete nulls every edge pointing at the node before it returns, so the
    // player's `target` clears itself. Nothing is left to remember.
    print("Removing defeated enemy:\n")
    entities.delete(goblin)
    print("Goblin deleted\n")

    if player.target? as t {
        print("Player still targets ")
        print(t.name)
        print("\n\n")
    } else {
        print("Player's target cleared by the delete\n\n")
    }

    print("=== Key Benefits ===\n")
    print("- No lifetime parameters\n")
    print("- A link can live in a field; a reference can't\n")
    print("- A dead link never exists, so reads need no check\n")
    print("- The rack owns the nodes; links are one machine word\n")
}
