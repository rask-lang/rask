// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Game Loop with Entities
// Demonstrates: Rack + Link for entities, traits, threading, time/delta, game systems

import time
import random
import thread.ThreadPool
import memory.Rack
import memory.Link
import random.Random

// Trait for updatable components
trait Updatable {
    func update(self, dt: f32)
}

// Position implements Updatable (applies velocity)
extend Position with Updatable {
    func update(self, dt: f32) {
        // Position updated by movement system
    }
}

// Component types
struct Position {
    x: f32
    y: f32
}

struct Velocity {
    dx: f32
    dy: f32
}

struct Health {
    current: i32
    max: i32
}

struct Collider {
    radius: f32
}

// Entity with all components
struct Entity {
    position: Position
    velocity: Velocity
    health: Health
    collider: Collider
    active: bool
    entity_type: EntityType
}

enum EntityType {
    Player
    Enemy
    Projectile
}

// Game state
struct GameState {
    entities: Rack<Entity>
    player: Link<Entity>?
    score: i32
    game_over: bool
    // Seeded so a run is reproducible. Enemy spawn positions decide which
    // collisions happen, so an unseeded RNG makes the entity counts — and the
    // score — different every run, on either backend.
    rng: Random
}

extend GameState {
    func new() -> GameState {
        // The rack has to exist before anything links into it: a link into a
        // rack this body owns can't be returned (mem.racks/RK6), so the player
        // is inserted through the finished state rather than beside it.
        mut state = GameState {
            entities: Rack<Entity>.new(),
            player: none,
            score: 0,
            game_over: false,
            rng: Random.from_seed(20260809),
        }

        state.player = state.entities.insert(Entity {
            position: Position { x: 400.0f32, y: 300.0f32 },
            velocity: Velocity { dx: 0.0f32, dy: 0.0f32 },
            health: Health { current: 100, max: 100 },
            collider: Collider { radius: 16.0f32 },
            active: true,
            entity_type: EntityType.Player,
        })

        return state
    }

    func spawn_enemy(mutate self, x: f32, y: f32) -> Link<Entity> {
        return self.entities.insert(Entity {
            position: Position { x, y },
            velocity: Velocity { dx: -50.0f32, dy: 0.0f32 },
            health: Health { current: 20, max: 20 },
            collider: Collider { radius: 12.0f32 },
            active: true,
            entity_type: EntityType.Enemy,
        })
    }

    func spawn_projectile(mutate self, x: f32, y: f32, dx: f32, dy: f32) -> Link<Entity> {
        return self.entities.insert(Entity {
            position: Position { x, y },
            velocity: Velocity { dx, dy },
            health: Health { current: 1, max: 1 },
            collider: Collider { radius: 4.0f32 },
            active: true,
            entity_type: EntityType.Projectile,
        })
    }
}

// System: Update positions based on velocities
// Takes the Rack directly — decoupled from GameState, works with any entity rack
func movement_system(mutate entities: Rack<Entity>, dt: f32) {
    for e in entities.nodes() {
        if !e.active { continue }

        e.position.x += e.velocity.dx * dt
        e.position.y += e.velocity.dy * dt
    }
}

// System: Check collisions between entities
func collision_system(mutate state: GameState) {
    mut to_check = state.entities.nodes()

    for i in 0..to_check.len() {
        for j in i + 1..to_check.len() {
            let e1 = to_check[i]
            let e2 = to_check[j]

            if !e1.active || !e2.active { continue }

            // Take the components the check needs, not the whole entity —
            // `Position` is 8 bytes and copies, an `Entity` doesn't
            // (mem.borrowing/E4).
            let p1 = e1.position
            let p2 = e2.position

            // Calculate distance
            let dx = p1.x - p2.x
            let dy = p1.y - p2.y
            let dist = (dx * dx + dy * dy).sqrt()
            let min_dist = e1.collider.radius + e2.collider.radius

            if dist < min_dist {
                resolve_collision(mutate state, e1, e2)
            }
        }
    }
}

func resolve_collision(mutate state: GameState, e1: Link<Entity>, e2: Link<Entity>) {
    let type1 = e1.entity_type
    let type2 = e2.entity_type

    // Player vs Enemy
    if type1 == EntityType.Player && type2 == EntityType.Enemy || type1 == EntityType.Enemy && type2 == EntityType.Player {
        let player = if type1 == EntityType.Player { e1 } else { e2 }
        let enemy = if type1 == EntityType.Enemy { e1 } else { e2 }

        player.health.current -= 10
        enemy.active = false

        if player.health.current <= 0 {
            state.game_over = true
        }
    }

    // Projectile vs Enemy
    if type1 == EntityType.Projectile && type2 == EntityType.Enemy || type1 == EntityType.Enemy && type2 == EntityType.Projectile {
        let enemy = if type1 == EntityType.Enemy { e1 } else { e2 }
        let proj = if type1 == EntityType.Projectile { e1 } else { e2 }

        enemy.health.current -= 25
        proj.active = false

        if enemy.health.current <= 0 {
            enemy.active = false
            state.score += 100
        }
    }
}

// System: Remove inactive entities
//
// `delete` nulls every `Link<Entity>?` field pointing at the node before it
// returns — so `state.player` becomes `none` on its own if the player dies,
// with nothing here to remember.
func cleanup_system(deleting state: GameState) {
    mut to_remove: Vec<Link<Entity>> = Vec.new()

    for e in state.entities.nodes() {
        if !e.active { to_remove.push(e) }
    }

    for e in to_remove {
        state.entities.delete(e)
    }
}

// System: Spawn enemies periodically
func spawn_system(mutate state: GameState, time_since_last_spawn: f32) -> f32 {
    let spawn_interval = 2.0f32

    if time_since_last_spawn >= spawn_interval {
        // Spawn enemy at right edge with random y. range() returns i64, which
        // widens to f32 losslessly here — f32()/f64() both return f64 (stdlib
        // convention), and there's no `as` conversion that narrows f64 to f32.
        let y = state.rng.range(50, 550).round<f32>()
        let _ = state.spawn_enemy(850.0f32, y)
        return 0.0f32  // Reset timer
    } else {
        return time_since_last_spawn
    }
}

// Movement update across all entities.
//
// The aspirational form (specs/concurrency/runtime.md:1807) splits the work
// across green tasks:
//
//     func parallel_movement_system(mutate entities: Rack<Entity>, dt: f32, num_threads: usize)
//         using Multitasking
//     {
//         let nodes = entities.nodes()
//         let chunk_size = (nodes.len() + num_threads - 1) / num_threads
//         mut tasks = Vec.new()
//         for chunk in nodes.chunks(chunk_size) {
//             let work = chunk.to_vec()
//             tasks.push(spawn(own || {
//                 for e in work {
//                     if !e.active: continue
//                     e.position.x += e.velocity.dx * dt
//                     e.position.y += e.velocity.dy * dt
//                 }
//             }))
//         }
//         for t in tasks { let _ = t.join() }
//     }
//
// This doesn't typecheck yet — two compiler gaps block it:
//   #267 `spawn` builtin not registered in the type checker
//   #268 `with mutex as v { ... }` doesn't unwrap to inner T
//
// A link is an address, so it also means nothing in another task's address
// space (mem.racks): sending the graph across needs `snapshot()`, which copies
// the nodes and re-points the internal edges. That is the real design question
// the gaps are hiding, and it's why this stays single-threaded rather than
// being one `spawn` away.
func parallel_movement_system(mutate entities: Rack<Entity>, dt: f32, num_threads: usize) {
    let _ = num_threads
    for e in entities.nodes() {
        if !e.active { continue }
        e.position.x += e.velocity.dx * dt
        e.position.y += e.velocity.dy * dt
    }
}

// Main game loop with fixed timestep and threading
func main() -> void or Error {
    mut state = GameState.new()

    let target_fps = 60.0f32
    let dt = 1.0f32 / target_fps
    let NUM_PHYSICS_THREADS: usize = 4u64

    mut last_time = 0.0f32  // Simplified: track elapsed time
    mut accumulator = 0.0f32
    mut spawn_timer = 0.0f32
    mut frame_count = 0

    println("Game started! Score: 0")

    // Thread pool for CPU-bound physics work
    using ThreadPool(workers: 4) {
        // Simulate game for a few seconds
        while !state.game_over && frame_count < 300 {
            // Simulate frame time (16ms = ~60fps)
            let frame_time = 0.016f32
            last_time += frame_time

            accumulator += frame_time

            // Fixed timestep updates
            while accumulator >= dt {
                // Handle input (simulated - would be real input in actual game)
                if frame_count % 30 == 0 {
                    // Fire projectile
                    if state.player? as player {
                        let px = player.position.x
                        let py = player.position.y
                        let _ = state.spawn_projectile(px + 20.0f32, py, 300.0f32, 0.0f32)
                    }
                }

                // Parallel physics: split entity updates across thread pool
                // Each thread processes a batch of entities
                // Borrow checker tracks that only state.entities is borrowed
                parallel_movement_system(mutate state.entities, dt, NUM_PHYSICS_THREADS)

                // Collision runs single-threaded (needs to see all entities)
                collision_system(mutate state)

                // Game logic on main thread
                spawn_timer = spawn_system(mutate state, spawn_timer + dt)
                cleanup_system(deleting state)

                accumulator -= dt
            }

            // Render (simulated - just print status occasionally)
            if frame_count % 60 == 0 {
                let entity_count = state.entities.len()
                mut player_health = 0
                if state.player? as player {
                    player_health = player.health.current
                }
                println("Frame {frame_count}: Entities={entity_count}, Health={player_health}, Score={state.score}")
            }

            frame_count += 1

            // In a real game, we'd sleep here to maintain frame rate
            // time.sleep(time.Duration.from_millis(16))
        }
    }

    if state.game_over {
        println("Game Over! Final Score: {state.score}")
    } else {
        println("Demo complete! Final Score: {state.score}")
    }
}
