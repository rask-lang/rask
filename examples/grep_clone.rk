// grep clone - Pattern Search CLI Tool
// Demonstrates: CLI args, file I/O, string operations, iteration, error handling

import cli
import fs
import io.IoError
import std
import string.StringView

struct GrepOptions {
    pattern: string
    ignore_case: bool
    line_numbers: bool
    count_only: bool
    invert_match: bool
}

func line_matches(line: StringView, opts: GrepOptions) -> bool {
    if opts.ignore_case {
        return line.to_lowercase().contains(opts.pattern.to_lowercase())
    }
    return line.contains(opts.pattern)
}

func grep_file(path: string, opts: GrepOptions) -> i64 or IoError {
    let content = try fs.read_text(path)

    mut match_count: i64 = 0
    for (i, line) in content.lines().enumerate() {
        if line_matches(line.view(), opts) == opts.invert_match { continue }
        match_count += 1
        if opts.count_only { continue }
        if opts.line_numbers {
            println("{i + 1}:{line}")
        } else {
            println("{line}")
        }
    }

    if opts.count_only { println("{match_count}") }
    return match_count
}

func main() {
    let args = cli.Parser.new("rgrep")
        .description("Print lines that contain PATTERN")
        .flag("ignore-case", "i", "Ignore case")
        .flag("line-number", "n", "Show line numbers")
        .flag("count", "c", "Count matching lines only")
        .flag("invert-match", "v", "Show non-matching lines")
        .positional("pattern", "Text to search for")
        .positional("files", "Files to search")
        .parse() catch e => {
            println("rgrep: {e}")
            std.exit(2)
        }

    let words = args.positional()
    let opts = GrepOptions(
        pattern: words[0]
        ignore_case: args.flag("ignore-case")
        line_numbers: args.flag("line-number")
        count_only: args.flag("count")
        invert_match: args.flag("invert-match")
    )

    mut total_matches = 0
    mut had_errors = false
    for path in words.skip(1) {
        if grep_file(path, opts) is i64 as found {
            total_matches += found
        } else as e {
            println("rgrep: {path}: {e}")
            had_errors = true
        }
    }

    if had_errors { std.exit(2) }
    if total_matches == 0 { std.exit(1) }
}
