// SPDX-License-Identifier: (MIT OR Apache-2.0)
// File Copy Utility
// Demonstrates: CLI arg parsing, structs, enums, match, error propagation,
//               @message error text, string interpolation, file I/O

import cli
import fs
import io.IoError
import std

@message
enum CopyError {
    @message("source file not found: {0}")
    SourceNotFound(string)
    @message("destination already exists: {0} (use -f to overwrite)")
    DestinationExists(string)
    @message("read error: {0}")
    ReadError(IoError)
    @message("write error: {0}")
    WriteError(IoError)
    @message("source and destination are the same file")
    SameFile
}

struct CopyOptions {
    source: string
    dest: string
    force: bool
    verbose: bool
}

func copy_file(opts: CopyOptions) -> u64 or CopyError {
    if !fs.exists(opts.source) {
        return CopyError.SourceNotFound(opts.source)
    }
    if fs.exists(opts.dest) && !opts.force {
        return CopyError.DestinationExists(opts.dest)
    }

    // Same file under two spellings: compare canonical paths
    let src_canonical = fs.absolute_path(opts.source) catch e => {
        return CopyError.ReadError(e)
    }
    let dst_canonical = fs.absolute_path(opts.dest) catch _ => none
    if dst_canonical? as dst {
        if src_canonical == dst { return CopyError.SameFile }
    }

    fs.copy(opts.source, opts.dest) catch e => {
        return CopyError.WriteError(e)
    }

    // fs.copy returns void — read the copied size back off disk for the report
    let meta = fs.metadata(opts.dest) catch e => {
        return CopyError.WriteError(e)
    }
    return meta.size
}

func format_size(bytes: u64) -> string {
    if bytes < 1024 { return "{bytes} B" }
    if bytes < 1048576 { return "{bytes / 1024} KB" }
    return "{bytes / 1048576} MB"
}

func main() {
    let args = cli.Parser.new("rcopy")
        .description("Copy SOURCE to DEST")
        .flag("force", "f", "Overwrite destination if it exists")
        .flag("verbose", "v", "Show progress information")
        .positional("source", "File to copy")
        .positional("dest", "Where to copy it")
        .parse() catch e => {
            println("rcopy: {e}")
            std.exit(2)
        }

    let words = args.positional()
    let opts = CopyOptions(
        source: words[0]
        dest: words[1]
        force: args.flag("force")
        verbose: args.flag("verbose")
    )

    if opts.verbose {
        println("Copying '{opts.source}' to '{opts.dest}'...")
    }

    let copied = copy_file(opts) catch e => {
        println("rcopy: {e}")
        std.exit(1)
    }
    if opts.verbose {
        println("Copied {format_size(copied)}")
    }
}
