// Learn: String methods and parsing

func main() {
    // Basic string creation
    let greeting = "Hello, Rask!"
    print("Original: ")
    print(greeting)
    print("\n\n")

    // String length
    print("Length: ")
    print(greeting.len())
    print("\n\n")

    // Case conversion
    let lower = greeting.to_lowercase()
    let upper = greeting.to_uppercase()

    print("Lowercase: ")
    print(lower)
    print("\n")

    print("Uppercase: ")
    print(upper)
    print("\n\n")

    // Trimming whitespace
    let messy = "   spaces everywhere   "
    print("Original: '")
    print(messy)
    print("'\n")

    let trimmed = messy.trim().to_string()
    print("Trimmed: '")
    print(trimmed)
    print("'\n")

    let trim_start = messy.trim_start().to_string()
    print("Trim start: '")
    print(trim_start)
    print("'\n")

    let trim_end = messy.trim_end().to_string()
    print("Trim end: '")
    print(trim_end)
    print("'\n\n")

    // Checking content
    let text = "The quick brown fox"

    if text.contains("quick") {
        print("Contains 'quick'\n")
    }

    if text.starts_with("The") {
        print("Starts with 'The'\n")
    }

    if text.ends_with("fox") {
        print("Ends with 'fox'\n")
    }
    print("\n")

    // Splitting strings
    let sentence = "one two three four five"
    let words = sentence.split_whitespace().to_vec()

    print("Words: ")
    for word in words.iter() {
        print("[")
        print(word)
        print("] ")
    }
    print("\n\n")

    // Split by delimiter
    let csv = "apple,banana,orange,grape"
    let fruits = csv.split(",").to_vec()

    print("Fruits: ")
    for fruit in fruits.iter() {
        print(fruit)
        print(" ")
    }
    print("\n\n")

    // String slicing
    let full = "Hello, World!"
    let slice1 = full[0..5].to_string()    // "Hello"
    let slice2 = full[7..].to_string()     // "World!"

    print("Slice [0..5]: ")
    print(slice1)
    print("\n")

    print("Slice [7..]: ")
    print(slice2)
    print("\n\n")

    // String interpolation
    let name = "Alice"
    let age = 30
    let formatted = "Name: {name}, Age: {age}"

    print(formatted)
    print("\n\n")

    // Multiple interpolated values
    let x = 10
    let y = 20
    let msg = "Point ({x}, {y})"
    print(msg)
    print("\n\n")

    // Parsing strings to numbers
    let num_str = "42"
    let parsed = num_str.parse<i32>()

    if parsed is i32 as n {
        print("Parsed number: ")
        print(n)
        print("\n")
    } else as e {
        print("Parse error: ")
        print("{e}")
        print("\n")
    }

    // Parsing with error handling
    let bad_str = "not a number"
    let bad_parsed = bad_str.parse<i32>()

    if bad_parsed is i32 as _n {
        print("This shouldn't happen\n")
    } else as e {
        print("Expected error: ")
        print("{e}")
        print("\n")
    }

    print("\n")

    // String concatenation
    let first = "Hello"
    let second = "World"
    let combined = "{first} {second}"

    print("Combined: ")
    print(combined)
    print("\n\n")

    // Working with individual characters
    let alpha = "abc"
    print("Iterating chars: ")
    for c in alpha.chars() {
        print(c)
        print(" ")
    }
    print("\n\n")

    // String replacement
    let original = "foo bar foo"
    let replaced = original.replace("foo", "baz")

    print("Original: ")
    print(original)
    print("\n")

    print("Replaced: ")
    print(replaced)
    print("\n\n")

    // Repeating strings
    let pattern = "ab"
    let repeated = pattern.repeat(3)

    print("Repeated: ")
    print(repeated)
    print("\n")
}
