// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Id newtypes and the two closed enums (Priority, Status).
//
// The ids are struct wrappers, not `type X = u64` nominal newtypes. On the
// spec that's a valid choice ("Custom data + behavior" in type.aliases), and
// it's the only one the current checker supports: a nominal newtype can't be
// extended with methods yet, and its `with (...)` traits don't resolve. As a
// struct, TaskId gets the auto-derived Equal/Hashable/Comparable for free and
// can carry `next()` — see FINDINGS.

struct TaskId { public value: u64 }

struct ProjectId { public value: u64 }

struct UserId { public value: u64 }

extend TaskId {
    func next(self) -> TaskId {
        return TaskId { value: self.value + 1 }
    }
}

extend ProjectId {
    func next(self) -> ProjectId {
        return ProjectId { value: self.value + 1 }
    }
}

extend UserId {
    func next(self) -> UserId {
        return UserId { value: self.value + 1 }
    }
}

// ─── Email ───────────────────────────────────────────────────────────
// A struct starts with the four core traits auto-derived — the setup OC1
// needs. Equality is case-insensitive: "Bo@x.io" and "bo@x.io" are the same
// account. That's a real semantic override, not field-wise equality.

struct EmailAddress {
    public raw: string
}

extend EmailAddress {
    func canonical(self) -> string {
        return self.raw.to_lowercase()
    }
}

// Custom Equal (EQ2).
extend EmailAddress with Equal {
    func eq(self, other: EmailAddress) -> bool {
        return self.raw.to_lowercase() == other.raw.to_lowercase()
    }
}

// OC1: the Equal override cancels the auto-derived Hashable (and Comparable).
// Hashable is redeclared here, consistent with the case-insensitive equality,
// so a Map keyed by EmailAddress stays correct. Comparable would also need
// redeclaring, but its signature returns `Ordering`, which the checker can't
// name yet — so EmailAddress stays non-Comparable (it's never sorted). See
// FINDINGS.
extend EmailAddress with Hashable {
    func hash(self) -> u64 {
        return self.raw.to_lowercase().hash()
    }
}

// ─── Priority ────────────────────────────────────────────────────────
// Variant order IS the ordering (CO1): Low < Medium < High < Urgent.
// Enums auto-derive the core traits; the list handler sorts by this directly.

enum Priority {
    Low
    Medium
    High
    Urgent
}

extend Priority {
    func from_label(s: string) -> Priority or ValidationError {
        match s {
            "low" => return Priority.Low
            "medium" => return Priority.Medium
            "high" => return Priority.High
            "urgent" => return Priority.Urgent
            _ => return ValidationError.BadEnum("priority", s)
        }
    }

    func label(self) -> string {
        match self {
            Low => return "low"
            Medium => return "medium"
            High => return "high"
            Urgent => return "urgent"
        }
    }
}

// ─── Status ──────────────────────────────────────────────────────────
// Used as a Map key for per-status counts — auto Hashable + Equal.

enum Status {
    Open
    InProgress
    Blocked
    Done
    Cancelled
}

extend Status {
    func from_label(s: string) -> Status or ValidationError {
        match s {
            "open" => return Status.Open
            "in_progress" => return Status.InProgress
            "blocked" => return Status.Blocked
            "done" => return Status.Done
            "cancelled" => return Status.Cancelled
            _ => return ValidationError.BadEnum("status", s)
        }
    }

    func label(self) -> string {
        match self {
            Open => return "open"
            InProgress => return "in_progress"
            Blocked => return "blocked"
            Done => return "done"
            Cancelled => return "cancelled"
        }
    }

    func is_terminal(self) -> bool {
        match self {
            Done => return true
            Cancelled => return true
            _ => return false
        }
    }
}
