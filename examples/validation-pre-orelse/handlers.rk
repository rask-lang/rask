// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Request handlers. Each returns `Response or ApiError`; the router turns the
// error side into an HTTP response once, at the top. Handlers propagate with
// `try` — a typed error lands in its ApiError variant on its own (ER31a) —
// and reach shared state through the module-level `store`/`metrics`/`config`.
//
// Store/metrics are reached with inline `.lock()` (MX3) rather than a `with`
// block: `with <module-level-const mutex> as v` doesn't unwrap to the inner
// type in the current checker, while inline access does. See FINDINGS.

import http
import json
import time

const started = time.Instant.now()

// ─── Small response bodies ───────────────────────────────────────────

struct HealthBody {
    public status: string
    public uptime_ms: i64
    public tasks: usize
}

struct OkBody {
    public ok: bool
}

struct BatchResult {
    public applied: usize
}

// ─── Batch request DTOs ──────────────────────────────────────────────

struct BatchRequest {
    public ops: Vec<BatchOp>
}

struct BatchOp {
    public op: string
    public task_id: u64
    public value: string?
    public dep_id: u64?
}

struct AddDepRequest {
    public dep_id: u64
}

struct CreateProjectRequest {
    public name: string
    public owner: u64
}

// ─── Health & metrics ────────────────────────────────────────────────

func handle_health() -> Response or ApiError {
    let count = store.lock().task_count()
    let up = started.elapsed()
    let body = HealthBody {
        status: "ok",
        uptime_ms: up.as_millis() saturate to i64,
        tasks: count,
    }
    return json_response(200, json.encode(body))
}

func handle_metrics() -> Response or ApiError {
    let summary = metrics.lock().summarize()
    return json_response(200, json.encode(summary))
}

// Deliberately fallible I/O so SysError reaches the boundary (os.SY1).
func handle_sleep(req: Request) -> Response or ApiError {
    let raw = req.query_param("ms") ?? "50"
    let ms = raw.parse<u64>() ?? return ApiError.BadRequest("ms must be a non-negative integer")
    try time.sleep(time.Duration.millis(ms))
    return json_response(200, json.encode(OkBody { ok: true }))
}

// ─── Tasks ───────────────────────────────────────────────────────────

func handle_list_tasks(req: Request) -> Response or ApiError {
    let filter = try build_filter(req)
    let page = store.lock().list_views(filter)
    return json_response(200, json.encode(page))
}

func handle_create_task(req: Request) -> Response or ApiError {
    let dto = try json.decode<CreateTaskRequest>(req.body) else |e| ApiError.BadRequest("invalid JSON")
    try dto.validate()

    let label = dto.priority ?? "medium"
    let priority = try Priority.from_label(label)
    let project = ProjectId { value: dto.project_id }

    let id = try store.lock().create_task(dto.title, project, priority)
    let view = try store.lock().view_task(id)
    return json_response(201, json.encode(view))
}

func handle_get_task(id: TaskId) -> Response or ApiError {
    let view = try store.lock().view_task(id)
    return json_response(200, json.encode(view))
}

func handle_update_task(id: TaskId, req: Request) -> Response or ApiError {
    let dto = try json.decode<UpdateTaskRequest>(req.body) else |e| ApiError.BadRequest("invalid JSON")
    try dto.validate()
    let patch = try build_patch(dto)

    let view = try store.lock().update_task(id, patch)
    return json_response(200, json.encode(view))
}

func handle_delete_task(id: TaskId) -> Response or ApiError {
    try store.lock().delete_task(id)
    return json_response(200, json.encode(OkBody { ok: true }))
}

func handle_add_dep(id: TaskId, req: Request) -> Response or ApiError {
    let dto = try json.decode<AddDepRequest>(req.body) else |e| ApiError.BadRequest("invalid JSON")
    let dep = TaskId { value: dto.dep_id }
    try store.lock().add_dependency(id, dep)
    return json_response(200, json.encode(OkBody { ok: true }))
}

func handle_batch(req: Request) -> Response or ApiError {
    let dto = try json.decode<BatchRequest>(req.body) else |e| ApiError.BadRequest("invalid JSON")

    mut ops = Vec.new()
    for raw in dto.ops {
        ops.push(try to_txop(raw))
    }

    let applied = ops.len()
    try store.lock().apply_batch(ops)
    return json_response(200, json.encode(BatchResult { applied: applied }))
}

// ─── Users & projects ────────────────────────────────────────────────

func handle_create_user(req: Request) -> Response or ApiError {
    let dto = try json.decode<CreateUserRequest>(req.body) else |e| ApiError.BadRequest("invalid JSON")
    try dto.validate()

    let email = EmailAddress { raw: dto.email }
    let id = try store.lock().create_user(dto.name, email)
    let view = try store.lock().view_user(id)
    return json_response(201, json.encode(view))
}

func handle_get_user(id: UserId) -> Response or ApiError {
    let view = try store.lock().view_user(id)
    return json_response(200, json.encode(view))
}

func handle_create_project(req: Request) -> Response or ApiError {
    let dto = try json.decode<CreateProjectRequest>(req.body) else |e| ApiError.BadRequest("invalid JSON")
    if dto.name.is_empty() { return ApiError.BadRequest("project name required") }

    let owner = UserId { value: dto.owner }
    let id = try store.lock().create_project(dto.name, owner)
    return json_response(201, json.encode(ProjectView {
        id: id.value,
        name: dto.name,
        owner: dto.owner,
        archived: false,
    }))
}

// ─── Parsing helpers ─────────────────────────────────────────────────

func build_filter(req: Request) -> ListFilter or ValidationError {
    mut f = ListFilter.new()
    if req.query_param("status")? as s   { f.status = try Status.from_label(s) }
    if req.query_param("priority")? as p { f.priority = try Priority.from_label(p) }
    if req.query_param("offset")? as o   { f.offset = o.parse<usize>() ?? 0 }
    if req.query_param("limit")? as l    { f.limit = l.parse<usize>() ?? 50 }
    return f
}

func build_patch(dto: UpdateTaskRequest) -> TaskPatch or ValidationError {
    mut p = TaskPatch.new()
    if dto.status? as s    { p.status = try Status.from_label(s) }
    if dto.priority? as pr { p.priority = try Priority.from_label(pr) }
    if dto.assignee? as a  { p.assignee = UserId { value: a } }
    if dto.add_tags? as tags { p.add_tags = tags }
    return p
}

func to_txop(raw: BatchOp) -> TxOp or ValidationError {
    let id = TaskId { value: raw.task_id }
    match raw.op {
        "status" => {
            let v = raw.value ?? return ValidationError.Empty("value")
            let st = try Status.from_label(v)
            return TxOp.SetStatus(id, st)
        }
        "priority" => {
            let v = raw.value ?? return ValidationError.Empty("value")
            let pr = try Priority.from_label(v)
            return TxOp.SetPriority(id, pr)
        }
        "dep" => {
            let d = raw.dep_id ?? return ValidationError.Empty("dep_id")
            return TxOp.AddDep(id, TaskId { value: d })
        }
        _ => return ValidationError.BadEnum("op", raw.op),
    }
}
