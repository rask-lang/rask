// L3 — scene tree, with Store + Link. Reparent and subtree delete.
//
// This is the program that exercises edge *lists*: `children: Vec<Link<Node>>`.
// Deleting a node drops it out of its parent's children list — the entry does
// not become `none`, it disappears, which is what a list of live things means.
//
// `selected` is a root edge on the editor, so deleting the selected node
// clears the selection with no code in `delete_subtree` saying so.

struct SceneNode {
    name: string
    parent: Link<SceneNode>?
    children: Vec<Link<SceneNode>>
}

struct Scene {
    nodes: Store<SceneNode>
    root: Link<SceneNode>?
    selected: Link<SceneNode>?
}

func add_child(mutate scene: Scene, parent: Link<SceneNode>, name: string) -> Link<SceneNode> {
    let n = scene.nodes.insert(SceneNode { name: name, parent: parent, children: Vec.new() })
    parent.children.push(n)
    return n
}

// Reparent. The inverse (`parent` <-> `children`) is NOT compiler-maintained in
// this prototype, so both sides are written by hand — same as the handle
// version. See the write-up: `inverse` is the piece that would make this one
// assignment, and it is not implemented here.
func reparent(n: Link<SceneNode>, new_parent: Link<SceneNode>) {
    if n.parent? as old {
        old.children = old.children.filter(|c| c != n)
    }
    new_parent.children.push(n)
    n.parent = new_parent
}

// No cascade policy in the prototype either, so the recursion is explicit.
// What delete DOES do for free: drop `n` from its parent's children list,
// and clear `scene.selected` if it pointed here.
func delete_subtree(mutate scene: Scene, n: Link<SceneNode>) {
    let kids = n.children.clone()
    for c in kids {
        delete_subtree(scene, c)
    }
    scene.nodes.delete(n)
}

func print_tree(n: Link<SceneNode>, indent: string) {
    println("{indent}{n.name}")
    for c in n.children {
        print_tree(c, "{indent}  ")
    }
}

func report(scene: Scene) {
    if scene.root? as r {
        print_tree(r, "   ")
    }
    mut sel = "none"
    if scene.selected? as s {
        sel = s.name
    }
    println("   selected = {sel}, nodes = {scene.nodes.len()}")
}

func main() {
    mut scene = Scene { nodes: Store.new(), root: none, selected: none }

    let root = scene.nodes.insert(SceneNode { name: "root", parent: none, children: Vec.new() })
    scene.root = root

    let a = add_child(scene, root, "a")
    let b = add_child(scene, root, "b")
    let a1 = add_child(scene, a, "a1")
    let a2 = add_child(scene, a, "a2")

    println("-- initial")
    report(scene)

    println("-- reparent a1 under b")
    reparent(a1, b)
    report(scene)

    println("-- select a2, then delete the subtree at a")
    scene.selected = a2
    report(scene)
    delete_subtree(scene, a)
    report(scene)
    let _ = a2
    let _ = b
}
