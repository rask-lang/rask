// SPDX-License-Identifier: (MIT OR Apache-2.0)
// The hole in the model as prototyped: a link held in a LOCAL survives the
// delete that was supposed to fix every reference to its node.
//
// The fourth-option analysis knows about this — rule 1 says links live only in
// node fields, and locals hold block-scoped borrows. What the analysis does not
// say is what that rule means when `store.insert()` hands a link straight into
// a local, which is the first thing every program does.
//
// The borrow rule that reconciles those two is the piece that decides whether
// this model ships. It is not written anywhere, and it is not implemented here,
// so this program runs and prints a read and a write through a deleted node.
//
// In the real design links are raw pointers, so this is a use-after-free.

struct Node {
    name: string
    health: i32
    next: Link<Node>?
}

func main() {
    mut store: Store<Node> = Store.new()

    let a = store.insert(Node { name: "a", health: 1, next: none })
    let b = store.insert(Node { name: "b", health: 2, next: none })
    a.next = b

    store.delete(b)

    // The edge INSIDE a node was fixed. This is the model working.
    if a.next? as t {
        println("a.next -> {t.name}   (edge NOT fixed -- model broken)")
    } else {
        println("a.next = none        (edge fixed at delete -- model working)")
    }

    // The link in a LOCAL was not, because the fixup walk cannot see locals.
    println("local link still reads:  name={b.name} health={b.health}")
    b.health = 99
    println("local link still writes: health={b.health}")

    println("store len = {store.len()}   (b is gone from the store)")
}
