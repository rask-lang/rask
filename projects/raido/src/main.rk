// Raido demo: run hand-assembled fib on the VM. The tests are in tests.rk.

func main() {
    mut chunk = Chunk.new()
    chunk.add_proto(fib_proto(0))
    print(chunk.protos[0].disassemble())
    mut vm = Vm.new(chunk, Config(memory_limit: 65536, initial_fuel: 1_000_000, max_call_depth: 256))
    match vm.call(0, Vec<Value>.from([Value.from_int(20)])) {
        Value as v => println("fib(20) = {v.bits}, fuel left {vm.fuel}")
        VmError as e => println("error: {e.message()}")
    }
}
