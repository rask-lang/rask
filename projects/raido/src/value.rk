// Raido values: an 8-byte tag word and an 8-byte payload (vm/architecture.md,
// Value Representation).
//
// No instruction reads the tag; the compiler knows every register's type. The
// collector reads it to find references, and serialization reads it to write
// a value without knowing its static type.
//
// A Raido `float` is a Rask f64, held here as its bit pattern. The VM raises
// an error on any operation that would produce NaN or an infinity, so neither
// ever lives in a register.

// The low byte of the tag word. Zero is unused so a zeroed word is invalid.
const TAG_INT: i64 = 1
const TAG_FLOAT: i64 = 2
const TAG_BOOL: i64 = 3
const TAG_NONE: i64 = 4
const TAG_FUNC: i64 = 5
const TAG_ENUM: i64 = 6
const TAG_REF: i64 = 7
const TAG_EXTERN: i64 = 8

struct Value {
    tag: i64
    bits: i64
}

extend Value {
    func from_int(n: i64) -> Value {
        return Value(tag: TAG_INT, bits: n)
    }

    func from_float(x: f64) -> Value {
        return Value(tag: TAG_FLOAT, bits: x.to_bits().wrap<i64>())
    }

    func from_bool(b: bool) -> Value {
        return Value(tag: TAG_BOOL, bits: if b { 1 } else { 0 })
    }

    // `None` is depth 0; `Some(None)` is depth 1, and so on.
    func none() -> Value {
        return Value(tag: TAG_NONE, bits: 0)
    }

    func func_ref(proto: i64) -> Value {
        return Value(tag: TAG_FUNC, bits: proto)
    }

    func enum_disc(disc: i64) -> Value {
        return Value(tag: TAG_ENUM, bits: disc)
    }

    func ref_to(slot: i64) -> Value {
        return Value(tag: TAG_REF, bits: slot)
    }

    // The extern struct's type index rides in the tag word above the kind byte.
    func extern_ref(type_idx: i64, id: i64) -> Value {
        return Value(tag: TAG_EXTERN | type_idx << 8, bits: id)
    }

    func kind(self) -> i64 {
        return self.tag & 0xFF
    }

    func extern_type(self) -> i64 {
        return self.tag >> 8
    }

    func is_ref(self) -> bool {
        return self.kind() == TAG_REF
    }

    func as_float(self) -> f64 {
        return f64.from_bits(self.bits.wrap<u64>())
    }

    func as_bool(self) -> bool {
        return self.bits != 0
    }

    // Optionals cost nothing: `Some(x)` of a non-none value is `x` itself,
    // and wrapping a none adds one to its depth.
    func wrap_some(self) -> Value {
        if self.kind() == TAG_NONE {
            return Value(tag: TAG_NONE, bits: self.bits + 1)
        }
        return self
    }

    func is_some(self) -> bool {
        return self.kind() != TAG_NONE || self.bits > 0
    }

    // Caller checks `is_some` first; unwrapping `None` is the VM's error.
    func unwrap_some(self) -> Value {
        if self.kind() == TAG_NONE {
            return Value(tag: TAG_NONE, bits: self.bits - 1)
        }
        return self
    }

    func same(self, other: Value) -> bool {
        return self.tag == other.tag && self.bits == other.bits
    }
}
