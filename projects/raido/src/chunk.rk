// Chunk and Prototype — the compiled output of the Raido compiler
//
// A Prototype is one function's bytecode. A Chunk holds every prototype in
// one flat list, so `FUNC_REF Bx` and `CLOSURE Bx` name a prototype by index,
// plus the struct layouts `NEW_STRUCT` needs and the module variables.
//
// Module variables are initialised by the `init` prototype, which the VM
// runs once at load as its own transaction.

struct Prototype {
    code: Vec<u32>
    constants: Vec<Value>
    num_registers: i64
    arity: i64
    captures: i64
    name: string
    lines: Vec<i64>
}

extend Prototype {
    func new(name: string, arity: i64, num_registers: i64) -> Prototype {
        return Prototype(
            code: Vec.new()
            constants: Vec.new()
            num_registers: num_registers
            arity: arity
            captures: 0
            name: name
            lines: Vec.new()
        )
    }

    func add_constant(mutate self, v: Value) -> i64 {
        self.constants.push(v)
        return self.constants.len().wrap<i64>() - 1
    }

    func disassemble(self) -> string {
        mut out = "== {self.name} (regs={self.num_registers}, args={self.arity}) ==\n"
        mut i: i64 = 0
        let count = self.code.len().wrap<i64>()
        while i < count {
            out = "{out}{disassemble_instr(self.code[i], i)}\n"
            i = i + 1
        }
        return out
    }
}

// A tuple is a struct the language doesn't name; it compares by content.
struct StructLayout {
    name: string
    field_count: i64
    is_tuple: bool
}

struct Chunk {
    protos: Vec<Prototype>
    structs: Vec<StructLayout>
    module_vars: i64
    init: i64
    imports: Vec<string>
    module_imports: Vec<string>
    exports: Vec<string>
}

extend Chunk {
    func new() -> Chunk {
        return Chunk(
            protos: Vec.new()
            structs: Vec.new()
            module_vars: 0
            init: -1
            imports: Vec.new()
            module_imports: Vec.new()
            exports: Vec.new()
        )
    }

    func add_proto(mutate self, take p: Prototype) -> i64 {
        self.protos.push(p)
        return self.protos.len().wrap<i64>() - 1
    }

    func find(self, name: string) -> i64? {
        mut i: i64 = 0
        let n = self.protos.len().wrap<i64>()
        while i < n {
            if self.protos[i].name == name {
                return i
            }
            i = i + 1
        }
        return none
    }
}
