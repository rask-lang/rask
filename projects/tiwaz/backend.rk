import sync.Mutex

struct BackendPool {
    backends: Vec<Backend>
    index: Shared<usize, Mutex>
}

struct Backend {
    url: string
}

extend BackendPool {
    func next_healthy(self) -> Backend or ProxyError {
        with self.index.write() as idx {
            let count = self.backends.len()
            mut checked = 0
            loop {
                if checked >= count {
                    return ProxyError.UpstreamUnreachable
                }
                let backend = self.backends[idx]
                idx = (idx + 1) % count
                checked = checked + 1
                with status.read() as s {
                    let healthy = s.get(backend.url)
                    // Treat unknown backends as healthy until a health check runs.
                    if healthy is none || healthy == true {
                        return backend
                    }
                }
            }
        }
    }
}


