enum ProxyError {
    UpstreamUnreachable
    UpstreamTimeout
    BadResponse
    NoMatchingRoute
}

extend ProxyError {
    public func message(self) -> string {
        match self {
            ProxyError.UpstreamUnreachable => return "upstream unreachable",
            ProxyError.UpstreamTimeout    => return "upstream timeout",
            ProxyError.BadResponse        => return "bad response from upstream",
            ProxyError.NoMatchingRoute    => return "no matching route",
        }
    }

    /// The response a client gets when proxying fails: a gateway error for
    /// an upstream that's down or slow, a 404 when no route matches.
    public func to_response(self) -> Response {
        return match self {
            ProxyError.UpstreamUnreachable => Response.new(502, self.message())
            ProxyError.UpstreamTimeout => Response.new(504, self.message())
            ProxyError.BadResponse => Response.new(502, self.message())
            ProxyError.NoMatchingRoute => Response.not_found()
        }
    }
}
