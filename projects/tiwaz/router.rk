struct MatchedRoute {
    path: string
    pool: BackendPool
}

func match_route(path: string, routes: Vec<Route>) -> MatchedRoute? {
    for route in routes {
        if path.starts_with(route.prefix) {
            let stripped = path[route.prefix.len()..path.len()].to_string()
            return MatchedRoute { path: stripped, pool: route.pool }
        }
    }
    return none
}
