import time.Instant

func logging(next: |Request| -> Response) -> |Request| -> Response {
    return |request: Request| {
        println("Received request: {request.method} {request.path()}")
        let start = Instant.now()
        let response = next(request)
        let duration = start.elapsed().as_millis()
        println("Request processed in {duration} ms")
        println("Responding with status: {response.status}")
        return response.clone()
    }
}

// W9 (tool.warnings) points at the four counter writes below. These are
// counters: a panic between two of them leaves the totals briefly disagreeing
// with each other, which nothing here reads as an invariant. `staged()` would
// clone the metrics struct on every request to protect a consistency this
// doesn't need.
@allow(torn_lock_update)
func with_metrics(next: |Request| -> Response) -> |Request| -> Response {
    return |request: Request| {
        let response = next(request)
        with metrics.write() as m {
            m.request_count = m.request_count + 1
            if response.status >= 400 {
                m.error_count = m.error_count + 1
            }
            m.bytes_sent = m.bytes_sent + response.body.len()
            m.bytes_received = m.bytes_received + request.body.len()
        }
        return response.clone()
    }
}
