// QUIC over one UDP socket, through ngtcp2 (quic/ting_quic.c).
//
// ngtcp2 does the transport: acks, loss recovery, congestion and flow control.
// A reliable message rides one QUIC stream per direction and arrives once and
// in order. An unreliable one is a QUIC DATAGRAM frame and may not arrive.
// This file moves datagrams between the socket and ngtcp2, once a tick.
//
// Barebones: the crypto callbacks are a null cipher and a fake handshake that
// only swaps transport parameters. Nothing is encrypted or authenticated.
//
// Native only. `extern "C"` needs a C ABI, which the interpreter doesn't have.

import net
import net.UdpSocket
import io.IoError
import string.cstring

// None of these wait: ngtcp2 is a state machine, and the socket is this
// file's. They do read the clock and ask for random bytes.
@ambient
extern "C" {
    func ting_quic_new(local: *u8, remote: *u8?) -> *u8?
    func ting_quic_free(quic: *u8)
    func ting_quic_receive(quic: *u8, pkt: *u8, len: i64, from: *u8) -> i64
    func ting_quic_send(quic: *u8, peer: *u8, data: *u8, len: i64, reliable: i64) -> i64
    func ting_quic_next_packet(quic: *u8, out: *u8, cap: i64, to: *u8, to_cap: i64) -> i64
    func ting_quic_next_message(quic: *u8, out: *u8, cap: i64, from: *u8, from_cap: i64, reliable: *i64) -> i64
    func ting_quic_connected(quic: *u8, peer: *u8) -> i64
    func ting_quic_unacked(quic: *u8, peer: *u8) -> i64
}

/// Room for one datagram or one message.
const BUF: i64 = 65536
/// Room for one "ip:port".
const ADDR: i64 = 64
/// The largest UDP payload ngtcp2 is told to write.
const PACKET: i64 = 1200

public struct Message {
    public from: string
    public data: Vec<u8>
    public reliable: bool
}

/// Where C writes what it hands back: a packet or a message, the address it
/// goes to or came from, and whether a message was reliable.
struct Scratch {
    bytes: Vec<u8>
    addr: Vec<u8>
    reliable: Vec<i64>
}

@resource
public struct Endpoint {
    socket: UdpSocket
    // Absent only while `start` builds it: the socket has to be in the
    // endpoint, with its close committed, before its address can be read.
    quic: *u8?
    out: Scratch
}

extend Endpoint {
    /// A server: accepts a connection from any client that sends to `addr`.
    public func listen(addr: string) -> Endpoint or IoError {
        let socket = try net.udp_bind(addr)
        return Endpoint.start(socket, "")
    }

    /// A client of the server at `server`, from a socket bound to `local`.
    /// Messages queued before the handshake finishes go once it has.
    public func connect(local: string, server: string) -> Endpoint or IoError {
        let socket = try net.udp_bind(local)
        return Endpoint.start(socket, server)
    }

    func start(take socket: UdpSocket, server: string) -> Endpoint or IoError {
        mut ep = Endpoint(
            socket: socket
            quic: none
            out: Scratch(bytes: zeroed(BUF), addr: zeroed(ADDR), reliable: [0])
        )
        ensure ep.close()
        let local = ep.socket.local_addr()
        let here = c_text(local)
        let there = c_text(server)
        ep.quic = unsafe ting_quic_new(here.as_ptr(), if server.is_empty() { none } else { there.as_ptr() })
        if ep.quic is none {
            return IoError.Other("not an address QUIC can use: {local} / {server}")
        }
        return ep
    }

    /// The QUIC state. Every endpoint `start` hands out has one.
    func handle(self) -> *u8 {
        return self.quic!
    }

    public func local_addr(self) -> string {
        return self.socket.local_addr()
    }

    public func close(take self) -> void or IoError {
        if self.quic? as quic {
            unsafe ting_quic_free(quic)
        }
        try self.socket.close()
        return
    }

    /// Queue `data` for `to`. It leaves on the next `flush`. Fails when there
    /// is no connection to `to`: a server has one once that client has sent.
    public func send(mutate self, to: string, data: Vec<u8>, reliable: bool) -> void or IoError {
        let peer = c_text(to)
        let kind: i64 = if reliable { 1 } else { 0 }
        let r = unsafe ting_quic_send(self.handle(), peer.as_ptr(), data.as_ptr(), data.len().wrap<i64>(), kind)
        if r < 0 {
            return IoError.Other("no connection to {to}")
        }
        return
    }

    /// Hand everything ngtcp2 wants sent to the socket: new data, resends,
    /// acks, timers that came due.
    public func flush(mutate self) -> void or IoError {
        loop {
            let n = unsafe ting_quic_next_packet(self.handle(), self.out.bytes.as_mut_ptr(), PACKET, self.out.addr.as_mut_ptr(), ADDR)
            if n <= 0 {
                return
            }
            let to = unsafe string.from_c(self.out.addr.as_ptr())
            try self.socket.send_to(self.out.bytes.take(n.wrap<usize>()).to_vec(), to)
        }
    }

    /// Feed ngtcp2 every datagram that has arrived, without waiting, and
    /// return the messages that are now delivered.
    public func poll(mutate self) -> Vec<Message> or IoError {
        loop {
            let d = try self.socket.try_receive_from() ?? {
                break
            }
            let from = c_text(d.from)
            // A packet ngtcp2 can't read is dropped, as QUIC drops them.
            unsafe ting_quic_receive(self.handle(), d.data.as_ptr(), d.data.len().wrap<i64>(), from.as_ptr())
        }
        mut got: Vec<Message> = []
        loop {
            let n = unsafe ting_quic_next_message(self.handle(), self.out.bytes.as_mut_ptr(), BUF, self.out.addr.as_mut_ptr(), ADDR, self.out.reliable.as_mut_ptr())
            if n < 0 {
                return got
            }
            got.push(Message(
                from: unsafe string.from_c(self.out.addr.as_ptr())
                data: self.out.bytes.take(n.wrap<usize>()).to_vec()
                reliable: self.out.reliable[0] == 1
            ))
        }
    }

    /// Whether the handshake with `peer` is done.
    public func connected(self, peer: string) -> bool {
        let p = c_text(peer)
        return unsafe ting_quic_connected(self.handle(), p.as_ptr()) == 1
    }

    /// Reliable messages to `peer` not yet acknowledged.
    public func unacked(self, peer: string) -> i64 {
        let p = c_text(peer)
        return unsafe ting_quic_unacked(self.handle(), p.as_ptr())
    }
}

/// `n` zero bytes, for C to write into.
func zeroed(n: i64) -> Vec<u8> {
    mut v: Vec<u8> = Vec.with_capacity(n.wrap<usize>())
    for _ in 0..n {
        v.push(0)
    }
    return v
}

/// `s` as a C string. An address never holds a NUL, so this can't fail.
func c_text(s: string) -> cstring {
    let c = s.to_cstring() catch _ => {
        panic("an address held a NUL byte: {s}")
    }
    return c
}
