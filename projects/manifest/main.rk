// manifest load <rask.toml>          check it and print what the compiler would see
// manifest migrate <rask.toml> <N>   rewrite it for version N, either direction
// manifest check                     replay the schema's history against its shape
// manifest json-schema               print the schema as JSON Schema, for editors

import fs
import os

func main() {
    let args = os.args()
    if args.len() < 2 {
        usage()
    }
    let cmd = args[1].clone()
    if cmd == "check" {
        check_history(package_schema()) catch e => fail(e.message())
        println("rask-package: history replays to the current shape (version {package_schema().version()})")
    } else if cmd == "json-schema" {
        println(json_schema(package_schema()))
    } else if cmd == "load" && args.len() == 3 {
        match load_package(read_or_fail(args[2])) {
            Package as pkg => print_package(pkg),
            LoadError as e => fail(e.message()),
        }
    } else if cmd == "migrate" && args.len() == 4 {
        match args[3].parse<i64>() {
            i64 as to => {
                match migrate(read_or_fail(args[2]), package_schema(), to) {
                    string as out => print(out),
                    LoadError as e => fail(e.message()),
                }
            }
            ParseError => fail("version must be a number, got `{args[3]}`"),
        }
    } else {
        usage()
    }
}

func read_or_fail(path: string) -> string {
    match fs.read_text(path) {
        string as text => return text,
        IoError as e => {
            fail("{path}: {e.message()}")
            return ""
        }
    }
}

func usage() {
    fail("usage: manifest load <file> | migrate <file> <version> | check | json-schema")
}

func fail(msg: string) {
    eprintln(msg)
    os.exit(1)
}

func print_package(p: Package) {
    println("{p.name} {p.version}")
    if p.description? as d {
        println("  description: {d}")
    }
    println("  sandbox: {p.sandbox}")
    print_deps("  ", "dependencies", p.dependencies)
    print_deps("  ", "dev-dependencies", p.dev_dependencies)
    print_deps("  ", "build-dependencies", p.build_dependencies)
    for f in p.features {
        println("  feature {f.name} (default {f.on_by_default}) enables [{f.enables.join(", ")}]")
        print_deps("    ", "dependencies", f.dependencies)
        print_deps("    ", "dev-dependencies", f.dev_dependencies)
        print_deps("    ", "build-dependencies", f.build_dependencies)
    }
    for g in p.exclusive_features {
        println("  exclusive feature {g.name} (default {g.default})")
        for o in g.options {
            print_deps("    ", "option {o.name}", o.dependencies)
        }
    }
    for pr in p.profiles {
        mut line = "  profile {pr.name}"
        if pr.inherits? as i {
            line = "{line} inherits {i}"
        }
        if pr.debug_info? as d {
            line = "{line} debug-info {d}"
        }
        println(line)
    }
}

func print_deps(indent: string, label: string, deps: Vec<Dep>) {
    if deps.is_empty() {
        return
    }
    println("{indent}{label}:")
    for d in deps {
        mut line = "{indent}  {d.name}: {d.source.describe()}"
        if d.target? as t {
            line = "{line} target {t}"
        }
        if !d.with.is_empty() {
            line = "{line} with [{d.with.join(", ")}]"
        }
        if !d.allow.is_empty() {
            line = "{line} allow [{d.allow.join(", ")}]"
        }
        for (group, option) in d.select {
            line = "{line} select {group}={option}"
        }
        println(line)
    }
}
