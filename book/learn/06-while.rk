//
// 6. while
//
// `while` repeats its block as long as the condition holds. Parameters are
// `let` names, so a function that counts something down copies the value into
// a `mut` name first.

func halvings(n: i32) -> i32 {
    mut left = n
    mut steps = 0
    while left > 1 {
        left = left / 2
        steps += 1
    }
    return steps
}

// Integer division drops the remainder: 7 / 2 == 3.
//
// Your turn: `digit_sum(1234)` is 1 + 2 + 3 + 4 = 10. `n % 10` is the last
// digit and `n / 10` drops it.

func digit_sum(n: i32) -> i32 {
    todo()
}

test "halvings" {
    assert halvings(8) == 3
    assert halvings(1) == 0
}

test "digit sum" {
    assert digit_sum(1234) == 10
    assert digit_sum(7) == 7
    assert digit_sum(0) == 0
    assert digit_sum(90210) == 12
    assert digit_sum(1999999999) == 82
}

