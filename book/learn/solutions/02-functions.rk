//
// 2. Functions
//
// A function says what it takes and what it gives back. It gives the value
// back with `return`, every time: the last line of a function is not returned
// on its own, the way it is in Rust or Ruby.

func double(n: i32) -> i32 {
    return n * 2
}

// `i32` is a 32-bit integer. You'll also meet `i64`, `f64` (a float), `bool`
// and `string`.
//
// Your turn: make `square` give back n times n. The `test` blocks at the
// bottom check it. Run them with
//
//     rask test 02-functions.rk
//
// and they fail with "not yet implemented" until you replace `todo()`.

func square(n: i32) -> i32 {
    return n * n
}

test "double" {
    assert double(4) == 8
}

test "square" {
    assert square(3) == 9
    assert square(-4) == 16
}
