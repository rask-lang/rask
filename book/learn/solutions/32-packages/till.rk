//
// Your turn: `total` adds up what the items cost, with `price_of` from
// prices.rk. Something without a price counts as 0.

public func total(items: Vec<string>) -> i32 {
    mut sum = 0
    for item in items {
        sum += price_of(item) ?? 0
    }
    return sum
}
