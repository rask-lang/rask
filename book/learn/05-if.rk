//
// 5. if and else
//
// The condition needs no parentheses. The block after it always has braces,
// even when it's one line.

func abs(n: i32) -> i32 {
    if n < 0 {
        return -n
    }
    return n
}

// `if` also gives a value. When each side is a single expression, write it
// after a colon instead of a block:
//
//     let kind = if n % 2 == 0: "even" else: "odd"
//
// `%` is the remainder, so `9 % 3 == 0`.
//
// Your turn: `fizz` gives "Fizz" for multiples of 3, "Buzz" for multiples of
// 5, "FizzBuzz" for multiples of both, and the number itself otherwise.
// Chain the cases with `else if`.

func fizz(n: i32) -> string {
    todo()
}

test "abs" {
    assert abs(-3) == 3
    assert abs(3) == 3
}

test "fizz" {
    assert fizz(9) == "Fizz"
    assert fizz(10) == "Buzz"
    assert fizz(30) == "FizzBuzz"
    assert fizz(7) == "7"
}

