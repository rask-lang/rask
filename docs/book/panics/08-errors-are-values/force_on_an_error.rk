enum ParseError {
    UnknownVerb(string)
}

extend ParseError {
    func message(self) -> string {
        return match self {
            ParseError.UnknownVerb(v) => "I don't know how to '{v}'.",
        }
    }
}

func parse(line: string) -> string or ParseError {
    if line == "look" {
        return line
    }
    return ParseError.UnknownVerb(line)
}

func main() {
    let verb = parse("dance")!
    println(verb)
}
