// Panics: `!` on a value that turned out to be an error
//
// type.errors/ER15: `!` extracts the success value, or panics using the
// error's own `message()`. It is the fourth thing you can put in the error
// arm — stop — and the only one that doesn't hand the caller anything.

// ANCHOR: body
func main() {
    let port = "eighty-eighty".parse<i64>()!
    println("listening on {port}")
}
// ANCHOR_END: body
