// SPDX-License-Identifier: (MIT OR Apache-2.0)
struct Item {
    name: string
    description: string
}

struct World {
    here: u64
    carried: Vec<Item>
}

func go(mutate world: World, to: u64) {
    world.here = to
}

func main() {
    mut world = World(here: 0, carried: Vec.new())
    go(world, 1)
}
