enum ParseError {
    UnknownVerb(string)
}

extend ParseError {
    func message(self) -> string {
        return "I don't know how to do that."
    }
}

func parse(line: string) -> string or ParseError {
    if line == "look" {
        return line
    }
    return ParseError.UnknownVerb(line)
}

func show(line: string) {
    let verb = try parse(line)
    println(verb)
}

func main() {
    show("dance")
}
