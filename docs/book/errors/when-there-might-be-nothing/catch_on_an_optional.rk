// Compile Error: `catch` on an optional
// Rejects: `p.email catch _ => "none"` — there is no error to bind
//
// type.errors/ER14: `catch` names or drops an error. Absence carries no
// payload, so the fallback for it is `??`.

struct Profile {
    name: string
    email: string?
}

func main() {
    let p = Profile { name: "ada", email: none }
    let address = p.email catch _ => "no email"
    println(address)
}
