import memory.Rack
import memory.Link

struct Room {
    name: string
    north: Link<Room>?
}

struct World {
    rooms: Rack<Room>
}

extend World {
    func collapse(mutate self, name: string) -> bool {
        for r in self.rooms.nodes() {
            if r.name == name {
                self.rooms.delete(r)
                return true
            }
        }
        return false
    }
}

func main() {
    mut w = World(rooms: Rack.new())
    let cellar = w.rooms.insert(Room(name: "Cellar", north: none))
    let tunnel = w.rooms.insert(Room(name: "Tunnel", north: none))
    cellar.north = tunnel
    w.collapse("Tunnel")
    println(cellar.name)
}
