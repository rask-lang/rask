// Must not compile: a `mutate` parameter needs the marker at the call site.
// Quoted by docs/book/src/guide/passing-values.md; rendering in .out.

struct Account {
    owner: string
    balance: i64
}

func deposit(mutate account: Account, amount: i64) {
    account.balance += amount
}

func main() {
    mut account = Account { owner: "Ada", balance: 100 }
    deposit(account, 50)
    println("{account.balance}")
}
