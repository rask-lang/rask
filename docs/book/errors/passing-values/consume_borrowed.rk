// Must not compile: a borrowed parameter isn't the callee's to give away.
// Quoted by docs/book/src/guide/passing-values.md; rendering in .out.

struct Account {
    owner: string
    balance: i64
}

func close_out(take account: Account) -> i64 {
    return account.balance
}

func describe(account: Account) -> i64 {
    return close_out(account)
}

func main() {
    let account = Account { owner: "Ada", balance: 100 }
    println("{describe(account)}")
}
