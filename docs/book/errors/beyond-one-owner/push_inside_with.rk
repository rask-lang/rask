// Must not compile: growing a Vec while a view into it is open.

struct Item {
    count: i64
}

func main() {
    // ANCHOR: body
    mut items: Vec<Item> = [Item { count: 1 }]

    with items[0] as first {
        first.count = first.count + 1
        items.push(Item { count: 9 })
    }
    // ANCHOR_END: body
}
