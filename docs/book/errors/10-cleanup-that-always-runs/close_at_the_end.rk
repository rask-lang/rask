import fs
import io.IoError

func save(lines: Vec<string>, path: string) -> void or IoError {
    let file = try fs.create_file(path)
    for line in lines {
        try file.write_text("{line}\n")
    }
    try file.close()
}

func main() {
    save(["take lamp"], "mud.log")!
}
