// SPDX-License-Identifier: (MIT OR Apache-2.0)
// What a player typed, turned into something the game can act on.

public enum Command {
    Look
    Go(Direction)
    Take(string)
    Drop(string)
    Inventory
    Say(string)
    Help
    Quit
}

public enum ParseError {
    Empty
    UnknownVerb(string)
    MissingObject(string)
    NoSuchDirection(string)
}

extend ParseError {
    public func message(self) -> string {
        return match self {
            ParseError.Empty => "Say something.",
            ParseError.UnknownVerb(v) => "I don't know how to '{v}'. Try 'help'.",
            ParseError.MissingObject(v) => "{v} what?",
            ParseError.NoSuchDirection(w) => "'{w}' isn't a direction.",
        }
    }
}

public const HELP: string = "Commands: look, n/s/e/w/u/d, take <item>, drop <item>, inventory, say <words>, quit."

// The first word is the verb and the rest, if any, is what it acts on.
public func parse(line: string) -> Command or ParseError {
    let text = line.trim().to_string()
    if text.is_empty() {
        return ParseError.Empty
    }
    mut verb = text.to_lowercase()
    mut rest = ""
    if text.index_of(" ")? as i {
        verb = text[0..i].to_lowercase()
        rest = text[i + 1..].trim().to_string()
    }

    if Direction.parse(verb)? as d {
        return Command.Go(d)
    }
    let cmd = match verb {
        "look" | "l" => Command.Look,
        "inventory" | "i" => Command.Inventory,
        "help" | "?" => Command.Help,
        "quit" => Command.Quit,
        "go" => Command.Go(try direction(rest)),
        "take" | "get" => Command.Take(try object(verb, rest)),
        "drop" => Command.Drop(try object(verb, rest)),
        "say" => Command.Say(try object(verb, rest)),
        _ => return ParseError.UnknownVerb(verb),
    }
    return cmd
}

// exercise 08: The direction `word` names, or why it doesn't name one.
func direction(word: string) -> Direction or ParseError {
    if word.is_empty() {
        return ParseError.MissingObject("go")
    }
    let d = Direction.parse(word) ?? return ParseError.NoSuchDirection(word)
    return d
}

// exercise 08: What `verb` acts on, or an error when nothing follows it.
func object(verb: string, rest: string) -> string or ParseError {
    if rest.is_empty() {
        return ParseError.MissingObject(verb)
    }
    return rest
}

test "a direction alone is a move" {
    assert parse("n")! == Command.Go(Direction.North)
    assert parse("  go   west ")! == Command.Go(Direction.West)
}

test "the object keeps its case and inner spaces" {
    assert parse("say Hello there")! == Command.Say("Hello there")
    assert parse("TAKE brass lamp")! == Command.Take("brass lamp")
}

test "what can go wrong is a value" {
    assert parse("   ") is ParseError.Empty
    assert parse("dance") is ParseError.UnknownVerb
    assert parse("take") is ParseError.MissingObject
    assert parse("go sideways") is ParseError.NoSuchDirection
}
