    todo()
}

test "squares" {
    assert squares(4) == Vec.from([1, 4, 9, 16])
    assert squares(0).len() == 0
}

test "split sum" {
    assert split_sum(Vec.from([1, 2, 3, 4, 5])) == 15
    assert split_sum(Vec.from([7])) == 7
    assert split_sum(Vec.new()) == 0
}

