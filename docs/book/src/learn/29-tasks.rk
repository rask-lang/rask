//
// 29. Tasks and channels
//
// A program often has two things to do that don't depend on each other: add
// up two halves of a long list, answer two people at once. Doing them one
// after the other wastes the time one spends waiting or the second core the
// machine has.
//
// `spawn { ... }` starts the block as a task that runs alongside the code
// that started it. `join()` waits for it and gives back what the block gave,
// or an error if the task crashed, hence the `!`. Any function can run in a
// task; there's no special kind of function for it. Tasks need something to
// run them, which `using Multitasking { ... }` sets up.
//
// A channel carries values from one task to another. `Channel<i32>.buffered(10)`
// gives a sending end and a receiving end, which can hold 10 values waiting.

func squares(n: i32) -> Vec<i32> {
    using Multitasking {
        let (tx, rx) = Channel<i32>.buffered(10)
        let worker = spawn {
            for i in 1..=n {
                tx.send(i * i)!
            }
        }
        mut out = Vec.new()
        for _ in 0..n {
            out.push(rx.receive()!)
        }
        worker.join()!
        return out
    }
}

