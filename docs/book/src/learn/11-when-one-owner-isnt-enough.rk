// Generated by `tests/learn_gate.sh --update` from the files `exercises` lists. Edit those, not this.
// test-specs: skip: an exercise starts with its tests failing

import memory.Rack
import memory.Link

// ── mud/direction.rk ────────────────────────────────────────────────

// The six ways out of a room.

public enum Direction {
    North
    South
    East
    West
    Up
    Down
}

extend Direction {
    public func parse(word: string) -> Direction? {
        return match word {
            "n" | "north" => Direction.North,
            "s" | "south" => Direction.South,
            "e" | "east" => Direction.East,
            "w" | "west" => Direction.West,
            "u" | "up" => Direction.Up,
            "d" | "down" => Direction.Down,
            _ => none,
        }
    }

    public func name(self) -> string {
        return match self {
            Direction.North => "north",
            Direction.South => "south",
            Direction.East => "east",
            Direction.West => "west",
            Direction.Up => "up",
            Direction.Down => "down",
        }
    }

    // exercise 04: The way back: north for south, up for down, and so on.
    public func opposite(self) -> Direction {
        return match self {
            Direction.North => Direction.South,
            Direction.South => Direction.North,
            Direction.East => Direction.West,
            Direction.West => Direction.East,
            Direction.Up => Direction.Down,
            Direction.Down => Direction.Up,
        }
    }
}

// Every direction, in the order a room lists its exits.
public const DIRECTIONS: Vec<Direction> = [
    Direction.North
    Direction.South
    Direction.East
    Direction.West
    Direction.Up
    Direction.Down
]

test "every direction leads back the way it came" {
    for dir in DIRECTIONS {
        assert dir.opposite() != dir
        assert dir.opposite().opposite() == dir
    }
    assert Direction.North.opposite() == Direction.South
    assert Direction.Up.opposite() == Direction.Down
}

// ── mud/item.rk ─────────────────────────────────────────────────────

// Things lying around, and things carried.

public struct Item {
    public name: string
    public description: string
}

// exercise 07: Where the item called `name` sits in `items`, or none if
// it isn't there.
public func find_item(items: Vec<Item>, name: string) -> usize? {
    for i in 0..items.len() {
        if items[i].name == name {
            return i
        }
    }
    return none
}

test "finding an item by name" {
    let items: Vec<Item> = [Item(name: "lamp", description: ""), Item(name: "key", description: "")]
    assert find_item(items, "key") == 1
    assert find_item(items, "rope") is none
}

// ── mud/command.rk ──────────────────────────────────────────────────

// What a player typed, turned into something the game can act on.

public enum Command {
    Look
    Go(Direction)
    Take(string)
    Drop(string)
    Inventory
    Say(string)
    Help
    Quit
}

public enum ParseError {
    Empty
    UnknownVerb(string)
    MissingObject(string)
    NoSuchDirection(string)
}

extend ParseError {
    public func message(self) -> string {
        return match self {
            ParseError.Empty => "Say something.",
            ParseError.UnknownVerb(v) => "I don't know how to '{v}'. Try 'help'.",
            ParseError.MissingObject(v) => "{v} what?",
            ParseError.NoSuchDirection(w) => "'{w}' isn't a direction.",
        }
    }
}

public const HELP: string = "Commands: look, n/s/e/w/u/d, take <item>, drop <item>, inventory, say <words>, quit."

// The first word is the verb and the rest, if any, is what it acts on.
public func parse(line: string) -> Command or ParseError {
    let text = line.trim().to_string()
    if text.is_empty() {
        return ParseError.Empty
    }
    mut verb = text.to_lowercase()
    mut rest = ""
    if text.index_of(" ")? as i {
        verb = text[0..i].to_lowercase()
        rest = text[i + 1..].trim().to_string()
    }

    if Direction.parse(verb)? as d {
        return Command.Go(d)
    }
    let cmd = match verb {
        "look" | "l" => Command.Look,
        "inventory" | "i" => Command.Inventory,
        "help" | "?" => Command.Help,
        "quit" => Command.Quit,
        "go" => Command.Go(try direction(rest)),
        "take" | "get" => Command.Take(try object(verb, rest)),
        "drop" => Command.Drop(try object(verb, rest)),
        "say" => Command.Say(try object(verb, rest)),
        _ => return ParseError.UnknownVerb(verb),
    }
    return cmd
}

// exercise 08: The direction `word` names, or why it doesn't name one.
func direction(word: string) -> Direction or ParseError {
    if word.is_empty() {
        return ParseError.MissingObject("go")
    }
    let d = Direction.parse(word) ?? return ParseError.NoSuchDirection(word)
    return d
}

// exercise 08: What `verb` acts on, or an error when nothing follows it.
func object(verb: string, rest: string) -> string or ParseError {
    if rest.is_empty() {
        return ParseError.MissingObject(verb)
    }
    return rest
}

test "a direction alone is a move" {
    assert parse("n")! == Command.Go(Direction.North)
    assert parse("  go   west ")! == Command.Go(Direction.West)
}

test "the object keeps its case and inner spaces" {
    assert parse("say Hello there")! == Command.Say("Hello there")
    assert parse("TAKE brass lamp")! == Command.Take("brass lamp")
}

test "what can go wrong is a value" {
    assert parse("   ") is ParseError.Empty
    assert parse("dance") is ParseError.UnknownVerb
    assert parse("take") is ParseError.MissingObject
    assert parse("go sideways") is ParseError.NoSuchDirection
}

// ── mud/world.rk ────────────────────────────────────────────────────

// The world: rooms joined by exits, the items lying in them, and who is where.


// An exit stays when the room it led to is gone: `to` reads `none` from then on.
public struct Exit {
    public dir: Direction
    public to: Link<Room>?
}

public struct Room {
    public name: string
    public description: string
    public items: Vec<Item>
    public exits: Vec<Exit>
}

public struct Player {
    public name: string
    public at: Link<Room>?
    public inventory: Vec<Item>
}

// Moves from room to room on its own, once a tick.
public struct Monster {
    public name: string
    public at: Link<Room>?
}

public struct World {
    public rooms: Rack<Room>
    public players: Rack<Player>
    public monsters: Rack<Monster>
}

extend World {
    public func new() -> World {
        return World(rooms: Rack.new(), players: Rack.new(), monsters: Rack.new())
    }

    public func add_room(mutate self, name: string, description: string) -> Link<Room> {
        return self.rooms.insert(Room(name, description, items: Vec.new(), exits: Vec.new()))
    }

    // exercise 11: Join `a` to `b` both ways: going `dir` from `a` reaches `b`,
    // and the opposite way from `b` leads back to `a`.
    public func connect(mutate self, a: Link<Room>, dir: Direction, b: Link<Room>) -> void {
        todo()
    }

    public func room(self, name: string) -> Link<Room>? {
        for r in self.rooms.nodes() {
            if r.name == name {
                return r
            }
        }
        return none
    }

    public func player(self, name: string) -> Link<Player>? {
        for p in self.players.nodes() {
            if p.name == name {
                return p
            }
        }
        return none
    }

    // Everyone in `room` but `except`, by name.
    public func players_in(self, room: Link<Room>, except: string) -> Vec<string> {
        mut names = Vec.new()
        for p in self.players.nodes() {
            if p.at? as r {
                if r == room && p.name != except {
                    names.push(p.name)
                }
            }
        }
        return names
    }

    // exercise 11: Delete the room called `name`, and answer whether there was
    // one. Every exit into it reads `none` afterwards. Anyone standing in it is
    // nowhere, so callers move them out first.
    public func collapse(deleting self, name: string) -> bool {
        todo()
    }

    // How many items there are, wherever they are.
    public func item_count(self) -> u64 {
        mut n: u64 = 0
        for r in self.rooms.nodes() {
            n += r.items.len()
        }
        for p in self.players.nodes() {
            n += p.inventory.len()
        }
        return n
    }
}

extend Room {
    public func exit(self, dir: Direction) -> Exit? {
        for e in self.exits {
            if e.dir == dir {
                return e
            }
        }
        return none
    }
}

// ── mud/game.rk ─────────────────────────────────────────────────────

// The rules: what each command does to the world, and who hears about it.


// Something a player can look at.
public interface Describe {
    func describe(self) -> string
}

Item implements Describe {
    public func describe(self) -> string {
        return self.name
    }
}

Exit implements Describe {
    public func describe(self) -> string {
        if self.to? {
            return self.dir.name()
        }
        return "{self.dir.name()} (blocked)"
    }
}

// "a, b and c", or `empty` when there is nothing to list.
public func listing<T: Describe>(things: Vec<T>, empty: string) -> string {
    let n = things.len()
    if n == 0 {
        return empty
    }
    mut out = things[0].describe()
    for i in 1..n {
        let sep = if i == n - 1: " and " else: ", "
        out = "{out}{sep}{things[i].describe()}"
    }
    return out
}

// A line for one player, as opposed to the reply to whoever typed the command.
public struct Heard {
    public to: string
    public text: string
}

public struct Outcome {
    public reply: string
    public heard: Vec<Heard>
}

public func reply(text: string) -> Outcome {
    return Outcome(reply: text, heard: Vec.new())
}

func tell_room(world: World, room: Link<Room>, except: string, text: string, mutate heard: Vec<Heard>) {
    for name in world.players_in(room, except) {
        heard.push(Heard(to: name, text))
    }
}

public func describe_room(world: World, room: Link<Room>, viewer: string) -> string {
    let items = listing(room.items, "nothing")
    let exits = listing(room.exits, "none")
    mut text = "{room.name}\n{room.description}\nYou see {items}.\nExits: {exits}."
    let others = world.players_in(room, viewer)
    if !others.is_empty() {
        text = "{text}\nAlso here: {others.join(", ")}."
    }
    for m in world.monsters.nodes() {
        if m.at? as r {
            if r == room {
                text = "{text}\nA {m.name} is here."
            }
        }
    }
    return text
}

public enum EnterError {
    NoName
    NameTaken(string)
    NoSuchRoom(string)
}

extend EnterError {
    public func message(self) -> string {
        return match self {
            EnterError.NoName => "You'll need a name.",
            EnterError.NameTaken(n) => "Someone called {n} is already here.",
            EnterError.NoSuchRoom(r) => "The world has no room called {r}.",
        }
    }
}

// A name is who you are in the game, so two players can't share one.
public func enter(mutate world: World, name: string, start: string) -> Outcome or EnterError {
    if name.is_empty() {
        return EnterError.NoName
    }
    if world.player(name)? {
        return EnterError.NameTaken(name)
    }
    let room = world.room(start) ?? return EnterError.NoSuchRoom(start)
    world.players.insert(Player(name, at: room, inventory: Vec.new()))
    mut heard = Vec.new()
    tell_room(world, room, name, "{name} arrives.", mutate heard)
    return Outcome(reply: describe_room(world, room, name), heard)
}

// What a leaving player carried stays behind, on the floor where they stood.
public func leave(deleting world: World, name: string) -> Outcome {
    let p = world.player(name) ?? return reply("")
    mut heard = Vec.new()
    if p.at? as room {
        while p.inventory.pop()? as item {
            room.items.push(item)
        }
        tell_room(world, room, name, "{name} leaves.", mutate heard)
    }
    world.players.delete(p)
    return Outcome(reply: "Goodbye.", heard)
}

public func apply(mutate world: World, name: string, cmd: Command) -> Outcome {
    let p = world.player(name) ?? return reply("You aren't in the game.")
    let here = p.at ?? return reply("You are nowhere at all.")
    return match cmd {
        Command.Look => reply(describe_room(world, here, name)),
        Command.Go(dir) => go(mutate world, p, here, dir),
        Command.Take(thing) => take_item(mutate world, p, here, thing),
        Command.Drop(thing) => drop_item(mutate world, p, here, thing),
        Command.Inventory => reply("You carry {listing(p.inventory, "nothing")}."),
        Command.Say(text) => say(world, p, here, text),
        Command.Help => reply(HELP),
        Command.Quit => reply("Type 'quit' again at the prompt to leave."),
    }
}

func go(mutate world: World, p: Link<Player>, here: Link<Room>, dir: Direction) -> Outcome {
    let exit = here.exit(dir) ?? return reply("You can't go {dir.name()}.")
    let there = exit.to ?? return reply("Rubble blocks the way {dir.name()}.")
    mut heard = Vec.new()
    tell_room(world, here, p.name, "{p.name} goes {dir.name()}.", mutate heard)
    p.at = there
    tell_room(world, there, p.name, "{p.name} arrives.", mutate heard)
    return Outcome(reply: describe_room(world, there, p.name), heard)
}

// Picking something up moves it: out of the room, into the inventory.
func take_item(mutate world: World, p: Link<Player>, here: Link<Room>, thing: string) -> Outcome {
    let i = find_item(here.items, thing) ?? return reply("There's no {thing} here.")
    let item = here.items.remove(i)
    p.inventory.push(item)
    mut heard = Vec.new()
    tell_room(world, here, p.name, "{p.name} takes the {thing}.", mutate heard)
    return Outcome(reply: "You take the {thing}.", heard)
}

func drop_item(mutate world: World, p: Link<Player>, here: Link<Room>, thing: string) -> Outcome {
    let i = find_item(p.inventory, thing) ?? return reply("You don't have a {thing}.")
    let item = p.inventory.remove(i)
    here.items.push(item)
    mut heard = Vec.new()
    tell_room(world, here, p.name, "{p.name} drops the {thing}.", mutate heard)
    return Outcome(reply: "You drop the {thing}.", heard)
}

func say(world: World, p: Link<Player>, here: Link<Room>, text: string) -> Outcome {
    mut heard = Vec.new()
    tell_room(world, here, p.name, "{p.name} says \"{text}\"", mutate heard)
    return Outcome(reply: "You say \"{text}\"", heard)
}

// Each monster walks through one open exit, picked by `step`.
public func tick(mutate world: World, step: u64) -> Vec<Heard> {
    mut heard = Vec.new()
    for m in world.monsters.nodes() {
        let here = m.at ?? continue
        mut open: Vec<Exit> = Vec.new()
        for e in here.exits {
            if e.to? {
                open.push(e)
            }
        }
        if open.is_empty() {
            continue
        }
        let pick = step % open.len()
        let exit = open[pick]
        let there = exit.to ?? continue
        tell_room(world, here, "", "The {m.name} scurries {exit.dir.name()}.", mutate heard)
        m.at = there
        tell_room(world, there, "", "A {m.name} scurries in.", mutate heard)
    }
    return heard
}

// ── mud/start.rk ────────────────────────────────────────────────────

// The world a new game starts in.

public const START: string = "Gate"

public func default_world() -> World {
    mut w = World.new()
    let gate = w.add_room("Gate", "A rusted iron gate stands open to the north.")
    let yard = w.add_room("Courtyard", "Weeds push up between the flagstones.")
    let hall = w.add_room("Hall", "A long table, set for a feast nobody came to.")
    let tower = w.add_room("Tower", "Wind whistles through the arrow slits.")
    let cellar = w.add_room("Cellar", "Barrels line the walls. Something drips.")
    let tunnel = w.add_room("Tunnel", "A narrow passage. The ceiling looks unhappy.")

    w.connect(gate, Direction.North, yard)
    w.connect(yard, Direction.East, hall)
    w.connect(yard, Direction.Up, tower)
    w.connect(hall, Direction.Down, cellar)
    w.connect(cellar, Direction.West, tunnel)
    w.connect(tunnel, Direction.North, gate)

    gate.items.push(Item(name: "lamp", description: "A brass lamp, still half full of oil."))
    hall.items.push(Item(name: "coin", description: "A gold coin with a worn face."))
    tower.items.push(Item(name: "rope", description: "Twenty feet of good rope."))
    cellar.items.push(Item(name: "key", description: "A heavy iron key."))

    w.monsters.insert(Monster(name: "rat", at: cellar))
    return w
}

// ── mud/play.rk ─────────────────────────────────────────────────────

// One player's line in, the game's answer out. The terminal loop, the server
// and the tests all go through here.

public func respond(mutate world: World, name: string, line: string) -> Outcome {
    let cmd = parse(line) catch e => return reply(e.message())
    return apply(mutate world, name, cmd)
}

// A list of commands standing in for a player, and every reply they got.
public func script(mutate world: World, name: string, lines: Vec<string>) -> Vec<string> {
    mut replies = Vec.new()
    replies.push(enter(mutate world, name, START)!.reply)
    for line in lines {
        replies.push(respond(mutate world, name, line).reply)
    }
    return replies
}

test "walking to the hall" {
    mut w = default_world()
    let out = script(mutate w, "ada", ["n", "e"])
    assert out[2].starts_with("Hall\n")
    assert out[2].contains("You see coin.")
}

test "picking something up moves it" {
    mut w = default_world()
    let before = w.item_count()
    let out = script(mutate w, "ada", ["take lamp", "look", "i"])
    assert out[1] == "You take the lamp."
    assert out[2].contains("You see nothing.")
    assert out[3] == "You carry lamp."
    assert w.item_count() == before
}

test "a dead end and a typo" {
    mut w = default_world()
    let out = script(mutate w, "ada", ["w", "dance"])
    assert out[1] == "You can't go west."
    assert out[2] == "I don't know how to 'dance'. Try 'help'."
}

test "two players in one room hear each other" {
    mut w = default_world()
    enter(mutate w, "ada", START)!
    let joined = enter(mutate w, "bo", START)!
    assert joined.heard.len() == 1
    assert joined.heard[0].to == "ada"
    assert joined.heard[0].text == "bo arrives."
    let said = respond(mutate w, "ada", "say hi")
    assert said.heard[0].to == "bo"
    assert said.heard[0].text == "ada says \"hi\""
}

test "a collapsed tunnel leaves a blocked exit" {
    mut w = default_world()
    assert w.collapse("Tunnel")
    let out = script(mutate w, "ada", ["look", "s"])
    assert out[1].contains("Exits: north and south (blocked).")
    assert out[2] == "Rubble blocks the way south."
}

test "leaving drops what you carried" {
    mut w = default_world()
    let _ = script(mutate w, "ada", ["take lamp", "n"])
    let _ = leave(deleting w, "ada")
    let yard = w.room("Courtyard")!
    assert find_item(yard.items, "lamp")?
}

test "the rat wanders" {
    mut w = default_world()
    let heard = tick(mutate w, 0)
    assert heard.is_empty()
    let rat = w.monsters.nodes()[0]
    assert rat.at!.name != "Cellar"
}

test "a name already in the game is refused" {
    mut w = default_world()
    enter(mutate w, "ada", START)!
    assert enter(mutate w, "ada", START) is EnterError.NameTaken
    assert enter(mutate w, "", START) is EnterError.NoName
    assert w.players.len() == 1
}
