//
// 23. Chains
//
// Step 22's `keep_where` is a loop everybody needs, so a Vec comes with it,
// called `filter`, along with a few others. Chained together, they say what
// you want and leave out how to loop:
//
//     filter(|x| ...)   keep the items that pass
//     map(|x| ...)      turn each item into something else
//     to_vec()          collect what's left into a new Vec
//     sum(), count()    or boil it down to one value
//
// A chain does nothing until its last step asks for a result, and then it
// goes through the list once. The middle steps don't build lists of their own.

struct Person {
    name: string
    age: i32
}

func adult_names(people: Vec<Person>) -> Vec<string> {
    return people.filter(|p| p.age >= 18).map(|p| p.name).to_vec()
}

// Your turn: `even_squares_total` squares the even numbers and adds them up,
// so [1, 2, 3, 4] gives 4 + 16 = 20. One chain does it.

func even_squares_total(numbers: Vec<i32>) -> i32 {
    return numbers.filter(|n| n % 2 == 0).map(|n| n * n).sum()
}

test "adult names" {
    let people = Vec.from([
        Person(name: "Ada", age: 36)
        Person(name: "Tim", age: 9)
        Person(name: "Alan", age: 41)
    ])
    assert adult_names(people) == Vec.from(["Ada", "Alan"])
    assert people.filter(|p| p.age < 18).count() == 1
}

test "even squares" {
    assert even_squares_total(Vec.from([1, 2, 3, 4])) == 20
    assert even_squares_total(Vec.from([6, -2, 5])) == 40
    assert even_squares_total(Vec.from([1, 3])) == 0
}
