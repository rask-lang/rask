// ── mud/direction.rk ────────────────────────────────────────────────

// The six ways out of a room.

public enum Direction {
    North
    South
    East
    West
    Up
    Down
}

extend Direction {
    public func parse(word: string) -> Direction? {
        return match word {
            "n" | "north" => Direction.North,
            "s" | "south" => Direction.South,
            "e" | "east" => Direction.East,
            "w" | "west" => Direction.West,
            "u" | "up" => Direction.Up,
            "d" | "down" => Direction.Down,
            _ => none,
        }
    }

    public func name(self) -> string {
        return match self {
            Direction.North => "north",
            Direction.South => "south",
            Direction.East => "east",
            Direction.West => "west",
            Direction.Up => "up",
            Direction.Down => "down",
        }
    }

    // exercise 04: The way back: north for south, up for down, and so on.
    public func opposite(self) -> Direction {
        return match self {
            Direction.North => Direction.South,
            Direction.South => Direction.North,
            Direction.East => Direction.West,
            Direction.West => Direction.East,
            Direction.Up => Direction.Down,
            Direction.Down => Direction.Up,
        }
    }
}

// Every direction, in the order a room lists its exits.
public const DIRECTIONS: Vec<Direction> = [
    Direction.North
    Direction.South
    Direction.East
    Direction.West
    Direction.Up
    Direction.Down
]

test "every direction leads back the way it came" {
    for dir in DIRECTIONS {
        assert dir.opposite() != dir
        assert dir.opposite().opposite() == dir
    }
    assert Direction.North.opposite() == Direction.South
    assert Direction.Up.opposite() == Direction.Down
}

// ── mud/item.rk ─────────────────────────────────────────────────────

// Things lying around, and things carried.

public struct Item {
    public name: string
    public description: string
}

// exercise 07: Where the item called `name` sits in `items`, or none if
// it isn't there.
public func find_item(items: Vec<Item>, name: string) -> usize? {
    for i in 0..items.len() {
        if items[i].name == name {
            return i
        }
    }
    return none
}

test "finding an item by name" {
    let items: Vec<Item> = [Item(name: "lamp", description: ""), Item(name: "key", description: "")]
    assert find_item(items, "key") == 1
    assert find_item(items, "rope") is none
}

// ── mud/command.rk ──────────────────────────────────────────────────

// What a player typed, turned into something the game can act on.

public enum Command {
    Look
    Go(Direction)
    Take(string)
    Drop(string)
    Inventory
    Say(string)
    Help
    Quit
}

public enum ParseError {
    Empty
    UnknownVerb(string)
    MissingObject(string)
    NoSuchDirection(string)
}

extend ParseError {
    public func message(self) -> string {
        return match self {
            ParseError.Empty => "Say something.",
            ParseError.UnknownVerb(v) => "I don't know how to '{v}'. Try 'help'.",
            ParseError.MissingObject(v) => "{v} what?",
            ParseError.NoSuchDirection(w) => "'{w}' isn't a direction.",
        }
    }
}

public const HELP: string = "Commands: look, n/s/e/w/u/d, take <item>, drop <item>, inventory, say <words>, quit."

// The first word is the verb and the rest, if any, is what it acts on.
public func parse(line: string) -> Command or ParseError {
    let text = line.trim().to_string()
    if text.is_empty() {
        return ParseError.Empty
    }
    mut verb = text.to_lowercase()
    mut rest = ""
    if text.index_of(" ")? as i {
        verb = text[0..i].to_lowercase()
        rest = text[i + 1..].trim().to_string()
    }

    if Direction.parse(verb)? as d {
        return Command.Go(d)
    }
    let cmd = match verb {
        "look" | "l" => Command.Look,
        "inventory" | "i" => Command.Inventory,
        "help" | "?" => Command.Help,
        "quit" => Command.Quit,
        "go" => Command.Go(try direction(rest)),
        "take" | "get" => Command.Take(try object(verb, rest)),
        "drop" => Command.Drop(try object(verb, rest)),
        "say" => Command.Say(try object(verb, rest)),
        _ => return ParseError.UnknownVerb(verb),
    }
    return cmd
}

// exercise 08: The direction `word` names, or why it doesn't name one.
func direction(word: string) -> Direction or ParseError {
    if word.is_empty() {
        return ParseError.MissingObject("go")
    }
    let d = Direction.parse(word) ?? return ParseError.NoSuchDirection(word)
    return d
}

// exercise 08: What `verb` acts on, or an error when nothing follows it.
func object(verb: string, rest: string) -> string or ParseError {
    if rest.is_empty() {
        return ParseError.MissingObject(verb)
    }
    return rest
}

test "a direction alone is a move" {
    assert parse("n")! == Command.Go(Direction.North)
    assert parse("  go   west ")! == Command.Go(Direction.West)
}

test "the object keeps its case and inner spaces" {
    assert parse("say Hello there")! == Command.Say("Hello there")
    assert parse("TAKE brass lamp")! == Command.Take("brass lamp")
}

test "what can go wrong is a value" {
    assert parse("   ") is ParseError.Empty
    assert parse("dance") is ParseError.UnknownVerb
    assert parse("take") is ParseError.MissingObject
    assert parse("go sideways") is ParseError.NoSuchDirection
}

// ── early/world.rk ──────────────────────────────────────────────────

// The world as the first chapters build it. Rooms sit in a list, and an exit
// names the room it leads to by its place in that list. Chapter 11 replaces
// this file with ../mud/world.rk.

public struct Room {
    public name: string
    public description: string
    public items: Vec<Item>
    public exits: Map<Direction, usize>
}

public struct World {
    public rooms: Vec<Room>
    public here: usize
    public carried: Vec<Item>
}

extend World {
    public func new() -> World {
        return World(rooms: Vec.new(), here: 0, carried: Vec.new())
    }

    // exercise 06: Add a room with nothing in it and no way out, and answer
    // its place in `rooms`, which is how an exit will name it.
    public func add_room(mutate self, name: string, description: string) -> usize {
        self.rooms.push(Room(name, description, items: Vec.new(), exits: Map.new()))
        return self.rooms.len() - 1
    }

    // Both ways: going `dir` from `a` reaches `b`, and the opposite way leads back.
    public func connect(mutate self, a: usize, dir: Direction, b: usize) -> void {
        self.rooms[a].exits[dir] = b
        self.rooms[b].exits[dir.opposite()] = a
    }
}

// ── early/game.rk ───────────────────────────────────────────────────

// The rules, for one player.

// exercise 05: Answer each command: look describes the room, a direction
// walks, take and drop move an item, and so on down the list.
public func apply(mutate world: World, cmd: Command) -> string {
    todo()
}

// The room's name, its description, what's in it and the ways out.
public func describe(world: World) -> string {
    with world.rooms[world.here] as room {
        mut text = "{room.name}\n{room.description}"
        for item in room.items {
            text = "{text}\nThere is a {item.name} here."
        }
        mut exits: Vec<string> = Vec.new()
        for dir in DIRECTIONS {
            if room.exits.contains(dir) {
                exits.push(dir.name())
            }
        }
        if exits.is_empty() {
            return "{text}\nThere is no way out."
        }
        return "{text}\nExits: {exits.join(", ")}."
    }
}

// exercise 07: Walk `dir` from here, and describe where that leads. If there's
// no exit that way, say so and stay put.
public func go(mutate world: World, dir: Direction) -> string {
    let to = world.rooms[world.here].exits.get(dir) ?? return "You can't go {dir.name()}."
    world.here = to
    return describe(world)
}

// exercise 09: Move the item called `thing` off the floor and into what the
// player carries. It leaves the room: an item is only ever in one place.
public func pick_up(mutate world: World, thing: string) -> string {
    with world.rooms[world.here] as room {
        let i = find_item(room.items, thing) ?? return "There's no {thing} here."
        world.carried.push(room.items.remove(i))
    }
    return "You take the {thing}."
}

// exercise 09: The other way: from what the player carries onto the floor.
public func put_down(mutate world: World, thing: string) -> string {
    let i = find_item(world.carried, thing) ?? return "You don't have a {thing}."
    world.rooms[world.here].items.push(world.carried.remove(i))
    return "You drop the {thing}."
}

// exercise 06: List what the player carries, or say there's nothing.
public func inventory(world: World) -> string {
    if world.carried.is_empty() {
        return "You carry nothing."
    }
    mut names: Vec<string> = Vec.new()
    for item in world.carried {
        names.push(item.name)
    }
    return "You carry {names.join(", ")}."
}

// ── early/start.rk ──────────────────────────────────────────────────

// The world a new game starts in.

public func default_world() -> World {
    mut w = World.new()
    let gate = w.add_room("Gate", "A rusted iron gate stands open to the north.")
    let yard = w.add_room("Courtyard", "Weeds push up between the flagstones.")
    let hall = w.add_room("Hall", "A long table, set for a feast nobody came to.")
    let tower = w.add_room("Tower", "Wind whistles through the arrow slits.")
    let cellar = w.add_room("Cellar", "Barrels line the walls. Something drips.")

    w.connect(gate, Direction.North, yard)
    w.connect(yard, Direction.East, hall)
    w.connect(yard, Direction.Up, tower)
    w.connect(hall, Direction.Down, cellar)

    w.rooms[gate].items.push(Item(name: "lamp", description: "A brass lamp, still half full of oil."))
    w.rooms[hall].items.push(Item(name: "coin", description: "A gold coin with a worn face."))
    w.rooms[tower].items.push(Item(name: "rope", description: "Twenty feet of good rope."))
    w.rooms[cellar].items.push(Item(name: "key", description: "A heavy iron key."))
    w.here = gate
    return w
}

// ── early/play.rk ───────────────────────────────────────────────────

// A line the player typed in, the game's answer out.
//
// test-specs: skip: these tests run in the exercise files, which put this
// together with the rest of the program (tests/learn_gate.sh)

public func respond(mutate world: World, line: string) -> string {
    let cmd = parse(line) catch e => return e.message()
    return apply(mutate world, cmd)
}

// exercise 05: Look around first, then answer each line in turn. Every
// answer goes in the list, in order.
public func script(mutate world: World, lines: Vec<string>) -> Vec<string> {
    todo()
}

test "the game starts at the gate" {
    let w = default_world()
    assert describe(w) == "Gate\nA rusted iron gate stands open to the north.\nThere is a lamp here.\nExits: north."
}

test "walking to the hall" {
    mut w = default_world()
    let out = script(mutate w, ["n", "e"])
    assert out[2].starts_with("Hall\n")
    assert out[2].contains("There is a coin here.")
}

test "a dead end and a typo" {
    mut w = default_world()
    let out = script(mutate w, ["w", "dance"])
    assert out[1] == "You can't go west."
    assert out[2] == "I don't know how to 'dance'. Try 'help'."
}

test "picking something up moves it" {
    mut w = default_world()
    let out = script(mutate w, ["take lamp", "look", "i", "take lamp"])
    assert out[1] == "You take the lamp."
    assert !out[2].contains("lamp")
    assert out[3] == "You carry lamp."
    assert out[4] == "There's no lamp here."
}

test "putting it down somewhere else" {
    mut w = default_world()
    let out = script(mutate w, ["take lamp", "n", "drop lamp", "i", "look", "drop lamp"])
    assert out[3] == "You drop the lamp."
    assert out[4] == "You carry nothing."
    assert out[5].contains("There is a lamp here.")
    assert out[6] == "You don't have a lamp."
}

// ── early/main.rk ───────────────────────────────────────────────────

// A walk around the castle, printed.

func main() {
    mut world = default_world()
    for reply in script(mutate world, ["take lamp", "n", "e", "i"]) {
        println(reply)
        println("")
    }
}
