//
// 10. Structs
//
// A struct groups named fields into a type of your own. You build one like a
// function call, giving each field by name, and read a field with a dot.

struct Point {
    x: i32
    y: i32
}

func distance_from_origin(p: Point) -> i32 {
    return abs(p.x) + abs(p.y)
}

func abs(n: i32) -> i32 {
    return if n < 0: -n else: n
}

// Your turn: `step_right(p, 3)` gives a new Point three to the right of p.

func step_right(p: Point, by: i32) -> Point {
    todo()
}

test "distance" {
    assert distance_from_origin(Point(x: 3, y: -4)) == 7
}

test "step right" {
    let p = step_right(Point(x: 1, y: 2), 3)
    assert p.x == 4
    assert p.y == 2
}
