// 11. Methods
//
// Functions that belong to a type go in an `extend` block. One that takes
// `self` is called on a value, `p.flipped()`. One without `self` is called on
// the type, `Point.origin()`.

struct Point {
    x: i32
    y: i32
}

extend Point {
    func origin() -> Point {
        return Point(x: 0, y: 0)
    }

    func flipped(self) -> Point {
        return Point(x: self.y, y: self.x)
    }

    // Your turn: `a.plus(b)` adds the two points field by field.
    func plus(self, other: Point) -> Point {
        todo()
    }
}

test "flipped" {
    let p = Point(x: 1, y: 2).flipped()
    assert p.x == 2
    assert p.y == 1
}

test "plus" {
    let p = Point(x: 1, y: 2).plus(Point(x: 10, y: 20))
    assert p.x == 11
    assert p.y == 22
    assert Point.origin().plus(p).x == 11
}

