//
// 9. Walking a Vec
//
// `for` walks a Vec the same way it walks a range, one item at a time.

func sum(numbers: Vec<i32>) -> i32 {
    mut total = 0
    for n in numbers {
        total += n
    }
    return total
}

// Your turn: `largest` gives the biggest number in the list. You can assume
// the list isn't empty, so start from `numbers[0]`.

