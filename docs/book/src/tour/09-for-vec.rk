    todo()
}

test "sum" {
    assert sum(Vec.from([1, 2, 3])) == 6
}

test "largest" {
    assert largest(Vec.from([3, 9, 4])) == 9
    assert largest(Vec.from([-5, -2, -8])) == -2
}

