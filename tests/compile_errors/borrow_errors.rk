// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Rejects: borrowing rule violations
//
// Spec: mem.borrowing (S1-S5, W1-W7, E1-E5, A1-A3, F1-F4)
// Spec: mem.parameters (PM1-PM3)
//
// One marker per rejection, on the line the compiler points at. Four of the
// rules below produce nothing today and are registered in DEAD_MARKERS.txt;
// they are the interesting half of this file, and the reason it was worth
// anchoring markers to lines at all — the file passed for years on the
// strength of its own missing `mut` keywords reporting E0322 over them.

struct Player { health: i32, score: i32 }

// --- mutating a read-only parameter (PM1) ---
func bad_heal(p: Player) {
    // ERROR: cannot mutate parameter `p` — read-only by default [E0321]
    p.health += 10
}

// --- moving out of a borrowed parameter (PM3) ---
func bad_store(p: Player) {
    // ERROR: cannot move out of borrowed parameter `p`
    let stored = p
}

// --- moving a non-Copy field out of borrowed self ---
struct Named { name: string, value: Vec<i32> }

extend Named {
    func bad_take_field(self) -> Vec<i32> {
        // ERROR: cannot move `self.value` out of borrowed self
        return self.value
    }
}

// --- a block-scoped slice kept past its statement (B3, S3) ---
func store_slice() -> string {
    let s = "hello world"
    // ERROR: `s[0..5]` gives a view into `s`, not a new string [E0324]
    let slice = s[0..5]
    return slice
}

// --- a borrow of a field escaping the owner's scope (S3) ---
struct Holder { data: Vec<i32> }

func borrow_escape() {
    let h = Holder { data: Vec.new() }
    // ERROR: `h.data` is a block-scoped borrow of a non-Copy field
    mut escaped = h.data
}

// --- structural mutation inside `with` (W2) ---
func push_in_with() {
    mut v = Vec<i32>.new()
    v.push(1)
    v.push(2)
    with v[0] as item {
        // ERROR: cannot push `v` inside `with` block [E0808]
        v.push(3)
    }
}

func remove_in_with() {
    mut v = Vec<i32>.new()
    v.push(1)
    v.push(2)
    with v[0] as item {
        // ERROR: cannot pop `v` inside `with` block [E0808]
        v.pop()
    }
}

// --- a whole-object borrow overlapping a field borrow (F3) ---
//
// `p.health` goes in as `mutate` and `p` goes in beside it, so the callee holds
// a write to one field and a read of the whole object at the same time. The
// section used to hold a call that violated nothing and a comment saying a
// simultaneous one would fail — which meant nothing was being tested.
func both(mutate a: i32, b: Player) -> i32 {
    return b.score
}

func overlapping_borrow() {
    mut p = Player { health: 50, score: 10 }
    // ERROR: cannot borrow `p` while `p.health` is mutably borrowed
    let n = both(mutate p.health, p)
}

// --- copying a non-Copy element out of a collection (E4) ---
struct BigThing { data: Vec<i32> }

func copy_out_non_copy() {
    mut items = Vec<BigThing>.new()
    items.push(BigThing { data: Vec.new() })
    // ERROR: `BigThing` is not Copy — use `with`, or clone it
    let x = items[0]
}
