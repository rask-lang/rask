// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A method the type does have, called wrong.
//
// `Atomic<i64>.into_inner(Ordering.SeqCst)` reported "no method `into_inner`
// found for type `Atomic<i64>`" and then suggested `into_inner` — the name
// that had just been written. Every arm of the atomic resolver is guarded on
// the argument count, so a wrong count falls through to "no such method", and
// the suggestion machine offered the nearest name, which was the exact one.
//
// Three things were wrong, and each has its own answer now.
//
// A suggestion is never the name in the source, and a name the type *has*
// means the name isn't the problem — both are guards in the diagnostics layer.
// And the count itself is knowable: `Shared` and `Atomic` are compiler types
// with no stdlib file, so nothing checks a call against a signature before
// their resolvers run, and the arities had to live somewhere. They live with
// the names in `rask_stdlib::registry`, one list, so these now read the way
// `v.len(3)` always has (#1150):
//
//     error[E0310]: expected 1 argument, found 2
//         |             ^^^^^^^^^^^^^^^^^^^^^^ takes 1 argument
//
// Rejection is the right answer either way. This file is about which
// rejection, and the last case is the one that still has to say the name
// doesn't exist.
import sync.Atomic
import sync.Ordering

func too_many() {
    let a = Atomic<i64>.new(1)
    // ERROR: `load` takes an ordering and nothing else
    println(a.load(Ordering.SeqCst, 3))
    return
}

func too_few() {
    let a = Atomic<i64>.new(1)
    // ERROR: `store` takes a value and an ordering
    a.store(5)
    return
}

func into_inner_takes_none() {
    let a = Atomic<i64>.new(1)
    // ERROR: `into_inner` reads the word without an ordering — it consumes the atomic
    println(a.into_inner(Ordering.SeqCst))
    return
}

// And the name genuinely not existing still says so, so the new branch didn't
// swallow the old one.
func no_such_name() {
    let a = Atomic<i64>.new(1)
    // ERROR: no method `increment` — the name is `fetch_add`
    println(a.increment(1, Ordering.SeqCst))
    return
}

// And the argument count being right doesn't make the call right. `fetch_add`
// on a struct payload is GA3: the payload fits a word — two `i32`s are eight
// bytes — so it isn't the width, it's that the hardware has nothing to add.
// That used to report as wrong arguments, which sent the reader to count them.
struct Pair {
    public a: i32
    public b: i32
}

func no_arithmetic_on_the_payload() {
    let a = Atomic<Pair>.new(Pair { a: 1, b: 2 })
    // ERROR: `fetch_add` needs a payload it can add, and `Pair` isn't one
    println(a.fetch_add(1, Ordering.SeqCst).a)
    return
}

func main() {
    too_many()
    too_few()
    into_inner_takes_none()
    no_such_name()
    no_arithmetic_on_the_payload()
    return
}
