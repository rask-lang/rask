// ERROR [mem.context/CC11]: the entry point declares a `using` context, and
// nothing can supply it — the process starts here, so there's no caller to pass
// the hidden parameter. It used to compile and run on garbage (#732): the
// uninitialized pointer went straight into `insert`, which panicked with
// "pool insert: elem_size mismatch".
//
// The fix is to own the pool in main and leave the clause on the callee, which
// is what tests/suite/t_context_entry_point.rk checks still works.

struct Player { health: i32 }

func main() using players: Pool<Player> {    // ERROR: nothing can supply this
    let h = players.insert(Player { health: 100 })
    print(players[h].health)
}
