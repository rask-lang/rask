// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `has<A>()`, `get<A>()` and `is<T>()` on a reflect item are answered while a
// `comptime for` unrolls (E0960). An ordinary `for` over the same Vec runs the
// body at run time, where native has no answer to give: these compiled and
// then failed at codegen with "Function not found: FieldInfo_has_label".
import std.reflect

annotation @label {
    name: string
}

struct Row {
    @label(name: "id")
    public id: i64
}

func runtime_has() -> i64 {
    mut n = 0
    for f in reflect.fields<Row>() {
        if f.has<label>() {          // ERROR: not a comptime for binding
            n += 1
        }
    }
    return n
}

func runtime_get() -> string {
    let fs = reflect.fields<Row>()
    return fs[0].get<label>().name   // ERROR: not a comptime for binding
}

func runtime_is() -> bool {
    let ps = reflect.params<func(i64)>()
    return ps[0].is<i64>()           // ERROR: not a comptime for binding
}

func main() {
    println("{runtime_has()} {runtime_get()} {runtime_is()}")
}
