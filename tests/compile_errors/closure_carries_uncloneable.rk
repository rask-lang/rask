// Compile Error: a closure value carrying something that can't be cloned
//
// Cloning a closure clones what it carries, so everything it carries has to be
// Cloneable. An interface object isn't.

func greeter(take d: any Displayable) -> func() -> string {
    // ERROR: carries an uncloneable capture [E0976]
    return || d.to_string()
}

func main() {
    let f = greeter(5 as any Displayable)
    println(f())
}
