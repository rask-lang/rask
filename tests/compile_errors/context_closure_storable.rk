// ERROR [mem.context/CC10]: a storable closure (bound to `cb`) can't inherit the
// enclosing function's ambient Pool<Player>. It must take the pool as an
// explicit parameter instead.

struct Player { health: i32 }

func damage(h: Handle<Player>) using players: Pool<Player> {
    print(players[h].health)
}

func main() {
    mut players = Pool<Player>.new()
    let h = players.insert(Player { health: 100 })
    let cb = |hh: Handle<Player>| { damage(hh) }    // ERROR: no explicit pool param
    cb(h)
}
