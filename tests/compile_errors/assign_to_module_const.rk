// Rejects: assigning to a module-level `const`
//
// Writing through a const with a method was caught, and a bare `=` wasn't:
// `LIMIT = 3` inside a function rebound the constant for the whole program,
// for every task at once.

const LIMIT: i64 = 1

func main() {
    // ERROR: a module `const` is one value for every task [E0856]
    LIMIT = 3
    // ERROR: and so is `+=` [E0856]
    LIMIT += 1

    // FIX: a local copy is yours to change
    mut limit = LIMIT
    limit += 1
    println("{limit}")
}
