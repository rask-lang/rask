// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Using a link after its node is deleted is a compile error (E0328).
//
// A `Link<T>` is a pointer to a node, and `delete` frees the node — so this is a
// use after free, proven rather than checked. Nothing is moved anywhere: the move
// checker is only the mechanism that tracks which names died.
//
// Not lifetime inference either: the invalidation point is the `delete` statement
// you wrote, not a last use the compiler worked out, so the analysis never leaves
// this function body.

struct Node {
    name: string
    next: Link<Node>?
}

func read_after_delete() {
    mut rack: Rack<Node> = Rack.new()
    let a = rack.insert(Node { name: "a", next: none })
    let b = rack.insert(Node { name: "b", next: none })
    a.next = b                  // fine: the field is an edge the rack maintains

    rack.delete(b)

    println("{b.name}")         // ERROR: E0328 — reading a freed node
}

func write_after_delete() {
    mut rack: Rack<Node> = Rack.new()
    let n = rack.insert(Node { name: "n", next: none })
    rack.delete(n)
    n.name = "zombie"           // ERROR: E0328 — same, for a write
}

func ask_after_delete() {
    mut rack: Rack<Node> = Rack.new()
    let n = rack.insert(Node { name: "n", next: none })
    rack.delete(n)
    // Also an error, and correctly so: if the type guarantees liveness, asking
    // whether it is live is a question with no meaning.
    println("{rack.contains(n)}")   // ERROR: E0328
}

func clear_after_delete() {
    mut rack: Rack<Node> = Rack.new()
    let n = rack.insert(Node { name: "n", next: none })
    // `clear` names no link, but it deletes every node — so it revokes every
    // local link into the rack, same as writing `delete` on each one.
    rack.clear()
    println("{n.name}")         // ERROR: E0328
}

func bulk_loop_after_delete() {
    mut rack: Rack<Node> = Rack.new()
    let n = rack.insert(Node { name: "n", next: none })
    let _other = rack.insert(Node { name: "o", next: none })
    // `x` is whichever node the loop reached, not a node the caller named — so
    // this is the same unnamed delete `clear` is, written longhand.
    for x in rack.nodes() {
        rack.delete(x)
    }
    println("{n.name}")         // ERROR: E0328
}

// The intra-function sibling of the cascade hole. `t` is a *derived* name — read
// out of an edge, so nothing tied it to `b` — and it may be pointing at whatever
// the delete names. A named delete kills one name only if the body can vouch for
// it, which means an `insert` it made or a `take` a caller handed over. Everything
// else dies with the delete.
func derived_alias_after_delete() {
    mut rack: Rack<Node> = Rack.new()
    let a = rack.insert(Node { name: "a", next: none })
    let b = rack.insert(Node { name: "b", next: none })
    a.next = b

    if a.next? as t {
        rack.delete(b)
        let _ = t.name          // ERROR: E0328 — `t` may be `b`
    }
}

// The other half of the same rule: `a` survives, because it has its own `insert`
// behind it and so cannot be a second name for `b`. This is the precision that
// makes the rule usable rather than a blanket kill.
func unrelated_link_survives_a_named_delete() {
    mut rack: Rack<Node> = Rack.new()
    let a = rack.insert(Node { name: "a", next: none })
    let b = rack.insert(Node { name: "b", next: none })
    a.next = b
    rack.delete(b)
    println("{a.name}")         // fine — no error here
}

func main() {
    read_after_delete()
    write_after_delete()
    ask_after_delete()
    clear_after_delete()
    bulk_loop_after_delete()
    derived_alias_after_delete()
    unrelated_link_survives_a_named_delete()
}
