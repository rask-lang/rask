// Rejects: a closure leaving the function over a borrow the frame doesn't own
//
// A closure that outlives its frame carries what it captured (mem.closures/CM1),
// so a local or a `take` parameter travels with it and none of that is an error
// any more. What it can't carry is something the frame only borrowed: a lent
// parameter is the caller's (CM3), and a `with` binding belongs to the block.
// Those stay borrowed, SL4 rides the limit out on the return, and returning
// past it is what this file tests.
//
// The passing side — everything a returned closure may now take with it — is in
// tests/suite/t_returned_closure_captures.rk.

func make(base: Vec<i64>) -> func(i64) -> i64 {
    return |x| x + base.len().wrap<i64>()
}

// ERROR: SL4 carries `make`'s limit out to the call, and `v` dies here
func returns_a_borrowed_result() -> func(i64) -> i64 {
    let v: Vec<i64> = [1, 2]
    return make(v)
}

func main() {
    let f = returns_a_borrowed_result()
    println("{f(1)}")
}
