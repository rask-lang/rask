// Compile Error: a struct literal names only the struct's own fields.
//
// A field the struct doesn't declare was inferred on its own and dropped, so
// `Pt { x: 1, xx: 2 }` compiled and ran on both backends (#1476).

struct Pt {
    x: i64
}

struct Holder<T> {
    item: T
}

func main() {
    // ERROR: no field `xx` on type `Pt`
    let p = Pt { x: 1, xx: 2 }
    // ERROR: a generic struct's literal is checked the same way
    let h = Holder { item: 1, itme: 2 }
    println(p.x)
    println(h.item)
}
