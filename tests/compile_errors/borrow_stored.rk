// Rejects: `string[..]` written as a type
//
// The slice expression `s[0..5]` is a borrow into `s`'s buffer and lives for
// one statement (B3, S3). There is no type spelling for it, because the thing
// you'd want to store isn't a borrow at all: `StringView` shares the source's
// buffer and holds a refcount on it, so it can go in a struct and outlive the
// statement without dangling (std.strings/V1).
//
// So `input: string[..]` is a syntax error, not a borrow-escape error, and this
// file can only test the parser. Keeping the value past its statement — the
// actual S3 rejection — is in borrow_errors.rk, where the checker gets to run.

// ERROR: `string[..]` is not a type — a slice expression has no type spelling
struct Parser {
    input: string[..]
    position: usize
}

// The way to write it:
//
//   import string.StringView
//
//   struct Parser {
//       input: StringView
//       position: usize
//   }
//
//   func make_parser(s: string) -> Parser {
//       return Parser { input: s[0..5].view(), position: 0 }
//   }
//
// `.view()` is where the refcount is taken, which is why the storable form
// needs a call and the borrow doesn't.
