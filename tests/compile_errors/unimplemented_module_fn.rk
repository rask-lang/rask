// Compile Error: a stdlib module function whose signature has nothing behind it.
//
// Methods on a receiver were already caught here; module functions took a
// different route through the checker and got no check at all. `json.decode`
// type-checked, compiled, and segfaulted at the call (#506). It's implemented
// now, so the gate rides on `json.to_value`, which still has only a signature.

import json

struct User {
    public name: string
}

func main() {
    const u = User { name: "alice" }
    // ERROR: `json.to_value` is declared but not implemented yet
    const value = json.to_value(u)
    println("unreachable")
}
