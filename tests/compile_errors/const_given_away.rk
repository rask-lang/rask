// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Rejects: giving away a non-Copy module const (mem.ownership/O11, E0883).
//
// A const is one value every function reads, so no function owns it. Handing
// it to a `take` parameter was refused, but `let x = ORIGIN` wasn't: the
// interpreter treated the binding as a move and emptied the const, so the next
// read of it found nothing. A function value is not Copy either, so a const
// holding one is the same case.

struct Point3 {
    x: i64
    y: i64
    z: i64
}

const ORIGIN: Point3 = Point3(x: 0, y: 0, z: 0)

func answer() -> i64 {
    return 42
}

const PICK: func() -> i64 = answer

func keep(take p: Point3) -> i64 {
    return p.x
}

test "binding a const makes the binding its owner" {
    // ERROR: cannot give away `ORIGIN` [E0883]
    let p = ORIGIN
    assert p.y == ORIGIN.y
}

test "a function value in a const" {
    // ERROR: cannot give away `PICK` [E0883]
    let f = PICK
    assert f() == PICK()
}

test "a take parameter" {
    // ERROR: cannot give away `ORIGIN` [E0883]
    assert keep(ORIGIN) == 0
}

// --- none of these give it away ---
test "reading, calling and cloning" {
    assert ORIGIN.z == 0
    assert PICK() == 42
    let p = ORIGIN.clone()
    assert keep(p) == 0
    let f = PICK.clone()
    assert f() == 42
}
