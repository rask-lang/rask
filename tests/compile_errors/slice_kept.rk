// Compile Error: a string slice kept past the expression that cut it (E0303, E0308)
//
// `s[i..j]` and `s.trim()` are slices (std.strings/S2): the bytes they cover
// and where they sit in `s`, with no copy. `StringSlice` is declared
// `@temporary` (type.temporary), so one lives for its expression: a binding,
// a field or a container's element can't keep it (E0303). Returning it into a
// `string`, or passing it where a `string` goes, is a type mismatch whose fix
// names the conversion the type declares (E0308). The two ways to keep one are
// named either way: `.to_string()` copies, `.view()` shares the source's
// buffer.

import string.StringSlice

func head(s: string) -> string {
    // ERROR: mismatched types [E0308]
    return s[0..2]
}

struct Holder {
    text: string
}

func held(s: string) -> Holder {
    // ERROR: mismatched types [E0308]
    return Holder(text: s[0..3])
}

func shout(s: string) -> string {
    return s.to_uppercase()
}

func passed(s: string) -> string {
    // ERROR: mismatched types [E0308]
    return shout(s.trim())
}

func pieces(line: string) -> usize {
    // ERROR: a `Vec<StringSlice>` would keep `StringSlice` values [E0303]
    let parts = line.split(",").to_vec()
    return parts.len()
}

struct Cut {
    // ERROR: `Cut.piece` would keep a `StringSlice` [E0303]
    piece: StringSlice
}

func main() {
    let s = "  hello world  "
    // ERROR: `t` would keep a `StringSlice` [E0303]
    let t = s.trim()
    // ERROR: a `Vec<StringSlice>` would keep `StringSlice` values [E0303]
    mut parts = Vec.new()
    parts.push(s.trim())
    println("{parts.len()} {head(s)} {held(s).text} {pieces(s)} {passed(s)} {t.len()}")
}
