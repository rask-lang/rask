// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Rejects: `[x; n]` of a value that moves
//
// `[row("a", 2); 3]` compiled and put the same `Row` in all three slots, so
// the array's release freed its one `tags` buffer three times and native
// segfaulted (#2050). A `Shared` is a counted reference, and copying it into
// slots takes no references, so it doesn't repeat either, nor pass a `T: Copy`
// bound. Copy values still repeat.

import sync.Shared

struct Row { public name: string, public tags: Vec<i64> }

func row(name: string, n: i64) -> Row {
    mut tags: Vec<i64> = Vec.new()
    for i in 0..n {
        tags.push(i)
    }
    return Row(name: name, tags: tags)
}

func fill<T>(x: T) -> [T; 2] {
    // ERROR: `T` could be a `Vec` [E0979]
    return [x; 2]
}

func fill_copy<T: Copy>(x: T) -> [T; 2] {
    return [x; 2]
}

func main() {
    // ERROR: each slot would own the same buffer [E0979]
    let v = [row("a", 2); 3]
    let zeros = [0i64; 4]
    let names = ["x"; 3]
    let pairs = fill_copy((1, 2))
    let sh = Shared.new(1)
    // ERROR: `Shared<i64, Readers>` isn't Copy [E0979]
    let boxes = [sh; 2]
    // ERROR: `Shared<i64, Readers>` isn't Copy [E0333]
    let more = fill_copy(Shared.new(2))
    println("{boxes.len()} {more.len()}")
    println("{v.len()} {zeros.len()} {names.len()} {pairs.len()}")
}
