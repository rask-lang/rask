// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A terminal that answers with one of the items it walked hands back
// something the source still owns (type.sequence/SEQ47). For an item that
// isn't Copy that's a second owner: `vv.find(…)` over `Vec<Vec<i64>>` gave
// back the inner vector `vv` held, and natively both freed it (#2028).

struct Big {
    a: string
    b: string
    c: string
}

func main() {
    let vv: Vec<Vec<i64>> = [[1, 2], [3], [4, 5, 6]]

    // ERROR: `find` on the Vec itself [E0977]
    let m = vv.find(|v| v.len() == 1)

    // ERROR: `max_by_key` [E0977]
    let n = vv.max_by_key(|v| v.len())

    // ERROR: `reduce` seeds with the first item, which stays the Vec's [E0977]
    let r = vv.reduce(|a, b| if b.len() > a.len() { b.clone() } else { a.clone() })

    // ERROR: a lending chain hands on the same items [E0977]
    let f = vv.filter(|v| v.len() > 1).min_by_key(|v| v.len())

    // ERROR: the lent half of an `enumerate` pair [E0977]
    let e = vv.enumerate().find(|p| p.0 == 1)

    mut bs: Vec<Big> = Vec.new()
    bs.push(Big(a: "x", b: "y", c: "z"))
    // ERROR: a struct over 16 bytes isn't Copy either [E0977]
    let k = bs.find(|b| b.a == "x")

    // A `map` makes values the chain owns, a Copy item copies, and `position`
    // finds the one to clone.
    let owned = vv.map(|v| v.clone()).max_by_key(|v| v.len())
    let xs: Vec<i64> = [3, 1, 2]
    let big = xs.find(|x| x > 1)
    if vv.position(|v| v.len() == 1)? as i {
        println(vv[i].len())
    }
    println("{(owned ?? Vec.new()).len()} {big ?? 0}")
}
