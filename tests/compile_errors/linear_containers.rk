// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Compile Error: linear values in Vec/Map (mem.resource-types/RC1, RC3)
//
// Two kinds of linear value, and they are linear for different reasons: a
// `@resource` struct because of what it holds, a `Heap<T>` because it *is* the
// allocation someone has to give back. Both are covered — the Vec check used to
// catch only the first (#1245).
//
// Vec and Map drop can't consume their elements, so a linear value (@resource,
// a transitively-linear struct/enum, or an optional/tuple/array built from one)
// can't live inside them — it would be silently dropped, breaking
// consume-exactly-once. Pool<T> (RC2) and T? (RC4) are the sanctioned
// containers. Every route a linear type can reach a Vec/Map is covered below.

import memory.Heap

@resource
struct File {
    fd: i32
}

extend File {
    func open() -> File {
        return File { fd: 1 }
    }
    func close(take self) -> void {
        return
    }
}

// A plain struct that transitively holds a resource is itself linear.
struct Wrapper {
    inner: File
}

// ── RC1: Vec ────────────────────────────────────────────────────────

// Route: direct binding annotation
func vec_annotation() -> void {
    let files: Vec<File> = Vec.new()   // ERROR [RC1]: `Vec` cannot hold linear value `File`
    return
}

// Route: inferred element via push (no annotation)
func vec_push() -> void {
    // ERROR [RC1]: element unifies to `File` through the push below
    mut files = Vec.new()
    files.push(File.open())
    return
}

// Route: function parameter
func vec_param(files: Vec<File>) -> void {   // ERROR [RC1]: `Vec` cannot hold linear value `File`
    return
}

// Route: return type
func vec_return() -> Vec<File> {             // ERROR [RC1]: `Vec` cannot hold linear value `File`
    return Vec.new()
}

// Route: struct field
struct HasVec {
    files: Vec<File>                     // ERROR [RC1]: `Vec` cannot hold linear value `File`
}

// Route: transitively-linear element
func vec_transitive() -> void {
    let ws: Vec<Wrapper> = Vec.new()   // ERROR [RC1]: `Vec` cannot hold linear value `Wrapper`
    return
}

// Route: nested Vec<Vec<File>>
func vec_nested() -> void {
    let vv: Vec<Vec<File>> = Vec.new() // ERROR [RC1]: innermost `Vec` cannot hold `File`
    return
}

// Route: optional element (RC4 optional is fine on its own, but not inside a Vec)
func vec_optional() -> void {
    let opts: Vec<File?> = Vec.new()   // ERROR [RC1]: `Vec` cannot hold linear value `File?`
    return
}

// Route: type alias
type alias FileList = Vec<File>          // ERROR [RC1]: `Vec` cannot hold linear value `File`

// ── The same rule for `Heap<T>`, which is linear by being the obligation ──
//
// A `@resource` struct is linear because of what it holds; a `Heap<T>` *is* the
// obligation — the allocation someone has to give back. `Vec<Heap<i64>>`
// type-checked for a while because the Vec check asked "does this hold anything
// linear inside it", and a `Heap` holds a plain `i64`. The Map half asked the
// right question, which is how the asymmetry turned up (#1245).

func vec_of_heap() -> void {
    let hs: Vec<Heap<i64>> = Vec.new()   // ERROR [RC1]: `Vec` cannot hold linear value `Heap<i64>`
    return
}

// Inferred through a push, with no annotation to read it off.
func vec_of_heap_inferred() -> void {
    // ERROR [RC1]: element unifies to `Heap<i64>` through the push below
    mut hs = Vec.new()
    hs.push(Heap(7))
    return
}

func heap_param(hs: Vec<Heap<i64>>) -> void {   // ERROR [RC1]: `Vec` cannot hold linear value `Heap<i64>`
    return
}

struct HasHeapVec {
    boxes: Vec<Heap<i64>>                // ERROR [RC1]: `Vec` cannot hold linear value `Heap<i64>`
}

func map_of_heap() -> void {
    let m: Map<string, Heap<i64>> = Map.new()   // ERROR [RC3]: `Map` cannot hold linear value `Heap<i64>`
    return
}

// ── RC3: Map ────────────────────────────────────────────────────────

// Route: Map value is linear
func map_value() -> void {
    let m: Map<string, File> = Map.new()   // ERROR [RC3]: `Map` cannot hold linear value `File`
    return
}

// Route: Map key is linear (a resource key is as unconsumable on drop as a value)
func map_key() -> void {
    let m: Map<File, string> = Map.new()   // ERROR [RC3]: `Map` cannot hold linear value `File`
    return
}

func main() -> void {
    return
}
