// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Compile Error: linear values in a container (mem.resource-types/RC1-RC3)
//
// Vec and Map drop can't consume their elements, and `Rack.delete` frees a node
// rather than handing it back, so a linear value (@resource, a transitively-
// linear struct/enum, or an optional/tuple/array built from one) can't live in
// any of them — it would be silently dropped, breaking consume-exactly-once.
// `T?` (RC4) is what's left. Every route a linear type can reach a container is
// covered below.

import memory.Rack

@resource
struct File {
    fd: i32
}

extend File {
    func open() -> File {
        return File { fd: 1 }
    }
    func close(take self) -> void {
        return
    }
}

// A plain struct that transitively holds a resource is itself linear.
struct Wrapper {
    inner: File
}

// ── RC1: Vec ────────────────────────────────────────────────────────

// Route: direct binding annotation
func vec_annotation() -> void {
    let files: Vec<File> = Vec.new()   // ERROR [RC1]: `Vec` cannot hold linear value `File`
    return
}

// Route: inferred element via push (no annotation)
func vec_push() -> void {
    // ERROR [RC1]: element unifies to `File` through the push below
    mut files = Vec.new()
    files.push(File.open())
    return
}

// Route: function parameter
func vec_param(files: Vec<File>) -> void {   // ERROR [RC1]: `Vec` cannot hold linear value `File`
    return
}

// Route: return type
func vec_return() -> Vec<File> {             // ERROR [RC1]: `Vec` cannot hold linear value `File`
    return Vec.new()
}

// Route: struct field
struct HasVec {
    files: Vec<File>                     // ERROR [RC1]: `Vec` cannot hold linear value `File`
}

// Route: transitively-linear element
func vec_transitive() -> void {
    let ws: Vec<Wrapper> = Vec.new()   // ERROR [RC1]: `Vec` cannot hold linear value `Wrapper`
    return
}

// Route: nested Vec<Vec<File>>
func vec_nested() -> void {
    let vv: Vec<Vec<File>> = Vec.new() // ERROR [RC1]: innermost `Vec` cannot hold `File`
    return
}

// Route: optional element (RC4 optional is fine on its own, but not inside a Vec)
func vec_optional() -> void {
    let opts: Vec<File?> = Vec.new()   // ERROR [RC1]: `Vec` cannot hold linear value `File?`
    return
}

// Route: type alias
type alias FileList = Vec<File>          // ERROR [RC1]: `Vec` cannot hold linear value `File`

// ── RC3: Map ────────────────────────────────────────────────────────

// Route: Map value is linear
func map_value() -> void {
    let m: Map<string, File> = Map.new()   // ERROR [RC3]: `Map` cannot hold linear value `File`
    return
}

// Route: Map key is linear (a resource key is as unconsumable on drop as a value)
func map_key() -> void {
    let m: Map<File, string> = Map.new()   // ERROR [RC3]: `Map` cannot hold linear value `File`
    return
}

// ── RC2: Rack ───────────────────────────────────────────────────────

// `Pool.remove` answered `T?`, which is what made a pool the one container a
// linear value could live in. `Rack.delete` answers nothing, so a rack is in
// with Vec and Map (rask-lang/rask#908).
func rack_node() -> void {
    let r: Rack<File> = Rack.new()         // ERROR [RC2]: `Rack` cannot hold linear value `File`
    return
}

// Route: transitively linear node
func rack_wrapper() -> void {
    let r: Rack<Wrapper> = Rack.new()      // ERROR [RC2]: `Rack` cannot hold linear value `Wrapper`
    return
}

func main() -> void {
    return
}
