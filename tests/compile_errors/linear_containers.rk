// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Compile Error: linear values in containers (mem.resource-types/RC1-RC5)
//
// A `Vec` or `Map` can hold values that must be consumed, and is then owed
// itself: `pop` and `remove` hand elements back, `consume` takes the lot.
// What it can't do is lose one. A method that would drop an element (`clear`,
// `set`, writing over `v[i]`) or hand out a copy of one (`get`, `first`) is
// refused on such a container, in a generic body too, once a call makes the
// element linear, and so is a `for` over `take_all()`, which drops the rest on
// an early exit. A `Rack` can't hold one at all: `delete` frees the node
// rather than handing it back.

import memory.Rack
import memory.Heap

@resource
struct File {
    fd: i32
}

extend File {
    func open() -> File {
        return File(fd: 1)
    }
    func close(take self) -> void {
        return
    }
}

// A plain struct that transitively holds a resource is itself linear.
struct Wrapper {
    inner: File
}

// ── RC1: a Vec of resources is owed ────────────────────────────────

func never_consumed() {
    mut files: Vec<File> = Vec.new()
    ensure files.consume(|take f| f.close())
    files.push(File.open())
    let other: Vec<File> = Vec.new()     // ERROR: E0805
}

// ── RC5: nothing may drop or copy an element ───────────────────────

func cleared(mutate files: Vec<File>) {
    files.clear()                        // ERROR: E0823
}

func overwritten(mutate files: Vec<File>) {
    files.set(0, File.open())            // ERROR: E0823
}

func written_over(mutate files: Vec<File>) {
    files[0] = File.open()               // ERROR: E0823
}

func filtered(mutate files: Vec<File>) {
    files.remove_where(|f| f.fd == 1)    // ERROR: E0823
}

func copied_out(files: Vec<File>) -> i32 {
    // ERROR: E0823
    if files.first()? as f {
        return f.fd
    }
    return 0
}

func copied_from_a_map(m: Map<string, File>) -> i32 {
    // ERROR: E0823
    if m.get("a")? as f {
        return f.fd
    }
    return 0
}

func map_cleared(mutate m: Map<string, Wrapper>) {
    m.clear()                            // ERROR: E0823
}

func heaps_cleared(mutate hs: Vec<Heap<i64>>) {
    hs.clear()                           // ERROR: E0823
}

// The loop owns what `take_all` hands back, so a `break`, `return` or `try`
// out of it drops the rest. `while files.pop()? as f` leaves them in `files`.
func drained_by_for(mutate files: Vec<File>) {
    // ERROR: E0844
    for f in files.take_all() {
        f.close()
    }
}

// A generic body is checked against each type it's called with.
func wipe<T>(mutate v: Vec<T>) {
    v.clear()
}

func wiped(mutate files: Vec<File>) {
    wipe(mutate files)                   // ERROR: E0849
}

// Fine: looked at where they live, taken out to be closed.
func handled(mutate files: Vec<File>) -> i32 {
    mut sum: i32 = 0
    for f in files {
        sum += f.fd
    }
    with files[0] as f {
        sum += f.fd
    }
    let taken = files.remove(0)
    taken.close()
    while files.pop()? as f {
        f.close()
    }
    return sum
}

// ── RC2: Rack ───────────────────────────────────────────────────────

func rack_node() -> void {
    let r: Rack<File> = Rack.new()         // ERROR: E0820
    return
}

func rack_wrapper() -> void {
    let r: Rack<Wrapper> = Rack.new()      // ERROR: E0820
    return
}

func main() -> void {
    return
}
