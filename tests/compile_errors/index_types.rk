// Compile Error: index expression types (#310, std.collections/V1).
// Vec/array/string are position-indexed by an integer; `Map<K,V>` by `K`.
// A range index slices a string and nothing else — see
// `range_slice_rejected.rk` for the Vec and array halves of that.

// --- Vec indexed by a string ---
// ERROR: cannot index `Vec` with `string` [E0819]
func vec_string_index() {
    mut v = Vec.new()
    v.push(10)
    let s = "x"
    let bad = v[s]
    println("{bad}")
}

// --- Vec indexed by a float ---
// ERROR: cannot index `Vec` with `f64` [E0819]
func vec_float_index() {
    mut v = Vec.new()
    v.push(10)
    let bad = v[1.5]
    println("{bad}")
}

// --- string indexed by a string ---
// ERROR: cannot index `string` with `string` [E0819]
func string_string_index() {
    let s = "hello"
    let k = "x"
    let bad = s[k]
    println("{bad}")
}

// --- Map<string, i32> indexed by an integer key ---
// ERROR: cannot index `Map` with `i32` [E0819]
func map_wrong_key() {
    mut m = Map.new()
    m.insert("a", 1)
    let bad = m[5]
    println("{bad}")
}

// --- range slice on a Map (keyed, so it has no positions at all) ---
// ERROR: cannot slice `Map` with a range [E0819]
func map_range_slice() {
    mut m = Map.new()
    m.insert("a", 1)
    let bad = m[0..2]
    println("{bad}")
}
