// A comptime block hands a `Vec` or `Map` to runtime only through
// `.freeze()` (ctrl.comptime/CT19, E0903). Spec'd and not checked until now:
// examples/17_comptime.rk returned its tables bare.

const SQUARES = comptime {
    mut v = Vec.new()
    for i in 0..10 {
        v.push(i * i)
    }
    // ERROR: E0903, the block's value is the vector itself
    v
}

const NAMES = comptime {
    mut m = Map.new()
    m.insert(1, "one")
    // ERROR: E0903, a map the same
    m
}

// Fine: frozen as the last expression, or through a binding set from one.
const CUBES = comptime {
    mut v = Vec.new()
    for i in 0..10 {
        v.push(i * i * i)
    }
    v.freeze()
}

const ODDS = comptime {
    mut v = Vec.new()
    for i in 0..5 {
        v.push(i * 2 + 1)
    }
    let frozen = v.freeze()
    frozen
}

func main() {
    println(SQUARES[2] + CUBES[2] + ODDS[2])
    println(NAMES.len())
}
