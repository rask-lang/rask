// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Rejects: an expression statement whose value is a `T or E`
// (type.errors/ER50, E0419), and `@allow(unused_result)`, which no longer names
// anything (E0855).
//
// Ignoring a result used to be a warning. It's an error now, with no opt-out:
// `save()!` panics with the error's message, `try save()` passes it on, and
// `let _ = save()` drops it where anyone reading can see.

import thread.Thread
import sync.Shared

struct SaveError {
    detail: string
}

extend SaveError {
    public func message(self) -> string {
        return self.detail
    }
}

func save(n: i64) -> void or SaveError {
    if n < 0 {
        return SaveError(detail: "negative")
    }
    return
}

func number(n: i64) -> i64 or SaveError {
    if n < 0 {
        return SaveError(detail: "negative")
    }
    return n
}

func maybe_name(n: i64) -> string? {
    if n < 0 {
        return none
    }
    return "ok"
}

// --- a bare call, in a function that could have propagated it ---
func bare_call() -> void or SaveError {
    // ERROR: result of type `void or SaveError` is ignored [E0419]
    save(1)
    return
}

// --- an `if` arm written as a statement drops what it ends with ---
func in_a_branch(c: bool) {
    if c {
        // ERROR: result of type `void or SaveError` is ignored [E0419]
        save(2)
    }
}

// --- the same, in a loop ---
func in_a_loop() {
    for i in 0..3 {
        // ERROR: result of type `void or SaveError` is ignored [E0419]
        save(i)
    }
}

// --- inside every kind of block, not only function bodies ---
func in_a_using_block() {
    using Multitasking {
        // ERROR: result of type `void or SaveError` is ignored [E0419]
        save(11)
        println("using")
    }
}

func in_a_with_block() {
    let m = Shared<i64>.mutex(0)
    with m.write() as v {
        // ERROR: result of type `void or SaveError` is ignored [E0419]
        save(12)
        v += 1
    }
}

func in_a_loop_value() -> i64 {
    let x = loop {
        // ERROR: result of type `void or SaveError` is ignored [E0419]
        save(13)
        break 5
    }
    return x
}

func in_a_comptime_block() -> i64 {
    let y = comptime {
        // ERROR: result of type `i64 or SaveError` is ignored [E0419]
        number(14)
        7
    }
    return y
}

// --- all but the last statement of an `ensure` body; the last is the cleanup ---
func in_an_ensure_block() {
    ensure {
        // ERROR: result of type `void or SaveError` is ignored [E0419]
        save(15)
        println("between")
        save(16)
    }
}

// --- the value is a result even though no call is written ---
// `!` strips the join error and leaves what the task's body returned.
func after_a_join() {
    // ERROR: result of type `void or SaveError` is ignored [E0419]
    Thread.spawn { return save(17) }.join()!
}

// A `catch` handler's value goes nowhere when the `catch` is a statement.
func in_a_catch_handler() {
    // ERROR: result of type `void or SaveError` is ignored [E0419]
    save(18) catch _ => save(19)
}

// --- the opt-out that used to exist ---
// ERROR: `@allow(unused_result)` names nothing [E0855]
@allow(unused_result)
func allowed() {
    // ERROR: result of type `void or SaveError` is ignored [E0419]
    save(4)
}

// --- every accepted way to deal with it still compiles ---
func handled(c: bool) -> void or SaveError {
    save(5)!
    try save(6)
    save(7) catch _ => {}
    save(8) catch e => println(e.message())
    let _ = save(9)
    let answer = Thread.spawn { return save(10) }.join()!
    answer!
    let m = Shared<i64>.mutex(0)
    with m.write() as v {
        v += 1
        save(20)!
    }
    // An optional isn't a failure: nothing to handle.
    maybe_name(1)
    return
}

func main() {
    handled(true) catch _ => {}
}
