// LP14: structural mutation during `for mutate`
// Rejects: cannot push during mutable iteration

func test_structural_mutation() {
    mut items = Vec.new<string>()
    items.push("hello")

    for mutate item in items {
        item = "updated"
        items.push("extra")    // ERROR LP14: structural mutation
    }
}

// LP16: passing for-mutate item to take parameter
//
// The element type is a `Vec` rather than a `string` because `take` only means
// something for a type that is given away: a `string` is Copy, and `take s:
// string` is the PM6c error rather than the rule this file is about.

func consume(take tags: Vec<string>) {
    println("{tags.len()}")
}

func test_take_item() {
    mut rows: Vec<Vec<string>> = Vec.new()
    mut first: Vec<string> = Vec.new()
    first.push("hello")
    rows.push(first)

    for mutate row in rows {
        consume(row)       // ERROR LP16: take from borrowed element
    }
}

func main() {
    test_structural_mutation()
    test_take_item()
}
