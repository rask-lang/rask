// Rejects: `self` anywhere but a method's first parameter
//
// `func f(a: i32, self)` compiled, and natively read `a`'s slot as the
// receiver; the interpreter failed at the field access. A free `func f(self)`
// was an ordinary parameter that happened to be called `self`.

struct Point { x: i32 }

extend Point {
    // ERROR: the receiver comes first [E0219]
    func shifted(by: i32, self) -> i32 {
        return by + self.x
    }
}

// ERROR: a free function has no receiver [E0219]
func lonely(self) -> i32 {
    return 1
}

func main() {}
