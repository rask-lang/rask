// Compile Error: no conformance takes the call's arguments (type.generics/GT7)
// Rejects: `render` called with a `string` on a type whose conformances take
// `Html` and `Json`. Each conformance keeps its own `render`, and the arguments
// pick one; here none fits, so the error names the ones that exist.

interface Render<F> {
    func render(self, f: F) -> string
}

struct Html {
    level: i64
}

struct Json {
    pretty: bool
}

struct Report {
    title: string
}

Report implements Render<Html> {
    func render(self, f: Html) -> string {
        return self.title
    }
}

Report implements Render<Json> {
    func render(self, f: Json) -> string {
        return self.title
    }
}

func main() {
    let r = Report(title: "q3")
    // ERROR: E0972, there's no `Render<string>`
    println(r.render("plain"))
}
