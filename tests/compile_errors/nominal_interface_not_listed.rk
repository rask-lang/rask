// Compile Error: a nominal newtype inherits nothing it didn't ask for (T10).
//
// The other half of #551: the `implements …` list is now honoured, so it has to
// stay a list and not become "everything the underlying type can do".

type OnlyEq = u64 implements Equal
type Money = i64 implements Numeric, Equal

struct Board {
    n: i64
}

extend Board {
    // A static method the newtype inherits answers the newtype, not whatever
    // the context wants. `Self` was left open, so this passed as a `Board`
    // (#2004).
    func weird(self) -> Board {
        // ERROR: expected `Board`, found `Money`
        return Money.zero()
    }
}

func main() {
    let a = OnlyEq(1)
    let b = OnlyEq(2)
    // Equal was listed, so this is fine.
    println("eq={a == b}")

    // ERROR: no method `lt` found for type `OnlyEq`
    println("lt={a < b}")

    // ERROR: no `+` between `OnlyEq` and `OnlyEq` — `Add` wasn't listed, and
    // ERROR: an operator answers to a declared conformance
    let sum = a + b
    println("sum={sum}")

    // ERROR: `Money` doesn't list `Comparable`, so no inherited `max`
    let m = Money.zero().max(Money.one())
    println("{Board(n: 1).weird().n} {m.value}")
}
