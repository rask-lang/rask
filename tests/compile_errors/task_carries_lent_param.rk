// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Rejects: a task that may outlive the call reading a parameter it was lent
//
// A detached task read the caller's `items` after the function returned and
// the caller freed them (#2033). A task whose handle can leave the block
// carries its captures, and a borrowed parameter isn't the function's to hand
// over. Copy values, owned (`take`) values and tasks joined in this block
// are fine.

func detached_reads(items: Vec<i64>) {
    spawn {
        // ERROR: the caller only lent [E0862]
        println("{items.len()}")
    }.detach()
}

func detached_calls(f: func() -> i64) {
    spawn {
        // ERROR: the caller only lent [E0862]
        println("{f()}")
    }.detach()
}

func copy_param(n: i64) {
    spawn {
        println("{n}")
    }.detach()
}

func owned_param(take items: Vec<i64>) {
    spawn {
        println("{items.len()}")
    }.detach()
}

func joined(items: Vec<i64>) -> i64 {
    let h = spawn { return items.len().wrap<i64>() }
    return h.join()!
}

func joined_in_match(items: Vec<i64>) -> i64 {
    let h = spawn { return items.len().wrap<i64>() }
    match h.join() {
        i64 as n => return n
        JoinError as _ => return 0
    }
}

func main() {
    using Multitasking {
        let v: Vec<i64> = [1, 2]
        detached_reads(v)
        detached_calls(|| 1)
        copy_param(3)
        owned_param([4])
        println("{joined(v)} {joined_in_match(v)}")
    }
}
