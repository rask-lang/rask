// Rejects: Calling a function that requires a context without providing it
//
// This demonstrates the compile error when calling a context-requiring function
// from a scope where the required pool is not available.
import memory.Handle
import memory.Pool

struct Enemy {
    health: i32,
}

// This function requires Pool<Enemy> context
public func damage(h: Handle<Enemy>, amount: i32) using Pool<Enemy> {
    h.health -= amount
}

// A public function is where propagation stops: the signature is what a caller
// in another module reads, so the compiler won't add a hidden parameter behind
// it (CC6). A private function here would have the context propagated instead.
public func process_damage(h: Handle<Enemy>) {
    damage(h, 10)    // ERROR: cannot satisfy Pool<Enemy> requirement
}

// Expected error message:
//
// error: cannot satisfy context requirement Pool<Enemy>
//   --> context_unavailable.rk:17
//    |
// 17 |     damage(h, 10)
//    |     ^^^^^^ function requires Pool<Enemy>
//    |
// 16 | func process_damage(h: Handle<Enemy>) {
//    |      -------------- no Pool<Enemy> in scope
//    |
//    help: add Pool<Enemy> to process_damage's signature:
//          func process_damage(h: Handle<Enemy>) using Pool<Enemy>
//
//    help: or pass pool explicitly:
//          func process_damage(enemies: Pool<Enemy>, h: Handle<Enemy>)

// FIX 1: Declare the context — it propagates on to `damage`
public func process_damage_fixed(h: Handle<Enemy>) using Pool<Enemy> {
    damage(h, 10)    // ✅ Context propagates
}

// FIX 2: Take pool as explicit parameter
public func process_damage_explicit(mutate enemies: Pool<Enemy>, h: Handle<Enemy>) {
    enemies[h].health -= 10
}

// FIX 3: Have pool in scope via local variable
func game_loop() {
    mut enemies: Pool<Enemy> = Pool.new()
    let h = enemies.insert(Enemy { health: 100 })

    damage(h, 10)    // ✅ Compiler passes enemies implicitly
}
