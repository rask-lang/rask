// Compile Error: decoding a type that has a checking constructor (std.encoding/E12a).
//
// `Port.new` rejects 0. A derived `Decode` builds a `Port` straight from the
// wire and never calls it, so `json.decode<Port>("{\"value\": 0}")` used to
// return a port the constructor refuses. The error names the constructor, and
// reaches through containers and fields: a `Vec<Port>` skips it just the same.

import json

struct PortError {
    reason: string
}

extend PortError {
    public func message(self) -> string {
        return self.reason
    }
}

struct Port {
    value: u16
}

extend Port {
    func new(v: u16) -> Port or PortError {
        if v == 0 {
            return PortError(reason: "port 0 is reserved")
        }
        return Port(value: v)
    }
}

struct Listener {
    name: string
    ports: Vec<Port>
}

func main() {
    // ERROR: `Port` cannot be decoded: `Port.new` checks its input [E0418]
    let p = json.decode<Port>("{{\"value\": 0}") catch e => {
        return
    }
    println("{p.value}")

    // ERROR: the same, through a field's `Vec` [E0418]
    let l = json.decode<Listener>("{{\"name\": \"a\", \"ports\": [{{\"value\": 0}]}") catch e => {
        return
    }
    println(l.name)
}
