// Compile Error: `return` in a constant's initializer
//
// A block that computes a constant isn't a function body, so there is
// nothing for `return` to leave.

const LIMIT: i64 = {
    // ERROR: return outside of function [E0206]
    return 1
}

func main() {
    println(LIMIT)
}
