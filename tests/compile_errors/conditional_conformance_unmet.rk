// ERROR: a conditional conformance whose `where` condition isn't met (CC1)
// Expected: typecheck error E0333 — `Blob` does not implement `Show`

trait Show {
    func show(self) -> string
}

struct Blob { v: i64 }   // does NOT conform to Show

struct Ring<T> { items: Vec<T> }
extend Ring<T> with Show where T: Show {
    func show(self) -> string { return "ring" }
}

func present(x: T) -> string where T: Show { return x.show() }

func main() {
    mut v = Vec.new<Blob>()
    v.push(Blob { v: 1 })
    const r = Ring { items: v }
    // Ring<Blob> can't satisfy `T: Show` because Blob doesn't implement Show.
    println("{present(r)}")
}
