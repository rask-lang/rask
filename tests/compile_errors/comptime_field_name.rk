// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Compile Error: the field name in `value.("x")` has to name a real field
// ERROR: no field `nope` on type `Budget9`
//
// `value.("x")` is a field access with the name in quotes, so a name that isn't
// a field is the same error `value.x` gives, at the same point in the pipeline.
//
// It has to be that way. Ordinary field lowering answers "field 0, i64" for a
// name it can't find in the struct layout — safe only because the checker
// rejects `p.nope` long before anything reaches lowering. While the literal
// form went unchecked, `p.("nope")` quietly read the first field and reported
// nothing (#930).
//
// The name being known at compile time is checked too, but later: `p.(f.name)`
// inside a `comptime for` is only knowable once the loop is unrolled, which
// happens during MIR lowering, so the "has to be comptime-known" error lands
// there rather than here.

struct Budget9 {
    spent: i64
    limit: i64
}

// ERROR: `nope` isn't a field of Budget9 — it has `spent` and `limit`.
func typo(b: Budget9) -> i64 {
    return b.("nope")
}

// THE FIX: name a field that exists. Both spellings the syntax allows work —
// the literal, and a binding holding a compile-time string.
func works(b: Budget9) -> i64 {
    let which = comptime { "limit" }
    return b.("spent") + b.(which)
}

func main() {
    let b = Budget9 { spent: 3, limit: 10 }
    println("{works(b)}")
}
