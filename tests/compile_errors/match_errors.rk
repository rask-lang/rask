// Compile Error: Pattern matching violations
//
// Spec: type.enums (PM1-PM5), ctrl.flow (CF8-CF15)

// --- non-exhaustive match (PM2) ---
// ERROR: non-exhaustive match — missing variant 'Blue'
enum Color { Red, Green, Blue }

func test_nonexhaustive() {
    let c = Color.Red
    match c {
        Red => println("red"),
        Green => println("green"),
        // missing Blue
    }
}

// --- wildcard discards linear resource (PM5) ---
@resource
struct File { fd: i32 }

struct GuardError { detail: string }

extend GuardError {
    public func message(self) -> string {
        return self.detail
    }
}

func open_file() -> File or GuardError {
    return File { fd: 1 }
}

func test_wildcard_linear() {
    let result = open_file()
    // ERROR: the `File` arm discards a linear resource without consuming it
    match result {
        File => {},
        GuardError as e => {},
    }
}

// --- guard pattern else doesn't diverge (CF13) ---
func test_guard_no_diverge() {
    let opt: i32? = 42
    mut value = opt is Some else { 0 }   // ERROR: 0 doesn't diverge
    // else must use return, break, panic, etc.
}

// --- or-pattern binding mismatch ---
// ERROR: or-pattern branches bind different variables
enum Token { Number(i32), Ident(string), Plus, Minus }

func test_or_pattern_mismatch() {
    let t = Token.Plus
    match t {
        Number(n) | Ident(n) => println("{n}"),
        _ => {},
    }
}

// --- match expression missing else/wildcard ---
// ERROR: match expression requires exhaustive arms
func test_match_expr_missing_arm() -> string {
    let x = 5
    return match x {
        1 => "one",
        2 => "two",
        // missing wildcard — not exhaustive for i32
    }
}

// --- linear resource consumed on only one path ---
//
// Matching a `File or GuardError` and closing the file arm is fine: the two
// arms are disjoint, and only one of them holds a resource. The rejection is
// for a branch that consumes and a sibling that doesn't.
extend File {
    func close(take self) {}
}

func test_match_consume_is_fine() {
    let result = open_file()
    match result {
        File as file => file.close(),
        GuardError as e => {},
    }
}

func test_conditional_consume(cond: bool) {
    let f = File { fd: 1 }
    // ERROR: `f` isn't consumed when cond is false [E0805]
    if cond {
        f.close()
    }
}
