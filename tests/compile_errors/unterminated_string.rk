// Compile Error: a string literal that never closes
//
// Everything after the opening quote is the string's text, so the rest of the
// file is swallowed. The error points at the quote that opened it, not at the
// end of the file where the lexer ran out.

func main() {
    // ERROR: the quote opens a string that runs to the end of the file [E0002]
    let greeting = "hello
    println(greeting)
}
