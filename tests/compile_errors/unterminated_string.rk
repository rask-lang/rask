// Compile Error: string literals that never close
//
// A `"` string stays on its line, so the error points at the string that was
// left open. A plain string used to run on to the next quote in the file, and
// the error landed on a later string that was closed properly. (`x"…"` may
// span lines, like `"""`, so it isn't tested here.)

func main() {
    // ERROR: the line ends before the string does [E0002]
    let greeting = "hello
    println(greeting)
    println("done")
    // ERROR: raw string never closed [E0002]
    let path = r"C:\temp
    println(path)
}
