// Compile Error: `format` with a template held in a variable
//
// The placeholders are checked against the arguments at compile time, so the
// template has to be written at the call.

func main() {
    let t = "x {}"
    // ERROR: template must be a literal [E0338]
    println(format(t, 1))
}
