// Compile Error: `any Interface?`, which isn't built on the native backend
// Rejects: an optional interface object isn't built yet
//
// This has always been rejected, but by accident and with the wrong message.
// The parse after `any` was a copy of the type-name parse that stopped before
// the optional suffix, so `any Shape?` failed with `Expected ')', found '?'` —
// a message about punctuation for a feature that isn't there.
//
// #1159 needed that branch to share the real parse, so a qualified name after
// `any` would work. Sharing it whole would have let this spelling through to
// codegen, where handing a concrete value to an `any Interface?` never boxes it
// into the option's payload: the slot is read uninitialised and the program
// segfaults, in every position, while the interpreter answers correctly
// (#1308).
//
// So the suffix is still refused, deliberately, and says which of the two it
// is. When the backend has it, this file and the guard in `parse_type_name`
// go together.

interface Shape {
    func area(self) -> i64
}

struct Sq {
    s: i64
}

extend Sq implements Shape {
    func area(self) -> i64 {
        return self.s * self.s
    }
}

// ERROR: the optional layer is what isn't built, not the interface object.
func in_a_parameter(x: any Shape?) -> i64 {
    return 0
}

func main() {
    println("unreachable")
}
