// A `{…}` hole holding a constant is an error in every string (std.fmt/I4).
//
// `{0}` puts the number 0 in the string, which writing `0` already does, so
// nobody means it. It's a positional placeholder: `format`'s argument 0, or a
// positional variant's payload 0 in its `@message` (type.errors/ER36). Anywhere
// else it's an error. The `@message` misuses are in message_positional_hole.rk.

@message
enum LoadError {
    @message("nf {0}")
    NotFound(u64)
    @message("parse error at {line}")
    Parse(line: i32)
}

func main() {
    println("width {80}")              // ERROR: a constant in a hole
    println("{LoadError.NotFound(1)}")
}
