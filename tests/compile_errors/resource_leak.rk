// Forgetting to close a file (mem.linear/L1, L7).
//
// `File` is a `@resource`, so every opened file is closed exactly once and the
// compiler checks it. It used to be a plain struct in stdlib/io.rk, and every
// function below compiled. This file was "rejected" only because it was
// written in syntax that no longer parses, so it proved nothing.
//
// Each fix names the call that closes a `File`, `close()`. A placeholder like
// `<consuming method>()` was what it said before.

import fs

// ERROR: `file` would leak if this fails [E0881]
// ERROR: fix: add `ensure file.close()` on the line after it's acquired
func forgets_to_close(path: string) -> string or Error {
    let file = try fs.open(path)
    let text = try file.read_text()
    return text
}

// ERROR: `file` has no cleanup committed yet [E0882]
func closes_too_late(path: string) -> string or Error {
    let file = try fs.open(path)
    println("opened {path}")
    let text = file.read_text() catch _ => ""
    try file.close()
    return text
}

func closes_on_one_branch(path: string, flag: bool) -> void or Error {
    let file = try fs.open(path)
    // ERROR: consumption of `file` depends on which path ran [E0821]
    ensure file.close()
    if flag {
        try file.close()
    }
}

func closes_twice(path: string) -> void or Error {
    let file = try fs.open(path)
    try file.close()
    // ERROR: use of moved value: `file` [E0800]
    // ERROR: note: `File` is a resource: it's consumed exactly once, and it can't be copied or cloned
    try file.close()
}

// The fix: commit the close on the line after the open, then use the file freely.
func reads_and_closes(path: string) -> string or Error {
    let file = try fs.open(path)
    ensure file.close()
    return try file.read_text()
}

func main() -> void or Error {
    println(try reads_and_closes("/etc/hostname"))
}
