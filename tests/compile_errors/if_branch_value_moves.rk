// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A value an `if`, `if let` or `match` branch ends with is handed over to
// wherever the whole expression goes, exactly as `let r = fresh` hands it
// over (mem.ownership/O3, #1899).
//
// The branch's last expression wasn't counted as a move, so both names read
// one vector and native freed it twice.

func pick(flag: bool) -> usize {
    let fresh = Vec.from([1, 2, 3])
    let r = if flag { fresh } else { Vec.new() }
    // ERROR: `fresh` may have gone into `r` [E0813]
    return r.len() + fresh.len()
}

func pick_match(n: i64) -> usize {
    let a = Vec.from([1, 2])
    let b = Vec.from([3])
    let r = match n {
        0 => a
        _ => b
    }
    // ERROR: `a` may have gone into `r` [E0813]
    return r.len() + a.len()
}

func pick_if_let(maybe: i64?) -> usize {
    let fallback = Vec.from([9])
    let r = if maybe? as n {
        Vec.from([n])
    } else {
        fallback
    }
    // ERROR: `fallback` may have gone into `r` [E0813]
    return r.len() + fallback.len()
}

enum Val {
    Table(Vec<string>)
    Num(i64)
}

// A branch that ends in a part of a value on loan, a borrowed parameter or a
// loop's element hands out a second owner, the same as `let q = part` does.
func entries_of(v: Val) -> Vec<string> {
    let es = match v {
        // ERROR: `es` is part of `v`, which is borrowed [E0899]
        Val.Table(es) => es
        _ => Vec.new()
    }
    return es
}

func param_through_if(flag: bool, a: Vec<i64>) -> usize {
    // ERROR: `a` is the caller's [E0835]
    let r = if flag { a } else { Vec.new() }
    return r.len()
}

func item_through_if(lists: Vec<Vec<i64>>) -> usize {
    mut total = 0
    for item in lists {
        // ERROR: `item` is lent by `lists` [E0902]
        let r = if total > 0 { item } else { Vec.new() }
        total += r.len()
    }
    return total
}

// Fine: the match moves out of a value this function owns.
func fine_owned(take v: Val) -> usize {
    let es = match v {
        Val.Table(es) => es
        _ => Vec.new()
    }
    return es.len()
}

// Fine: each name is used only on the path that didn't hand it over.
func fine(flag: bool) -> usize {
    let fresh = Vec.from([1, 2, 3])
    let other = Vec.from([4])
    let r = if flag { fresh } else { other }
    return r.len()
}

// A plain block's value too: `let r = { fresh }` is `let r = fresh`.
func through_block() -> usize {
    let fresh = Vec.from([1, 2, 3])
    let r = {
        println("making r")
        fresh
    }
    // ERROR: `fresh` went into `r` [E0800]
    return r.len() + fresh.len()
}

// Fine: the block ends in its own `v`, not the one outside it.
func fine_shadowed() -> usize {
    let v = Vec.from([1])
    let r = {
        let v = Vec.from([2, 3])
        v
    }
    return r.len() + v.len()
}

// Fine: a Copy value is copied, and the source stays readable.
func fine_copy(flag: bool) -> i64 {
    let x = 5
    let r = if flag { x } else { 6 }
    return r + x
}

func main() {
    println("{pick(true)} {pick_match(0)} {pick_if_let(none)} {fine(true)} {fine_copy(true)}")
    println("{entries_of(Val.Num(1)).len()} {param_through_if(true, [1])} {item_through_if([[1]])} {fine_owned(Val.Num(2))}")
    println("{through_block()} {fine_shadowed()}")
}
