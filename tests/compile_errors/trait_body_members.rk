// Rejects: anything but a method signature in a trait body
//
// These all used to hang the parser (#1164). The body loop matched `func` and a
// bare identifier (the method shorthand) and had no third branch, so a token
// neither of those covered was never consumed and the loop condition never went
// false. `rask check` sat there until it was killed.
//
// `type` was one of them and no longer is — a trait body holds methods and
// associated types (TD4), and `type Out` is the feature, not a mistake.
// Everything else here still has no place in a trait.
//
// Parser-level only. Each error has to recover onto the method under it, so
// every trait here reports exactly once.

// ERROR: `const` in a trait body
trait Counter {
    const START = 3
    func next(self) -> i64
}

// ERROR: a nested `struct` in a trait body
trait Shaped {
    struct Nested { a: i64 }
    func area(self) -> f64
}

// ERROR: a bare modifier with no method under it — this is the case that needs
// ERROR: the forced advance, since synchronize_to_next_method reads `public` as
// ERROR: the start of a method and returns without moving
trait Visible {
    public
    func show(self) -> string
}

// ERROR: an attribute on a trait method — trait methods parse with no attrs
trait Quiet {
    @allow(dead_code)
    func hush(self) -> i64
}

// The shape that now works, and is checked in trait_assoc_types.rk:
//
//   trait Mul<Rhs> {
//       type Out
//       func mul(self, rhs: Rhs) -> Self.Out
//   }
