// ERROR: declared `extend T with Trait` but the type lacks the trait's method
// Expected: typecheck error E0333 at the extend — `Dog` does not implement `Greeter`

trait Greeter {
    func greet(self) -> string
}

struct Dog { name: string }

// Declares conformance but provides `bark`, not `greet`.
extend Dog with Greeter {
    func bark(self) -> string { return "woof" }
}

func main() {
    println("unused")
}
