// ERROR: a struct or enum name used as a constructor call (E0345)
// Only nominal types (`type Name = Underlying`) have `Name(value)` (T7).
// Structs are built field by field — there are no tuple structs (S1).

struct TaskId { public value: u64 }

enum Color { Red, Green }

func main() {
    let a = TaskId(1)     // ERROR: `TaskId` is a struct
    let c = Color(0)      // ERROR: `Color` is an enum
    println("{a.value} {c}")
}
