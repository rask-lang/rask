// Rejects: a struct built by position (E0416), and an enum called (E0345).
// Only nominal types (`type Name = Underlying`) take one value by position
// (T7); a struct names its fields, `TaskId(value: 1)` (S1).

struct TaskId { public value: u64 }

enum Color { Red, Green }

func main() {
    let a = TaskId(1)     // ERROR: `TaskId` names its fields
    let c = Color(0)      // ERROR: `Color` is an enum
    println("{a.value} {c}")
}
