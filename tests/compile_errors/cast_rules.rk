// Compile Error: `as` cast rules (type.primitives CV1–CV4, CH5, BL3) and the
// explicit conversion forms (CV5–CV10). `as` is lossless widening only; lossy
// conversions need their named form.

// --- CV2: narrowing int→int via `as` ---
// ERROR: cannot narrow `i32` to `i8` with `as` [E0817]
func narrow() {
    let big: i32 = 300
    let x: i8 = big as i8
}

// --- CV3: same-width sign reinterpretation via `as` ---
// ERROR: cannot reinterpret sign converting `i32` to `u32` with `as` [E0817]
func sign_reinterpret() {
    let n: i32 = -1
    let u: u32 = n as u32
}

// --- CV4: float→int via `as` ---
// ERROR: cannot convert float `f64` to integer `i32` with `as` [E0817]
func float_to_int() {
    let f: f64 = 3.14
    let i: i32 = f as i32
}

// --- CH5: int→char via `as` ---
// ERROR: cannot convert `u32` to `char` with `as` — use char.from_u32 [E0817]
func int_to_char() {
    let n: u32 = 65
    let c: char = n as char
}

// --- BL3: int→bool via `as` ---
// ERROR: no conversion between `bool` and numeric types with `as` [E0817]
func int_to_bool() {
    let one: i32 = 1
    let flag: bool = one as bool
}

// --- BL3: bool→int via `as` ---
// ERROR: no conversion between `bool` and numeric types with `as` [E0817]
func bool_to_int() {
    let b: bool = true
    let n: i32 = b as i32
}

// --- CV15: `floor` misused on an integer source ---
// ERROR: `floor` rounds a float to an integer, source is not a float [E0818]
func float_form_on_int() {
    let n: i32 = 5
    let x = n.floor<i32>()!
}

// --- CV12: `wrap` producing a non-integer ---
// ERROR: `wrap` produces an integer, target is not an integer [E0818]
func wrap_to_float() {
    let n: i32 = 5
    let x = n.wrap<f64>()
}

// --- CV14: `round` between integer types has nothing to round ---
// ERROR: `round` has nothing to round going from `i32` to `i8` [E0818]
func round_int_to_int() {
    let n: i32 = 5
    let x = n.round<i8>()!
}

// --- CV13: `clamp` on a float source ---
// ERROR: `clamp` works between integer types, source is a float [E0818]
func clamp_a_float() {
    let f: f64 = 1.5
    let x = f.clamp<i32>()
}

// --- `as` to a collection: a reinterpretation, not a conversion ---
// This used to be accepted with no check at all. The literal lowered to a
// stack array and the cast handed its address to `Vec_len`, so indexing the
// result segfaulted from ordinary safe code (#862).
// ERROR: `as Vec<i64>` reinterprets the bits — it doesn't convert [E0838]
func literal_as_vec() {
    let v = [1, 2, 3] as Vec<i64>
    println("{v[0]}")
}

// --- `as` to a struct: same reinterpretation, and `unsafe` is how you say so ---
// ERROR: `as Point` reinterprets the bits — it doesn't convert [E0838]
func pointer_as_struct() {
    let raw: i64 = 0
    let p = raw as Point
}

struct Point {
    x: i64
    y: i64
}
