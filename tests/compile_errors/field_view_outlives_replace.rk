// A field read is a view until its block ends, and writing over the field
// frees what it views (mem.borrowing/S1, S5, E0958, #1838).
//
// `let old = p.f` followed by `p.f = …` in the same block, with nothing in
// between that can leave early, is consume-and-replace: the read is a move,
// and the field is empty until the refill (E0959). Anywhere else the refill
// might not run, so the read stays a view. Native freed the buffer under it
// and printed garbage, or read the emptied slot.

struct Holder {
    log: Vec<string>
}

extend Holder {
    // Fine: the refill always runs, so `old` owns the old vector. A loop
    // whose own `break` is in between doesn't change that.
    func swap(mutate self, limit: i64) -> usize {
        let old = self.log
        mut count = 0
        while true {
            if count >= limit {
                break
            }
            count += 1
        }
        self.log = Vec.new()
        return old.len()
    }

    // ERROR: the early return skips the refill [E0958]
    func swap_or_stop(mutate self, stop: bool) -> usize {
        let old = self.log
        if stop {
            return 99
        }
        self.log = Vec.new()
        return old.len()
    }
}

struct Regs {
    log: Vec<string>
    regs: Vec<i64>
}

extend Regs {
    func set_reg(mutate self, v: i64) {
        self.regs = Vec.new()
        self.regs.push(v)
    }

    func reset(mutate self) {
        self.log = Vec.new()
    }

    func reset_twice_removed(mutate self) {
        self.reset()
    }
}

// Fine: `set_reg` replaces `regs`, never `log`, which is what a VM loop
// holding `let code = self.code` across `self.set_reg(…)` relies on.
func set_under_view(mutate r: Regs) -> usize {
    let code = r.log
    r.set_reg(1)
    return code.len()
}

// ERROR: `reset` replaces `log`, here through a second method [E0958]
func reset_under_view(mutate r: Regs) -> usize {
    let code = r.log
    r.reset_twice_removed()
    return code.len()
}

struct Cfg {
    list: Vec<string>
}

extend Cfg {
    func wipe(mutate self) {
        self.list = Vec.new()
    }
}

struct Outer {
    cfg: Cfg
}

// ERROR: a struct field's view is a copy of it, and `wipe` replaces what
// that copy holds [E0958]
func wipe_under_view(mutate p: Outer) -> usize {
    let old = p.cfg
    p.cfg.wipe()
    return old.list.len()
}

// Fine: growing the vector a view reads frees nothing.
func grow(mutate h: Holder) -> usize {
    let f = h.log
    h.log.push("more")
    return f.len()
}

// ERROR: an inner `let` reusing the view's name doesn't hide it from the
// write [E0958]
func shadowed(mutate h: Holder) -> usize {
    let old = h.log
    if h.log.len() > 0 {
        let old = 5
        h.log = Vec.new()
        println("{old}")
    }
    return old.len()
}

// ERROR: a closure called between the move and the refill could read the
// empty field, so the read stays a view [E0958]
func closure_between(mutate h: Holder) -> usize {
    let n = || h.log.len()
    let old = h.log
    println("{n()}")
    h.log = Vec.new()
    return old.len()
}

// Fine: a new `h` in an inner block is a different value.
func inner_rebind(h: Holder) -> usize {
    let old = h.log
    mut total = 0
    for i in 0..2 {
        mut h = Holder(log: Vec.new())
        h.log = Vec.new()
        total += h.log.len()
    }
    return total + old.len()
}

func reset_log(mutate h: Holder) {
    h.log = Vec.new()
}

func main() {
    mut h = Holder(log: Vec.new())
    h.log.push("entry-long-enough-to-heap")

    // ERROR: the refill runs on one path only [E0958]
    let c = h.log.len() > 0
    let a = h.log
    if c {
        h.log = Vec.new()
    }

    // ERROR: a write later in a loop frees what the next turn reads [E0958]
    let b = h.log
    mut i = 0
    while i < 2 {
        println("{b.len()}")
        h.log = Vec.new()
        i += 1
    }

    // ERROR: a call given `h` to write through can replace the field under
    // a view [E0958]
    let d = h.log
    reset_log(mutate h)

    // ERROR: between the move and the refill the field is empty [E0959]
    let g = h.log
    println("{h.log.len()}")
    h.log = Vec.new()

    println("{a.len()} {d.len()} {grow(mutate h)} {g.len()} {h.swap(1)} {h.swap_or_stop(true)}")
}
