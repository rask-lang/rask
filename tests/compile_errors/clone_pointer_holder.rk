// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A struct holding a raw pointer has no derived `clone` (type.generics/CL2):
// whether the pointer owns what it points at is the author's to say, and a
// derived clone of an owning pointer is two owners of one block.
//
// `.clone()` used to answer on every type, so the call compiled while a
// `T: Cloneable` bound on the same struct was refused.

struct Buf {
    data: *i32
    len: i64
    cap: i64
}

struct Owned {
    data: *i32
    len: i64
    cap: i64
}

Owned implements Cloneable {
    func clone(self) -> Owned {
        return Owned(data: self.data, len: self.len, cap: self.cap)
    }
}

func main() {
    mut xs: Vec<i32> = [7]
    let p = unsafe xs.as_ptr()
    let b = Buf(data: p, len: 1, cap: 1)
    let b2 = b.clone()           // ERROR: E0933
    println(b2.len)
    let o = Owned(data: p, len: 1, cap: 1)
    let o2 = o.clone()           // fine: written by hand
    println(o2.len)
}
