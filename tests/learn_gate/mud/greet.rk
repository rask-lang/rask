// The learn gate's own tutorial: one function, one exercise.

// exercise 01: Greet `name` as "Hello, <name>!".
public func greet(name: string) -> string {
    return "Hello, {name}!"
}

test "greets by name" {
    assert greet("ada") == "Hello, ada!"
}
