// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A float method answers at the receiver's own width, and a big float spells
// out the digits that round-trip (#844, #845).
//
// There's one `sqrt` in libm and one dispatch entry per float method, so an
// `f32` receiver went to the `f64` symbol: the argument was promoted on the way
// in and the answer came back at double width and stayed there.
//
//     let x: f32 = 2.0
//     x.sqrt()      // 1.4142135623730951 on native, 1.4142135 on the interpreter
//
// The other half is formatting. Both backends found the shortest digit string
// that reads back as the same value, then re-rendered it with a decimal count —
// which goes negative for a large magnitude, and clamping it to zero prints the
// double's *exact* value:
//
//     let a: f64 = 1.0e300
//     "{a}"         // 1 followed by 300 digits of binary residue, not 300 zeros
//
// Both now spell out the digits the round-trip check already chose.

test "type.primitives — an f32 method answers in f32" {
    let x: f32 = 2.0
    assert_eq("{x.sqrt()}", "1.4142135")
    assert_eq("{x.ln()}", "0.6931472")
    assert_eq("{x.exp()}", "7.389056")

    let y: f32 = 2.5
    assert_eq("{y.sqrt()}", "1.5811388")

    // f64 is unchanged — it was never the one going through a wider type.
    let d: f64 = 2.0
    assert_eq("{d.sqrt()}", "1.4142135623730951")
}

test "type.primitives — f32 rounding and classification still work" {
    let x: f32 = 0 - 2.7
    assert_eq("{x.abs()}", "2.7")
    assert_eq("{x.floor()}", "-3")
    assert_eq("{x.ceil()}", "-2")
    assert_eq("{x.round()}", "-3")
    assert_eq("{x.trunc()}", "-2")

    let y: f32 = 2.0
    assert(!y.is_nan())
    assert(y.is_finite())
    assert_eq(y.to_int(), 2)
}

test "type.primitives — a large float prints the digits that round-trip" {
    let a: f64 = 1.0e20
    assert_eq("{a}", "100000000000000000000")

    let b: f64 = 123456789012345678901.0
    assert_eq("{b}", "123456789012345680000")

    let c: f32 = 1.0e20
    assert_eq("{c}", "100000000000000000000")
}

test "type.primitives — small and ordinary floats are unchanged" {
    let a: f64 = 1.0 / 3.0
    assert_eq("{a}", "0.3333333333333333")

    let b: f64 = 1.0e-7
    assert_eq("{b}", "0.0000001")

    let c: f64 = 1234567.75
    assert_eq("{c}", "1234567.75")

    let d: f64 = 0.0
    assert_eq("{d}", "0")

    let e: f32 = 0.1
    assert_eq("{e}", "0.1")
}

func main() {}
