// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `Random.shuffle` and `Random.choice`, natively (#857).
//
// Both reached codegen as "Function not found: Random_shuffle" / "_choice"
// while the interpreter ran them. Everything else on `Random` — the draws, the
// range, the seeding — already agreed.
//
// A seeded generator has to produce the same sequence on both backends, so
// these assert exact values rather than properties: same seed, same
// permutation, same pick. The walk is Fisher-Yates from the last index down,
// drawing `next_u64() % (i + 1)`, which is what the interpreter does.

import random
import random.Random

test "std.random — the same seed gives the same sequence" {
    mut a = Random.from_seed(11)
    mut b = Random.from_seed(11)
    assert a.i64() == b.i64()
    assert a.i64() == b.i64()

    mut c = Random.from_seed(12)
    mut d = Random.from_seed(11)
    assert(!(c.i64() == d.i64()))
}

test "std.random — shuffle permutes, and identically for a given seed" {
    mut r = Random.from_seed(4)
    mut v: Vec<i64> = [1, 2, 3, 4, 5]
    r.shuffle(v)
    assert v.join(",") == "2,5,3,1,4"

    // Nothing is lost or duplicated.
    mut total = 0
    for x in v {
        total = total + x
    }
    assert total == 15
    assert v.len() == 5
}

test "std.random — shuffling one element or none is a no-op" {
    mut r = Random.from_seed(1)
    mut one: Vec<i64> = [7]
    r.shuffle(one)
    assert one.join(",") == "7"

    mut empty: Vec<i64> = []
    r.shuffle(empty)
    assert empty.len() == 0
}

test "std.random — shuffle works on a wide element type" {
    mut r = Random.from_seed(4)
    mut v: Vec<string> = ["a", "b", "c", "d", "e"]
    r.shuffle(v)
    assert v.join(",") == "b,e,c,a,d"
    assert v.len() == 5
}

test "std.random — choice picks an element" {
    mut r = Random.from_seed(4)
    let v: Vec<i64> = [1, 2, 3]
    assert r.choice(v) ?? 0 - 1 == 1

    mut r2 = Random.from_seed(4)
    let s: Vec<string> = ["x", "y", "z"]
    assert r2.choice(s) ?? "-" == "x"
}

test "std.random — choice on an empty Vec is none" {
    mut r = Random.from_seed(4)
    let v: Vec<i64> = []
    assert(r.choice(v) is none)
}

func main() {}
