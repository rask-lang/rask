// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A program's own function may share a name with a stdlib I/O function. Effect
// inference matched callees by bare name, so calling this `exists` from a
// `comptime func` was rejected as "reaches I/O at compile time". A bare name
// is only `fs.exists` when the file imported it that way.

func exists(n: i64) -> bool {
    return n > 3
}

comptime func pick(n: i64) -> i64 {
    if exists(n) {
        return 1
    }
    return 0
}

const BIG: i64 = comptime pick(5)
const SMALL: i64 = comptime pick(2)

func main() {
    println("{BIG} {SMALL}")
}

test "a user function named exists is not file I/O" {
    assert BIG == 1
    assert SMALL == 0
}
