// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Reading a nominal type out of method use — #904's remaining half. Unbuilt.
//
// The operator half is done and lives in `t_week_gradual_generics.rk`:
// `func double(x) { x * 2 }` comes out as `<T: Numeric>(x: T) -> T` and takes
// an int and a float from the same program, which is the first row of
// `gradual-constraints.md`'s table.
//
// This is the fourth row, and it needs something different:
//
//   func count(items) { return items.len() }
//   count(ints)                          // fixes items at Vec<i32>
//   count(strs)                          // error: expected i32, found string
//
// The table's answer is `<T>(items: Vec<T>) -> usize` — the parameter isn't the
// generic, its *element* is. Getting there means going from "something with a
// `.len()`" to `Vec<T>` and then generalizing the argument, which is
// structural-to-nominal inference (GC3) the checker doesn't do at all. The
// operator half could be written down as a signature because an operator names
// its trait; `.len()` names nothing — `Vec`, `Map`, `string` and `Set` all have
// one, and picking `Vec` from the method alone would be a guess.
//
// Until then a method call on an inferred parameter keeps IN2's answer: one
// concrete type for the whole program, whichever call site arrives first.

func count(items) {
    return items.len()
}

// GC3/IN1: `.len()` says nothing about the element, so the element generalizes
// and both calls are fine.
test "type.gradual-constraints — a method that doesn't constrain T stays generic" {
    let ints: Vec<i32> = [1, 2, 3]
    assert count(ints) == 3
    let strs: Vec<string> = ["a", "b"]
    assert count(strs) == 2
}

func main() {}
