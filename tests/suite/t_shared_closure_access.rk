// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// `s.read(|v| … )` and its three siblings (#1155, #1311).
//
// Two separate faults, and the first was hiding the second.
//
// **The binding was left open.** The resolver arm invented a fresh variable for
// the result and unified the return with *that*, which relates the call to
// nothing:
//
//     let doubled = s.read(|v| { return v * 2 })
//     error[E0361]: couldn't work out the type of `doubled`
//
// while the same line with `: i64` written on it was accepted — which reads
// like an inference hiccup rather than a missing constraint. The closure's own
// `Type::Fn` has both answers: its parameter is the box's `T`, so `|v| v * 2`
// knows `v` is an `i64` instead of guessing from use, and its return is the
// call's `R`. `try_read`/`try_write` wrap that in an optional; otherwise the
// four arms are the same, so they share one.
//
// **And the accepted spelling was wrong anyway.** Of the three strategies only
// `Readers` ran the closure. `Local` ignored its argument and handed the value
// straight back — 5 where `Readers` said 10 — and `Mutex` had no closure arm at
// all, reporting "no method `read` on type `Mutex`". Both answer now, `write`
// included: it runs the closure under the lock and keeps what it returns.
//
// Native still hands back garbage for all three (#1311) — a number that changes
// between runs, from a slot nobody wrote. The cause is written down in the
// `with` lowering, which was moved off this same closure-passing path for
// exactly that reason. Registered in `tests/known_divergences.txt` until it
// lands; the interpreter is the reference here and is now uniformly right.
//
// Nothing in the suite, stdlib, examples or projects called the closure form
// before this file, which is how both faults kept.

import sync.Shared

test "the binding types itself from the closure's return" {
    let s = Shared<i64>.local(5)
    let doubled = s.read(|v| { return v * 2 })
    assert doubled == 10
}

test "and the closure's parameter from the box" {
    let s = Shared<i64>.local(21)
    // `v` is an `i64` because the box says so, not because of how it's used.
    let same = s.read(|v| { return v })
    assert same == 21
}

test "every strategy runs the closure" {
    let local = Shared<i64>.local(5)
    let readers = Shared<i64>.new(5)
    let mutexed = Shared<i64>.mutex(5)
    assert local.read(|v| { return v * 2 }) == 10
    assert readers.read(|v| { return v * 2 }) == 10
    assert mutexed.read(|v| { return v * 2 }) == 10
}

test "write keeps what the closure returned" {
    mut a = Shared<i64>.local(5)
    let r = a.write(|v| { return v * 2 })
    assert r == 10
    assert a.read() == 10

    mut b = Shared<i64>.mutex(5)
    assert b.write(|v| { return v * 3 }) == 15
    assert b.read() == 15
}

test "the inline form still answers the value" {
    let s = Shared<i64>.local(7)
    assert s.read() == 7
}
