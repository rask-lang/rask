// `[x; n]` with a constant `n` used to become one store per element, so
// `[0u8; 1000000000]` was a billion statements and the compiler ran out of
// memory (#2055). Past a handful of elements it fills in a loop now. The
// string case checks the loop takes a reference per slot and the array
// releases them all: nothing marked the looped-into array as a value of its
// own at first, and its strings were never released.

test "a long array of numbers is filled in every slot" {
    let z = [7i64; 100000]
    mut sum = 0i64
    for x in z {
        sum = sum + x
    }
    assert z.len() == 100000
    assert sum == 700000
    assert z[99999] == 7
}

test "a long array of strings holds the same string in every slot" {
    let n = 40
    let names = ["a-string-long-enough-to-live-on-the-heap-{n}"; 40]
    assert names.len() == 40
    assert names[0] == "a-string-long-enough-to-live-on-the-heap-40"
    assert names[39] == names[0]
}

test "a short array is filled the same way" {
    let names = ["a-string-long-enough-to-live-on-the-heap"; 4]
    assert names[3] == "a-string-long-enough-to-live-on-the-heap"
}
