// PENDING std.bits — integer bit methods (count_ones/count_zeros/leading_zeros/
// trailing_zeros/rotate_left/rotate_right) are unregistered on BOTH backends
// (bits.rk documents them as "registered in builtins" but nothing wires them;
// #397). Expected RED until built; drives implementation. Do NOT assert current
// (wrong) behavior.

func main() {}

test "std.bits/count_ones popcount" {
    assert (7).count_ones() == 3
    assert (0).count_ones() == 0
    assert (255).count_ones() == 8
}

test "std.bits/trailing_zeros and leading_zeros" {
    assert (8).trailing_zeros() == 3
    assert (1).trailing_zeros() == 0
}

test "std.bits/count_zeros over the width" {
    // 32-bit value 0 has 32 zero bits.
    const z: i32 = 0
    assert z.count_zeros() == 32
}
