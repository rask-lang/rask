// std.bits B1 — bit inspection and permutation on integer types.
// Implemented in #397: the checker resolves them on any integer, the
// interpreter counts over the declared width, and native lowers each to a
// single machine instruction.
//
// The width cases matter most: a count has to answer over the receiver's own
// type, not over the 64-bit register the value sits in.

func main() {}

test "std.bits/count_ones popcount" {
    assert (7).count_ones() == 3
    assert (0).count_ones() == 0
    assert (255).count_ones() == 8
}

test "std.bits/trailing_zeros and leading_zeros" {
    assert (8).trailing_zeros() == 3
    assert (1).trailing_zeros() == 0
}

test "std.bits/count_zeros over the width" {
    // 32-bit value 0 has 32 zero bits.
    let z: i32 = 0
    assert z.count_zeros() == 32
}

test "std.bits/counts answer over the receiver's width" {
    let a: u8 = 0
    assert a.count_zeros() == 8
    assert a.leading_zeros() == 8

    let b: u16 = 0
    assert b.count_zeros() == 16
    assert b.leading_zeros() == 16

    let c: u32 = 1
    assert c.leading_zeros() == 31
    assert c.trailing_zeros() == 0

    let d: u64 = 1
    assert d.leading_zeros() == 63
}

test "std.bits/leading and trailing ones" {
    let a: u8 = 255
    assert a.leading_ones() == 8
    assert a.trailing_ones() == 8

    let b: u8 = 7
    assert b.trailing_ones() == 3
    assert b.leading_ones() == 0
}

test "std.bits/rotate wraps instead of dropping bits" {
    let x: u8 = 1
    assert x.rotate_left(1) == 2
    // The high bit wraps back to the low end rather than falling off.
    let high: u8 = 128
    assert high.rotate_left(1) == 1
    assert high.rotate_right(7) == 1

    // A full turn is the identity.
    let y: u32 = 305419896
    assert y.rotate_left(32) == y
    assert y.rotate_right(32) == y
}

test "std.bits/reverse_bits and swap_bytes stay in width" {
    let a: u8 = 1
    assert a.reverse_bits() == 128

    let b: u16 = 258
    assert b.swap_bytes() == 513

    let c: u32 = 1
    assert c.swap_bytes() == 16777216
}

test "std.bits/round trips" {
    let x: u16 = 4660
    assert x.swap_bytes().swap_bytes() == x
    assert x.reverse_bits().reverse_bits() == x
}

test "std.bits/byte order round-trips" {
    let a: u16 = 258
    assert a.to_be() == 513
    assert a.to_le() == 258
    assert a.to_be().to_be() == a

    let b: u32 = 1
    assert b.to_be() == 16777216
    assert b.to_le() == 1
}
