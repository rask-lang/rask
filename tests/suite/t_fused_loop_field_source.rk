// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A fused loop reading a struct field gives the field's container back.
//
// It didn't, when the loop had two ways out:
//
//     let r = Row { xs: [1, 2, 3] }
//     let pairs: Vec<(i64, i64)> = r.xs.zip(other)
//     // rask: 2 allocations never released
//
// `zip` fuses into a loop that reads the receiver's handle straight off the
// struct — `_34 = _27.0` — and that read is the last thing in the function
// that touches `r`. A bare handle is never the name a release walks, so the
// release has to go on the edge where the group dies instead, which is the
// loop's exit block.
//
// `aggregate_edge_releases` is that mechanism and it declined. It asked for the
// target to have exactly one predecessor, which is the easy case of the rule it
// wanted: a release at the top of a block must not run on a path that never
// built the group or still needs it. A fused `zip` exit has two predecessors —
// one for the receiver running out, one for the other side — so neither edge
// qualified and nobody freed the vector. The condition is "every predecessor
// has it live on the way in" now, which covers both.
//
// The tell was that any later read of the struct made it clean: that gives the
// group a use in a block where it dies, so the ordinary placement finds it and
// the edge case never comes up. Which is also why this went unnoticed —
// a chain is usually not the last thing a function does with its source.
//
// Spec: std.collections — a struct owns the containers in its fields.

struct Row {
    xs: Vec<i64>
    ys: Vec<i64>
}

struct One {
    only: Vec<i64>
}

// The shape that leaked: the zip is the struct's last use.
test "std.collections — a zip on a field, and nothing after it" {
    let r = One { only: [1, 2, 3] }
    let other: Vec<i64> = [9, 9]
    let pairs: Vec<(i64, i64)> = r.only.zip(other)
    assert pairs.len() == 2
    assert pairs[0].0 == 1
    assert pairs[1].1 == 9
}

// Both sides out of fields, so two field reads have to be accounted for.
test "std.collections — both sides of a zip are fields" {
    let r = Row { xs: [1, 2, 3], ys: [7, 8] }
    let pairs: Vec<(i64, i64)> = r.xs.zip(r.ys)
    assert pairs.len() == 2
    assert pairs[0].1 == 7
    assert pairs[1].0 == 2
}

// The field is the *argument*, not the receiver.
test "std.collections — a field on the far side of a zip" {
    let r = Row { xs: [1, 2, 3], ys: [7, 8] }
    let mine: Vec<i64> = [4, 5, 6]
    let pairs: Vec<(i64, i64)> = mine.zip(r.ys)
    assert pairs.len() == 2
    assert pairs[0].0 == 4
    assert pairs[1].1 == 8
}

// An adapter before the zip, which is how this was found.
test "std.collections — a filter on a field, then a zip" {
    let r = Row { xs: [1, 2, 3], ys: [7, 8] }
    let pairs: Vec<(i64, i64)> = r.xs.filter(|x| x != 2).to_vec().zip(r.ys)
    assert pairs.len() == 2
    assert pairs[0].0 == 1
    assert pairs[1].0 == 3
}

// A struct field the chain never touches still has to be freed, and the one it
// does touch has to survive being read afterwards — the release goes on the
// exit edge, so a later read would be a use-after-free if it went too early.
test "std.collections — an untouched field, and a read after the chain" {
    let r = Row { xs: [1, 2, 3], ys: [7, 8] }
    let other: Vec<i64> = [9, 9]
    let pairs: Vec<(i64, i64)> = r.xs.zip(other)
    assert pairs.len() == 2
    assert r.ys.len() == 2
    assert r.xs.len() == 3
    assert r.xs[2] == 3
}

// In a loop, so a group released on the exit edge of an inner fused loop
// doesn't take the outer turn's vector with it.
test "std.collections — a fused loop per turn" {
    mut total: usize = 0
    for i in 1..4 {
        let r = One { only: [i, i * 2, i * 3] }
        let other: Vec<i64> = [1, 1]
        let pairs: Vec<(i64, i64)> = r.only.zip(other)
        total = total + pairs.len()
    }
    assert total == 6
}

// Strings in the elements, so the release walks something the free has to
// decrement rather than just a byte store.
test "std.collections — string elements through a field" {
    let n = 2
    let names: Vec<string> = ["name {n}, long enough to allocate", "another, also long enough"]
    let r = Row { xs: [1, 2], ys: [7, 8] }
    let pairs: Vec<(i64, string)> = r.xs.zip(names)
    assert pairs.len() == 2
    assert pairs[0].1 == "name 2, long enough to allocate"
    assert pairs[1].0 == 2
}

func main() {}
