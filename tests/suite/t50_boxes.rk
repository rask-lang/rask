// mem.boxes / conc.sync witnesses.
//
// This was a known-fail for #268 — Cell unlinked in codegen ("Function not found:
// Cell_new") and Mutex `with .write()` reading pointer garbage on native. Box
// codegen has landed: both tests pass on both backends and the
// known_divergences.txt line is gone. The note saying otherwise was left behind,
// and is corrected here rather than left to mislead the next reader.
//
// Shared `with` access works now too — `t_month_boxes.rk` covers read/write
// alongside the rest of the family.

import sync.Shared
import sync.Mutex

func main() {}

test "conc.sync — Shared get + set via interior mutability" {
    mut c = Shared.local(0)
    assert c.get() == 0
    c.set(42)
    assert c.get() == 42
    c.set(c.get() + 1)
    assert c.get() == 43
}

test "conc.sync — the Mutex strategy's write() mutates the guarded value" {
    mut m = Shared.mutex(0)
    with m.write() as v { v += 5 }
    with m.write() as v { v += 3 }
    with m.write() as v { assert v == 8 }
}
