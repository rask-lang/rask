// mem.boxes / mem.cell / conc.sync witnesses.
//
// This was a known-fail for #268 — Cell unlinked in codegen ("Function not found:
// Cell_new") and Mutex `with .lock()` reading pointer garbage on native. Box
// codegen has landed: both tests pass on both backends and the
// known_divergences.txt line is gone. The note saying otherwise was left behind,
// and is corrected here rather than left to mislead the next reader.
//
// Shared `with` access works now too — `t_month_boxes.rk` covers read/write
// alongside the rest of the family.

import memory.Cell
import sync.Mutex

func main() {}

test "mem.cell/Cell get + set via interior mutability" {
    mut c = Cell.new(0)
    assert c.get() == 0
    c.set(42)
    assert c.get() == 42
    c.set(c.get() + 1)
    assert c.get() == 43
}

test "conc.sync/Mutex with .lock() mutates the guarded value" {
    mut m = Mutex.new(0)
    with m.lock() as v { v += 5 }
    with m.lock() as v { v += 3 }
    with m.lock() as v { assert v == 8 }
}
