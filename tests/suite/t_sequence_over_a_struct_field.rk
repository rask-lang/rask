// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A struct handed to a closure the frame also drops is still the frame's.
//
// `h.walk()` returns a closure that captures `h`, and the aggregate release
// pass treated any capture as handing the struct away — so nothing released
// its `Vec` field and every sequence built over a struct field leaked the
// container behind it. `t40_forwarded_generic_method.rk` leaked one vector per
// `Holder` it made, fourteen allocations.
//
// The frame drops the closure, so the frame outlives it. The closure counts as
// a name that *reaches* the struct instead — the same way a handle read out of
// one does: it holds the group alive for placement and is never the name
// released, so the release lands after the `closure_drop` rather than at the
// capture.
//
// Only a closure the frame drops. One it doesn't own can outlive the frame,
// and releasing then is a use-after-free rather than a leak — which is why the
// escaping cases below have their own tests: the answers, not the counts, are
// what catch a release placed too early.
import sequence.Sequence

struct Holder {
    public items: Vec<i64>
}

extend Holder {
    public func walk(self) -> Sequence<i64> {
        return |yield| {
            mut i = 0
            while i < self.items.len() {
                if !yield(self.items[i]) {
                    return
                }
                i = i + 1
            }
        }
    }

    public func doubled(self) -> Sequence<i64> {
        return self.walk().map(|x| x * 2)
    }
}

// A generic one, which is the shape `t40` uses.
struct Bag<T> {
    public items: Vec<T>
}

extend Bag<T> {
    public func walk(self) -> Sequence<T> {
        return |yield| {
            mut i = 0
            while i < self.items.len() {
                if !yield(self.items[i]) {
                    return
                }
                i = i + 1
            }
        }
    }
}

// Two containers and a string beside them, so the release walks a whole
// aggregate rather than one field.
struct Ledger {
    public name: string
    public amounts: Vec<i64>
    public tags: Vec<string>
}

extend Ledger {
    public func walk(self) -> Sequence<i64> {
        return |yield| {
            mut i = 0
            while i < self.amounts.len() {
                if !yield(self.amounts[i]) {
                    return
                }
                i = i + 1
            }
        }
    }
}

test "type.sequence — a sequence over a struct's container field" {
    let h = Holder { items: [1, 2, 3] }
    assert h.walk().count() == 3
}

test "type.sequence — and the values, so nothing was freed early" {
    let h = Holder { items: [1, 2, 3] }
    let out: Vec<i64> = h.walk().to_vec()
    assert out.len() == 3
    assert out[0] == 1
    assert out[2] == 3
    // The field is still readable after the chain is done with it.
    assert h.items.len() == 3
    assert h.items[1] == 2
}

test "type.sequence — an adapter on top of it" {
    let h = Holder { items: [1, 2, 3] }
    let out: Vec<i64> = h.doubled().to_vec()
    assert out[0] == 2
    assert out[2] == 6
}

test "type.sequence — a generic holder" {
    let a = Bag<i64> { items: [1, 2] }
    assert a.walk().count() == 2
    let b = Bag<string> { items: ["x", "y", "z"] }
    assert b.walk().count() == 3
}

// A string field beside the containers: it is refcounted, so a release run
// twice would leave the header pointing at freed bytes and the comparison
// would fail rather than the count being wrong.
test "type.sequence — a struct with a string and two vectors" {
    let l = Ledger {
        name: "the ledger's name, long enough to allocate",
        amounts: [10, 20, 30],
        tags: ["one tag long enough to allocate", "and a second one, also long"],
    }
    assert l.walk().count() == 3
    assert l.name == "the ledger's name, long enough to allocate"
    assert l.tags[1] == "and a second one, also long"
    assert l.amounts[2] == 30
}

// Two chains over one struct, so the one-free-per-value rule is exercised on
// an aggregate as well as on a bare container.
test "type.sequence — two chains over one struct" {
    let h = Holder { items: [1, 2, 3] }
    let a: Vec<i64> = h.walk().to_vec()
    let b: Vec<i64> = h.doubled().to_vec()
    assert a.len() == 3
    assert b.len() == 3
    assert a[2] == 3
    assert b[2] == 6
    assert h.items.len() == 3
}

// In a loop, so a struct freed twice lands on one the next turn has reused.
test "type.sequence — a struct per turn" {
    mut total: usize = 0
    for i in 1..5 {
        let h = Holder { items: [i, i * 2] }
        total = total + h.walk().count() + h.doubled().count()
    }
    assert total == 16
}
