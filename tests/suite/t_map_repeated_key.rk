// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// Inserting a key that was already in the map copied the new key's bytes over
// the stored one and released neither. Two equal strings are still two heap
// buffers, so every repeated string key leaked one (#1432). A map literal, a
// fused `.to_map()` and a comptime map also dropped the value a repeated key
// displaced, since nothing took it. Run under RASK_LEAK_CHECK=1.

func key(x: i64) -> string {
    return "key {x} long enough to live on the heap"
}

test "insert over an existing string key" {
    mut m: Map<string, i64> = Map.new()
    m.insert(key(1), 1)
    m.insert(key(1), 2)
    let old = m.insert(key(1), 3)
    assert m.len() == 1
    assert (old ?? -1) == 2
    assert m[key(1)] == 3
}

test "index assignment over an existing string key" {
    mut m: Map<string, string> = Map.new()
    m[key(1)] = key(10)
    m[key(1)] = key(11)
    assert m.len() == 1
    assert m[key(1)] == key(11)
}

test "the stored key outlives the one that matched it" {
    mut m: Map<string, i64> = Map.new()
    m.insert(key(1), 1)
    let again = key(1)
    m.insert(again, 2)
    for (k, v) in m {
        assert k == key(1)
        assert v == 2
    }
}

test "a map literal with a repeated key" {
    let m: Map<string, string> = Map.from([(key(2), key(20)), (key(2), key(21))])
    assert m.len() == 1
    assert m[key(2)] == key(21)
}

test "a fused to_map with a repeated key" {
    let words: Vec<string> = [key(3), key(3), key(4)]
    let m = words.map(|w| (w, "{w} value")).to_map()
    assert m.len() == 2
    assert m[key(3)] == "{key(3)} value"
}
