// SPDX-License-Identifier: (MIT OR Apache-2.0)
// std.bits parsing and building: every `read_*` on a `BinaryReader` against
// bytes laid out by hand and by `BinaryBuilder`, and what a short buffer
// answers.
//
// The reader owns the buffer and keeps its own position. Reads used to hand
// back the rest of the buffer as a new Vec, so reading a buffer value by value
// copied it once per value (O(n²)). The million-read timing test is
// bits_reader_million.rk in rask-cli's fixtures: it runs natively only, the
// interpreter takes half a minute over it.

import bits

func reads_off_the_front() -> bool or bits.BinaryParseError {
    let data: Vec<u8> = [0xCA, 0xFE, 0xBA, 0xBE, 0x01, 0x00, 0x2A, 0xFF]
    mut r = bits.BinaryReader.new(data)
    assert r.remaining() == 8
    let v1 = try r.read_u32be()
    assert v1 == 0xCAFEBABE
    assert r.pos() == 4
    let v2 = try r.read_u8()
    assert v2 == 1
    let v3 = try r.read_u16le()
    assert v3 == 0x2A00
    let v4 = try r.read_i8()
    assert v4 == -1
    assert r.pos() == 8
    assert r.remaining() == 0

    // The buffer comes back whole, read part included.
    let back = r.into_inner()
    assert back.len() == 8
    mut le = bits.BinaryReader.new(back)
    let v5 = try le.read_u32le()
    assert v5 == 0xBEBAFECA
    let v6 = try le.read_u16be()
    assert v6 == 0x0100
    return true
}

test "reads off the front, big and little endian" {
    let ok = reads_off_the_front() catch e => {
        println(e.message())
        assert false
        return
    }
    assert ok
}

func round_trip() -> bool or bits.BinaryParseError {
    let data = bits.BinaryBuilder.with_capacity(64)
        .write_u8(200)
        .write_i8(-100)
        .write_u16be(0xBEEF)
        .write_u16le(0xBEEF)
        .write_i16be(-12345)
        .write_i16le(-12345)
        .write_u32be(0xDEADBEEF)
        .write_u32le(0xDEADBEEF)
        .write_i32be(-123456789)
        .write_i32le(-123456789)
        .write_u64be(0x0123456789ABCDEF)
        .write_u64le(0x0123456789ABCDEF)
        .write_i64be(-1234567890123)
        .write_i64le(-1234567890123)
        .write_f32be(1.5)
        .write_f32le(-2.25)
        .write_f64be(3.141592653589793)
        .write_f64le(-0.5)
        .write_bytes([7, 8, 9])
    assert data.len() == 85

    mut r = bits.BinaryReader.new(data.build())
    let v7 = try r.read_u8()
    assert v7 == 200
    let v8 = try r.read_i8()
    assert v8 == -100
    let v9 = try r.read_u16be()
    assert v9 == 0xBEEF
    let v10 = try r.read_u16le()
    assert v10 == 0xBEEF
    let v11 = try r.read_i16be()
    assert v11 == -12345
    let v12 = try r.read_i16le()
    assert v12 == -12345
    let v13 = try r.read_u32be()
    assert v13 == 0xDEADBEEF
    let v14 = try r.read_u32le()
    assert v14 == 0xDEADBEEF
    let v15 = try r.read_i32be()
    assert v15 == -123456789
    let v16 = try r.read_i32le()
    assert v16 == -123456789
    let v17 = try r.read_u64be()
    assert v17 == 0x0123456789ABCDEF
    let v18 = try r.read_u64le()
    assert v18 == 0x0123456789ABCDEF
    let v19 = try r.read_i64be()
    assert v19 == -1234567890123
    let v20 = try r.read_i64le()
    assert v20 == -1234567890123
    let v21 = try r.read_f32be()
    assert v21 == 1.5
    let v22 = try r.read_f32le()
    assert v22 == -2.25
    let v23 = try r.read_f64be()
    assert v23 == 3.141592653589793
    let v24 = try r.read_f64le()
    assert v24 == -0.5
    let tail = try r.read_bytes(3)
    assert tail.len() == 3
    assert tail[0] == 7
    assert tail[2] == 9
    assert r.pos() == 85
    assert r.remaining() == 0
    return true
}

test "every read round-trips through the builder" {
    let ok = round_trip() catch e => {
        println(e.message())
        assert false
        return
    }
    assert ok
}

test "the builder lays bytes out in the order it says" {
    let out = bits.BinaryBuilder.new().write_u16be(0x0102).write_u16le(0x0102).write_f32be(1.5).build()
    assert out.len() == 8
    assert out[0] == 0x01
    assert out[1] == 0x02
    assert out[2] == 0x02
    assert out[3] == 0x01
    // 1.5f32 is 0x3FC00000.
    assert out[4] == 0x3F
    assert out[5] == 0xC0
    assert out[7] == 0x00
}

func empty_head() -> bool or bits.BinaryParseError {
    let data: Vec<u8> = [1, 2, 3]
    mut r = bits.BinaryReader.new(data)
    let head = try r.read_bytes(0)
    assert head.len() == 0
    assert r.pos() == 0
    let all = try r.read_bytes(3)
    assert all[2] == 3
    assert r.pos() == 3
    return true
}

test "read_bytes takes nothing or everything" {
    let ok = empty_head() catch e => {
        println(e.message())
        assert false
        return
    }
    assert ok
}

func short(data: Vec<u8>, what: string) -> string {
    mut r = bits.BinaryReader.new(data.clone())
    if what == "u32" {
        let v = r.read_u32be() catch e => return e.message()
        return "read {v}"
    }
    if what == "f64" {
        let v = r.read_f64le() catch e => return e.message()
        return "read {v}"
    }
    if what == "bytes" {
        let v = r.read_bytes(3) catch e => return e.message()
        return "read {v.len()}"
    }
    if r.read_u8() is bits.BinaryParseError {
        return "u8 failed"
    }
    return "u8 read"
}

func end_counts(data: Vec<u8>) -> string {
    mut r = bits.BinaryReader.new(data.clone())
    let v = r.read_i16be() catch e => {
        match e {
            bits.BinaryParseError.UnexpectedEnd(expected, actual) => return "{expected} {actual}"
            bits.BinaryParseError.InvalidData(message) => return message
        }
    }
    return "read {v}"
}

test "reading past the end is an error, not a panic" {
    let two: Vec<u8> = [1, 2]
    let empty: Vec<u8> = []
    assert short(two, "u32") == "unexpected end: expected 4 bytes, got 2"
    assert short(empty, "u32") == "unexpected end: expected 4 bytes, got 0"
    assert short(two, "f64") == "unexpected end: expected 8 bytes, got 2"
    assert short(two, "bytes") == "unexpected end: expected 3 bytes, got 2"
    assert short(empty, "u8") == "u8 failed"
    assert short(two, "u8") == "u8 read"
    assert end_counts(empty) == "2 0"
    assert end_counts([7]) == "2 1"
    assert end_counts(two) == "read 258"
}

func after_a_failed_read() -> string {
    let three: Vec<u8> = [1, 2, 3]
    mut r = bits.BinaryReader.new(three)
    let _ = r.read_u8() catch e => return e.message()
    let missed = r.read_u32be() is bits.BinaryParseError
    // A read that fails takes nothing, so the next one starts where it did.
    let next = r.read_u16be() catch e => return e.message()
    return "{missed} / {next} at {r.pos()}"
}

test "a short read leaves the position where it was" {
    assert after_a_failed_read() == "true / 515 at 3"
}
