// std.bits parsing and building: every `read_*` against bytes laid out by
// hand and by `BinaryBuilder`, and what a short buffer answers.
//
// A read takes the offset to start at and hands back the offset after it.
// It used to hand back the rest of the buffer as a new Vec, so reading a
// buffer value by value copied it once per value (O(n²)).

import bits

func reads_off_the_front() -> bool or bits.BinaryParseError {
    let data: Vec<u8> = [0xCA, 0xFE, 0xBA, 0xBE, 0x01, 0x00, 0x2A, 0xFF]
    let (magic, at) = try data.read_u32be(0)
    assert magic == 0xCAFEBABE
    assert at == 4
    let (one, at) = try data.read_u8(at)
    assert one == 1
    let (word, at) = try data.read_u16le(at)
    assert word == 0x2A00
    let (neg, at) = try data.read_i8(at)
    assert neg == -1
    assert at == 8

    let (le, _) = try data.read_u32le(0)
    assert le == 0xBEBAFECA
    let (be16, _) = try data.read_u16be(0)
    assert be16 == 0xCAFE
    let (mid, _) = try data.read_u16be(2)
    assert mid == 0xBABE
    // The receiver is only read: it still holds every byte.
    assert data.len() == 8
    return true
}

test "reads off the front, big and little endian" {
    let ok = reads_off_the_front() catch e => {
        println(e.message())
        assert false
        return
    }
    assert ok
}

func round_trip() -> bool or bits.BinaryParseError {
    let data = bits.BinaryBuilder.with_capacity(64)
        .write_u8(200)
        .write_i8(-100)
        .write_u16be(0xBEEF)
        .write_u16le(0xBEEF)
        .write_i16be(-12345)
        .write_i16le(-12345)
        .write_u32be(0xDEADBEEF)
        .write_u32le(0xDEADBEEF)
        .write_i32be(-123456789)
        .write_i32le(-123456789)
        .write_u64be(0x0123456789ABCDEF)
        .write_u64le(0x0123456789ABCDEF)
        .write_i64be(-1234567890123)
        .write_i64le(-1234567890123)
        .write_f32be(1.5)
        .write_f32le(-2.25)
        .write_f64be(3.141592653589793)
        .write_f64le(-0.5)
        .write_bytes([7, 8, 9])
    assert data.len() == 85
    let r0 = data.build()

    let (a, at) = try r0.read_u8(0)
    assert a == 200
    let (b, at) = try r0.read_i8(at)
    assert b == -100
    let (c, at) = try r0.read_u16be(at)
    assert c == 0xBEEF
    let (d, at) = try r0.read_u16le(at)
    assert d == 0xBEEF
    let (e, at) = try r0.read_i16be(at)
    assert e == -12345
    let (f, at) = try r0.read_i16le(at)
    assert f == -12345
    let (g, at) = try r0.read_u32be(at)
    assert g == 0xDEADBEEF
    let (h, at) = try r0.read_u32le(at)
    assert h == 0xDEADBEEF
    let (i, at) = try r0.read_i32be(at)
    assert i == -123456789
    let (j, at) = try r0.read_i32le(at)
    assert j == -123456789
    let (k, at) = try r0.read_u64be(at)
    assert k == 0x0123456789ABCDEF
    let (l, at) = try r0.read_u64le(at)
    assert l == 0x0123456789ABCDEF
    let (m, at) = try r0.read_i64be(at)
    assert m == -1234567890123
    let (n, at) = try r0.read_i64le(at)
    assert n == -1234567890123
    let (o, at) = try r0.read_f32be(at)
    assert o == 1.5
    let (p, at) = try r0.read_f32le(at)
    assert p == -2.25
    let (q, at) = try r0.read_f64be(at)
    assert q == 3.141592653589793
    let (s, at) = try r0.read_f64le(at)
    assert s == -0.5
    let (tail, at) = try r0.read_bytes(at, 3)
    assert tail.len() == 3
    assert tail[0] == 7
    assert tail[2] == 9
    assert at == r0.len()
    return true
}

test "every read round-trips through the builder" {
    let ok = round_trip() catch e => {
        println(e.message())
        assert false
        return
    }
    assert ok
}

test "the builder lays bytes out in the order it says" {
    let out = bits.BinaryBuilder.new().write_u16be(0x0102).write_u16le(0x0102).write_f32be(1.5).build()
    assert out.len() == 8
    assert out[0] == 0x01
    assert out[1] == 0x02
    assert out[2] == 0x02
    assert out[3] == 0x01
    // 1.5f32 is 0x3FC00000.
    assert out[4] == 0x3F
    assert out[5] == 0xC0
    assert out[7] == 0x00
}

func empty_head() -> bool or bits.BinaryParseError {
    let data: Vec<u8> = [1, 2, 3]
    let (head, at) = try data.read_bytes(0, 0)
    assert head.len() == 0
    assert at == 0
    let (all, at) = try data.read_bytes(0, 3)
    assert all[2] == 3
    assert at == 3
    return true
}

test "read_bytes takes nothing or everything" {
    let ok = empty_head() catch e => {
        println(e.message())
        assert false
        return
    }
    assert ok
}

func short(data: Vec<u8>, what: string) -> string {
    let failed = if what == "u8" {
        data.read_u8(0) is bits.BinaryParseError
    } else {
        false
    }
    if failed {
        return "u8 failed"
    }
    if what == "u32" {
        let (v, _) = data.read_u32be(0) catch e => return e.message()
        return "read {v}"
    }
    if what == "f64" {
        let (v, _) = data.read_f64le(0) catch e => return e.message()
        return "read {v}"
    }
    if what == "bytes" {
        let (v, _) = data.read_bytes(0, 3) catch e => return e.message()
        return "read {v.len()}"
    }
    return "u8 read"
}

func end_counts(data: Vec<u8>) -> string {
    let (v, _) = data.read_i16be(0) catch e => {
        match e {
            bits.BinaryParseError.UnexpectedEnd(expected, actual) => return "{expected} {actual}"
            bits.BinaryParseError.InvalidData(message) => return message
        }
    }
    return "read {v}"
}

test "reading past the end is an error, not a panic" {
    let two: Vec<u8> = [1, 2]
    let empty: Vec<u8> = []
    assert short(two, "u32") == "unexpected end: expected 4 bytes, got 2"
    assert short(empty, "u32") == "unexpected end: expected 4 bytes, got 0"
    assert short(two, "f64") == "unexpected end: expected 8 bytes, got 2"
    assert short(two, "bytes") == "unexpected end: expected 3 bytes, got 2"
    assert short(empty, "u8") == "u8 failed"
    assert short(two, "u8") == "u8 read"
    assert end_counts(empty) == "2 0"
    assert end_counts([7]) == "2 1"
    assert end_counts(two) == "read 258"
}

func past_the_end(data: Vec<u8>, at: usize) -> string {
    let (v, _) = data.read_u8(at) catch e => return e.message()
    return "read {v}"
}

test "an offset at or past the end has nothing left" {
    let two: Vec<u8> = [1, 2]
    assert past_the_end(two, 1) == "read 2"
    assert past_the_end(two, 2) == "unexpected end: expected 1 bytes, got 0"
    assert past_the_end(two, 9) == "unexpected end: expected 1 bytes, got 0"
}
