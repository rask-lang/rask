// PENDING type.simd — SIMD vector types (f32x4 = Vec[f32,4]): literals, splat, lane-wise arithmetic, lane extract. Expected RED until built; drives implementation. Do NOT assert current (wrong) behavior.
//
// Surveyed 2026-09-04, full findings in #1059. Short version: the checker's half
// is there — with `import math.f32x4` the types below check clean — and nothing
// below it is. A SIMD literal lowers to `[f64; 4]` (f64 lanes, not f32, and an
// array rather than a vector) and the binding is a `ptr` nothing ever writes to;
// lane indexing has no arm in MIR and falls into the Vec path; `+` desugars to a
// Vec method the interpreter can't find. `splat[f32, 4](…)` doesn't parse at all
// — square-bracket type application isn't in the grammar, which the spec's own
// `Vec[T, N]` form needs too. Start at the literal: the rest has nothing to work
// on until a SIMD value exists.
// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Spec: specs/types/simd.md — f32x4 aliases Vec[f32,4]; C1 literal construction,
// C3 splat[T,N](x) broadcast, A1 element-wise arithmetic, A3 scalar broadcast,
// LA1 lane indexing v[i].

// --- C1 literal + A1 element-wise add + LA1 lane extract ---

test "type.simd/A1 — f32x4 lane-wise add, extract lanes" {
    let a: f32x4 = [1.0, 2.0, 3.0, 4.0]   // C1 literal
    let b: f32x4 = [10.0, 20.0, 30.0, 40.0]
    let c = a + b                          // A1 element-wise
    assert c[0] == 11.0                      // LA1 lane read
    assert c[3] == 44.0
}

// --- C3 splat + A3 scalar broadcast ---

test "type.simd/C3 — splat broadcasts a scalar to all lanes, then add scalar" {
    let v = splat[f32, 4](5.0)             // C3: [5,5,5,5]
    let r = v + 1.0                         // A3: scalar broadcast -> [6,6,6,6]
    assert r[0] == 6.0
    assert r[1] == 6.0
    assert r[2] == 6.0
    assert r[3] == 6.0
}

func main() {}
