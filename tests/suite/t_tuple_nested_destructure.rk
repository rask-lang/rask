// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Nested tuple patterns and wide tuple elements (#442).
//
// The pattern used to be flattened to a bare name list, so `((a, b), c)` read
// all three off the *outer* tuple at positions 0, 1, 2 — and a wildcard shifted
// everything after it up one. A string element was stored as a pointer instead
// of its 16-byte value, so reading it back gave garbage.

func pairs() -> ((i64, i64), string) {
    return ((10, 20), "a fairly long string here")
}

test "nested tuple pattern" {
    let t = ((1, 2), 3)
    let ((a, b), c) = t
    assert a == 1
    assert b == 2
    assert c == 3
}

test "nested on the right" {
    let (m, (n, o)) = (1, (2, 3))
    assert m == 1
    assert n == 2
    assert o == 3
}

test "wildcard doesn't shift the elements after it" {
    let (p, _, r) = (7, 8, 9)
    assert p == 7
    assert r == 9
}

test "string element of a tuple" {
    let t = (5, "yo")
    assert t.0 == 5
    assert t.1 == "yo"
    let (n, s) = (7, "a fairly long string here")
    assert n == 7
    assert s == "a fairly long string here"
    assert s.len() == 25
}

test "nested pattern against a returned tuple" {
    let ((x, y), s) = pairs()
    assert x == 10
    assert y == 20
    assert s == "a fairly long string here"
}
