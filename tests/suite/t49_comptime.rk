// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Compile-time execution — the subset correct on BOTH backends.
// Witnesses ctrl.comptime (CT2 comptime const, CT5 comptime block, CT9/CT10
// return semantics, CT20 arithmetic, CT22 control flow, CT23 structs).
//
// Compile-time-evaluation proof (native): the `comptime func`s below are CT3
// comptime-only — no runtime body is emitted for them (verified via --dump-mir:
// `factorial` etc. are absent from the runtime function list). The native binary
// still links and produces the right values, which is only possible if the calls
// were folded to constants during compilation. An unfolded/deferred call would
// fail to link ("Function not found"). So a passing native run here IS the
// compile-time-evaluation witness.

// ── `if x? as v` inside comptime (#808) ─────────────────────────────
//
// The comptime evaluator dropped the presence binding: it evaluated the
// condition as a plain bool and never defined `v`, so a body that read the
// payload failed with "undefined variable". The interpreter and native both bind
// it; comptime is the one that didn't.

comptime func find_name(want: string) -> string? {
    let names = ["ada", "bo", "cy"]
    for n in names {
        if n == want { return n }
    }
    return none
}

const HIT: string = comptime {
    mut out = "unset"
    if find_name("bo")? as hit {
        out = "found {hit}"
    } else {
        out = "missing"
    }
    out
}

const MISS: string = comptime {
    mut out = "unset"
    if find_name("zz")? as hit {
        out = "found {hit}"
    } else {
        out = "missing"
    }
    out
}

const SHADOWED: string = comptime {
    mut out = "unset"
    let maybe = find_name("cy")
    // `as` can reuse the scrutinee's own name — ordinary shadowing, which is how
    // the no-rename convenience is recovered per-site (OPT19's rationale).
    if maybe? as maybe {
        out = "shadowed {maybe}"
    }
    out
}

test "type.optionals/OPT19 — comptime binds the presence payload" {
    assert HIT == "found bo"
    assert MISS == "missing"
    assert SHADOWED == "shadowed cy"
}

// ── 128-bit arithmetic at comptime (#802) ───────────────────────────
//
// Every comptime integer operation ran through one `i128` carrier, so the top
// half of `u128` had nowhere to be computed. `as_int` refused those values, the
// comparison path fell back to `as_i64` — which can't see past `i64::MAX` — and
// what came out was a silently wrong answer: `huge > big` on two values above
// `i128::MAX` answered false.
//
// The `u128` width is computed in a `u128` now. Only small values cross back out
// of these functions, so the folded return is observable without depending on how
// a 128-bit constant travels into MIR (which is its own gap — #824).

comptime func wide_compare() -> i64 {
    let huge: u128 = 340282366920938463463374607431768211455
    let big: u128 = 200000000000000000000000000000000000000
    if huge > big { return 1 }
    return 0
}

comptime func wide_add() -> i64 {
    let big: u128 = 200000000000000000000000000000000000000
    let one: u128 = 1
    let total = big + one
    if total > big { return 7 }
    return 0
}

comptime func wide_sub() -> i64 {
    let huge: u128 = 340282366920938463463374607431768211455
    let big: u128 = 200000000000000000000000000000000000000
    let diff = huge - big
    if diff == 140282366920938463463374607431768211455 { return 3 }
    return 0
}

comptime func wide_mask() -> i64 {
    let huge: u128 = 340282366920938463463374607431768211455
    let low: u128 = 255
    if huge & low == low { return 9 }
    return 0
}

comptime func wide_div() -> i64 {
    let huge: u128 = 340282366920938463463374607431768211455
    let two: u128 = 2
    if huge / two == 170141183460469231731687303715884105727 { return 5 }
    return 0
}

test "ctrl.comptime/CT1 — arithmetic reaches the top of u128" {
    assert comptime wide_compare() == 1
    assert comptime wide_add() == 7
    assert comptime wide_sub() == 3
    assert comptime wide_mask() == 9
    assert comptime wide_div() == 5
}

func main() {}

// CT5 + CT10: comptime block, value is the last expression
const SUM_BLOCK: i64 = comptime {
    mut s = 0
    for i in 0..10 {
        s += i
    }
    s
}

test "ctrl.comptime/CT5 — block const-eval last expression" {
    assert SUM_BLOCK == 45
}

// CT2: let initialized at compile time from a comptime expression
const PRODUCT: i64 = comptime 6 * 7

test "ctrl.comptime/CT2 — const from comptime expression" {
    assert PRODUCT == 42
}

// CT20: full arithmetic (incl. bitwise) at comptime
const BITS: i64 = comptime (1 << 4) | 3

test "ctrl.comptime/CT20 — arithmetic and bitwise" {
    assert BITS == 19          // 16 | 3
}

// CT2: a comptime let feeding another comptime const
const BASE: i64 = comptime 4 * 4
const DERIVED: i64 = comptime BASE + 8

test "ctrl.comptime/CT2 — comptime const feeds comptime const" {
    assert BASE == 16
    assert DERIVED == 24
}

// CT3 + CT9: marked comptime func with explicit return, recursion (CT22)
comptime func factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

const FACT5 = comptime factorial(5)

test "ctrl.comptime/CT3 — recursive comptime func call" {
    assert FACT5 == 120
}

// CT22: comptime branch selection
comptime func pick(flag: bool) -> i64 {
    if flag {
        return 100
    }
    return 200
}

const PICK_T = comptime pick(true)
const PICK_F = comptime pick(false)

test "ctrl.comptime/CT22 — comptime branch selection" {
    assert PICK_T == 100
    assert PICK_F == 200
}

// CT22: comptime while loop
comptime func triangular(n: i64) -> i64 {
    mut s = 0
    mut i = 0
    while i <= n {
        s += i
        i += 1
    }
    return s
}

const TRI = comptime triangular(5)

test "ctrl.comptime/CT22 — comptime while loop" {
    assert TRI == 15           // 0+1+2+3+4+5
}

// CT23: struct construction + field access at comptime
struct Point { x: i64, y: i64 }

comptime func manhattan() -> i64 {
    let p = Point { x: 3, y: 5 }
    return p.x + p.y
}

const MH = comptime manhattan()

test "ctrl.comptime/CT23 — struct construction and field access" {
    assert MH == 8
}

// CT8-adjacent: a comptime let is compile-time-known, so it drives a
// loop bound (a position that would reject a deferred/runtime value).
const LIMIT: i64 = comptime 3 + 4

test "ctrl.comptime/CT2 — comptime const drives loop bound" {
    mut count = 0
    for _ in 0..LIMIT {
        count += 1
    }
    assert count == 7
}

// CT6 (#403): an unmarked function referenced only from a top-level
// `const = comptime f()` used to get dropped from native codegen entirely —
// `triangular` above is `comptime func` and dodges this; this one isn't marked.
func doubled(n: i64) -> i64 {
    return n * 2
}

const DOUBLED: i64 = comptime doubled(21)

test "ctrl.comptime/CT6 — unmarked func called only at comptime" {
    assert DOUBLED == 42
}

// Typed array-repeat `[T; N]` (#403): the explicit element-type annotation used
// to leave `.len()` unresolved on native (`[mir] method len has no type prefix`).
func array_len() -> u64 {
    let a: [i32; 5] = [0; 5]
    return a.len()
}

test "types.arrays — typed array-repeat resolves .len()" {
    assert array_len() == 5
}
