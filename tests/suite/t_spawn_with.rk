// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `spawn_with`: a task handed what it consumes (conc.async/S6, #1318).
//
// A closure can't consume what it captured (mem.closures/CM4), so a resource
// reaches a task as the body's `take` parameter. One value, several in a
// tuple, a container the task hands back, a named function as the body, every
// spawn form, and the HTTP responder `http.serve` gives each request.

import async.Handles
import thread.Thread
import thread.ThreadPool
import net
import http
import http.{Request, Response, Responder}

@resource
struct Conn {
    public id: i32
}

extend Conn {
    public func close(take self) -> i32 {
        println("closed {self.id}")
        return self.id
    }
}

struct Bag {
    public items: Vec<i64>
    public name: string
}

func total(take b: Bag) -> i64 {
    mut t = 0
    for x in b.items {
        t += x
    }
    return t
}

test "a task closes the connection it is handed" {
    using Multitasking {
        let c = Conn { id: 1 }
        let h = spawn_with(c, |take c: Conn| {
            return c.close()
        })
        assert h.join()! == 1
    }
}

test "several go in a tuple" {
    using Multitasking {
        let h = spawn_with((Conn { id: 2 }, Conn { id: 3 }), |take pair: (Conn, Conn)| {
            let (a, b) = pair
            ensure b.close()
            return a.close()
        })
        assert h.join()! == 2
    }
}

test "a container goes in and comes back" {
    using Multitasking {
        let v: Vec<i64> = [1, 2, 3]
        let h = spawn_with(v, |take v: Vec<i64>| {
            v.push(4)
            return v
        })
        let back = h.join()!
        assert back.len() == 4
    }
}

test "the body can capture as well" {
    using Multitasking {
        let label = "sum"
        let h = spawn_with(Bag { items: [5, 6], name: "bag" }, |take b: Bag| {
            return "{label} {b.name} {total(b)}"
        })
        assert h.join()! == "sum bag 11"
    }
}

test "a named function is a body" {
    using Multitasking {
        let h = spawn_with(Bag { items: [1, 2], name: "two" }, total)
        assert h.join()! == 3
    }
}

test "wide results come back whole" {
    using Multitasking {
        let s = spawn_with("hello", |take s: string| { return "{s} world" })
        assert s.join()! == "hello world"
        let f = spawn_with(2.5, |take x: f64| { return x * 2.0 })
        assert f.join()! == 5.0
    }
}

test "one per turn of a loop" {
    using Multitasking {
        mut hs = Handles<u64>.new()
        ensure hs.detach()
        for i in 0..3 {
            let items: Vec<i64> = [i, i]
            hs.add(spawn_with(items, |take items: Vec<i64>| { return items.len() }))
        }
        mut sum: u64 = 0
        for r in hs.join_all() {
            sum += r!
        }
        assert sum == 6
    }
}

test "an OS thread" {
    let t = Thread.spawn_with(Conn { id: 4 }, |take c: Conn| { return c.close() })
    assert t.join()! == 4
}

test "a pool job" {
    using ThreadPool {
        let p = ThreadPool.spawn_with(Bag { items: [2, 3], name: "pool" }, total)
        assert p.join()! == 5
    }
}

test "the responder an HTTP server hands out" {
    using Multitasking {
        let server = http.listen("127.0.0.1:0")!
        ensure server.close()
        let addr = server.local_addr()
        let client = spawn(|| {
            return http.get("http://{addr}/items/7")
        })
        ensure client.detach()
        // The shape `http.serve` has: both handed over in a tuple.
        let (req, responder) = server.accept()!
        spawn_with((req, responder), |take handed: (Request, Responder)| {
            let (req, r) = handed
            let _ = r.respond(Response.ok("you asked for {req.path()}"))
        }).join()!
        let resp = client.join()!!
        assert resp.body == "you asked for /items/7"
    }
}
