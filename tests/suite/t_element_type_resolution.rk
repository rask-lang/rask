// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Lowering resolves what a collection holds instead of guessing i64. Each shape
// here reached a different resolution path, and every one of them used to fall
// through to the guess — right for integers, silently wrong for an f64, a
// string, or a struct.
import sync.Shared
import memory.Pool

struct Holder {
    public names: Vec<string>
    public scores: Map<string, f64>
}

struct Point {
    public x: f64
    public y: f64
}

func make_holder() -> Holder {
    mut names: Vec<string> = Vec.new()
    names.push("alpha")
    names.push("beta")
    mut scores: Map<string, f64> = Map.new()
    scores.insert("alpha", 1.5)
    return Holder { names: names, scores: scores }
}

test "indexing a Vec field of a returned struct keeps the element type" {
    let h = make_holder()
    assert h.names[0] == "alpha"
    assert h.names[1] == "beta"
}

test "a Map value type survives get" {
    let h = make_holder()
    if h.scores.get("alpha")? as s {
        assert s == 1.5
    } else {
        assert(false)
    }
}

test "a for loop over a struct's Vec field binds the real element type" {
    let h = make_holder()
    mut joined = ""
    for n in h.names {
        joined = "{joined}{n}"
    }
    assert joined == "alphabeta"
}

test "a Map inside a Mutex resolves its value type through lock" {
    let m = Shared.mutex(Map.new())
    with m.write() as inner {
        inner.insert("k", 2.5)
    }
    let got: f64 = m.write().get("k") ?? 0.0
    assert got == 2.5
}

test "a Vec of structs keeps its element type through index and iteration" {
    mut pts: Vec<Point> = Vec.new()
    pts.push(Point { x: 1.5, y: 2.5 })
    pts.push(Point { x: 3.5, y: 4.5 })

    assert pts[1].x == 3.5

    mut sum = 0.0
    for p in pts {
        sum = sum + p.y
    }
    assert sum == 7.0
}

test "an iterator chain keeps the element type" {
    mut vals: Vec<f64> = Vec.new()
    vals.push(1.5)
    vals.push(2.5)
    mut total = 0.0
    for v in vals {
        total = total + v
    }
    assert total == 4.0
}

test "removing during a snapshot iteration is not a stale handle" {
    mut pool: Pool<Point> = Pool.new()
    let a = pool.insert(Point { x: 1.0, y: 1.0 })
    let b = pool.insert(Point { x: 9.0, y: 9.0 })
    assert pool.len() == 2

    // Each `h` is a distinct handle out of the snapshot, so reading one after a
    // previous iteration removed a different one is fine.
    for h in pool.handles() {
        let p = pool[h]
        if p.x < 5.0 {
            pool.remove(h)
        }
    }
    assert pool.len() == 1
    assert pool[b].x == 9.0
    let _ = a
}
