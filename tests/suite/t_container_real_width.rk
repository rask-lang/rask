// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A container holds each element at its own width: a `Vec<u8>` is a byte per
// element and a `Vec<f32>` holds f32s. Every scalar used to take an 8-byte
// slot, integers widened and floats promoted to f64, and each reader and
// writer had to agree on that.

import sync.Shared
import sync.Local
import sync.Mutex

test "narrow integers keep their values and signs" {
    mut raw: Vec<u8> = Vec.new()
    raw.push(200)
    raw.push(7)
    assert raw[0] == 200
    assert raw.len() == 2
    let small: Vec<i16> = Vec.from([-300, 5, 32000])
    assert small[0] == -300
    assert small[2] == 32000
    mut words: Vec<u32> = Vec.new()
    words.push(4000000000)
    assert words[0] == 4000000000
}

test "floats stay floats" {
    mut fs: Vec<f32> = Vec.new()
    fs.push(2.5)
    fs.push(-0.25)
    assert fs[0] == 2.5
    assert fs[1] == -0.25
    let ds: Vec<f64> = Vec.from([1.5, 2.75])
    assert ds[1] == 2.75
}

test "bools and chars" {
    let flags: Vec<bool> = Vec.from([true, false, true])
    assert flags[0]
    assert !flags[1]
    let cs: Vec<char> = "héllo".chars().to_vec()
    assert cs.len() == 5
    assert cs[1] == 'é'
}

test "join prints each element as it prints alone" {
    let raw: Vec<u8> = Vec.from([200, 1])
    assert raw.join(",") == "200,1"
    let fs: Vec<f32> = Vec.from([1.5, 2.0])
    assert fs.join(" ") == "1.5 2"
    let flags: Vec<bool> = Vec.from([true, false])
    assert flags.join("") == "truefalse"
}

test "sort orders by value" {
    mut v: Vec<i16> = Vec.from([3, -2, 1])
    v.sort()
    assert v.join(",") == "-2,1,3"
    mut f: Vec<f32> = Vec.from([2.5, -1.0, 0.5])
    f.sort_by(|a, b| a.compare(b))
    assert f.join(",") == "-1,0.5,2.5"
}

test "pop, remove and get hand back the element" {
    mut v: Vec<u8> = Vec.from([1, 2, 3])
    assert (v.pop() ?? 0) == 3
    assert v.remove(0) == 1
    assert (v.get(0) ?? 0) == 2
    assert v.contains(2)
    assert !v.contains(9)
}

test "a map keyed and valued by narrow types" {
    mut m: Map<i32, f32> = Map.new()
    m.insert(1, 0.5)
    m.insert(-7, 2.25)
    assert (m.get(-7) ?? 0.0) == 2.25
    mut total = 0.0
    for (k, v) in m {
        total += v
    }
    assert total == 2.75
}

test "bytes round-trip through a string" {
    let b: Vec<u8> = "hi!".bytes().to_vec()
    assert b.len() == 3
    assert b[0] == 104
}

test "a channel of bytes" {
    let (tx, rx) = Channel.buffered<u8>(4)
    tx.send(250)!
    tx.send(3)!
    assert rx.receive()! == 250
    assert rx.receive()! == 3
}

test "an array borrows Vec methods at its own width" {
    mut a: [i32; 3] = [3, 1, 2]
    a.sort()
    assert a[0] == 1
    assert a[2] == 3
}

test "a shared narrow value" {
    let c: Shared<i16, Local> = Shared.local(-5)
    c.set(c.get() - 300)
    assert c.get() == -305
    let m: Shared<f32, Mutex> = Shared.mutex(1.5)
    with m.write() as v { v += 0.25 }
    with m.write() as v { assert v == 1.75 }
    let b: Shared<u8, Local> = Shared.local(7)
    with b.write() as v { v = 250 }
    assert b.get() == 250
}
