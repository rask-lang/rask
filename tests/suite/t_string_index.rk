// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `[]` on a string means bytes in both forms, and the indexed reads take byte
// offsets too (std.strings/U1, U1b).
//
// This used to be the sharpest instance of the units bug: `s[i]` yielded the
// character at index `i` while `s[i..j]` right beside it counted bytes, and
// `char_at` took a character index too — so both scanned from byte zero and a
// cursor loop was quadratic.

test "slices are usable in an expression" {
    let s = "hello"
    assert s[1..3] == "el"
    assert s[1..3].len() == 2
    assert s[0..5] == "hello"
}

test "a slice copied out with to_string" {
    let s = "hello"
    let owned = s[1..3].to_string()
    assert owned == "el"
    assert owned.len() == 2
}

test "slice offsets are bytes" {
    let u = "héllo"
    // é is two bytes, so it occupies 1..3 and 'l' starts at byte 3
    assert u.len() == 6
    assert u[0..1] == "h"
    assert u[1..3] == "é"
    assert u[3..4] == "l"
}

test "char_at takes a byte offset" {
    let u = "héllo"
    assert (u.char_at(0) ?? 'x') == 'h'
    assert (u.char_at(1) ?? 'x') == 'é'
    // byte 2 is the second half of é — not a character boundary
    assert u.char_at(2) is none
    assert (u.char_at(3) ?? 'x') == 'l'
    assert u.char_at(99) is none
}

test "s[i] reads one byte" {
    let u = "héllo"
    assert u[0] == 104u8          // 'h'
    // é is two bytes, so s[1] is the first of them, not the character
    assert u[1] == 195u8
    assert u[3] == 108u8          // 'l'
}

test "the three indexed reads agree on the offset" {
    let s = "hi"
    assert s[0] == 104u8
    assert s.byte_at(0)! == 104u8
    assert s.char_at(0)! == 'h'
}

test "s[i] and s[i..j] count the same unit" {
    let u = "héllo"
    // the byte at 1 is the first byte of the slice starting at 1
    assert u[1] == 195u8
    assert u[1..3] == "é"
}

test "scanning bytes for a delimiter" {
    let csv = "a,b,c"
    mut commas = 0
    mut i = 0
    while i < csv.len() {
        if csv[i] == 44u8 { commas = commas + 1 }
        i = i + 1
    }
    assert commas == 2
}

test "a byte cursor walks with len_utf8" {
    let u = "héllo"
    mut pos = 0
    mut count = 0
    while pos < u.len() {
        let c = u.char_at(pos)!
        pos = pos + c.len_utf8()
        count = count + 1
    }
    assert count == 5
}
