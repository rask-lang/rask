// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `s[i]` and `s[i..j]` on native (#353).
//
// Indexing had no runtime entry point at all — native failed with
// "Function not found: string_index". Both `s[i]` and `s.char_at(i)` count
// Unicode scalars, not bytes, matching the interpreter; `s.len()` still
// counts bytes (S-rules).

test "indexing an ascii string" {
    let s = "hello"
    assert s[0] == 'h'
    assert s[4] == 'o'
}

test "indexing counts characters, not bytes" {
    let u = "héllo"
    assert u[0] == 'h'
    assert u[1] == 'é'
    assert u[2] == 'l'
    // len is byte length, so the two-byte é makes it one longer
    assert u.len() == 6
}

test "char_at agrees with indexing" {
    let u = "héllo"
    assert (u.char_at(1) ?? 'x') == 'é'
    assert (u.char_at(2) ?? 'x') == 'l'
    assert u.char_at(99)? == false
}

test "slices are usable in an expression" {
    let s = "hello"
    assert s[1..3] == "el"
    assert s[1..3].len() == 2
    assert s[0..5] == "hello"
}

test "a slice copied out with to_string" {
    let s = "hello"
    let owned = s[1..3].to_string()
    assert owned == "el"
    assert owned.len() == 2
}
