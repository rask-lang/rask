// SPDX-License-Identifier: (MIT OR Apache-2.0)

// A tuple, optional or result has no methods of its own, so `k.hash()`,
// `a == b` and `a.clone()` in a generic body reach the function the checker
// wrote for the type `K` turns out to be. Natively the call had nothing to
// dispatch to, and `==` on a tuple holding a `Vec` compared the vectors'
// addresses (#1976).

func code<K: Hashable>(k: K) -> u64 {
    return k.hash()
}

func same<K: Equal>(a: K, b: K) -> bool {
    return a == b
}

func differ<K: Equal>(a: K, b: K) -> bool {
    return a != b
}

func dup<K: Cloneable>(a: K) -> K {
    return a.clone()
}

test "a tuple hashes through a bound" {
    assert code((1, 2)) == code((1, 2))
    assert code((1, 2)) != code((2, 1))
    assert code(("a", 3)) == code(("a", 3))
    assert code(("a", 3)) != code(("b", 3))
}

test "an optional hashes through a bound" {
    let a: string? = "x"
    let b: string? = "x"
    let n: string? = none
    assert code(a) == code(b)
    assert code(a) != code(n)
}

test "a tuple holding a vector compares by its contents" {
    let v: Vec<i64> = Vec.from([1, 2])
    let w: Vec<i64> = Vec.from([1, 3])
    assert same((v.clone(), 2), (v.clone(), 2))
    assert !same((v.clone(), 2), (w.clone(), 2))
    assert differ((v.clone(), 2), (w.clone(), 2))
    assert !differ((v.clone(), 2), (v.clone(), 2))
}

test "a tuple clones through a bound" {
    let v: Vec<i64> = Vec.from([4, 5])
    let t = (v, 3)
    let d = dup(t)
    assert d.0[1] == 5
    assert d.1 == 3
    assert t.0.len() == 2
    let p = dup((1, 2))
    assert p.1 == 2
    let s: string? = "kept"
    assert dup(s)! == "kept"
}
