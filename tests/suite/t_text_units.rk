test "std.strings — two marks recompose to one character" {
    // e + dot-below + circumflex is one Vietnamese character, not three
    assert_eq("\u{1EC7}".normalized().len(), 3)
    assert_eq("\u{1EC7}".normalized().chars().count(), 1)
    // and the decomposed spelling composes to the same thing
    assert_eq("e\u{0323}\u{0302}".normalized().len(), 3)
    if "e\u{0323}\u{0302}".normalized() != "\u{1EC7}" {
        panic("decomposed form should compose to the precomposed one")
    }
}

test "std.strings — a ZWJ sequence is one glyph wide" {
    let family = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}"
    assert_eq(family.width(), 2)
    assert_eq(family.graphemes().count(), 1)
    assert_eq(family.truncate(1).len(), 0)
    assert_eq(family.truncate(2).len(), family.len())
}

test "std.strings — a flag is one grapheme, two columns" {
    let no = "\u{1F1F3}\u{1F1F4}"
    assert_eq(no.graphemes().count(), 1)
    assert_eq(no.width(), 2)
}

test "std.strings — NFC composes and singletons fold" {
    assert_eq("\u{212B}".normalized().len(), 2)
    assert_eq("\u{1100}\u{1161}".normalized().len(), 3)
    assert_eq("caf\u{00E9}".normalized().len(), 5)
    assert_eq("plain ascii".normalized().len(), 11)
}

test "std.strings — normalized makes the comparison work" {
    let composed = "caf\u{00E9}"
    let decomposed = "cafe\u{0301}"
    if composed == decomposed { panic("these differ by bytes, that's the point") }
    if composed.normalized() != decomposed.normalized() {
        panic("normalized forms should match")
    }
}

test "std.strings — prepend characters chain into one cluster" {
    // Two Arabic number signs before a digit are one cluster, not three
    assert_eq("\u{0600}\u{0601}7".graphemes().count(), 1)
}
