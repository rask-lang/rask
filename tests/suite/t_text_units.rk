// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Text units against a reference (std.strings/U2, U5).
//
// The width, grapheme and NFC tables in the native runtime are generated from
// the same crates the interpreter uses (scripts/gen_unicode_text), so the two
// backends cannot drift by construction — but nothing checked that the
// generator's output agrees with the reference. These cases are fuzzed against
// Python's unicodedata, which shares no code with either backend.
//
// The pool is drawn from every codepoint whose NFC and NFD differ, plus the
// combining marks. An earlier version hand-picked a couple of dozen characters
// and missed the bug below entirely.
//
// Two bugs are pinned here:
//   - A character needing two marks (Vietnamese tone vowels, polytonic Greek)
//     came back as two codepoints. The generator only recorded a composition
//     pair when a character's fully-unfolded form had exactly two parts, so
//     the intermediate step was never in the table.
//   - Native summed the scalar widths of a ZWJ sequence, so a family emoji
//     measured six columns instead of two.

func assert_eq(got: usize, want: usize) {
    if got != want {
        panic("expected {want}, got {got}")
    }
}

test "std.strings — NFC matches the reference" {
    assert_eq("\u{1EC7}".normalized().len(), 3)
    assert_eq("\u{1EC1}".normalized().len(), 3)
    assert_eq("\u{1ED1}".normalized().len(), 3)
    assert_eq("\u{01ED}".normalized().len(), 2)
    assert_eq("\u{1FB7}".normalized().len(), 3)
    assert_eq("\u{1EAB}".normalized().len(), 3)
    assert_eq("\u{1EF1}".normalized().len(), 3)
