// SPDX-License-Identifier: (MIT OR Apache-2.0)
// 128-bit arithmetic (type.primitives: `i128`/`u128`, 16 bytes, ±2¹²⁷ / 0..2¹²⁸).
//
// The interpreter is right now; native still rejects these. Registered as a known
// divergence so the gate says when native catches up (#762).
//
// The interpreter had all the 128-bit arithmetic already — `Value::Int128` /
// `Value::Uint128` with checked ops behind them. What was missing was ever
// *producing* one: `IntKind` is a width tag on an i64 payload with no 128-bit
// member, so `let a: i128 = …` bound a plain `Value::Int` and `a + a` wrapped at
// 64 bits. `i64::MAX + i64::MAX` came back as -2. Silently, in a language whose
// arithmetic is otherwise checked.
//
// Natively `i128` has no MIR type of its own, so it lowers as an i64 and the
// overflow check fires at 64 bits: the same program panics instead. Loud rather
// than silent, which is why the interpreter went first.
//
// Every value here is written at or below `u64::MAX`, and the results are checked
// as *relationships* rather than literals — the lexer still parses a literal into
// 64 bits, so a number past that boundary can't be written on either side of the
// comparison. That half has to wait for native: widening the literal first would
// turn "doesn't compile" into "compiles and truncates".

test "type.primitives — i128 addition past the 64-bit boundary" {
    let a: i128 = 9223372036854775807
    let sum = a + a
    // Wrapped at 64 bits this was -2, so both halves of the check matter.
    assert sum > a
    assert sum / 2 == a
    assert sum - a == a
}

test "type.primitives — i128 multiplication past the 64-bit boundary" {
    let a: i128 = 9223372036854775807
    let doubled = a * 2
    assert doubled > a
    assert doubled == a + a
}

test "type.primitives — u128 addition past the 64-bit boundary" {
    let u: u128 = 18446744073709551615
    let sum = u + u
    assert sum > u
    assert sum / 2 == u
}

test "type.primitives — a negative i128 stays negative" {
    let n: i128 = -9223372036854775807
    let sum = n + n
    assert sum < n
    assert sum / 2 == n
}

test "type.primitives — small 128-bit values behave like any integer" {
    let s: i128 = 5
    assert s + 1 == 6
    assert s * 3 == 15
    assert s - 7 == -2
    assert s == 5
}

test "type.primitives — 128-bit values compare" {
    let big: i128 = 9223372036854775807
    let small: i128 = 5
    assert big > small
    assert small < big
}

func main() {}
