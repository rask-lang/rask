//
// A default argument naming an enum, in a program with its own enum of the
// same name.
//
// A default is a constant, folded at each call. The fold used to find
// `MemoryOrder.SeqCst` by looking `MemoryOrder` up by name, so the program's
// `MemoryOrder` below hid the stdlib's and `a.load()` had no `SeqCst` to read.
// It reads the enum the checker typed the access as now.

import sync.Atomic

enum MemoryOrder {
    Loose
    Strict
}

func pick(mode: MemoryOrder = MemoryOrder.Strict) -> i64 {
    match mode {
        MemoryOrder.Loose => return 1
        MemoryOrder.Strict => return 2
    }
}

const PICKED: i64 = comptime pick()

test "the stdlib's default and the program's enum both fold" {
    let a = Atomic<i64>.new(5)
    a.store(7)
    assert a.load() == 7
    assert pick() == 2
    assert pick(mode: MemoryOrder.Loose) == 1
    assert PICKED == 2
}
