// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A `let` bound to a value computed at compile time is an ordinary binding.
// Its written type is a coercion site: `let p: Point? = comptime { Point(…) }`
// bound a bare `Point`. And `as` inside the block is the conversion it says:
// the evaluator used to hand back any value it couldn't convert unchanged, so
// `Marker(v: 2) as any Opaque` came out a `Marker` and `3u32 as u64` a `u32`.

interface Opaque {
    func id(self) -> i64
}

struct Marker {
    public v: i64
}

Marker implements Opaque {
    func id(self) -> i64 {
        return self.v + 40
    }
}

struct Point {
    public x: i64
    public y: i64
}

func make() -> any Opaque {
    let d: any Opaque = comptime { Marker(v: 2) as any Opaque }
    return d
}

func maybe() -> Point? {
    let p: Point? = comptime { Point(x: 1, y: 2) }
    return p
}

func opt_local() -> i64 {
    let p: Point? = comptime { Point(x: 5, y: 6) }
    if p? as q {
        return q.x
    }
    return 0
}

func opt_scalar() -> i64 {
    let n: i64? = comptime { 9 }
    return n ?? 0
}

func wide() -> u64 {
    let w: u64 = comptime { 3u32 as u64 }
    return w
}

test "an interface value made at compile time" {
    assert make().id() == 42
}

test "a folded struct into an optional" {
    assert maybe()!.y == 2
    assert opt_local() == 5
}

test "a folded scalar into an optional" {
    assert opt_scalar() == 9
}

test "a widening as" {
    assert wide() == 3
}

func main() {}
