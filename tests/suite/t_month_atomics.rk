// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Atomics — #927, and the file that drove the feature.
//
// `Atomic` had no operations on any spelling. `Atomic<i64>` and `AtomicI64`
// both resolved as type names and then `new`, `load`, `store` were all "no
// method found" — the names came from the compiler's type registry with
// nothing behind them, while the C runtime had every operation implemented and
// unreachable.
//
// Everything here uses `Atomic<T>`, the only spelling mem.atomics/GA1 allows:
// "There are no `AtomicU64`-style named types and no aliases". The eleven named
// ones the registry carried are gone with the fix.
//
// mem.boxes/BX1 lists Atomic as the box family's adjacent member and boxes.md's
// decision tree routes "single counter, flag, or pointer-sized value" to it, so
// a reader following the documented procedure for a shared counter lands here.
// Reaching one from several tasks is `t_atomic_across_tasks.rk`.
import sync.Atomic

// A word-sized, padding-free, Copy struct — a legal payload per GA2.
//
// One field, not two: Rask gives every field its own word, so `{ index: i32,
// gen: i32 }` is 16 bytes however small the fields are written, and an atomic
// is one word. That case is a compile error now (E0384), pinned in
// `rask-cli/tests/compile_run.rs`.
struct Slot {
    packed: i64
}

test "mem.atomics — new and load" {
    let a = Atomic<i64>.new(7)
    assert a.load(Ordering.SeqCst) == 7
}

test "mem.atomics — store replaces the value" {
    let a = Atomic<i64>.new(0)
    a.store(42, Ordering.SeqCst)
    assert a.load(Ordering.SeqCst) == 42
}

test "mem.atomics — swap returns the old value" {
    let a = Atomic<i64>.new(1)
    assert a.swap(2, Ordering.SeqCst) == 1
    assert a.load(Ordering.SeqCst) == 2
}

test "mem.atomics — an integer payload counts" {
    let a = Atomic<i64>.new(0)
    a.fetch_add(5, Ordering.SeqCst)
    a.fetch_add(3, Ordering.SeqCst)
    assert a.load(Ordering.SeqCst) == 8
}

test "mem.atomics — counting in a loop" {
    let a = Atomic<i64>.new(0)
    for _ in 0..10 {
        a.fetch_add(1, Ordering.SeqCst)
    }
    assert a.load(Ordering.SeqCst) == 10
}

test "mem.atomics — a bool payload loads and stores" {
    let flag = Atomic<bool>.new(false)
    assert !flag.load(Ordering.SeqCst)
    flag.store(true, Ordering.SeqCst)
    assert flag.load(Ordering.SeqCst)
}

test "mem.atomics — a word-sized struct payload" {
    let s = Atomic<Slot>.new(Slot { packed: 0 })
    s.store(Slot { packed: 3 }, Ordering.SeqCst)
    let got = s.load(Ordering.SeqCst)
    assert got.packed == 3
}

test "mem.atomics — default for a primitive payload" {
    let a = Atomic<i64>.default()
    assert a.load(Ordering.SeqCst) == 0
}

func main() {}
