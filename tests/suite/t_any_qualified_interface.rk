// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// `any module.Interface` (#1159).
//
// A module-qualified name was fine in every type position but this one:
//
//     func takes_a_struct(b: io.Buffer) -> i64 { … }    // parses
//     func returns_one() -> io.Buffer { … }             // parses
//     func takes_a_box(r: any io.Reader) -> i64 { … }   // Expected ')', found '.'
//
// The parse after `any` was a copy of the type-name parse that handled a name
// and its generic arguments and stopped, so it never reached the qualification
// the real one does two lines further down. The interface's own name reads exactly
// like any other type name, so the same code reads it now.
//
// It cost more than the one spelling: with `any io.Reader` refused, writing a
// interface object of another module's interface meant importing the interface under a name
// of its own first, and for `io` that is its own maze — `import io.Writer`
// reports no such symbol, a bare `Writer` beside `import io` collides and asks
// for an alias. The error hinted at none of it.

import io

interface Greeter {
    func greet(self) -> string
}

struct Loud {
    name: string
}

extend Loud implements Greeter {
    func greet(self) -> string {
        return "HI {self.name}"
    }
}

// The unqualified spelling, which always worked — here so a regression in
// either shows up.
func hail(g: any Greeter) -> string {
    return g.greet()
}

// A qualified interface in a parameter, which is what the issue is about. It parses
// and it checks — `io.Buffer` conforms — and it stops there for now: the rest of
// the spelling isn't built. Calling it fails to lower natively (#1309), and
// declaring conformance with a qualified name (`extend Counter implements io.Writer`)
// is refused outright (#1310). So this is a signature that has to compile, not
// a call.
func sink(w: any io.Writer, data: string) -> bool {
    return true
}

// And inside a generic argument, which is the other place the old copy of the
// parse would have stopped.
func any_writers(ws: Vec<any io.Writer>) -> bool {
    return ws.len() > 0
}

// And in a return position.
func pick(g: any Greeter) -> any Greeter {
    return g
}

test "the file compiles, which is what the qualified signatures assert" {
    let l = Loud { name: "rask" }
    assert hail(l) == "HI rask"
}

test "and a bare one still round-trips" {
    let l = Loud { name: "there" }
    assert pick(l).greet() == "HI there"
}
