// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// `any module.Interface` (#1159).
//
// A module-qualified name was fine in every type position but this one:
//
//     func takes_a_struct(b: io.Buffer) -> i64 { … }    // parses
//     func returns_one() -> io.Buffer { … }             // parses
//     func takes_a_box(r: any io.Reader) -> i64 { … }   // Expected ')', found '.'
//
// The parse after `any` was a copy of the type-name parse that handled a name
// and its generic arguments and stopped, so it never reached the qualification
// the real one does two lines further down. The interface's own name reads exactly
// like any other type name, so the same code reads it now.
//
// It cost more than the one spelling: with `any io.Reader` refused, writing a
// interface object of another module's interface meant importing the interface under a name
// of its own first, and for `io` that is its own maze — `import io.Writer`
// reports no such symbol, a bare `Writer` beside `import io` collides and asks
// for an alias. The error hinted at none of it.

import io

interface Greeter {
    func greet(self) -> string
}

struct Loud {
    name: string
}

Loud implements Greeter {
    func greet(self) -> string {
        return "HI {self.name}"
    }
}

// The unqualified spelling, which always worked — here so a regression in
// either shows up.
func hail(g: any Greeter) -> string {
    return g.greet()
}

// A qualified interface in a parameter, which is what the issue is about, and a
// call through it. Lowering named the parameter's interface from its written
// text, "io.Writer", which no vtable is filed under, so the call couldn't be
// lowered natively (#1309). It now asks the type table, as the checker does.
func sink(w: any io.Writer, data: string) -> bool {
    w.write_text(data) catch _ => { return false }
    return true
}

// The other half: a program's own type conforming to another module's
// interface by its qualified name. The header looked the name up as written
// and answered "no interface named `io.Writer`", so no type a program declared
// could satisfy one (#1310).
struct Tally {
    seen: i64
}

Tally implements io.Writer {
    func write(self, data: Vec<u8>) -> i64 or io.IoError {
        return self.seen + data.len().to<i64>()!
    }
    func write_bytes(self, data: Vec<u8>) -> void or io.IoError {
    }
    func write_text(self, data: string) -> void or io.IoError {
        if data.is_empty() {
            return io.IoError.Other("nothing to write")
        }
    }
}

func send<W: Writer>(w: W, data: string) -> bool {
    w.write_text(data) catch _ => { return false }
    return true
}

// And inside a generic argument, which is the other place the old copy of the
// parse would have stopped.
func any_writers(ws: Vec<any io.Writer>) -> bool {
    for w in ws {
        w.write_text("x") catch _ => { return false }
    }
    return ws.len() > 0
}

// And in a return position.
func pick(take g: any Greeter) -> any Greeter {
    return g
}

test "the file compiles, which is what the qualified signatures assert" {
    let l = Loud { name: "rask" }
    assert hail(l) == "HI rask"
}

test "and a bare one still round-trips" {
    let l = Loud { name: "there" }
    assert pick(l).greet() == "HI there"
}

test "a qualified conformance header satisfies the module's interface" {
    let t = Tally { seen: 2 }
    assert send(t, "hello")
    assert !send(t, "")
    let n = t.write([1u8, 2u8, 3u8]) catch _ => -1
    assert n == 5
}

test "a call through `any io.Writer`" {
    mut buf = io.Buffer.new()
    assert sink(buf, "hello")
    assert sink(Tally { seen: 0 }, "hi")
    assert !sink(Tally { seen: 0 }, "")
    mut ws: Vec<any io.Writer> = Vec.new()
    ws.push(Tally { seen: 0 })
    assert any_writers(ws)
}
