// Who frees a closure's environment.
//
// A function that returns a closure allocates an environment per call. Calling
// one in a loop leaked every environment but the last: 99 allocations for 100
// calls (#1045).
//
// Two things were wrong, and the first was hiding the second.
//
// The back-edge case only knew closures built by a `ClosureCreate` in this
// frame. A closure that arrived from a *call* — which is the whole point of
// tracking functions that hand one back — had no entry, and the filter read
// that absence as "not made in the loop". So the only drop that ever fired was
// the one at the return, which happened to free the environment still live.
//
// Fixing that turned the leak into a double free, because the return case
// dropped every owned closure at every return with no dominance check at all.
// A closure made in a loop body isn't live at the loop's exit — it was already
// freed at the back-edge — and on the path that skips the body it was never
// made. Both cases decide by dominance now, the way `container_drop` has all
// along.
//
// What this does *not* fix, measured per test rather than assumed:
//
//   - A closure made on one branch of an `if` inside a loop. Neither the
//     back-edge nor the return dominates the block that made it, so there is
//     no point where freeing it is unconditionally safe. Same conservatism
//     `container_drop` has; the answer is drop placement at last use, not
//     another boundary.
//   - A chain's intermediate environments. Each adapter captures the one
//     before it, so only the outermost is this frame's — and freeing an
//     environment doesn't free what it captured.
//
// Both are the same question one level up: what happens to what an environment
// *owns* when the environment goes. That is #1045's remaining half and a design
// decision, not a missing case here.

import sequence.Sequence

func counter(base: i64) -> Sequence<i64> {
    return |yield| {
        if !yield(base) {
            return
        }
        if !yield(base + 1) {
            return
        }
    }
}

// The shape that leaked: one environment per call, a hundred calls.
test "an environment per call is freed per call" {
    mut total = 0
    mut r = 0
    while r < 100 {
        for x in counter(r) {
            total = total + x
        }
        r = r + 1
    }
    assert total == 10000
}

test "the same through a terminal rather than a for loop" {
    mut total = 0
    mut r = 0
    while r < 50 {
        total = total + counter(r).count()
        r = r + 1
    }
    assert total == 100u64
}

// A closure built in the loop body directly, rather than received from a call.
// This half always worked; it's here because the fix could have broken it.
test "a closure built in the loop body" {
    mut total = 0
    mut r = 0
    while r < 100 {
        let s: Sequence<i64> = |yield| {
            if !yield(r) {
                return
            }
        }
        total = total + s.count()
        r = r + 1
    }
    assert total == 100u64
}

// The dominance half, from the other side: a closure made on one branch is not
// freed on a path that never made it. Freeing it there was the double free the
// first version of this fix produced.
test "a closure made on one branch only" {
    mut total = 0
    mut r = 0
    while r < 20 {
        if r % 2 == 0 {
            total = total + counter(r).count()
        } else {
            total = total + 1
        }
        r = r + 1
    }
    assert total == 30u64
}

// Straight-line, no loop: the plain case, which the return path handles.
test "a returned closure outside any loop" {
    assert counter(5).count() == 2
}

// A sequence re-run (SEQ11): the environment has to survive the first run and
// still be freed once at the end.
test "a returned closure run twice" {
    let s = counter(1)
    assert s.count() == 2
    assert s.count() == 2
}

// A chain of them — each adapter is another environment.
test "a chain of adapters in a loop" {
    mut total = 0
    mut r = 0
    while r < 50 {
        total = total + counter(r).map(|x| x * 2).filter(|x| x > 0).count()
        r = r + 1
    }
    assert total == 99u64
}

// A captured container, which turns out to be clean: the environment is freed
// and the vector outlives it. Kept as the boundary marker — if this starts
// leaking, something about capture ownership changed.
func over_a_vec(v: Vec<i64>) -> Sequence<i64> {
    return |yield| {
        mut i = 0
        while i < v.len() {
            if !yield(v[i]) {
                return
            }
            i = i + 1
        }
    }
}

test "capturing a vec still works" {
    let v: Vec<i64> = [1, 2, 3]
    assert over_a_vec(v).count() == 3
    assert v.len() == 3
}
