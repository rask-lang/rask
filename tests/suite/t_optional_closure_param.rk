// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A closure handed to a `func(…) -> … ?` parameter. Native passed the bare
// closure pointer where the callee reads a tag, so `by? as f` took the `none`
// branch with the closure sitting right there (#1275). Every other payload —
// `i64?`, `string?`, a struct — went through the argument coercion and was
// fine; only a closure literal skipped it.
//
// It hid because a small callee gets inlined, and the inliner substitutes the
// argument instead of going through the ABI. Each function here has a body big
// enough that the call is real, which is the only thing `padding` is for.

func apply_free(padding: Vec<i64>, by: func(i64) -> i64 ? = none) -> i64 {
    let _n = padding.len()
    if by? as f {
        return f(3)
    }
    return -1
}

struct Scaler {
    base: i64
}

extend Scaler {
    func apply(self, padding: Vec<i64>, by: func(i64) -> i64 ? = none) -> i64 {
        let _n = padding.len()
        if by? as f {
            return f(self.base)
        }
        return -1
    }
}

func main() {}

test "A1 — a free function sees the closure it was passed" {
    mut pad = Vec.new()
    pad.push(1)
    assert apply_free(pad, |x| x * 10) == 30
    assert apply_free(pad, by: |x| x * 10) == 30
}

test "A2 — omitting it still reads as none" {
    mut pad = Vec.new()
    pad.push(1)
    assert apply_free(pad) == -1
}

test "A3 — a method sees it too" {
    mut pad = Vec.new()
    pad.push(1)
    let s = Scaler { base: 7 }
    assert s.apply(pad, |x| x * 10) == 70
    assert s.apply(pad, by: |x| x * 10) == 70
    assert s.apply(pad) == -1
}
