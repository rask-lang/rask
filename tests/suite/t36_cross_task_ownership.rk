// Legal cross-task ownership patterns (mem.ownership/T1–T3). The negative
// forms live in tests/compile_errors/cross_task_ownership.rk.

// T1: send moves the value to the receiver end of the channel. The compile-
// error suite proves that touching the value after the send is rejected; here
// the legal round-trip delivers it.
test "send delivers a value to the receiver" {
    const (tx, rx) = Channel<i64>.buffered(4)
    tx.send(30)
    mut total = 0
    if rx.receive() is i64 as v {
        total = v
    }
    assert total == 30
}

// Clone-then-send: cloning a sender yields an independent handle to the same
// channel; the original stays usable after the clone sends.
test "clone-then-send keeps the original sender usable" {
    const (tx, rx) = Channel<i64>.buffered(4)
    const tx2 = tx.clone()
    tx2.send(1)
    tx.send(2)
    mut sum = 0
    mut n = 0
    while rx.try_receive() is i64 as v {
        sum += v
        n += 1
        if n > 4 {
            assert false, "drain did not terminate"
            return
        }
    }
    assert sum == 3
    assert n == 2
}

// Move-capture spawn: `own` moves captures into the task, which then owns
// them. The task returns its result over a channel (another owned transfer).
test "own closure moves its captures into the task" {
    using Multitasking {
        const (tx, rx) = Channel<i64>.buffered(1)
        mut data = Vec.new<i64>()
        data.push(7)
        data.push(8)
        spawn(own || {
            mut acc = 0
            for v in data {
                acc += v
            }
            tx.send(acc)
            return 0
        }).detach()
        mut result = 0
        if rx.receive() is i64 as v {
            result = v
        }
        assert result == 15
    }
}
