// SPDX-License-Identifier: (MIT OR Apache-2.0)
// An i128 handed to a 64-bit instruction — #933.
//
// i128 works as a local, a parameter and a return value. Put one in a Vec or a
// struct and native won't build: the value is correctly typed i128 and the access
// is emitted as `load.i64`, which Cranelift's verifier rejects before anything
// runs.
//
//     v17 = load.i64 v16
//     arg 0 (v16) with type i128 failed to satisfy type set …
//
// #762 mapped MirType::I128/U128 to Cranelift's own I128 at 16 bytes, so the
// arithmetic holds up — it's the layout/access side that never got the same
// treatment, and whatever computes the load type for an aggregate member has an
// i64 default the i128 case doesn't override.
//
// Fourth member of the "size is known, access path doesn't consult it" family
// alongside #902, #924 and #895 — except louder, because the verifier catches this
// one instead of letting it corrupt memory.
//
// A 128-bit accumulator inside a struct is the ordinary reason to want the type: a
// ledger balance, a hash, a fixed-point value with a lot of fractional bits.
// Raido's 32.32 fixed-point is exactly this shape.
//
// A third site with the same cause and no aggregate in sight: a `to<T>()`
// narrowing *out* of 128 bits emits `sextend` — a *widening* instruction — against
// the 128-bit source. Whether the value fits doesn't matter; it's the instruction
// selection, not the range check. All four conversions below are right on the
// interpreter, including the out-of-range one.
//
// The surface that works is in `t_month_i128.rk`.

struct Ledger {
    id: i64
    balance: i128
}

struct Wrapper {
    inner: Ledger
}

func sum_wide(v: Vec<i128>) -> i128 {
    mut total: i128 = 0
    for x in v {
        total = total + x
    }
    return total
}

test "type.primitives — an i128 Vec element reads back" {
    let v: Vec<i128> = [18446744073709551616, 1]
    assert v.len() == 2
    assert v[0] == 18446744073709551616
    assert v[1] == 1
}

test "type.primitives — summing an i128 Vec" {
    let v: Vec<i128> = [18446744073709551616, 18446744073709551616, 1]
    assert sum_wide(v) == 36893488147419103233
}

test "type.primitives — an i128 struct field reads back" {
    let l = Ledger { id: 1, balance: 18446744073709551617 }
    assert l.id == 1
    assert l.balance == 18446744073709551617
}

test "type.primitives — an i128 struct field can be written" {
    mut l = Ledger { id: 2, balance: 0 }
    l.balance = 36893488147419103232
    assert l.balance == 36893488147419103232
    assert l.id == 2
}

test "type.primitives — an i128 field one level down" {
    let w = Wrapper { inner: Ledger { id: 3, balance: 18446744073709551616 } }
    assert w.inner.balance == 18446744073709551616
    assert w.inner.id == 3
}

test "type.primitives — an i128 as a Map value" {
    mut m: Map<string, i128> = Map.new()
    m.insert("big", 18446744073709551617)
    assert m.get("big")! == 18446744073709551617
}

test "type.primitives — to<i64> out of an i128 that fits" {
    let fits: i128 = 100
    assert fits.to<i64>()! == 100
}

test "type.primitives — to<i64> out of an i128 that doesn't fit" {
    let big: i128 = 18446744073709551617
    assert (big.to<i64>() catch _ => 0) == 0
}

test "type.primitives — to<i32> out of an i128" {
    let fits: i128 = 100
    assert fits.to<i32>()! == 100
}

test "type.primitives — to<u64> out of a u128" {
    let u: u128 = 100
    assert u.to<u64>()! == 100
}

// Every other place a 128-bit scalar can sit, and the rest of the conversion
// surface. All of these are the same question — is sixteen bytes an aggregate
// or a scalar? — asked by a different piece of code, and each one used to
// answer it from the size alone.

struct Wide9 {
    balance: i128
    tag: i32
}

enum Amount9 {
    Wide(i128)
    Narrow(i32)
}

test "type.primitives — an i128 in a tuple" {
    let t = (18446744073709551617, 5)
    assert t.0 == 18446744073709551617
    assert t.1 == 5
}

test "type.primitives — an i128 array element" {
    let arr: [i128; 3] = [1, 18446744073709551616, 3]
    assert arr[0] == 1
    assert arr[1] == 18446744073709551616
    assert arr[2] == 3
}

test "type.primitives — an i128 enum payload" {
    let a = Amount9.Wide(18446744073709551618)
    match a {
        Amount9.Wide(v) => assert v == 18446744073709551618
        Amount9.Narrow(_) => assert false
    }
}

test "type.primitives — an i128 optional payload" {
    let maybe: i128? = 18446744073709551619
    assert maybe! == 18446744073709551619
}

test "type.primitives — a u128 struct field holds its full range" {
    let w = Wide9 { balance: -18446744073709551617, tag: 3 }
    assert w.balance == -18446744073709551617
    assert w.tag == 3
}

// Ordering a struct with a 128-bit field: the derived `compare` reads each
// field, and every other scalar arm widens to i64 first. There is nothing
// wider to widen an i128 into, so it needs an arm of its own.
test "type.primitives — a struct with an i128 field can be ordered" {
    let lo = Wide9 { balance: 1, tag: 0 }
    let hi = Wide9 { balance: 18446744073709551616, tag: 0 }
    assert lo < hi
    assert hi > lo
    assert lo == Wide9 { balance: 1, tag: 0 }
}

test "type.primitives — a Vec<i128> element can be written back" {
    mut v: Vec<i128> = Vec.new()
    v.push(18446744073709551616)
    v.push(2)
    v[1] = 36893488147419103232
    assert v[0] == 18446744073709551616
    assert v[1] == 36893488147419103232
}

test "type.primitives — wrap<i64> out of an i128 keeps the low bits" {
    let big: i128 = 18446744073709551617
    assert big.wrap<i64>() == 1
}

test "type.primitives — clamp out of an i128 pins to the target range" {
    let big: i128 = 18446744073709551617
    let small: i128 = 100
    assert big.clamp<i64>() == 9223372036854775807
    assert small.clamp<i32>() == 100
}

// Widening the other way. The range check compares the value against the
// target's bounds, and doing that at the *source's* width truncated
// `i128::MIN` to zero, so every negative value looked out of range.
test "type.primitives — to<i128> out of a negative i64 always succeeds" {
    let n: i64 = -5
    assert n.to<i128>()! == -5
    let m: i64 = -9223372036854775808
    assert m.to<i128>()! == -9223372036854775808
}

func main() {}
