// SPDX-License-Identifier: (MIT OR Apache-2.0)
// #441: `v.map(f)` segfaulted natively — it fell through to a Vec_map runtime
// function that ignores the closure ABI. A bare adapter is a chain with an
// implicit collect, so it fuses like every other chain now.
//
// The result annotations are deliberate: inferring the element type back out
// of a chained adapter goes through the same `U` gap as fold (#327), and it
// resolves inconsistently across environments — this file passed locally and
// failed in CI on exactly that. The subject here is the adapters, so the
// annotations keep it testing those.
//
// Also pins the element type of `Vec.from([...])`. The checker leaves that as
// `Vec<?>`, and lowering used to read the unresolved variable as a pointer —
// which made `|x| { return x + 1 }` compile to pointer arithmetic and add the
// 8-byte stride instead of 1.

struct Point { public x: i64, public y: i64 }

func main() {}

test "map over a vec without an explicit iter()" {
    let v = Vec.from([1, 2, 3])
    let doubled: Vec<i64> = v.map(|x| { return x * 2 }).to_vec()
    assert doubled.len() == 3
    assert doubled[0] == 2
    assert doubled[2] == 6
}

test "addition in a closure is arithmetic, not pointer stride" {
    let v = Vec.from([1, 2, 3])
    let bumped: Vec<i64> = v.map(|x| { return x + 1 }).to_vec()
    assert bumped[0] == 2
    assert bumped[1] == 3
    assert bumped[2] == 4
}

test "filter without an explicit iter()" {
    let v = Vec.from([1, 2, 3, 4, 5, 6])
    let evens: Vec<i64> = v.filter(|x| { return x % 2 == 0 }).to_vec()
    assert evens.len() == 3
    assert evens[0] == 2
    assert evens[2] == 6
}

test "adapters chain without an explicit iter()" {
    let v = Vec.from([1, 2, 3, 4])
    let out: Vec<i64> = v.filter(|x| { return x > 2 }).map(|x| { return x * 2 }).to_vec()
    assert out.len() == 2
    assert out[0] == 6
    assert out[1] == 8
}

test "explicit iter().map().to_vec() agrees" {
    let v = Vec.from([1, 2, 3])
    let out: Vec<i64> = v.map(|x| { return x + 1 }).to_vec()
    assert out.len() == 3
    assert out[0] == 2
    assert out[2] == 4
}

test "struct elements keep their layout" {
    let pts = Vec.from([Point { x: 1, y: 2 }, Point { x: 3, y: 4 }])
    mut sum = 0
    for p in pts {
        sum = sum + p.x + p.y
    }
    assert sum == 10
}

test "float elements are not read as pointers" {
    let fs = Vec.from([1.5, 2.5])
    mut total = 0.0
    for f in fs {
        total = total + f
    }
    assert total == 4.0
}

// `v.take(n)` bound to a variable, with no chain around it to fuse into.
// `Vec.take` had no runtime symbol and no lowering outside fusion, so this died
// with "codegen 'main': Function not found: Vec_take" while `v.skip(n)` — which
// has always had `rask_iter_skip` — worked. Nothing in the suite spelled it
// until `.iter()` went away and chains started at the collection.
test "take and skip standing on their own" {
    let v: Vec<i32> = [1, 2, 3, 4, 5]
    let first3 = v.take(3).to_vec()
    assert first3.count() == 3
    assert first3[0] == 1
    assert first3[2] == 3
    let rest = v.skip(3).to_vec()
    assert rest.count() == 2
    assert rest[0] == 4
}

test "take more than there is, and take none" {
    let v: Vec<i32> = [1, 2, 3]
    assert v.take(99).count() == 3
    assert v.take(0).count() == 0
}

test "take keeps string elements alive" {
    let words: Vec<string> = ["alpha", "beta", "gamma"]
    let two = words.take(2).to_vec()
    assert two.count() == 2
    assert two[0] == "alpha"
    assert two[1] == "beta"
}
