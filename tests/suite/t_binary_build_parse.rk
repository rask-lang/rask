// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// type.binary: a `@binary` struct's field order is its wire layout (B1),
// packed with no padding (B2), most significant bit first (B3). `build()`
// writes it (G2), `T.parse(mutate r)` reads it back off a `bits.BinaryReader`
// and `T.from_bytes(bytes)` reads a buffer holding exactly one (G1), and
// `T.SIZE`/`T.SIZE_BITS` say how big it is (G4).
//
// These used to be Rust inside the interpreter, and native had neither, so a
// program that built a packet only ran on the interpreter.
import bits

@binary
struct Packet {
    magic: u16be
    id: u32be
}

@binary
struct Header {
    version: 4
    ihl: 4
    flags: 3
    offset: 13
    ttl: u8
    port: u16le
    delta: i8
    tag: [2]u8
}

@binary
struct Reading {
    temp: f32be
    scale: f64le
}

test "type.binary/G1 — build then parse gives every field back" {
    let p = Packet(magic: 0x1234, id: 0xDEADBEEF)
    let raw = p.build()
    assert raw.len() == 6
    let got = Packet.from_bytes(raw) catch e => {
        assert false
        return
    }
    assert got.magic == 0x1234
    assert got.id == 0xDEADBEEF
}

test "type.binary/B3 — a big-endian field goes most significant byte first" {
    let raw = Packet(magic: 0x1234, id: 0).build()
    assert raw[0] == 0x12
    assert raw[1] == 0x34
}

test "type.binary/B2 — bit fields pack with no padding, little-endian is low byte first" {
    let h = Header(version: 4, ihl: 5, flags: 2, offset: 0x1abc, ttl: 64, port: 0x1f90, delta: -3, tag: [7u8, 9u8])
    let raw = h.build()
    assert raw.len() == Header.SIZE
    assert raw[0] == 0x45
    // flags 010 then the top five bits of offset 1 1010 1011 1100.
    assert raw[1] == 0x5a
    assert raw[2] == 0xbc
    assert raw[3] == 64
    assert raw[4] == 0x90
    assert raw[5] == 0x1f
    assert raw[6] == 0xfd
    assert raw[7] == 7
    assert raw[8] == 9
    let g = Header.from_bytes(raw) catch e => {
        assert false
        return
    }
    assert g.version == 4
    assert g.ihl == 5
    assert g.flags == 2
    assert g.offset == 0x1abc
    assert g.ttl == 64
    assert g.port == 0x1f90
    assert g.delta == -3
    assert g.tag[1] == 9
}

func parse_one(mutate r: bits.BinaryReader) -> string {
    let p = Packet.parse(mutate r) catch e => return e.message()
    return "parsed {p.magic}"
}

func two_packets(raw: Vec<u8>) -> string or bits.BinaryParseError {
    mut r = bits.BinaryReader.new(raw.clone().freeze())
    let version = try r.read_u8()
    let first = try Packet.parse(mutate r)
    let second = try Packet.parse(mutate r)
    assert r.pos() == 13
    let tail = try r.read_u8()
    // Nothing left is short of a whole packet, and says how short.
    let missing = parse_one(mutate r)
    return "{version} {first.magic} {first.id} {second.magic} {second.id} {tail} / {missing}"
}

test "type.binary/G1 — records parse one after another off one reader" {
    mut raw: Vec<u8> = [9u8]
    for b in Packet(magic: 1, id: 2).build() {
        raw.push(b)
    }
    for b in Packet(magic: 3, id: 4).build() {
        raw.push(b)
    }
    raw.push(0xaa)
    let got = two_packets(raw) catch e => e.message()
    assert got == "9 1 2 3 4 170 / unexpected end: expected 6 bytes, got 0"
}

test "type.binary/G1 — too few bytes is an error, not a short read" {
    let short: Vec<u8> = [1u8, 2u8, 3u8]
    let got = Packet.from_bytes(short) catch e => {
        assert e.message() == "unexpected end: expected 6 bytes, got 3"
        return
    }
    assert false
}

test "type.binary/G1 — from_bytes wants exactly one, not one and some" {
    mut raw = Packet(magic: 1, id: 2).build()
    raw.push(0)
    let got = Packet.from_bytes(raw) catch e => {
        assert e.message() == "invalid data: 1 bytes after a Packet"
        return
    }
    assert false
}

test "type.binary/G4 — SIZE rounds up to whole bytes" {
    assert Packet.SIZE == 6
    assert Packet.SIZE_BITS == 48
    assert Header.SIZE_BITS == 72
    assert Header.SIZE == 9
}

test "type.binary — floats go on the wire as their bits, NaN as one pattern" {
    let r = Reading(temp: 1.5, scale: -2.25)
    let raw = r.build()
    assert raw.len() == Reading.SIZE
    // 1.5f32 is 0x3fc00000, most significant byte first.
    assert raw[0] == 0x3f
    assert raw[1] == 0xc0
    assert raw[2] == 0
    // -2.25 is 0xc002000000000000, least significant byte first.
    assert raw[4] == 0
    assert raw[10] == 0x02
    assert raw[11] == 0xc0
    let back = Reading.from_bytes(raw) catch e => {
        assert false
        return
    }
    assert back.temp == 1.5
    assert back.scale == -2.25
    let nan: f32 = 0.0 / 0.0
    let wire = Reading(temp: nan, scale: 0.0).build()
    assert wire[0] == 0x7f
    assert wire[1] == 0xc0
}

func main() {}
