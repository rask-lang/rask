// A panic or a skip releases what the frames it leaves own (ctrl.panic/U6).
//
// Both leave by longjmp, straight past every free the compiler put at the
// frames' ends, so each of these used to leave its vectors and strings behind
// natively (#1422). They pass either way; the leak gate runs this file under
// RASK_LEAK_CHECK, and a count above zero is the failure.
//
// The functions recurse so the inliner can't fold them into one frame: each
// frame here is a real frame with its own unwind record.

test "a skip releases the test's own vector" {
    let v: Vec<i64> = [1, 2, 3]
    skip("not today")
}

func label(n: i64) -> string {
    return "label number {n} of many"
}

func deepest(n: i64, depth: i64) -> i64 {
    let v: Vec<i64> = [n, depth]
    let s = label(depth)
    if depth > 2 {
        panic("deep")
    }
    let r = deepest(n, depth + 1)
    return r + s.len().to<i64>()! + v.len().to<i64>()!
}

func middle(n: i64) -> i64 {
    mut v: Vec<i64> = [n]
    let s = label(n + 10)
    // Runs before the frame's own vector is released, so it can still read it.
    ensure println("middle's ensure sees {v.len()} items, first {v[0]}")
    v.push(n)
    let r = deepest(n, 0)
    return r + s.len().to<i64>()!
}

func outer(n: i64) -> i64 {
    let v: Vec<i64> = [n, n, n]
    let s = label(n + 20)
    let r = middle(n)
    return r + s.len().to<i64>()! + v.len().to<i64>()!
}

test "a panic three frames deep releases every frame's vector and string" {
    mut died = false
    using Multitasking {
        let h = spawn {
            return outer(4)
        }
        match h.join() {
            i64 as v => { died = false },
            JoinError.Panicked(msg) => { died = true },
        }
    }
    assert died
}

func takes(take v: Vec<i64>, depth: i64) -> i64 {
    if depth > 1 {
        panic("the callee owns it now")
    }
    return takes(v, depth + 1)
}

test "a vector handed to a callee that panics is released once" {
    mut died = false
    using Multitasking {
        let h = spawn {
            let v: Vec<i64> = [1, 2]
            let s = label(7)
            return takes(v, 0) + s.len().to<i64>()!
        }
        match h.join() {
            i64 as v => { died = false },
            JoinError.Panicked(msg) => { died = true },
        }
    }
    assert died
}

// What a task block captured is the block's. Read and kept, it is released by
// the block's frame; handed on, by the frame it went to.
test "a panicking task releases what it captured" {
    let v: Vec<i64> = [1, 2, 3]
    let w: Vec<i64> = [4, 5]
    let s = label(3)
    mut died = 0
    using Multitasking {
        let h = spawn {
            return v.len().to<i64>()! + s.len().to<i64>()! + deepest(0, 0)
        }
        match h.join() {
            i64 as r => { died = 0 },
            JoinError.Panicked(msg) => { died = 1 },
        }
        let g = spawn {
            return takes(w, 0)
        }
        match g.join() {
            i64 as r => { died = 0 },
            JoinError.Panicked(msg) => { died += 1 },
        }
    }
    assert died == 2
}

// Aggregates (#1518): a struct, an enum, a `T?`, a `T or E` and a tuple are
// released by a panic too. A struct literal stores each field as soon as it
// is evaluated, so a panic in a later field's expression finds the value half
// built; it starts zeroed, so the fields not stored yet hold nothing to
// release. These also run under RASK_POISON_STACK, where an unzeroed field
// would read as 0xAA… and crash the release.

struct Held {
    items: Vec<i64>
}

struct Rec {
    name: string
    items: Vec<i64>
    n: i64
}

enum Slot {
    Empty
    Full(Vec<i64>)
    Named(string)
}

func later(n: i64) -> i64 {
    if n > 3 {
        skip("not today")
    }
    return later(n + 1) + 1
}

func boom(n: i64) -> i64 {
    if n > 2 {
        panic("boom")
    }
    return boom(n + 1) + 1
}

func panics(f: func() -> i64) -> bool {
    mut out = false
    using Multitasking {
        let h = spawn {
            return f()
        }
        match h.join() {
            i64 as v => { out = false },
            JoinError.Panicked(msg) => { out = true },
        }
    }
    return out
}

test "a skip releases what a struct holds" {
    let h = Held { items: [1, 2, 3] }
    let k = later(1)
    assert h.items.len() == 3
}

func half_built(n: i64) -> i64 {
    let r = Rec { name: label(n), items: [n, n], n: boom(n) }
    return r.n + r.items.len().to<i64>()!
}

test "a panic while a later field is evaluated" {
    assert panics(|| half_built(0))
}

func rebuild(turns: i64, k: i64) -> i64 {
    mut total = 0
    for i in 0..turns {
        let r = Rec { name: label(i), items: [i, i, i], n: if i == k { boom(3) } else { i } }
        total += r.n + r.name.len().to<i64>()! + r.items.len().to<i64>()!
    }
    return total
}

test "a panic on a later turn of a loop that rebuilds a struct" {
    assert panics(|| rebuild(5, 3))
    assert !panics(|| rebuild(3, 7))
}

func size(s: Slot) -> i64 {
    match s {
        Slot.Empty => { return 0 },
        Slot.Full(v) => { return v.len().to<i64>()! },
        Slot.Named(t) => { return t.len().to<i64>()! },
    }
}

func held_enum(n: i64) -> i64 {
    let a = Slot.Full([n, n])
    let b = Slot.Named(label(n))
    let k = boom(n)
    return k + size(a) + size(b)
}

func held_option(n: i64) -> i64 {
    let o: Vec<i64>? = [n, n]
    let s: string? = label(n)
    let k = boom(n)
    return k + o!.len().to<i64>()! + s!.len().to<i64>()!
}

struct ParseFail {
    text: string
}

extend ParseFail {
    func message(self) -> string {
        return self.text
    }
}

func parse(n: i64) -> Vec<i64> or ParseFail {
    if n > 100 {
        return ParseFail { text: label(n) }
    }
    let v: Vec<i64> = [n]
    return v
}

func width(r: Vec<i64> or ParseFail) -> i64 {
    match r {
        Vec<i64> as v => { return v.len().to<i64>()! },
        ParseFail as f => { return f.text.len().to<i64>()! },
    }
}

func held_result(n: i64) -> i64 {
    let r = parse(n)
    let e = parse(n + 200)
    let k = boom(n)
    return k + width(r) + width(e)
}

func held_tuple(n: i64) -> i64 {
    let t = ([n, n], label(n))
    let k = boom(n)
    return k + t.0.len().to<i64>()! + t.1.len().to<i64>()!
}

test "a panic releases what an enum, an optional, a result and a tuple hold" {
    assert panics(|| held_enum(0))
    assert panics(|| held_option(0))
    assert panics(|| held_result(0))
    assert panics(|| held_tuple(0))
}

func takes_rec(take r: Rec, depth: i64) -> i64 {
    if depth > 1 {
        panic("deep in the callee")
    }
    return takes_rec(r, depth + 1)
}

test "a struct handed to a callee that panics is released once" {
    assert panics(|| {
        let r = Rec { name: label(1), items: [1, 2], n: 1 }
        return takes_rec(r, 0)
    })
}
