    S(string)
    T(string, string)
}

func show(b: Big) -> string {
    match b {
        Big.S(s) => return s
        Big.T(a, c) => return "{a}+{c}"
        Big.V7(n) => return "v{n}"
        Big.V299(n) => return "v{n}"
        _ => return "?"
    }
}

test "match reads a two-byte tag" {
    assert show(Big.S("s-0")) == "s-0"
    assert show(Big.T("a", "b")) == "a+b"
    assert show(Big.V7(5)) == "v5"
    assert show(Big.V299(6)) == "v6"
    assert show(Big.V100(6)) == "?"
    let b = Big.S("x")
    match b {
        Big.S(s) => assert s == "x"
        _ => assert false
    }
}

// A backed enum's tag is as wide as its backing type; `match` reads all of it.
enum Op: u32 {
    A = 1
    B = 70000
    C = 5
}

func op_name(o: Op) -> string {
    match o {
        Op.A => return "a"
        Op.B => return "b"
        Op.C => return "c"
    }
}

test "match reads a four-byte tag" {
    assert op_name(Op.A) == "a"
    assert op_name(Op.B) == "b"
    assert op_name(Op.C) == "c"
}
