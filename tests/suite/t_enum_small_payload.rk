// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A nested enum or a small struct inside an enum variant lives in the parent's
// bytes, so reading it out has to hand back its address. Native loaded it as a
// word instead — a fieldless enum's payload is one byte, and that byte got
// dereferenced as a pointer (#561). Payloads over 8 bytes were always fine,
// which is why this only showed up on the small ones.

enum AuthError {
    Missing
    Invalid
}

extend AuthError {
    func message(self) -> string {
        match self {
            Missing => return "authorization required",
            Invalid => return "invalid credentials",
        }
    }
}

struct Pair {
    public a: i32
    public b: i32
}

struct Wide {
    public a: i64
    public b: i64
    public c: i64
}

enum ApiError {
    Auth(AuthError)
    Coords(Pair)
    Big(Wide)
    Named { code: u16, kind: AuthError }
    Text(string)
}

extend ApiError {
    func message(self) -> string {
        match self {
            Auth(e)     => return e.message(),
            Coords(p)   => return "at {p.a},{p.b}",
            Big(w)      => return "big {w.a}/{w.b}/{w.c}",
            ApiError.Named { code, kind } => return "{code}: {kind.message()}",
            Text(m)     => return "text: {m}",
        }
    }
}

test "a fieldless enum payload survives the match" {
    let e = ApiError.Auth(AuthError.Missing)
    assert_eq(e.message(), "authorization required")
    assert_eq(ApiError.Auth(AuthError.Invalid).message(), "invalid credentials")
}

test "an 8-byte struct payload survives the match" {
    let e = ApiError.Coords(Pair { a: 3, b: 4 })
    assert_eq(e.message(), "at 3,4")
}

test "a payload wider than a word still works" {
    let e = ApiError.Big(Wide { a: 1, b: 2, c: 3 })
    assert_eq(e.message(), "big 1/2/3")
}

test "a named-field variant reads its small enum field" {
    let e = ApiError.Named { code: 401, kind: AuthError.Invalid }
    assert_eq(e.message(), "401: invalid credentials")
}

test "a string payload still comes back whole" {
    assert_eq(ApiError.Text("hi").message(), "text: hi")
}

test "if-let binds a small enum payload" {
    let e = ApiError.Auth(AuthError.Missing)
    mut got = "none"
    if e is ApiError.Auth(inner) {
        got = inner.message()
    }
    assert_eq(got, "authorization required")
}
