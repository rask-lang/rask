// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A fused `.map(...).to_vec()` frees the elements it made.
//
// The fused loop built its result with `Vec_new(size)` and no description of
// the elements, so `Vec_free` thought they owned nothing: every inner vector
// of `v.map(|x| one(x)).to_vec()` leaked, and so did every string a
// `.map(...).join(sep)` built on the way (#1412). `RASK_LEAK_CHECK=1` is what
// catches it; the answers were always right.

func one(x: i64) -> Vec<i64> {
    mut v: Vec<i64> = Vec.new()
    v.push(x)
    return v
}

func adder(n: i64) -> func(i64) -> i64 {
    return |x| x + n
}

test "inner vectors made by map" {
    let plain: Vec<i64> = [1, 2, 3]
    let vs = plain.map(|x| one(x)).to_vec()
    assert vs.len() == 3
    assert vs[1][0] == 2
    let evens = plain.filter(|x| x % 2 == 1).map(|x| one(x * 10)).to_vec()
    assert evens.len() == 2
    assert evens[1][0] == 30
}

test "strings made by map" {
    let plain: Vec<i64> = [1, 2, 3]
    let names = plain.map(|x| "name number {x}, long enough to live on the heap").to_vec()
    assert names[2] == "name number 3, long enough to live on the heap"
    let joined = plain.map(|x| "item {x} with a long enough tail to be on the heap").join("|")
    assert joined.len() > 100
}

test "closures made by map" {
    let plain: Vec<i64> = [1, 2, 3]
    let fs = plain.map(|x| adder(x)).to_vec()
    assert fs.len() == 3
    let f = fs[2]
    assert f(10) == 13
}
