//
// A loop over a collection's sequence whose body also reads the collection.
//
// The body reading `v` makes `v` a memory slot the loop's closure points at,
// and the sequence's own closure captures what that slot holds. Natively,
// nobody freed it: the drop pass read the capture as `v` being handed over,
// and the sequence's closure only borrows its receiver, so its drop left `v`
// to the frame. `for k in m.keys() { m[k] }` leaked the map once `keys()`
// became a sequence; `v.as_sequence()` had leaked the same way before that.
//
// The leak gate runs this file. A read of `v` after the loop is here too, so
// a free placed at the closure's drop can't be too early.

import sequence.Sequence

test "a map's keys, indexing the map" {
    mut m: Map<string, i64> = Map.new()
    m["a key long enough to live on the heap"] = 1
    m["b"] = 2
    mut sum = 0
    for k in m.keys() {
        sum = sum + m[k]
    }
    assert sum == 3
}

test "a vector's sequence, reading the vector" {
    let v: Vec<string> = ["alpha", "a string long enough to live on the heap"]
    mut n: usize = 0
    for s in v.as_sequence() {
        n = n + v.len() + s.len()
    }
    assert n == 2 + 5 + 2 + 40
}

test "and the vector is still there after the loop" {
    let v: Vec<string> = ["x", "a string long enough to live on the heap"]
    mut n: usize = 0
    for s in v.as_sequence() {
        n = n + v[0].len() + s.len()
    }
    assert n + v[1].len() == 1 + 1 + 1 + 40 + 40
}

test "the map changes after the loop" {
    mut m: Map<string, i64> = Map.new()
    m["x"] = 1
    m["y"] = 2
    mut sum = 0
    for k in m.keys() {
        sum = sum + m[k]
    }
    m["z"] = 3
    assert sum + m["z"] == 6
}
