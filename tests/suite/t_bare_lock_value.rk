// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `mutex.write()` used directly as a value, with nothing chained onto it.
//
// The chained forms (`.write().method()`, `.write().field`) lower to an
// acquire / use / release trio. The bare form fell through to plain method
// dispatch and mangled the closure-taking `Mutex_lock` with no closure to give
// it, so native failed the Cranelift verifier on argument count (#479).
//
// A module-let case is deliberately absent: a test block that references a
// module-level let registers 0 tests on native (the #390 family), which would
// make this file diverge for an unrelated reason.
import sync.Shared
import sync.Mutex

struct Counter { public n: i64 }
extend Counter {
    func new() -> Counter { return Counter { n: 7 } }
    func get(self) -> i64 { return self.n }
}

struct Holder {
    n: Shared<i64, Mutex>
    v: Shared<Vec<i64>, Mutex>
    c: Shared<Counter, Mutex>
}

extend Holder {
    func new() -> Holder {
        return Holder {
            n: Shared.mutex(3),
            v: Shared.mutex(Vec.new()),
            c: Shared.mutex(Counter.new()),
        }
    }

    // Bare: the guard's value is the result.
    func read_scalar(self) -> i64 { return self.n.write() }
    // Chained, for contrast — this always worked.
    func read_chained(self) -> i64 { return self.c.write().get() }
    func vec_len(self) -> usize { return self.v.write().len() }
}

test "mem.boxes — a bare lock() yields the scalar payload" {
    let h = Holder.new()
    assert h.read_scalar() == 3
}

test "mem.boxes — a bare lock() on a Vec payload" {
    let h = Holder.new()
    assert h.vec_len() == 0
}

test "mem.boxes — the chained form still works" {
    let h = Holder.new()
    assert h.read_chained() == 7
}
