import sequence.Sequence

// `Vec.as_sequence()` — the chain head a collection stands for (SEQ48).
//
// Written in Rask, in `stdlib/collections.rk`, so both backends run one
// implementation. It is the first method on a built-in collection that has a
// Rask body rather than a native one, and that turned up a hole: the
// interpreter's "when no Rust arm recognises the method, the answer is a Rask
// implementation" fallback keys on a value's nominal type name, and
// `Value::Vec` had none — so the fallback had never been asked for a collection
// and silently reported "no method `as_sequence` on type `Vec`" while native ran
// it fine. Vec, Map, Pool and Rack have names now.
//
// Not a second `.iter()`: nothing here is a spelling a program should reach
// for. `for x in v` and `v.filter(p)` are the spellings. This exists so the
// call-site coercion has something to call once adapters move to the one
// surface SEQ41 asks for.

test "a sequence over a Vec yields its elements" {
    let v: Vec<i32> = [1, 2, 3, 4]
    mut total = 0
    for x in v.as_sequence() {
        total = total + x
    }
    assert total == 10
}

test "the terminals reach it" {
    let v: Vec<i32> = [1, 2, 3, 4]
    assert v.as_sequence().count() == 4u64
}

test "adapters compose over it" {
    let v: Vec<i32> = [1, 2, 3, 4, 5, 6]
    let evens: Vec<i32> = v.as_sequence().filter(|x| x % 2 == 0).to_vec()
    assert evens.len() == 3
    assert evens[0] == 2
    assert evens[2] == 6
}

test "map through a sequence over a Vec" {
    let v: Vec<i32> = [1, 2, 3]
    let doubled: Vec<i32> = v.as_sequence().map(|x| x * 2).to_vec()
    assert doubled.len() == 3
    assert doubled[2] == 6
}

// SEQ13a: a `break` has to stop the source, not just the loop.
test "break stops the walk" {
    let v: Vec<i32> = [1, 2, 3, 4, 5]
    mut seen = 0
    for x in v.as_sequence() {
        seen = seen + 1
        if x == 3 { break }
    }
    assert seen == 3
}

// The source is re-runnable: a Sequence is a function value, so consuming it
// twice walks twice (SEQ11/SEQ32).
test "a sequence over a Vec runs again" {
    let v: Vec<i32> = [1, 2, 3]
    let s = v.as_sequence()
    assert s.count() == 3u64
    assert s.count() == 3u64
}

test "a sequence over an empty Vec yields nothing" {
    let v: Vec<i32> = []
    mut seen = 0
    for x in v.as_sequence() {
        seen = seen + 1
    }
    assert seen == 0
    assert v.as_sequence().count() == 0u64
}

// Calling a method on the element used to fail native lowering with "method
// `len` on receiver of unresolved type". MIR knew a `Sequence<T>` holds `T`;
// the checker didn't, so the loop variable kept a free type variable and
// dispatch had nothing to name. These four are the shapes that broke.

test "a method on a string element" {
    let words: Vec<string> = ["alpha", "beta", "gamma", "delta"]
    mut long = 0u64
    for w in words.as_sequence() {
        if w.len() > 4u64 {
            long = long + w.len()
        }
    }
    assert long == 15u64
}

test "a method on the element of an adapted chain" {
    let words: Vec<string> = ["alpha", "beta", "gamma"]
    mut seen = 0
    for w in words.as_sequence().filter(|s| s.len() > 4u64) {
        if w.starts_with("a") {
            seen = seen + 1
        }
    }
    assert seen == 1
}

test "a method on a struct element" {
    let pts: Vec<Point> = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    mut total = 0
    for p in pts.as_sequence() {
        total = total + p.sum()
    }
    assert total == 10
}

test "a method on half of a tuple element" {
    mut letters = 0
    for (n, name) in pairs() {
        letters = letters + n + name.len().wrap<i64>()
    }
    assert letters == 9
}

struct Point {
    x: i64
    y: i64
}

extend Point {
    public func sum(self) -> i64 {
        return self.x + self.y
    }
}

func pairs() -> Sequence<(i64, string)> {
    return |yield| {
        if !yield((1, "one")) { return }
        if !yield((2, "two")) { return }
    }
}
