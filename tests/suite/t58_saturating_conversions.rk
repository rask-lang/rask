// type.primitives — `clamp` and `to` across the signedness
// boundary, where source and target don't agree on whether values can be
// negative.

test "CV6 — unsigned source, signed target" {
    let small: u64 = 42
    assert small.clamp<i64>() == 42
    let huge: u64 = 18446744073709551615
    assert huge.clamp<i64>() == 9223372036854775807
    let zero: u64 = 0
    assert zero.clamp<i64>() == 0
}

test "CV6 — signed source, unsigned target" {
    let neg: i64 = -5
    assert neg.clamp<u64>() == 0
    assert neg.clamp<u8>() == 0
    let pos: i64 = 200
    assert pos.clamp<u64>() == 200
    let big: i64 = 9223372036854775807
    assert big.clamp<u64>() == 9223372036854775807
}

test "CV6 — narrowing within one signedness" {
    let wide: i64 = 300
    assert wide.clamp<u8>() == 255
    assert wide.clamp<i8>() == 127
    let low: i64 = -300
    assert low.clamp<i8>() == -128
    let fits: i64 = 100
    assert fits.clamp<i8>() == 100
}

test "CV6 — an unsigned narrowing keeps its ceiling" {
    let u: u64 = 70000
    assert u.clamp<u16>() == 65535
    assert u.clamp<u32>() == 70000
}

test "CV11 — to across the signedness boundary" {
    // `x.to<T>()` gives `T or ConvertError` — the failure is a value with a
    // reason on it, so the fallback is `catch` rather than `??`.
    let small: u64 = 42
    assert (small.to<i64>() catch _ => -1) == 42

    let huge: u64 = 18446744073709551615
    assert (huge.to<i64>() catch _ => -1) == -1

    let neg: i64 = -1
    assert (neg.to<u64>() catch _ => 99) == 99

    let pos: i64 = 7
    assert (pos.to<u64>() catch _ => 99) == 7

    let big: i64 = 9223372036854775807
    assert (big.to<u64>() catch _ => 0) == 9223372036854775807
}

test "CV6 — saturating inside a loop accumulator" {
    mut ids = 0
    mut vals = Vec.new()
    vals.push(10)
    vals.push(20)
    vals.push(30)
    for v in vals {
        ids += v.clamp<i64>()
    }
    assert ids == 60
}
