// Optional types: auto-wrap, none literal, operators, is-patterns.

func find(items: Vec<i32>, target: i32) -> i32? {
    for i in 0..items.len() {
        if items[i] == target {
            return items[i]
        }
    }
    return none
}

func safe_div(a: i32, b: i32) -> i32? {
    if b == 0 { return none }
    return a / b
}

test "present value auto-wraps" {
    let x: i32? = 42
    assert x?
}

test "none construction" {
    let x: i32? = none
    assert x is none
}

test "force unwrap present" {
    let x: i32? = 42
    assert x! == 42
}

test "is Some with binding" {
    let x: i32? = 10
    if x? {
        assert x == 10
    } else {
        assert false, "expected present"
    }
}

test "is None" {
    let x: i32? = none
    assert x is none
    if x? {
        assert false, "expected none"
    }
}

test "optional from function" {
    assert safe_div(10, 2)?
    assert safe_div(10, 2)! == 5
    assert safe_div(10, 0) is none
}

test "optional with Vec" {
    mut v = Vec.new()
    v.push(10)
    v.push(20)
    v.push(30)

    let found = find(v, 20)
    assert found?
    assert found! == 20

    let not_found = find(v, 99)
    assert not_found is none
}

// rask#579: bare `x is i32` (no `as` binding) on a `T?` fell through to a
// variable-binding pattern in the interpreter and matched unconditionally,
// so a `none` also answered `true`. Native always had this right.
test "bare type-name is check on optional (#579)" {
    let present: i32? = 5
    assert present is i32
    let absent: i32? = none
    assert !(absent is i32)
}

test "is-as narrowing on optional agrees with bare is (#579)" {
    let present: i32? = 5
    if present is i32 as v {
        assert v == 5
    } else {
        assert false, "expected present to narrow"
    }
    let absent: i32? = none
    if absent is i32 as v {
        assert false, "expected none not to narrow"
    }
}

func main() {}
