// SPDX-License-Identifier: (MIT OR Apache-2.0)
// The `os` module's environment and platform calls, natively (#855).
//
// Five of them had no native entry point at all — `os.set_env(…)` reached
// codegen as "Function not found: os_set_env" while the interpreter ran it
// fine. `env`, `env_or`, `env_vars` and `pid` were there; `set_env`,
// `remove_env`, `args`, `platform` and `arch` weren't.
//
// The subprocess half (`os.Command`) is still interpreter-only — that's a
// bigger piece and has its own issue.

import os

test "std.os — setting, reading and removing a variable" {
    os.set_env("RASK_TEST_ENV_A", "one")
    assert os.env("RASK_TEST_ENV_A") ?? "-" == "one"
    assert os.env_or("RASK_TEST_ENV_A", "fallback") == "one"

    // Setting again replaces.
    os.set_env("RASK_TEST_ENV_A", "two")
    assert os.env("RASK_TEST_ENV_A") ?? "-" == "two"

    os.remove_env("RASK_TEST_ENV_A")
    assert(os.env("RASK_TEST_ENV_A") is none)
    assert os.env_or("RASK_TEST_ENV_A", "fallback") == "fallback"
}

test "std.os — an empty value is set, not unset" {
    os.set_env("RASK_TEST_ENV_EMPTY", "")
    assert os.env("RASK_TEST_ENV_EMPTY") ?? "-" == ""
    assert(!(os.env("RASK_TEST_ENV_EMPTY") is none))
    os.remove_env("RASK_TEST_ENV_EMPTY")
}

test "std.os — a name that was never set" {
    assert(os.env("RASK_TEST_ENV_NEVER_SET_XYZ") is none)
    assert os.env_or("RASK_TEST_ENV_NEVER_SET_XYZ", "fb") == "fb"
    // Removing one that isn't there is a no-op, not a failure.
    os.remove_env("RASK_TEST_ENV_NEVER_SET_XYZ")
    assert(os.env("RASK_TEST_ENV_NEVER_SET_XYZ") is none)
}

test "std.os — env_vars sees what set_env wrote" {
    os.set_env("RASK_TEST_ENV_LISTED", "here")
    mut found = 0
    for pair in os.env_vars() {
        if pair.0 == "RASK_TEST_ENV_LISTED" {
            found = found + 1
            assert pair.1 == "here"
        }
    }
    assert found == 1
    os.remove_env("RASK_TEST_ENV_LISTED")
}

// A value long enough to have its own buffer, so the string coming out of the
// option is a real heap string rather than a small one living in the header.
// A header read out of freed storage gives a garbage pointer, and this
// comparison is what notices.
test "std.os — a long value survives the trip out" {
    let long = "a value long enough that the string keeps its own buffer"
    os.set_env("RASK_TEST_ENV_LONG", long)
    let got = os.env("RASK_TEST_ENV_LONG") ?? "-"
    assert got == long
    assert got.len() == 56
    os.remove_env("RASK_TEST_ENV_LONG")
}

// One read per turn, so a header written into storage the last turn owned
// reads as the wrong value rather than as nothing.
test "std.os — one read per turn" {
    os.set_env("RASK_TEST_ENV_LOOP", "the value each turn reads back, long enough to allocate")
    mut hits = 0
    for i in 0..16 {
        let v = os.env("RASK_TEST_ENV_LOOP") ?? "-"
        if v == "the value each turn reads back, long enough to allocate" {
            hits = hits + 1
        }
    }
    assert hits == 16
    os.remove_env("RASK_TEST_ENV_LOOP")
}

// A hit and a miss in the same frame: the miss must not disturb the slot the
// hit wrote, which is the same slot when both reads share a destination.
test "std.os — a hit and a miss side by side" {
    os.set_env("RASK_TEST_ENV_PRESENT", "present and long enough to allocate")
    let hit = os.env("RASK_TEST_ENV_PRESENT")
    let miss = os.env("RASK_TEST_ENV_ABSENT_QQQ")
    assert miss is none
    assert (hit ?? "-") == "present and long enough to allocate"
    os.remove_env("RASK_TEST_ENV_PRESENT")
}

// The values depend on the machine, so this checks the shape rather than the
// answer — the point is that both backends have one at all.
test "std.os — platform, arch, args and pid" {
    assert(os.platform().len() > 0)
    assert(!(os.platform() == "unknown"))
    assert(os.arch().len() > 0)
    assert(!(os.arch() == "unknown"))
    assert(os.args().len() >= 1)
    assert(os.pid() > 0)
}

func main() {}
