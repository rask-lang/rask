// `Link<T>?` is one word with no tag, and its `none` is the nullptr address.
//
// The first native pass gave links all-ones instead — the sentinel the pool's
// handles used, back when there were handles — so every absent edge in a fresh
// node was the address -1, which `rack.insert` then walked looking for edges to
// record. It only stayed upright because the runtime also accepted -1 as
// absent, i.e. two wrongs. Null is the right sentinel for the same reason: a
// rack chunk arrives zeroed, so every link in it already reads as `none`.
import memory.Link
import memory.Rack

struct Node {
    id: i32
    peer: Link<Node>?
}

struct Cursor {
    at: Link<Node>?
}

func main() {}

test "a fresh node's absent edge is absent, not an address" {
    mut rack: Rack<Node> = Rack.new()
    let n = rack.insert(Node { id: 1, peer: none })

    if n.peer? as _p {
        assert false
    }
    assert n.id == 1
}

// A present edge and an absent one side by side, so a sentinel that collided
// with a real address would show as one reading like the other.
test "present and absent edges don't read as each other" {
    mut rack: Rack<Node> = Rack.new()
    let a = rack.insert(Node { id: 1, peer: none })
    let b = rack.insert(Node { id: 2, peer: a })

    if b.peer? as p {
        assert p.id == 1
    } else {
        assert false
    }
    if a.peer? as _p {
        assert false
    }
}

test "clearing an edge to none leaves the node reachable" {
    mut rack: Rack<Node> = Rack.new()
    let a = rack.insert(Node { id: 1, peer: none })
    mut b = rack.insert(Node { id: 2, peer: a })

    b.peer = none

    if b.peer? as _p {
        assert false
    }
    assert rack.len() == 2

    // The target survives losing its last incoming edge — a rack is not
    // reference counted (RK5).
    rack.delete(b)
    assert rack.len() == 1
    assert a.id == 1
}

// A container of *nodes carrying* edges, which is the shape programs write.
test "a none inside a struct in a container stays none" {
    mut rack: Rack<Node> = Rack.new()
    let a = rack.insert(Node { id: 1, peer: none })
    mut v: Vec<Cursor> = Vec.new()
    v.push(Cursor { at: none })
    v.push(Cursor { at: a })

    if v.get(0)? as first {
        if first.at? as _p {
            assert false           // the literal's `none` read as an address
        }
    } else {
        assert false
    }
    if v.get(1)? as second {
        if second.at? as p {
            assert p.id == 1
        } else {
            assert false
        }
    } else {
        assert false
    }
}

// A container whose *element* is itself the niche. This is the shape #959 was
// about: two computations of the element disagreed, one writing the 8-byte word
// and the other reserving a 16-byte tagged slot. Past-the-end and an empty slot
// are different answers and both have to survive.
test "a Vec of optional links keeps its slots apart" {
    mut rack: Rack<Node> = Rack.new()
    let a = rack.insert(Node { id: 1, peer: none })
    mut v: Vec<Link<Node>?> = Vec.new()
    v.push(a)
    v.push(none)

    assert v.len() == 2
    if v.get(0)? as slot {
        if slot? as live {
            assert live.id == 1
        } else {
            assert false           // a filled slot read as empty
        }
    } else {
        assert false
    }
    if v.get(1)? as slot {
        if slot? as _p {
            assert false           // an empty slot read as an address
        }
    } else {
        assert false               // index 1 of a 2-element Vec exists
    }
    if v.get(9)? as _slot {
        assert false               // past the end is absent at the outer layer
    }

    // The delete reaches into the container and nulls the entry (RK3).
    rack.delete(a)
    if v.get(0)? as slot {
        if slot? as _p {
            assert false
        }
    } else {
        assert false
    }
}
