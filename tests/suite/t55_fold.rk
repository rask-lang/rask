// SPDX-License-Identifier: (MIT OR Apache-2.0)
// #462: fold with a `return` in the closure body dropped the accumulator.
// The return stored its result, then the fused loop assigned the body's
// fall-off value over it, so every iteration reset acc and the fold came
// back with its init value.
//
// Also covers folding a Vec directly (#462 reached `Vec_fold`, which doesn't
// exist) — a collection is its own iteration source, same as `.iter()`.

func main() {}

test "fold with an explicit return in the body" {
    let v = Vec.from([1, 2, 3, 4])
    let total: i64 = v.fold(0, |acc, x| { return acc + x })
    assert total == 10
}

test "fold through an explicit iter() is the same" {
    let v = Vec.from([1, 2, 3, 4])
    let total: i64 = v.iter().fold(0, |acc, x| { return acc + x })
    assert total == 10
}

test "fold with a non-zero init" {
    let v = Vec.from([1, 2, 3])
    let total: i64 = v.fold(100, |acc, x| { return acc + x })
    assert total == 106
}

test "fold over an empty vec keeps the init" {
    let v: Vec<i64> = Vec.new()
    let total: i64 = v.fold(7, |acc, x| { return acc + x })
    assert total == 7
}

test "fold is not commutative — order is preserved" {
    let v = Vec.from([1, 2, 3])
    // Each step doubles what came before, so order shows up in the result.
    let packed: i64 = v.fold(0, |acc, x| { return acc * 10 + x })
    assert packed == 123
}

test "fold composes with map and filter" {
    let v = Vec.from([1, 2, 3, 4, 5, 6])
    let total: i64 = v.iter()
        .filter(|x| { return x % 2 == 0 })
        .map(|x| { return x * 10 })
        .fold(0, |acc, x| { return acc + x })
    assert total == 120
}
