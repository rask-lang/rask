// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Field annotations on the JSON path: @rename, @skip, @default
// (std.encoding/E18–E20, std.json/J8–J9).
//
// These decide both what a decode looks for and what an encode writes, so each
// one is checked in both directions. `{` opens interpolation, hence the doubled
// braces in the JSON literals.

import json

struct ApiUser {
    @rename("user_name")
    public name: string

    public age: i64

    @default("user")
    public role: string

    @skip
    public cache_key: string
}

struct Skipped {
    public id: i64

    @skip
    public note: string

    @skip
    public tags: Vec<string>

    @skip
    public seen: i64?
}

// E18
test "std.encoding — @rename decides the key a field decodes from" {
    let u = json.decode<ApiUser>("{{\"user_name\":\"alice\",\"age\":30}}") catch e => {
        assert false
        return
    }
    assert u.name == "alice"
    assert u.age == 30
}

test "std.encoding — @rename decides the key a field encodes to" {
    let u = json.decode<ApiUser>("{{\"user_name\":\"alice\",\"age\":30}}") catch e => {
        assert false
        return
    }
    let out = json.encode(u)
    assert out.contains("\"user_name\":\"alice\"")
    assert !out.contains("\"name\":")
}

test "std.encoding — the field's own name no longer works once renamed" {
    let u = json.decode<ApiUser>("{{\"name\":\"alice\",\"age\":30}}") catch e => {
        assert e.message().contains("user_name")
        return
    }
    assert false
}

// E20
test "std.encoding — @default fills in for a missing key" {
    let u = json.decode<ApiUser>("{{\"user_name\":\"alice\",\"age\":30}}") catch e => {
        assert false
        return
    }
    assert u.role == "user"
}

test "std.encoding — a present key beats the @default" {
    let u = json.decode<ApiUser>("{{\"user_name\":\"a\",\"age\":1,\"role\":\"admin\"}}") catch e => {
        assert false
        return
    }
    assert u.role == "admin"
}

// E19
test "std.encoding — @skip keeps a field out of the encoded object" {
    let u = json.decode<ApiUser>("{{\"user_name\":\"a\",\"age\":1}}") catch e => {
        assert false
        return
    }
    assert !json.encode(u).contains("cache_key")
}

// A skipped field still has to hold something usable — zeroed bytes are not an
// empty string, and a null pointer is not an empty Vec.
test "std.encoding — a skipped field decodes to its type's empty value" {
    let s = json.decode<Skipped>("{{\"id\":5}}") catch e => {
        assert false
        return
    }
    assert s.id == 5
    assert s.note == ""
    assert s.note.len() == 0
    assert s.tags.len() == 0
    assert s.seen is none
}

// E19 again, from the type-system side: a field that can't be serialized would
// disqualify the whole struct, but a skipped one never reaches the wire, so it
// doesn't get a vote. Without this, `@skip` was advice the checker ignored.
trait Opaque {
    func tag(self) -> i64
}

struct Marker {
    public v: i64
}

extend Marker with Opaque {
    func tag(self) -> i64 { return self.v }
}

struct HasOpaque {
    @skip
    public probe: any Opaque

    public n: i64
}

test "std.encoding — a @skip field doesn't block Encode/Decode" {
    let h = json.decode<HasOpaque>("{{\"n\":3}}") catch e => {
        assert false
        return
    }
    assert h.n == 3
    assert json.encode(h) == "{{\"n\":3}}"
}
