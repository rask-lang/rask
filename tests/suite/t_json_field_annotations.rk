// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Field annotations on the JSON path: @rename, @no_serialize, @default
// (std.encoding/E18–E20, std.json/J8–J9).
//
// These decide both what a decode looks for and what an encode writes, so each
// one is checked in both directions. `{` opens interpolation, hence the doubled
// braces in the JSON literals.
//
// `@no_serialize` was `@skip` until E19 renamed it — "skip from what?" had no
// answer, and the field-level concept is "not part of this type's serialized
// form, either direction". The old spelling is a compile error rather than a
// silent no-op, because left alone it reads as excluded and serializes the
// field anyway (#603).

import json

struct ApiUser {
    @rename("user_name")
    public name: string

    public age: i64

    @default("user")
    public role: string

    @no_serialize
    public cache_key: string = ""
}

// E13a: an excluded field takes its declared default on decode. Without one the
// type isn't auto-`Decode` at all — zero-initialization is never automatic
// (type.structs/FD4), and these are the values the decode has to come up with.
struct Skipped {
    public id: i64

    @no_serialize
    public note: string = ""

    @no_serialize
    public tags: Vec<string> = Vec.new()

    @no_serialize
    public seen: i64? = none
}

// E18
test "std.encoding — @rename decides the key a field decodes from" {
    let u = json.decode<ApiUser>("{{\"user_name\":\"alice\",\"age\":30}}") catch e => {
        assert false
        return
    }
    assert u.name == "alice"
    assert u.age == 30
}

test "std.encoding — @rename decides the key a field encodes to" {
    let u = json.decode<ApiUser>("{{\"user_name\":\"alice\",\"age\":30}}") catch e => {
        assert false
        return
    }
    let out = json.encode(u)
    assert out.contains("\"user_name\":\"alice\"")
    assert !out.contains("\"name\":")
}

test "std.encoding — the field's own name no longer works once renamed" {
    let u = json.decode<ApiUser>("{{\"name\":\"alice\",\"age\":30}}") catch e => {
        assert e.message().contains("user_name")
        return
    }
    assert false
}

// E20
test "std.encoding — @default fills in for a missing key" {
    let u = json.decode<ApiUser>("{{\"user_name\":\"alice\",\"age\":30}}") catch e => {
        assert false
        return
    }
    assert u.role == "user"
}

test "std.encoding — a present key beats the @default" {
    let u = json.decode<ApiUser>("{{\"user_name\":\"a\",\"age\":1,\"role\":\"admin\"}}") catch e => {
        assert false
        return
    }
    assert u.role == "admin"
}

// E19
test "std.encoding — @no_serialize keeps a field out of the encoded object" {
    let u = json.decode<ApiUser>("{{\"user_name\":\"a\",\"age\":1}}") catch e => {
        assert false
        return
    }
    assert !json.encode(u).contains("cache_key")
}

// A skipped field still has to hold something usable — zeroed bytes are not an
// empty string, and a null pointer is not an empty Vec. E13a says where the
// value comes from: the field's declared default.
test "std.encoding — a skipped field decodes to its declared default" {
    let s = json.decode<Skipped>("{{\"id\":5}}") catch e => {
        assert false
        return
    }
    assert s.id == 5
    assert s.note == ""
    assert s.note.len() == 0
    assert s.tags.len() == 0
    assert s.seen is none
}

// E19 again, from the type-system side: a field that can't be serialized would
// disqualify the whole struct, but a skipped one never reaches the wire, so it
// doesn't get a vote. Without this, `@no_serialize` was advice the checker ignored.
trait Opaque {
    func tag(self) -> i64
}

struct Marker {
    public v: i64
}

extend Marker with Opaque {
    func tag(self) -> i64 { return self.v }
}

struct HasOpaque {
    @no_serialize
    public probe: any Opaque = Marker { v: 0 } as any Opaque

    public n: i64
}

test "std.encoding — a @no_serialize field doesn't block Encode/Decode" {
    let h = json.decode<HasOpaque>("{{\"n\":3}}") catch e => {
        assert false
        return
    }
    assert h.n == 3
    assert json.encode(h) == "{{\"n\":3}}"
}
