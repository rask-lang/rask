// Week one: nested data structures.
//
// The shapes real programs build: a Vec of structs each holding a Vec, a Map of
// Vecs, a Map of structs, a Vec of Vecs, a struct holding a Map, an enum with a
// struct payload, and reading and writing several levels down. This is where
// layout bugs show up, so each test both reads and writes at depth.

struct Item {
    name: string
    qty: i32
}

struct Order {
    id: i32
    items: Vec<Item>
}

struct Inventory {
    stock: Map<string, i32>
    orders: Vec<Order>
}

enum Node {
    Leaf(i32)
    Branch(Vec<i32>)
}

// The loop lives in the arm, which is where it reads best. `rask fmt` used to
// unwrap the arm's braces into `Branch(vs) => for v in vs { … }` and hand back
// source the parser rejects (#925) — every arm body was spanned from the `match`
// keyword, so the "did the source have braces?" test never saw one.
func node_value(n: Node) -> i32 {
    mut total = 0
    match n {
        Leaf(v) => total = v
        Branch(vs) => {
            for v in vs {
                total = total + v
            }
        }
    }
    return total
}

func total_qty(o: Order) -> i32 {
    mut sum = 0
    for it in o.items {
        sum = sum + it.qty
    }
    return sum
}

test "a struct holding a Vec of structs" {
    let o = Order {
        id: 1,
        items: [Item { name: "bolt", qty: 3 }, Item { name: "nut", qty: 5 }],
    }
    assert o.id == 1
    assert o.items.len() == 2
    assert o.items[0].name == "bolt"
    assert o.items[1].qty == 5
    assert total_qty(o) == 8
}

test "writing into a nested Vec element" {
    mut o = Order {
        id: 1,
        items: [Item { name: "bolt", qty: 3 }],
    }
    o.items[0].qty = 99
    assert o.items[0].qty == 99
    assert o.items[0].name == "bolt"
    o.items.push(Item { name: "nut", qty: 1 })
    assert o.items.len() == 2
    assert o.items[0].qty == 99
}

test "a Vec of Vecs" {
    let grid: Vec<Vec<i32>> = [[1, 2], [3, 4], [5, 6]]
    assert grid.len() == 3
    assert grid[0].len() == 2
    assert grid[1][1] == 4
    assert grid[2][0] == 5
    mut total = 0
    for row in grid {
        for cell in row {
            total = total + cell
        }
    }
    assert total == 21
}

test "writing into a Vec of Vecs" {
    mut grid: Vec<Vec<i32>> = [[1, 2], [3, 4]]
    grid[0][1] = 99
    assert grid[0][1] == 99
    assert grid[0][0] == 1
    assert grid[1][0] == 3
    grid[1].push(5)
    assert grid[1].len() == 3
}

test "a Map of Vecs" {
    mut m: Map<string, Vec<i32>> = Map.new()
    let a: Vec<i32> = [1, 2]
    let b: Vec<i32> = [3]
    m.insert("a", a)
    m.insert("b", b)
    assert m.len() == 2
    assert m.get("a")!.len() == 2
    assert m.get("a")![1] == 2
    assert m.get("b")![0] == 3
}

test "a Map of structs" {
    mut m: Map<string, Item> = Map.new()
    m.insert("bolt", Item { name: "bolt", qty: 3 })
    m.insert("nut", Item { name: "nut", qty: 5 })
    assert m.get("bolt")!.qty == 3
    assert m.get("nut")!.name == "nut"
    assert m.get("zzz") is none
}

test "a struct holding a Map" {
    mut stock: Map<string, i32> = Map.new()
    stock.insert("bolt", 10)
    let inv = Inventory { stock: stock, orders: Vec.new() }
    assert inv.stock.len() == 1
    assert inv.stock.get("bolt")! == 10
    assert inv.orders.is_empty()
}

test "three levels: struct, Vec, struct, field" {
    let inv = Inventory {
        stock: Map.new(),
        orders: [
            Order { id: 1, items: [Item { name: "a", qty: 1 }] },
            Order { id: 2, items: [Item { name: "b", qty: 2 }, Item { name: "c", qty: 3 }] },
        ],
    }
    assert inv.orders.len() == 2
    assert inv.orders[1].items.len() == 2
    assert inv.orders[1].items[1].name == "c"
    assert inv.orders[1].items[1].qty == 3
    mut grand = 0
    for o in inv.orders {
        grand = grand + total_qty(o)
    }
    assert grand == 6
}

test "writing three levels down" {
    mut inv = Inventory {
        stock: Map.new(),
        orders: [Order { id: 1, items: [Item { name: "a", qty: 1 }] }],
    }
    inv.orders[0].items[0].qty = 42
    assert inv.orders[0].items[0].qty == 42
    assert inv.orders[0].items[0].name == "a"
    assert inv.orders[0].id == 1
}

// The Vec is bound first: an array literal fills a `Vec<T>` slot in a struct
// field or a function argument, but not in an enum payload (#922, which also has
// expected/found swapped in its message).
test "an enum with a collection payload" {
    let leaf = Node.Leaf(7)
    assert leaf is Leaf
    let ns: Vec<i32> = [1, 2, 3]
    let branch = Node.Branch(ns)
    assert node_value(branch) == 6
    assert node_value(Node.Leaf(7)) == 7
}

test "a Vec of enums with collection payloads" {
    let pair: Vec<i32> = [2, 3]
    let nodes: Vec<Node> = [Node.Leaf(1), Node.Branch(pair), Node.Leaf(4)]
    assert nodes.len() == 3
    mut total = 0
    for n in nodes {
        total = total + node_value(n)
    }
    assert total == 10
}

test "a nested optional inside a collection" {
    mut names: Vec<string?> = Vec.new()
    names.push("ada")
    names.push(none)
    names.push("bo")
    assert names.len() == 3
    assert names[0]! == "ada"
    assert names[1] is none
    mut present = 0
    for n in names {
        if n? {
            present = present + 1
        }
    }
    assert present == 2
}

test "building nested data in a loop" {
    mut grid: Vec<Vec<i32>> = Vec.new()
    for r in 0..3 {
        mut row: Vec<i32> = Vec.new()
        for c in 0..3 {
            row.push(r * 3 + c)
        }
        grid.push(row)
    }
    assert grid.len() == 3
    assert grid[0][0] == 0
    assert grid[2][2] == 8
    assert grid[1][2] == 5
}

func main() {}
