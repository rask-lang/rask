// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Calling a closure that came out of a collection (#869).
//
// `for f in fs { f(5) }` over a `Vec<func(i64) -> i64>` didn't compile:
//
//     error: MIR lowering 'main': couldn't work out a type here, so there's
//     nothing safe to compile … Gave up in: lower/expr:1156
//
// while `let g = fs[0]` two lines away was fine, and the interpreter ran both.
//
// A `let`/`mut` binding registers itself as holding a closure when the checker
// types its initializer as a function, which is what makes the call site emit an
// indirect call instead of looking for a function by that name. A `for` binding
// didn't, so `f(5)` lowered as a call to a *function named `f`*, found no
// signature for it, and gave up on the return type.
//
// Calling a *closure parameter* that holds a function was the same gap one level
// down (#870), and needed the registration in two more places: an inlined
// adapter closure over a Vec of functions, and a synthesized closure whose
// parameter is declared as a function type.

func twice(x: i64) -> i64 {
    return x * 2
}

func thrice(x: i64) -> i64 {
    return x * 3
}

test "closures in a Vec — indexed out and called" {
    mut fs: Vec<func(i64) -> i64> = Vec.new()
    fs.push(|x| {
        return x * 2
    })
    assert_eq(fs.len(), 1)
    let g = fs[0]
    assert_eq(g(5), 10)
}

test "closures in a Vec — iterated and called" {
    mut fs: Vec<func(i64) -> i64> = Vec.new()
    fs.push(|x| {
        return x * 2
    })
    fs.push(|x| {
        return x * 3
    })
    mut out: Vec<i64> = Vec.new()
    for f in fs {
        out.push(f(5))
    }
    assert_eq(out.join(","), "10,15")
}

// Named functions go in the same slot as closures, and come back out callable.
test "closures in a Vec — named functions too" {
    mut fs: Vec<func(i64) -> i64> = Vec.new()
    fs.push(twice)
    fs.push(thrice)
    mut total = 0
    for f in fs {
        total = total + f(10)
    }
    assert_eq(total, 50)
}

// The element type has to survive `.iter()`, which is a different lowering path
// from a bare `for` over the collection.
test "closures in a Vec — through iter()" {
    mut fs: Vec<func(i64) -> i64> = Vec.new()
    fs.push(|x| {
        return x + 1
    })
    fs.push(|x| {
        return x + 2
    })
    mut out: Vec<i64> = Vec.new()
    for f in fs.iter() {
        out.push(f(0))
    }
    assert_eq(out.join(","), "1,2")
}

// #870: `f` is the adapter closure's own parameter, holding a function. The
// adapter path inlines the body rather than synthesizing a closure, so it needs
// its own registration.
test "closures in a Vec — an adapter closure can call its parameter" {
    mut fs: Vec<func(i64) -> i64> = Vec.new()
    fs.push(|x| {
        return x * 2
    })
    fs.push(|x| {
        return x * 5
    })
    mut total = 0
    for n in fs.map(|f| {
        return f(3)
    }) {
        total = total + n
    }
    assert_eq(total, 21)
}

// #870 again, the other shape: a closure whose parameter is *declared* as a
// function type. This one is synthesized rather than inlined.
test "closures — a declared function parameter is callable" {
    let call_with = |g: func(i64) -> i64| {
        return g(5)
    }
    let double = |x| {
        return x * 2
    }
    assert_eq(call_with(double), 10)
    assert_eq(call_with(twice), 10)
    assert_eq(call_with(thrice), 15)
}

test "closures in a Vec — an empty Vec iterates zero times" {
    let fs: Vec<func(i64) -> i64> = Vec.new()
    mut calls = 0
    for f in fs {
        calls = calls + f(1)
    }
    assert_eq(calls, 0)
}

func main() {}
