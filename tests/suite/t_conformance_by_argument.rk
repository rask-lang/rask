// type.generics/GT7 — one generic interface, two conformances on one type, and
// the call's arguments pick which. The operator rule (OR1), for any interface.

interface Render<F> {
    func render(self, f: F) -> string
}

struct Html {
    level: i64
}

struct Json {
    pretty: bool
}

struct Report {
    title: string
}

Report implements Render<Html> {
    func render(self, f: Html) -> string {
        return "<h{f.level}>{self.title}</h{f.level}>"
    }
}

Report implements Render<Json> {
    func render(self, f: Json) -> string {
        if f.pretty {
            return "title: {self.title}"
        }
        return "title:{self.title}"
    }
}

// A bound names the conformance itself.
func as_html<T: Render<Html>>(t: T) -> string {
    return t.render(Html(level: 2))
}

// A generic receiver picks the same way.
struct Boxed<T> {
    inner: T
}

Boxed<T> implements Render<Html> {
    func render(self, f: Html) -> string {
        return "boxed h{f.level}"
    }
}

Boxed<T> implements Render<Json> {
    func render(self, f: Json) -> string {
        return "boxed json"
    }
}

// Both literal kinds, and a direct call picked by its argument.
struct Ticks {
    n: i64
}

Ticks implements FromLiteral<i64> {
    comptime func from_literal(value: i64) -> Ticks {
        return Ticks(n: value * 60)
    }
}

Ticks implements FromLiteral<f64> {
    comptime func from_literal(value: f64) -> Ticks {
        return Ticks(n: (value * 60.0).to_int())
    }
}

test "GT7 — the argument's type picks the conformance" {
    let r = Report(title: "q3")
    assert r.render(Html(level: 1)) == "<h1>q3</h1>"
    assert r.render(Json(pretty: false)) == "title:q3"
}

test "GT7 — a bound reaches the conformance it names" {
    assert as_html(Report(title: "x")) == "<h2>x</h2>"
}

test "GT7 — a generic receiver" {
    let b = Boxed(inner: 5)
    assert b.render(Html(level: 3)) == "boxed h3"
    assert b.render(Json(pretty: true)) == "boxed json"
}

test "GT7 — FromLiteral<i64> and FromLiteral<f64> on one type" {
    let a: Ticks = 2
    let b: Ticks = 0.5
    assert a.n == 120
    assert b.n == 30
    let c = Ticks.from_literal(3)
    let d = Ticks.from_literal(1.5)
    assert c.n == 180
    assert d.n == 90
}

// A bound whose argument is the type parameter itself, written out or as the
// `Rhs = Self` default. One conformance: the plain name, nothing filed.
interface Combine<Rhs = Self> {
    func combine(self, other: Rhs) -> i64
}

struct Thing {
    n: i64
}

Thing implements Combine {
    func combine(self, other: Thing) -> i64 {
        return self.n + other.n
    }
}

func comb<T: Combine>(t: T, u: T) -> i64 {
    return t.combine(u)
}

func both<T: Render<Html> + Render<Json>>(t: T) -> string {
    return "{t.render(Html(level: 7))}|{t.render(Json(pretty: true))}"
}

// An argument converts the way any call's does: an integer literal into an
// f64, a value into its optional.
interface Scale<K> {
    func scale(self, k: K) -> i64
}

struct Meter {
    v: i64
}

Meter implements Scale<f64> {
    func scale(self, k: f64) -> i64 {
        return (self.v.to_float() * k).to_int()
    }
}

Meter implements Scale<Html?> {
    func scale(self, k: Html?) -> i64 {
        return k?.level ?? -1
    }
}

// A nominal type built from literals.
type Cents = i64

Cents implements FromLiteral<i64> {
    comptime func from_literal(value: i64) -> Cents {
        return Cents(value * 100)
    }
}

Cents implements FromLiteral<f64> {
    comptime func from_literal(value: f64) -> Cents {
        return Cents((value * 100.0).to_int())
    }
}

test "GT7 — a bound argument that is the type parameter" {
    assert comb(Thing(n: 1), Thing(n: 3)) == 4
}

test "GT7 — two bounds of one interface, picked by argument" {
    assert both(Report(title: "q")) == "<h7>q</h7>|title: q"
}

test "GT7 — arguments convert as in any call" {
    let m = Meter(v: 3)
    assert m.scale(2) == 6
    assert m.scale(Html(level: 4)) == 4
}

test "GT7 — a nominal type with both literal conversions" {
    let a: Cents = 3
    let b: Cents = 1.25
    assert a.value == 300
    assert b.value == 125
}

// `T` and `Vec<T>` can never be one type, so these two don't overlap.
struct Shelf<T> {
    item: T
}

Shelf<T> implements Render<T> {
    func render(self, f: T) -> string {
        return "one"
    }
}

Shelf<T> implements Render<Vec<T>> {
    func render(self, f: Vec<T>) -> string {
        return "many {f.len()}"
    }
}

// A literal goes where it fits: 300 isn't a u8.
interface Weigh<K> {
    func weigh(self, k: K) -> string
}

struct Balance {
    n: i64
}

Balance implements Weigh<u8> {
    func weigh(self, k: u8) -> string {
        return "u8"
    }
}

Balance implements Weigh<i64> {
    func weigh(self, k: i64) -> string {
        return "i64"
    }
}

test "GT7 — conformances that never meet" {
    let s: Shelf<i64> = Shelf(item: 1)
    assert s.render(5i64) == "one"
    let v: Vec<i64> = Vec.from([1, 2])
    assert s.render(v) == "many 2"
}

test "GT7 — a literal's magnitude rules a conformance out" {
    let s = Balance(n: 0)
    assert s.weigh(300) == "i64"
    assert s.weigh(7u8) == "u8"
}
