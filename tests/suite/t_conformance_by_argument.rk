// type.generics/GT7 — one generic interface, two conformances on one type, and
// the call's arguments pick which. The operator rule (OR1), for any interface.

interface Render<F> {
    func render(self, f: F) -> string
}

struct Html {
    level: i64
}

struct Json {
    pretty: bool
}

struct Report {
    title: string
}

Report implements Render<Html> {
    func render(self, f: Html) -> string {
        return "<h{f.level}>{self.title}</h{f.level}>"
    }
}

Report implements Render<Json> {
    func render(self, f: Json) -> string {
        if f.pretty {
            return "title: {self.title}"
        }
        return "title:{self.title}"
    }
}

// A bound names the conformance itself.
func as_html<T: Render<Html>>(t: T) -> string {
    return t.render(Html(level: 2))
}

// A generic receiver picks the same way.
struct Boxed<T> {
    inner: T
}

Boxed<T> implements Render<Html> {
    func render(self, f: Html) -> string {
        return "boxed h{f.level}"
    }
}

Boxed<T> implements Render<Json> {
    func render(self, f: Json) -> string {
        return "boxed json"
    }
}

// Both literal kinds, and a direct call picked by its argument.
struct Ticks {
    n: i64
}

Ticks implements FromLiteral<i64> {
    comptime func from_literal(value: i64) -> Ticks {
        return Ticks(n: value * 60)
    }
}

Ticks implements FromLiteral<f64> {
    comptime func from_literal(value: f64) -> Ticks {
        return Ticks(n: (value * 60.0).to_int())
    }
}

test "GT7 — the argument's type picks the conformance" {
    let r = Report(title: "q3")
    assert r.render(Html(level: 1)) == "<h1>q3</h1>"
    assert r.render(Json(pretty: false)) == "title:q3"
}

test "GT7 — a bound reaches the conformance it names" {
    assert as_html(Report(title: "x")) == "<h2>x</h2>"
}

test "GT7 — a generic receiver" {
    let b = Boxed(inner: 5)
    assert b.render(Html(level: 3)) == "boxed h3"
    assert b.render(Json(pretty: true)) == "boxed json"
}

test "GT7 — FromLiteral<i64> and FromLiteral<f64> on one type" {
    let a: Ticks = 2
    let b: Ticks = 0.5
    assert a.n == 120
    assert b.n == 30
    let c = Ticks.from_literal(3)
    let d = Ticks.from_literal(1.5)
    assert c.n == 180
    assert d.n == 90
}
