// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A box in a variable that a closure, or the body of a `for` over a sequence,
// reaches by address.
//
// Such a variable lives in a stack slot, and its value is stored into the slot
// rather than assigned. The drop pass read that store as the box leaving the
// frame, so nobody freed it. A closure writing a new box over the variable
// also left the old one behind. The strings are long enough to live on the
// heap.

import sequence.Sequence

interface Shape {
    func name(self) -> string
}

struct Circle { tag: string }
Circle implements Shape {
    func name(self) -> string { return self.tag }
}

func nums() -> Sequence<i64> {
    return |yield| {
        for i in 0..4 {
            if !yield(i) { return }
        }
    }
}

func long(n: i64) -> string {
    return "long-heap-string-number-{n}-padded-past-inline"
}

func read_in_loop() -> i64 {
    let s: any Shape = Circle(tag: long(1))
    mut n = 0
    for a in nums() {
        n += s.name().len().to<i64>()!
    }
    return n
}

func read_in_closure() -> string {
    let s: any Shape = Circle(tag: long(2))
    let f = || s.name()
    return f()
}

func reassigned_after() -> string {
    mut s: any Shape = Circle(tag: long(3))
    let f = || s.name()
    let first = f()
    s = Circle(tag: long(4))
    return "{first} {s.name()}"
}

func swapped_in_loop() -> string {
    mut s: any Shape = Circle(tag: long(5))
    for a in nums() {
        if a == 2 { s = Circle(tag: long(a + 10)) }
    }
    return s.name()
}

func swapped_by_closure() -> string {
    mut s: any Shape = Circle(tag: long(6))
    let swap = || { s = Circle(tag: long(7)) }
    swap()
    return s.name()
}

test "a box read by a loop body" {
    assert read_in_loop() == 4 * long(1).len().to<i64>()!
}

test "a box read by a closure" {
    assert read_in_closure() == long(2)
}

test "a captured box written over by its own frame" {
    assert reassigned_after() == "{long(3)} {long(4)}"
}

test "a captured box written over by a loop body" {
    assert swapped_in_loop() == long(12)
}

test "a captured box written over by a closure" {
    assert swapped_by_closure() == long(7)
}
