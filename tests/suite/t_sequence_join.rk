// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `join` straight off a sequence, with no adapter in between (#878).
//
//     println("{s.split(", ").join("|")}")
//     error: codegen 'main': Function not found: Iterator_join
//
// The interpreter ran it, and `s.split(", ").to_vec().join("|")` — two
// characters longer — compiled. The materializing lowering was gated on the
// chain having at least one adapter, because it also matches a bare `Vec`, and
// `Vec.join` has to keep answering for itself: it picks the right runtime by
// element type, so sending `Vec<i64>.join(", ")` down the materializing path
// printed nothing at all.
//
// Asked the other way round — "is this source a sequence?" — instead of "is it
// not a Vec?", which answers yes whenever the type simply wasn't recorded.

test "sequence join — split with no adapter" {
    let s = "a, b, c"
    assert_eq(s.split(", ").join("|"), "a|b|c")
}

test "sequence join — the other string splitters" {
    assert_eq("x y z".split_whitespace().join("+"), "x+y+z")
    assert_eq("l1\nl2".lines().join("/"), "l1/l2")
}

// The case the gate was protecting. A Vec answers `join` itself, and for a
// non-string element type the runtime converts — materializing it first lost
// that.
test "sequence join — a Vec keeps answering for itself" {
    mut ns: Vec<i64> = Vec.new()
    ns.push(1)
    ns.push(2)
    assert_eq(ns.join(", "), "1, 2")

    let ss: Vec<string> = ["a", "b"]
    assert_eq(ss.join("-"), "a-b")
}

test "sequence join — a chain with adapters still fuses" {
    let ss: Vec<string> = ["a", "b"]
    assert_eq(ss.map(|x| {
        return x.to_uppercase()
    }).join(","), "A,B")

    mut ns: Vec<i64> = Vec.new()
    ns.push(1)
    ns.push(2)
    ns.push(3)
    assert_eq(ns.filter(|x| {
        return x > 1
    }).map(|x| {
        return "n{x}"
    }).join(","), "n2,n3")
}

test "sequence join — the long way round agrees" {
    let s = "a, b, c"
    assert_eq(s.split(", ").to_vec().join("|"), s.split(", ").join("|"))
}

test "sequence join — an empty separator and a single element" {
    assert_eq("abc".split(", ").join("|"), "abc")
    assert_eq("a, b".split(", ").join(""), "ab")
}

func main() {}
