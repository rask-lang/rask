// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `comptime test` runs during compilation and is reported, not re-run
// (std.testing/T11, T11a).
//
// `is_comptime` was parsed and then ignored: the block was collected by the
// runner and executed at run time like any other test, so `rask check` on a
// failing one exited 0. Now the pipeline runs it and a failure is a compile
// error (E0848) — see tests/compile_errors/comptime_test_failure.rk for that
// half. This file is the green half: the result reaches the report, once, and
// reads the same on both backends.

comptime func factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

comptime func sum_to(n: i64) -> i64 {
    mut total = 0
    mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

comptime test "factorial" {
    assert factorial(5) == 120
    assert factorial(0) == 1
}

comptime test "sum to ten" {
    assert sum_to(10) == 55
}

// A runtime test in the same file: the two kinds coexist, and the comptime
// results are listed alongside the ones the runner produced.
test "runtime arithmetic" {
    assert 2 + 2 == 4
}
