// SPDX-License-Identifier: (MIT OR Apache-2.0)
// #1021 — `join` on a fixed-size array of strings. Reading elements out of the
// same array is fine natively, and the same strings in a `Vec` join fine, so
// it's `join`'s receiver handling that's wrong: an array base pointer where a
// Vec header is expected. Empty result in the small case, SIGSEGV once a few
// element reads precede it.
//
// Related but distinct from #1000, which is module-level `const` arrays — this
// one is a plain local, and its element reads work.

test "elements of a local string array read back" {
    let arr = ["a", "b"]
    assert arr.len() == 2u64
    assert arr[0] == "a"
    assert arr[1] == "b"
}

test "the same strings join fine through a Vec" {
    let v: Vec<string> = ["a", "b"].iter().to_vec()
    assert v.join("-") == "a-b"
}

test "join on the array itself" {
    let arr = ["a", "b"]
    assert arr.join("-") == "a-b"
}

// An array packs scalars at their natural stride; a Vec keeps them in 8-byte
// slots and reads a whole word per element. Handing the array's buffer over
// unchanged made the two disagree — `[1, 2, 3]` joined as
// `8589934593,12884901890,3`, where 8589934593 is `(2<<32)|1`: two elements
// read as one. Flagged from #1054 while both branches were fixing #1021.
test "join on an array of narrower-than-word elements" {
    let ints: [i32; 3] = [1, 2, 3]
    assert ints.join(",") == "1,2,3"
    let small: [u8; 2] = [7, 8]
    assert small.join("-") == "7-8"
}

// The two ends of the loop, where an off-by-one in the copy would show.
test "join on an empty and a single-element array" {
    let empty: [string; 0] = []
    assert empty.join("-") == ""
    let one = ["solo"]
    assert one.join("-") == "solo"
    let one_int: [i32; 1] = [42]
    assert one_int.join(",") == "42"
}
