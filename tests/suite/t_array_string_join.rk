// SPDX-License-Identifier: (MIT OR Apache-2.0)
// #1021 — `join` on a fixed-size array of strings.
//
// A `Vec<string>` stores each RaskStr inline; a `[string; N]` stores a pointer
// to one per slot (`MirType::stored_inline_in_array`). `join` goes to the Vec
// runtime either way, so on an array it reads the element slots as RaskStr
// values and gets the pointer's own bytes back as inline characters — an empty
// string in the quiet case, a segfault once a few element reads have happened
// first.
//
// The fix is in PR #1057, which makes a string inline in its array slot rather
// than a pointer to it — the root of the same problem, and it closes #1000 as
// well. This branch had a narrower one (array-specific join entry points that
// dereference the slot) and dropped it: the two are incompatible, and merged
// they crash, because the dereference reads an inline RaskStr's first eight
// bytes as a pointer.
//
// Related but distinct from #1000, which is module-level `const` arrays — this
// one is a plain local, and its element reads always worked.

test "elements of a local string array read back" {
    let arr = ["a", "b"]
    assert arr.len() == 2u64
    assert arr[0] == "a"
    assert arr[1] == "b"
}

test "the same strings join fine through a Vec" {
    let v: Vec<string> = ["a", "b"].iter().to_vec()
    assert v.join("-") == "a-b"
}

test "join on the array itself" {
    let arr = ["a", "b"]
    assert arr.join("-") == "a-b"
}

test "join on an array of integers uses the array's element width" {
    // `[1, 2, 3]` is i32. The integer join read eight bytes at a four-byte
    // stride, so each pair of elements came back packed into one number.
    let nums = [1, 2, 3]
    assert nums.join(",") == "1,2,3"
}

test "join on an empty array is the empty string" {
    let empty: [string; 0] = []
    assert empty.join("-") == ""
}

test "join on a one-element array has no separator" {
    let one = ["ab"]
    assert one.join("-") == "ab"
}
