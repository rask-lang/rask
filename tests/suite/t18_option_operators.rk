// Option operators: none literal, x! force unwrap, ?? fallback,
// ?. chaining, try on Option, auto-wrap.
//
// Spec: type.optionals (OPT1-OPT26)

// --- none literal (OPT9) ---

func returns_none() -> i32? {
    return none
}

test "none literal" {
    let x: i32? = none
    assert x is none

    let y = returns_none()
    assert y is none
}

// --- force unwrap x! (OPT14) ---

test "force unwrap present" {
    let x: i32? = 42
    assert x! == 42
}

test "force unwrap" {
    let inner: i32? = 10
    assert inner! == 10
}

// --- value fallback ?? (OPT12) ---

test "fallback with none" {
    let x: i32? = none
    assert (x ?? 99) == 99
}

test "fallback with present" {
    let x: i32? = 42
    assert (x ?? 99) == 42
}

test "fallback short-circuits" {
    let x: i32? = 1
    assert (x ?? 999) == 1
}

// --- optional chaining ?. (OPT11) ---

struct Profile {
    name: string
    age: i32
}

struct User {
    profile: Profile?
}

func get_user(has_profile: bool) -> User? {
    if has_profile {
        let p: Profile? = Profile { name: "Alice", age: 30 }
        return User { profile: p }
    }
    return none
}

test "optional chaining present path" {
    let user = get_user(true)
    let name = user?.profile?.name
    assert name?
    assert name! == "Alice"
}

test "optional chaining absent short-circuits" {
    let user = get_user(false)
    let name = user?.profile?.name
    assert name is none
}

test "optional chaining on none field" {
    let p: Profile? = none
    let user: User? = User { profile: p }
    let name = user?.profile?.name
    assert name is none
}

// --- auto-wrap T to T? (OPT5) ---

func maybe_value() -> i32? {
    return 42
}

test "auto-wrap T to T?" {
    let x = maybe_value()
    assert x?
    assert x! == 42
}

// --- try on Option (OPT15, OPT18) ---

func inner_option() -> i32? {
    return 10
}

func outer_option() -> i32? {
    let val = try inner_option()
    return val * 2
}

func try_propagates_none() -> i32? {
    let val = try returns_none()
    return val + 1
}

test "try on Option extracts" {
    let result = outer_option()
    assert result?
    assert result! == 20
}

test "try on Option propagates none" {
    let result = try_propagates_none()
    assert result is none
}

// --- The wrapper has no methods; the bind does the work (#599) ---

test "transform the payload through the bind" {
    let x: i32? = 5
    let y = if x? as v { v * 2 } else { 0 }
    assert y == 10
}

test "an absent value never reaches the transform" {
    let x: i32? = none
    let y = if x? as v { v * 2 } else { 0 }
    assert y == 0
}

test "a condition on the payload is an ordinary if" {
    let x: i32? = 10
    mut y: i32? = none
    if x? as v {
        if v > 5 { y = v }
    }
    assert y! == 10
}

test "and it rejects when the condition fails" {
    let x: i32? = 3
    mut y: i32? = none
    if x? as v {
        if v > 5 { y = v }
    }
    assert y is none
}

// --- Binding, not narrowing (OPT19) ---

test "the payload comes from the `as` bind" {
    let opt: i32? = 42
    if opt? as v {
        assert v == 42
    } else {
        assert false, "expected present"
    }
}

// Match on an optional is rejected; the operator form is the idiom.
test "operator-form branch" {
    let x: i32? = 7
    let result = if x? as v { v * 2 } else { 0 }
    assert result == 14
}

func main() {}
