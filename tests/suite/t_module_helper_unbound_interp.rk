// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A stdlib function imported by name, in a program that never imports its
// module. `fs.create_file`'s body calls `fs.create_handle(path)`, and the
// stream methods call `io.read_std_bytes(...)`.
//
// The interpreter runs those bodies against this program's imports, where
// `fs` and `io` aren't bound, and fails with "undefined variable
// `create_handle`" / "`read_std_bytes`" (#1602). Adding `import fs`
// makes it pass. Native is right.

import fs.{create_file, open, read_text, remove_file}
import io.{stdin, IoError}
import os

func fresh_dir() -> string {
    let out = os.Command.new("mktemp").arg("-d").run()!
    return out.stdout.trim().to_string()
}

func write_through_handle(p: string, text: string) -> void or IoError {
    let w = try create_file(p)
    ensure w.close()
    try w.write_text(text)
    return
}

func read_through_handle(p: string) -> string or IoError {
    let r = try open(p)
    ensure r.close()
    return try r.read_text()
}

test "create_file and open without `import fs`" {
    let dir = fresh_dir()
    let p = "{dir}/h.txt"
    write_through_handle(p, "via handle")!
    assert read_through_handle(p)! == "via handle"
    assert read_text(p)! == "via handle"
    remove_file(p)!
    let _ = os.Command.new("rm").arg("-rf").arg(dir).run()
}

test "Stdin.read_text without `import io`" {
    mut inp = stdin()
    ensure inp.close()
    assert inp.read_text()! == ""
}
