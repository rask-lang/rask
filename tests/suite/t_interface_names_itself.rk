// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// An interface may name `any` of itself, or of an interface declared further
// down, in its own methods.
//
// The method signatures were read before the interface was in the table, so
// `any Shape` inside `Shape` named no declaration and no implementation's
// `func copy_out(self) -> any Shape` matched it: every conformance failed and
// every coercion to `any Shape` with it. That's what giving `any Registry` a
// clone method ran into.

interface Shape {
    func area(self) -> i64
    func copy_out(self) -> any Shape
    func label(self) -> any Label
}

interface Label {
    func text(self) -> string
}

struct Sq { side: i64 }
struct Tag { name: string }

Tag implements Label {
    func text(self) -> string {
        return self.name
    }
}

Sq implements Shape {
    func area(self) -> i64 {
        return self.side * self.side
    }

    func copy_out(self) -> any Shape {
        return Sq(side: self.side)
    }

    func label(self) -> any Label {
        return Tag(name: "square-with-a-long-enough-label-{self.side}")
    }
}

func make(side: i64) -> any Shape {
    return Sq(side: side)
}

test "a method returns any of its own interface" {
    let s = make(3)
    let t = s.copy_out()
    assert t.area() == 9
    assert s.area() == 9
}

test "a method returns any of an interface declared below" {
    let s = make(4)
    assert s.label().text() == "square-with-a-long-enough-label-4"
}

// The box a vtable call hands back is the caller's to free. Only a box built
// in this frame or returned by a named function was, so every `s.label()`
// on an `any Shape` leaked the label.
struct Refused { why: string }

extend Refused {
    func message(self) -> string {
        return self.why
    }
}

interface Maker {
    func make(self, n: i64) -> any Label or Refused
}

struct Tagger { prefix: string }

Tagger implements Maker {
    func make(self, n: i64) -> any Label or Refused {
        if n < 0 {
            return Refused(why: "negative-and-long-enough-to-be-on-the-heap")
        }
        return Tag(name: "{self.prefix}-{n}-padded-past-the-inline-length")
    }
}

func tagger() -> any Maker {
    return Tagger(prefix: "t")
}

test "a label a vtable call handed back is freed" {
    let s = make(5)
    for i in 0..3 {
        let l = s.label()
        assert l.text().len() > 0
    }
}

test "a boxed label behind a vtable call's error side" {
    let m = tagger()
    let l = try m.make(2)
    assert l.text() == "t-2-padded-past-the-inline-length"
    assert m.make(-1) is Refused
}
