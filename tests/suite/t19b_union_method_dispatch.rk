// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Union errors — `T or (A | B)`. Split out of t19 when this was the KNOWN-FAIL
// witness; it passes on both backends now (#776).
//
// What was missing was a runtime discriminant. A union's members are nominally
// distinct types with nothing in their bytes to tell them apart, so a union in
// the Result's payload area is laid out `[member:8][member bytes]` and the index
// is written where the error is produced. Two things read it:
//
//   `r is ParseError` tests err-side *and* member index. It used to be answered
//   by the Result's own tag alone — first member name read as "is it Ok?", second
//   as "is it Err?" — so every failure claimed to be whichever member was listed
//   second. Silently. `union_error_member.rk` in the compile_run fixtures is the
//   sharper witness for that, with three members.
//
//   `e.message()` switches on the index and calls that member's own method. This
//   is the part that used to fail loudly: MIR lowering couldn't pick a target and
//   the whole file failed to compile on native.
//
// Still open: a function returning `i32 or (A | B)`, compiled alongside other
// code, has been seen to corrupt memory — every test passes but the process
// exits non-zero, order- and layout-dependent (#375).
//
// Spec: type.errors (ER4, ER31)
//

struct DivError {}

extend DivError {
    func message(self) -> string {
        return "division by zero"
    }
}

struct ParseError {
    detail: string
}

extend ParseError {
    func message(self) -> string {
        return "parse error: {self.detail}"
    }
}

func parse_number(s: string) -> i32 or ParseError {
    if s == "42" { return 42 }
    return ParseError { detail: "not a number" }
}

func safe_div(a: i32, b: i32) -> i32 or DivError {
    if b == 0 { return DivError {} }
    return a / b
}

func combined(s: string, b: i32) -> i32 or (ParseError | DivError) {
    let n = try parse_number(s)
    let result = try safe_div(n, b)
    return result
}

// --- Error union composition (ER31) ---

test "error union present path" {
    assert combined("42", 2)! == 21
}

test "error union parse error" {
    assert combined("bad", 2) is ParseError
}

test "error union div error" {
    assert combined("42", 0) is DivError
}

// --- shared-method dispatch (rask#211) ---
// Every `E` satisfies `Error` (ER4), so `e.message()` on a union
// `e: A | B` resolves by dispatching to whichever variant `e` holds.
func union_message(s: string, b: i32) -> string {
    let r = combined(s, b)
    if r is i32 as v {
        return "ok({v})"
    } else as e {
        return e.message()
    }
}

test "union error dispatches shared message()" {
    assert union_message("42", 2) == "ok(21)"
    assert union_message("bad", 2) == "parse error: not a number"
    assert union_message("42", 0) == "division by zero"
}

func main() {}
