// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A runtime-built string that leaves its local — into a struct field, or out of
// the function — has to keep its reference. Native dropped it at the local's
// last use, so the buffer was freed and the next allocation wrote over it
// (#501, #499). Only heap strings show it; anything ≤15 bytes is inline.

struct Body {
    public error: string
    public code: string
}

enum Fail { Bad }

extend Fail {
    func message(self) -> string {
        return "bad"
    }
}

func route(path: string) -> Body {
    return Body { error: "no route for {path}", code: "not_found" }
}

func encoded(n: i64) -> string or Fail {
    return "a fairly long string here {n}"
}

test "interpolated field of a returned struct" {
    const b = route("/nope")
    assert b.error == "no route for /nope"
    assert b.error.len() == 18
    assert b.code == "not_found"
}

test "interpolated field built in place" {
    const path = "/nope"
    const b = Body { error: "no route for {path}", code: "not_found" }
    assert b.error == "no route for /nope"
}

test "the field survives an intervening allocation" {
    const b = route("/nope")
    mut junk = ""
    for i in 0..8 {
        junk = "filler string number {i} padded out"
    }
    assert junk.len() > 0
    assert b.error == "no route for /nope"
}

test "string returned as a Result ok payload" {
    const r = encoded(1)
    if r? as body {
        assert body == "a fairly long string here 1"
        assert body.len() == 27
    } else {
        assert false, "expected a value"
    }
}
