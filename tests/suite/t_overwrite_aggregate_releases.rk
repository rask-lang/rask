// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Writing a whole array over a struct field, or an array or tuple through a
// `mutate` parameter, gives back the strings the old value held. Natively the
// release list for those stores left arrays out (and tuples, for the
// parameter), so each write leaked what it replaced. Releasing them was held
// back by two bugs that turned the leak into a use-after-free: a small Copy
// aggregate (`[string; 1]`) copied out of a place took no references of its
// own (#1876), and `let t = a` on a `mutate` array bound the caller's slot
// instead of copying it (#1877). The leak gate runs this file with
// RASK_LEAK_CHECK=1, and the memcheck gate runs it under valgrind.

struct Slots {
    v: [string; 2]
}

func mk(i: i64) -> string {
    return "item-{i}-long-enough-to-live-on-the-heap"
}

func reset(mutate v: [string; 2]) {
    v = [mk(5), mk(6)]
}

func retuple(mutate t: (string, string)) {
    t = (mk(7), mk(8))
}

test "an array written over a field" {
    mut s = Slots(v: [mk(1), mk(2)])
    s.v = [mk(3), mk(4)]
    assert s.v[1] == mk(4)
}

test "an array and a tuple written through mutate" {
    mut a = [mk(1), mk(2)]
    reset(mutate a)
    mut t = (mk(3), mk(4))
    retuple(mutate t)
    assert a[0] == mk(5)
    assert t.1 == mk(8)
}

test "an array of scalars has nothing to give back" {
    mut s = [1, 2, 3]
    s = [4, 5, 6]
    assert s[2] == 6
}

struct Grid {
    g: [[string; 1]; 2]
}

test "a new array built from the old one's small elements" {
    mut g = Grid(g: [[mk(1)], [mk(2)]])
    g.g = [g.g[1], g.g[0]]
    assert g.g[0][0] == mk(2)
    assert g.g[1][0] == mk(1)
}

struct Halves {
    t: ([string; 1], [string; 1])
}

test "a tuple swapped from its own halves" {
    mut h = Halves(t: ([mk(3)], [mk(4)]))
    h.t = (h.t.1, h.t.0)
    assert h.t.0[0] == mk(4)
    assert h.t.1[0] == mk(3)
}

struct One {
    one: [string; 1]
}

test "a small array copied from one field to another" {
    mut a = One(one: [mk(9)])
    mut c = One(one: [mk(10)])
    c.one = a.one
    a.one = [mk(11)]
    assert c.one[0] == mk(9)
    assert a.one[0] == mk(11)
}

func rotate(mutate v: [[string; 1]; 2]) {
    v = [v[1], v[0]]
}

test "rotating a mutate array from its own elements" {
    mut v = [[mk(1)], [mk(2)]]
    rotate(mutate v)
    assert v[0][0] == mk(2)
}

func touch(mutate a: [string; 2]) {
    a[0] = mk(9)
}

test "an element store through mutate reaches the caller and releases the old one" {
    mut a = [mk(3), mk(4)]
    touch(mutate a)
    assert a[0] == mk(9)
}

test "an element store into a local array" {
    mut a = [mk(3), mk(4)]
    let s = mk(9)
    a[0] = s
    assert a[0] == mk(9)
    assert s == mk(9)
}
