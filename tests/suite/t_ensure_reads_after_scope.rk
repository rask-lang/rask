// SPDX-License-Identifier: (MIT OR Apache-2.0)
// An `ensure` body can read a variable however many ensures there are and
// whatever the variable holds.
//
// Two ensures that both read `w` crashed natively: the analysis that places
// releases treated the ensure bodies as alternative ways out, so each body
// released `w` after reading it, and the second one read it freed. A value
// holding a rack was worse: it's released where its scope ends, and that was
// placed before any ensure body ran, so even one ensure read a freed rack.
// A plain `Vec` or `Map` had the first problem in a second pass, which frees
// a container kept in a slot at the end of every ensure body.

import memory.Rack

struct Names {
    list: Vec<string>
}

struct Room {
    name: string
}

struct World {
    rooms: Rack<Room>
}

func count(n: Names, mutate seen: Vec<u64>) {
    seen.push(n.list.len())
}

func room_names(w: World) -> string {
    mut out = ""
    for r in w.rooms.nodes() {
        out = "{out}[{r.name}]"
    }
    return out
}

func two_ensures(mutate seen: Vec<u64>) {
    mut n = Names(list: Vec.new())
    ensure count(n, mutate seen)
    ensure count(n, mutate seen)
    n.list.push("a string long enough to live on the heap")
    n.list.push("and another one just as long as the first")
}

func plain_containers(mutate seen: Vec<u64>) {
    mut v: Vec<string> = Vec.new()
    mut m: Map<string, i64> = Map.new()
    ensure seen.push(v.len() + m.len())
    ensure seen.push(v.len() + m.len())
    v.push("a heap string that is definitely long enough to allocate")
    m.insert("another key long enough to sit on the heap", 1)
}

func rack_in_ensure(mutate out: Vec<string>) {
    mut w = World(rooms: Rack.new())
    ensure out.push(room_names(w))
    w.rooms.insert(Room(name: "hall"))
    w.rooms.insert(Room(name: "cellar"))
}

test "two ensures read the same value" {
    mut seen: Vec<u64> = Vec.new()
    two_ensures(mutate seen)
    assert seen.len() == 2
    assert seen[0] == 2
    assert seen[1] == 2
}

test "an ensure reads a value holding a rack" {
    mut out: Vec<string> = Vec.new()
    rack_in_ensure(mutate out)
    assert out.len() == 1
    assert out[0].contains("[hall]")
    assert out[0].contains("[cellar]")
}

test "two ensures read a plain Vec and Map" {
    mut seen: Vec<u64> = Vec.new()
    plain_containers(mutate seen)
    assert seen.len() == 2
    assert seen[0] == 2
    assert seen[1] == 2
}
