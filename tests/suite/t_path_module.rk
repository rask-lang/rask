// SPDX-License-Identifier: (MIT OR Apache-2.0)
// The `path` module, natively (#851, #852).
//
// Two things stopped it working on native while the interpreter ran it fine:
//
//   path.Path.from("/a/b")     error: MIR lowering 'main':
//                              unresolved variable `path`
//   p.components().join(",")   "97,98,99" — the bytes of a, b and c
//
// The first: MIR flattens `module.Type.method()` to `Type_method`, and decided
// whether the first name was a module by asking a list built from the stubs'
// `extend <module>` blocks. `stdlib/path.rk` has only `extend Path`, so `path`
// wasn't on it.
//
// The second: `Vec.join` picks the string or the integer runtime from the
// element type, which comes from tracking every `push` in the current function.
// A Vec that came back from a call has no tracking, so it took the integer one.

import path
import path.Path

func p(s: string) -> Path {
    return Path.from(s)
}

test "std.path — a module-qualified constructor compiles" {
    let a = path.Path.from("/a/b.txt")
    assert_eq(a.as_string(), "/a/b.txt")
    // The unqualified form was always fine; both spell the same thing.
    let b = Path.from("/a/b.txt")
    assert_eq(b.as_string(), a.as_string())
}

test "std.path — absolute and relative" {
    assert(p("/a/b").is_absolute())
    assert(!p("/a/b").is_relative())
    assert(!p("a/b").is_absolute())
    assert(p("a/b").is_relative())
    assert(!p("").is_absolute())
}

test "std.path — the pieces of a path" {
    let f = p("/a/b/c.txt")
    assert_eq(f.file_name() ?? "-", "c.txt")
    assert_eq(f.extension() ?? "-", "txt")
    assert_eq(f.stem() ?? "-", "c")
    assert(f.has_extension())

    let noext = p("/a/README")
    assert_eq(noext.extension() ?? "-", "-")
    assert_eq(noext.stem() ?? "-", "README")
    assert(!noext.has_extension())

    // A leading dot is the whole name, not an extension.
    let dotfile = p("/a/.bashrc")
    assert_eq(dotfile.extension() ?? "-", "-")
    assert_eq(dotfile.stem() ?? "-", ".bashrc")
}

test "std.path — parent" {
    let f = p("/a/b/c.txt")
    let up = f.parent()
    if up is Path as v {
        assert_eq(v.as_string(), "/a/b")
    } else {
        assert_eq("parent was none", "")
    }
    // The root has no parent.
    assert(p("/").parent() is none)
}

test "std.path — building a new path" {
    assert_eq((p("/a") / "b").as_string(), "/a/b")
    assert_eq(p("/a/b.txt").with_extension("md").as_string(), "/a/b.md")
    assert_eq(p("/a/b.txt").with_file_name("z.md").as_string(), "/a/z.md")
}

test "std.path — components are strings, not their bytes" {
    assert_eq(p("/a/b/c").components().join(","), "a,b,c")
    // A trailing separator adds no empty component.
    assert_eq(p("/a/b/").components().join(","), "a,b")
    assert_eq(p("a/b").components().join(","), "a,b")
    assert_eq(p("/").components().len(), 0)
}

func main() {}
