// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Who owns a container, and who frees it.
//
// A `Vec` or a `Map` built here belongs to this frame, and that survives being
// handed back out of a function — `make_words()` returning a `Vec<string>` is
// the caller's, elements and all. What it must not survive is a name that
// holds this frame's container on one path and somebody else's on the other:
//
//     func lookup(index: Map<string, Vec<i64>>, word: string) -> Vec<i64> {
//         return index.get(word) ?? Vec.new()
//     }
//
// One name, two sources — a fresh vector, or the map's own. Treating that as
// the caller's freed a vector the map still held, and the next lookup read
// memory that was already gone.

func make_words() -> Vec<string> {
    mut v: Vec<string> = []
    v.push("a word long enough that it lives on the heap")
    v.push("another word long enough that it lives on the heap")
    return v
}

func build_index() -> Map<string, Vec<i64>> {
    mut index: Map<string, Vec<i64>> = Map.new()
    mut postings: Vec<i64> = []
    postings.push(1i64)
    postings.push(3i64)
    index.insert("shared-key-long-enough-to-need-the-heap", postings)
    return index
}

func lookup(index: Map<string, Vec<i64>>, word: string) -> Vec<i64> {
    return index.get(word) ?? Vec.new()
}

test "mem.ownership — a container handed back is the caller's" {
    let words = make_words()
    assert words.len() == 2
    assert words[0].len() == 44
}

test "mem.ownership — a lookup that falls back to a fresh container is safe to repeat" {
    let index = build_index()
    let key = "shared-key-long-enough-to-need-the-heap"
    // Reading the same entry twice: neither read may free what the map holds.
    assert lookup(index, key).len() == 2
    assert lookup(index, key).len() == 2
    assert lookup(index, key)[1] == 3
    // And the miss path, which is the fresh one.
    assert lookup(index, "no-such-key-long-enough-to-need-the-heap").len() == 0
    assert lookup(index, key).len() == 2
}
