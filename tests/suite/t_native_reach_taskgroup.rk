// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `TaskGroup<T>` runs on the interpreter and has no native entry point.
//
//     error: codegen 'main': Function not found: TaskGroup_new
//
// `spawn` names `rask_green_closure_spawn` and would resolve; `new` and
// `join_all` are `@native` with no symbol and no dispatch row, so a program
// can't get as far as calling `spawn`. From
// `NATIVE_WITHOUT_A_DISPATCH_ROW` in rask-codegen/src/dispatch.rs — see the
// sibling t_native_reach_* files for the rest of the sweep.

import async.TaskGroup

test "task group spawns and joins" {
    mut g: TaskGroup<i64> = TaskGroup.new()
    g.spawn(|| { return 1 })
    g.spawn(|| { return 2 })
    let results = g.join_all()
    assert(results.len() == 2)
}
