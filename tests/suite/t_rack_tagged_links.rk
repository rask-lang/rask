//
// A link behind a tag: in the payload of a tagged optional (`cur: Cursor?`)
// or in an enum variant's fields (#1801).
//
// Whether those bytes hold a link depends on which variant is live, and the
// rack's per-node descriptor lists fixed slots only, so neither kind was
// recorded: delete left them naming the freed node. They are recorded per
// store now, by the variant that is live, and a store that switches the
// variant forgets the old one's first.
import memory.Link
import memory.Rack

struct Leaf {
    id: i32
}

struct Cursor {
    at: Link<Leaf>?
}

enum Target {
    Nothing
    One(Link<Leaf>?)
    Weighted(i32, Link<Leaf>?)
}

struct Item {
    id: i32
    cur: Cursor?
    target: Target
}

// An arm of more than 63 entries: its guard keeps the count in a second word.
struct Big {
    s0: string
    s1: string
    s2: string
    s3: string
    s4: string
    s5: string
    s6: string
    s7: string
    s8: string
    s9: string
    s10: string
    s11: string
    s12: string
    s13: string
    s14: string
    s15: string
    s16: string
    s17: string
    s18: string
    s19: string
    s20: string
    s21: string
    s22: string
    s23: string
    s24: string
    s25: string
    s26: string
    s27: string
    s28: string
    s29: string
    s30: string
    s31: string
    s32: string
    s33: string
    s34: string
    s35: string
    s36: string
    s37: string
    s38: string
    s39: string
    s40: string
    s41: string
    s42: string
    s43: string
    s44: string
    s45: string
    s46: string
    s47: string
    s48: string
    s49: string
    s50: string
    s51: string
    s52: string
    s53: string
    s54: string
    s55: string
    s56: string
    s57: string
    s58: string
    s59: string
    s60: string
    s61: string
    s62: string
    s63: string
    at: Link<Leaf>?
}

struct Holder {
    big: Big?
}

func opt_id(c: Cursor?) -> i32 {
    if c? as x {
        return link_id(x.at)
    }
    return -2
}

func topt_id(t: Target?) -> i32 {
    if t? as x {
        return target_id(x)
    }
    return -3
}

struct Oops {
    why: string
}

extend Oops {
    func message(self) -> string {
        return self.why
    }
}

enum Wrap {
    Nope
    Yes(Cursor)
}

func ok_id(r: Cursor or Oops) -> i32 {
    return match r {
        Cursor as c => link_id(c.at)
        Oops => -9
    }
}

func found(l: Link<Leaf>) -> Cursor or Oops {
    return Cursor(at: l)
}

func wrap_id(w: Wrap) -> i32 {
    match w {
        Wrap.Nope => return -2,
        Wrap.Yes(c) => return link_id(c.at),
    }
}

func cur_id(i: Link<Item>) -> i32 {
    if i.cur? as c {
        if c.at? as l {
            return l.id
        }
        return -1
    }
    return -2
}

func link_id(l: Link<Leaf>?) -> i32 {
    if l? as x {
        return x.id
    }
    return -1
}

func target_id(t: Target) -> i32 {
    match t {
        Target.Nothing => return -2,
        Target.One(l) => return link_id(l),
        Target.Weighted(_, l) => return link_id(l),
    }
}

func main() {}

test "a link in a tagged optional's payload is nulled by delete" {
    mut leaves: Rack<Leaf> = Rack.new()
    mut items: Rack<Item> = Rack.new()
    let a = leaves.insert(Leaf(id: 1))
    let h = items.insert(Item(id: 1, cur: Cursor(at: a), target: Target.Nothing))
    assert cur_id(h) == 1
    leaves.delete(a)
    assert cur_id(h) == -1
}

test "switching the variant moves the edge" {
    mut leaves: Rack<Leaf> = Rack.new()
    mut items: Rack<Item> = Rack.new()
    let a = leaves.insert(Leaf(id: 1))
    let b = leaves.insert(Leaf(id: 2))
    let h = items.insert(Item(id: 1, cur: none, target: Target.Nothing))
    h.cur = Cursor(at: a)
    h.cur = none
    leaves.delete(a)
    assert cur_id(h) == -2
    h.cur = Cursor(at: b)
    leaves.delete(b)
    assert cur_id(h) == -1
}

test "a link in an enum variant's fields is nulled by delete" {
    mut leaves: Rack<Leaf> = Rack.new()
    mut items: Rack<Item> = Rack.new()
    let a = leaves.insert(Leaf(id: 1))
    let b = leaves.insert(Leaf(id: 2))
    let oa: Link<Leaf>? = a
    let ob: Link<Leaf>? = b
    let h = items.insert(Item(id: 1, cur: none, target: Target.One(oa)))
    h.target = Target.Weighted(3, ob)
    leaves.delete(a)
    assert target_id(h.target) == 2
    leaves.delete(b)
    assert target_id(h.target) == -1
    items.delete(h)
    assert items.len() == 0
}

test "a local struct's optional link is nulled by delete" {
    mut leaves: Rack<Leaf> = Rack.new()
    let a = leaves.insert(Leaf(id: 1))
    let local: Cursor? = Cursor(at: a)
    leaves.delete(a)
    if local? as c {
        assert c.at is none
    } else {
        assert false
    }
}

test "a reassigned local keeps one record, at its own address" {
    mut leaves: Rack<Leaf> = Rack.new()
    let a = leaves.insert(Leaf(id: 1))
    let b = leaves.insert(Leaf(id: 2))
    mut c: Cursor? = Cursor(at: a)
    c = Cursor(at: b)
    for i in 0..3 {
        c = Cursor(at: a)
    }
    leaves.delete(a)
    assert opt_id(c) == -1
    let ob: Link<Leaf>? = b
    mut t = Target.One(ob)
    t = Target.Weighted(1, ob)
    leaves.delete(b)
    assert target_id(t) == -1
}

test "an optional around a struct or an enum, in a container or a local" {
    mut leaves: Rack<Leaf> = Rack.new()
    let a = leaves.insert(Leaf(id: 1))
    let oa: Link<Leaf>? = a
    mut v: Vec<Cursor?> = Vec.new()
    v.push(Cursor(at: a))
    mut m: Map<i32, Cursor?> = Map.new()
    m.insert(1, Cursor(at: a))
    let lt: Target? = Target.One(oa)
    mut vt: Vec<Target?> = Vec.new()
    vt.push(Target.One(oa))
    leaves.delete(a)
    assert opt_id(v[0]) == -1
    if m.get(1)? as e {
        assert opt_id(e) == -1
    } else {
        assert false
    }
    assert topt_id(lt) == -1
    assert topt_id(vt[0]) == -1
}

test "a link in a payload with more than 63 entries" {
    mut leaves: Rack<Leaf> = Rack.new()
    let a = leaves.insert(Leaf(id: 1))
    mut hs: Rack<Holder> = Rack.new()
    let h = hs.insert(Holder(big: Big(s0: "0", s1: "1", s2: "2", s3: "3", s4: "4", s5: "5", s6: "6", s7: "7", s8: "8", s9: "9", s10: "10", s11: "11", s12: "12", s13: "13", s14: "14", s15: "15", s16: "16", s17: "17", s18: "18", s19: "19", s20: "20", s21: "21", s22: "22", s23: "23", s24: "24", s25: "25", s26: "26", s27: "27", s28: "28", s29: "29", s30: "30", s31: "31", s32: "32", s33: "33", s34: "34", s35: "35", s36: "36", s37: "37", s38: "38", s39: "39", s40: "40", s41: "41", s42: "42", s43: "43", s44: "44", s45: "45", s46: "46", s47: "47", s48: "48", s49: "49", s50: "50", s51: "51", s52: "52", s53: "53", s54: "54", s55: "55", s56: "56", s57: "57", s58: "58", s59: "59", s60: "60", s61: "61", s62: "62", s63: "63", at: a)))
    leaves.delete(a)
    if h.big? as b {
        assert link_id(b.at) == -1
        assert b.s63 == "63"
    } else {
        assert false
    }
}

test "a struct carried by `T or E` or by an enum, and its copies" {
    mut leaves: Rack<Leaf> = Rack.new()
    let a = leaves.insert(Leaf(id: 1))
    mut rs: Vec<Cursor or Oops> = Vec.new()
    rs.push(found(a))
    let rc = rs.clone()
    mut ws: Vec<Wrap> = Vec.new()
    ws.push(Wrap.Yes(Cursor(at: a)))
    mut wm: Map<i32, Wrap> = Map.new()
    wm.insert(1, Wrap.Yes(Cursor(at: a)))
    let src: Cursor? = Cursor(at: a)
    let copy: Cursor? = src
    leaves.delete(a)
    assert ok_id(rs[0]) == -1
    assert ok_id(rc[0]) == -1
    assert wrap_id(ws[0]) == -1
    if wm.get(1)? as w {
        assert wrap_id(w) == -1
    } else {
        assert false
    }
    assert opt_id(copy) == -1
}
