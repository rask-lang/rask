// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Indexing a collection reached through a field infers its element type (#632).
//
// A field's type arrives as a deferred constraint, so at the index the container
// is still an unresolved variable. The element type used to be a fresh variable
// with nothing tying it to the container, so it stayed open however the field
// later resolved — `let n = state.names[i]` didn't compile, while the same
// index on a local did.

struct World {
    names: Vec<string>
    scores: Map<string, i64>
    grid: Vec<Vec<i64>>
}

func build() -> World {
    mut names: Vec<string> = Vec.new()
    names.push("first")
    names.push("second")

    mut scores: Map<string, i64> = Map.new()
    scores.insert("a", 7)

    mut inner: Vec<i64> = Vec.new()
    inner.push(3)
    inner.push(4)
    mut grid: Vec<Vec<i64>> = Vec.new()
    grid.push(inner)

    return World { names: names, scores: scores, grid: grid }
}

test "stdlib.collections — a Vec behind a field indexes to its element type" {
    let w = build()
    let name = w.names[1]
    assert name == "second"
}

test "stdlib.collections — a Map behind a field indexes to its value type" {
    let w = build()
    let score = w.scores["a"]
    assert score == 7
}

// The inner `Vec` is the element here, so binding it would be a second name for
// the same buffer rather than a copy — that's E0871, and chaining the two
// indexes is the form the rule points at (mem.borrowing/E1, E2).
test "stdlib.collections — a nested Vec indexes twice" {
    let w = build()
    assert w.grid[0][1] == 4
    assert w.grid[0].len() == 2
}
