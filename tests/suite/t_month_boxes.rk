// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Month one: the box family — Cell, Shared, Mutex, Heap, Atomic.
//
// The family is closed: these are compiler types and you can't build an
// equivalent. Each one answers a different question, and the source shows which:
//
//   Cell     interior mutability for a Copy value, no locking
//   Mutex    exclusive access, `with m.write() as v`
//   Shared   many readers or one writer, `with s.read()` / `with s.write()`
//   Heap     a single owner of a heap value, spelled `Heap(expr)`
//
// Two holes here, both deliberate:
//
//   Atomic is the family's adjacent member and has no operations at all — the
//   type names resolve and nothing is behind them (#927). `t_month_atomics.rk`
//   drives it. `Shared.mutex(0)` plus `with m.write()` is the working answer today.
//
//   Pool and Handle are excluded from this sweep by standing request.
//   `t_pool_capacity.rk`, `t_pool_iter_handles.rk` and `t_pool_remove.rk` carry
//   them.

import sync.Shared
import memory.Heap
import sync.Mutex
import sync.Shared

struct Counter {
    n: i64
}

struct Config {
    retries: i32
    verbose: bool
}

test "conc.sync — a Local box holds a Copy value and hands it back" {
    mut c = Shared.new(7)
    assert c.get() == 7
    c.set(8)
    assert c.get() == 8
}

test "conc.sync — a Local box of a small struct" {
    mut c = Shared.new(Config { retries: 3, verbose: false })
    assert c.get().retries == 3
    c.set(Config { retries: 5, verbose: true })
    assert c.get().retries == 5
    assert c.get().verbose
}

test "conc.sync — replace returns the old value in one step" {
    mut c = Shared.new(1)
    assert c.replace(2) == 1
    assert c.replace(3) == 2
    assert c.get() == 3
}

test "conc.sync — into_inner consumes the box" {
    let c = Shared.new(99)
    assert c.into_inner() == 99
}

test "conc.sync — the Mutex strategy serialises access through with" {
    mut m = Shared.mutex(0)
    for _ in 0..5 {
        with m.write() as v {
            v = v + 2
        }
    }
    with m.write() as v {
        assert v == 10
    }
}

test "conc.sync — the Mutex strategy guarding a struct field" {
    mut m = Shared.mutex(Counter { n: 0 })
    with m.write() as c {
        c.n = 41
    }
    with m.write() as c {
        c.n = c.n + 1
    }
    with m.write() as c {
        assert c.n == 42
    }
}

test "conc.sync — the Mutex strategy guarding a collection" {
    mut m = Shared.mutex(Vec.new())
    with m.write() as v {
        v.push(1)
        v.push(2)
    }
    with m.write() as v {
        assert v.len() == 2
        assert v[1] == 2
    }
}

test "conc.sync — Shared read sees what Shared write put there" {
    mut s = Shared.new(0)
    with s.write() as v {
        v = 5
    }
    with s.read() as v {
        assert v == 5
    }
}

test "conc.sync — several Shared writes in sequence" {
    mut s = Shared.new(Counter { n: 0 })
    with s.write() as c {
        c.n = 10
    }
    with s.write() as c {
        c.n = c.n * 2
    }
    with s.read() as c {
        assert c.n == 20
    }
}

test "conc.sync — two Shared reads in a row" {
    mut s = Shared.new(7)
    with s.read() as a {
        assert a == 7
    }
    with s.read() as b {
        assert b == 7
    }
}

// `Heap(expr)` heap-allocates and gives back a `Heap<T>`; `*ptr` reads through it.
test "mem.heap — Heap() heap-allocates and derefs back" {
    let p: Heap<i64> = Heap(42)
    assert *p == 42
}

// A struct payload really is allocated, so the box owes a drop (mem.linear/L1).
// `Heap<i64>` above doesn't: a scalar was never allocated, so there is nothing
// to free (#819).
test "mem.heap — a Heap struct payload" {
    let p: Heap<Counter> = Heap(Counter { n: 5 })
    assert (*p).n == 5
    drop(p)
}

test "mem.heap — a Heap field on a struct" {
    let c: Heap<Counter> = Heap(Counter { n: 7 })
    assert (*c).n == 7
    drop(c)
}

func main() {}
