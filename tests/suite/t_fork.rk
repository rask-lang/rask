// conc.fork — `fork { … } and { … }`: blocks that borrow from the frame and
// may run at the same time. Every test runs with and without a pool; the
// answer has to be the same (FK5).

struct Point {
    x: i64
    y: i64
}

struct Bad {
    why: string
}

extend Bad {
    func message(self) -> string {
        return self.why
    }
}

func parse(s: string) -> i64 or Bad {
    if s == "bad" {
        return Bad(why: "bad input")
    }
    return 7
}

func sum_range(lo: i64, hi: i64) -> i64 {
    mut total = 0
    for i in lo..hi {
        total += i
    }
    return total
}

func fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    if n < 12 {
        return fib(n - 1) + fib(n - 2)
    }
    let (a, b) = fork { fib(n - 1) } and { fib(n - 2) }
    return a + b
}

func shapes() -> (string, f64, i64, Point) {
    let v = Vec.from([4, 5, 6])
    return fork {
        return "left"
    } and {
        return 2.5
    } and {
        v[0] + v[2]
    } and {
        Point(x: v.len().to<i64>()!, y: 9)
    }
}

test "conc.fork/FK1 the value is a tuple in written order" {
    let (a, b) = fork { sum_range(0, 100) } and { sum_range(100, 200) }
    assert a == 4950
    assert b == 14950
    let (s, f, n, p) = shapes()
    assert s == "left"
    assert f == 2.5
    assert n == 10
    assert p.x == 3 && p.y == 9
    using ThreadPool(workers: 2) {
        let (s2, f2, n2, p2) = shapes()
        assert s2 == "left" && f2 == 2.5 && n2 == 10 && p2.x == 3
    }
}

test "conc.fork/FK2 blocks write through to the frame" {
    mut p = Point(x: 1, y: 2)
    mut log: Vec<string> = Vec.new()
    fork {
        p.x = 10
    } and {
        p.y = 20
    } and {
        log.push("third")
    }
    assert p.x == 10
    assert p.y == 20
    assert log.len() == 1
    using ThreadPool(workers: 3) {
        fork { p.x += 1 } and { p.y += 1 }
    }
    assert p.x == 11 && p.y == 21
}

test "conc.fork/FK4 try ends one block with the error" {
    let (r1, r2) = fork { try parse("ok") } and { try parse("bad") }
    assert r1 is i64
    if r2 is Bad as e {
        assert e.why == "bad input"
    } else {
        assert false
    }
}

test "conc.fork/FK5 nested forks on a small pool" {
    let alone = fib(20)
    using ThreadPool(workers: 2) {
        assert fib(20) == alone
    }
    assert alone == 6765
}

test "conc.fork/FK1 a fork inside a fork block" {
    let (inner, outer) = fork {
        let (x, y) = fork { 1 } and { 2 }
        x + y
    } and { 10 }
    assert inner == 3
    assert outer == 10
}

test "conc.fork/FK1 a block hands back what it built" {
    let (v, s) = fork { Vec.from([1, 2, 3]) } and { "built" }
    assert v.len() == 3
    assert s == "built"
}
