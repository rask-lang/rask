// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Explicit lossy conversions (type.primitives CV5–CV10) and char.from_u32 (CH3).
// Every case is exercised at a boundary value and must give identical results
// on the interpreter and native backends.

// --- CV12: wrap<T> (wrapping/bitwise) ---
test "truncate wraps into target width" {
    let big: i32 = 300
    let a: u8 = big.wrap<u8>()      // 300 & 0xFF = 44
    assert a == 44
    let neg: i32 = -1
    let b: u8 = neg.wrap<u8>()      // low 8 bits of -1 = 255
    assert b == 255
    let c: i8 = 200.wrap<i8>()      // 0xC8 → -56
    assert c == -56
    let same: i32 = 42.wrap<i32>()  // no-op on same width
    assert same == 42
}

// --- CV13: clamp<T> (pins to the range) ---
test "saturate clamps to target range" {
    let big: i32 = 300
    assert (big.clamp<u8>()) == 255
    assert (big.clamp<i8>()) == 127
    let neg: i32 = -5
    assert (neg.clamp<u8>()) == 0
    let vneg: i32 = -200
    assert (vneg.clamp<i8>()) == -128
    let fits: i32 = 100
    assert (fits.clamp<u8>()) == 100
}

// --- CV11: to<T> (exact, or ConvertError) ---
//
// This replaced `try x convert to T`, and the shape changed with it: a result
// rather than an optional, so `?? d` became `catch _ => d`. It also covers more
// than the old form did — a float source is exact-or-fail here, where the old
// family needed a separate verb for it.
test "to fails when the value doesn't fit" {
    let ok: i64 = 100
    assert ok.to<u8>()! == 100
    let overflow: i64 = 300
    assert (overflow.to<u8>() catch _ => 0) == 0
    let negative: i64 = -1
    assert (negative.to<u8>() catch _ => 0) == 0
}

// --- CV15/CV16: floor and ceil (float → int) ---
//
// Toward-zero is gone with the phrase verbs — it was never a policy anyone
// named, just what a C cast happens to do. What the fraction does is now the
// verb: `floor` toward −∞, `ceil` toward +∞, `round` to nearest.
test "floor and ceil name which way the fraction goes" {
    let p: f64 = 3.9
    assert p.floor<i32>()! == 3
    assert p.ceil<i32>()! == 4
    let n: f64 = -3.9
    assert n.floor<i32>()! == -4
    assert n.ceil<i32>()! == -3
}

// --- CV14–CV16: out of range is a failure, not a clamp ---
//
// The saturating float→int form is gone too: `clamp` is integers-only (CV13),
// because on a float it would have to pick a fraction policy silently — the one
// thing its name can't say. A float that doesn't fit fails, and the caller says
// what to do about it.
test "a float that doesn't fit the target fails" {
    let huge: f64 = 1.0e30
    assert (huge.round<i32>() catch _ => 0) == 0
    let tiny: f64 = -1.0e30
    assert (tiny.floor<i32>() catch _ => 0) == 0
    let fits: f64 = 42.5
    assert fits.floor<i32>()! == 42
}

// --- int → float via `as` (lossless widening, spec examples) ---
test "as allows int to float" {
    let n: i32 = 300
    let f: f64 = n as f64
    assert f == 300.0
}

// --- CH3: char.from_u32 returns char? ---
// (compares via `as u32` to sidestep a pre-existing native char-eq codegen bug, #332)
test "char from_u32 validates code points" {
    if char.from_u32(65)? as a {
        assert (a as u32) == 65
    } else {
        assert false, "65 is a valid scalar"
    }
    let surrogate = char.from_u32(0xD800)
    assert surrogate is none
    let too_big = char.from_u32(0x110000)
    assert too_big is none
    let emoji = char.from_u32(0x1F600)
    assert emoji?
}
