// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Pool and WeakHandle methods that type-check, run on the interpreter, and
// have no native entry point at all.
//
// Every one of these is declared `@native` in stdlib/memory.rk and listed in
// `NATIVE_WITHOUT_A_DISPATCH_ROW` (rask-codegen/src/dispatch.rs), where the
// list mixes "lowered somewhere bespoke" with "no entry point at all" and its
// comment says only trying one tells them apart. Trying them says: all nine
// are the second kind. `rask run` on any of them dies with
//
//     error: codegen 'main': Function not found: Pool_capacity
//
// `Pool.read` fails differently and worse — it reaches a dispatch row with the
// wrong shape and Cranelift rejects the call ("mismatched argument count …
// got 4, expected 2"), so the gap there is a wrong row rather than a missing
// one.
//
// Pool is deprecated (CLAUDE.md's Decided table), so this file is a statement
// of what is missing rather than a request to build it. It is registered in
// known_divergences.txt; if Pool is removed, delete the file with it.

import memory.Pool

struct Item {
    public id: i64
}

test "pool capacity and remaining" {
    mut p: Pool<Item> = Pool.new()
    let h = p.insert(Item { id: 7 })
    assert(p.len() == 1)
    assert(p.capacity() >= 1)
    assert(p.remaining() >= 0)
}

test "pool read, modify and the unchecked accessors" {
    mut p: Pool<Item> = Pool.new()
    let h = p.insert(Item { id: 7 })
    assert((p.read(h, |it| { return it.id }) ?? -1) == 7)
    assert((p.modify(h, |it| { return it.id + 1 }) ?? -1) == 8)
    assert(p.get_unchecked(h).id == 7)
}

test "pool clear and snapshot" {
    mut p: Pool<Item> = Pool.new()
    p.insert(Item { id: 1 })
    let (snap, _rest) = p.snapshot()
    assert(snap.len() == 1)
    p.clear()
    assert(p.len() == 0)
}

test "weak handle valid and upgrade" {
    mut p: Pool<Item> = Pool.new()
    let h = p.insert(Item { id: 7 })
    let w = p.weak(h)
    assert(w.valid())
    if w.upgrade()? as live {
        assert((p.get(live)?.id ?? -1) == 7)
    }
}
