// SPDX-License-Identifier: (MIT OR Apache-2.0)
// What json.encode writes for each shape a value can take inside a struct or
// a Vec. Native kept one list of shapes for struct fields and a shorter one
// for Vec elements, so a nested Vec, an optional or an enum element wrote its
// address (#1956). Fields came out in memory order, not declaration order
// (#1961), and the interpreter wrote a Map in insertion order where `for` and
// native use the seeded order (#1938).
import json

struct Opts {
    name: string
    f: bool
    n: i64
}

enum Slot {
    One(i64)
    Two(string, i64)
    Empty
}

struct Book {
    nested: Vec<Vec<string>>
    opts: Vec<string?>
    slots: Vec<Slot>
    maybe: Vec<Opts?>
    small: Vec<i8>
}

test "fields come out in declaration order" {
    assert json.encode(Opts(name: "x", f: true, n: 3)) == "\{\"name\":\"x\",\"f\":true,\"n\":3\}"
}

test "Vec elements encode as their own type" {
    mut inner = Vec.new()
    inner.push("k")
    mut nested = Vec.new()
    nested.push(inner)
    nested.push(Vec.new())
    mut opts: Vec<string?> = Vec.new()
    opts.push(none)
    opts.push("m")
    mut slots = Vec.new()
    slots.push(Slot.One(1))
    slots.push(Slot.Two("y", 9))
    slots.push(Slot.Empty)
    mut maybe: Vec<Opts?> = Vec.new()
    maybe.push(Opts(name: "a", f: false, n: 1))
    maybe.push(none)
    mut small: Vec<i8> = Vec.new()
    small.push(-3)
    let b = Book(nested: nested, opts: opts, slots: slots, maybe: maybe, small: small)
    let want = "\{\"nested\":[[\"k\"],[]],\"opts\":[null,\"m\"],\"slots\":[\{\"One\":1\},\{\"Two\":\{\"_0\":\"y\",\"_1\":9\}\},\"Empty\"],\"maybe\":[\{\"name\":\"a\",\"f\":false,\"n\":1\},null],\"small\":[-3]\}"
    assert json.encode(b) == want
}

test "a Map encodes in the order for visits it" {
    mut m: Map<string, i64> = Map.new()
    mut i = 7
    while i >= 0 {
        m.insert("w{i}", i)
        i -= 1
    }
    mut parts = Vec.new()
    for (k, v) in m {
        parts.push("\"{k}\":{v}")
    }
    let want = "\{{parts.join(",")}\}"
    assert json.encode(m) == want
}
