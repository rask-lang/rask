// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `with box.write() as v` binds what the box holds, not the box (conc.sync/R2).
// On native the binding was the box pointer, so a scalar came out as an address
// and a struct payload segfaulted on the first field read. Also covers CE6's
// get/set/replace and the interior mutability that lets them work through a
// `let` binding — mutation goes through the heap slot, never the binding.

struct State {
    public count: i32
    public mode: i32
}

struct App {
    public hits: Shared<i32>
    public state: Shared<State>
}

func bump(c: Shared<i32>) -> i32 {
    with c.write() as v {
        v = v + 100
        return v
    }
    return -1
}

test "the binding is the value, not the box" {
    let c = Shared.local(42)
    with c.write() as v {
        assert_eq(v, 42)
    }
}

test "writes through the binding land in the cell" {
    let c = Shared.local(42)
    with c.write() as v {
        v = v + 5
    }
    assert_eq(c.get(), 47)
}

test "the block is an expression" {
    let c = Shared.local(21)
    let doubled: i64 = with c.write() as v { v * 2 }
    assert_eq(doubled, 42)
}

test "a struct payload reads and writes through the binding" {
    let s = Shared.local(State { count: 1, mode: 0 })
    with s.write() as st {
        st.count = st.count + 10
        st.mode = 3
    }
    with s.write() as st {
        assert_eq(st.count, 11)
        assert_eq(st.mode, 3)
    }
}

test "Shared<T> works in type position" {
    let app = App {
        hits: Shared.local(0),
        state: Shared.local(State { count: 7, mode: 1 }),
    }
    with app.hits.write() as h {
        h = h + 1
    }
    with app.hits.write() as h {
        assert_eq(h, 1)
    }
    with app.state.write() as st {
        st.count = 99
    }
    with app.state.write() as st {
        assert_eq(st.count, 99)
    }
}

test "an early exit still writes back on the way out" {
    let c = Shared.local(47)
    assert_eq(bump(c), 147)
    with c.write() as v {
        assert_eq(v, 147)
    }
}

test "get, set and replace work through a let binding" {
    let counter = Shared.local(0)
    assert_eq(counter.get(), 0)
    counter.set(42)
    assert_eq(counter.get(), 42)
    let old = counter.replace(7)
    assert_eq(old, 42)
    assert_eq(counter.get(), 7)
}

test "the mutex path shares this lowering and still agrees" {
    let m = Shared.mutex(100)
    with m.write() as v {
        v = v + 1
    }
    with m.write() as v {
        assert_eq(v, 101)
    }
}
