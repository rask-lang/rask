// std.math witnesses. Interp is correct; NATIVE is a KNOWN-FAIL — the whole
// math module is unlinked in codegen (`Function not found: math_sin`, etc.; the
// codegen dispatch table only has sqrt/abs/pow, none of which are even in the
// stub). Tracked in tests/known_divergences.txt; delete that line and this note
// when native math lands. Do NOT weaken to make native pass.

import math

func main() {}

test "std.math/exp-ln-log identities" {
    assert math.exp(0.0) == 1.0
    assert math.ln(1.0) == 0.0
    assert math.log2(8.0) == 3.0
    assert math.log10(1000.0) == 3.0
}

test "std.math/trig at zero" {
    assert math.sin(0.0) == 0.0
    assert math.cos(0.0) == 1.0
    assert math.tan(0.0) == 0.0
}

test "std.math/hypot 3-4-5" {
    assert math.hypot(3.0, 4.0) == 5.0
}

test "std.math/clamp bounds" {
    assert math.clamp(5.0, 0.0, 3.0) == 3.0
    assert math.clamp(-1.0, 0.0, 3.0) == 0.0
    assert math.clamp(2.0, 0.0, 3.0) == 2.0
}

test "std.math/is_finite is_inf is_nan" {
    assert math.is_finite(1.0)
    assert math.is_inf(1.0) == false
    assert math.is_nan(1.0) == false
}
