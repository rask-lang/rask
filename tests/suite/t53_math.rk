// std.math witnesses.
//
// is_nan/is_inf/is_finite are f64 methods, not math module functions, and
// there is no math.clamp — min/max/clamp are prelude functions that work on
// any Comparable type (#302/#303 rename sweep, std.math/G1-G3).

import math

func main() {}

test "std.math/exp-ln-log identities" {
    assert math.exp(0.0) == 1.0
    assert math.ln(1.0) == 0.0
    assert math.log2(8.0) == 3.0
    assert math.log10(1000.0) == 3.0
}

test "std.math/trig at zero" {
    assert math.sin(0.0) == 0.0
    assert math.cos(0.0) == 1.0
    assert math.tan(0.0) == 0.0
}

test "std.math/hypot 3-4-5" {
    assert math.hypot(3.0, 4.0) == 5.0
}

test "prelude clamp bounds (std.math/G3)" {
    assert clamp(5.0, 0.0, 3.0) == 3.0
    assert clamp(-1.0, 0.0, 3.0) == 0.0
    assert clamp(2.0, 0.0, 3.0) == 2.0
}

test "prelude min/max (std.math/G1-G2)" {
    assert min(5.0, 3.0) == 3.0
    assert max(5.0, 3.0) == 5.0
    assert min(2, 7) == 2
    assert max(2, 7) == 7
}

test "f64.is_finite/.is_inf/.is_nan (std.math/N1)" {
    let x = 1.0
    assert x.is_finite()
    assert x.is_inf() == false
    assert x.is_nan() == false
}
