// mem.racks/RK16–RK21: tasks that borrow their frame, and the code beside
// them, read one rack and record structural changes in `Staged` buffers,
// applied after the join in key order, deletes last.

import memory.Rack
import memory.Link
import memory.Staged
import thread.ThreadPool

struct Entity {
    id: u64
    name: string
    health: i64
    target: Link<Entity>?
}

func describe(world: Rack<Entity>) -> string {
    mut line = "{world.len()}"
    for e in world.nodes() {
        mut t = "-"
        if e.target? as tt {
            t = tt.name
        }
        line = "{line} {e.name}:{e.health}->{t}"
    }
    return line
}

func decide(world: Rack<Entity>, lo: u64, hi: u64) -> Staged<Entity> {
    mut ops = world.staged()
    for e in world.nodes() {
        if e.id >= lo && e.id < hi && e.health <= 0 {
            ops.delete(e.id, e)
        }
    }
    return ops
}

func total(world: Rack<Entity>) -> i64 {
    mut sum = 0
    for e in world.nodes() {
        sum += e.health
    }
    return sum
}

test "mem.racks/RK19 deletes land last; relinks to dying nodes are skipped" {
    mut world: Rack<Entity> = Rack.new()
    let a = world.insert(Entity(id: 1, name: "a", health: 10, target: none))
    let b = world.insert(Entity(id: 2, name: "b", health: 0, target: none))
    let c = world.insert(Entity(id: 3, name: "c", health: 5, target: none))

    mut ops = world.staged()
    ops.relink(1, a, b, |mutate n: Entity, to: Link<Entity>| { n.target = to })
    ops.relink(3, c, a, |mutate n: Entity, to: Link<Entity>| { n.target = to })
    ops.delete(2, b)
    ops.delete(2, b)
    ops.insert(9, Entity(id: 4, name: "d", health: 7, target: c))
    mut more = world.staged()
    more.insert(0, Entity(id: 5, name: "e", health: 1, target: b))
    ops.append(more)
    assert ops.len() == 6
    // Recorded, not made: the rack is as it was.
    assert world.len() == 3
    assert b.name == "b"
    world.apply(ops)
    assert describe(world) == "4 a:10->- c:5->a e:1->- d:7->c"
}

test "mem.racks/RK16 a task and the code beside it share a rack for reading" {
    mut world: Rack<Entity> = Rack.new()
    for i in 0..200 {
        let hp = (i % 5).to<i64>()! - 1
        world.insert(Entity(id: i.to<u64>()!, name: "n", health: hp, target: none))
    }
    let ha = ThreadPool.spawn(requires_pool: false) { decide(world, 0, 100) }
    let hb = ThreadPool.spawn(requires_pool: false) { decide(world, 100, 200) }
    let sum = total(world)
    mut ops = ha.join()!
    ops.append(hb.join()!)
    assert sum == 200
    assert ops.len() == 80
    world.apply(ops)
    assert world.len() == 120

    using ThreadPool(workers: 3) {
        let hc = ThreadPool.spawn { decide(world, 0, 100) }
        let hd = ThreadPool.spawn { decide(world, 100, 200) }
        let s2 = total(world)
        mut more = hc.join()!
        more.append(hd.join()!)
        assert s2 == 240
        assert more.len() == 0
        world.apply(more)
    }
    assert world.len() == 120
}

func call_it(f: func(u64) -> void, k: u64) {
    f(k)
}

test "mem.racks/RK15 a loop that deletes through a function it hands on keeps its place" {
    mut world: Rack<Entity> = Rack.new()
    let a = world.insert(Entity(id: 1, name: "a", health: 10, target: none))
    let b = world.insert(Entity(id: 2, name: "b", health: 20, target: none))
    let c = world.insert(Entity(id: 3, name: "c", health: 30, target: none))
    let v = Vec.from([a, b, c])
    let kill = |k: u64| {
        for n in world.nodes() {
            if n.id == k {
                world.delete(n)
                return
            }
        }
    }
    mut seen = ""
    for x in v {
        seen = "{seen}{x.name}"
        if x.id == 1 {
            call_it(kill, 2)
        }
    }
    assert seen == "ac"
    assert v.len() == 2
}

test "mem.racks/RK17 a buffer nobody applies releases what it recorded" {
    mut world: Rack<Entity> = Rack.new()
    let a = world.insert(Entity(id: 1, name: "a", health: 10, target: none))
    mut ops = world.staged()
    ops.insert(1, Entity(id: 2, name: "never inserted", health: 1, target: a))
    ops.relink(2, a, a, |mutate n: Entity, to: Link<Entity>| { n.target = to })
    assert ops.len() == 2
    assert world.len() == 1
}
