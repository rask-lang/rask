// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A type with a checking constructor is not auto-`Decode` (std.encoding/E12a).
//
// The compile-error half is `tests/compile_errors/decode_skips_constructor.rk`.
// This file holds what the rule leaves working: `Encode` on such a type, a
// `decode` that runs the constructor (std.encoding/E12b, whose own cases are in
// `t_decode_custom.rk`), and the declaration that says a raw decode is intended.

import json

struct PortError {
    reason: string
}

extend PortError {
    public func message(self) -> string {
        return self.reason
    }
}

struct Port {
    value: u16
}

extend Port {
    func new(v: u16) -> Port or PortError {
        if v == 0 {
            return PortError(reason: "port 0 is reserved")
        }
        return Port(value: v)
    }
}

Port implements Decode {
    func decode(raw: u16) -> Port or PortError {
        return Port.new(raw)
    }
}

// Written the way it is read, so what comes out decodes back (E12b).
Port implements Encode {
    func encode(self) -> u16 {
        return self.value
    }
}

func read_port(text: string) -> string {
    let p = json.decode<Port>(text) catch e => {
        return e.message()
    }
    return "port {p.value}"
}

test "std.encoding/E12a — a decode that calls the constructor makes the type decodable" {
    assert read_port("8080") == "port 8080"
    assert read_port("0") == "type error: the value: port 0 is reserved"
}

test "std.encoding/E12a — a constructor doesn't touch Encode: the type writes itself with its encode" {
    let p = Port.new(443) catch _ => {
        return
    }
    assert json.encode(p) == "443"
}

// A function that returns `Self or E` without checking decoded data says so
// once, where the type is declared.
struct Settings {
    name: string
    retries: i64
}

extend Settings {
    func load(path: string) -> Settings or PortError {
        return PortError(reason: "no file at {path}")
    }
}

Settings implements Decode {
}

struct App {
    settings: Vec<Settings>
}

test "std.encoding/E12a — `T implements Decode { }` lifts the rule, even inside a Vec" {
    let a = json.decode<App>("{{\"settings\": [{{\"name\": \"x\", \"retries\": 3}]}") catch e => {
        assert false
        return
    }
    assert a.settings.len() == 1
    assert a.settings[0].retries == 3
}
