// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A type with a checking constructor is not auto-`Decode` (std.encoding/E12a).
//
// The compile-error half is `tests/compile_errors/decode_skips_constructor.rk`.
// This file holds what the rule leaves working: `Encode` on such a type, the
// wire-struct way of decoding it through its constructor, and the one-line
// declaration that says a raw decode is intended.

import json

struct PortError {
    reason: string
}

extend PortError {
    public func message(self) -> string {
        return self.reason
    }
}

struct Port {
    value: u16
}

extend Port {
    func new(v: u16) -> Port or PortError {
        if v == 0 {
            return PortError(reason: "port 0 is reserved")
        }
        return Port(value: v)
    }
}

struct PortWire {
    value: u16
}

func read_port(text: string) -> Port or PortError {
    let wire = json.decode<PortWire>(text) catch e => {
        return PortError(reason: e.message())
    }
    return try Port.new(wire.value)
}

test "std.encoding/E12a — decoding through the wire struct calls the constructor" {
    let ok = read_port("{{\"value\": 8080}")
    if ok is Port as p {
        assert p.value == 8080
    } else {
        assert false
    }

    let bad = read_port("{{\"value\": 0}")
    if bad is PortError as e {
        assert e.reason == "port 0 is reserved"
    } else {
        assert false
    }
}

test "std.encoding/E12a — Encode is untouched by a constructor" {
    let p = Port.new(443) catch _ => {
        return
    }
    assert json.encode(p) == "{{\"value\":443}"
}

// A function that returns `Self or E` without checking decoded data says so
// once, where the type is declared.
struct Settings {
    name: string
    retries: i64
}

extend Settings {
    func load(path: string) -> Settings or PortError {
        return PortError(reason: "no file at {path}")
    }
}

Settings implements Decode {
}

struct App {
    settings: Vec<Settings>
}

test "std.encoding/E12a — `T implements Decode { }` lifts the rule, even inside a Vec" {
    let a = json.decode<App>("{{\"settings\": [{{\"name\": \"x\", \"retries\": 3}]}") catch e => {
        assert false
        return
    }
    assert a.settings.len() == 1
    assert a.settings[0].retries == 3
}
