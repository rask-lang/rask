// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// `for v in s` over a `Set` walks its values (#1511).
//
// A collection is its own chain head (SEQ48), and `Set` declares
// `as_sequence`, so the loop goes through that. It type-checked and then
// failed on both backends: the interpreter said "cannot iterate over struct",
// native couldn't type the loop variable. The order is the map's underneath
// (C7), so the loop sees what `to_vec()` sees.

struct Point {
    x: i64
    y: i64
    z: i64
}

struct Registry {
    names: Set<string>
}

func joined(s: Set<string>) -> string {
    mut out = ""
    for v in s {
        out = "{out}{v};"
    }
    return out
}

test "a string set walks every value once" {
    let a = "abcdefghijklmnopqrstuvwxyz"
    mut s: Set<string> = Set.new()
    s.insert("{a}1")
    s.insert("{a}2")
    s.insert("{a}1")
    mut n = 0
    mut total = 0
    for v in s {
        n += 1
        total += v.len()
    }
    assert n == 2
    assert total == 54
}

test "the loop's order is to_vec's" {
    let a = "abcdefghijklmnopqrstuvwxyz"
    mut s = Set<string>.new()
    for i in 0..20 {
        s.insert("{a}{i}")
    }
    mut walked = ""
    for v in s {
        walked = "{walked}{v};"
    }
    mut listed = ""
    for v in s.to_vec() {
        listed = "{listed}{v};"
    }
    assert walked == listed
    assert joined(s) == listed
}

test "a struct set walks its values" {
    mut s: Set<Point> = Set.new()
    s.insert(Point { x: 1, y: 2, z: 3 })
    s.insert(Point { x: 4, y: 5, z: 6 })
    s.insert(Point { x: 1, y: 2, z: 3 })
    mut sum = 0
    for p in s {
        sum += p.x + p.y + p.z
    }
    assert sum == 21
}

test "a set reached through a field" {
    mut r = Registry { names: Set.new() }
    r.names.insert("abcdefghijklmnopqrstuvwxyz-one")
    r.names.insert("abcdefghijklmnopqrstuvwxyz-two")
    mut n = 0
    for v in r.names {
        assert v.starts_with("abcdefghijklmnopqrstuvwxyz-")
        n += 1
    }
    assert n == 2
}

test "break leaves the loop" {
    mut s: Set<i64> = Set.new()
    for i in 0..10 {
        s.insert(i)
    }
    mut seen = 0
    for v in s {
        seen += 1
        if seen == 3 {
            break
        }
    }
    assert seen == 3
}

test "an empty set runs no iterations" {
    let s: Set<string> = Set.new()
    mut n = 0
    for v in s {
        n += 1
    }
    assert n == 0
}
