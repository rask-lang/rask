// SPDX-License-Identifier: (MIT OR Apache-2.0)
// The merge and tombstone strip from examples/lsm_database/compaction.rk.
//
// That file never type-checked (#1293). `merged = merged.filter(p)` put the
// `Sequence` that `filter` answers into a `Vec` variable, and `let m0 =
// merged[0]` bound a second name to a non-Copy element. The example now
// strips in place with `remove_where` and reads fields straight off the
// index. The package as a whole still doesn't check (#1492), so this holds
// the same code to both backends until the example can be gated.

struct KeyValue {
    key: string
    value: string
    seq: i64
    deleted: bool
}

extend KeyValue {
    func new(key: string, value: string, seq: i64) -> KeyValue {
        return KeyValue { key, value, seq, deleted: false }
    }

    func tombstone(key: string, seq: i64) -> KeyValue {
        return KeyValue { key, value: "", seq, deleted: true }
    }
}

func merge_entries(a: Vec<KeyValue>, b: Vec<KeyValue>) -> Vec<KeyValue> {
    mut result = Vec.new()
    mut i: usize = 0
    mut j: usize = 0

    while i < a.len() && j < b.len() {
        if a[i].key < b[j].key {
            result.push(a[i].clone())
            i += 1
        } else if a[i].key > b[j].key {
            result.push(b[j].clone())
            j += 1
        } else {
            if a[i].seq >= b[j].seq {
                result.push(a[i].clone())
            } else {
                result.push(b[j].clone())
            }
            i += 1
            j += 1
        }
    }
    while i < a.len() {
        result.push(a[i].clone())
        i += 1
    }
    while j < b.len() {
        result.push(b[j].clone())
        j += 1
    }
    return result
}

func compact(a: Vec<KeyValue>, b: Vec<KeyValue>, bottom: bool) -> Vec<KeyValue> {
    mut merged = merge_entries(a, b)
    if bottom {
        merged.remove_where(|kv| kv.deleted)
    }
    return merged
}

test "merge entries deduplicates by seq" {
    let a = Vec.from([KeyValue.new("a", "old_a", 1), KeyValue.new("c", "old_c", 2)])
    let b = Vec.from([KeyValue.new("a", "new_a", 3), KeyValue.new("b", "b", 4)])

    let merged = merge_entries(a, b)
    assert merged.len() == 3
    assert merged[0].key == "a"
    assert merged[0].value == "new_a"
    assert merged[1].key == "b"
    assert merged[2].key == "c"
}

test "tombstones survive above the bottom level" {
    mut a = Vec.new()
    a.push(KeyValue.new("x", "alive", 1))
    mut b = Vec.new()
    b.push(KeyValue.tombstone("x", 5))

    let merged = compact(a, b, false)
    assert merged.len() == 1
    assert merged[0].deleted
    assert merged[0].seq == 5
}

test "the bottom level drops tombstones" {
    let a = Vec.from([KeyValue.new("k1", "v1", 1), KeyValue.tombstone("k2", 2)])
    let b = Vec.from([KeyValue.tombstone("k1", 3), KeyValue.new("k3", "v3".to_uppercase(), 4)])

    let merged = compact(a, b, true)
    assert merged.len() == 1
    assert merged[0].key == "k3"
    assert merged[0].value == "V3"
}
