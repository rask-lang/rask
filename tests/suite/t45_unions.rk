// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Union types: multi-variant error unions `A | B | C` in the error position of
// `T or E`. Spec: type.union-types (U2 anonymous enum, S1/S2 auto-widen).
//
// SCOPE NOTE: only the success/widening path is exercised here. Runtime
// discrimination of *which* error variant a union holds (`is`, `? as v`,
// `match` per variant) currently diverges between interp and native — those
// are reported as divergences, not committed as green tests.

enum ParseError { NotNumber }
extend ParseError {
    func message(self) -> string {
        match self {
            ParseError.NotNumber => return "not a number",
        }
    }
}

enum DivError { ByZero }
extend DivError {
    func message(self) -> string {
        match self {
            DivError.ByZero => return "division by zero",
        }
    }
}

enum RangeError { TooBig }
extend RangeError {
    func message(self) -> string {
        match self {
            RangeError.TooBig => return "out of range",
        }
    }
}

func parse_number(s: string) -> i32 or ParseError {
    if s == "42" { return 42 }
    if s == "10" { return 10 }
    return ParseError.NotNumber
}

func safe_div(a: i32, b: i32) -> i32 or DivError {
    if b == 0 { return DivError.ByZero }
    return a / b
}

// S1/S2: each `try` widens its own error type into the 3-variant return union,
// and the success value flows through unchanged.
func compute(s: string, b: i32, limit: i32) -> i32 or (DivError | ParseError | RangeError) {
    const n = try parse_number(s)
    const q = try safe_div(n, b)
    if q > limit { return RangeError.TooBig }
    return q
}

// --- S1: success widens through the union, `!` extracts it ---
test "type.union-types/S1 — success widens through union, ! extracts" {
    const r = compute("42", 2, 100)
    assert r! == 21
}

// --- S1/S2: different success values across the try chain ---
test "type.union-types/S2 — multiple inputs, success flows unchanged" {
    assert compute("42", 2, 100)! == 21
    assert compute("10", 5, 100)! == 2
    assert compute("42", 42, 100)! == 1
}

// --- S1: success value binds via `? as v` on the union (present branch) ---
func first_or_zero(s: string, b: i32) -> i32 {
    const r = compute(s, b, 1000000)
    if r? as v {
        return v
    } else {
        return 0
    }
}

test "type.union-types/S1 — ? as v binds union success value" {
    assert first_or_zero("42", 2) == 21
    assert first_or_zero("10", 2) == 5
}

// --- U2/M2: a `match` over the union routes the success value to the i32 arm ---
func doubled_or_neg(s: string, b: i32) -> i32 {
    const r = compute(s, b, 1000000)
    const out = match r {
        i32 as v => v * 2
        ParseError => -1
        DivError => -1
        RangeError => -1
    }
    return out
}

test "type.union-types/M2 — match routes success to the value arm" {
    assert doubled_or_neg("42", 2) == 42
    assert doubled_or_neg("10", 5) == 4
}

func main() {}
