// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Two native-only breakages from #403:
//   - a SCREAMING_CASE module let read as a type, so `CT.to_string()`
//     compiled to a call to a function named `CT_to_string`;
//   - `[T; N]` in a type annotation losing the array's length, so `a.len()`
//     failed dispatch on the annotated form while the un-annotated one worked.

func triangular(n: i64) -> i64 {
    mut sum = 0
    mut i = 1
    while i <= n { sum = sum + i; i = i + 1 }
    return sum
}

const TRI: i64 = comptime triangular(5)
const PLAIN: i64 = 15
const LABEL: string = "hi"

func main() {}

test "a comptime module const answers method calls" {
    assert TRI == 15
    assert TRI.to_string() == "15"
    assert "{TRI}" == "15"
}

test "a plain module const answers method calls" {
    assert PLAIN == 15
    assert PLAIN.to_string() == "15"
    assert LABEL.len() == 2
}

test "a module const survives being read twice in one function" {
    let a = TRI
    let b = TRI
    assert a + b == 30
}

test "an annotated fixed-size array knows its length" {
    let a: [i32; 5] = [0; 5]
    assert a.len() == 5
    let b: [i32; 3] = [1, 2, 3]
    assert b.len() == 3
    assert b[2] == 3
}

test "an un-annotated array still knows its length" {
    let a = [0; 4]
    assert a.len() == 4
}
