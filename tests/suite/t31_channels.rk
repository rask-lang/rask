// Channel send / try_receive over scalar element types.

// try_receive() returns `T or E`: Ok(value) when a value is ready, Err on
// empty/closed. Native codegen used to leak the empty status as a present
// value, so a drain loop never terminated (Track 1.6 follow-up). Sends are
// bare here on purpose — a discarded `send()` currently double-sends (tracked
// separately), which would skew the drained counts.

test "try_receive drains an i64 channel then reports empty" {
    let (tx, rx) = Channel<i64>.buffered(8)
    tx.send(10)
    tx.send(20)
    tx.send(30)
    mut sum = 0
    mut n = 0
    while rx.try_receive() is i64 as v {
        sum += v
        n += 1
        if n > 8 {
            assert false, "drain did not terminate"
            return
        }
    }
    assert n == 3
    assert sum == 60
}

test "try_receive drains an f64 channel" {
    let (tx, rx) = Channel<f64>.buffered(8)
    tx.send(1.5)
    tx.send(2.5)
    mut sum = 0.0
    mut n = 0
    while rx.try_receive() is f64 as v {
        sum += v
        n += 1
        if n > 8 {
            assert false, "drain did not terminate"
            return
        }
    }
    assert n == 2
    assert sum == 4.0
}

test "try_receive on an empty channel reports none-equivalent immediately" {
    let (tx, rx) = Channel<i64>.buffered(4)
    mut n = 0
    while rx.try_receive() is i64 as v {
        n += 1
        if n > 4 {
            assert false, "empty channel yielded a value"
            return
        }
    }
    assert n == 0
}

// A discarded `send(x)` must send x exactly once. Native codegen used to
// lower the receiver twice, sending every value twice (#349).
test "a discarded send() sends the value exactly once" {
    let (tx, rx) = Channel<i64>.buffered(8)
    let _ = tx.send(1)
    let _ = tx.send(2)
    let _ = tx.send(3)
    mut n = 0
    while rx.try_receive() is i64 as v {
        n += 1
        if n > 8 {
            assert false, "received more values than were sent"
            return
        }
    }
    assert n == 3
}

func main() {}
