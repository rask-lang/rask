// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// The shapes E0864 and E0865 now reject, written the way they have to be
// written instead (#1090).
//
// A `match` on an integer, a float, a string or a char has more values than a
// list of arms can name, so it needs an arm for the rest. Nothing checked
// that, and the two backends did different things with what fell through:
//
//     func pick(x: i32) -> string {
//         return match x { 1 => "one", 2 => "two" }
//     }
//     pick(9)     native: prints nothing, exit 0
//                 interp: panic "no matching arm", exit 101
//
// An enum is different and stays different: its variants are finite, so
// covering them all is exhaustive with no wildcard written. That's E0340, and
// this file keeps a case of it to make sure the new rule didn't swallow it.
//
// `break 42` from a `while` or a `for` is E0865. Those forms end with no value
// when their condition goes false, so there is nowhere for one to go —
// `loop` is the form that produces a value (ctrl.flow/CF20, CF21).

enum Colour {
    Red
    Green
    Blue
}

func name_of(c: Colour) -> string {
    // No wildcard, and none needed: three variants, three arms.
    match c {
        Colour.Red => return "red"
        Colour.Green => return "green"
        Colour.Blue => return "blue"
    }
}

test "an enum is exhausted by its variants" {
    assert name_of(Colour.Red) == "red"
    assert name_of(Colour.Blue) == "blue"
}

func describe(n: i64) -> string {
    return match n {
        0 => "zero"
        1 => "one"
        _ => "many"
    }
}

test "an integer match needs the arm for the rest, and uses it" {
    assert describe(0) == "zero"
    assert describe(1) == "one"
    assert describe(2) == "many"
    assert describe(-7) == "many"
}

// A bare name binds rather than tests, so it closes the match the same way `_`
// does — and unlike `_` it can say what it caught.
func classify(n: i64) -> string {
    return match n {
        0 => "zero"
        other => "nonzero"
    }
}

test "a binding arm closes it too" {
    assert classify(0) == "zero"
    assert classify(5) == "nonzero"
}

func initial(c: char) -> string {
    return match c {
        'a' => "first"
        'z' => "last"
        _ => "middle"
    }
}

test "the same rule for a char" {
    assert initial('a') == "first"
    assert initial('z') == "last"
    assert initial('m') == "middle"
}

func greet(who: string) -> string {
    return match who {
        "world" => "hello, world"
        _ => "hello, stranger"
    }
}

test "and for a string" {
    assert greet("world") == "hello, world"
    assert greet("you") == "hello, stranger"
}

// `loop` is the form that produces a value, so a break value belongs here.
func first_over(limit: i64) -> i64 {
    mut i = 0
    return loop {
        if i > limit {
            break i
        }
        i = i + 1
    }
}

test "a break value comes out of a loop" {
    assert first_over(3) == 4
    assert first_over(0) == 1
}

// The `while` a `break 42` wanted, written as CF20 says: the test moves inside
// a `loop`.
func first_over_while(limit: i64) -> i64 {
    mut i = 0
    return loop {
        if !(i <= limit) {
            break i
        }
        i = i + 1
    }
}

test "the while form rewritten as a loop" {
    assert first_over_while(3) == 4
}

// A `while` and a `for` still break — without a value.
func count_to(limit: i64) -> i64 {
    mut i = 0
    while true {
        if i >= limit {
            break
        }
        i = i + 1
    }
    return i
}

test "a bare break still ends a while" {
    assert count_to(4) == 4
}

func sum_until(stop: i64) -> i64 {
    mut total = 0
    for i in 0..10 {
        if i == stop {
            break
        }
        total = total + i
    }
    return total
}

test "and a for" {
    assert sum_until(4) == 6
    assert sum_until(0) == 0
}

func main() {
    println("match and break rules ok")
    return
}
