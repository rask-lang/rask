// SPDX-License-Identifier: (MIT OR Apache-2.0)
// ER18 block form: `{ … } catch e => return …`. A `try` inside the block belongs to
// the handler, not the caller. Native used to lower the block's own value as if
// it were a Result and tag-test it (#480).

struct LowError { detail: string }

extend LowError {
    func message(self) -> string {
        return self.detail
    }
}

func low(fail: bool) -> i64 or LowError {
    if fail {
        return LowError { detail: "low failed" }
    }
    return 10
}

func doubled(fail: bool) -> i64 or LowError {
    let v = try {
        try low(fail)
    } catch _e => {
        return LowError { detail: "handled" }
    }
    return v * 2
}

test "block value passes through when nothing fails" {
    match doubled(false) {
        i64 as v => assert v == 20
        LowError as _e => assert false, "expected a value"
    }
}

test "a try inside the block runs the handler" {
    match doubled(true) {
        i64 as _v => assert false, "expected the handler"
        LowError as e => assert e.message() == "handled"
    }
}

// ER18's handler covers the block, so this `try` propagates a `ParseError` to
// `_e` and not to the function's `LowError`. The checker used to match it
// against the function's error type instead — the handler-covers-the-block path
// looked for the opposite AST nesting and never fired — and the mismatch was
// swallowed because a stdlib name deferred rather than resolving (#950).
func parsed(s: string) -> f64 or LowError {
    let v = try {
        try s.parse<f64>()
    } catch _e => {
        return LowError { detail: "not a number" }
    }
    return v + 1.0
}

test "float parse inside a try block" {
    match parsed("3.5") {
        f64 as v => assert v == 4.5
        LowError as _e => assert false, "expected a value"
    }
    match parsed("junk") {
        f64 as _v => assert false, "expected the handler"
        LowError as e => assert e.message() == "not a number"
    }
}
