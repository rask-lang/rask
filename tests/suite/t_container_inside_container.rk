// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A container inside a container element (#1035).
//
// A container is a byte store: it knows how big an element is and is told once,
// at construction, where the *strings* inside one element sit. That list could
// only say "string", so freeing a `Vec<Order>` freed each element's `name` and
// left each element's `items` vector to nobody. Every entry now carries a kind
// as well — string, Vec or Map — and the nested container's own list travels
// with it, so freeing the outer one walks all the way down without any level
// knowing what the next holds.
//
// Two things had to move with it:
//
//   A literal's elements are *adopted*, not copied. `rask_vec_from_static` is
//   handed the bytes of `[Order { … }, Order { … }]` and takes them over — the
//   array they came from is a temporary the frame never frees. A string still
//   needs the reference, because the locals that built `"{a}"` release their
//   own on the way out, but a nested container is not refcounted and cloning it
//   there would leave the original with no owner at all.
//
//   `Map.clone()` retains into a scratch copy rather than in place. Retaining a
//   nested container replaces the handle with a clone, and doing that to the
//   source would leave the original pointing at nothing.
//
// `tests/leak_gate.sh` counts the allocations. What this file pins is that the
// frees land on the right memory — a double free shows up as a crash or as
// garbage read back, which is what `inv.orders[1].items[1].qty` did while this
// was half-built (it answered 3643808010019265059, then 0).
//
// Spec: specs/memory/ownership.md — a value is freed once, where its last owner
// ends.

struct Item {
    name: string
    qty: i32
}

struct Order {
    id: i32
    items: Vec<Item>
}

struct Inventory {
    orders: Vec<Order>
    by_name: Map<string, Vec<i32>>
}

func stock() -> Inventory {
    mut lookup: Map<string, Vec<i32>> = Map.new()
    let one: Vec<i32> = [1]
    let two: Vec<i32> = [2, 3]
    lookup.insert("a", one)
    lookup.insert("bc", two)
    return Inventory {
        orders: [
            Order { id: 1, items: [Item { name: "a", qty: 1 }] },
            Order { id: 2, items: [Item { name: "b", qty: 2 }, Item { name: "c", qty: 3 }] },
        ],
        by_name: lookup,
    }
}

test "mem.ownership — reading three levels down through two containers" {
    let inv = stock()
    assert inv.orders.len() == 2
    assert inv.orders[1].items.len() == 2
    assert inv.orders[1].items[1].name == "c"
    // The one that came back as garbage: a nested read after the outer element
    // had been released a statement too early.
    assert inv.orders[1].items[1].qty == 3
    assert inv.orders[0].items[0].qty == 1
}

test "mem.ownership — a Map whose values are containers" {
    let inv = stock()
    assert inv.by_name.len() == 2
    assert inv.by_name["bc"].len() == 2
    assert inv.by_name["bc"][1] == 3
    assert inv.by_name["a"][0] == 1
}

test "mem.ownership — built by push rather than from a literal" {
    mut items: Vec<Item> = Vec.new()
    items.push(Item { name: "x", qty: 7 })
    mut orders: Vec<Order> = Vec.new()
    orders.push(Order { id: 9, items: items })
    assert orders.len() == 1
    assert orders[0].items[0].qty == 7
    assert orders[0].items[0].name == "x"
}

test "mem.ownership — cloning a container of containers is a deep copy" {
    let inv = stock()
    mut copy = inv.orders.clone()
    copy.push(Order { id: 3, items: Vec.new() })
    // The clone grew and the original didn't, and the shared level is still
    // readable through both.
    assert copy.len() == 3
    assert inv.orders.len() == 2
    assert copy[1].items[1].qty == 3
    assert inv.orders[1].items[1].qty == 3
}

test "mem.ownership — cloning a Map of containers leaves the original intact" {
    let inv = stock()
    let copy = inv.by_name.clone()
    assert copy.len() == 2
    assert copy["bc"][0] == 2
    assert inv.by_name["bc"][0] == 2
}

// Repeatedly, so a buffer freed and handed back out would read wrong rather
// than merely leak.
test "mem.ownership — the whole shape in a loop" {
    mut total = 0
    for i in 1..6 {
        let inv = stock()
        total = total + inv.orders[1].items[1].qty + inv.by_name["bc"][1]
    }
    assert total == 30
}
