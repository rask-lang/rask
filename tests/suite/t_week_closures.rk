// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Week one: closures, and the higher-order collection methods that take them.
//
// `|x| expr` for one expression, `|x| { ... }` for a block, zero and several
// parameters, capturing a surrounding binding, a closure in a binding called
// later, a closure passed to a function, and a closure returned from one. Then
// the Vec methods that exist to take one: map, filter, fold, reduce, any, all,
// find, position, sort_by — plus Map's read and modify.
//
// Two neighbours are missing rather than broken: `flat_map` works on the
// interpreter and has no native lowering (#886), and `remove_where`/`take_where`
// are declared but unimplemented on both (#912, with the rest of that set in
// `t_week_collection_stubs.rk`).

func apply(f: func(i32) -> i32, x: i32) -> i32 {
    return f(x)
}

func apply_twice(f: func(i32) -> i32, x: i32) -> i32 {
    return f(f(x))
}

func adder(k: i32) -> func(i32) -> i32 {
    return |x| x + k
}

test "a one-expression closure" {
    let double = |x| x * 2
    assert double(21) == 42
    assert double(0) == 0
    assert double(-3) == -6
}

test "a block-bodied closure" {
    let classify = |x| {
        if x > 0: "pos"
        else if x < 0: "neg"
        else: "zero"
    }
    assert classify(1) == "pos"
    assert classify(-1) == "neg"
    assert classify(0) == "zero"
}

test "zero and several parameters" {
    let always = || 7
    assert always() == 7
    let add = |a, b| a + b
    assert add(2, 3) == 5
    let sum3 = |a, b, c| a + b + c
    assert sum3(1, 2, 3) == 6
}

test "a closure captures a surrounding binding" {
    let k = 10
    let add_k = |x| x + k
    assert add_k(1) == 11
    assert add_k(-10) == 0
}

test "a closure passed to a function" {
    assert apply(|x| x + 1, 41) == 42
    assert apply_twice(|x| x * 2, 3) == 12
    let k = 5
    assert apply(|x| x + k, 1) == 6
}

test "a closure returned from a function" {
    let add5 = adder(5)
    assert add5(1) == 6
    assert add5(10) == 15
    let add0 = adder(0)
    assert add0(9) == 9
}

test "std.collections — map and filter" {
    let v: Vec<i32> = [1, 2, 3, 4, 5]
    let doubled = v.map(|x| x * 2).to_vec()
    assert doubled.count() == 5
    assert doubled[0] == 2
    assert doubled[4] == 10
    let evens = v.filter(|x| x % 2 == 0).to_vec()
    assert evens.count() == 2
    assert evens[0] == 2
    assert evens[1] == 4
}

test "std.collections — map changing the element type" {
    let v: Vec<i32> = [1, 2, 3]
    let labels = v.map(|x| "n{x}").to_vec()
    assert labels.count() == 3
    assert labels[0] == "n1"
    assert labels.join(",") == "n1,n2,n3"
}

test "std.collections — fold and reduce" {
    let v: Vec<i32> = [1, 2, 3, 4]
    assert v.fold(0, |acc, x| acc + x) == 10
    assert v.fold(1, |acc, x| acc * x) == 24
    assert v.fold(100, |acc, x| acc - x) == 90
    assert v.reduce(|a, b| a + b)! == 10
    mut empty: Vec<i32> = Vec.new()
    assert empty.reduce(|a, b| a + b) is none
}

test "std.collections — any, all, find, position" {
    let v: Vec<i32> = [1, 3, 4, 7]
    assert v.any(|x| x % 2 == 0)
    assert !v.any(|x| x > 100)
    assert v.all(|x| x > 0)
    assert !v.all(|x| x % 2 == 1)
    assert v.find(|x| x > 3)! == 4
    assert v.find(|x| x > 100) is none
    assert v.position(|x| x == 4)! == 2
    assert v.position(|x| x == 99) is none
}

test "std.collections — sort_by with a comparison closure" {
    mut v: Vec<i32> = [3, 1, 4, 1, 5]
    v.sort_by(|a, b| b.compare(a))
    assert v[0] == 5
    assert v[4] == 1
    mut w: Vec<i32> = [3, 1, 2]
    w.sort_by(|a, b| a.compare(b))
    assert w[0] == 1
    assert w[2] == 3
}

test "std.collections — chaining higher-order methods" {
    let v: Vec<i32> = [1, 2, 3, 4, 5, 6]
    let total = v.filter(|x| x % 2 == 0).map(|x| x * x).fold(0, |a, b| a + b)
    assert total == 56
}

// `read` applies a plain closure and hands back its result without touching the
// entry. `modify` takes a `|mutate v|` closure — the element changes in place and
// the closure's own return value comes back.
test "std.collections — Map read applies a closure without mutating" {
    mut m: Map<string, i64> = Map.new()
    m.insert("a", 1)
    assert m.read("a", |v| v + 100)! == 101
    assert m.read("zzz", |v| v + 100) is none
    // Untouched.
    assert m.get("a")! == 1
}

test "std.collections — Map modify writes back through a mutate closure" {
    mut m: Map<string, i64> = Map.new()
    m.insert("a", 1)
    let r = m.modify("a", |mutate v: i64| {
        v = v * 10
        return v
    })
    assert r! == 10
    assert m.get("a")! == 10
    let absent = m.modify("zzz", |mutate v: i64| {
        v = v + 1
        return v
    })
    assert absent is none
}

test "std.collections — Vec modify writes back through a mutate closure" {
    mut v: Vec<i64> = [10, 20]
    let r = v.modify(0, |mutate x: i64| {
        x = x + 5
        return x
    })
    assert r! == 15
    assert v[0] == 15
    assert v[1] == 20
}

test "a closure capturing a Vec it then reads" {
    let base: Vec<i32> = [10, 20, 30]
    let at = |i| base[i]
    assert at(0) == 10
    assert at(2) == 30
}

func main() {}
