// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// Iterating a `Set<T>`, which the interpreter does and native can't (#1070).
//
// `Set.iter()` hands back `self.entries.keys()` — an `Iterator<T>` from a
// generic method. MIR can't work out the element type through that, and gives
// up in `lower/stmt:for_loop_elem`. The same loop over the inner map directly
// lowers fine, so it isn't the map or the iterator, it's the generic method's
// return type.
//
// Nothing about this is specific to `Set`: a plain `struct Wrap<T>` with the
// same shape fails identically. It's here because `Set` is where it was found,
// and because a collection written in Rask over another collection is meant to
// be the cheap way to add one.

test "iterating yields every value once" {
    mut s: Set<i64> = Set.new()
    s.insert(1)
    s.insert(2)
    s.insert(1)
    mut total = 0
    mut count = 0
    for v in s.iter() {
        total = total + v
        count = count + 1
    }
    assert count == 2
    assert total == 3
}
