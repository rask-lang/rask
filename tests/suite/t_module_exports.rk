// SPDX-License-Identifier: (MIT OR Apache-2.0)
// What a stdlib module exports came from five hand-written tables across three
// crates, and they'd drifted from the stdlib itself: `import time.Timer` was
// rejected as "not part of this module" even though time.rk declares `Timer`.
// The table is read off each module's own `.rk` file now, so a type is
// importable as soon as the stdlib declares it.

import time.Timer
import os.SysError
import json.JsonParser
import async.TaskGroup
import time
import http
import time.Duration
import http.Response

test "a plain import registers the module's structs" {
    let d = Duration.from_millis(3)
    assert d.as_millis() == 3
}

test "qualified and unqualified spellings name the same type" {
    let via_module = http.Response.ok("x")
    let via_bare = Response.ok("x")
    assert via_module.status == via_bare.status
    assert via_module.status == 200
}

test "a module's namespace struct still carries its functions" {
    // `struct http { }` exists to hang qualified calls off, and isn't itself
    // an exported type — `http.Response` resolves through it either way.
    let r = http.Response.ok("y")
    assert r.status == 200
}
