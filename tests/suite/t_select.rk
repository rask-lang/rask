// conc.select — receive arms, send arms, the default arm, and blocking until a
// producer shows up. Native used to fall straight into arm 0 and run every
// body, so a receive binding was never defined (#405); these keep both backends
// on the same poll-then-fire shape.

import async.Channel

func main() {}

test "A1 — the ready receive arm fires, and its binding is the received value" {
    let (tx1, rx1) = Channel<i64>.buffered(4)
    let (tx2, rx2) = Channel<i64>.buffered(4)
    let _ = tx1.send(7)
    let got = select {
        rx1 -> v: v * 2,
        rx2 -> v: v + 1000,
    }
    assert got == 14
}

test "A1 — a later arm fires when the earlier channel is empty" {
    let (tx1, rx1) = Channel<i64>.buffered(4)
    let (tx2, rx2) = Channel<i64>.buffered(4)
    let _ = tx2.send(3)
    let got = select {
        rx1 -> v: v,
        rx2 -> v: v + 100,
    }
    assert got == 103
}

test "A3 — the default arm fires when nothing is ready" {
    let (tx, rx) = Channel<i64>.buffered(4)
    let got = select {
        rx -> v: v,
        _: -1,
    }
    assert got == -1
}

test "A3 — the default arm does not fire when something is ready" {
    let (tx, rx) = Channel<i64>.buffered(4)
    let _ = tx.send(42)
    let got = select {
        rx -> v: v,
        _: -1,
    }
    assert got == 42
}

test "A2 — a send arm fires when the channel has room" {
    let (tx, rx) = Channel<i64>.buffered(2)
    let got = select {
        tx <- 9: 1,
        _: 0,
    }
    assert got == 1
    mut back = 0
    if rx.receive() is i64 as v { back = v }
    assert back == 9
}

test "select drains one value per evaluation" {
    let (tx, rx) = Channel<i64>.buffered(4)
    let _ = tx.send(1)
    let _ = tx.send(2)
    mut total = 0
    for i in 0..2 {
        total += select {
            rx -> v: v,
            _: 0,
        }
    }
    assert total == 3
}

test "select blocks until a spawned producer sends" {
    using Multitasking {
        let (tx, rx) = Channel<i64>.buffered(1)
        let h = spawn(own || {
            let _ = tx.send(5)
            return 0
        })
        let got = select {
            rx -> v: v,
        }
        assert got == 5
        h.join()
    }
}
