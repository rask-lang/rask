// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Result operators: x! force unwrap, auto-wrap at return, try...else,
// error union composition, error methods.
//
// Spec: type.errors (ER1-ER42)

struct DivError {}

extend DivError {
    func message(self) -> string {
        return "division by zero"
    }
}

struct ParseError {
    detail: string
}

extend ParseError {
    func message(self) -> string {
        return "parse error: {self.detail}"
    }
}

// --- force unwrap (ER15) ---

func safe_div(a: i32, b: i32) -> i32 or DivError {
    if b == 0 { return DivError {} }
    return a / b
}

test "force unwrap present" {
    let result = safe_div(10, 2)
    assert result! == 5
}

// --- auto-wrap at return (ER9) ---

func double(x: i32) -> i32 or DivError {
    return x * 2
}

test "auto-wrap at return" {
    let result = double(21)
    assert result?
    assert result! == 42
}

// --- implicit unit success (ER10) ---

func do_nothing() -> void or DivError {
    // No explicit return — ER10 says implicit unit success
}

test "implicit unit success" {
    let result = do_nothing()
    assert result?
}

// --- try propagation (ER16) ---

func compute(a: i32, b: i32) -> i32 or DivError {
    let x = try safe_div(a, b)
    return x + 1
}

test "try extracts present" {
    let result = compute(10, 2)
    assert result! == 6
}

test "try propagates error" {
    let result = compute(10, 0)
    assert result is DivError
}

// --- try with method chaining ---

func parse_number(s: string) -> i32 or ParseError {
    if s == "42" { return 42 }
    return ParseError { detail: "not a number" }
}

func parse_and_double(s: string) -> i32 or ParseError {
    let n = try parse_number(s)
    return n * 2
}

test "try with chaining" {
    assert parse_and_double("42")! == 84
    assert parse_and_double("bad") is ParseError
}

// --- try...else (ER18) ---

struct ContextError {
    source: string
}

extend ContextError {
    func message(self) -> string {
        return "context: {self.source}"
    }
}

func load_value(s: string) -> i32 or ContextError {
    let n = parse_number(s) catch e => return ContextError { source: e.message() }
    return n
}

test "try else transforms error" {
    let result = load_value("bad")
    assert result is ContextError
}

test "try else passes through" {
    let result = load_value("42")
    assert result! == 42
}

// --- Result methods from spec ---

test "map on present" {
    let result = safe_div(10, 2).map(|v| v * 3)
    assert result! == 15
}

test "map on error" {
    let result = safe_div(10, 0).map(|v| v * 3)
    assert result is DivError
}

test "ok() lifts to Option (present)" {
    let opt = safe_div(10, 2) catch _ => none
    assert opt! == 5
}

test "ok() lifts to Option (absent)" {
    let opt = safe_div(10, 0) catch _ => none
    assert opt is none
}

// Error union composition (`i32 or (A | B)`) and shared-method dispatch on
// union errors live in t19b_union_method_dispatch.rk — native codegen mishandles
// them (union-error family, #375 / rask#211), so they're tracked separately to
// keep this file on the green gate.

// --- match on Result ---

test "match on Result" {
    let result = safe_div(10, 2)
    let value = match result {
        i32 as v => v
        DivError => -1
    }
    assert value == 5
}

// Union error shared-method dispatch (`e.message()` on `A | B`) lives in
// t19b_union_method_dispatch.rk — it needs native union dispatch that isn't
// built yet, so it's tracked separately to keep this file on the green gate.

func main() {}
