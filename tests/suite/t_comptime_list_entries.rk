// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `comptime for` and `comptime if` among a list's entries (ctrl.comptime/CT69–
// CT73): an array, a tuple, a call's arguments or a struct literal's fields,
// one entry per field, without a second mechanism to learn.
import std.reflect

struct Point {
    x: i64
    y: i64
}

struct Tagged {
    id: i64
    label: string
    weight: i64
}

struct Acc {
    total: i64
}

func names<T>() -> Vec<string> {
    return [comptime for f in reflect.fields<T>() { f.name }]
}

func ints(t: Tagged) -> Vec<i64> {
    return [0, comptime for f in reflect.fields<Tagged>() {
        comptime if f.type_name == "i64" { t.(f.name) }
    }, 99]
}

func origin() -> Point {
    return Point(comptime for f in reflect.fields<Point>() { (f.name): 7 })
}

func shifted<T>(a: T, by: i64) -> T {
    return T(comptime for f in reflect.fields<T>() { (f.name): a.(f.name) + by })
}

func pair(p: Point) -> (i64, i64) {
    return (comptime for f in reflect.fields<Point>() { p.(f.name) })
}

func add(mutate acc: Acc, seen: Acc) {
    acc.total += seen.total
}

// The argument's mode follows the parameter's.
func apply<F>(f: F, mutate acc: Acc, seen: Acc) {
    f(comptime for p in reflect.params<F>() {
        comptime if p.is_mutate { mutate acc } else { seen }
    })
}

test "an array of field names" {
    let n = names<Tagged>()
    assert n.len() == 3
    assert n[1] == "label"
}

test "entries chosen per field, between written ones" {
    let v = ints(Tagged(id: 3, label: "a label long enough to live on the heap", weight: 4))
    assert v.len() == 4
    assert v[1] == 3
    assert v[2] == 4
    assert v[3] == 99
}

test "a struct literal's fields" {
    let o = origin()
    assert o.x == 7
    assert o.y == 7
}

test "building a type parameter" {
    let p = shifted(Point(x: 1, y: 2), 10)
    assert p.x == 11
    assert p.y == 12
}

test "a tuple" {
    let t = pair(Point(x: 5, y: 6))
    assert t.0 == 5
    assert t.1 == 6
}

test "a call whose arguments follow the parameters' modes" {
    mut a = Acc(total: 1)
    apply(add, mutate a, Acc(total: 10))
    apply(add, mutate a, Acc(total: 100))
    assert a.total == 111
}
