// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Comparison operators on a user type (type.operators/ORD1) and the Comparable
// bound (type.generics). A struct carries user-defined `lt`/`gt` methods that
// `<`/`>` desugar to (rask-desugar: `a < b` -> `a.lt(b)`). The bodies match
// lexicographic order, which is also what the compiler auto-derives — so the
// same assertions hold whether a backend runs the user body or the derived one.
//
// Deliberately narrow: user-defined `+`/`==` and enum/`<=`/`>=` comparisons on
// user types don't yet round-trip on both backends (filed separately), so this
// file sticks to the operators that do.

struct Version {
    major: i64
    minor: i64
}

extend Version {
    // `<` desugars to `.lt()`
    func lt(self, other: Version) -> bool {
        if self.major != other.major {
            return self.major < other.major
        }
        return self.minor < other.minor
    }
    // `>` desugars to `.gt()`
    func gt(self, other: Version) -> bool {
        if self.major != other.major {
            return self.major > other.major
        }
        return self.minor > other.minor
    }
}

// ORD1: a Comparable bound grants `>`/`<` on the type parameter, resolved to
// the concrete type's comparison at monomorphization.
func largest(a: T, b: T) -> T where T: Comparable {
    if a > b {
        return a
    }
    return b
}

test "type.operators/ORD1 — `<` on a user type compares minor after major" {
    let a = Version { major: 1, minor: 2 }
    let b = Version { major: 1, minor: 5 }
    assert a < b
    assert !(b < a)
}

test "type.operators/ORD1 — `<` on a user type compares major first" {
    let a = Version { major: 1, minor: 9 }
    let c = Version { major: 2, minor: 0 }
    assert a < c
    assert !(c < a)
}

test "type.operators/ORD1 — `>` on a user type" {
    let b = Version { major: 1, minor: 5 }
    let c = Version { major: 2, minor: 0 }
    assert c > b
    assert !(b > c)
}

test "type.generics — Comparable bound grants `>` over a user type" {
    let a = Version { major: 1, minor: 2 }
    let b = Version { major: 1, minor: 5 }
    let big = largest(a, b)
    assert big.major == 1
    assert big.minor == 5
}

// Integer operator semantics — Type Support Summary (integers: Equal + Comparable).
test "type.operators — integer comparison operators" {
    assert 3 == 3
    assert 3 != 4
    assert 2 < 9
    assert 9 > 2
    assert 3 <= 3
    assert 4 >= 4
    assert !(9 < 2)
}


// ── type.operators/P4: `as` binds tighter than every binary operator ─────
//
// `as` used to sit between `+ -` and `* / %`, so `a + b as f64` cast `b` while
// `a / b as f64` cast the whole quotient. Nothing picks that on purpose and it
// only showed up as a bug: `examples/sensor_processor.rk` read 2200.02 °C
// instead of 22.02 once the formatter dropped a pair of parens (#817).

test "type.operators/P4 — a cast takes one operand, whichever operator precedes it" {
    let a: i64 = 8
    let b: i64 = 2

    // The two lines that used to group differently.
    let over: f64 = 4.0 / b as f64
    let plus: f64 = 4.0 + b as f64
    assert over == 2.0
    assert plus == 6.0

    // `%` and `*` too.
    let times: f64 = 4.0 * b as f64
    assert times == 8.0

    // Both sides cast: nothing swallows the other operand.
    let both: f64 = a as f64 / b as f64
    assert both == 4.0
}

test "type.operators/P4 — unary and postfix bind tighter than a cast" {
    let a: i64 = 8
    assert (-a as f64) == -8.0

    let v: Vec<i64> = [1, 2, 3]
    assert (v.len() as f64) == 3.0
}

test "type.operators/P4 — parenthesise to cast a whole expression" {
    let a: i64 = 8
    let b: i64 = 3
    // Integer division first, then the cast — 8/3 is 2, not 2.666…
    let whole: f64 = (a / b) as f64
    assert whole == 2.0
}

test "type.operators/P4 — a cast is looser than comparison and the bitwise ops" {
    let n: i64 = 300
    assert n as f64 > 299.0
    // `as` tighter than `&`: (n as i64) & 0xFF, not n as (i64 & 0xFF)
    assert (n as i64 & 0xFF) == 44
}

func main() {}
