// SPDX-License-Identifier: (MIT OR Apache-2.0)
// The standard stream handles — `io.stdout()`, `io.stderr()`, `io.stdin()`.
//
// None of this worked. All three were empty structs with `@native` on every
// method and no implementation behind any of them on either backend, and
// `close` was declared `mutate self`, which consumes nothing — so a program
// that acquired a handle and closed it right there was still told it leaked:
//
//     mut out = io.stdout()
//     out.close()
//     // error[E0805]: resource `out` must be consumed before scope exit
//
// Two things had to be fixed on top of writing the bodies:
//
//   - `close` takes `self` now. A `@resource` has to be consumed exactly once,
//     and only `take` does that.
//   - Even with `take self`, the check that discharges the obligation gave up:
//     it wanted the receiver's type as a resolved id, and `io.stdout()` hands
//     back the *name* `Stdout`, because a stub's return type is parsed before
//     the type table exists. Method resolution already looked those up by
//     name; ownership didn't.
//
// The handles carry a stream number and go through stdio rather than
// `write(2)`, so their output interleaves with `println` in the order the
// program wrote it — that ordering is what the first test is really checking.

import io

test "std.io — a handle can be acquired and closed" {
    mut out = io.stdout()
    out.close()

    mut err = io.stderr()
    err.close()

    mut inp = io.stdin()
    inp.close()
}

test "std.io — writing text through a handle reports no error" {
    mut out = io.stdout()
    let w = out.write_text("")
    w catch e => {
        assert false
    }
    let f = out.flush()
    f catch e => {
        assert false
    }
    out.close()
}

// W1: `write` answers how many bytes went in.
test "std.io — write answers the byte count" {
    mut out = io.stdout()
    let empty: Vec<u8> = []
    let n = out.write(empty)
    if n is i64 as k {
        assert_eq(k, 0)
    } else as e {
        assert false
    }
    out.close()
}

// W2: `write_bytes` writes them all and answers nothing.
test "std.io — write_bytes takes a byte vector" {
    mut err = io.stderr()
    let empty: Vec<u8> = []
    let w = err.write_bytes(empty)
    w catch e => {
        assert false
    }
    err.close()
}

// Reading from stdin under the test runner would consume input the runner
// needs, so this checks the shape the reader gives back rather than the bytes:
// a zero-length buffer reads zero and doesn't fail.
test "std.io — reading into an empty buffer is zero, not an error" {
    mut inp = io.stdin()
    mut buf: Vec<u8> = []
    let n = inp.read(mutate buf)
    if n is i64 as k {
        assert_eq(k, 0)
    } else as e {
        assert false
    }
    inp.close()
}

// Each acquisition is its own handle with its own obligation — two live at
// once, closed in the other order.
test "std.io — two handles at once" {
    mut a = io.stdout()
    mut b = io.stderr()
    let wa = a.write_text("")
    wa catch e => {
        assert false
    }
    let wb = b.write_text("")
    wb catch e => {
        assert false
    }
    b.close()
    a.close()
}

// `ensure` is the other way to discharge the obligation, and the one a program
// with an error path actually wants.
func write_or_fail(text: string) -> void or IoError {
    mut out = io.stdout()
    ensure out.close()
    try out.write_text(text)
    return
}

test "std.io — ensure discharges the handle on both paths" {
    let r = write_or_fail("")
    r catch e => {
        assert false
    }
}

func main() {}
