// SPDX-License-Identifier: (MIT OR Apache-2.0)
// #775: native lowered exactly one reflect thing — `reflect.fields()` as the
// iterable of a `comptime for`. Every other reflect call left the `reflect` name
// for ordinary local lookup, which failed with "unresolved variable `reflect`"
// — a diagnosis pointing at name resolution, which was never the problem.
//
// The interpreter answered these, but four of them wrongly: `is_integer<i32>()`
// came back `false`, and so did `is_float`, `is_vec` and `is_optional`. Both
// backends now fold the same constants from one classifier
// (rask-types/src/reflect.rs), which is what this gates.
import std.reflect
import memory.Handle

struct Point { public x: f64, public y: f64 }

enum Colour { Red, Green }

func field_names() -> string {
    mut out = ""
    comptime for field in reflect.fields<Point>() {
        out = "{out}{field.name}:{field.type_name} "
    }
    return out
}

func main() {}

test "std.reflect/name_of hands back the type's spelling" {
    assert reflect.name_of<Point>() == "Point"
    assert reflect.name_of<Colour>() == "Colour"
}

test "std.reflect/is_struct and is_enum split declared types" {
    assert reflect.is_struct<Point>()
    assert !reflect.is_struct<Colour>()
    assert reflect.is_enum<Colour>()
    assert !reflect.is_enum<Point>()
}

test "std.reflect/is_integer covers the integer primitives" {
    assert reflect.is_integer<i32>()
    assert reflect.is_integer<u8>()
    assert reflect.is_integer<i64>()
    assert reflect.is_integer<usize>()
    assert !reflect.is_integer<f64>()
    assert !reflect.is_integer<Point>()
}

test "std.reflect/is_float is the two float widths" {
    assert reflect.is_float<f64>()
    assert reflect.is_float<f32>()
    assert !reflect.is_float<i32>()
}

test "std.reflect/container predicates match the base name" {
    assert reflect.is_vec<Vec<i32>>()
    assert !reflect.is_vec<Point>()
    assert reflect.is_map<Map<string, i32>>()
    assert !reflect.is_map<Vec<i32>>()
}

test "std.reflect/is_optional sees the wrapper, not the payload" {
    assert reflect.is_optional<Point?>()
    assert reflect.is_optional<i32?>()
    assert !reflect.is_optional<Point>()
}

test "std.reflect/fields still unrolls in a comptime for" {
    assert field_names() == "x:f64 y:f64 "
}

// #603: `is_public` had no source in `FieldLayout`, so native answered `true`
// for every field while the interpreter read the real visibility — a `private`
// field looked public on one backend and not the other. The layout carries it
// now.
struct Mixed {
    public shown: i64
    private hidden: i64 = 0
}

func visibility_report() -> string {
    mut out = ""
    comptime for field in reflect.fields<Mixed>() {
        out = "{out}{field.name}={field.is_public} "
    }
    return out
}

test "std.reflect — a field's visibility survives to both backends" {
    assert visibility_report() == "shown=true hidden=false "
}

// ── #791: the two that need only the declaration ─────────────────────
//
// Five reflect methods answered with an honest error because "neither backend
// has what they need". That was right for `size_of`/`align_of`/`is_copy`, which
// need a size — and the compiler still has two size models that disagree. It was
// wrong for these two: both are questions about the *declaration*, and the
// declaration is exactly what a layout has thrown away by the time it exists.
// Native reads the checker's type table now, the interpreter reads its AST maps,
// and one classifier turns either into the same answer.

@resource
struct Conn {
    public fd: i64
}

struct Entity {
    public id: i64
    public pos: Point
    public alive: bool
}

struct Named {
    public label: string
    public n: i32
}

struct Linked {
    public id: i64
    public peer: Handle<Point>
}

enum Shape { Circle(f64), Square(Point) }

enum Payload { Text(string), Empty }

type NodeId = u64

test "mem.resource-types — is_resource reads the annotation" {
    assert reflect.is_resource<Conn>()
    assert !reflect.is_resource<Point>()
    assert !reflect.is_resource<i64>()
}

test "mem.relocatable/FL2 — the primitives are flat" {
    assert reflect.is_flat<i32>()
    assert reflect.is_flat<u64>()
    assert reflect.is_flat<f64>()
    assert reflect.is_flat<bool>()
    assert reflect.is_flat<char>()
}

test "mem.relocatable/FL1 — the heap-backed types are not" {
    assert !reflect.is_flat<string>()
    assert !reflect.is_flat<Vec<i32>>()
    assert !reflect.is_flat<Map<string, i32>>()
}

test "mem.relocatable/FL1 — a struct follows its fields, recursively" {
    assert reflect.is_flat<Point>()
    assert reflect.is_flat<Entity>()
    assert !reflect.is_flat<Named>()
    // A resource is never flat, whatever it holds.
    assert !reflect.is_flat<Conn>()
}

test "mem.relocatable/FL3 — a handle field keeps a struct flat" {
    assert reflect.is_flat<Handle<Point>>()
    assert reflect.is_flat<Linked>()
}

test "mem.relocatable/FL5 — an enum follows its variant payloads" {
    assert reflect.is_flat<Colour>()
    assert reflect.is_flat<Shape>()
    assert !reflect.is_flat<Payload>()
}

test "type.aliases/T11 — a nominal newtype is as flat as what it wraps" {
    assert reflect.is_flat<NodeId>()
}

test "mem.relocatable/FL1 — an optional follows its payload" {
    assert reflect.is_flat<Point?>()
    assert !reflect.is_flat<Named?>()
}
