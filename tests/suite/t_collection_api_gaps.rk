// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Collection methods that were declared but had no native lowering (#886), and
// the one string split the two backends disagreed about (#888).
//
// Found by calling every declared Vec and Map method on both backends. Six
// reached codegen as "Function not found" while the interpreter's own copy ran:
//
//     Vec_enumerate  Vec_zip  Vec_flatten  Vec_flat_map  Vec_sort_by_key
//     Map_insert_if_missing
//
// `enumerate` got the standalone-adapter treatment `map`/`filter` already had —
// the `IterAdapter::Enumerate` existed, only the spelling without `.iter()` was
// missing. `insert_if_missing` is written in Rask now: a condition around two
// primitives, one source for both backends.
//
// The other four each mention a type parameter of their *own* — `zip`'s `U`,
// `sort_by_key`'s `K` — and nothing resolves those at the call site, so a Rask
// body for them is made with the parameter unsubstituted and lays its result out
// at the wrong width. #887 has the details; they stay native-only until it's
// fixed. Writing `zip` in Rask and watching a `Vec<string>` come back truncated
// is what found it.
//
// `"ab".split("")` answered 2 pieces natively and 4 on the interpreter. An empty
// separator matches at every boundary — before the first character, between each
// pair, and after the last — and the native branch pushed one *byte* per
// character with no empties, which also cut a multi-byte character in half.

test "vec enumerate — standalone, without .iter()" {
    let base: Vec<i64> = [3, 1, 2]
    let pairs = base.enumerate()
    assert_eq(pairs.len(), 3)
    mut indices = 0
    mut values = 0
    for p in pairs {
        indices = indices + p.0.wrap<i64>()
        values = values + p.1
    }
    assert_eq(indices, 3)
    assert_eq(values, 6)
}

test "vec enumerate — through iter() still works" {
    let base: Vec<i64> = [10, 20]
    mut seen = ""
    for p in base.iter().enumerate() {
        seen = "{seen}{p.0}:{p.1} "
    }
    assert_eq(seen, "0:10 1:20 ")
}

test "map insert_if_missing — fills a gap and leaves a value alone" {
    mut m: Map<string, i64> = Map.new()
    m.insert_if_missing("a", || {
        return 9
    })
    assert_eq(m.get("a") ?? -1, 9)

    // Present already: the closure's value is not used.
    m.insert_if_missing("a", || {
        return 100
    })
    assert_eq(m.get("a") ?? -1, 9)
    assert_eq(m.len(), 1)
}

// A value type wider than a word is what caught the substitution half of #887:
// the copy's `f: func() -> V` kept the unsubstituted `V`, so the call through it
// read the return as one word and a string came back as a pointer.
test "map insert_if_missing — a string value survives the closure" {
    mut ms: Map<string, string> = Map.new()
    ms.insert_if_missing("k", || {
        return "hello there"
    })
    assert_eq(ms.get("k") ?? "?", "hello there")

    mut mi: Map<i64, string> = Map.new()
    mi.insert_if_missing(5, || {
        return "five"
    })
    assert_eq(mi.get(5) ?? "?", "five")
}

// #888: an empty separator matches at every boundary.
test "split — an empty separator gives every boundary" {
    let parts = "ab".split("").to_vec()
    assert_eq(parts.len(), 4)
    assert_eq(parts.join("|"), "|a|b|")

    // One character: a boundary each side.
    assert_eq("a".split("").to_vec().len(), 3)
    // Nothing at all: the two ends are the same boundary, counted twice.
    assert_eq("".split("").to_vec().len(), 2)
}

test "split — an empty separator walks characters, not bytes" {
    assert_eq("héllo".split("").join("|"), "|h|é|l|l|o|")
}

// The non-empty separators always agreed; they're here so a change to the empty
// case can't quietly move them.
test "split — a real separator is unchanged" {
    assert_eq("a,,b".split(",").to_vec().len(), 3)
    assert_eq("a,,b".split(",").join("|"), "a||b")
    assert_eq(",a,".split(",").join("|"), "|a|")
    assert_eq("".split(",").to_vec().len(), 1)
}

func main() {}
