// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Value semantics: Copy vs move, explicit .clone() independence, the 16-byte
// threshold. Spec: mem.value (VS1-VS7), mem.ownership (O1-O4).
//
// Extends t14_ownership.rk (which covers read-only copy of primitives, string,
// small structs, plus vec move/clone). This file adds mutation-independence
// after clone, the >16-byte move boundary, and a 16-byte tuple copy.
//
// Implicit-copy independence (`mut b = a; b.x = 1` leaves `a` untouched) is
// exercised below — the interpreter used to alias the source storage (#401).

struct Point {
    x: i32
    y: i32
}

// Exactly 16 bytes: two i64. Copy-eligible (VS1, VS6).
struct Vec2 {
    x: i64
    y: i64
}

// 32 bytes > 16: move-only (VS1 size boundary).
struct Big {
    a: i64
    b: i64
    c: i64
    d: i64
}

// --- Primitive copy is independent (VS2) ---

test "mem.value/VS2 — primitive copy is independent" {
    mut a = 5
    mut b = a
    b = 99
    assert a == 5
    assert b == 99
}

// --- Explicit clone yields an independent value (Copy or not) ---

test "mem.value/VS1 — small struct clone is independent" {
    mut p1 = Point { x: 1, y: 2 }
    mut p2 = p1.clone()
    p2.x = 99
    assert p1.x == 1
    assert p2.x == 99
}

test "mem.value/VS1 — large struct clone is independent" {
    mut a = Big { a: 1, b: 2, c: 3, d: 4 }
    mut b = a.clone()
    b.a = 99
    assert a.a == 1
    assert b.a == 99
}

// --- 16-byte tuple is Copy: both bindings usable (VS1, VS6) ---

test "mem.value/VS6 — 16-byte tuple copies, both readable" {
    const t = (100i64, 200i64)
    const u = t
    assert t.0 == 100
    assert u.1 == 200
}

// --- >16-byte struct moves; the new binding owns the value (mem.ownership/O2) ---

test "mem.ownership/O2 — large struct moves to new binding" {
    const a = Big { a: 5, b: 6, c: 7, d: 8 }
    const b = a
    assert b.a == 5
    assert b.d == 8
}

// --- Clone before mutation keeps the source intact across a mutating helper ---

test "mem.value/VS1 — clone survives independent mutation of the copy" {
    const original = Big { a: 10, b: 20, c: 30, d: 40 }
    mut working = original.clone()
    working.a = 111
    working.d = 444
    assert original.a == 10
    assert original.d == 40
    assert working.a == 111
    assert working.d == 444
}

// --- Implicit copy is independent, no .clone() needed (#401, VS1) ---

struct Line {
    a: Point
    b: Point
}

func bump_local(p: Point) -> i32 {
    mut q = p
    q.x = 99
    return q.x
}

test "mem.value/VS1 — implicit mut-binding copy is independent" {
    const a = Point { x: 1, y: 2 }
    mut b = a
    b.x = 99
    assert a.x == 1
    assert b.x == 99
}

test "mem.value/VS1 — assignment copies, source untouched" {
    mut c = Point { x: 5, y: 6 }
    const d = Point { x: 7, y: 8 }
    c = d
    c.x = 100
    assert d.x == 7
}

test "mem.value/VS1 — struct literal captures a copy of each field source" {
    mut p = Point { x: 3, y: 4 }
    const ln = Line { a: p, b: p }
    p.x = 99                // mutate the source after construction
    assert ln.a.x == 3      // the literal captured a copy, not a reference
    assert ln.b.x == 3
}

test "mem.value/VS1 — by-value param is a copy of the argument" {
    const src = Point { x: 7, y: 8 }
    const got = bump_local(src)
    assert got == 99
    assert src.x == 7
}

test "mem.value/VS1 — Vec push stores a copy of the argument" {
    mut a = Point { x: 1, y: 2 }
    mut v = Vec.new()
    v.push(a)
    a.x = 99                // mutate the source after the push
    assert v[0].x == 1      // the vec stored a copy, not a reference
}

func main() {}
