// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Writes through a fixed-array element land in the array (#2089).
//
//     mut grid: [[i64; 3]; 2] = [[1, 2, 3], [4, 5, 6]]
//     for mutate row in grid { row[0] = 0 }
//
// printed `1 4` natively and `0 0` on the interpreter. Each way of reaching an
// element (an index on the left of `=`, a `mutate self` receiver, `for
// mutate`, `with`, a path through a Heap) read the element into a temporary
// and wrote to that. They all take the element's address now.

struct Pt {
    public x: i64
    public y: i64
}

extend Pt {
    func bump(mutate self) {
        self.x += 10
    }
}

struct Room {
    public n: i64
    public name: string
    public pts: [i64; 3]
}

struct House {
    public id: i64
    public main: Room
    public rooms: [Room; 2]
}

struct Node {
    public id: i64
    public arr: [i64; 3]
}

func mkr(k: i64) -> Room {
    return Room(n: k, name: "room {k}, long enough to allocate a heap string", pts: [k, k, k])
}

test "for mutate over a fixed array" {
    mut grid: [[i64; 3]; 2] = [[1, 2, 3], [4, 5, 6]]
    for mutate row in grid {
        row[0] = 0
    }
    assert grid[0][0] == 0
    assert grid[1][0] == 0
}

test "a field assignment and a mutate receiver" {
    mut ps: [Pt; 2] = [Pt(x: 1, y: 2), Pt(x: 3, y: 4)]
    ps[1].x = 44
    ps[0].bump()
    assert ps[0].x == 11
    assert ps[1].x == 44
}

test "with on an element" {
    mut rs: [Room; 2] = [mkr(1), mkr(2)]
    with rs[1] as r {
        r.n = 20
        r.name = "renamed, long enough to allocate a heap string"
        r.pts[2] = 22
    }
    assert rs[1].n == 20
    assert rs[1].name == "renamed, long enough to allocate a heap string"
    assert rs[1].pts[2] == 22
}

test "an element inside a struct field" {
    mut h = House(id: 0, main: mkr(3), rooms: [mkr(4), mkr(5)])
    with h.rooms[0] as r {
        r.n = 40
    }
    h.main.pts[0] = 30
    h.rooms[1].pts[1] = 51
    assert h.rooms[0].n == 40
    assert h.main.pts[0] == 30
    assert h.rooms[1].pts[1] == 51
}

test "an element behind a Heap" {
    mut node = Heap(Node(id: 1, arr: [0, 0, 0]))
    ensure drop(node)
    node.arr[1] = 5
    assert node.arr[1] == 5
}
