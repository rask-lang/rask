// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A `Handle<T>?` field in a pool element (#438).
//
// `Handle?` is a niche: `none` is a sentinel handle, not a tag plus payload.
// Inside a pool element the field has no checker type to read at the use site,
// so both the read and the `none` construction fell back to the tagged layout —
// which tested a tag that isn't there and stored one where the handle belongs.

struct Node {
    public v: i64
    public next: Handle<Node>?
}

func build() -> Pool<Node> {
    mut p: Pool<Node> = Pool.new()
    let a = p.insert(Node { v: 1, next: none })
    let _b = p.insert(Node { v: 2, next: a })
    return p
}

test "a linked node reaches its successor" {
    let p = build()
    mut found = 0
    for h in p.handles() {
        if p[h].next? as n {
            found = found + p[n].v
        }
    }
    assert found == 1
}

test "an absent handle reads as none" {
    mut p: Pool<Node> = Pool.new()
    let a = p.insert(Node { v: 1, next: none })
    assert p[a].next? == false
}

test "a present handle reads back" {
    mut p: Pool<Node> = Pool.new()
    let a = p.insert(Node { v: 7, next: none })
    let b = p.insert(Node { v: 8, next: a })
    assert p[b].next?
    assert p[p[b].next!].v == 7
}
