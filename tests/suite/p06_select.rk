// PENDING conc.select — `select` is unimplemented on native codegen (MIR
// lowering: `UnresolvedVariable`; #405). Interp evaluates it; native is the gap.
// Expected RED until native select lands. Do NOT assert current (wrong) behavior.

import async.Channel

func main() {}

test "conc.select/A1 — fires the ready receive arm" {
    let (tx1, rx1) = Channel<i64>.buffered(4)
    let (tx2, rx2) = Channel<i64>.buffered(4)
    let _ = tx1.send(7)          // only rx1 is ready
    let got = select {
        rx1 -> v: v,
        rx2 -> v: v + 1000,
    }
    assert got == 7
}

test "conc.select/A3 — default arm when nothing is ready" {
    let (tx, rx) = Channel<i64>.buffered(4)
    let got = select {
        rx -> v: v,
        _: -1,
    }
    assert got == -1
}
