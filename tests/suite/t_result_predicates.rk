// is_ok/is_err on `T or E` and is_some/is_none on `T?` (#482).

struct LoadError { detail: string }

extend LoadError {
    func message(self) -> string {
        return self.detail
    }
}

func load(fail: bool) -> i32 or LoadError {
    if fail {
        return LoadError { detail: "no" }
    }
    return 7
}

func lookup(found: bool) -> i32? {
    if found {
        return 5
    }
    return none
}

test "is_err on the error side" {
    const r = load(true)
    assert r.is_err()
    assert r.is_ok() == false
}

test "is_ok on the value side" {
    const r = load(false)
    assert r.is_ok()
    assert r.is_err() == false
}

test "predicates on a string payload" {
    const r = load(true)
    if r.is_err() {
        assert true
    } else {
        assert false
    }
}

test "is_some and is_none" {
    assert lookup(true).is_some()
    assert lookup(false).is_none()
    assert lookup(true).is_none() == false
    assert lookup(false).is_some() == false
}
