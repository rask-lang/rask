// Failure and absence tests on the two wrapper shapes (#482, #599).

struct LoadError { detail: string }

extend LoadError {
    func message(self) -> string {
        return self.detail
    }
}

func load(fail: bool) -> i32 or LoadError {
    if fail {
        return LoadError { detail: "no" }
    }
    return 7
}

func lookup(found: bool) -> i32? {
    if found {
        return 5
    }
    return none
}

test "the error side answers to its own type" {
    let r = load(true)
    assert r is LoadError
    assert (r is i32) == false
}

test "the value side does too" {
    let r = load(false)
    assert r is i32
    assert (r is LoadError) == false
}

test "the test reads as a condition" {
    let r = load(true)
    if r is LoadError {
        assert true
    } else {
        assert false
    }
}

test "presence and absence" {
    assert lookup(true)?
    assert lookup(false) is none
    assert (lookup(true) is none) == false
    assert lookup(false)? == false
}
