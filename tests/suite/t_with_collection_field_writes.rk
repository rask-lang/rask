// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Writes inside `with collection[key] as elem { ... }` have to survive the block
// when the collection is reached through a struct field. Native decided "is this
// a collection access" from the syntax of the indexed expression, so
// `self.items[0]` missed and the element was copied instead of aliased — scalar
// writes landed in the copy and vanished. Heap-backed writes (a Vec push)
// persisted through the shared buffer, which made it look like it half-worked.

struct Item { public n: i64, public tags: Vec<string> }

struct Bag { public items: Vec<Item> }

extend Bag {
    func new() -> Bag {
        mut v = Vec<Item>.new()
        v.push(Item { n: 1, tags: Vec.new() })
        return Bag { items: v }
    }

    // A scalar write and a heap write in the same block — both must stick.
    func bump(mutate self) {
        with self.items[0] as it {
            it.tags.push("urgent")
            it.n = 99
        }
    }

    func first(self) -> i64 {
        return with self.items[0] as it { it.n }
    }

    // `len()` answers `usize`, so this returns u64 — it read `i64` until the
    // deferred index constraint gave the `with` block a real type and the
    // mismatch became visible (#632).
    func tag_count(self) -> u64 {
        return with self.items[0] as it { it.tags.len() }
    }
}

test "a vec write through a struct field persists past the block" {
    mut b = Bag.new()
    b.bump()
    assert b.first() == 99
}

test "every field written in one block persists" {
    mut b = Bag.new()
    b.bump()
    assert b.first() == 99
    // the heap-backed write always worked — check it didn't regress
    assert b.tag_count() == 1
}

test "the write is visible inside the block too" {
    mut b = Bag.new()
    with b.items[0] as it {
        it.n = 7
        assert it.n == 7
    }
    assert b.first() == 7
}

test "a vec reached by a plain name still works" {
    mut v = Vec<Item>.new()
    v.push(Item { n: 1, tags: Vec.new() })
    with v[0] as it { it.n = 77 }
    let got = with v[0] as it { it.n }
    assert got == 77
}
