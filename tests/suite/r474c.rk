// SPDX-License-Identifier: (MIT OR Apache-2.0)
enum Kind { A, B, C }

struct Msg {
    public kind: Kind
    public path: string
}

func label(k: Kind) -> string {
    match k {
        A => return "A", B => return "B", C => return "C",
    }
}

func kind_from(s: string) -> Kind? {
    if s == "c" { return Kind.C }
    return none
}

func parse(s: string) -> Msg {
    const k = if kind_from(s)? as m { m } else { return Msg { kind: Kind.A, path: "-" } }
    return Msg { kind: k, path: "/health" }
}

func main() {
    const msg = parse("c")
    println("kind={label(msg.kind)} path=[{msg.path}]")
}
