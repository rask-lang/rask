// The predicates the wrappers used to carry are operators now: `x?` for
// presence, `x is none` for absence, `r is E` for failure (#599). This file
// keeps #482's coverage — the shapes had no codegen at all back then.

struct MyErr { detail: string }

extend MyErr {
    func message(self) -> string { return self.detail }
}

func load(fail: bool) -> i32 or MyErr {
    if fail { return MyErr { detail: "no" } }
    return 7
}

func find(hit: bool) -> i64? {
    if hit { return 42 }
    return none
}

test "testing a result's error side" {
    let bad = load(true)
    assert bad is MyErr

    let good = load(false)
    assert (good is MyErr) == false
}

test "presence and absence on an optional" {
    let present = find(true)
    assert present?
    assert (present is none) == false

    let absent = find(false)
    assert absent is none
    assert absent? == false
}

test "tests compose in conditions" {
    let r = load(true)
    mut seen = 0
    if r is MyErr { seen = seen + 1 }
    if r is i32 { seen = seen + 10 }
    assert seen == 1
}
