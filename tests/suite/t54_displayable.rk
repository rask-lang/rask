// SPDX-License-Identifier: (MIT OR Apache-2.0)
// std.fmt/D1–D5 — what `{}` will and won't render, and how it renders it.

struct Point { x: i64, y: i64 }

extend Point with Displayable {
    public func to_string(self) -> string {
        return "({self.x}, {self.y})"
    }
}

enum AppError {
    NotFound(path: string),
    Timeout,
}

// D5: `message()` alone bridges to Displayable — no to_string needed.
extend AppError {
    public func message(self) -> string {
        match self {
            AppError.NotFound(p) => return "not found: {p}",
            AppError.Timeout => return "timed out",
        }
    }
}

// An inherent `to_string` counts too — the conformance is about *having* the
// method, not about writing `with Displayable` next to it. That is what lets a
// stdlib type like `StringView` render without a conformance declaration, and
// what broke when `stdlib/fmt.rk` joined the stub set: a declaration for
// `Displayable` made it look like a trait a program had written, and G1 gates
// those on `extend T with Trait` (#990).
struct Tally { hits: i64 }

extend Tally {
    public func to_string(self) -> string {
        return "{self.hits} hits"
    }
}

test "std.fmt/D3 — an inherent to_string is the conformance" {
    let t = Tally { hits: 3 }
    assert "{t}" == "3 hits"
    assert t.to_string() == "3 hits"
    assert format("{}", t) == "3 hits"
}

test "std.fmt/D3 — a struct that opts in renders through its own to_string" {
    let p = Point { x: 1, y: 2 }
    assert "{p}" == "(1, 2)"
    assert format("{}", p) == "(1, 2)"
    assert p.to_string() == "(1, 2)"
}

test "std.fmt/D5 — an error type renders through message()" {
    let timeout = AppError.Timeout
    assert "{timeout}" == "timed out"
    let missing = AppError.NotFound(path: "/etc/hosts")
    assert "{missing}" == "not found: /etc/hosts"
}

test "std.fmt/S2 — a spec applies to an opted-in type too" {
    let p = Point { x: 1, y: 2 }
    assert "{p:>10}|" == "    (1, 2)|"
    assert "{p:<10}|" == "(1, 2)    |"
    let timeout = AppError.Timeout
    assert format("{:>12}", timeout) == "   timed out"
}

test "std.fmt/D4 — an optional renders once its missing case is supplied" {
    let some: i64? = 5
    assert "{some ?? 0}" == "5"
    let nothing: i64? = none
    assert "{nothing ?? 0}" == "0"
}
