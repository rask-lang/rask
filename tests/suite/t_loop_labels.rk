// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Labeled break/continue reach the loop they name (CF22-CF25, #392).
//
// The interpreter's break/continue signal carried no label, so the innermost
// loop swallowed every one of them — `continue outer` from a nested loop just
// continued the inner loop.

test "continue label skips the outer iteration" {
    mut count = 0
    outer: for i in 0..5 {
        for j in 0..5 {
            if j == 2: continue outer
            count += 1
        }
    }
    // j = 0, 1 each outer round, then on to the next i
    assert count == 10
}

test "break label exits the outer loop" {
    mut seen = 0
    outer: for i in 0..5 {
        for j in 0..5 {
            seen += 1
            if i == 1 && j == 1: break outer
        }
    }
    // 5 full inner rounds for i=0, then j=0 and j=1 for i=1
    assert seen == 7
}

test "break label carries a value out of a loop expression" {
    let found = search: loop {
        for i in 0..10 {
            if i == 7: break search i
        }
        break search -1
    }
    assert found == 7
}

test "an unlabeled break still stops at the nearest loop" {
    mut count = 0
    outer: for i in 0..3 {
        for j in 0..3 {
            if j == 1: break
            count += 1
        }
        count += 10
    }
    assert count == 33
}

test "break value is still a value, not a label" {
    let n = 42
    let got = loop {
        break n
    }
    assert got == 42
}

test "a labeled while is a real label" {
    mut count = 0
    mut i = 0
    outer: while i < 5 {
        i += 1
        mut j = 0
        while j < 5 {
            j += 1
            if j == 2: continue outer
            count += 1
        }
    }
    assert count == 5

    mut hits = 0
    mut a = 0
    stop: while a < 5 {
        a += 1
        mut b = 0
        while b < 5 {
            b += 1
            hits += 1
            if a == 2 && b == 2: break stop
        }
    }
    // 5 inner rounds for a=1, then b=1 and b=2 for a=2
    assert hits == 7
}

test "labeled continue on a loop expression" {
    mut ticks = 0
    let done = spin: loop {
        ticks += 1
        for _ in 0..3 {
            if ticks < 3: continue spin
        }
        break spin ticks
    }
    assert done == 3
}

// Which of the two `break x` means is decided by the enclosing labels, and
// nothing else. Guessing from the next token used to make every one of these a
// jump to a label that doesn't exist, which left the loop's value type open and
// got the binding reported as un-inferrable (#620).

test "a bare variable is a break value, whatever follows it" {
    mut i = 0
    let found = loop {
        if i == 7 { break i }
        i += 1
    }
    assert found == 7

    let s = "done"
    let word = loop {
        break s
    }
    assert word == "done"
}

test "a variable break value works inside a labeled loop too" {
    mut n: i64 = 0
    let got = outer: loop {
        n += 1
        for j in 0..3 {
            if n == 4 { break outer n }
            if j == 2 { continue outer }
        }
    }
    assert got == 4
}

test "a label and a variable can share a name — the label wins" {
    mut hits: i64 = 0
    let got = tick: loop {
        let tick = 99
        hits += 1
        if hits == 2 { break tick hits }
    }
    // `break tick hits` reads as label `tick` with value `hits`, not as
    // breaking out with the local `tick`.
    assert got == 2
}

test "a break value inside a closure in a loop is a value" {
    mut total: i64 = 0
    let n = 5
    let got = loop {
        let add = |x: i64| -> i64 { return x + n }
        total += add(1)
        if total >= 12 { break total }
    }
    assert got == 12
}
