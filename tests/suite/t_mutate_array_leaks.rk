// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A swap through two `mutate` arrays gives the right answer and still leaks.
// The answer is the point here: `let t = a` used to read the caller's slot
// back (#1877). The leak is tracked in tests/known_leaks.txt: a caller never
// releases a parameter its callee moved out of and refilled (#1885).

func mk(i: i64) -> string {
    return "item-{i}-long-enough-to-live-on-the-heap"
}

func swap(mutate a: [string; 2], mutate b: [string; 2]) {
    let t = a
    a = b
    b = t
}

test "swapping two mutate arrays through a local" {
    mut a = [mk(3), mk(4)]
    mut b = [mk(5), mk(6)]
    swap(mutate a, mutate b)
    assert a[0] == mk(5)
    assert b[1] == mk(4)
}
