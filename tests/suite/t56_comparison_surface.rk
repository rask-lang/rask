// The comparison surface the spec calls Comparable/Equatable: `char` and `bool`
// ordering, and tuple equality (TU9). Was the TDD backlog for #406; green on
// both backends since the tuple-store width fix (#548).

func main() {}

test "type.operators/ORD1 — char ordering" {
    assert 'a' < 'b'
    assert 'z' > 'a'
    assert ('a' < 'a') == false
}

test "type.tuples/TU9 — tuple equality" {
    assert (1, 2) == (1, 2)
    assert ((1, 2) == (1, 3)) == false
    assert (1, 2) != (2, 1)
}

test "type.operators — bool ordering (false < true)" {
    assert false < true
    assert (true < false) == false
}
