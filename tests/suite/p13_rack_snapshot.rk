// PENDING analysis.fourth-option — `Rack.snapshot()`, the answer to how a graph
// crosses a task boundary. Interpreter only, like the rest of the Rack work.
//
// A link can't cross: it's a mutable reference to a node, and mem.ownership/T2
// forbids sharing those between tasks. So the *rack* crosses instead. `snapshot`
// deep-copies the graph and re-points every edge inside the copy at the copy, so
// the reader owns everything it can reach and nothing is shared.
//
// It is the delete-time fixup's walk with a different rewrite: delete finds the
// edges into one node and nulls them, snapshot finds the edges out of every node
// and re-points them. Both work because the rack knows its own graph.
import memory.Link
import memory.Rack

struct Node {
    id: i32
    peer: Link<Node>?
    kids: Vec<Link<Node>>
}

func fresh() -> Rack<Node> {
    return Rack.new()
}

func sum(s: Rack<Node>) -> i32 {
    mut t = 0
    for n in s.nodes() { t += n.id }
    return t
}

func main() {}

test "a snapshot is independent of the original" {
    mut s = fresh()
    let a = s.insert(Node { id: 1, peer: none, kids: Vec.new() })
    let b = s.insert(Node { id: 2, peer: none, kids: Vec.new() })

    let copy = s.snapshot()
    assert_eq(copy.len(), 2)
    assert_eq(sum(copy), 3)

    a.id = 100
    b.id = 200
    assert_eq(sum(s), 300)
    assert_eq(sum(copy), 3)        // the copy did not move
}

test "edges inside the copy point at the copy" {
    mut s = fresh()
    let a = s.insert(Node { id: 1, peer: none, kids: Vec.new() })
    let b = s.insert(Node { id: 2, peer: none, kids: Vec.new() })
    a.peer = b

    let copy = s.snapshot()
    b.id = 999                     // move the original's target

    if copy.corresponding(a)? as ca {
        if ca.peer? as cb {
            assert_eq(cb.id, 2)            // followed into the copy, not back
            assert copy.contains(cb)
            assert !s.contains(cb)
        } else {
            assert false               // the edge was lost in the copy
        }
    } else {
        assert false                   // no corresponding node
    }
}

test "links inside a Vec field are re-pointed too" {
    mut s = fresh()
    let parent = s.insert(Node { id: 1, peer: none, kids: Vec.new() })
    let kid = s.insert(Node { id: 2, peer: none, kids: Vec.new() })
    parent.kids.push(kid)

    let copy = s.snapshot()
    kid.id = 999

    if copy.corresponding(parent)? as cp {
        assert_eq(cp.kids.len(), 1)
        if cp.kids.get(0)? as ck {
            assert_eq(ck.id, 2)
            assert copy.contains(ck)
        } else {
            assert false
        }
    } else {
        assert false
    }
}

test "deleting on either side leaves the other alone" {
    mut s = fresh()
    let a = s.insert(Node { id: 1, peer: none, kids: Vec.new() })
    let b = s.insert(Node { id: 2, peer: none, kids: Vec.new() })
    a.peer = b

    mut copy = s.snapshot()
    s.delete(b)

    assert_eq(s.len(), 1)
    assert_eq(copy.len(), 2)       // the copy still has both

    // And the copy's edge survived, because its target was never deleted.
    if copy.corresponding(a)? as ca {
        if ca.peer? as _cb { } else { assert false }
    } else {
        assert false
    }

    copy.clear()
    assert_eq(s.len(), 1)          // clearing the copy doesn't touch the original
}

test "corresponding says none for a node this rack never copied" {
    mut left = fresh()
    mut right = fresh()
    let l = left.insert(Node { id: 1, peer: none, kids: Vec.new() })
    let _r = right.insert(Node { id: 2, peer: none, kids: Vec.new() })

    let copy = right.snapshot()
    // `l` is not in `right`, so the snapshot has no copy of it. A link is an
    // address; asking for one across allocations has to be answerable with none.
    if copy.corresponding(l)? as _c {
        assert false
    }
}

test "snapshotting an empty rack is empty" {
    mut s = fresh()
    let copy = s.snapshot()
    assert copy.is_empty()
    assert_eq(copy.len(), 0)
}
