// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A link inside a tuple is an edge like any other (#1795): `delete` has to
// null it, whether the tuple sits in a node or in a local.
import memory.Link
import memory.Rack

struct Cursor {
    at: Link<Node>?
}

struct Node {
    id: i32
    cur: Cursor
}

struct Pair {
    id: i32
    ends: (Cursor, i32)
    back: (i32, Cursor)
}

func main() {}

test "a link inside a tuple in a node is nulled by delete" {
    mut nodes: Rack<Node> = Rack.new()
    let a = nodes.insert(Node(id: 1, cur: Cursor(at: none)))
    mut rack: Rack<Pair> = Rack.new()
    let h = rack.insert(Pair(id: 2, ends: (Cursor(at: none), 7), back: (0, Cursor(at: none))))
    h.ends.0.at = a
    nodes.delete(a)
    assert h.ends.0.at is none
    assert h.ends.1 == 7
}

test "a link inside a tuple local is nulled by delete" {
    mut rack: Rack<Node> = Rack.new()
    let a = rack.insert(Node(id: 1, cur: Cursor(at: none)))
    let b = rack.insert(Node(id: 2, cur: Cursor(at: none)))
    mut t = (Cursor(at: a), 5)
    rack.delete(a)
    assert t.0.at is none
    t.0.at = b
    if t.0.at? as p {
        assert p.id == 2
    } else {
        assert false
    }
}

test "overwriting a tuple in a node moves its edge" {
    mut nodes: Rack<Node> = Rack.new()
    let a = nodes.insert(Node(id: 1, cur: Cursor(at: none)))
    let b = nodes.insert(Node(id: 2, cur: Cursor(at: none)))
    mut rack: Rack<Pair> = Rack.new()
    let h = rack.insert(Pair(id: 2, ends: (Cursor(at: a), 7), back: (0, Cursor(at: a))))
    h.ends = (Cursor(at: b), 8)
    h.back = (5, Cursor(at: b))
    nodes.delete(b)
    assert h.ends.0.at is none
    assert h.back.1.at is none
    assert h.back.0 == 5
}

test "reassigning a tuple local records its links" {
    mut rack: Rack<Node> = Rack.new()
    let a = rack.insert(Node(id: 1, cur: Cursor(at: none)))
    let b = rack.insert(Node(id: 2, cur: Cursor(at: none)))
    mut t = (1, Cursor(at: a))
    t = (2, Cursor(at: b))
    rack.delete(b)
    assert t.1.at is none
}


struct Wrap {
    pair: (i32, Link<Node>?)
}

test "a bare link in a tuple local or a tuple field is nulled by delete" {
    mut rack: Rack<Node> = Rack.new()
    let c = rack.insert(Node(id: 3, cur: Cursor(at: none)))
    let d = rack.insert(Node(id: 4, cur: Cursor(at: none)))
    mut t: (i32, Link<Node>?) = (0, none)
    t.1 = c
    mut w = Wrap(pair: (0, none))
    w.pair.1 = d
    rack.delete(c)
    rack.delete(d)
    assert t.1 is none
    assert w.pair.1 is none
}
