// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `with box.lock() as x` for every payload shape (#477).
//
// A box stores its payload's bytes and the lock hands the block their address.
// For a struct that address is the value, but for anything word-sized — a Map
// or Vec handle, an integer — the value has to be loaded out. Passed straight
// through, `Mutex<Map>` handed the map runtime a pointer to a pointer.

struct Counter { public n: i64 }

extend Counter {
    func bump(mutate self) {
        self.n = self.n + 1
    }
    func get(self) -> i64 {
        return self.n
    }
}

struct Store { public entries: Mutex<Map<string, i64>> }

extend Store {
    func put(self, k: string, v: i64) {
        with self.entries.lock() as mut m {
            m.insert(k, v)
        }
    }
    func size(self) -> u64 {
        return self.entries.lock().len()
    }
}

test "struct payload" {
    let m = Mutex.new(Counter { n: 0 })
    with m.lock() as mut c {
        c.bump()
        c.bump()
    }
    assert m.lock().get() == 2
}

test "map payload" {
    let mm: Mutex<Map<string, i64>> = Mutex.new(Map.new())
    with mm.lock() as mut m {
        m.insert("a", 1)
        m.insert("b", 2)
    }
    assert mm.lock().len() == 2
}

test "vec payload" {
    let mv: Mutex<Vec<i64>> = Mutex.new(Vec.new())
    with mv.lock() as mut v {
        v.push(3)
        v.push(4)
    }
    assert mv.lock().len() == 2
}

test "scalar payload" {
    let mi: Mutex<i64> = Mutex.new(5)
    with mi.lock() as n {
        assert n == 5
    }
}

test "a mutex in a struct field" {
    let s = Store { entries: Mutex.new(Map.new()) }
    s.put("a", 1)
    s.put("b", 2)
    assert s.size() == 2
}
