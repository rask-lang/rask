// SPDX-License-Identifier: (MIT OR Apache-2.0)
// mem.pools PL2/PL8 — a `with_capacity` pool is bounded, `try_insert` refuses
// once it's full, and freeing a slot makes room again. Native had no dispatch
// for `try_insert` at all (#435), so a bounded pool couldn't even compile.

struct Ent { hp: i32 }

func main() {}

test "PL2 — a bounded pool fills to its capacity" {
    mut p = Pool.with_capacity(2)
    p.insert(Ent { hp: 1 })
    p.insert(Ent { hp: 2 })
    assert p.len() == 2
}

test "PL8 — try_insert refuses a full pool" {
    mut p = Pool.with_capacity(2)
    p.insert(Ent { hp: 1 })
    p.insert(Ent { hp: 2 })
    let r = p.try_insert(Ent { hp: 3 })
    if r? as h {
        assert false, "a full pool accepted a third element"
    } else {
        assert p.len() == 2
    }
}

test "PL8 — try_insert succeeds while there is room" {
    mut p = Pool.with_capacity(2)
    let r = p.try_insert(Ent { hp: 1 })
    if r? as h {
        assert p[h].hp == 1
    } else {
        assert false, "an empty bounded pool refused an element"
    }
}

test "a removed element frees its slot" {
    mut p = Pool.with_capacity(2)
    let a = p.insert(Ent { hp: 1 })
    p.insert(Ent { hp: 2 })
    p.remove(a)
    let r = p.try_insert(Ent { hp: 3 })
    if r? as h {
        assert p[h].hp == 3
        assert p.len() == 2
    } else {
        assert false, "the freed slot was not reused"
    }
}

test "an unbounded pool has no limit" {
    mut p = Pool.new()
    for i in 0..8 {
        p.insert(Ent { hp: 1 })
    }
    assert p.len() == 8
    let r = p.try_insert(Ent { hp: 2 })
    if r? as h {
        assert p.len() == 9
    } else {
        assert false, "an unbounded pool refused an element"
    }
}
