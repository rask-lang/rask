// An `extend` header whose target argument is itself generic.
//
// `flatten` was the last eager adapter, and what stopped it was that its
// receiver can't be spelled in an ordinary block. `extend Sequence<T>` gives
// the method a `T` element and nothing to flatten; the receiver has to say its
// element is itself a sequence, and the block header is the only place to
// write that:
//
//     extend Sequence<Sequence<U>> {
//         public func flatten(self) -> Sequence<U> { … }
//     }
//
// The header machinery from #1046 already bound a *tuple* argument member-wise
// — `extend Sequence<(K, V)>` gives `K` and `V` the halves of the element. This
// is the same rule one shape wider: a generic argument binds argument-wise, so
// `U` gets the inner sequence's element rather than the inner sequence.
//
// A bracket-counting bug came with it. `target_type_args` closed the header
// with `trim_end_matches('>')`, which takes *every* trailing bracket:
// `Vec<Vec<T>>` came back as `Vec<T` — a name nothing has, and every method on
// it "not found". One bracket, not all of them.

import sequence.Sequence

func inner_a() -> Sequence<i64> {
    return |yield| {
        if !yield(1) {
            return
        }
        if !yield(2) {
            return
        }
    }
}

func inner_b() -> Sequence<i64> {
    return |yield| {
        if !yield(3) {
            return
        }
    }
}

func nested() -> Sequence<Sequence<i64>> {
    return |yield| {
        if !yield(inner_a()) {
            return
        }
        if !yield(inner_b()) {
            return
        }
    }
}

test "a sequence of sequences flattens one level" {
    let flat = nested().flatten()
    assert flat.count() == 3
    let out: Vec<i64> = nested().flatten().to_vec()
    assert out.len() == 3
    assert out[0] == 1
    assert out[1] == 2
    assert out[2] == 3
}

test "flatten is lazy like every other adapter" {
    let flat = nested().flatten()
    assert flat.count() == 3
    assert flat.count() == 3
}

test "flatten composes with the other adapters" {
    let out: Vec<i64> = nested().flatten().map(|x| x * 10).filter(|x| x > 10).to_vec()
    assert out.len() == 2
    assert out[0] == 20
    assert out[1] == 30
}

// SEQ13a through a flattened chain: the break has to reach the inner source.
test "break through a flattened chain" {
    mut seen = 0
    for x in nested().flatten() {
        seen = seen + 1
        if x == 2 {
            break
        }
    }
    assert seen == 2
}

test "a Vec of Vecs flattens too" {
    let a: Vec<i64> = [1, 2]
    let b: Vec<i64> = [3]
    mut nest = Vec<Vec<i64>>.new()
    nest.push(a)
    nest.push(b)
    assert nest.flatten().count() == 3
    let out: Vec<i64> = nest.flatten().to_vec()
    assert out.len() == 3
    assert out[0] == 1
    assert out[2] == 3
}

test "an empty outer flattens to nothing" {
    mut nest = Vec<Vec<i64>>.new()
    assert nest.flatten().count() == 0
}

test "an empty inner is skipped" {
    let a: Vec<i64> = []
    let b: Vec<i64> = [7]
    mut nest = Vec<Vec<i64>>.new()
    nest.push(a)
    nest.push(b)
    let out: Vec<i64> = nest.flatten().to_vec()
    assert out.len() == 1
    assert out[0] == 7
}

// The bracket-counting half, on a user type: a header argument that is itself
// generic, two levels of brackets to close.
struct Layers<T> {
    public rows: Vec<T>
}

extend Layers<Vec<E>> {
    public func total(self) -> usize {
        mut n = 0
        mut i = 0
        while i < self.rows.len() {
            n = n + self.rows[i].len()
            i = i + 1
        }
        return n
    }
}

test "a user header whose argument is generic" {
    let r1: Vec<i64> = [1, 2, 3]
    let r2: Vec<i64> = [4]
    mut rows = Vec<Vec<i64>>.new()
    rows.push(r1)
    rows.push(r2)
    let l = Layers<Vec<i64>> { rows: rows }
    assert l.total() == 4u64
}

// Writing that literal at all is a third bracket bug, in the parser this time.
// Deciding whether `Name<...>` starts a struct literal was its own hand-written
// scan that only matched a single `>`, and `Layers<Vec<i64>> {` closes both
// brackets with one `>>` token — so the scan never finished, the `<` stayed an
// operator, and the error landed on the `{`. The two neighbouring scans, for
// `Name<...>(` and `Name<...>.`, had handled `>>` all along; this one now calls
// the same function instead of keeping its own copy (#1078).
test "a struct literal whose type argument is itself generic" {
    mut rows = Vec<Vec<i64>>.new()
    let r: Vec<i64> = [1, 2]
    rows.push(r)
    let l = Layers<Vec<i64>> { rows: rows }
    assert l.rows.len() == 1
    assert l.total() == 2u64
}

test "three levels of brackets" {
    let deep = Vec<Vec<Vec<i64>>>.new()
    let l = Layers<Vec<Vec<i64>>> { rows: deep }
    assert l.rows.len() == 0
}

struct Pair<A, B> {
    public a: A
    public b: B
}

test "two type arguments, the second one nested" {
    let v: Vec<i64> = [1]
    let p = Pair<i64, Vec<i64>> { a: 5, b: v }
    assert p.a == 5
    assert p.b.len() == 1
}

// The shared scan also tracks parens and brackets, so a type argument that
// contains its own `(` doesn't run the scan past the enclosing group.
struct Holder<T> {
    public v: T
}

test "a function type as the argument" {
    let h = Holder<func(i64) -> bool> { v: |x| x > 0 }
    let f = h.v
    assert f(3)
}

test "a tuple type as the argument" {
    let t = Holder<(i64, string)> { v: (1, "a") }
    assert t.v.0 == 1
}

// Not a bracket bug — a name one. A field declared `T` is declared `i64?`
// once the struct is instantiated, and the interpreter has to wrap the bare 5
// on the way in or `!` later finds a plain integer. It was looking the field's
// type up under the base name `Holder`, where the field is still `T`; the
// instantiated decl, with `T` substituted, was already built and its name
// thrown away (#1080).
//
// Native has the same bug one shape further out and it is NOT fixed here: an
// optional over an aggregate — `Holder<Vec<i64>?>` — reads back as `none`, and
// a 24-byte struct payload kills the binary (#1081).
test "an optional as the argument" {
    let h = Holder<i64?> { v: 5 }
    assert h.v! == 5
}

// The other side of the same decision: a `<` that really is a comparison, and
// a `>>` that really is a shift.
test "a comparison is still a comparison" {
    let a = 1
    let b = 4
    mut hits = 0
    if a < b {
        hits = hits + 1
    }
    assert hits == 1
    assert (16 >> 2) == 4
}
