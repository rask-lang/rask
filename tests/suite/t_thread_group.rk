// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `ThreadGroup<T>`: threads joined together, for a count known only at run
// time (#1360). A `ThreadHandle` is linear, so a `Vec` can't hold them. The
// group is the same plain-Rask list as `TaskGroup`, and it takes handles from
// `Thread.spawn` or from `ThreadPool.spawn`.

import thread.Thread
import thread.ThreadPool
import thread.ThreadGroup
import async.JoinError

func total(results: Vec<i64 or JoinError>) -> i64 {
    mut sum = 0
    for r in results {
        if r is i64 as v { sum += v }
    }
    return sum
}

test "threads come back in the order they were added" {
    mut group = ThreadGroup<i64>.new()
    ensure group.detach()
    mut i = 0
    while i < 8 {
        let k = i
        group.spawn(|| {
            return k * 10
        })
        i += 1
    }
    let results = group.join_all()
    assert results.len() == 8
    mut n = 0
    for r in results {
        if r is i64 as v { assert v == n * 10 }
        n += 1
    }
}

test "pool handles go in a group too" {
    using ThreadPool(workers: 2) {
        mut group = ThreadGroup<i64>.new()
        ensure group.detach()
        mut i = 1
        while i <= 4 {
            let k = i
            group.add(ThreadPool.spawn(|| {
                return k
            }))
            i += 1
        }
        assert total(group.join_all()) == 10
    }
}

test "an empty group joins to nothing" {
    let group = ThreadGroup<i64>.new()
    assert group.join_all().len() == 0
}

test "a detached group lets its threads finish" {
    mut group = ThreadGroup<i64>.new()
    ensure group.detach()
    group.spawn(|| {
        return 1
    })
}
