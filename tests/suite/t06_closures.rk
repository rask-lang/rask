// Closures, captures, and higher-order functions.

func apply(f: |i32| -> i32, x: i32) -> i32 {
    return f(x)
}

func apply_twice(f: |i32| -> i32, x: i32) -> i32 {
    return f(f(x))
}

test "basic closure" {
    let double = |x: i32| -> i32 { return x * 2 }
    assert double(5) == 10
    assert double(0) == 0
    assert double(-3) == -6
}

test "closure capture" {
    let offset = 10
    let add_offset = |x: i32| -> i32 { return x + offset }
    assert add_offset(5) == 15
    assert add_offset(0) == 10
}

test "closure passed to function" {
    let inc = |x: i32| -> i32 { return x + 1 }
    assert apply(inc, 5) == 6
    assert apply_twice(inc, 5) == 7
}

test "closure with multiple captures" {
    let a = 3
    let b = 7
    let sum = |_: i32| -> i32 { return a + b }
    assert sum(0) == 10
}

func main() {}
