// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Braces in string literals. The interpolation scanner re-emitted a closing
// brace whether or not it had consumed one, so the one-brace string evaluated
// to two characters on the interpreter while native kept it at one (#481).
// That made a JSON string compare unequal to its own opening brace. A brace
// meant as text is written doubled (fmt/F4).

test "type.strings — an escaped brace is one character" {
    let open = "{{"
    let close = "}}"
    assert open.len() == 1
    assert close.len() == 1
    assert (open.byte_at(0) ?? 0) == 123
    assert (close.byte_at(0) ?? 0) == 125
}

test "type.strings — an escaped brace is a usable prefix" {
    let open = "{{"
    let obj = "{open}\"a\":1"
    assert obj.len() == 6
    assert obj.starts_with(open)
    assert obj == "{{\"a\":1"
    assert !obj.starts_with("}}")
}

test "type.strings — escaped braces and interpolation coexist" {
    let empty = "{{}}"
    assert empty.len() == 2
    let n = 7
    let rendered = "{{n={n}}}"
    assert rendered == "{{n=7}}"
    assert rendered.len() == 5
}
