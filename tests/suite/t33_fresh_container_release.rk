// SPDX-License-Identifier: (MIT OR Apache-2.0)

import memory.Pool
import memory.Handle

// A runtime call that hands back a container: does the caller free it?
//
// `container_drop` learns "this call made a container the caller owns" from
// `elem_strs::CTORS`, and that list was written for the constructors —
// `Vec_new`, `Map_new`. Everything else that allocates a container and returns
// it was invisible to the pass, so `let k = m.keys().to_vec()` leaked the Vec.
//
// It only shows up when the result is bound. `v.filter(p).to_vec()` fuses into
// `Vec_new` plus a loop of pushes, so the fresh container *is* a `Vec_new` and
// was always freed — which is why the whole family sat unnoticed (#1050).
//
// The assertions are ordinary correctness; the leak check is the point. This
// file is not in known_leaks.txt, so the gate fails if any of these leaks
// again. Each shape appears twice: bound locally, and handed back out of a
// function — a fresh container returned to the caller must be freed once, by
// the caller, and the second spelling is what catches a double free.

test "skip and take hand back a fresh Vec" {
    let v: Vec<i32> = [1, 2, 3, 4, 5]
    let head = v.take(2).to_vec()
    let tail = v.skip(3).to_vec()
    assert head.count() == 2
    assert tail.count() == 2
    assert head[0] == 1
    assert tail[1] == 5
}

// `keys` and `values` are `Map_` calls that hand back a `Vec`. The drop pass
// used to guess the free from the name prefix, which would have freed a Vec
// with `Map_free` — reading a byte store as a hash table. The free is written
// down in the table now, next to the shape.
test "map keys land in a Vec the caller owns" {
    mut m = Map<string, i64>.new()
    m.insert("a", 1)
    m.insert("b", 2)
    let k = m.keys().to_vec()
    assert k.len() == 2
}

test "map values land in a Vec the caller owns" {
    mut m = Map<string, i64>.new()
    m.insert("a", 10)
    m.insert("b", 20)
    let vs = m.values().to_vec()
    assert vs.len() == 2
}

test "iterating a map builds a Vec of pairs the caller owns" {
    mut m = Map<string, i64>.new()
    m.insert("a", 1)
    m.insert("b", 2)
    mut total = 0
    for (k, v) in m {
        total = total + v
    }
    assert total == 3
}

func head_of(v: Vec<i32>) -> Vec<i32> {
    return v.take(2).to_vec()
}

func tail_of(v: Vec<i32>) -> Vec<i32> {
    return v.skip(3).to_vec()
}

func keys_of(m: Map<string, i64>) -> Vec<string> {
    return m.keys().to_vec()
}

test "a fresh Vec handed back to the caller is freed once" {
    let v: Vec<i32> = [1, 2, 3, 4, 5]
    let head = head_of(v)
    let tail = tail_of(v)
    assert head.len() == 2
    assert tail.len() == 2
    assert v.len() == 5
}

test "a fresh Vec of strings handed back to the caller" {
    mut m = Map<string, i64>.new()
    m.insert("a", 1)
    m.insert("b", 2)
    let k = keys_of(m)
    assert k.len() == 2
    assert m.len() == 2
}

// A pool's accessors are the same shape as a map's: a `Pool_` name handing back
// a `Vec`, which is why the free is written down and not read off the prefix.
test "pool handles land in a Vec the caller owns" {
    mut p = Pool<i32>.new()
    let a = p.insert(1)
    let b = p.insert(2)
    let hs = p.handles()
    assert hs.len() == 2
}

test "draining a pool hands the caller a Vec" {
    mut p = Pool<i32>.new()
    let a = p.insert(1)
    let b = p.insert(2)
    let d = p.drain()
    assert d.len() == 2
    assert p.len() == 0
}

// `values` is the third one, and it hides behind its declared type: the stdlib
// says `Iterator<T>`, but `rask_pool_values` builds the same plain `RaskVec`
// its two neighbours do. Going by the declaration there was nothing to free,
// so it leaked 96 bytes per call.
test "a pool's values land in a Vec the caller owns" {
    mut p = Pool<i32>.new()
    let a = p.insert(1)
    let b = p.insert(2)
    mut n = 0
    for x in p.values() {
        n = n + x
    }
    assert n == 3
}

func handles_of(p: Pool<i32>) -> Vec<Handle<i32>> {
    return p.handles()
}

func values_of(p: Pool<i32>) -> Iterator<i32> {
    return p.values()
}

test "a pool's values handed back to the caller are freed once" {
    mut p = Pool<i32>.new()
    let a = p.insert(4)
    mut n = 0
    for x in values_of(p) {
        n = n + x
    }
    assert n == 4
    assert p.len() == 1
}

test "a pool's handles handed back to the caller are freed once" {
    mut p = Pool<i32>.new()
    let a = p.insert(1)
    let hs = handles_of(p)
    assert hs.len() == 1
    assert p.len() == 1
}
