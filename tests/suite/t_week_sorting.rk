// Week one: sorting.
//
// `sort()` on a Vec of anything comparable, `sort_by(|a, b| …)` with an
// `Ordering` from a comparison closure, descending order by flipping the
// operands, sorting structs on a field, stability, sorting strings, and
// `min`/`max`/`remove_adjacent_duplicates` alongside. `sort_by_key` is left out
// — no native lowering (#886, blocked on #887).

struct Person {
    name: string
    age: i32
}

func ages(v: Vec<Person>) -> string {
    mut parts = Vec.new()
    for p in v {
        parts.push("{p.age}")
    }
    return parts.join(",")
}

func names(v: Vec<Person>) -> string {
    mut parts = Vec.new()
    for p in v {
        parts.push(p.name)
    }
    return parts.join(",")
}

test "std.collections — sort on integers" {
    mut v: Vec<i32> = [3, 1, 4, 1, 5, 9, 2, 6]
    v.sort()
    assert v[0] == 1
    assert v[1] == 1
    assert v[7] == 9
    assert v.len() == 8
}

test "std.collections — sort is a no-op on an empty or single Vec" {
    mut empty: Vec<i32> = Vec.new()
    empty.sort()
    assert empty.is_empty()
    mut one: Vec<i32> = [7]
    one.sort()
    assert one.len() == 1
    assert one[0] == 7
}

test "std.collections — sort on an already-sorted Vec" {
    mut v: Vec<i32> = [1, 2, 3]
    v.sort()
    assert v[0] == 1
    assert v[2] == 3
}

test "std.collections — sort on strings is lexicographic" {
    mut v: Vec<string> = ["pear", "apple", "cherry"]
    v.sort()
    assert v[0] == "apple"
    assert v[1] == "cherry"
    assert v[2] == "pear"
}

test "std.collections — sort on floats" {
    mut v: Vec<f64> = [2.5, 0.5, 1.5]
    v.sort()
    assert v[0] == 0.5
    assert v[2] == 2.5
}

test "std.collections — sort_by ascending" {
    mut v: Vec<i32> = [3, 1, 2]
    v.sort_by(|a, b| a.compare(b))
    assert v[0] == 1
    assert v[1] == 2
    assert v[2] == 3
}

test "std.collections — sort_by descending flips the operands" {
    mut v: Vec<i32> = [3, 1, 4, 1, 5]
    v.sort_by(|a, b| b.compare(a))
    assert v[0] == 5
    assert v[1] == 4
    assert v[4] == 1
}

test "std.collections — sort_by on a struct field" {
    mut v: Vec<Person> = [
        Person { name: "cy", age: 30 },
        Person { name: "ada", age: 20 },
        Person { name: "bo", age: 25 },
    ]
    v.sort_by(|a, b| a.age.compare(b.age))
    assert ages(v) == "20,25,30"
    assert names(v) == "ada,bo,cy"
}

test "std.collections — sort_by on a struct field, descending" {
    mut v: Vec<Person> = [
        Person { name: "ada", age: 20 },
        Person { name: "cy", age: 30 },
        Person { name: "bo", age: 25 },
    ]
    v.sort_by(|a, b| b.age.compare(a.age))
    assert ages(v) == "30,25,20"
}

test "std.collections — sort_by on a string field" {
    mut v: Vec<Person> = [
        Person { name: "cy", age: 1 },
        Person { name: "ada", age: 2 },
        Person { name: "bo", age: 3 },
    ]
    v.sort_by(|a, b| a.name.compare(b.name))
    assert names(v) == "ada,bo,cy"
}

// A stable sort leaves equal elements in the order they were given, so the two
// 20-year-olds keep their input order.
test "std.collections — equal keys keep their input order" {
    mut v: Vec<Person> = [
        Person { name: "first", age: 20 },
        Person { name: "second", age: 20 },
        Person { name: "third", age: 10 },
    ]
    v.sort_by(|a, b| a.age.compare(b.age))
    assert ages(v) == "10,20,20"
    assert names(v) == "third,first,second"
}

test "std.collections — min and max without sorting" {
    let v: Vec<i32> = [3, 1, 4, 1, 5]
    assert v.min()! == 1
    assert v.max()! == 5
    mut empty: Vec<i32> = Vec.new()
    assert empty.min() is none
    assert empty.max() is none
}

test "std.collections — sort then drop adjacent duplicates" {
    mut v: Vec<i32> = [3, 1, 3, 1, 2]
    v.sort()
    v.remove_adjacent_duplicates()
    assert v.len() == 3
    assert v[0] == 1
    assert v[1] == 2
    assert v[2] == 3
}

test "std.collections — reverse after sorting is descending order" {
    mut v: Vec<i32> = [3, 1, 4, 1, 5]
    v.sort()
    v.reverse()
    assert v[0] == 5
    assert v[4] == 1
}

func main() {}
