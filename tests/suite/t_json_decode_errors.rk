// SPDX-License-Identifier: (MIT OR Apache-2.0)
// The three ways json.decode<T> fails (std.json/J3), and that each one names
// what went wrong.
//
// Both backends have to produce the same JsonError variant and the same text —
// native reports from the C decoder, the interpreter from its own walk, and the
// two drifting apart is exactly what this catches.

import json

struct User {
    public name: string
    public age: i64
    public email: string?
}

/// The error text, or "OK" when the decode succeeded.
func failure(body: string) -> string {
    let u = json.decode<User>(body) catch e => {
        return e.message()
    }
    return "OK"
}

test "std.json — a missing required field reports which one" {
    let msg = failure("{{\"name\":\"a\"}}")
    assert msg.starts_with("missing field:")
    assert msg.contains("\"age\"")
}

test "std.json — a missing optional field is not an error" {
    assert failure("{{\"name\":\"a\",\"age\":1}}") == "OK"
}

test "std.json — an explicit null for an optional field is not an error" {
    assert failure("{{\"name\":\"a\",\"age\":1,\"email\":null}}") == "OK"
}

test "std.json — a field of the wrong type reports the field and both types" {
    let msg = failure("{{\"name\":\"a\",\"age\":\"x\"}}")
    assert msg.starts_with("type error:")
    assert msg.contains("age")
    assert msg.contains("found a string")
}

test "std.json — a non-object where a struct is expected is a type error" {
    let msg = failure("[1,2]")
    assert msg.starts_with("type error:")
    assert msg.contains("found an array")
}

test "std.json — truncated input is a parse error" {
    let msg = failure("{{\"name\":")
    assert msg.starts_with("parse error:")
}

test "std.json — empty input is a parse error" {
    assert failure("").starts_with("parse error:")
}

test "std.json — content after the value is a parse error" {
    let msg = failure("{{\"name\":\"a\",\"age\":1}} junk")
    assert msg.starts_with("parse error:")
    assert msg.contains("trailing")
}

test "std.json — a bad escape is a parse error" {
    assert failure("{{\"name\":\"a\\q\",\"age\":1}}").starts_with("parse error:")
}
