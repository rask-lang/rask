// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A box read that ends the box hands the value over without allocating.
//
// `replace` and `take` both read a payload the box is about to overwrite
// or throw away, so neither can return a pointer into the box's own storage.
// The runtime's answer was a fresh block: copy the old value there, hand back
// its address, and let the caller copy out of it. Nothing freed the block, so
// every `replace` leaked its payload's width — sixteen bytes a call for a
// string, eight for a number.
//
// `take` was worse in a quiet way: it was wired to `Cell.get`, the plain
// slot read, because freeing the cell would have dangled the pointer coming
// back. So the box that `take` is supposed to consume stayed allocated,
// header and payload both.
//
// Both write into the caller's own destination now — an aggregate straight into
// its stack slot, a scalar into a word to be loaded back out of. No block, no
// dangling pointer, and `take` frees the cell it consumed.
//
// The values matter as much as the counts here: a payload copied out after the
// free reads as whatever the allocator wrote next, so a wrong answer is a wrong
// answer rather than a quiet leak.
//
// Spec: specs/memory/shared-rack-heap.md — `Cell`/`Mutex` are strategies on `Shared`, and
// `take` is the last read.
import sync.Shared

struct Point {
    public x: i64
    public y: i64
}

// `take` is only for a box holding a resource (conc.sync/SH9), so the payloads
// it hands back are these.
@resource
struct Ticket {
    id: i64
    holder: string
    seat: Point
}

extend Ticket {
    func redeem(take self) -> string {
        return format("{self.holder} {self.id} {self.seat.x},{self.seat.y}")
    }
}

func ticket(id: i64) -> Ticket {
    return Ticket(id: id, holder: "a holder name long enough to allocate", seat: Point(x: id, y: id + 1))
}

test "mem.shared-rack-heap — replace hands back a number" {
    let c = Shared<i64>.local(1)
    assert c.replace(2) == 1
    assert c.replace(3) == 2
    assert c.get() == 3
}

// A string payload: sixteen bytes, so the half-copy that a scalar read would
// make reads as empty rather than as the old value.
test "mem.shared-rack-heap — replace hands back a string" {
    let c = Shared<string>.local("the first value, long enough to allocate")
    let old = c.replace("the second value, also long enough")
    assert old == "the first value, long enough to allocate"
    assert c.get() == "the second value, also long enough"
}

test "mem.shared-rack-heap — replace hands back a struct" {
    let c = Shared<Point>.local(Point(x: 1, y: 2))
    let old = c.replace(Point(x: 3, y: 4))
    assert old.x == 1
    assert old.y == 2
    assert c.get().x == 3
}

// One per turn, so a payload freed early lands on storage the next turn has
// taken and the comparison says so.
test "mem.shared-rack-heap — replace in a loop" {
    let c = Shared<i64>.local(0)
    mut total = 0
    for i in 1..6 {
        total = total + c.replace(i)
    }
    assert total == 10
    assert c.get() == 5
}

test "mem.shared-rack-heap — take consumes the Shared" {
    let c = Shared.local(ticket(7))
    assert c.take().redeem() == "a holder name long enough to allocate 7 7,8"
}

// One consumed and one dropped in the same frame, so the frame's own drop
// doesn't free a cell `take` already gave back.
test "mem.shared-rack-heap — one consumed, one dropped" {
    let b = Shared<i64>.local(2)
    let a = Shared.local(ticket(1))
    assert a.take().redeem() == "a holder name long enough to allocate 1 1,2"
    assert b.get() == 2
}

// A box per turn, consumed each time: a double free lands on one the next turn
// has reused. The string inside passes to the caller, so the box's own free
// must not release it too; a second release lands on a buffer the next turn
// has taken and the comparison says so.
test "mem.shared-rack-heap — a Shared consumed per turn" {
    mut n = 0
    for i in 0..8 {
        let c = Shared.local(ticket(i))
        if c.take().redeem() == format("a holder name long enough to allocate {i} {i},{i + 1}") {
            n = n + 1
        }
    }
    assert n == 8
}

// The locking strategies have their own boxes and their own `take`.
test "mem.shared-rack-heap — take under every strategy" {
    assert Shared.new(ticket(3)).take().redeem() == "a holder name long enough to allocate 3 3,4"
    assert Shared.mutex(ticket(4)).take().redeem() == "a holder name long enough to allocate 4 4,5"
}

test "mem.shared-rack-heap — a string payload replaced per turn" {
    mut n = 0
    for i in 0..8 {
        let c = Shared<string>.local("the first value, long enough to allocate")
        let old = c.replace("the second value, also long enough")
        if old == "the first value, long enough to allocate" {
            n = n + 1
        }
        assert c.get() == "the second value, also long enough"
    }
    assert n == 8
}

// Every primitive width, because the value comes back through a word-sized
// slot and the destination's type decides how it is read out of one. A float
// is the case that can't just be widened: the conversion reads a mismatched
// type as a *number*, not as bits, so an integer load of a double answered
// 4609434218613702700 — and an `f32` slot holds a promoted double, so a
// four-byte read got its zero low half and answered 0.
test "mem.shared-rack-heap — replace at every primitive width" {
    let f = Shared<f64>.local(1.5)
    assert f.replace(2.5) == 1.5
    assert f.get() == 2.5

    let g = Shared<f32>.local(1.5)
    assert g.replace(2.5) == 1.5
    assert g.get() == 2.5

    let i = Shared<i32>.local(7)
    assert i.replace(9) == 7

    let u = Shared<u8>.local(200)
    assert u.replace(11) == 200

    let b = Shared<bool>.local(true)
    assert b.replace(false)

    let c = Shared<char>.local('x')
    assert c.replace('y') == 'x'
    assert c.get() == 'y'
}

// The mutex strategy takes the same two paths under a lock.
test "mem.shared-rack-heap — replace under the mutex strategy" {
    let m = Shared<i64>.mutex(10)
    assert m.replace(20) == 10
    with m.read() as v {
        assert v == 20
    }
}

func main() {}
