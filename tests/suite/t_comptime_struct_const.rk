// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A struct or enum computed at compile time is constant data (ctrl.comptime/CT2),
// not code that rebuilds it at startup. Every field sits at its own width and
// offset: narrow integers, floats, a char, a short string held inline and a
// long one held by pointer, a nested struct, an enum with and without fields.
// A use copies the value out, so changing the copy leaves the const alone.

enum Level {
    Low
    High
}

enum Mode {
    Off
    On(level: i32)
}

struct Point {
    public x: i64
    public y: i64
}

struct Mixed {
    public flag: bool
    public small: i8
    public ratio: f32
    public big: f64
    public letter: char
    public short: string
    public long: string
    public level: Level
    public neg: i32
    public at: Point
}

struct Limits {
    public lo: i64 = 1
    public hi: i64 = 10 * 10
}

const M: Mixed = comptime {
    Mixed(
        flag: true
        small: -5
        ratio: 0.5
        big: 2.25
        letter: 'z'
        short: "hi"
        long: "a string too long to sit inline"
        level: Level.High
        neg: -70000
        at: Point(x: 3, y: 4 * 2)
    )
}
const LOW: Level = comptime { Level.Low }
const ON: Mode = comptime { Mode.On(level: 7) }

// A field's own default, `10 * 10`, is filled in and folded with the rest.
const L: Limits = comptime { Limits() }

test "every field reads back at its own width" {
    assert M.flag
    assert M.small == -5
    assert M.ratio == 0.5
    assert M.big == 2.25
    assert M.letter == 'z'
    assert M.short == "hi"
    assert M.long == "a string too long to sit inline"
    assert M.neg == -70000
    assert M.at.y == 8
    assert L.hi == 100
}

test "enums with and without fields" {
    assert M.level == Level.High
    assert LOW == Level.Low
    let level = match ON {
        Mode.On(level) => level
        Mode.Off => 0
    }
    assert level == 7
}

test "a copy is its own value" {
    mut m = M.clone()
    m.small = 9
    m.long = "changed"
    assert m.small == 9
    assert M.small == -5
    assert M.long == "a string too long to sit inline"
}

func main() {}
