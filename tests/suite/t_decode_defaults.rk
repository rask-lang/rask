// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A field the input leaves out takes its declared default (#853).
//
// `@default(expr)` covered a missing key; a declared default (`tag: string =
// "fallback"`) did not — the decode failed with "missing field" instead. Worse,
// the diagnostic for a `@no_serialize` field tells you to add exactly that:
//
//     error[E0377]: `Rec` cannot be decoded
//         = fix: give `secret` a declared default (`secret: T = value`), or an
//           `@default(expr)` override if the default should only apply to decoding
//
// Adding one made the program compile and then decode `secret` as 0.
//
// `type.structs/FD6` is the rule: `@default` exists to differ from the declared
// default *on decode*, which only means something if the declared one applies
// there in the first place.

import json

struct Rec {
    public name: string
    @no_serialize
    public secret: i64 = 99
    public tag: string = "fallback"
}

struct Wide {
    public name: string
    public n: i64 = 42
    public neg: i64 = -7
    public f: f64 = 2.5
    public b: bool = true
    public s: string = "hi"
    @default(9)
    public overridden: i64 = 1
}

test "std.encoding — a declared default fills a missing key" {
    let r = json.decode<Rec>("{{\"name\": \"bo\"}}")
    if r is Rec as v {
        assert_eq(v.name, "bo")
        assert_eq(v.tag, "fallback")
        assert_eq(v.secret, 99)
    } else as e {
        assert_eq("decode failed: {e}", "")
    }
}

test "std.encoding — every literal kind a default can be" {
    let r = json.decode<Wide>("{{\"name\": \"bo\"}}")
    if r is Wide as v {
        assert_eq(v.n, 42)
        assert_eq(v.neg, -7)
        assert_eq(v.f, 2.5)
        assert(v.b)
        assert_eq(v.s, "hi")
    } else as e {
        assert_eq("decode failed: {e}", "")
    }
}

test "std.encoding — `@default` still wins over the declared one" {
    let r = json.decode<Wide>("{{\"name\": \"bo\"}}")
    if r is Wide as v {
        assert_eq(v.overridden, 9)
    } else as e {
        assert_eq("decode failed: {e}", "")
    }
}

test "std.encoding — a value in the input still wins over the default" {
    let r = json.decode<Wide>("{{\"name\": \"bo\", \"n\": 1, \"s\": \"z\", \"overridden\": 3}}")
    if r is Wide as v {
        assert_eq(v.n, 1)
        assert_eq(v.s, "z")
        assert_eq(v.overridden, 3)
        // Untouched fields keep their defaults.
        assert_eq(v.f, 2.5)
    } else as e {
        assert_eq("decode failed: {e}", "")
    }
}

test "std.encoding — a `@no_serialize` field stays off the wire" {
    let r = Rec { name: "bo", secret: 1, tag: "t" }
    assert_eq(json.encode(r), "{{\"name\":\"bo\",\"tag\":\"t\"}}")
}

// Construction is the other half of the same rule and was never broken —
// here so a change to one is checked against the other.
test "type.structs — a declared default fills an omitted field at construction" {
    let r = Rec { name: "x" }
    assert_eq(r.secret, 99)
    assert_eq(r.tag, "fallback")
}

func main() {}
