    assert x.rotate_right(3) == 2552254560
    // A rotation turns modulo the width: by the width is no turn at all.
    assert x.rotate_left(32) == x
    assert x.rotate_right(32) == x
    assert x.rotate_left(35) == 135534630
    assert x.rotate_right(35) == 2552254560
