    assert ne[3] == 0x8D
    assert ne[4] == 0x0C
    assert ne[5] == 0x8B
    assert ne[6] == 0x0A
    assert ne[7] == 0x89
    assert ne[8] == 0x08
    assert ne[9] == 0x87
    assert ne[10] == 0x06
    assert ne[11] == 0x85
    assert ne[12] == 0x04
    assert ne[13] == 0x83
    assert ne[14] == 0x02
    assert ne[15] == 0xC1
    assert u128.from_be_bytes(be) == x
    assert u128.from_le_bytes(le) == x
    assert u128.from_ne_bytes(ne) == x
    assert u128.from_be_bytes(le) == 64545737377233718443185943936927728321
    assert u128.from_le_bytes([0x30, 0x8F, 0x0E, 0x8D, 0x0C, 0x8B, 0x0A, 0x89, 0x08, 0x87, 0x06, 0x85, 0x04, 0x83, 0x02, 0xC1]) == x
}
