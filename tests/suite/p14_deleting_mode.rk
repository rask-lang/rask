// PENDING analysis.fourth-option — the `deleting` parameter mode. Interpreter
// only, like the rest of the Rack work.
//
// A delete the caller can see needs no declaration: `delete(take link)` consumes
// the link at the call site. A delete that picks its own victim can't be seen from
// outside, so the parameter says `deleting` and the call revokes the caller's
// links. This file is the accepted side — the rejections live in
// tests/compile_errors/rack_delete_undeclared.rk.
import memory.Link
import memory.Rack

struct Node {
    id: i32
    peer: Link<Node>?
}

struct Scene {
    nodes: Rack<Node>
}

extend Scene {
    // On a method the declaration sits on the receiver.
    public func purge(deleting self) -> i32 {
        mut n = 0
        for node in self.nodes.nodes() {
            n += 1
            self.nodes.delete(node)
        }
        return n
    }

    public func count(self) -> usize {
        return self.nodes.len()
    }
}

// Deletes only what it was handed, so it needs nothing.
func drop_one(mutate s: Rack<Node>, take n: Link<Node>) {
    s.delete(n)
}

// Picks its own, so it declares.
func drop_all(deleting s: Rack<Node>) -> i32 {
    mut n = 0
    for node in s.nodes() {
        n += 1
        s.delete(node)
    }
    return n
}

func main() {}

test "a named delete leaves other links alone" {
    mut s: Rack<Node> = Rack.new()
    let a = s.insert(Node { id: 1, peer: none })
    let b = s.insert(Node { id: 2, peer: none })

    drop_one(mutate s, b)

    // `a` came from its own insert, so it cannot be a second name for `b`.
    assert a.id == 1
    assert s.len() == 1
}

test "a deleting call revokes the caller's links" {
    mut s: Rack<Node> = Rack.new()
    let a = s.insert(Node { id: 1, peer: none })
    let b = s.insert(Node { id: 2, peer: none })
    a.peer = b
    // Read what is needed before the call: after it, no link into `s` is usable.
    let before = a.id

    // PM5: the marker follows the signature, so a `deleting` parameter takes
    // `deleting` at the call site — `mutate` would print two contracts the same.
    assert drop_all(deleting s) == 2

    assert before == 1
    assert s.is_empty()
}

test "deleting on a method receiver works the same way" {
    mut sc = Scene { nodes: Rack.new() }
    let _a = sc.nodes.insert(Node { id: 1, peer: none })
    let _b = sc.nodes.insert(Node { id: 2, peer: none })
    assert sc.count() == 2

    assert sc.purge() == 2

    assert sc.count() == 0
}

test "`deleting` is contextual, not reserved" {
    // Still usable as an ordinary name, so adding the mode broke no vocabulary.
    let deleting = 7
    assert deleting == 7
}
