// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `extend` on a nominal newtype, on both backends (#445, #457).
//
// A nominal newtype has no layout of its own, so its methods were looked up
// under the underlying type: native mangled `Label("x").shout()` to
// `string_shout`, and the interpreter looked for methods on the literal type
// name "nominal". Keying by the newtype's own name fixes both.

type UserId = u64 with (Hashable, Comparable)
type Label = string

extend UserId {
    func next(self) -> UserId {
        return UserId(self.value + 1)
    }
    func is_admin(self) -> bool {
        return self.value == 1
    }
}

extend Label {
    func shout(self) -> string {
        return self.value.to_uppercase()
    }
}

test "methods on a newtype over an integer" {
    let u = UserId(5)
    assert u.value == 5
    assert u.next().value == 6
    assert u.is_admin() == false
    assert UserId(1).is_admin()
}

test "methods on a newtype over a string" {
    let l = Label("hey")
    assert l.shout() == "HEY"
    assert l.value.len() == 3
}

test "the underlying value's own methods still reach through" {
    let u = UserId(5)
    assert u.value.to_string() == "5"
}

test "a newtype as a map key" {
    mut m: Map<UserId, string> = Map.new()
    m.insert(UserId(1), "root")
    m.insert(UserId(2), "guest")
    assert (m.get(UserId(1)) ?? "MISSING") == "root"
    assert (m.get(UserId(2)) ?? "MISSING") == "guest"
    assert (m.get(UserId(9)) ?? "MISSING") == "MISSING"
}
