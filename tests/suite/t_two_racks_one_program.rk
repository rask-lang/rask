// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// A field read through a `Link<T>` uses `T`'s layout.
//
// A link is the node's address and carries the node's layout, which is what
// makes `l.field` an ordinary base+offset projection (mem.racks/RK2). Lowering
// didn't ask it: the field index was resolved from a `MirType::Struct` and
// nothing else, so a link fell through to index 0.
//
// Index 0 is right whenever the field happens to be laid out first, which is
// why one rack in a program worked. Two racks over different node types did
// not: a node with its `Vec` first was fine and a node with a `string` first
// read the string's header as a vector handle. It printed
// 2336353779914121313 for a length of 0, or segfaulted in `Vec.push`.
//
// One rack per program is the whole reason this went unnoticed — every rack
// test in the suite has exactly one node type.
//
// Spec: specs/memory/racks.md — RK2, a link is an address into the rack that
// owns the node.
import memory.Rack
import memory.Link

// The container first, so index 0 is the right answer here.
struct Slot {
    public kids: Vec<Link<Slot>>
    public n: i32
}

// A string first, so index 0 is the wrong one.
struct Labelled {
    public label: string
    public kids: Vec<Link<Labelled>>
}

// A third shape: two scalars ahead of the container.
struct Counted {
    public a: i64
    public b: i64
    public kids: Vec<Link<Counted>>
}

test "mem.racks/RK2 — two node types in one program" {
    mut slots: Rack<Slot> = Rack.new()
    let s = slots.insert(Slot { kids: Vec.new(), n: 1 })
    assert s.kids.len() == 0
    assert s.n == 1

    mut labels: Rack<Labelled> = Rack.new()
    let l = labels.insert(Labelled { label: "a label long enough to allocate", kids: Vec.new() })
    assert l.kids.len() == 0
    assert l.label == "a label long enough to allocate"
}

test "mem.racks/RK2 — and three, with the container at three offsets" {
    mut slots: Rack<Slot> = Rack.new()
    mut labels: Rack<Labelled> = Rack.new()
    mut counted: Rack<Counted> = Rack.new()

    let s = slots.insert(Slot { kids: Vec.new(), n: 7 })
    let l = labels.insert(Labelled { label: "another label, also long enough", kids: Vec.new() })
    let c = counted.insert(Counted { a: 10, b: 20, kids: Vec.new() })

    assert s.n == 7
    assert l.label == "another label, also long enough"
    assert c.a == 10
    assert c.b == 20
    assert s.kids.len() == 0
    assert l.kids.len() == 0
    assert c.kids.len() == 0
}

// Pushing through the link, which is what crashed: the handle read out of the
// wrong offset went straight to `Vec.push`.
test "mem.racks/RK2 — pushing an edge through each" {
    mut labels: Rack<Labelled> = Rack.new()
    let a = labels.insert(Labelled { label: "the first node's label is long", kids: Vec.new() })
    let b = labels.insert(Labelled { label: "the second node's label is too", kids: Vec.new() })
    a.kids.push(b)
    assert a.kids.len() == 1
    assert a.kids[0].label == "the second node's label is too"

    mut counted: Rack<Counted> = Rack.new()
    let x = counted.insert(Counted { a: 1, b: 2, kids: Vec.new() })
    let y = counted.insert(Counted { a: 3, b: 4, kids: Vec.new() })
    x.kids.push(y)
    assert x.kids.len() == 1
    assert x.kids[0].b == 4
}

// Writing through the link as well as reading, so a wrong offset corrupts the
// neighbouring field rather than only reading it.
test "mem.racks/RK2 — writing a field through a link" {
    mut labels: Rack<Labelled> = Rack.new()
    let a = labels.insert(Labelled { label: "before, and long enough to allocate", kids: Vec.new() })
    a.label = "after, and long enough as well"
    assert a.label == "after, and long enough as well"
    assert a.kids.len() == 0

    mut counted: Rack<Counted> = Rack.new()
    let x = counted.insert(Counted { a: 1, b: 2, kids: Vec.new() })
    x.b = 99
    assert x.a == 1
    assert x.b == 99
    assert x.kids.len() == 0
}

// Interleaved, so a per-program answer that happened to be set by the first
// rack would show up.
test "mem.racks/RK2 — interleaved inserts" {
    mut slots: Rack<Slot> = Rack.new()
    mut labels: Rack<Labelled> = Rack.new()
    mut total = 0
    for i in 1..5 {
        let s = slots.insert(Slot { kids: Vec.new(), n: i.clamp<i32>() })
        let l = labels.insert(Labelled { label: "node {i} with a long enough label", kids: Vec.new() })
        total = total + s.n.clamp<i64>() + l.label.len().wrap<i64>()
    }
    assert total == 134
}
