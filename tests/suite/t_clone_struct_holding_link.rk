// A struct holding a `Link<T>?` clones like any other: the link is copied, the
// vectors beside it are cloned. Deriving `clone` asked only `Vec` and `Map`
// among the stdlib's generic types, so a link field left the struct with no
// derived `clone`, and native copied it in place. The copy shared the
// source's vectors and read them after the source was freed (#1972). With the
// clone deep, the vectors it makes inside each element have to be recorded
// with the rack too, or a delete leaves the clone's deeper links dangling.
import memory.Link
import memory.Rack

struct Leaf {
    id: i32
}

struct Tree {
    at: Link<Leaf>?
    kids: Vec<Tree>
}

func depth(t: Tree) -> i64 {
    mut at = t.clone()
    mut n = 0
    while at.kids.len() > 0 {
        at = at.kids[0].clone()
        n += 1
    }
    return n
}

test "a link clones as the same edge" {
    mut leaves: Rack<Leaf> = Rack.new()
    let a = leaves.insert(Leaf(id: 4))
    let b = a.clone()
    let o: Link<Leaf>? = a
    let c = o.clone()
    assert b.id == 4
    assert c!.id == 4
}

test "an element of a tree's kids clones on its own" {
    mut leaves: Rack<Leaf> = Rack.new()
    let a = leaves.insert(Leaf(id: 1))
    mut v: Vec<Tree> = Vec.new()
    v.push(Tree(at: a, kids: Vec.new()))
    let t = Tree(at: none, kids: v)
    let n = t.kids[0].clone()
    assert n.kids.len() == 0
    assert n.at!.id == 1
}

test "a clone outlives the tree it was taken from" {
    mut leaves: Rack<Leaf> = Rack.new()
    let a = leaves.insert(Leaf(id: 2))
    mut t = Tree(at: a, kids: Vec.new())
    for _i in 0..5 {
        mut v: Vec<Tree> = Vec.new()
        v.push(t)
        t = Tree(at: none, kids: v)
    }
    assert depth(t) == 5
    let c = t.kids[0].kids[0].clone()
    t = Tree(at: none, kids: Vec.new())
    assert depth(c) == 3
    assert depth(t) == 0
}

test "a delete reaches the links deep inside a clone" {
    mut leaves: Rack<Leaf> = Rack.new()
    let a = leaves.insert(Leaf(id: 5))
    mut t = Tree(at: a, kids: Vec.new())
    for _i in 0..3 {
        mut v: Vec<Tree> = Vec.new()
        v.push(t)
        t = Tree(at: none, kids: v)
    }
    let c = t.clone()
    leaves.delete(a)
    assert t.kids[0].kids[0].kids[0].at is none
    assert c.kids[0].kids[0].kids[0].at is none
}
