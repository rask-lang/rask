// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A struct with a `string? or MyErr` field.
//
// It didn't type-check: the derived `==` and hash split the field into two
// branches, `string?` and `MyErr`, but a flat `T? or E` has three: the value,
// `none` and the error (#1446). They now build their arms the same way the
// derived clone does.

enum MyErr {
    Bad(string)
}

extend MyErr {
    func message(self) -> string {
        return "bad"
    }
}

struct Maybe {
    r: string? or MyErr
}

func found(s: string) -> string? or MyErr {
    return s
}

func missing() -> string? or MyErr {
    return none
}

func failed(why: string) -> string? or MyErr {
    return MyErr.Bad(why)
}

test "each branch equals itself and nothing else" {
    let a = Maybe { r: found("here") }
    let b = Maybe { r: found("here") }
    let c = Maybe { r: found("there") }
    let n = Maybe { r: missing() }
    let e = Maybe { r: failed("x") }
    assert a == b
    assert a != c
    assert a != n
    assert n == Maybe { r: missing() }
    assert n != e
    assert e == Maybe { r: failed("x") }
    assert e != Maybe { r: failed("y") }
    assert e != a
}

test "hash follows equality and tells the branches apart" {
    let a = Maybe { r: found("here") }
    let n = Maybe { r: missing() }
    let e = Maybe { r: failed("here") }
    assert a.hash() == Maybe { r: found("here") }.hash()
    assert a.hash() != n.hash()
    assert n.hash() != e.hash()
}

test "clone keeps the branch and the payload" {
    let a = Maybe { r: found("here") }
    let copy = a.clone()
    assert copy == a
    let got = match copy.r {
        string as s => s,
        none => "none",
        MyErr as err => "err",
    }
    assert got == "here"
}
