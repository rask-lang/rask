// Raw OS threads (conc.async/S3, S4). Thread.spawn needs no runtime scope and
// works on both backends — bare `spawn` (green tasks) is interp-undefined
// (#267), so these use Thread.spawn per t36's cross-task ownership patterns.
// Payloads are scalar i64 to sidestep the native aggregate-channel bug (#387).
import thread.Thread

// S3/H2: a thread computes a value; the result comes back over a channel while
// join() confirms the thread finished (Thread.spawn's handle is void).
test "conc.async/S3 — thread returns a computed value via channel" {
    let (tx, rx) = Channel<i64>.buffered(1)
    Thread.spawn(own || {
        mut acc = 0
        mut i = 1
        while i <= 10 {
            acc += i
            i += 1
        }
        let _ = tx.send(acc)
        return
    }).join()
    mut got = 0
    if rx.receive() is i64 as v {
        got = v
    }
    assert got == 55
}

// S4: every spawned thread yields a must-use handle; join each before draining.
// Cloned senders (t36) give each thread an independent handle to one channel.
test "conc.async/S4 — spawn multiple threads and join each" {
    let (tx, rx) = Channel<i64>.buffered(4)
    let txa = tx.clone()
    let txb = tx.clone()
    let txc = tx.clone()
    let h1 = Thread.spawn(own || { let _ = txa.send(100); return })
    let h2 = Thread.spawn(own || { let _ = txb.send(200); return })
    let h3 = Thread.spawn(own || { let _ = txc.send(300); return })
    h1.join()
    h2.join()
    h3.join()
    mut total = 0
    mut n = 0
    while rx.try_receive() is i64 as v {
        total += v
        n += 1
        if n > 3 {
            assert false, "drain did not terminate"
            return
        }
    }
    assert n == 3
    assert total == 600
}

// mem.ownership/T2: `own` moves captures into the thread, which then owns them.
// A moved Vec is summed inside the thread; the result returns over a channel.
test "mem.ownership/T2 — own moves a Vec into the thread" {
    let (tx, rx) = Channel<i64>.buffered(1)
    mut data = Vec.new<i64>()
    data.push(7)
    data.push(8)
    data.push(9)
    Thread.spawn(own || {
        mut s = 0
        for x in data {
            s += x
        }
        let _ = tx.send(s)
        return
    }).join()
    mut owned = 0
    if rx.receive() is i64 as v {
        owned = v
    }
    assert owned == 24
}

// H2: join() waits for the thread's side effect to be observable. The thread
// pushes into a channel the main thread only reads after join returns.
test "conc.async/H2 — join happens-before the reader" {
    let (tx, rx) = Channel<i64>.buffered(1)
    let h = Thread.spawn(own || {
        let _ = tx.send(42)
        return
    })
    h.join()
    mut seen = -1
    if rx.try_receive() is i64 as v {
        seen = v
    }
    assert seen == 42
}

func main() {}
