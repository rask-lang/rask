// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A container reached through a field gives up its element type.
//
// A field's type arrives as a deferred `HasField` constraint, so at a `for` over
// it — or an index into it — the container is still an unresolved variable. Both
// sites handed back a fresh type variable with nothing tying it to the
// container, so the element type stayed open however the field later resolved.
// The same loop or index on a *local* worked, which is what made it look
// arbitrary (#632):
//
//     let direct = rows[i]        // fine
//     let viafield = w.rows[i]    // E0361: couldn't work out the type
//
// Both now register a constraint that re-runs once the container settles, the
// same shape the `!` fix in #620 used.
//
// Also covered here: `for n in rack.nodes()` reached through a field, which is
// the same question one container further out — the link snapshot has to give
// up its node type before `n.active` can mean anything.
//
// Spec: type.gradual (inference), mem.racks (RK1)
import memory.Rack

struct Entity {
    public hp: i64
    public active: bool
}

struct Row {
    public key: string
    public n: i64
}

struct World {
    entities: Rack<Entity>
    rows: Vec<Row>
    index: Map<string, i64>
}

extend World {
    // for over a Vec field
    func total_n(self) -> i64 {
        mut total = 0
        for r in self.rows {
            total = total + r.n
        }
        return total
    }

    // for over a Vec field, with a method call on the element
    func keys_joined(self) -> string {
        mut out = ""
        for r in self.rows {
            out = "{out}{r.key.to_uppercase()}/"
        }
        return out
    }

    // index into a Vec field, reaching a field of the element. A binding for the
    // whole element would be a silent 24-byte copy — E0871, mem.borrowing/E4.
    func row_at(self, i: u64) -> string {
        return self.rows[i].key
    }

    // index into a Map field, bare binding
    func lookup(self, k: string) -> i64 {
        let v = self.index[k]
        return v
    }

    // for over a Rack field — yields links, which have to reach `Entity`
    func count_active(self) -> i64 {
        mut n = 0
        for e in self.entities.nodes() {
            if e.active {
                n = n + 1
            }
        }
        return n
    }

    // the first node's field, read through the field-reached rack
    func first_hp(self) -> i64 {
        for e in self.entities.nodes() {
            return e.hp
        }
        return -1
    }
}

// The same two loops over locals — the shapes that always worked.
func local_rack_active() -> i64 {
    mut r: Rack<Entity> = Rack.new()
    r.insert(Entity { hp: 10, active: true })
    r.insert(Entity { hp: 20, active: false })
    r.insert(Entity { hp: 30, active: true })
    mut n = 0
    for e in r.nodes() {
        if e.active {
            n = n + 1
        }
    }
    return n
}

func local_rack_total_hp() -> i64 {
    mut r: Rack<Entity> = Rack.new()
    r.insert(Entity { hp: 10, active: true })
    r.insert(Entity { hp: 20, active: false })
    mut total = 0
    for e in r.nodes() {
        total = total + e.hp
    }
    return total
}

func build() -> World {
    mut rows: Vec<Row> = Vec.new()
    rows.push(Row { key: "a", n: 1 })
    rows.push(Row { key: "b", n: 2 })

    mut index: Map<string, i64> = Map.new()
    index.insert("a", 10)
    index.insert("b", 20)

    mut entities: Rack<Entity> = Rack.new()
    entities.insert(Entity { hp: 5, active: true })
    entities.insert(Entity { hp: 7, active: false })
    entities.insert(Entity { hp: 9, active: true })

    return World { entities: entities, rows: rows, index: index }
}

test "type.gradual — a `for` over a Vec field knows its element type" {
    let w = build()
    assert w.total_n() == 3
    assert w.keys_joined() == "A/B/"
}

test "type.gradual — indexing a Vec or Map field into a bare binding" {
    let w = build()
    assert w.row_at(1) == "b"
    assert w.lookup("b") == 20
}

test "mem.racks/RK1 — a rack reached through a field knows its node type" {
    let w = build()
    assert w.count_active() == 2
    assert w.first_hp() == 5
}

test "mem.racks/RK1 — the same loops over a local rack" {
    assert local_rack_active() == 2
    assert local_rack_total_hp() == 30
}

func main() {
    let w = build()
    println("{w.total_n()}")
    println(w.keys_joined())
    println("{w.count_active()}")
    println("{local_rack_active()}")
}
