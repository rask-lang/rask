// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// An array reads like a `Vec` of its element type. It always half did: the
// method lookup found the `Vec` stub and took the declared return type straight
// out of it — and a stub says `Iterator<T>`, with `T` the parameter name and
// nothing substituted for it.
//
// So `[1, 2, 3].filter(…)` ran over a dangling `T`, and anything reading the
// element inherited that:
//
//     let evens: Vec<i64> = v.filter(|x| x % 2i64 == 0i64).to_vec()
//
// `x` had no type, `x % 2i64` had no type, and MIR gave up — "method `rem` on
// receiver of unresolved type". The same line on a `Vec<i64>` was always fine.
// The array question goes to the `Vec` resolver now, with the array's own
// element as the type argument (#1026).

test "iterating an array literal knows the element type" {
    let v = [1i64, 2i64, 3i64]
    let evens: Vec<i64> = v.filter(|x| x % 2i64 == 0i64).to_vec()
    assert evens.len() == 1u64
    assert evens[0] == 2i64
}

test "a method call on the element inside map" {
    let v = [-1i64, 2i64, -3i64]
    let sizes: Vec<i64> = v.map(|x| x.abs()).to_vec()
    assert sizes[0] == 1i64
    assert sizes[2] == 3i64
}

test "strings too — the element isn't always a machine word" {
    let names = ["ada", "grace"]
    let upper: Vec<string> = names.map(|n| n.to_uppercase()).to_vec()
    assert upper[0] == "ADA"
    assert upper[1] == "GRACE"
}

test "floats" {
    let xs = [1.5, 2.5]
    let doubled: Vec<f64> = xs.map(|x| x * 2.0).to_vec()
    assert doubled[0] == 3.0
    assert doubled[1] == 5.0
}

test "the read-only surface, straight through" {
    let v = [3i64, 1i64, 2i64]
    assert v.len() == 3u64
    assert !v.is_empty()
    assert v.contains(2i64)
    assert v.first() == 3i64
    assert v.last() == 2i64
}

test "an empty literal in an annotated slot" {
    let v: Vec<i64> = [].to_vec()
    assert v.len() == 0u64
}

test "a slice keeps the element type as well" {
    let v = [10i64, 20i64, 30i64]
    let s = v[0..2]
    let sum = s.map(|x| x + 1i64).to_vec()
    assert sum[0] == 11i64
    assert sum[1] == 21i64
}

// Slicing a fixed array natively handed `Vec_slice` the array's buffer, and a
// `[T; N]` local *is* its buffer — no header, no length word. It read the first
// element as the header, so `s.len()` answered 2 by luck and every read through
// the slice segfaulted. The array is copied into a real vector first now, the
// same way its borrowed `Vec` methods already were.
test "reading through a slice of a fixed array" {
    let v = [10i64, 20i64, 30i64]
    let s = v[0..2]
    assert s.len() == 2u64
    assert s[0] == 10i64
    assert s[1] == 20i64
}

test "iterating one" {
    let v = [1i64, 2i64, 3i64, 4i64]
    let s = v[1..3]
    mut total = 0i64
    for x in s {
        total = total + x
    }
    assert total == 5i64
}

test "an open-ended range" {
    let v = [1i64, 2i64, 3i64]
    let s = v[1..]
    assert s.len() == 2u64
    assert s[0] == 2i64
}

test "a slice of strings — the element is wider than a word" {
    let names = ["ada", "grace", "alan"]
    let s = names[0..2]
    assert s.len() == 2u64
    assert s[0] == "ada"
    assert s[1] == "grace"
}
