// SPDX-License-Identifier: (MIT OR Apache-2.0)
// json.decode<T> across the types std.json/J7 says are compatible.
//
// `{` opens interpolation in a Rask string, so every JSON literal here writes
// its braces doubled (`{{`) — that's a literal `{` by std.fmt/F4.
//
// Native builds these by describing T to the runtime decoder (a "shape") and
// letting it fill the value in one pass; the interpreter walks the same struct
// declarations itself. The two have to agree, which is what this file checks.

import json

struct Address {
    public street: string
    public zip: u32
}

struct Tag {
    public name: string
    public weight: f64
}

struct Profile {
    public id: u64
    public name: string
    public active: bool
    public score: f64
    public rank: i32
    public home: Address
    public nicknames: Vec<string>
    public counts: Vec<i64>
    public tags: Vec<Tag>
    public email: string?
    public backup: string?
    public limit: i64?
}

struct Counts {
    public totals: Map<string, i64>
}

struct Point {
    public x: i32
    public y: i32
}

func profile_json() -> string {
    return "{{\"id\":7,\"name\":\"alice\",\"active\":true,\"score\":0.25,\"rank\":-3,\"home\":{{\"street\":\"Main\",\"zip\":1234}},\"nicknames\":[\"al\",\"ali\"],\"counts\":[1,2,3],\"tags\":[{{\"name\":\"x\",\"weight\":1.5}},{{\"name\":\"y\",\"weight\":2.5}}],\"email\":\"a@b.c\",\"backup\":null,\"extra\":\"ignored\"}}"
}

test "std.json — scalar fields decode at their declared width" {
    let p = json.decode<Profile>(profile_json()) catch e => {
        assert false
        return
    }
    assert p.id == 7
    assert p.name == "alice"
    assert p.active
    assert p.score == 0.25
    assert p.rank == -3
}

test "std.json — a nested struct field decodes into its own fields" {
    let p = json.decode<Profile>(profile_json()) catch e => {
        assert false
        return
    }
    assert p.home.street == "Main"
    assert p.home.zip == 1234
}

test "std.json — a Vec field decodes element by element" {
    let p = json.decode<Profile>(profile_json()) catch e => {
        assert false
        return
    }
    assert p.nicknames.len() == 2
    assert p.nicknames[0] == "al"
    assert p.nicknames[1] == "ali"
    assert p.counts.len() == 3
    assert p.counts[2] == 3
}

test "std.json — a Vec of structs keeps each element's fields" {
    let p = json.decode<Profile>(profile_json()) catch e => {
        assert false
        return
    }
    assert p.tags.len() == 2
    assert p.tags[0].name == "x"
    assert p.tags[0].weight == 1.5
    assert p.tags[1].name == "y"
    assert p.tags[1].weight == 2.5
}

// J9: present is Some, explicit null is none, missing is none.
test "std.json — optional fields follow presence, null, and absence" {
    let p = json.decode<Profile>(profile_json()) catch e => {
        assert false
        return
    }
    let email = p.email ?? "missing"
    assert email == "a@b.c"
    assert p.backup is none
    assert p.limit is none
}

// J10
test "std.json — a key with no matching field is ignored" {
    let p = json.decode<Profile>(profile_json()) catch e => {
        assert false
        return
    }
    assert p.name == "alice"
}

test "std.json — decoding then encoding round-trips the whole struct" {
    let p = json.decode<Profile>(profile_json()) catch e => {
        assert false
        return
    }
    let out = json.encode(p)
    assert out.contains("\"id\":7")
    assert out.contains("\"name\":\"alice\"")
    assert out.contains("\"home\":{{\"street\":\"Main\",\"zip\":1234}}")
    assert out.contains("\"nicknames\":[\"al\",\"ali\"]")
    assert out.contains("\"counts\":[1,2,3]")
    assert out.contains("\"tags\":[{{\"name\":\"x\",\"weight\":1.5}},{{\"name\":\"y\",\"weight\":2.5}}]")
    assert out.contains("\"email\":\"a@b.c\"")
    assert out.contains("\"backup\":null")
}

test "std.json — a Map<string, V> field decodes to a real map" {
    let c = json.decode<Counts>("{{\"totals\":{{\"a\":1,\"b\":2}}}}") catch e => {
        assert false
        return
    }
    assert c.totals.len() == 2
    assert c.totals["a"] == 1
    assert c.totals["b"] == 2
}

// A Map has no defined iteration order, so only the pieces are checked.
test "std.json — a decoded Map encodes back to an object" {
    let c = json.decode<Counts>("{{\"totals\":{{\"a\":1,\"b\":2}}}}") catch e => {
        assert false
        return
    }
    let out = json.encode(c)
    assert out.starts_with("{{\"totals\":{{")
    assert out.contains("\"a\":1")
    assert out.contains("\"b\":2")
}

test "std.json — the target can be a bare scalar" {
    let n = json.decode<i64>("42") catch e => {
        assert false
        return
    }
    assert n == 42

    let s = json.decode<string>("\"hi\"") catch e => {
        assert false
        return
    }
    assert s == "hi"

    let f = json.decode<f64>("0.5") catch e => {
        assert false
        return
    }
    assert f == 0.5

    let b = json.decode<bool>("true") catch e => {
        assert false
        return
    }
    assert b
}

test "std.json — the target can be a list at the top level" {
    let pts = json.decode<Vec<Point>>("[{{\"x\":1,\"y\":2}},{{\"x\":3,\"y\":4}}]") catch e => {
        assert false
        return
    }
    assert pts.len() == 2
    assert pts[0].x == 1
    assert pts[1].y == 4
}

// The untyped path (std.json/J4) — same verb, JsonValue as the target.
//
// This used to assert only "not null", because native got it wrong both ways:
// decode<JsonValue> handed back a pointer from the C parser instead of a
// JsonValue, and encode<JsonValue> printed that pointer's value (#689). Both
// halves run the Rask code in stdlib/json.rk now — one parser, one encoder, both
// backends — so the tree can be read and round-tripped for real.
test "std.json — decoding to JsonValue gives the untyped tree" {
    let v = json.decode<JsonValue>("{{\"k\":[1,2]}}") catch e => {
        assert false
        return
    }
    assert v.is_null() == false
    let obj = v.as_object() ?? Map.new()
    let list = (obj.get("k") ?? JsonValue.Null).as_array() ?? Vec.new()
    assert list.len() == 2
    assert list[0].as_number() ?? 0.0 == 1.0
    assert list[1].as_number() ?? 0.0 == 2.0
    assert json.encode(v) == "{{\"k\":[1,2]}}"
}

// Non-ASCII text through both halves. `write_escaped` used to rebuild each byte
// as a char, so every multi-byte sequence got encoded twice: "café" came out
// "cafÃ©". The parser had the same bug reading literal UTF-8 back in.
test "std.json — non-ASCII survives a decode/encode round-trip" {
    let escaped = json.decode<JsonValue>("[\"caf\\u00e9\"]") catch e => {
        assert false
        return
    }
    assert json.encode(escaped) == "[\"café\"]"

    let literal = json.decode<JsonValue>("[\"naïve 日本語\"]") catch e => {
        assert false
        return
    }
    assert json.encode(literal) == "[\"naïve 日本語\"]"

    // Control characters stay escaped, and a real backslash stays doubled.
    assert json.encode(JsonValue.String("a\tb\\c")) == "\"a\\tb\\\\c\""
}

// One value per document (J4). Reading only the first would accept "1 2".
test "std.json — trailing content after the value is a parse error" {
    let v = json.decode<JsonValue>("1 2") catch e => {
        assert e.message().contains("parse error")
        return
    }
    assert false
}

test "std.json — escapes and unicode survive a decode" {
    let s = json.decode<string>("\"a\\nb\\t\\\"c\\\"\\u0041\"") catch e => {
        assert false
        return
    }
    assert s.contains("A")
    assert s.contains("\n")
    assert s.contains("\t")
    assert s.contains("\"c\"")
}

// J5
test "std.json — a repeated key takes its last value" {
    let p = json.decode<Point>("{{\"x\":1,\"y\":2,\"x\":9}}") catch e => {
        assert false
        return
    }
    assert p.x == 9
    assert p.y == 2
}
