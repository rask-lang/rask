// An edge is an edge wherever it is written (mem.racks/RK3).
//
// The first native pass registered edges only where the compiler happened to be
// looking: `rack.insert`, a field assignment, a `Vec.push`. A *literal* fills its
// fields before the value has an address, so there was no slot to record and the
// link stayed live past its target's delete — a dangling node address, native
// only, silent. These pin the holders that don't come from an assignment.
import memory.Link
import memory.Rack

struct Node {
    id: i32
    peer: Link<Node>?
}

struct Cursor {
    at: Link<Node>?
}

struct Holder {
    list: Vec<Link<Node>>
}

func main() {}

test "a link put in a field by a literal is still an edge" {
    mut rack: Rack<Node> = Rack.new()
    let victim = rack.insert(Node { id: 7, peer: none })
    let c = Cursor { at: victim }

    rack.delete(victim)

    if c.at? as _p {
        assert false           // the literal's edge outlived its target
    }
}

test "a whole struct written over a name registers what it carries" {
    mut rack: Rack<Node> = Rack.new()
    let a = rack.insert(Node { id: 1, peer: none })
    mut c = Cursor { at: none }
    c = Cursor { at: a }

    rack.delete(a)

    if c.at? as _p {
        assert false
    }
}

test "a container inside a literal keeps its entries registered" {
    mut rack: Rack<Node> = Rack.new()
    let b = rack.insert(Node { id: 2, peer: none })
    mut v: Vec<Link<Node>> = Vec.new()
    v.push(b)
    let h = Holder { list: v }
    assert_eq(h.list.len(), 1)

    rack.delete(b)

    assert_eq(h.list.len(), 0)
}

// A snapshot leaves a cross-rack edge pointing at the original node — there is
// no copy of it here, and inventing one would be wrong. But the edge still has
// to be *recorded*, or the rack that owns that node can't null this slot when it
// deletes it, and the copy is left holding a freed address.
test "a cross-rack edge inside a snapshot is still nulled by its owner" {
    mut left: Rack<Node> = Rack.new()
    mut right: Rack<Node> = Rack.new()
    let target = left.insert(Node { id: 1, peer: none })
    let holder = right.insert(Node { id: 2, peer: none })
    holder.peer = target

    let copy = right.snapshot()
    left.delete(target)

    if holder.peer? as _p {
        assert false           // the original's edge
    }
    for n in copy.nodes() {
        if n.peer? as _p {
            assert false       // the copy's edge
        }
    }
}
