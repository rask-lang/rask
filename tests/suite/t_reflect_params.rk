// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `reflect.params<F>()` (#1863): each parameter of a function type, with its
// type and mode. A named function reaches it through a type parameter — the
// caller passes `drift` and `F` is drift's type — and `comptime for` unrolls
// over the parameters the way it does over `fields<T>()`, so `p.is<T>()` and
// the mode flags pick which code each parameter gets.
import std.reflect

struct Pos {
    x: f64
    y: f64
}

struct Vel {
    x: f64
    y: f64
}

func drift(mutate p: Pos, v: Vel, take log: Vec<i64>) {
    p.x += v.x
    p.y += v.y
}

/// What a scheduler would read off a system's signature.
func schedule<F>(system: F) -> string {
    mut out = ""
    comptime for p in reflect.params<F>() {
        comptime if p.is<Pos>() && p.is_mutate {
            out = "{out}writes Pos;"
        }
        comptime if p.is<Vel>() && !p.is_mutate && !p.is_take {
            out = "{out}reads Vel;"
        }
        comptime if p.is_take {
            out = "{out}takes {p.type_name};"
        }
    }
    return out
}

test "a named function's parameters, through a type parameter" {
    assert schedule(drift) == "writes Pos;reads Vel;takes Vec<i64>;"
}

test "a closure's parameters reflect the same way" {
    assert schedule(|mutate p: Pos| { p.x = 0.0 }) == "writes Pos;"
}

/// How many parameters of `F` are exactly `T`.
func count_of<T, F>(f: F) -> i64 {
    mut n = 0
    comptime for p in reflect.params<F>() {
        comptime if p.is<T>() {
            n += 1
        }
    }
    return n
}

func mixed(a: Pos, b: Pos?, c: i64) {}

test "is<T> compares the exact type, T from the enclosing instantiation" {
    assert count_of<Pos>(mixed) == 1
    assert count_of<Pos?>(mixed) == 1
    assert count_of<i64>(mixed) == 1
    assert count_of<string>(mixed) == 0
}

test "params as a value, from a written function type" {
    let ps = reflect.params<func(i64, mutate Pos, take Vec<i64>)>()
    assert ps.len() == 3
    assert ps[0].index == 0
    assert ps[0].type_name == "i64"
    assert !ps[0].is_mutate && !ps[0].is_take
    assert ps[1].type_name == "Pos"
    assert ps[1].is_mutate
    assert ps[2].type_name == "Vec<i64>"
    assert ps[2].is_take
}

test "a function with no parameters has none" {
    assert reflect.params<func() -> i64>().len() == 0
}

func with_array(mutate p: Pos, grid: [i64; 3]) -> [i64; 2] {
    return [grid[0], grid[1]]
}

test "an array in the signature keeps the other types named" {
    // The interpreter rendered the whole type as `<type#N>` once anything in
    // it was an array, and `is<Pos>()` came back false.
    assert schedule(with_array) == "writes Pos;"
    assert count_of<Pos>(with_array) == 1
}

/// An inner loop reusing the name sees its own items, and the outer binding
/// comes back after it.
func shadowed<F>(f: F) -> string {
    mut out = ""
    comptime for p in reflect.params<F>() {
        for p in reflect.params<func(i64, bool)>() {
            out = "{out}{p.type_name},"
        }
        out = "{out}{p.type_name};"
    }
    return out
}

test "a loop inside comptime for can reuse the binding's name" {
    assert shadowed(mixed) == "i64,bool,Pos;i64,bool,Pos?;i64,bool,i64;"
}
