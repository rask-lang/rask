// `assert` runs its operands once.
//
// A comparison assert wants the two sides' values for the failure message, and
// it got them by lowering each side and then lowering the whole condition —
// which lowered both sides again. So `assert push(v) == 1` pushed twice, and
// any assert over a call that did work did that work twice. Native only; the
// interpreter evaluated the condition once and only re-read the sides when the
// assert actually failed.
import sync.Shared
import sync.Mutex

func bump(m: Shared<i64, Mutex>) -> i64 {
    with m.write() as n {
        n = n + 1
    }
    return 7
}

test "a call on the left runs once" {
    let m = Shared.mutex(0)
    assert bump(m) == 7
    with m.write() as n {
        assert n == 1
    }
}

test "a call on the right runs once" {
    let m = Shared.mutex(0)
    assert 7 == bump(m)
    with m.write() as n {
        assert n == 1
    }
}

test "an inequality runs its sides once" {
    let m = Shared.mutex(0)
    assert bump(m) != 0
    with m.write() as n {
        assert n == 1
    }
}

test "an ordering comparison runs its sides once" {
    let m = Shared.mutex(0)
    assert bump(m) > 3
    with m.write() as n {
        assert n == 1
    }
}

test "calls on both sides run once each" {
    let a = Shared.mutex(0)
    let b = Shared.mutex(0)
    assert bump(a) == bump(b)
    with a.write() as n {
        assert n == 1
    }
    with b.write() as n {
        assert n == 1
    }
}

test "string comparison still reports both sides" {
    let a = "hello"
    let b = "hello"
    assert a == b
}
