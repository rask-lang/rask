//
// Correct programs the checker-hardening branch rejected at first, found by
// an adversarial review. Each one has to keep compiling and give the same
// answer on both backends.

enum Color { Red, Green, Blue }

// The same variant on both sides of a tuple pattern tests twice and binds
// nothing. It was read as `Color.Red` bound twice.
func same(a: Color, b: Color) -> i32 {
    return match (a, b) {
        (Color.Red, Color.Red) => 1,
        _ => 0,
    }
}

test "a variant repeated in a tuple pattern is a test, not a binding" {
    assert same(Color.Red, Color.Red) == 1
    assert same(Color.Red, Color.Blue) == 0
}

// A `mut v` inside the loop is a new vector; growing it doesn't touch the
// one being walked.
test "a loop can grow a new binding that shadows the walked one" {
    mut v = Vec.from([1, 2, 3])
    mut total = 0
    for x in v {
        mut v = Vec.from([0])
        v.push(x)
        total += v.len().to<i32>()!
    }
    assert total == 6
}

// `as` on a numerically bounded type parameter is left to the instantiation.
func widen<T: Integer>(x: T) -> i128 {
    return x as i128
}

test "as on a bounded type parameter compiles" {
    assert widen(4) == 4
}
