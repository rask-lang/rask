// type.operators — user-defined and derived operators on structs/enums.
// Was PENDING (native computed on struct addresses instead of dispatching to
// the user method, #399) — fixed by #536; both backends agree now.

func main() {}

struct Vec2 { x: i32, y: i32 }
extend Vec2 {
    func add(self, o: Vec2) -> Vec2 { return Vec2 { x: self.x + o.x, y: self.y + o.y } }
    func mul(self, o: Vec2) -> Vec2 { return Vec2 { x: self.x * o.x, y: self.y * o.y } }
}

test "type.operators — user + and * on a struct" {
    let a = Vec2 { x: 1, y: 2 }
    let b = Vec2 { x: 3, y: 4 }
    let s = a + b
    assert s.x == 4
    assert s.y == 6
    let p = a * b
    assert p.x == 3
    assert p.y == 8
}

test "type.operators/EQ2 — derived struct equality by fields" {
    let a = Vec2 { x: 1, y: 2 }
    let b = Vec2 { x: 1, y: 2 }
    let c = Vec2 { x: 9, y: 9 }
    assert a == b
    assert (a == c) == false
}

enum Level { Low, Mid, High }
extend Level {
    func message(self) -> string { return "level" }
}

test "type.operators/EQ2-ORD1 — enum equality and ordering" {
    assert Level.Mid == Level.Mid
    assert (Level.Low == Level.High) == false
    assert Level.Low < Level.High
}
