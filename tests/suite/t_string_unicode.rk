// SPDX-License-Identifier: (MIT OR Apache-2.0)
// The string operations that walk text have to walk scalars, not bytes, and
// agree with the interpreter about what whitespace is (#840, #841).
//
// Four things were wrong on native, all invisible until the text stopped being
// ASCII:
//
//   "\u{00A0}hi".trim()          // kept the non-breaking space
//   "a\u{00A0}b".split_whitespace()  // one item, not two
//   '\u{00A0}'.is_whitespace()   // false
//   "Wörld".reverse()            // swapped the two halves of `ö`
//
// The runtime tested for ' ', '\t', '\n' and '\r' and reversed bytes. The
// interpreter goes through Rust, which uses Unicode White_Space and scalars,
// so every one of these was a silent disagreement between the backends.
//
// `trim_indices` and `char_indices` didn't exist on native at all — the first
// had no codegen entry, the second had neither an entry nor a runtime function.

const nbsp = "\u{00A0}"
const ideographic = "\u{3000}"

test "std.strings — trimming knows Unicode whitespace" {
    assert_eq("{nbsp}hi{nbsp}".trim(), "hi")
    assert_eq("{ideographic}hi{ideographic}".trim(), "hi")
    assert_eq("\u{2003}hi".trim_start(), "hi")
    assert_eq("hi\u{2003}".trim_end(), "hi")
    // Still ASCII-correct.
    assert_eq("  hi\t\n".trim(), "hi")
    assert_eq("".trim(), "")
    assert_eq("hi".trim(), "hi")
}

test "std.strings — splitting on whitespace knows Unicode whitespace" {
    mut n = 0
    mut joined = ""
    for w in "a{nbsp}b\tc".split_whitespace() {
        joined = "{joined}[{w.to_string()}]"
        n = n + 1
    }
    assert_eq(n, 3)
    assert_eq(joined, "[a][b][c]")
}

test "std.strings — a char knows whether it's whitespace" {
    assert('\u{00A0}'.is_whitespace())
    assert('\u{3000}'.is_whitespace())
    assert('\u{000B}'.is_whitespace())
    assert(' '.is_whitespace())
    assert('\t'.is_whitespace())
    assert(!'a'.is_whitespace())
    assert(!'ö'.is_whitespace())
}

test "std.strings — reverse works on graphemes" {
    assert_eq("Wörld".reverse(), "dlröW")
    assert_eq("abc".reverse(), "cba")
    assert_eq("".reverse(), "")
    assert_eq("é".reverse(), "é")
    // Reversing twice is the identity, which byte-reversal also satisfies —
    // the point is that one reversal is still valid text.
    assert_eq("Wörld".reverse().reverse(), "Wörld")

    // A combining mark stays on the character it belongs to. Scalar reversal
    // leaves the accent looking for a letter (std.strings/U2).
    assert_eq("cafe\u{0301}".reverse(), "\u{0065}\u{0301}fac")
}

// The trimmed region's byte range is `s.trim().span()` (std.strings) — which
// needs slices to be ranges rather than copies, the same gap V5's
// implementation notes record. `trim_indices` returned a bare (usize, usize)
// and is gone; coverage returns with `.span()`.

test "std.strings — char_indices pairs a byte offset with a scalar" {
    mut out = ""
    for (i, c) in "hé!".char_indices() {
        out = "{out}{i}:{c} "
    }
    assert_eq(out, "0:h 1:é 3:! ")

    mut count = 0
    for (_, _) in "".char_indices() {
        count = count + 1
    }
    assert_eq(count, 0)
}

func main() {}
