// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// Where the two backends still disagree about `{x:debug}`. Tracked, not fixed.
//
// Native renders what the runtime can read on its own: a Vec of scalars or
// strings elementwise, a tuple positionally, a struct or enum from its layout.
// A Vec of aggregates, or a Map, needs per-element recursion it doesn't have,
// so those come out as `[…]` and `{…}` — the shape, without the contents.
//
// The interpreter walks values, so it renders all of them fully. Neither
// backend is wrong about anything it prints; native is incomplete, and the
// interpreter is the reference for what the answer should be.
//
// Two separate gaps:
//   - a Vec of aggregates and a Map render elided natively (this file)
//   - a tuple is a Vec in the interpreter, so it prints `[1, "x"]` where native
//     prints `(1, "x")` — #1063, a value-model gap rather than a formatting one
//
// The assertions below are written against native. They fail on the
// interpreter, which is the point: this is what has to converge.

struct Point {
    x: i64
    y: i64
}

func main() {
    let ps: Vec<Point> = [Point { x: 1, y: 2 }].iter().to_vec()
    println("{ps:debug}")

    let nested: Vec<Vec<i64>> = [].iter().to_vec()
    println("{nested:debug}")

    mut m = Map.new<string, i64>()
    m.insert("k", 1)
    println("{m:debug}")

    let t = (1, "x", true)
    println("{t:debug}")
}

test "a Vec of aggregates shows its shape, not its contents" {
    let ps: Vec<Point> = [Point { x: 1, y: 2 }].iter().to_vec()
    assert "{ps:debug}" == "[…]"
}

test "a Map shows its shape" {
    mut m = Map.new<string, i64>()
    m.insert("k", 1)
    assert "{m:debug}" == "{{…}}"
}

test "a tuple renders positionally" {
    let t = (1, "x", true)
    assert "{t:debug}" == "(1, \"x\", true)"
}
