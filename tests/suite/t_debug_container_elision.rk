// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// Where the two backends still disagree about `{x:debug}`. Tracked, not fixed.
//
// One shape left: a `Map`. Native renders it `{…}` — the shape without the
// contents — because walking a map's entries needs an iteration order the
// runtime doesn't expose, and the interpreter walks values so it prints them.
//
// The other two converged. A `Vec` of aggregates is walked in MIR now, one
// element at a time through the same renderer a struct field goes through, so
// native prints its contents; and a tuple is a real value in the interpreter
// (#1063) rather than a `Vec`, so it renders positionally on both.
//
// Neither backend is wrong about anything it prints. Native is incomplete, and
// the interpreter is the reference for what the answer should be.

struct Point {
    x: i64
    y: i64
}

func main() {
    let ps: Vec<Point> = [Point { x: 1, y: 2 }].iter().to_vec()
    println("{ps:debug}")

    let nested: Vec<Vec<i64>> = [].iter().to_vec()
    println("{nested:debug}")

    mut m = Map.new<string, i64>()
    m.insert("k", 1)
    println("{m:debug}")

    let t = (1, "x", true)
    println("{t:debug}")
}

test "a Vec of aggregates shows its contents on both backends" {
    let ps: Vec<Point> = [Point { x: 1, y: 2 }].iter().to_vec()
    assert "{ps:debug}" == "[Point {{ x: 1, y: 2 }}]"
}

test "a Vec of Vecs recurses" {
    let inner: Vec<i64> = [1, 2].iter().to_vec()
    mut outer = Vec.new()
    outer.push(inner)
    assert "{outer:debug}" == "[[1, 2]]"
}

test "a Map shows its shape" {
    mut m = Map.new<string, i64>()
    m.insert("k", 1)
    assert "{m:debug}" == "{{…}}"
}

test "a tuple renders positionally" {
    let t = (1, "x", true)
    assert "{t:debug}" == "(1, \"x\", true)"
}
