// SPDX-License-Identifier: (MIT OR Apache-2.0)
// A pooled element doesn't have to be a struct. `Pool<string>`, `Pool<Vec<T>>`
// and `Pool<Map<K, V>>` hold elements that *are* the owned thing, and the
// element map was a struct-layout question only — so those three described
// themselves as owning nothing and the pool gave back the slot array and left
// the value. The tag comes from lowering now, and `Pool.remove` says which
// container it hands back so the frame frees it.
import memory.Pool

struct Ent {
    name: string
    tags: Vec<string>
}

enum Shape {
    Dot
    Named(string)
}

func main() {}

test "a pooled string comes back and is freed with the pool" {
    let n = 1
    mut p = Pool<string>.new()
    let a = p.insert("a{n}")
    let b = p.insert("b{n}")
    p.remove(a)
    if p.get(b)? as s {
        assert s == "b1"
    } else {
        assert false, "the second handle went stale"
    }
}

test "a pooled Vec keeps its elements and gives them back on remove" {
    let n = 1
    mut p = Pool<Vec<string>>.new()
    mut v = Vec<string>.new()
    v.push("x{n}")
    let h = p.insert(v)
    if p.get(h)? as held {
        assert held.len() == 1
    } else {
        assert false, "the handle went stale"
    }
    p.remove(h)
    assert p.len() == 0
}

test "a pooled Map is freed with the pool" {
    let n = 1
    mut p = Pool<Map<string, string>>.new()
    mut m = Map<string, string>.new()
    m.insert("k{n}", "v{n}")
    let h = p.insert(m)
    assert p.len() == 1
}

test "a pooled struct still owns its string and its Vec" {
    let n = 1
    mut p = Pool<Ent>.new()
    mut tags = Vec<string>.new()
    tags.push("t{n}")
    let h = p.insert(Ent { name: "e{n}", tags })
    if p.get(h)? as e {
        assert e.name == "e1"
        assert e.tags.len() == 1
    } else {
        assert false, "the handle went stale"
    }
}

test "a pooled enum payload is freed with the pool" {
    let n = 1
    mut p = Pool<Shape>.new()
    let h = p.insert(Shape.Named("s{n}"))
    p.remove(h)
    assert p.len() == 0
}
