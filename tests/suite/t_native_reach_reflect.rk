// SPDX-License-Identifier: (MIT OR Apache-2.0)
// reflect.* and FieldInfo.* marked `@native` with no dispatch row.
//
// All of these resolve at comptime, so the absent dispatch row is correct.
// `reflect.size_of`, `align_of` and `is_copy` are exercised in
// t_reflect_size_of.rk.

import std.reflect

annotation @label {
    name: string
}

struct Row {
    @label(name: "id")
    public id: i64
    public value: string
}

test "reflect.fields and FieldInfo has/get" {
    mut seen = ""
    comptime for f in reflect.fields<Row>() {
        seen = "{seen}{f.name};"
        comptime if f.has<label>() {
            seen = "{seen}@{f.get<label>().name};"
        }
    }
    assert(seen == "id;@id;value;")
}

test "reflect predicates" {
    assert(reflect.name_of<Row>() == "Row")
    assert(reflect.is_struct<Row>())
    assert(!reflect.is_enum<Row>())
    assert(!reflect.is_flat<Row>())
    assert(reflect.is_float<f64>())
    assert(reflect.is_integer<i64>())
    assert(!reflect.is_map<Row>())
    assert(!reflect.is_optional<Row>())
    assert(!reflect.is_resource<Row>())
    assert(!reflect.is_vec<Row>())
}

enum Cell {
    Empty
    Full(i64)
}

test "reflect type-table queries" {
    assert reflect.has_field<Row>("id")
    assert !reflect.has_method<Row>("nope")
    assert reflect.implements<Row, Equal>()
    assert reflect.interfaces<Row>().len() == 0
    assert reflect.methods<Row>().len() > 0
    assert reflect.variants<Cell>()[1].name == "Full"
}
