// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// Variant patterns against a `T or E` and a flat `T? or E` (#1849).
//
// The interpreter matched a named-field variant (`Bad.Named(a: x, b: y)`)
// only against a bare enum, so on the error side of a `T or E` the arm never
// matched and fell to the wildcard. And a variant of the success side of a
// flat `T? or E` sits behind two wrappers (`Ok(Some(Light.Red))`), which the
// search for it looked through only for the outer one, so `r is Light.Red`
// was false for every input.
enum Bad {
    Named(a: i64, b: string)
    Plain
}

enum Color {
    Blue
}

enum Light {
    Red
    Green
}

func f(x: i64) -> i64 or Bad {
    if x == 0 {
        return Bad.Named(a: 9, b: "nm")
    }
    if x == 1 {
        return Bad.Plain
    }
    return x
}

func get(a: i64) -> Light? or Color {
    if a == 0 {
        return Light.Red
    }
    if a == 1 {
        return Light.Green
    }
    if a == 2 {
        return none
    }
    return Color.Blue
}

func describe(x: i64) -> string {
    return match f(x) {
        Bad.Named(a as n, b as s) => "named {n} {s}",
        Bad.Plain => "plain",
        _ => "ok",
    }
}

func main() {}

test "a named-field variant on the error side of T or E matches" {
    assert describe(0) == "named 9 nm"
    assert describe(1) == "plain"
    assert describe(5) == "ok"
}

test "a success-side variant of a flat T? or E answers true for that variant" {
    assert get(0) is Light.Red
    assert !(get(0) is Light.Green)
    assert get(1) is Light.Green
    assert !(get(1) is Light.Red)
}

test "the other branches of a flat T? or E are not that variant" {
    let none_case = get(2)
    assert !(none_case is Light.Red)
    assert !(none_case is Light.Green)
    assert none_case is none
    let err_case = get(3)
    assert !(err_case is Light.Red)
    assert err_case is Color.Blue
}
