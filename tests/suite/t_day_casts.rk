// Day one: converting between numeric types.
//
// Rask splits this in two, and knowing which is which is the day-one lesson:
//
//   `as` is for conversions that cannot lose anything — widening an integer,
//   int→int where the value fits, f32→f64.
//
//   Anything lossy has to say what happens when it doesn't fit. Float→int names
//   a rounding (`.round<i32>()`, `.floor`, `.ceil`, `.to` for exact-only) and
//   those return a result, hence the `!`. Int→float names one too —
//   `.round<f64>()` — but it's total, so no `!`: every integer has a nearest
//   float, it just isn't always the same number.
//
// So `x as f64` on an i32 is fine (every i32 lands on a double exactly) and on
// an i64 it isn't, because past 2^53 a double starts skipping integers. Same
// rule one size down: an f32 keeps every i16 and starts skipping at 2^24.

test "widening an integer with as" {
    let a: i8 = 100
    assert (a as i16) == 100
    assert (a as i32) == 100
    assert (a as i64) == 100
    let b: u8 = 250
    assert (b as u16) == 250
    assert (b as u32) == 250
    assert (b as u64) == 250
}

test "unsigned to a wider signed type" {
    let a: u8 = 255
    assert (a as i16) == 255
    assert (a as i32) == 255
    let b: u32 = 4000000000
    assert (b as i64) == 4000000000
}

// Signed sources only here: an unsigned source with its top bit set takes the
// signed conversion on native (#907), which `t_day_unsigned_to_float.rk` carries.
//
// This test used to end with `let d: i64 = -1000; assert (d as f64) == -1000.0`,
// which the spec's CV1 table has never allowed — it was asserting the compiler's
// behaviour rather than the rule, and the compiler was wrong. -1000 does survive
// an f64, but `as` answers per type, not per value, and some i64s don't.
test "int to float where nothing can be lost" {
    let a: i32 = 3
    assert (a as f64) == 3.0
    let b: i16 = -7
    assert (b as f64) == -7.0
    let c: u8 = 100
    assert (c as f64) == 100.0
    let d: u32 = 4000000000
    assert (d as f64) == 4000000000.0
}

// The sources `as` won't take need `.round<T>()`, which is total — every
// integer has a nearest float. The value only moves once you're past the
// mantissa, and `t_float_formatting.rk` pins where that starts.
test "int to float where something could be lost names the rounding" {
    let big: i64 = -1000
    assert big.round<f64>() == -1000.0
    let count: u64 = 42
    assert count.round<f64>() == 42.0
    let n: i32 = 7
    assert n.round<f32>() == 7.0
}

test "f32 widens to f64" {
    let a: f32 = 0.5
    assert (a as f64) == 0.5
    let b: f32 = 2.25
    assert (b as f64) == 2.25
}

test "float to int names its rounding" {
    assert 3.9.floor<i32>()! == 3
    assert 3.1.ceil<i32>()! == 4
    assert 3.5.round<i32>()! == 4
    assert 3.4.round<i32>()! == 3
    assert 4.0.to<i32>()! == 4
}

test "float to int rounding on negatives" {
    assert (-3.9).floor<i32>()! == -4
    assert (-3.9).ceil<i32>()! == -3
    assert (-3.5).round<i32>()! == -4
    assert (-3.4).round<i32>()! == -3
}

// `to<T>()` is exact-only and returns `T or ConvertError` — a failure, not an
// absence — so `catch` is what handles it, never `??`.
// CV14 says ties go to even, and `3.5 -> 4` / `-3.5 -> -4` above don't show
// that: round-half-away-from-zero gives the same two answers. These are the
// halves where the two policies disagree — the implementation was right and
// nothing in the tree said so.
test "a tie rounds to even, not away from zero" {
    assert 0.5.round<i32>()! == 0      // away-from-zero would give 1
    assert 1.5.round<i32>()! == 2
    assert 2.5.round<i32>()! == 2      // away-from-zero would give 3
    assert 3.5.round<i32>()! == 4
    assert 4.5.round<i32>()! == 4      // away-from-zero would give 5
}

test "a negative tie rounds to even too" {
    assert (-0.5).round<i32>()! == 0   // away-from-zero would give -1
    assert (-1.5).round<i32>()! == -2
    assert (-2.5).round<i32>()! == -2  // away-from-zero would give -3
}

test "to is exact-only and fails on a fraction" {
    let exact: f64 = 8.0
    assert exact.to<i32>()! == 8
    let inexact: f64 = 8.5
    assert (inexact.to<i32>() catch _ => -1) == -1
}

test "narrowing an integer fails when the value does not fit" {
    let big: i64 = 300
    assert (big.to<u8>() catch _ => 0) == 0
    let fits: i64 = 200
    assert fits.to<u8>()! == 200
    let neg: i64 = -1
    assert (neg.to<u8>() catch _ => 0) == 0
}

test "casts inside arithmetic" {
    let n: i32 = 3
    let f: f64 = 0.5
    assert (n as f64) * f == 1.5
    assert (n as f64) + f == 3.5
    let m: i16 = 10
    assert (m as i64) * 1000000 == 10000000
}

test "casting a loop counter" {
    mut total: f64 = 0.0
    for i in 1..4 {
        total = total + (i as f64)
    }
    assert total == 6.0
}

test "round-tripping through a wider type" {
    let a: i8 = -100
    let wide = a as i64
    assert wide == -100
    assert wide.to<i8>()! == -100
}

func main() {}
