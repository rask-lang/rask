// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Assigning through an index or a link and then two or more fields —
// `v[i].mid.tag -= 1`, `n.health.current = 42`.
//
// #411 fixed the one-field forms and stopped there. The place lowering matched on
// the assignment target's immediate object being the index, which only ever sees
// the last field in a chain, so anything deeper fell through to the generic path.
// That one loads the intermediate aggregate as a value copy and stores into the
// copy, so the write vanished — silently, native only, and the read afterwards
// returned the original. The interpreter was right throughout.
import memory.Rack

struct Health {
    public current: i64
    public max: i64
}

struct Entity {
    public active: bool
    public hp: i64
    public health: Health
}

struct Inner { public v: i64 }
struct Mid { public inner: Inner, public tag: i64 }
struct Outer { public mid: Mid }

test "a rack node's nested field takes the write" {
    mut rack = Rack<Entity>.new()
    let n = rack.insert(Entity {
        active: true,
        hp: 100,
        health: Health { current: 100, max: 100 },
    })

    // One field deep: worked before, still has to.
    n.hp -= 25
    assert n.hp == 75
    n.active = false
    assert n.active == false

    // Two fields deep: this is what dropped.
    n.health.current = 42
    assert n.health.current == 42
    n.health.current -= 2
    assert n.health.current == 40

    // The sibling field is untouched — the store hit the right offset, not just
    // somewhere in the node.
    assert n.health.max == 100
    assert n.hp == 75
}

test "three fields deep through a link" {
    mut rack = Rack<Outer>.new()
    let n = rack.insert(Outer { mid: Mid { inner: Inner { v: 1 }, tag: 2 } })

    n.mid.inner.v = 99
    n.mid.tag += 5

    assert n.mid.inner.v == 99
    assert n.mid.tag == 7
}

test "a Vec element's nested field takes the write" {
    mut v = Vec<Outer>.new()
    v.push(Outer { mid: Mid { inner: Inner { v: 1 }, tag: 2 } })

    v[0].mid.inner.v = 77
    v[0].mid.tag -= 1

    assert v[0].mid.inner.v == 77
    assert v[0].mid.tag == 1
}

test "writes to two rack nodes don't bleed into each other" {
    mut rack = Rack<Entity>.new()
    let a = rack.insert(Entity {
        active: true,
        hp: 10,
        health: Health { current: 10, max: 10 },
    })
    let b = rack.insert(Entity {
        active: true,
        hp: 20,
        health: Health { current: 20, max: 20 },
    })

    a.health.current = 1
    b.health.current = 2

    assert a.health.current == 1
    assert b.health.current == 2
    assert a.health.max == 10
    assert b.health.max == 20
}
