// SPDX-License-Identifier: (MIT OR Apache-2.0)
// mut rebinding, let vs mut, shadowing.
//
// Spec: SYNTAX.md (bindings section)
//
// `mut` is the rebindable binding keyword, `let` is permanent.
//
// Note: `let` is deep — `let v = Vec.new()` forbids `v = other_vec` AND
// `v.push(1)`. Anything that needs to change goes through `mut`.

// --- let cannot be reassigned ---

test "let binding is permanent" {
    let x = 42
    // x = 43 would be a compile error (tested in compile_errors/let_reassign.rk)
    assert x == 42
}

// --- mut can be reassigned ---

test "mut binding reassignment" {
    mut x = 1
    assert x == 1
    x = 2
    assert x == 2
    x = x + 10
    assert x == 12
}

test "mut in loop" {
    mut sum = 0
    for i in 0..5 {
        sum += i
    }
    assert sum == 10
}

test "mut multiple reassignments" {
    mut s = "hello"
    assert s == "hello"
    s = "world"
    assert s == "world"
    s = "final"
    assert s == "final"
}

// --- shadowing (SYNTAX.md) ---

test "let shadows let" {
    let x = 1
    let x = x + 1
    assert x == 2
}

test "let shadows mut" {
    mut x = 1
    x = 5
    let x = x * 2
    assert x == 10
}

test "shadow changes type" {
    let x = 42
    let x = "now a string"
    assert x == "now a string"
}

test "shadow in nested block" {
    let x = 1
    {
        let x = 2
        assert x == 2
    }
    // Outer x still 1 — block shadow doesn't leak
    assert x == 1
}

// --- mutating collections requires mut (let is deep) ---

test "mut vec allows push" {
    mut v = Vec.new()
    v.push(1)
    v.push(2)
    assert v.len() == 2
}

test "mut map allows insert" {
    mut m = Map.new()
    m.insert("a", 1)
    assert m["a"] == 1
}

// --- mut with struct field mutation ---

struct Counter {
    value: i32
}

test "mut struct reassignment" {
    mut c = Counter { value: 0 }
    assert c.value == 0
    c = Counter { value: 10 }
    assert c.value == 10
}

func main() {}
