// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Primitive types: sized integers, bool, char, and the sanctioned lossy
// conversions. Spec: type.primitives (P1-P8, CV1/CV5-CV10, CH3-CH4, BL1-BL3).
// Every value is asserted at a boundary and must match on interp + native.

// --- P1: sized integer arithmetic and MAX/MIN bounds ---
test "type.primitives/P1 — i32 arithmetic at boundary" {
    let a: i32 = 2147483647
    assert a == 2147483647
    let lo: i32 = -2147483648
    assert lo == -2147483648
    let b: i32 = 1000000
    assert b * 2 == 2000000
}

test "type.primitives/P1 — i64 holds values beyond i32" {
    let big: i64 = 3000000000
    assert big + big == 6000000000
    assert big == 3000000000
}

test "type.primitives/P1 — u8 range" {
    let hi: u8 = 255
    assert hi == 255
    let lo: u8 = 0
    assert lo == 0
    let x: u8 = 200
    assert x == 200
}

test "type.primitives/P1 — u64 holds large value" {
    let x: u64 = 5000000000
    assert x == 5000000000
    assert x + 1 == 5000000001
}

// --- CV1: `as` widening is lossless ---
test "type.primitives/CV1 — lossless widening with as" {
    let small: i8 = 100
    let wide: i32 = small as i32
    assert wide == 100
    let n: i32 = 300
    let f: f64 = n as f64
    assert f == 300.0
}

// --- CV12: wrap<T> (keeps the low bits) ---
test "type.primitives/CV12 — wrap keeps the low bits" {
    let big: i32 = 300
    let a: u8 = big.wrap<u8>()
    assert a == 44
    let neg: i32 = -1
    let b: u8 = neg.wrap<u8>()
    assert b == 255
}

// --- CV13: clamp<T> (pins to the target's range) ---
test "type.primitives/CV13 — clamp pins to the range" {
    let big: i32 = 300
    assert (big.clamp<u8>()) == 255
    let neg: i32 = -5
    assert (neg.clamp<u8>()) == 0
    let fits: i32 = 100
    assert (fits.clamp<u8>()) == 100
}

// --- CV11: to<T> (exact, or ConvertError) ---
test "type.primitives/CV11 — to fails rather than losing the value" {
    let ok: i64 = 100
    assert ok.to<u8>()! == 100
    let overflow: i64 = 300
    assert (overflow.to<u8>() catch _ => 0) == 0
}

// --- BL1/BL2: boolean ops and short-circuit ---
test "type.primitives/BL1 — boolean operators" {
    assert (true && false) == false
    assert (true || false) == true
    assert !false == true
    assert (true && true) == true
}

func side_effect_free_true() -> bool { return true }

test "type.primitives/BL1 — short-circuit picks correct branch" {
    mut hit = false
    if false && side_effect_free_true() {
        hit = true
    }
    assert hit == false
    mut hit2 = false
    if true || side_effect_free_true() {
        hit2 = true
    }
    assert hit2 == true
}

// --- P5/CH2: char literals compared via code point (native char-eq is #332) ---
test "type.primitives/CH2 — char literals via code point" {
    let a = 'a'
    let b = 'b'
    assert (a as u32) == 97
    assert (a as u32) != (b as u32)
}

// --- CH4: char to u32 is lossless ---
test "type.primitives/CH4 — char as u32 lossless" {
    let a = 'a'
    assert (a as u32) == 97
    let nl = '\n'
    assert (nl as u32) == 10
}

// --- CH3: char.from_u32 returns char? with runtime validation ---
test "type.primitives/CH3 — from_u32 validates code points" {
    if char.from_u32(65)? as c {
        assert (c as u32) == 65
    } else {
        assert false, "65 is a valid scalar"
    }
    let surrogate = char.from_u32(0xD800)
    assert surrogate is none
    let too_big = char.from_u32(0x110000)
    assert too_big is none
}

// --- P4/BL3: bool is distinct; comparisons yield bool ---
test "type.primitives/P4 — comparisons produce bool" {
    let r: bool = 3 > 2
    assert r == true
    let e: bool = 2 == 2
    assert e == true
}

func main() {}

// ── A shift's operands take the expected type (#833) ─────────────────
//
// `let a: i64 = 2 << 40` panicked at runtime with "shift amount exceeds i32 bit
// width" — for an expression whose only written type is `i64`. The other
// arithmetic operators are "homogeneous": the checker ties the two operands
// together, so an annotation on the binding reaches both. Shifts aren't, and
// rightly so — the shift amount has its own type — but nothing tied the *result*
// to the receiver either, so a literal on the left was unconstrained and
// defaulted to i32 before the annotation was consulted.
//
// A local worked (`let b: i64 = 2` then `b << 40`), which is what made this look
// like a shift bug rather than an inference one.

test "type.primitives — a shift's left literal takes the annotation" {
    let a: i64 = 2 << 40
    assert a == 2199023255552

    // The other direction: the annotation narrows rather than widens.
    let n: i32 = 1 << 20
    assert n == 1048576

    // Unsigned, and past the signed boundary.
    let u: u64 = 1 << 63
    assert u == 9223372036854775808

    // Right shift too.
    let r: i64 = 4398046511104 >> 40
    assert r == 4
}

func shifted(n: i64) -> i64 {
    return n
}

test "type.primitives — a parameter's type reaches a shift argument" {
    // The expectation is the parameter's type rather than a binding's.
    assert shifted(2 << 40) == 2199023255552
}

test "type.primitives — a local on the left still works" {
    let base: i64 = 2
    assert (base << 40) == 2199023255552
}

test "type.primitives — a typed shift amount keeps its own type" {
    // ORD4 puts the shifts with arithmetic, so a mixed-signedness amount is a
    // type error (`u64 << i32` — asserted in tests/compile_errors/). The widths
    // don't have to match, though: only a *literal* amount takes the receiver's
    // type, and one written at its own keeps it.
    let n: u8 = 3
    let v: u64 = 1
    assert (v << n) == 8
}
