// SPDX-License-Identifier: (MIT OR Apache-2.0)
// `try` inside a `test` block — std.testing/T20.
//
// A test block is the error branch. `try` on a fallible step reads the way it
// does anywhere else, and when the step fails, that test fails by name with the
// error reported — later tests still run.
//
// This file was written as the #932 probe, back when the same code failed the
// Cranelift verifier on native and passed silently on interp, and the spec said
// bare `try` here should have been an ER47 compile error. #1057 fixed the
// codegen and gave the propagation somewhere to go; the rule that banned it was
// deleted afterwards, because its whole argument was that the failure would say
// nothing useful and it now says exactly what happened.
//
// Only the success half can live here — a failing test fails the file, so the
// propagation path is pinned in `compile_run.rs`
// (`try_in_a_test_block_fails_that_test_and_names_the_error`), which reads a
// program's output instead of asserting inside it.
//
// The three controls at the bottom are the other spellings of the same step:
// `catch` when you want to handle the failure, `!` when you want to assert it
// can't happen, and `try` inside an ordinary function as the shape this rule is
// modelled on.

enum MyErr {
    Bad
}

extend MyErr with Error {
    func message(self) -> string {
        return "bad"
    }
}

func might_fail(ok: bool) -> i64 or MyErr {
    if !ok: return MyErr.Bad
    return 7
}

func uses_try() -> i64 or MyErr {
    let v = try might_fail(true)
    return v
}

test "std.testing — T20: try on a result inside a test block" {
    let v = try might_fail(true)
    assert v == 7
}

test "std.testing — T20: two trys in one test block" {
    let a = try might_fail(true)
    let b = try might_fail(true)
    assert a + b == 14
}

// Controls: these three work on both backends.
test "type.errors — catch in the same position is the first control" {
    let v = might_fail(true) catch _ => -1
    assert v == 7
}

test "type.errors — ! in the same position is the second control" {
    let v = might_fail(true)!
    assert v == 7
}

test "type.errors — try inside a plain function is the third control" {
    assert uses_try()! == 7
}

func main() {}
