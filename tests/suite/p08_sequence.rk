// PENDING type.sequence — function-valued Sequence<T> + for-loop desugar to yield-closure call. Expected RED until built; drives implementation. Do NOT assert current (wrong) behavior.
// SPDX-License-Identifier: (MIT OR Apache-2.0)
// Spec: specs/types/sequence-protocol.md — SEQ1 defines Sequence<T> as a
// function type taking a yield closure; SEQ6 desugars `for x in seq_expr` to a
// yield-closure call; SEQ3/SEQ7: yield returns true to continue, false to stop.

// SEQ1: the sequence protocol is a plain function type alias, not a trait.
type alias Sequence<T> = func(yield: |T| -> bool)

// A user sequence: closure captures nothing, yields 1,2,3, honoring SEQ3.
func count_to_three() -> Sequence<i32> {
    return |yield| {
        if not yield(1) { return }
        if not yield(2) { return }
        if not yield(3) { return }
    }
}

// --- SEQ6: for-loop over a Sequence value sums the yielded items ---

test "type.sequence/SEQ6 — for over a Sequence sums yielded values" {
    mut sum = 0
    for x in count_to_three() {
        sum = sum + x
    }
    assert sum == 6
}

// --- SEQ7: break inside the for-body translates to `return false` (stop) ---

test "type.sequence/SEQ7 — break stops the sequence after two items" {
    mut count = 0
    for x in count_to_three() {
        count = count + 1
        if x == 2 { break }
    }
    assert count == 2
}

func main() {}
