//
// A dependency's `comptime if` is settled like the program's. The untaken
// branch names something that doesn't exist, so resolving it is an error.

public func mode() -> string {
    comptime if cfg.profile == "nonsense" {
        return no_such_function()
    }
    return "lib built"
}
