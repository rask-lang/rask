import libpkg

// The consumer's own Cat. Nothing here imports libpkg's, and it still loses:
// a dependency's public names occupy the consumer's namespace whether or not
// anyone asked for them.
struct Cat {
    legs: i64
}

func main() {
    let c = Cat { legs: 4 }
    println("{c.legs}")
    return
}
