//
// #1126 — `import libpkg.Colour` is rejected as "`Colour` is a built-in
// type", which it isn't. Without that import it's #1112 instead: `label`'s
// body names a `Colour` the merged program doesn't declare.

public enum Colour {
    Red
    Green
}

public func label(c: Colour) -> string {
    match c {
        Colour.Red => return "red"
        Colour.Green => return "green"
    }
}

// #1461 — a variant with named fields, built through the package name.
public enum Shape {
    Circle { r: i64 }
    Square { side: i64 }
}

public func area(s: Shape) -> i64 {
    match s {
        Shape.Circle { r } => return 3 * r * r
        Shape.Square { side } => return side * side
    }
}
