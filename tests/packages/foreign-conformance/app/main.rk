//
// The conformance is declared in neither the package that owns the type nor
// the one that owns the interface, and it's used here through the bound — the
// whole of type.generics/XC2 in one program.

import traitpkg
import traitpkg.Labeled
import liba

func show<T: Labeled>(x: T) -> string {
    return x.label()
}

func main() {
    let d = traitpkg.make_doc(7)
    println(show(d))
    println(d.label())
    return
}
