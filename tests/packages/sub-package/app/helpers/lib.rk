// SPDX-License-Identifier: (MIT OR Apache-2.0)
//
// #1100 — a subdirectory is a package of its own, and only its *public*
// declarations used to be merged before resolve. `answer()` calls a private
// helper by its bare name, so the package couldn't be resolved at all:
//
//     error[E0200]: undefined symbol: `private_delay`
//
// The privates reached MIR anyway, through a list merged after resolve, so
// they arrived having never been in a scope.

func private_delay() -> i64 {
    return 250
}

public func answer() -> i64 {
    return private_delay()
}
