import traitpkg.Labeled

public extend traitpkg.Doc implements Labeled {
    public func label(self) -> string {
        return "a:{self.n}"
    }
}

// XC4: `libb` isn't in `liba`'s dependency graph, so this call sees exactly
// one conformance and runs it — whatever else the program linking `liba`
// pulls in.
public func describe(d: traitpkg.Doc) -> string {
    return d.label()
}

// The same conformance reached from inside a generic body, which is the case
// `type.generics/XC5` names in so many words. Here the receiver is `T`, so
// there is no concrete type to resolve the block against when the body is
// checked — only the package the source is in, which is what decides.
func shown_a<T: Labeled>(x: T) -> string {
    return x.label()
}

public func describe_generic(d: traitpkg.Doc) -> string {
    return shown_a(d)
}
