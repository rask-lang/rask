public struct Counter {
    public n: i64
}

extend Counter {
    public func doubled(self) -> i64 {
        return self.raw() * 2
    }

    // No `public`: this package's own helper (struct.modules/V1).
    func raw(self) -> i64 {
        return self.n
    }
}
