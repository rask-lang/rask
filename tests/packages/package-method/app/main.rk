//
// A dependency's method without `public` is that package's own, so calling it
// from here is rejected (#1417). The public one beside it is fine.

import libpkg
import libpkg.Counter

func main() {
    let c = Counter { n: 4 }
    println("{c.doubled()}")
    println("{c.raw()}")
    return
}
