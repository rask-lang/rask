//
// #1123 — a `const` exported from a dependency reads as 0, silently,
// whatever its type. This one builds; it just gives the wrong answer.

public const LIMIT: i64 = 99
public const GREETING: string = "hei"

// A const holding a function, called through the package: natively the
// callee took the call's own node, so its type read as the call's `i64`.
func answer() -> i64 {
    return 42
}

public const PICK: func() -> i64 = answer
