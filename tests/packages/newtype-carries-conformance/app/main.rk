//
// The nominal type is what both XC1 and XC3 tell you to reach for, and it
// couldn't hold a conformance at all: an `extend Tagged implements Hashable` block
// registered its methods on the nominal type and the check that reads them
// back looked only at structs, enums and interfaces. Every method came back
// missing on a block that had them all.

import interfacepkg
import liba

func main() {
    let d = interfacepkg.make_doc(7)
    let t = liba.tag(d)
    println("{t.hash()}")
    return
}
