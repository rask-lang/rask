// SPDX-License-Identifier: (MIT OR Apache-2.0)
// The float workload whose bits are pinned (determinism/D12).
//
// An n-body step plus a few thousand transcendental calls, folded into one
// FNV-1a hash of the results' bit patterns. Every machine and both backends
// have to print the same number: a change that moves one bit anywhere in here
// changes it. tests/suite/t_float_bits_pinned.rk checks it on both backends,
// tests/float_gate.sh on aarch64 under qemu.

import math

struct Body {
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    mass: f64
}

func mix(h: u64, x: f64) -> u64 {
    return (h ^ x.to_bits()).wrapping_mul(1099511628211)
}

func step(mutate bodies: Vec<Body>, dt: f64) {
    let n = bodies.len()
    for i in 0..n {
        for j in (i + 1)..n {
            let dx = bodies[i].x - bodies[j].x
            let dy = bodies[i].y - bodies[j].y
            let dz = bodies[i].z - bodies[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * d2.sqrt())
            let mi = bodies[i].mass
            let mj = bodies[j].mass
            bodies[i].vx = bodies[i].vx - dx * mj * mag
            bodies[i].vy = bodies[i].vy - dy * mj * mag
            bodies[i].vz = bodies[i].vz - dz * mj * mag
            bodies[j].vx = bodies[j].vx + dx * mi * mag
            bodies[j].vy = bodies[j].vy + dy * mi * mag
            bodies[j].vz = bodies[j].vz + dz * mi * mag
        }
    }
    for i in 0..n {
        bodies[i].x = bodies[i].x + dt * bodies[i].vx
        bodies[i].y = bodies[i].y + dt * bodies[i].vy
        bodies[i].z = bodies[i].z + dt * bodies[i].vz
    }
}

public func float_workload_hash() -> u64 {
    mut h: u64 = 14695981039346656037
    mut bodies: Vec<Body> = Vec.new()
    for k in 0..5 {
        let t = k.to_float()
        bodies.push(Body(
            x: math.cos(t * 1.3) * (t + 1.0),
            y: math.sin(t * 0.7) * (t + 1.0),
            z: t * 0.1,
            vx: math.sin(t) * 0.01,
            vy: math.cos(t) * 0.01,
            vz: 0.0,
            mass: math.exp(-t * 0.5)
        ))
    }
    for _ in 0..1000 {
        step(mutate bodies, 0.01)
    }
    for b in bodies {
        h = mix(h, b.x)
        h = mix(h, b.y)
        h = mix(h, b.z)
        h = mix(h, b.vx)
    }
    for k in 1..3001 {
        let x = k.to_float() * 0.0137
        h = mix(h, math.sin(x))
        h = mix(h, math.cos(x))
        h = mix(h, math.tan(x * 0.3))
        h = mix(h, math.exp(-x * 0.1))
        h = mix(h, math.ln(x))
        h = mix(h, math.atan2(x, 3.0 - x))
        h = mix(h, x.pow(1.37))
        h = mix(h, math.hypot(x, 1.0 / x))
    }
    return h
}

func main() {
    println("{float_workload_hash()}")
}
